<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>LanguageStudyStardewValleyMod</RootNamespace>
        <EnableHarmony>true</EnableHarmony>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
    </ItemGroup>

    <ItemGroup>
      <!-- tools/ holds separate standalone projects (see tools/*/*.csproj); keep them out of this project's own compilation -->
      <Compile Remove="tools/**/*.cs" />
      <None Remove="tools/**" />
    </ItemGroup>

    <ItemGroup>
      <!-- bundled translation data (see Plan.md M0/M4); must be copied to the deployed mod folder to be loadable at runtime -->
      <None Include="assets/**/*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>

    </ItemGroup>

    <!--
      Hand-segmented word boundaries (see Plan.md's data task) live in tools/extracted-strings,
      where they're generated and validated. Copy them into assets/ before the build rather than
      committing a second copy: ModBuildConfig deploys files from the PROJECT folder (not the build
      output), and tools/ is excluded there, so a None+Link into the output never reaches the
      deployed mod. assets/segments/ is gitignored for the same reason: tools/ stays the source
      of truth.
    -->
    <Target Name="CopySegmentData" BeforeTargets="BeforeBuild">
      <ItemGroup>
        <SegmentDataFiles Include="tools/extracted-strings/literal-translations/*.json" />
      </ItemGroup>
      <Copy SourceFiles="@(SegmentDataFiles)" DestinationFolder="assets/segments/ja" SkipUnchangedFiles="true" />
    </Target>

</Project>
