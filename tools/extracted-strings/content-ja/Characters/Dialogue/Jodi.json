    "fall_Sun": "\u79C1\u3001 \u30AD\u30E3\u30ED\u30E9\u30A4\u30F3\u3068\u306F \u4EF2\u304C\u3044\u3044\u306E\u3088\u3002\u5F7C\u5973\u306B\u306F \u4F55\u3067\u3082 \u8A71\u305B\u308B\u306E\u3002",
    "fall_Sun2": "\u3042\u306A\u305F\u3082 \u89AA\u306B \u306A\u3063\u305F\u3089\u3001 \u6614\u306E \u751F\u6D3B\u3092 \u6368\u3066\u308B\u3053\u3068\u306B \u306A\u308B\u308F\u3088\u3002#$e#\u7D76\u5BFE\u6368\u3066\u306A\u304D\u3083 \u3044\u3051\u306A\u3044\u308F\u3051\u3058\u3083 \u306A\u3044\u3051\u3069\u2026 \u6C17\u3092\u3064\u3051\u306A\u3044\u3068 \u305D\u3046\u306A\u308B\u308F\u3002",
    "fall_Thu": "\u305F\u3076\u3093\u3001 \u5B50\u3069\u3082\u9054\u3092 \u7518\u3084\u304B\u3057\u3059\u304E\u305F\u306E\u304B\u3082\u3002\u5F7C\u3089\u306B \u5BB6\u4E8B\u3092 \u3055\u305B\u3066\u306A\u304B\u3063\u305F\u304B\u3089\u3002#$e#\u5B50\u3069\u3082\u9054\u306B\u306F\u3001 \u82E5\u3044\u9593\u306B \u8272\u3005\u3068 \u697D\u3057\u3093\u3067\u307B\u3057\u3044\u3068 \u601D\u3063\u3066\u308B\u306E\u3088\u3002\u307E\u3042\u3001 \u30B5\u30E0\u306F \u5341\u5206 \u5927\u4EBA\u306B \u306A\u3063\u305F\u3051\u3069\u306D\u3002#$b#\u6020\u3051\u8005\u306B \u306A\u3063\u3066\u306A\u304B\u3063\u305F\u3089 \u3044\u3044\u3051\u3069\u2026\u305D\u3046\u306F \u884C\u304B\u306A\u3044\u308F\u3088\u306D\u3002$s#$e#\u89AA\u306B\u306A\u308B\u306E\u3063\u3066 \u96E3\u3057\u3044\u308F\u3002",
    "fall_Thu_inlaw_Sam": "\u30B5\u30E0\u306F\u8FB2\u5834\u3067\u305F\u3060\u30D6\u30E9\u30D6\u30E9\u3057\u3066\u3044\u308B\u3060\u3051\u306A\u306E\u304B\u3001\u305D\u308C\u3068\u3082\u8CA2\u732E\u3057\u3066\u3044\u308B\u306E\u304B\uFF1F",
    "married_Sam": "\u3042\u306A\u305F\u3068\u30B5\u30E0\u304C\u3057\u3042\u308F\u305B\u305D\u3046\u3067\u79C1\u3082\u3046\u308C\u3057\u3044\u308F\uFF01\u672C\u5F53\u306B\u304A\u4F3C\u5408\u3044\u306E\u592B\u5A66\u306D\uFF01#$e#\u30B5\u30E0\u306E\u90E8\u5C4B\u304B\u3089\u3046\u308B\u3055\u3044\u30AE\u30BF\u30FC\u306E\u97F3\u304C\u805E\u3053\u3048\u306A\u304F\u306A\u308B\u306E\u3092\u3055\u3073\u3057\u304F\u601D\u3046\u65E5\u304C\u6765\u308B\u306A\u3093\u3066\u601D\u308F\u306A\u304B\u3063\u305F\u308F\u2026$s",
    "pamHouseUpgrade": "\u307E\u3042\u2026\u30D1\u30E0\u306E\u3053\u3068\u306F\u805E\u3044\u305F\u308F\u2026\u3069\u3046\u3057\u3066\u5F7C\u5973\u306F\u3053\u3093\u306A\u306B\u89AA\u5207\u306B\u3057\u3066\u3082\u3089\u3048\u308B\u306E\u304B\u3057\u3089\u3002$s#$e#\u2026\u79C1\u3082\u305D\u3093\u306A\u5927\u91D1\u3092\u6301\u3063\u3066\u307F\u305F\u3044\u308F\u2026$s",
    "pamHouseUpgradeAnonymous": "\u30D1\u30E0\u306E\u65B0\u3057\u3044\u5BB6\u3092\u898B\u305F\uFF1F\u306F\u3041\u2026\u79C1\u3082\u305D\u3093\u306A\u5927\u91D1\u3092\u6301\u3063\u3066\u307F\u305F\u3044\u308F\u2026\u305B\u3081\u3066\u30AD\u30C3\u30C1\u30F3\u3060\u3051\u306F\u30EA\u30D5\u30A9\u30FC\u30E0\u3057\u305F\u3044\u306E\u2026$s",
    "reject_864": "\u3053\u308C\u306F\uFF1F\u30B1\u30F3\u30C8\u306E\u6226\u53CB\u306E1\u4EBA\u307F\u305F\u3044\u306D\u3002\u5F7C\u306B\u898B\u305B\u305F\u65B9\u304C\u826F\u3044\u3093\u3058\u3083\u306A\u3044\u304B\u3057\u3089\uFF1F",
    "summer_Mon": "\u590F\u306F\u826F\u3044\u5B63\u7BC0\u3060\u3051\u3069\u3001 \u4ED5\u4E8B\u3082\u5897\u3048\u308B\u306E\u3088\u306D\u3002#$e#\u5BB6\u306E\u3053\u3068\u306F \u3082\u3061\u308D\u3093\u3001 \u304A\u5EAD\u3082 \u3061\u3083\u3093\u3068 \u624B\u5165\u308C \u3057\u306A\u304D\u3083\uFF01",
    "summer_Sun": "\u4ECA\u65E5\u306F \u3044\u3063\u305F\u3044\u3069\u3093\u306A \u5915\u98DF\u3092 \u4F5C\u308D\u3046\u304B\u3057\u3089\uFF1F#$e#\u306F\u3041\u2026",
    "summer_Thu": "\u5BB6\u4E8B\u3063\u3066\u3001 \u3044\u3064\u307E\u3067\u305F\u3063\u3066\u3082 \u7D42\u308F\u3089\u306A\u3044\u304B\u3089 \u30B9\u30C8\u30EC\u30B9\u304C \u6E9C\u307E\u308B\u306E\u3088\u306D\u3002#$e#\u5E8A\u3092 \u6383\u9664\u3057\u3066\u3082\u3001 \u6B21\u306E\u65E5\u306B\u306F \u3082\u3046\u6C5A\u308C\u3066\u308B\u3002",
    "summer_Tue": "\u3053\u3093\u306B\u3061\u306F\u3002#$e#\u4F55\u304B \u7528\u304B\u3057\u3089\uFF1F\u4ECA\u306F \u5C11\u3057 \u5FD9\u3057\u3044\u306E\u3002",
    "summer_Tue_inlaw_Sam": "\u79C1\u306E\u5C0F\u3055\u306A\u30B5\u30DF\u30FC\u306F\u3001\u53E4\u3044\u8FB2\u5834\u3067\u3069\u3046\u3057\u3066\u307E\u3059\u304B\uFF1F$h",
    "winter_Fri": "\u305F\u307E\u306B\u3067\u3082 \u3044\u3044\u304B\u3089 \u4F11\u6687\u3092 \u53D6\u308C\u305F\u3089 \u3046\u308C\u3057\u3044\u306A\u3041\u2026$s",
    "winter_Mon": "\u5B50\u3069\u3082\u306E\u9803\u3001 \u96EA\u3067 \u904A\u3076\u306E\u304C \u597D\u304D\u3060\u3063\u305F\u308F\u3002\u6BCD\u89AA\u306B\u306A\u3063\u3066 \u826F\u304B\u3063\u305F\u3053\u3068\u3068 \u3044\u3048\u3070\u3001 \u307E\u305F \u96EA\u3067 \u697D\u3057\u3081\u308B\u3088\u3046\u306B \u306A\u3063\u305F\u3053\u3068\u304B\u3057\u3089\u3002$h",
    "winter_Sun": "\u79C1\u304C \u304A\u91D1\u6301\u3061 \u3060\u3063\u305F\u3089\u3001 \u307E\u305A \u30E1\u30A4\u30C9\u3068 \u30B7\u30A7\u30D5\u3092 \u96C7\u3046\u308F\u3002#$e#\u3048\u3048\u3001 \u305D\u3046\u3044\u3046\u306E\u3063\u3066 \u672C\u5F53\u306B \u30B9\u30C6\u30AD\u3088\u306D\uFF01$h",
    "winter_Thu": "\u30B5\u30E0\u306E \u97F3\u697D\u304C \u3068\u3066\u3082 \u3046\u308B\u3055\u3044\u306E\u3002\u304A\u96A3\u3055\u3093\u306E \u8FF7\u60D1\u306B \u306A\u3089\u306A\u304D\u3083 \u3044\u3044\u3051\u3069\u3002",
    "winter_Thu8": "\u30B1\u30F3\u30C8\u304C\u5175\u58EB\u306B\u306A\u308B\u304B\u3089\u3001\u79C1\u9054\u306F\u6025\u3044\u3067\u7D50\u5A5A\u3057\u305F\u306E\u3088\u2026\u82E5\u3055\u3068\u81EA\u7531\u3092\u3042\u307E\u308A\u5473\u308F\u3048\u306A\u304B\u3063\u305F\u3057\u3001\u632F\u308A\u8FD4\u308B\u306B\u306F\u3082\u3046\u9045\u3059\u304E\u308B\u3002$s#$e#\u305D\u308C\u3092\u3042\u306A\u305F\u306B\u8A00\u3046\u306A\u3093\u3066\u4FE1\u3058\u3089\u308C\u306A\u3044\u3002$4",
    "winter_Thu_inlaw_Sam": "\u30B5\u30E0\u3068\u306E \u66AE\u3089\u3057\u306F \u3069\u3046\uFF1F\u3042\u306E\u5B50\u304C \u5BB6\u3092 \u51FA\u3066\u4EE5\u6765\u3001 \u6599\u7406\u3068 \u6383\u9664\u304C \u5C11\u3057\u697D\u306B\u306A\u3063\u305F\u306E\u3088\u3002",
    "winter_Tue": "\u306D\u3047\u3002\u307F\u3093\u306A\u304C \u3042\u306A\u305F\u306E \u7267\u5834\u306B\u3064\u3044\u3066 \u805E\u3044\u3066\u304F\u308B\u306E\u3001 \u98FD\u304D\u3066\u3053\u306A\u3044\u304B\u3057\u3089\uFF1F#$e#\u79C1\u306A\u3089 \u30A6\u30F3\u30B6\u30EA\u3057\u305D\u3046\u3002",
    "winter_Tue6": "\u306F\u3041\u2026 \u6642\u3005\u3001 \u5BB6\u65CF\u306E\u4E16\u8A71\u3092 \u3057\u306A\u304F\u3066\u3082\u3044\u3044\u3000\u72EC\u308A\u8EAB\u306E \u751F\u6D3B\u3092\u3059\u308B \u5922\u3092 \u898B\u308B\u306E\u2026\u305D\u308C\u3063\u3066 \u6050\u308D\u3057\u3044 \u5922\u304B\u3057\u3089\u3002$s#$e#\u8AB0\u306B\u3082 \u8A00\u308F\u306A\u3044\u3067\u3088\u3002$4",
    "winter_Wed2": "\u4F55\u3092\u3059\u308B\u306E\u304C \u597D\u304D\u304B\u3063\u3066\uFF1F\u3046\u30FC\u3093\u2026\u3044\u3044 \u8CEA\u554F\u306D\u3002#$e#\u5BDD\u308B\u306E\u304C \u597D\u304D\u3088\u3002$s",
    "winter_Wed4_2": "\u30B1\u30F3\u30C8\u304C \u5E30\u3063\u3066\u304D\u3066\u304B\u3089 \u3057\u3070\u3089\u304F \u305F\u3063\u305F\u3051\u3069\u3001 \u307E\u3060 \u843D\u3061\u7740\u304B\u306A\u3044 \u307F\u305F\u3044\u306D\u3002$s"
  }
