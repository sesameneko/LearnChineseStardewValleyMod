    "2_1": "\u592B\u306E \u30B1\u30F3\u30C8\u306F \u5175\u58EB\u3067\u3001 \u6D77\u5916\u3067 \u50CD\u3044\u3066\u3044\u308B\u306E\u3002\u3060\u304B\u3089 \u4ECA \u3053\u3053\u306B\u3044\u306A\u3044\u306E\u3088\u3002#$b#\u9060\u5F81\u3092 \u7121\u4E8B\u306B \u7D42\u3048\u3066 \u5E30\u3063\u3066\u304F\u308B\u3063\u3066 \u4FE1\u3058\u3066\u308B\uFF01#$e#\u4F55\u304B \u5165\u7528\u304B\u3057\u3089\uFF1F",
    "AcceptGift_(O)StardropTea": "\u307E\u3042\u2026\u305D\u3093\u306A\u306B\u8CB4\u91CD\u306A\u3082\u306E\u3092\u3082\u3089\u3063\u3066\u3044\u3044\u306E\uFF1F\u672C\u5F53\u306B\u3042\u308A\u304C\u3068\u3046\uFF01",
    "Fri": "$d Joja#Joja\u30DE\u30FC\u30C8\u306E \u98DF\u54C1\u306F \u5BB6\u65CF\u306B\u3068\u3063\u3066 \u5065\u5EB7\u3068\u306F \u8A00\u3048\u306A\u3044\u3051\u3069\u3001 \u3042\u306E \u5024\u6BB5\u306A\u3089 \u4ED6\u306E\u3068\u3053\u308D\u3067 \u8CB7\u3046\u6C17\u3082 \u8D77\u304D\u306A\u304F\u306A\u308B\u308F\uFF01|\u30D4\u30A8\u30FC\u30EB\u306E\u5E97\u306E \u98DF\u54C1\u306F Joja\u30DE\u30FC\u30C8\u3067 \u8CB7\u3048\u305F\u3082\u306E\u3088\u308A\u3082 \u305A\u3063\u3068 \u65B0\u9BAE\u3067 \u30D8\u30EB\u30B7\u30FC\u306D\u3002\u3067\u3082\u3001Joja\u30DE\u30FC\u30C8\u306E \u3042\u306E \u5B89\u3055\u304C \u604B\u3057\u3044\u308F\u3002",
    "GreenRain": "\u3042\u306A\u305F\u306F\u5927\u4E08\u592B\uFF1F\u3053\u3093\u306A\u3053\u3068\u306F\u521D\u3081\u3066\u3060\u308F\u2026$s#$e#\u592B\u304C\u3053\u3053\u306B\u3044\u3066\u304F\u308C\u305F\u3089\u3088\u304B\u3063\u305F\u306E\u3060\u3051\u3069\u3002\u5F7C\u306A\u3089\u3001\u3069\u3046\u3059\u308C\u3070\u3044\u3044\u304B\u9069\u5207\u306B\u5224\u65AD\u3067\u304D\u308B\u306F\u305A\u3060\u3082\u306E\u3002$s",
    "GreenRain_2": "\u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u3063\u305F\u3089\u3001\u96E8\u306E\u4E2D\u3092\u5916\u3067\u904A\u3076\u305F\u3081\u306B\u65E9\u8D77\u304D\u3057\u305F\u306E\u3088\u3002\u3053\u306E\u96E8\u306B\u672C\u5F53\u306B\u5BB3\u304C\u306A\u3044\u3053\u3068\u3092\u9858\u3063\u3066\u308B\u308F\uFF01",
    "Introduction": "\u3042\u3063\uFF01\u60F3\u50CF\u3068\u306F \u9055\u3046 \u30BF\u30A4\u30D7\u306D\u2026 \u307E\u3041\u3001 \u3044\u3044\u304B\u306A\uFF01\u79C1\u306F\u30B8\u30E7\u30C7\u30A3\u3002#$e#\u3053\u3053\u306F \u5C0F\u3055\u304F\u3066 \u9759\u304B\u306A \u753A\u3060\u304B\u3089\u3001 \u65B0\u3057\u3044 \u4EBA\u304C \u6765\u308B\u306E\u304C \u697D\u3057\u307F \u306A\u306E\u3088\uFF01\u7267\u5834\u4E3B\u304C \u6765\u305F\u3053\u3068\u3067 \u4F55\u304B\u304C \u5909\u308F\u308B\u3093\u3058\u3083 \u306A\u3044\u304B\u3057\u3089\u306D\u3002",
    "Mon": "\u5BB6\u5EAD\u3092 \u7DAD\u6301\u3059\u308B\u306E\u3063\u3066 \u96E3\u3057\u3044\u3051\u3069\u2026 \u8AB0\u304B\u304C \u3084\u3089\u306A\u304F\u3061\u3083 \u306A\u3089\u306A\u3044\u306E\u3088\u306D\u3002#$e#\u305D\u3046\u3067\u3057\u3087\u3046\uFF1F",
    "Mon2": "$d kent#\u6628\u65E5\u3001\u592B\u304C\u7121\u4E8B\u306B\u5E30\u3063\u305F\u3053\u3068\u3078\u306E\u611F\u8B1D\u306E\u305F\u3081\u306B\u30E8\u30D0\u795E\u306E\u796D\u58C7\u306B\u884C\u3063\u3066\u6765\u305F\u308F\u3002|\u6628\u65E5\u3001\u592B\u304C\u7121\u4E8B\u306B\u5E30\u3063\u3066\u6765\u308B\u3088\u3046\u306B\u30E8\u30D0\u795E\u306E\u796D\u58C7\u3067\u304A\u7948\u308A\u3057\u3066\u6765\u305F\u308F\u3002#$e#\u524D\u5411\u304D\u3067\u3044\u3088\u3046\u3068\u304C\u3093\u3070\u3063\u3066\u308B\u3051\u3069\u3001\u6642\u3005\u3064\u3089\u304F\u306A\u308B\u306E\u3088\u306D\u3002$s",
    "Mon6": "\u5BB6\u65CF\u3092 \u6301\u3066\u3066 \u5E78\u305B\u3060\u308F\u2026 \u82E5\u304B\u3063\u305F\u9803\u306E\u81EA\u7531\u3055\u304C \u604B\u3057\u304F\u306A\u308B\u3053\u3068\u306F \u3042\u308B\u3051\u3069\u306D\u2026$s",
    "Resort": "\u606F\u3092\u98F2\u3080\u3088\u3046\u306A\u666F\u8272\u306D\uFF01\u898B\u6E21\u3059\u9650\u308A\u306E\u6DF1\u3044\u9752\u2026",
    "Resort_Bar": "\u30AC\u30B9\u306E\u6D3B\u8E8D\u3001\u307F\u3093\u306A\u306F\u305D\u308C\u304C\u5927\u597D\u304D\u306A\u306E\u3002",
