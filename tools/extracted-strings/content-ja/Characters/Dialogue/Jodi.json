    "eventSeen_101": "\u304B\u308F\u3044\u305D\u3046\u306A\u30AF\u30EA\u30F3\u30C8\u2026 \u5F7C\u306F\u30A8\u30DF\u30EA\u30FC\u306E\u3053\u3068\u304C\u597D\u304D\u3089\u3057\u3044\u306E\u3002\u3067\u3082\u30A8\u30DF\u30EA\u30FC\u306F\u5F7C\u3092\u53CB\u9054\u3068\u3057\u304B\u601D\u3063\u3066\u306A\u3044\u3063\u3066\u805E\u3044\u305F\u308F\u2026",
