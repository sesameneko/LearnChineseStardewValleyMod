    "Resort_Leaving": "\u4ECA\u591C\u306F\u30B7\u30FC\u30D5\u30FC\u30C9\u306B\u3057\u3088\u3046\u304B\u3057\u3089\u3002$h",
    "Sat": "\u3053\u3093\u306B\u3061\u306F\u3002#$e#\u4F55\u304B \u7528\u304B\u3057\u3089\uFF1F",
    "Sat4": "\u3042\u306E \u53E4\u3044\u7267\u5834\u3092 \u826F\u304F\u3057\u3066\u304F\u308C\u3066\u3044\u308B \u307F\u305F\u3044\u3067 \u3046\u308C\u3057\u3044\u308F\u3002#$e#\u5168\u3066 \u9806\u8ABF\u306B \u306A\u3063\u305F\u3089\u3001 \u30B3\u30DF\u30E5\u30CB\u30C6\u30A3\u306B \u5927\u304D\u304F \u8CA2\u732E \u3067\u304D\u305D\u3046\u306D\uFF01$h#$e#\u3042\u306A\u305F\u306F\u3001 \u6CA2\u5C71\u306E\u4ED5\u4E8B\u3092 \u3053\u306A\u3059\u3053\u3068\u306B \u306A\u308B\u3051\u3069\u3002#$e#\u3058\u3083\u3042\u306D\u3002",
    "Sun": "#$c .5#\u4ECA\u65E5\u306E \u5BB6\u4E8B\u306F \u3053\u308C\u3050\u3089\u3044\u306B\u3059\u308B\u308F\u3002$h#$e#\u4ECA\u65E5\u306F \u3053\u308C\u3067 \u304A\u4F11\u307F\u3088\u3002$h#$e#\u3053\u308C\u4EE5\u4E0A \u5BB6\u306B \u9589\u3058\u3053\u3082\u3063\u3066\u305F\u3089\u3001 \u6C17\u304C\u5909\u306B\u306A\u3063\u3061\u3083\u3046\uFF01#$e#\u8DB3\u304C\u592A\u304F\u306A\u308B\u306E\u3082 \u30A4\u30E4\u3060\u3057\u3002",
    "Sun8": "\u81EA\u5206\u4EE5\u5916\u306E\u8AB0\u304B\u306B\u5C3D\u304F\u3059\u5FC5\u8981\u306E\u306A\u3044\u3001\u5B8C\u5168\u306B\u81EA\u7531\u3060\u3063\u305F\u5922\u3092\u898B\u3066\u305F\u308F\u3002#$b#\u2026\u3067\u3082\u76EE\u3092\u899A\u307E\u3059\u3068\u3001\u4E00\u65E5\u4E2D\u5BB6\u4E8B\u306B \u4ED8\u304D\u3063\u5207\u308A\u3063\u3066\u3044\u3046\u73FE\u5B9F\u304C\u5F85\u3063\u3066\u3044\u308B\u306E\u3088\u306D\u2026$s#$e#\u3067\u3082\u5BB6\u65CF\u3092\u6301\u3064\u3053\u3068\u306B\u5F8C\u6094\u306F\u306A\u3044\u308F\u3001@...\u3002\u30B5\u30E0\u305D\u3057\u3066\u30D3\u30F3\u30BB\u30F3\u30C8\u306F\u79C1\u306B\u3068\u3063\u3066\u3059\u3079\u3066\u3060\u3082\u306E\uFF01",
    "Thu": "\u3042\u306A\u305F\u3001\u7267\u5834\u4E3B\u306A\u3093\u3067\u3057\u3087\uFF1F\u3000\u9762\u767D\u3044\u308F\u306D\u3002#$e#\u7267\u5834\u4E3B\u306B \u4F1A\u3063\u305F\u3053\u3068\u304C \u306A\u304B\u3063\u305F\u306E\u3002#$e#\u91CE\u83DC\u306E \u80B2\u3066\u65B9\u3092 \u3044\u3064\u304B \u6559\u3048\u3066\u304F\u308C\u308B\u304B\u3057\u3089\u3002$h",
    "Thu6": "\u6642\u304C\u904E\u304E\u308B\u306E\u3063\u3066 \u3042\u3063\u3068\u3044\u3046\u9593\u306D\u3002\u306F\u3041\u2026#$e#\u30B5\u30E0\u304C \u30AA\u30E0\u30C4\u3092 \u3064\u3051\u3066\u3044\u305F \u9803\u306E\u3053\u3068\u3082 \u899A\u3048\u3066\u308B\u308F\u3002\u3042\u306E\u9803\u306E \u30B5\u30E0\u306F \u672C\u5F53\u306B \u304B\u308F\u3044\u304B\u3063\u305F\u3002$s#$e#\u3053\u308C\u3001\u3042\u306E\u5B50\u306B\u306F \u5185\u7DD2\u3088\u3002$h#$e#\u79C1\u3068 \u304A\u8A71\u3059\u308B\u306E\u304C \u672C\u5F53\u306B \u597D\u304D\u306A\u306E\u306D\u3002",
    "Tue": "\u904B\u52D5\u306F \u5065\u5EB7\u3092 \u4FDD\u3064\u306E\u306B \u91CD\u8981\u3088\u3002\u79C1\u306F \u904B\u52D5\u306E\u6642\u9593\u3092 \u3061\u3083\u3093\u3068 \u53D6\u308B\u3088\u3046\u306B \u3057\u3066\u3044\u308B\u308F\u3002#$e#\u89AA\u3060\u304B\u3089\u3001 \u81EA\u8EAB\u306B \u8CBB\u3084\u305B\u308B\u6642\u9593\u304C \u3042\u3093\u307E\u308A\u306A\u3044\u3051\u3069\u306D\u3002\u3060\u304B\u3089 \u6642\u9593\u306F \u6709\u52B9\u306B \u4F7F\u3044\u305F\u3044\u306E\u3002",
    "Wed": "\u306A\u3093\u3066\u8A00\u3063\u305F\u306E\uFF1F\u3082\u3046 %time \u306A\u306E\uFF1F\u3042\u3042\uFF01#$e#\u307E\u3060\u3084\u308B\u3053\u3068\u304C \u6CA2\u5C71 \u3042\u308B\u306E\u306B\uFF01$s",
