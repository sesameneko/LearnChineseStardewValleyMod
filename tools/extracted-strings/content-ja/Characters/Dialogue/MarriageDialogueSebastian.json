  "entries": {
    "Bad_5": "\u306A\u3041\u3001 \u3061\u3087\u3063\u3068 \u4E00\u4EBA\u306B \u306A\u308A\u305F\u3044\u3093\u3060\u3002\u5C11\u3057\u306E\u9593\u3001 \u304A\u524D\u306F \u5916\u3067 \u81EA\u5206\u306E\u3053\u3068\u3092 \u3084\u3063\u305F\u3089 \u3069\u3046\u3060\uFF1F",
    "Bad_6": "\u4F55\u306E\u7528\u3060\uFF1F\u307E\u308B\u3067 \u7FA9\u7236\u3055\u3093 \u307F\u305F\u3044\u306A\u3053\u3068\u3092 \u8A00\u3046\u306A\u3002\u3042\u3063\u3061\u3078 \u884C\u3063\u3066\u304F\u308C\u3002$a",
    "Bad_7": "\u3053\u306E \u5834\u6240\u304C \u5893\u5834\u307F\u305F\u3044\u306B \u601D\u3048\u3066\u304D\u305F\u3088\u3002$s",
    "Bad_8": "\u307E\u305F \u30BF\u30D0\u30B3\u3092 \u306F\u3058\u3081\u305F\u3088\u2026\u6700\u8FD1 \u30B9\u30C8\u30EC\u30B9\u304C \u305F\u307E\u3063\u3066\u304D\u305F\u304B\u3089\u306A\u3002$s",
    "Good_0": "\u306D\u3047\u3001\u30AA\u30EC\u3092 \u898B\u3066\u304F\u308C\u3002\u304A\u524D\u306F \u30AA\u30EC\u306E \u5168\u3066\u3060\u2026 \u611B\u3057\u3066\u308B\u3063\u3066 \u3053\u3068\u3092 \u5FD8\u308C\u306A\u3044\u3067\u304F\u308C\u3002$l#$b#\u3055\u3042\u3001 \u304A\u91D1\u3092 \u7A3C\u304E\u306B \u884C\u304F\u3093\u3060\u3002$h",
    "Good_1": "\u306A\u3041\u2026 \u3053\u3063\u3061\u3078 \u304D\u3066\u304F\u308C\u3002\u4ECA\u65E5\u306F \u30A4\u30B1\u3066\u308B\u306A\u3002$l",
    "Good_2": "\u4E00\u65E5\u3058\u3085\u3046 \u7267\u5834\u306E \u4ED5\u4E8B\u3092\u3057\u3066 \u6C5A\u308C\u3066\u3082\u3001 \u304A\u524D\u304C \u30B9\u30C6\u30AD\u306A\u306E\u306F \u5909\u308F\u3089\u306A\u3044\u306A\u3002$l",
    "Good_3": "\u3042\u3093\u307E\u308A \u8868\u306B\u306F \u51FA\u3055\u306A\u3044\u304C\u3001 \u304A\u524D\u306E \u592B\u306B \u306A\u3063\u3066 \u3068\u3066\u3082 \u5E78\u305B\u3060\u305C\u3002\u304A\u524D\u3068\u306E \u7D50\u5A5A\u306F\u3001 \u30AA\u30EC\u306E\u4EBA\u751F\u3067 \u6700\u5584\u306E\u6C7A\u65AD \u3060\u3063\u305F\u306A\u3002$l",
    "Good_4": "\u30AA\u30EC\u306E\u3053\u3068\u306F \u307E\u3063\u305F\u304F \u6C17\u306B\u3057\u306A\u304F\u3066\u3082\u3044\u3044\u3002\u4E00\u4EBA\u3067 \u6642\u9593\u3092\u904E\u3054\u3059\u306E\u304C \u597D\u304D\u3060\u304B\u3089\u306A\u3002",
    "Good_5": "\u6642\u3005 \u6012\u308A\u304C \u3053\u307F\u4E0A\u3052\u3066\u6765\u308B\u304C\u2026 \u304A\u524D\u3092 \u898B\u308B\u3068 \u3044\u3064\u3082 \u843D\u3061\u7740\u304F\u3093\u3060\u3002$7#$e#\u305F\u3076\u3093\u3001 \u5E74\u3092\u53D6\u308C\u3070 \u30AA\u30EC\u3082 \u6E29\u539A\u306B\u306A\u308B\u3093\u3060\u308D\u3046\u306A\u3002",
    "Good_6": "\u304A\u524D\u306F \u30BF\u30D5\u3060\u3063\u3066 \u5206\u304B\u3063\u3066\u308B\u3051\u3069\u3001 \u6642\u3005 \u5FC3\u914D\u306B \u306A\u308B\u3093\u3060\u3002\u30E9\u30A4\u30D5 \u30A8\u30EA\u30AF\u30B5\u30FC\u3084 \u786C\u3044 \u30D6\u30FC\u30C4\u3092 \u6301\u305F\u305A\u306B \u30E2\u30F3\u30B9\u30BF\u30FC\u72E9\u308A\u306B \u51FA\u308B\u306A\u3088\u3002 \u3044\u3044\u306A\uFF1F",
    "Good_8": "\u4ECA\u65E5\u306F \u672C\u5F53\u306B \u4F55\u3082\u3057\u305F\u304F\u306A\u3044 \u6C17\u5206\u3060\u3002\u30C6\u30EC\u30D3\u3067\u3082 \u898B\u308B\u304B\u306A\u3002",
    "Good_9": "\u53CB\u9054\u306A\u3093\u3066 \u3044\u3089\u306A\u3044\u3002\u304A\u524D\u3055\u3048 \u3044\u308C\u3070\u3001 \u305D\u308C\u3067\u3044\u3044\u3093\u3060\u3002\u5909\u3060\u3068 \u601D\u3046\u304B\uFF1F#$e#\u307E\u3042\u3001 \u30AA\u30EC\u306F \u307F\u3093\u306A\u3068\u306F \u9055\u3046\u3057\u3002",
    "Indoor_Day_0": "\u5E74\u3092\u53D6\u308B\u306B \u3064\u308C\u3066\u3001 \u90FD\u4F1A\u3078\u306E \u9B45\u529B\u304C \u8584\u308C\u3066\u3044\u304F\u3093\u3060\u3002\u78BA\u304B\u306B \u795E\u79D8\u7684\u306A \u611F\u3058\u306F \u3042\u3063\u305F\u3055\u3002\u3067\u3082 \u5B9F\u306F \u305F\u3060\u306E \u30ED\u30DE\u30F3\u30B9\u30D5\u30A1\u30F3\u30BF\u30B8\u30FC \u3060\u3063\u305F\u3002#$e#\u90FD\u4F1A\u306F \u4EBA\u3067 \u6EA2\u308C\u304B\u3048\u3063\u305F \u5FD9\u3057\u3044 \u5834\u6240\u3067\u2026\u30AA\u30EC\u306B\u306F \u5408\u308F\u306A\u3044\u3002\u7FA4\u308C\u308B\u30BF\u30A4\u30D7\u3058\u3083 \u306A\u3044\u304B\u3089\u306A\u3002",
    "Indoor_Day_1": "\u306A\u3041\u2026 \u30B3\u30FC\u30D2\u30FC \u98F2\u3080\u304B\uFF1F[395]$7#$e#\u30AA\u30EC\u306F \u5C11\u3057 \u98F2\u307F\u305F\u304B\u3063\u305F\u3093\u3060\u2026 \u60AA\u5922\u306E\u305B\u3044\u3067 \u65E9\u304F\u306B\u8D77\u304D\u3066\u3001 \u4E8C\u5EA6\u5BDD \u3067\u304D\u306A\u304B\u3063\u305F\u304B\u3089\u306A\u3002",
    "Indoor_Day_2": "\u6628\u6669\u306F \u7720\u308C\u306A\u304B\u3063\u305F\u304B\u3089\u3001 \u30D0\u30A4\u30AF\u3067 \u5C11\u3057 \u51FA\u304B\u3051\u3066\u305F\u3002#$e#\u7D50\u5A5A\u3057\u305F \u5F8C\u3067\u3082\u3001 \u3053\u3046\u3084\u3063\u3066 \u4E00\u4EBA\u3067 \u52D5\u304D\u305F\u3044\u3093\u3060\u3002\u305D\u308C\u304C \u30AA\u30EC\u306E \u3042\u308A\u65B9 \u3060\u304B\u3089\u306A\u3002\u3067\u3082 \u304A\u524D\u306E\u3053\u3068\u306F \u611B\u3057\u3066\u308B\u3002$7",
    "Indoor_Day_3": "\u306D\u3047\u3001\u6628\u6669\u306F \u7720\u308C\u305F\u304B\uFF1F\u5BDD\u8A00\u304C \u805E\u3053\u3048\u305F\u305E\u3002#$e#\u4F55\u304B \u6016\u304C\u3063\u3066\u305F \u3088\u3046\u3060\u304C\u3001\u6B63\u76F4\u306A\u3068\u3053\u308D\u2026 \u304B\u308F\u3044\u304F \u898B\u3048\u305F\u306A\u3002$l",
    "Indoor_Day_4": "\u304A\u524D\u3068 \u4E00\u7DD2\u306B \u751F\u6D3B\u3057\u3066\u3044\u308B\u3068\u3001 \u9589\u3058\u3053\u3082\u308B\u306E\u3092\u3000\u5C11\u3057\u3067\u3082 \u3084\u3081\u308B\u3088\u3046 \u8A00\u308F\u308C\u3066\u308B \u611F\u3058\u3060\u3002\u30AA\u30EC\u306B\u3068\u3063\u3066\u306F \u3044\u3044\u3053\u3068 \u3060\u308D\u3046\u306A\u3002$7",
    "Indoor_Night_0": "\u306D\u3047\u3001\u4ECA\u65E5\u306F \u5BB6\u306E\u5468\u308A\u3092 \u30D6\u30E9\u30D6\u30E9 \u3057\u3066\u305F\u3093\u3060\u3002\u666E\u901A\u306E \u4E00\u65E5 \u3060\u3063\u305F\u306A\u2026#$e#\u2026#$e#\u5BB6\u304B\u3089\u898B\u308B \u666F\u8272\u306F \u6700\u9AD8\u3060\u306A\u3002\u7384\u95A2\u304B\u3089\u3001 \u65E5\u66AE\u308C\u6642\u306E \u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3\u3092 \u898B\u308B\u3053\u3068\u304C \u3067\u304D\u308B\u3057\u3002",
    "Indoor_Night_1": "\u305F\u3076\u3093\u3001 \u30B3\u30FC\u30D2\u30FC\u3092 \u98F2\u307F\u3059\u304E\u305F \u304B\u3082\u306A\u2026\u307E\u3063\u305F\u304F \u75B2\u308C\u3092 \u611F\u3058\u306A\u3044\u305C\u3002#$e#\u7267\u5834\u306E \u751F\u6D3B\u30EA\u30BA\u30E0\u306B \u3042\u308F\u305B\u3088\u3046\u3068 \u3057\u3066\u308B\u3093\u3060\u3002\u524D\u306F\u3001 \u5348\u5F8C2\u6642\u306B \u8D77\u304D\u3066 \u5348\u524D5\u6642\u306B \u5BDD\u308B \u6642\u3082 \u3042\u3063\u305F\u304B\u3089\u306A\u3002$h",
    "Indoor_Night_2": "\u4FFA\u9054\u3060\u3051\u306E \u5834\u6240\u3092 \u3082\u3066\u308B\u306E\u3063\u3066 \u6700\u9AD8\u3060\u306A\u3002\u8AB0\u306B\u3082 \u90AA\u9B54 \u3055\u308C\u308B\u3053\u3068\u306A\u304F\u3001 \u3084\u308A\u305F\u3044\u3053\u3068\u3092 \u81EA\u7531\u306B \u3084\u308C\u308B\u3002#$e#\u30AA\u30EC\u304C \u3044\u306A\u304F\u306A\u3063\u3066\u3001 \u30DE\u30EB\u306F \u6E05\u3005\u3057\u305F \u3060\u308D\u3046\u306A\u3002",
    "Indoor_Night_3": "\u3055\u3063\u304D \u7A93\u304B\u3089 \u30B3\u30A6\u30E2\u30EA\u304C\u3000\u898B\u3048\u305F\u3093\u3060\u3002\u30B3\u30A6\u30E2\u30EA\u306F \u7D50\u69CB \u898B\u3048\u306B\u304F\u3044\u304C\u3001 \u96C6\u4E2D\u3057\u3066 \u826F\u304F\u307F\u308C\u3070\u3001 \u30C1\u30E9\u30C3\u3068 \u898B\u3048\u308B\u3060\u308D\u3046\u3002\u305D\u306E\u8FBA\u306B \u3044\u308B\u306F\u305A\u3060\u3002",
    "Indoor_Night_4": "\u5B9F\u5BB6\u3067\u306F \u3088\u304F\u3001 \u53D7\u3051\u5165\u308C\u3089\u308C\u3066\u306A\u3044 \u6C17\u5206\u306B \u306A\u3063\u305F\u3055\u2026 \u3067\u3082 \u3053\u3053\u306F \u81EA\u5206\u306E \u672C\u5F53\u306E \u5C45\u6240 \u307F\u305F\u3044\u306B \u611F\u3058\u308B\u3002@\u3001\u30AA\u30EC\u3092 \u53D7\u3051\u5165\u308C\u3066\u304F\u308C\u3066 \u3042\u308A\u304C\u3068\u3046\u306A$l",
    "Neutral_0": "\u6563\u6B69\u306E\u6642\u3001 \u3067\u304D\u308B\u3060\u3051 \u4EBA\u3092 \u907F\u3051\u3088\u3046\u3068 \u3057\u3066\u308B\u3093\u3060\u3002\u5C11\u3057 \u8A71\u3092 \u3057\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u3063\u3066 \u5727\u529B\u304C \u5ACC\u3044\u3060\u304B\u3089\u306A\u3002",
    "Neutral_2": "\u4ECA\u591C\u3001 \u30D9\u30C3\u30C9\u3067 \u304A\u524D\u306E \u4E00\u65E5\u306B \u3064\u3044\u3066 \u805E\u304B\u305B\u3066\u304F\u308C\u306A\u3044\u304B\uFF1F\u4ECA\u306F \u5FD9\u3057\u3044\u3093\u3060\u2026",
    "Neutral_3": "\u4ECA\u65E5\u306F \u753A\u3078 \u3044\u304F\u306E\u304B\uFF1F\u305D\u3053\u3067 \u4F55\u3092\u3059\u308B \u3064\u3082\u308A\u306A\u3093\u3060\uFF1F",
    "Neutral_4": "\u4ECA\u65E5\u306F \u6D17\u6FEF\u3092 \u3067\u304D\u308B\u306F\u305A\u3060\u2026\u304A\u524D\u306F \u7267\u5834\u306E \u904B\u55B6\u3067 \u5FD9\u3057\u3044 \u3060\u308D\u3046\u3057\u3002",
    "Neutral_5": "\u304A\u91D1\u306B\u306F \u56F0\u3063\u3066\u306A\u3044\u304B\uFF1F\u30AA\u30EC\u306E \u30CE\u30FC\u30C8PC\u3092 \u58F2\u308B\u306F \u30A4\u30E4\u3060\u305C\u2026",
    "Neutral_6": "\u3082\u3057 \u753A\u306E \u53CB\u9054\u3068 \u4F1A\u3044\u305F\u3051\u308C\u3070\u3001 \u304B\u307E\u308F\u306A\u3044\u305C\u3002\u3084\u3063\u3071\u308A \u30AA\u30EC\u306F \u4E00\u4EBA\u306E\u307B\u3046\u304C \u843D\u3061\u7740\u304F \u304B\u3089\u306A\u3002",
    "Neutral_8": "\u5BB6\u306E\u6383\u9664\u306F \u697D\u3057\u304F\u306A\u3044\u304C\u3001 \u97F3\u697D\u3092\u8074\u304D\u306A\u304C\u3089 \u3084\u308B\u3068 \u7D50\u69CB \u65E9\u304F \u7D42\u308F\u308B\u3082\u3093\u3060\u306A\u3002",
    "OneKid_0": "\u307E\u3060 \u7236\u89AA\u3068\u3057\u3066\u306E \u751F\u6D3B\u306B \u6163\u308C\u3088\u3046\u3068 \u3057\u3066\u308B\u3068\u3053\u308D\u3055\u3002\u5927\u4E08\u592B\u3001 %kid1\u306E \u9762\u5012\u306F \u898B\u3066\u3084\u308B\u304B\u3089\uFF01\u305F\u3060\u2026 \u65B0\u3057\u3044 \u7D4C\u9A13\u3060\u304B\u3089\u306A\u3002",
    "OneKid_1": "%kid1\u304C \u3082\u3046\u5C11\u3057 \u5927\u304D\u304F\u306A\u3063\u305F\u3089\u3001 \u30D0\u30A4\u30AF\u306B \u30B5\u30A4\u30C9\u30AB\u30FC\u3092 \u3064\u3051\u3066\u3001 \u307F\u3093\u306A\u3067 \u30C4\u30FC\u30EA\u30F3\u30B0\u3067\u3082 \u3057\u3088\u3046\u304B\u3002$h",
    "OneKid_3": "%kid1\u306E \u5302\u3044\u3092 \u304B\u3044\u3060\u304B\uFF1F\u305D\u308D\u305D\u308D \u304A\u98A8\u5442\u306B \u5165\u308C\u3066\u3084\u308B\u304B\u2026",
    "Outdoor_0": "\u4ECA\u65E5\u306F \u4F55\u304B\u3092 \u3057\u305F\u3044 \u6C17\u5206\u3060\u304C\u2026 \u305D\u306E \u4F55\u304B\u304C \u601D\u3044\u3064\u304B\u306A\u3044\u3002@\u3082 \u305D\u3093\u306A\u3053\u3068\u304C \u3042\u308B\u304B\uFF1F",
    "Outdoor_1": "\u3046\u30FC\u3093\u2026 \u5065\u5EB7\u306E\u305F\u3081\u306B \u6642\u3005 \u5916\u3078 \u51FA\u308B\u3088\u3046 \u81EA\u5206\u306B \u8A00\u3044\u805E\u304B\u305B\u306A\u304D\u3083\u306A\u3002#$e#\u3088\u304F \u308F\u304B\u3089\u306A\u3044\u3051\u3069\u3001 \u5C4B\u5185\u306E\u307B\u3046\u304C \u597D\u304D\u3060\u3002\u3042\u306E \u6697\u3044 \u5730\u4E0B\u306E \u90E8\u5C4B\u306B \u6163\u308C\u3059\u304E\u305F \u3060\u3051\u304B\u3082\u306A\u3002",
    "Outdoor_2": "\u30AA\u30EC\u306F \u3053\u3053\u304B\u3089 \u304A\u524D\u3092 \u898B\u3066\u308B\u305C\u3002$h#$e#\u898B\u3066\u3044\u3066 \u697D\u3057\u3044\u304B\u3089\u306A\u3002",
    "Outdoor_3": "\u7D50\u5A5A\u3057\u305F\u3093\u3060\u304B\u3089\u3001 \u3053\u306E \u5F31\u3044\u4F53\u3092 \u4F55\u3068\u304B \u3057\u306A\u304D\u3083\u306A\u3002\u30C8\u30A6\u30AC\u30E9\u30B7\u3092 \u3082\u3063\u3068 \u98DF\u3079\u3066\u3001 \u4F53\u3092 \u52D5\u304B\u3057\u305F\u307B\u3046\u304C \u3044\u3044\u304B\uFF1F#$e#\u307E\u3041\u3001 \u305D\u3046\u601D\u3063\u305F\u3060\u3051\u3055\u2026$h",
    "Outdoor_4": "\u3082\u3063\u3068 \u30B9\u30E9\u30A4\u30E0\u3092 \u80B2\u3066\u3088\u3046\u305C\u2026\u5927\u898F\u6A21\u3067 \u80B2\u3066\u308C\u3070\u3001 \u305D\u308C\u306A\u308A\u306B \u3082\u3046\u304B\u308B\u306F\u305A\u3060\u3002\u305D\u308C\u306B \u98FC\u80B2\u3082 \u7C21\u5358\u3060\u304B\u3089\u306A\u3002#$e#\u3042\u3068\u3001 \u30B9\u30E9\u30A4\u30E0\u306E \u8272\u304C \u9055\u3046\u3068 \u751F\u7523\u7269\u3082 \u7570\u306A\u308B\u3002\u3088\u304F\u77E5\u3089\u306A\u3044\u3051\u3069\u3001 \u8DA3\u5473\u3068\u3057\u3066\u306F \u697D\u3057\u3044\u3093\u3058\u3083\u306A\u3044\u304B\u306A\u3002",
    "Rainy_Day_0": "\u3084\u3063\u3068\u2026 \u5927\u96E8\u304B\u3002\u6674\u308C\u306E\u65E5\u306F \u3059\u3050 \u98FD\u304D\u3066\u304F\u308B\u3093\u3060\u3088\u3002",
    "Rainy_Day_1": "\u306D\u3047\u3001\u524D\u306B \u4F4F\u3093\u3067\u3044\u305F \u5730\u4E0B\u306E \u90E8\u5C4B\u306E \u3053\u3068\u3092 \u8003\u3048\u3066\u305F\u3093\u3060\u3002\u4F4F\u307F\u5FC3\u5730\u306E \u3044\u3044\u5834\u6240 \u3060\u3063\u305F\u3051\u3069\u3001 \u3053\u3053\u306E\u307B\u3046\u304C \u3082\u3063\u3068 \u8208\u5473\u6DF1\u3044\u306A\u3002\u305D\u308C\u306B\u3001 \u3042\u306E\u5302\u3044\u3082 \u604B\u3057\u304F\u306A\u3044\u3057\u2026#$e#\u6BCD\u3055\u3093\u306E \u5BB6\u306B \u9577\u3044\u9593 \u4F4F\u3093\u3067\u3044\u305F\u3053\u3068\u304C \u6065\u305A\u304B\u3057\u304F \u601D\u3048\u308B\u3088\u3002",
    "Rainy_Day_2": "\u306D\u3047\u3001\u6628\u6669 \u7720\u308C\u306A\u304B\u3063\u305F\u304B\u3089\u3001 \u3061\u3087\u3063\u3068 \u6D1E\u7A9F\u307E\u3067 \u6563\u6B69 \u3057\u3066\u305F\u3093\u3060\u3002\u3053\u3093\u306A\u3082\u306E\u3092 \u898B\u3064\u3051\u305F\u3051\u3069\u2026 \u3044\u308B\uFF1F[575 769 767 84 66 78]#$e#\u6642\u3005 \u7720\u308C\u306A\u304F\u306A\u308B\u3051\u3069\u3001 \u305D\u308C\u306F \u304A\u524D\u306E \u305B\u3044\u3058\u3083\u306A\u3044\u3002\u611B\u3057\u3066\u308B\u3088\u3002$7",
    "Rainy_Day_3": "\u4ECA\u65E5\u306F \u305F\u3060 \u6A2A\u306B\u306A\u3063\u3066\u3001 \u672C\u3092 \u8AAD\u3080\u304B \u4F55\u304B\u3059\u308B\u306B\u306F \u826F\u3044\u65E5\u3060\u3068 \u601D\u3046\u3051\u3069\u2026 \u3069\u3046\u3060\u308D\u3046\uFF1F",
    "Rainy_Day_4": "\u4ECA\u65E5\u3082\u96E8\u304B\u2026 \u3044\u3044\u306A\u3002#$e#\u5BD2\u304C\u3063\u3066\u308B\u306A\u3089\u2026 \u3053\u3063\u3061\u3078 \u304A\u3044\u3067\u3002$l",
    "Rainy_Night_0": "\u7D50\u5A5A\u3057\u305F\u304B\u3089\u3001 \u7981\u7159 \u3057\u3088\u3046\u3068 \u304C\u3093\u3070\u3063\u3066\u308B\u3093\u3060\u2026\u304A\u524D\u3092 \u6B8B\u3057\u3066 \u6B7B\u306A\u306A\u3044\u3088\u3046\u306B\u306A\u3002\u30BF\u30D0\u30B3\u306F \u60AA\u3044 \u30AF\u30BB\u3060\u3002#$e#\u4FFA\u9054 \u4E8C\u4EBA\u306E \u672A\u6765\u306E \u307B\u3046\u304C \u5927\u4E8B\u3060\u3057\u306A\u3002$l",
    "Rainy_Night_1": "\u4ECA\u65E5\u306F \u30CE\u30FC\u30C8PC\u3067 \u4ED5\u4E8B\u3092 \u3057\u3066\u305F\u3093\u3060\u3002\u4F5C\u308A\u305F\u3044\u30B2\u30FC\u30E0\u306E \u30A2\u30A4\u30C7\u30A2\u3092 \u3072\u3089\u3081\u3053\u3046\u3068 \u3057\u3066\u3044\u305F \u3068\u3053\u308D\u3055\u3002#$e#\u304A\u524D\u306E \u7267\u5834\u306E \u53CE\u5165\u306E \u304A\u304B\u3052\u3067\u3001 \u30AA\u30EC\u306F \u3084\u308A\u305F\u3044\u3053\u3068\u304C \u81EA\u7531\u306B \u3067\u304D\u308B\u3002\u672C\u5F53\u306B \u3059\u3070\u3089\u3057\u3044 \u751F\u6D3B\u3060\u3002\u672C\u5F53\u306B \u3042\u308A\u304C\u3068\u3046\u3002$h",
    "Rainy_Night_2": "\u3042\u3042\u3001 \u5915\u98DF\u304C \u3067\u304D\u3066\u306A\u304F\u3066 \u3059\u307E\u306A\u3044\u3002\u51B7\u8535\u5EAB\u306E \u30D4\u30B6\u304B \u4F55\u304B\u3092 \u98DF\u3079\u3088\u3046\u304B\u3002#$e#\u307E\u3041\u3001 \u3061\u3087\u3063\u3068 \u4ED6\u306E\u3053\u3068\u306B \u6C17\u304C \u884C\u3063\u3066\u305F\u3093\u3060\u3002\u5BB6\u4E8B\u3092 \u5FD8\u308C\u306A\u3044\u3088\u3046\u306B \u3059\u308B\u306E\u3063\u3066 \u96E3\u3057\u3044\u306A\u2026",
    "Rainy_Night_3": "\u3042\u306A\u305F\u306E \u4E00\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\uFF1F\u30E2\u30F3\u30B9\u30BF\u30FC\u3068 \u6226\u3063\u305F\u304B\uFF1F$h#$e#\u6642\u3005 \u305D\u3046\u3084\u3063\u3066 \u30B9\u30C8\u30EC\u30B9\u3092 \u767A\u6563\u3057\u306B \u3044\u304F\u306E\u3082 \u826F\u3044\u3060\u308D\uFF1F",
    "Rainy_Night_4": "\u4ECA\u591C\u306F \u9B54\u5973\u304C \u5BB6\u306B \u6765\u308B\u304B\u306A\uFF1F\u30CF\u30C3\u2026 \u4EBA\u751F\u3001 \u305D\u3053\u307E\u3067 \u9762\u767D\u304F\u3082 \u306A\u3044\u304B\u2026",
    "TwoKids_0": "\u3061\u3083\u3093\u3068 \u5B50\u4F9B\u9054\u306B\u306F \u30E1\u30B7\u3092 \u98DF\u3079\u3055\u305B\u305F\u305E\u2026%kid2 \u307E\u305F\u3001 \u30AA\u30EC\u306E\u30B7\u30E3\u30C4\u304C \u30C1\u30E7\u30B3\u30DF\u30EB\u30AF\u307E\u307F\u308C\u306B \u306A\u3063\u305F\u3051\u3069\u306A\u3002",
    "TwoKids_1": "%kid1\u3068%kid2\u304C \u4EF2\u826F\u304F \u3057\u3066\u304F\u308C\u308B\u3068 \u3044\u3044\u3093\u3060\u304C\u306A\u3002\u30AA\u30EC\u306F \u6614\u3001 \u3044\u3064\u3082 \u30DE\u30EB\u3068 \u30B1\u30F3\u30AB\u3057\u3066\u305F\u3002#$e#\u3042\u306E\u9803\u3092 \u601D\u3044\u51FA\u3059\u3068\u3001 \u3060\u3044\u305F\u3044 \u30AA\u30EC\u304C \u60AA\u304B\u3063\u305F\u3093\u3060\u306A\u2026",
    "TwoKids_2": "\u6700\u8FD1\u3001 %kid2\u304C \u30B7\u30E3\u30C9\u30A6\u30B7\u30E3\u30FC\u30DE\u30F3\u306E \u8863\u88C5\u3092 \u7740\u3066\u3001 \u304B\u304C\u3084\u304F \u30AB\u30DC\u30C1\u30E3\u306E \u4E0A\u306B \u5EA7\u3063\u3066\u3044\u308B \u5922\u3092 \u4F55\u5EA6\u3082 \u898B\u308B\u3093\u3060\u3002\u5909\u306A \u5922\u3060\u308D\uFF1F",
    "TwoKids_3": "@\u3001 \u4FFA\u9054\u306F \u9577\u3044\u9053\u3092 \u6B69\u3093\u3067\u304D\u305F\u3093\u3060\u306A\u3002\u30AA\u30EC\u305F\u3061\u306E\u5BB6\u65CF\u3092\u898B\u3066\u307F\u308D\u3088\u3002\u6B63\u76F4\u3001 \u30AA\u30EC\u306F \u81EA\u5206\u304C \u3053\u3093\u306A\u3053\u3068\u306B \u306A\u308B\u306A\u3093\u3066 \u601D\u3044\u3082\u3057\u306A\u304B\u3063\u305F\u3002#$e#\u5B9F\u73FE\u3057\u305F \u4ECA\u3068\u306A\u3063\u3066\u306F \u6C17\u306B\u5165\u3063\u3066\u308B\u305C\u2026$l",
    "fall_1": "\u4E00\u6669\u3067 \u30D0\u30EC\u30FC \u5168\u4F53\u306E \u96F0\u56F2\u6C17\u304C \u5909\u308F\u3063\u305F \u611F\u3058\u3060\u2026\u79CB\u304C \u6765\u305F\u304B\u3089 \u3060\u308D\u3046\u306A\u3002",
    "fall_15": "\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC \u30D0\u30EC\u30FC \u30D5\u30A7\u30A2\u306F \u4EBA\u304C \u591A\u3059\u304E\u308B \u5370\u8C61\u304C \u3042\u308B\u306A\u2026 \u3067\u3082 \u30AA\u30EC\u306F\u3001 \u30B5\u30E0\u3068 \u4E00\u7DD2\u306B \u904A\u3076\u3064\u3082\u308A\u3055\u3002\u3042\u3044\u3064\u306E \u8FD1\u6CC1\u3092 \u77E5\u308B\u306E\u3082 \u826F\u3044\u3053\u3068\u3060\u3057\u306A\u3002#$e#\u304A\u524D\u3082 \u5C4B\u53F0\u3067 \u904A\u3093\u3060\u307B\u3046\u304C \u3044\u3044\u305C\uFF01\u4FFA\u306E\u3053\u3068\u306F \u6C17\u306B\u3059\u308B\u306A\u3002$7",
    "fall_26": "\u660E\u65E5\u306E \u30B9\u30D4\u30EA\u30C3\u30C8\u30A4\u30D6\u306B\u306F \u671F\u5F85\u3057\u3066\u308B\u3093\u3060\u3002\u3044\u3063\u305F\u3044 \u3069\u3093\u306A\u3082\u306E\u304C \u304A\u76EE\u306B\u304B\u304B\u308C\u308B\u304B\u3002$h",
    "funLeave_Sebastian": "\u4ECA\u65E5\u306F \u6563\u6B69\u306B \u884C\u304F \u3064\u3082\u308A\u3055\u3002\u4E00\u4EBA\u306B\u306A\u308B \u6642\u9593\u304C \u307B\u3057\u3044\u3093\u3060\u3002\u307E\u305F \u591C\u306B \u4F1A\u304A\u3046\u3002",
    "funReturn_Sebastian": "\u8A71\u3059\u3053\u3068\u306F \u3042\u307E\u308A \u306A\u3044\u304C\u3001 \u826F\u3044 \u4E00\u65E5\u3092 \u904E\u3054\u305B\u305F\u3088\u3002\u304A\u524D\u306E\u306F \u3069\u3093\u306A \u4E00\u65E5 \u3060\u3063\u305F\u304B\uFF1F",
    "patio_Sebastian": "\u30D0\u30A4\u30AF\u3067\u3061\u3087\u3063\u3068\u305D\u3053\u307E\u3067\u51FA\u304B\u3051\u3066\u304F\u308B\u3002\u306A\u306B\u304B\u8CB7\u3063\u3066\u3053\u3088\u3046\u304B\uFF1F",
    "spring_1": "\u3042\u3042\u2026\u982D\u304C\u75DB\u3044\u3002\u65B0\u5E74\u304A\u3081\u3067\u3068\u3046\u2026$h",
    "spring_12": "\u660E\u65E5\u306E \u796D\u308A\u3092 \u697D\u3057\u307F\u306B\u3057\u3066\u308B\u306E\u304B\uFF1F\u307E\u305F \u30B5\u30E0\u3068 \u4F1A\u3048\u308B\u306E\u304C \u697D\u3057\u307F\u3060\u306A\u3002",
    "spring_23": "\u3042\u3042\u2026 \u660E\u65E5\u306F \u30D5\u30E9\u30EF\u30FC\u30C0\u30F3\u30B9 \u3060\u3063\u305F\u304B\uFF1F\u884C\u304B\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u306E\u304B\uFF1F#$e#\u3042\u306E \u304D\u3064\u304F\u3066 \u3072\u3069\u3044 \u30B8\u30E3\u30F3\u30D7\u30B9\u30FC\u30C4\u3092 \u7740\u308B\u306E\u306F \u30A4\u30E4\u306A\u3093\u3060\u3002\u306A\u3093\u3067 \u30EB\u30A4\u30B9 \u5E02\u9577\u306F \u3042\u3093\u306A\u3053\u3068\u3092 \u3055\u305B\u308B\u3093\u3060\uFF1F$s",
    "summer_1": "\u590F\u304C\u6765\u305F\u304B\u2026\u3053\u306E \u8272\u767D\u306A \u808C\u3092 \u7DAD\u6301\u3059\u308B\u306B\u306F\u3001 \u65E5\u713C\u3051\u6B62\u3081\u3092 \u5927\u91CF\u306B \u5857\u3089\u306A\u304D\u3083 \u3044\u3051\u306A\u3044\u306A\u2026",
    "summer_10": "\u4ECA\u591C\u306E \u30EB\u30A2\u30A6\u30B9\u30FC\u30D7\u306B \u4F55\u3092 \u5165\u308C\u308B\u304B \u8003\u3048\u305F\u304B\uFF1F#$e#\u30AA\u30EC\u306F \u4F55\u304C \u3044\u3044\u304B \u5206\u304B\u3089\u306A\u3044\u304C\u306A\u2026 \u304A\u524D\u304C \u6C7A\u3081\u3066\u304F\u308C\uFF01$7",
    "summer_27": "\u6DBC\u3057\u304F \u306A\u308A\u306F\u3058\u3081\u305F\u306A\u3002\u3044\u3044\u611F\u3058\u3060\u3002#$e#\u660E\u65E5\u306E\u591C\u306F \u4E00\u7DD2\u306B \u796D\u308A\u3078 \u884C\u304B\u306A\u3044\u304B\uFF1F\u30AA\u30EC\u306F \u5B9F\u969B\u306E\u3068\u3053\u308D \u796D\u308A\u3092 \u697D\u3057\u3081\u3066\u308B\u3093\u3060\u3002$7",
    "winter_1": "\u3053\u306E \u51AC\u306F \u4F55\u3092 \u4E88\u5B9A\u3057\u3066\u308B\u3093\u3060\uFF1F\u304A\u524D\u306B \u3068\u3063\u3066\u306F \u3086\u3063\u304F\u308A\u3067\u304D\u308B \u6642\u671F\u3060\u308D\u3046\u3051\u3069\u3002",
    "winter_28": "@\u3001 \u826F\u3044 \u4E00\u5E74\u3092 \u3042\u308A\u304C\u3068\u3046\u3002\u3061\u3087\u3063\u3068\u306F \u795D\u304A\u3046\u304B\u3002[346]$h#$e#\u6765\u5E74\u306F \u3082\u3063\u3068 \u3044\u3044\u5E74\u306B \u306A\u308B\u306F\u305A\u3055\u3002$7",
    "winter_7": "\u660E\u65E5\u306E \u91E3\u308A\u30B3\u30F3\u30C6\u30B9\u30C8\u306B\u306F \u53C2\u52A0\u3059\u308B \u3064\u3082\u308A\u304B\uFF1F"
  }
}