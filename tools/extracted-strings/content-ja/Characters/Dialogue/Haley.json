    "Event_clean2": "\u30A4\u30E4\u3088\uFF01\u7D76\u5BFE\u306B\u3084\u308A\u305F\u304F\u306A\u3044\u308F\uFF01$a#$b#\u4E8C\u4EBA\u3068\u3082 \u30D0\u30AB\u306D\uFF01%fork$a",
