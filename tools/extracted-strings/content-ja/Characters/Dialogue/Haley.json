    "Introduction": "\u3042\u3089\u2026\u3042\u306A\u305F\u304C\u65B0\u3057\u304F\u7267\u5834\u306B\u6765\u305F\u7537\u306E\u4EBA\uFF1F^\u3042\u3089\u2026\u3042\u3089\u2026\u3042\u306A\u305F\u304C\u65B0\u3057\u304F\u7267\u5834\u306B\u6765\u305F\u5973\u306E\u5B50\u3001\u3060\u3063\u305F\u304B\u3057\u3089\uFF1F#$e#\u3048\u3063\uFF1F\u3042\u3042\u2026\u79C1\u306F\u30D8\u30A4\u30EA\u30FC\u3088\u3002#$e#\u3075\u30FC\u3093\u2026\u3042\u306A\u305F\u3001 \u670D\u306F\u3068\u3063\u3066\u3082 \u30C0\u30B5\u3044\u3051\u3069 \u9854\u306F\u7D50\u69CB \u3044\u3044\u308F\u306D\u3002^\u3075\u30FC\u3093\u2026\u3042\u306A\u305F\u3001 \u670D\u306F\u3068\u3063\u3066\u3082 \u30C0\u30B5\u3044\u3051\u3069 \u9854\u306F\u7D50\u69CB \u304B\u308F\u3044\u3044\u306E\u306D\u2026\u307E\u3041\u3001 \u6C17\u306B\u3057\u306A\u3044\u3067\u3002$h",
    "Mon": "\u3053\u306E\u753A\u306F \u5C0F\u3055\u3059\u304E\u308B\u308F\u3002\u307B\u3093\u3068 \u30A4\u30E4\u306B\u306A\u3063\u3061\u3083\u3046\u3002$u#$e#\u3044\u3044\u670D\u3092 \u8CB7\u304A\u3046\u306B\u3082 \u8ECA\u3067 \u9060\u304F\u307E\u3067 \u51FA\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u3057\u3002$s#$e#\u3060\u304B\u3089\u3001 \u666E\u6BB5\u306F \u901A\u8CA9\u306B \u983C\u3063\u3066\u308B\u306E\u3088\u3002#$e#\u4F55\u304B\u3057\u3089\uFF1F",
    "Mon6": "\u6700\u521D\u306F \u3053\u306E\u753A\u306E \u5C0F\u3055\u3055\u306B \u6587\u53E5\u3092\u8A00\u3063\u3066\u305F\u3051\u3069\u3001 \u4ECA\u306F \u597D\u304D\u306B \u306A\u3063\u3066\u304D\u305F\u304B\u306A\u3002#$e#\u5927\u304D\u306A\u753A\u3058\u3083 \u89AA\u3057\u307F\u304C \u3082\u3066\u306A\u3055\u305D\u3046\u3060\u304B\u3089\u306D\u3002",
