    "Fri2": "\u7267\u5834\u3067 \u8D70\u308A\u56DE\u3063\u305F\u308A\u3001 \u6C57\u6C34\u305F\u3089\u3057\u3066 \u50CD\u304F\u306E\u3063\u3066 \u75B2\u308C\u305F\u308A\u3057\u306A\u3044\uFF1F#$e#\u4F53\u3058\u3085\u3046 \u571F\u307E\u307F\u308C\u306B\u306A\u308B\u306A\u3093\u3066 \u79C1\u306F \u30B4\u30E1\u30F3\u3060\u308F\u3002#$e#\u3067\u3082\u3001 \u3044\u3044\u611F\u3058\u306B \u65E5\u713C\u3051\u3057\u3066\u308B\u3058\u3083\u306A\u3044\u3002",
    "Fri6": "\u30B7\u30E7\u30C3\u30D4\u30F3\u30B0\u4EE5\u5916\u306E \u8DA3\u5473\u3092 \u898B\u3064\u3051\u306A\u304D\u3083\u3002#$e#\u3082\u3063\u3068\u5E83\u3044 \u8996\u91CE\u3092 \u6301\u3068\u3046\u3063\u3066 \u6C7A\u3081\u305F\u306E\u3088\u3002#$e#\u30DF\u30CB\u30CF\u30FC\u30D7\u3067\u3082 \u5B66\u307C\u3046\u304B\u3057\u3089\uFF1F",
    "GreenRain": "\u4ECA\u307E\u3067\u3001\u3053\u3053\u306B\u306F\u6765\u305F\u3053\u3068\u306F\u306A\u3044\u3068\u601D\u3046\u3002\u3067\u3082\u5C45\u5FC3\u5730\u304C\u3044\u3044\u308F\u306D\uFF01$h#$e#\u79C1\u306F\u96E8\u306E\u3053\u3068\u306F\u4F55\u3082\u5FC3\u914D\u3057\u3066\u306A\u3044\u306E\u3002\u304D\u3063\u3068\u3059\u3050\u306B\u3042\u304C\u308B\u308F\u3002",
