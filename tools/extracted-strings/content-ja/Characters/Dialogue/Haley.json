    "Resort_Bar": "\u30AC\u30B9\u304C\u79C1\u306E\u305F\u3081\u306B\u3001\u30AD\u30E5\u30FC\u30C8\u3067\u30D5\u30EB\u30FC\u30C6\u30A3\u30FC\u306A\u98F2\u307F\u7269\u3092\u4F5C\u3063\u3066\u304F\u308C\u305F\u306E\uFF01$h",
    "Resort_Chair": "\u6D77\u306B\u5408\u308F\u305B\u3066\u8DB3\u306E\u722A\u3092\u9752\u304F\u5857\u3063\u3066\u307F\u305F\u306E\u3002\u3069\u3046\u304B\u3057\u3089\uFF1F\uFF08\u304F\u306D\u304F\u306D\uFF09\uFF08\u304F\u306D\u304F\u306D\uFF09$h",
    "Resort_Entering": "\u6765\u308B\u9014\u4E2D\u306B\u30A4\u30EB\u30AB\u3092\u898B\u305F\u308F\uFF01",
    "Resort_Leaving": "\u5FC3\u5730\u3088\u3055\u3092\u611F\u3058\u3055\u305B\u3066\u304F\u308C\u308B\u3001\u305D\u3093\u306A\u529B\u304C\u592A\u967D\u306B\u306F\u3042\u308B\u308F\u306D\u3002",
    "Resort_Shore": "\u4E0D\u601D\u8B70\u306D\u3001\u4EBA\u751F\u306E\u5DE1\u308A\u5408\u308F\u305B\u3067\u8272\u3093\u306A\u5834\u6240\u306B\u884C\u3051\u308B\u2026\u3053\u306E\u5411\u3053\u3046\u306B\u306F\u3069\u3093\u306A\u4E16\u754C\u304C\u3042\u308B\u306E\u304B\u3057\u3089\uFF1F",
    "Resort_Shore_2": "\u308F\u3042\u3001\u898B\u3066\u3001\u592A\u967D\u3067\u6C34\u9762\u304C\u30AD\u30E9\u30AD\u30E9\u8F1D\u3044\u3066\u308B\u308F\uFF01$h#$b#\u3053\u306E\u5915\u65E5\u3092\u64AE\u5F71\u3057\u305F\u3089\u7D20\u6674\u3089\u3057\u3044\u5199\u771F\u306B\u306A\u308B\u3067\u3057\u3087\u3046\u306D\u3002#$e#\u6B21\u306B\u6765\u308B\u6642\u306F\u3001\u7D76\u5BFE\u306B\u30AB\u30E1\u30E9\u3092\u6301\u3063\u3066\u3053\u306A\u304F\u3063\u3061\u3083\u3002",
