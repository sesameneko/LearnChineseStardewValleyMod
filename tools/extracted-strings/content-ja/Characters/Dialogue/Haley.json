    "FlowerDance_Accept": "\u3042\u3089\u2026 \u300C\u79C1\u300D\u3068\u30C0\u30F3\u30B9\u3092\u8E0A\u308A\u305F\u3044\u306E\uFF1F$13^\u30DB\u30F3\u30C8\u306B\uFF1F\u3044\u3044\u308F\uFF01\u3044\u3063\u3057\u3087\u306B\u8E0A\u308A\u307E\u3057\u3087\u3046\uFF01#$b#\u30D5\u30D5\u30D5\u2026 \u3082\u3061\u308D\u3093\u3058\u3083\u306A\u3044\u3002\u3042\u306A\u305F\u3068\u30D1\u30FC\u30C8\u30CA\u30FC\u306B\u306A\u308A\u305F\u304B\u3063\u305F\u306E\u3002$h^\u7D20\u6575\u306A\u6642\u9593\u3092\u904E\u3054\u3057\u307E\u3057\u3087\u3046\uFF01$h#$e#\u3075\u30FC\u3093\u2026\u3042\u306A\u305F\u306F\u81EA\u4FE1\u5BB6\u306A\u306E\u306D\u3002\u307F\u3093\u306A\u6065\u305A\u304B\u3057\u304C\u3063\u3066\u79C1\u3092\u3055\u305D\u308F\u306A\u3044\u306E\u3002^\u4ECA\u65E5\u306E\u3042\u306A\u305F\u306F\u3068\u3066\u3082\u9B45\u529B\u7684\u3088\uFF01$h",
    "FlowerDance_Accept_Spouse": "\u306F\u3041\u2026 \u30D5\u30E9\u30EF\u30FC\u30C0\u30F3\u30B9\u306E \u5973\u738B\u306E \u65E5\u3005\u306F \u7D42\u308F\u3063\u305F\u304B\u3089\u2026 \u79C1\u306B\u3068\u3063\u3066\u306F \u307B\u308D\u82E6\u3044 \u30C0\u30F3\u30B9\u306B\u306A\u308B\u306E\u306D\u3002$s#$b#\u3067\u3082 \u3044\u3044\u308F\u3088\u2026",
    "FlowerDance_Decline": "\u3048\u30FC\u2026\u30A4\u30E4\u3088\u3002",
    "Fri": "%\u30D8\u30A4\u30EA\u30FC\u306B \u7121\u8996\u3055\u308C\u3066\u3044\u308B\u3002",
