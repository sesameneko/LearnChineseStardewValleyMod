    "Bad_7": "\u4EE5\u524D\u306F \u7279\u5225\u306A\u611F\u3058 \u3060\u3063\u305F\u3051\u3069\u2026 \u4ECA\u306F \u79C1\u304C\u6696\u304B\u3044 \u5915\u98DF\u3092 \u4F5C\u3063\u3066\u308B\u6642\u3060\u3051 \u6211\u6162 \u3057\u3066\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u3002$s",
    "Bad_8": "\u6700\u8FD1\u3001 \u79C1\u306B\u5BFE\u3057\u3066 \u51B7\u305F\u304F\u306A\u3044\uFF1F\u3044\u3063\u305F\u3044 \u3069\u3046\u3057\u305F\u306E\uFF1F\u307E\u308B\u3067 \u60AA\u970A\u306B \u3068\u308A\u3064\u304B\u308C\u3066\u308B \u611F\u3058\u306D\u2026$s",
    "Bad_9": "\u3082\u3046\u5C11\u3057 \u4F55\u304B \u3067\u304D\u305F\u3089\u306A\u3041\u3002\u3042\u306A\u305F\u3068 \u4F1A\u3046\u524D\u304B\u3089 \u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u3068 \u4EF2\u304C\u3088\u304B\u3063\u305F\u306E\u3002\u5F7C\u306E \u307B\u3046\u304C \u826F\u304B\u3063\u305F\u304B\u306A\u2026$s",
    "Good_1": "\u4ECA\u306E \u805E\u3053\u3048\u305F\uFF1F\u6642\u3005\u3001 \u3053\u306E\u5BB6\u306B \u5E7D\u970A\u304C \u3044\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u3063\u3066 \u601D\u3046\u306E\u3002$u",
    "Good_2": "\u30A6\u30A7\u30EB\u30A6\u30A3\u30C3\u30AF\u306E \u661F\u5360\u3044\u306B \u3088\u308B\u3068\u3001 \u4ECA\u65E5 \u30B9\u30C6\u30AD\u306A \u3053\u3068\u304C \u8D77\u3053\u308B\u3093\u3060\u3063\u3066\u3002\u3059\u3054\u304F \u30EF\u30AF\u30EF\u30AF \u3057\u3066\u304D\u305F\u308F\uFF01",
    "Good_3": "\u6700\u5F8C\u306B \u9AEA\u3092 \u67D3\u3081\u305F\u306E\u304C \u3044\u3064\u3060\u3063\u305F\u304B \u5FD8\u308C\u305F\u308F\u2026\u3082\u3046 \u3053\u306E \u8272\u304B\u3089 \u5909\u3048\u306A\u3044\u3063\u3066 \u6C7A\u3081\u305F\u306E\u2026",
    "Good_4": "\u5F15\u3063\u8D8A\u3059\u524D\u306B \u30D6\u30FC\u30C4\u3092 \u6301\u3063\u3066\u3066 \u826F\u304B\u3063\u305F\u308F\u3002\u30B9\u30CB\u30FC\u30AB\u30FC\u3092 \u6C5A\u3055\u306A\u3044\u3088\u3046\u306B \u6CE5\u306E\u4E2D\u3092 \u6B69\u304D\u56DE\u308B\u306E\u306F \u96E3\u3057\u3044\u304B\u3089\u306D\u3002$h",
    "Good_5": "\u3042\u306A\u305F\u304C \u304F\u308C\u305F \u4EBA\u9B5A\u306E \u30DA\u30F3\u30C0\u30F3\u30C8\u3001 \u672C\u5F53\u306B \u30B9\u30C6\u30AD\u306D\u2026\u751F\u6DAF \u305A\u3063\u3068 \u8EAB\u306B\u7740\u3051\u308B\u3064\u3082\u308A\u3088\u3002$l",
    "Good_6": "\u306D\u3047\u3001\u3042\u306A\u305F\u306F \u8CE2\u660E\u306A\u4EBA\u3060\u3063\u3066 \u5206\u304B\u3063\u3066\u308B\u3051\u3069\u3001 \u6642\u3005 \u5FC3\u914D\u306B\u306A\u308B\u306E\u3002\u3053\u306E \u4E16\u754C\u306F \u30E2\u30F3\u30B9\u30BF\u30FC \u3060\u3089\u3051 \u3060\u304B\u3089\u306D\u3002$6#$e#\u6C17\u3092\u3064\u3051\u308B\u3063\u3066 \u7D04\u675F\u3057\u3066\u3002\u3042\u306A\u305F\u3092 \u5931\u3044\u305F\u304F\u306A\u3044\u306E\u3002",
    "Good_7": "@\u3055\u3093\u304B\u3002\u3042\u306A\u305F\u304C \u3042\u305F\u3057\u9054\u306E\u305F\u3081\u306B \u5C3D\u304F\u3057\u3066\u304F\u308C\u3066\u3044\u308B\u3053\u3068 \u5168\u3066\u306B \u611F\u8B1D\u3057\u305F\u3044\u306E\u3002\u3059\u3054\u304F \u8A87\u3089\u3057\u304F \u601D\u3063\u3066\u308B\u308F\u3002$l",
    "Indoor_Day_0": "\u3042\u306A\u305F\u304C \u3053\u3053\u306B \u5F15\u3063\u8D8A\u3059\u524D\u304B\u3089\u3001 \u3053\u306E \u5834\u6240\u304C \u305A\u3063\u3068 \u597D\u304D\u3060\u3063\u305F\u306E\u3002\u4ECA\u306A\u3089\u3001 \u3044\u3064\u3067\u3082 \u597D\u304D\u306A\u3060\u3051 \u7267\u5834\u3092 \u63A2\u691C \u3067\u304D\u308B\u308F\u306D\uFF01$h",
    "Indoor_Day_1": "\u3088\u3046\u3001 @\u3002\u4ECA\u65E5\u306F \u5916\u3078 \u51FA\u308B\u306E\uFF1F\u3053\u3093\u306A\u3082\u306E\u3092 \u898B\u3064\u3051\u305F\u308F\u2026[286 287 205 732]#$e#\u3082\u3057 \u5371\u306A\u304F\u306A\u3063\u305F\u3089 \u4F7F\u3063\u3066\u306D\u3002\u3042\u306A\u305F\u306E \u52A9\u3051\u306B \u306A\u308B\u306F\u305A\u3088\u3002",
    "Indoor_Day_2": "\u9271\u5C71\u3078 \u884C\u304F\u306E\uFF1F\u3082\u3057\u2026 \u4F55\u304B \u304A\u3044\u3057\u305D\u3046\u306A\u3082\u306E\u3092 \u898B\u3064\u3051\u305F\u3089\u3001 \u3042\u305F\u3057\u306E\u5206\u3082 \u6301\u3063\u3066\u5E30\u3063\u3066\u306D\uFF01$h",
    "Indoor_Day_3": "\u306D\u3047\uFF01\u4ECA\u65E5\u306F \u4F55\u3092 \u3057\u3088\u3046\u304B \u8003\u3048\u3066\u3044\u305F\u306E\u3002\u3053\u3093\u306A\u306B \u81EA\u7531\u306A \u6642\u3063\u3066 \u4ECA\u307E\u3067\u7121\u304B\u3063\u305F\u304B\u3089\u306D\uFF01",
    "Indoor_Day_4": "\u6642\u3005 \u98FE\u308A\u3064\u3051\u3092 \u5909\u3048\u3061\u3083\u3063\u3066\u3082 \u6C17\u306B\u3057\u306A\u3044\u3067 \u3044\u3066\u304F\u308C\u308B\u3088\u306D\uFF1F\u81EA\u7531\u306B \u98FE\u308A\u3064\u3051\u3089\u308C\u308B \u5834\u6240\u304C \u3042\u308B\u3063\u3066 \u30EF\u30AF\u30EF\u30AF\u3059\u308B\u308F\u3002",
    "Indoor_Day_Abigail": "\u3044\u3064\u3082 \u7267\u5834\u3067 \u65B0\u3057\u3044\u3053\u3068\u304C \u8D77\u3053\u3063\u3066\u308B\u306E\u306D\u2026\u305D\u3046\u3044\u3046\u306E \u597D\u304D\u3088\u3002",
    "Indoor_Night_0": "\u4ECA\u65E5\u306F \u826F\u3044 \u4E00\u65E5\u3060\u3063\u305F\u308F\u3002\u76EE\u3092\u3053\u3089\u3057\u3066 \u898B\u308B\u3068\u3001 \u3044\u3064\u3082 \u305D\u3053\u3089\u3058\u3085\u3046\u3067 \u4F55\u304B \u8208\u5473\u6DF1\u3044\u3053\u3068\u304C \u8D77\u3053\u3063\u3066\u308B\u308F\u3002",
    "Indoor_Night_1": "\u306D\u3047\uFF01\u4ECA\u65E5\u306F\u3069\u3093\u306A\u4E00\u65E5\u3060\u3063\u305F\u304B\u805E\u304B\u305B\u3066\uFF1F\u4F55\u304B\u9762\u767D\u3044\u3053\u3068\u306F\u3042\u3063\u305F\uFF1F$h",
    "Indoor_Night_2": "\u524D\u306F \u591C\u578B \u3060\u3063\u305F\u3051\u3069\u3001 \u7267\u5834\u306E \u751F\u6D3B\u30EA\u30BA\u30E0\u3082 \u697D\u3057\u3081\u308B\u3088\u3046\u306B \u306A\u3063\u3066\u304D\u305F\u308F\u3002\u81EA\u7136\u306A \u611F\u3058\u304C \u3059\u308B\u304B\u3089\u306D\u3002",
    "Indoor_Night_3": "\u3075\u308F\u3041\u2026 \u3082\u3046 \u4ECA\u65E5\u306F \u3053\u308C\u304F\u3089\u3044\u306B \u3057\u3088\u3046\u304B\u3057\u3089\u3002$h",
    "Indoor_Night_4": "\u3053\u3053\u3067\u306F \u591C\u306E\u97F3\u304C \u3088\u308A \u30CF\u30C3\u30AD\u30EA \u805E\u3053\u3048\u308B\u306E\u306D\u3002\u305D\u3046\u3044\u3046\u306E\u3000\u672C\u5F53\u306B \u697D\u3057\u3044\u308F\u3002",
    "Indoor_Night_Abigail": "\u305D\u308D\u305D\u308D \u5BDD\u308B \u6E96\u5099\u306F \u3067\u304D\u305F\uFF1F\u96FB\u6C17\u6BDB\u5E03\u306E \u30B9\u30A4\u30C3\u30C1\u306F \u5165\u308C\u305F\u308F\u3088\u2026$l",
    "Neutral_0": "\u3042\u305F\u3057\u304C\u5E74\u3092\u53D6\u3063\u3066\u3082\u3001 \u305A\u3063\u3068 \u597D\u304D\u3067 \u3044\u3066\u304F\u308C\u308B\u304B\u3057\u3089\u3002\u3044\u305A\u308C \u305D\u3046\u306A\u3063\u3061\u3083\u3046\u304B\u3089\u306D\uFF01",
    "Neutral_1": "\u3042\u306A\u305F\u306E \u304A\u3058\u3044\u3055\u3093\u306F \u3042\u305F\u3057\u9054\u306E\u3053\u3068\u3001 \u8A87\u308A\u306B \u601D\u3063\u3066\u304F\u308C\u308B\u304B\u306A\uFF1F",
    "Neutral_6": "\u6700\u8FD1 \u3042\u306E\u5E97\u306F \u3069\u3046\u3057\u3066\u308B\u306E\u304B\u3057\u3089\u3002\u8FD1\u3044\u3046\u3061\u306B \u9854\u3092 \u51FA\u3057\u306B \u884C\u3053\u3046\u304B\u306A\u3002",
    "Neutral_7": "\u3082\u3057 \u3042\u306A\u305F\u304C \u3042\u306E\u4E16\u3078 \u884C\u3063\u3066\u3057\u307E\u3063\u305F\u3089\u3001 \u304A\u3058\u3044\u3055\u3093\u306E \u96A3\u306B \u307B\u3053\u3089\u3092 \u5EFA\u3066\u3066\u3042\u3052\u308B\u308F\u3002",
    "Neutral_8": "\u3069\u308C\u3060\u3051 \u304C\u3093\u3070\u3063\u3066 \u30AD\u30EC\u30A4\u306B\u3057\u3066\u3082\u3001 \u5BB6\u304C \u3059\u3050\u306B \u6C5A\u308C\u3061\u3083\u3046\u3002#$e#\u7267\u5834\u3063\u3066 \u305D\u3046\u3044\u3046\u3082\u306E\u304B\u306A\u3002",
    "Neutral_9": "\u305A\u3063\u3068 \u3053\u306E\u307E\u307E \u3053\u3053\u3067 \u66AE\u3089\u305B\u308B\u304B\u306A\uFF1F\u98FD\u304D\u3061\u3083\u3046\u304B\u3082\u3002",
    "OneKid_3": "\u81EA\u5206\u304C \u6BCD\u89AA\u306B \u306A\u308B\u306A\u3093\u3066\u2026 \u5909\u306A\u6C17\u5206\u306D\u3002$h",
    "Outdoor_0": "\u4ECA\u65E5\u306F\u3001 \u5C71\u304B\u3089 \u3084\u3055\u3057\u3044 \u98A8\u304C \u5439\u3044\u3066\u304D\u3066\u308B\u308F\u306D\u3002\u677E\u306E\u6728\u3068 \u30BB\u30FC\u30B8\u307F\u305F\u3044\u306A \u9999\u308A\u304C \u3059\u308B\u308F\u3002",
    "Outdoor_1": "\u3046\u30FC\u3093\u2026\u5C4B\u5916\u3067 \u30B9\u30E9\u30A4\u30E0\u3092 \u98FC\u3046\u306B\u306F \u5341\u5206\u306A \u30B9\u30DA\u30FC\u30B9\u304C \u3042\u308B\u3068 \u601D\u3046\u306E\uFF01",
    "Outdoor_2": "\u3061\u3083\u3093\u3068 \u3042\u306A\u305F\u306E \u304A\u3058\u3044\u3055\u3093\u306E \u307B\u3053\u3089\u306F \u30AD\u30EC\u30A4\u306B \u3057\u306A\u3044\u3068\u306D\u3002\u3042\u305D\u3053\u304B\u3089\u3001 \u4F55\u304B \u7279\u5225\u306A\u3082\u306E\u3092 \u611F\u3058\u308B\u306E\u3088\u3002",
    "Outdoor_3": "\u6D1E\u7A9F\u3082 \u6240\u6709\u3067\u304D\u305F\u306A\u3093\u3066 \u3059\u3054\u3044\u308F\u3002\u305D\u3046\u3044\u3046\u306E\u3092 \u305A\u3063\u3068 \u5922\u898B\u3066\u305F\u306E\u3088\u3002$h",
    "Outdoor_4": "\u3044\u3064\u3082\u3001\u30DD\u30B1\u30C3\u30C8\u306B \u8EFD\u98DF\u3092 \u5165\u308C\u5FD8\u308C\u308B\u306E\u3088\u3002 \u30B0\u30A5\u2026$h",
    "Outdoor_Abigail": "\u3042\u305F\u3057\u306F \u3053\u306E\u8FBA\u3092 \u30D6\u30E9\u30D6\u30E9 \u3057\u3088\u3046\u304B\u3057\u3089\u3002#$e#\u8208\u5473\u6DF1\u3044 \u866B\u3084\u3001 \u4ED6\u306E\u3082\u306E\u304C \u898B\u3064\u304B\u308B\u304B\u3089\u306D\u3002\u30D5\u30D5\u30C3\u3002$h",
    "Rainy_Day_0": "\u95C7\u3068\u2026 \u96E8\u2026 \u5FC3\u304C\u8E8D\u308B\u308F\u306D\u3002$l",
    "Rainy_Day_1": "\u306D\u3047\u3001 \u6C60\u3067 \u30C7\u30E5\u30A8\u30C3\u30C8 \u3057\u305F\u3053\u3068\u3092 \u899A\u3048\u3066\u308B\uFF1F\u3053\u3046\u3044\u3046 \u5929\u6C17\u306F \u3042\u306E\u65E5\u3092 \u601D\u3044\u51FA\u3059\u306E\u3002#$e#\u3042\u306E\u30DF\u30CB\u30CF\u30FC\u30D7\u306B\u306F \u672C\u5F53\u306B \u9A5A\u304B\u3055\u308C\u305F\u308F\u2026\u3042\u3093\u306A\u306E \u4E88\u60F3\u3057\u3066\u306A\u304B\u3063\u305F\u3002\u3042\u305F\u3057\u304C \u3042\u306A\u305F\u306B \u60DA\u308C\u305F\u306E\u3082 \u305D\u308C\u304C \u7406\u7531\u304B\u3057\u3089\u306D\u3002$l",
    "Rainy_Day_2": "\u306D\u3047\uFF01\u4ECA\u671D \u65E9\u304F \u8D77\u304D\u3066\u3001 \u3061\u3087\u3063\u3068\u3060\u3051 \u63A2\u691C \u3057\u306B\u3044\u3063\u3066\u305F\u306E\u3002\u3053\u308C\u3092 \u307F\u3064\u3051\u305F\u3051\u3069\u3001 \u3042\u306A\u305F\u306E\u3053\u3068\u3092 \u601D\u3044\u51FA\u3057\u305F\u308F\u3002[768 767 769 66 82]#$e#\u3053\u308C\u3088\u308A \u826F\u3044\u3082\u306E\u3001 \u898B\u3064\u3051\u3089\u308C\u308B\u304B\u3057\u3089\uFF1F\u3069\u3046\u304B\u306A\uFF01$h",
    "Rainy_Day_3": "\u4ECA\u65E5\u306F \u6D1E\u7A9F\u3078 \u884C\u304F \u3044\u3044\u65E5 \u304B\u3057\u3089\u306D\u3002\u3067\u3082 \u6C17\u3092\u3064\u3051\u308B\u306E\u3088\u3002#$e#\u6D1E\u7A9F\u3078 \u884C\u304F\u306A\u3089\u3001 \u30E9\u30A4\u30D5\u30A8\u30EA\u30AF\u30B5\u30FC\u3092 \u6301\u3063\u3066\u884C\u304D\u306A\u3055\u3044\u3002",
    "Rainy_Day_4": "\u4ECA\u65E5\u306F \u300C\u30A2\u30C9\u30D9\u30F3\u30C1\u30E3\u30FC \u30AA\u30D6 \u30D7\u30EC\u30A4\u30EA\u30FC\u30AD\u30F3\u30B0\u300D\u3092 \u3084\u308D\u3046\u304B\u3057\u3089\u2026 \u8FD1\u3044\u3046\u3061\u306B \u4E00\u4EBA\u3067 \u30AF\u30EA\u30A2\u3057\u3066\u3084\u308B\u3093\u3060\u304B\u3089\u3002$h",
    "Rainy_Day_Abigail": "\u3053\u3093\u306A\u65E5\u306E \u7530\u820E\u306F \u3044\u3064\u3082\u3088\u308A \u697D\u3057\u3044\u3068 \u601D\u3046\u3051\u3069\u3001 \u3042\u306A\u305F\u306F \u3069\u3046\u304B\u3057\u3089\uFF1F",
    "Rainy_Night_0": "\u96E8\u306B \u6FE1\u308C\u305F \u68EE\u3092 \u3058\u3063\u3068 \u898B\u3066\u305F\u3051\u3069\u2026\u4F55\u304B \u771F\u3063\u9ED2\u3044\u3082\u306E\u304C \u6728\u3005\u306E \u9593\u3092 \u52D5\u3044\u3066\u3044\u308B\u306E\u3092 \u898B\u305F\u308F\u3002$6",
    "Rainy_Night_1": "\u3053\u3093\u306A \u591C\u306F \u5E7D\u970A\u3067\u3082 \u51FA\u305D\u3046\u306D\u2026",
    "Rainy_Night_2": "\u3042\u306A\u305F\u306F \u611F\u3058\u308B\uFF1F\u96E8\u306E\u4E2D\u306E \u9759\u3051\u3055\u3092\u2026",
    "Rainy_Night_3": "\u3053\u3046\u3044\u3046 \u591C\u306F\u3001 \u660E\u304B\u308A\u3092 \u3051\u3057\u3066 \u5468\u308A\u306E\u97F3\u306B \u8033\u3092 \u50BE\u3051\u308B\u306E\u304C \u597D\u304D\u306A\u306E\u2026$8",
    "Rainy_Night_4": "\u4ECA\u591C\u306F \u30B9\u30FC\u30D7\u3067\u3082 \u4F5C\u308D\u3046\u304B\u3068 \u601D\u3063\u305F\u306E\u3002\u53E3\u306B \u3042\u3048\u3070 \u3044\u3044\u3093\u3060\u3051\u3069\u3002[199 218 219 727 730]$h",
    "Rainy_Night_5": "\u306D\u3047\uFF01\u4ED5\u4E8B\u3067 \u75B2\u308C\u3066\u3044\u308B \u3088\u3046\u306B \u898B\u3048\u308B\u308F\u3002\u4E00\u7DD2\u306B \u30EA\u30E9\u30C3\u30AF\u30B9 \u3057\u307E\u3057\u3087\uFF1F^\u4ECA\u65E5\u306F \u3068\u3066\u3082 \u50CD\u3044\u305F\uFF1F\u5C11\u3057 \u75B2\u308C\u3066\u3044\u308B \u3042\u306A\u305F\u306E \u9854\u3001 \u304B\u308F\u3044\u304F \u898B\u3048\u308B\u308F\u3088\u3002$h",
    "Rainy_Night_Abigail": "\u96E8\u97F3\u306E \u304A\u304B\u3052\u3067 \u4ECA\u591C\u306F \u3059\u3050\u306B \u5BDD\u4ED8\u3051\u305D\u3046\u3088\u3002",
    "TwoKids_0": "%kid1\u3068%kid2\u306B\u306F \u3082\u3046 \u30C1\u30E7\u30B3\u30EC\u30FC\u30C8 \u30B7\u30EA\u30A2\u30EB\u3092 \u98DF\u3079\u3055\u305B\u305F\u308F\u3002\u304A\u306A\u304B \u3059\u3044\u305F\u3063\u3066 \u3046\u308B\u3055\u304B\u3063\u305F\u304B\u3089\u306D\uFF01",
    "TwoKids_2": "%kid2\u304C \u6210\u9577\u3057\u3066\u3001 \u6709\u540D\u306A \u30E2\u30F3\u30B9\u30BF\u30FC\u30CF\u30F3\u30BF\u30FC\u306B \u306A\u308B \u5922\u3092 \u898B\u305F\u306E\u3002\u9632\u5177\u4E00\u5F0F\u3092 \u30D7\u30EC\u30BC\u30F3\u30C8 \u3057\u3088\u3046\u304B\u3063\u3066 \u601D\u3063\u3066\u308B\u306E\u3088\u3002",
    "TwoKids_3": "\u5E74\u5B63\u306E\u5165\u3063\u305F \u5BB6\u3001 \u4E8C\u4EBA\u306E \u5B50\u3069\u3082\u9054\u3001  \u305D\u3057\u3066 \u3059\u3070\u3089\u3057\u3044 \u7267\u5834\u3002\u3053\u3093\u306A \u751F\u6D3B\u306A\u3093\u3066 \u601D\u3044\u3082 \u3088\u3089\u306A\u304B\u3063\u305F\u2026 \u3051\u3069\u306D\uFF01\u3042\u305F\u3057\u9054\u306E \u751F\u6D3B\u306F \u307E\u3060 \u59CB\u307E\u3063\u305F \u3070\u304B\u308A\u3088\u3002$h",
    "fall_1": "\u9593\u9055\u3048\u3088\u3046\u306E \u306A\u3044 \u5302\u3044\u306D\u2026 \u30AD\u30CE\u30B3\u3001 \u843D\u3061\u8449\u3001 \u30AB\u30DC\u30C1\u30E3\u3002\u307E\u3042\u3001 \u3053\u308C\u304C \u79CB\u3063\u3066\u3082\u306E\u3088\u3002\u30B9\u30C6\u30AD\u306A \u5B63\u7BC0\u3067\u3057\u3087\uFF1F",
    "fall_2": "\u4ECA\u5E74\u306E\u79CB\u306F \u5927\u304D\u306A \u30AB\u30DC\u30C1\u30E3\u3092 \u80B2\u3066\u3066\u304F\u308C\u308B\uFF1F\u306D\u3047\u3001 \u304A\u9858\u3044\u3002$h",
    "fall_20": "\u3042\u306A\u305F\u306E\u3053\u3068\u2026 \u6C34\u6676\u304C \u3044\u3063\u3071\u3044\u306E \u5B9D\u7BB1\u3088\u308A\u3082 \u4FA1\u5024\u304C \u3042\u308B\u3068 \u601D\u3063\u3066\u308B\u306E\u3002#$e#\u30A2\u30E1\u30B8\u30B9\u30C8\u3068 \u6BD4\u8F03\u3057\u3066 \u3069\u3046\u304B\u3063\u3066\uFF1F\u3046\u30FC\u3093\u2026\u3061\u3087\u3063\u3068 \u8003\u3048\u305F \u307B\u3046\u304C \u3044\u3044\u304B\u3057\u3089\u3002$h",
    "fall_6": "\u3042\u3042\u2026 \u79CB\u306D\u3002\u3042\u305F\u3057\u304C \u304A\u6C17\u306B\u5165\u308A\u306E \u5B63\u7BC0\u3088\u3002\u79CB\u306E\u666F\u8272\u3063\u3066\u3001 \u3053\u306E\u9AEA\u8272\u306B \u3059\u3054\u304F \u4F3C\u5408\u3046\u3068 \u601D\u308F\u306A\u3044\uFF1F",
    "fall_Abigail": "\u3042\u306A\u305F\u304B\u3089 \u30AB\u30DC\u30C1\u30E3\u306E \u5302\u3044\u304C \u3059\u308B\u3051\u3069\uFF1F\u305F\u3076\u3093\u3001 \u6C17\u306E\u305B\u3044\u304B\u3082\u2026$h",
    "funLeave_Abigail": "\u4ECA\u65E5\u306F \u753A\u3078 \u884C\u3063\u3066\u304F\u308B\u308F\u306D\u3002\u3061\u3087\u3063\u3068\u306F \u8DB3\u3092 \u52D5\u304B\u3055\u306A\u3044\u3068\u3002",
    "funReturn_Abigail": "\u306D\u3047\uFF01\u3044\u3044\u4E00\u65E5\u3060\u3063\u305F \u304B\u3057\u3089\uFF1F\u3042\u305F\u3057\u306E\u307B\u3046\u306F \u3044\u3044\u611F\u3058 \u3060\u3063\u305F\u308F\u3002\u6563\u6B69\u3059\u308B\u3068 \u6C17\u5206\u304C \u3088\u304F\u306A\u308B\u308F\u306D\u3002$h",
    "patio_Abigail": "%\u30A2\u30D3\u30B2\u30A4\u30EB\u306F\u6F14\u594F\u306B\u5922\u4E2D\u3060\u3002",
    "spouseRoom_Abigail": "#$c .5#\u3042\u306A\u305F\u3088\u308A \u5C11\u3057 \u65E9\u304F \u8D77\u304D\u3066\u3001 \u30C0\u30D3\u30C7Jr\u306B \u30A8\u30B5\u3092 \u4E0E\u3048\u305F\u306E\u3002\u3042\u306E\u5B50\u3001 \u4ECA\u671D\u306F \u3059\u3054\u304F \u6D3B\u767A\u3067\u306D\u3002#$e#\u30E2\u30EB\u30E2\u30C3\u30C8\u306E \u5302\u3044\u306F \u6C17\u306B\u3057\u306A\u3044\u3067 \u307B\u3057\u3044\u304B\u306A\u3002",
    "spring_1": "\u65B0\u5E74\u306B\u306F \u3069\u3093\u306A \u5927\u304D\u306A \u8A08\u753B\u3092 \u8003\u3048\u3066\u308B\u306E\u304B\u3057\u3089\uFF1F",
    "spring_12": "\u660E\u65E5\u306F \u30A4\u30FC\u30B9\u30BF\u30FC\u306D\u3002\u60AA\u3044\u3051\u3069\u3001 \u7D50\u5A5A\u3057\u305F\u304B\u3089\u3063\u3066 \u624B\u52A0\u6E1B\u3059\u308B \u3064\u3082\u308A\u306F \u306A\u3044\u308F\u3088\uFF01$h#$e#\u4ECA\u5EA6\u306E \u30A8\u30C3\u30B0\u63A2\u3057\u306F \u52DD\u3064 \u3064\u3082\u308A\u3067 \u3044\u308B\u304B\u3089\u3002\u304C\u3093\u3070\u3063\u3066 \u3042\u305F\u3057\u3092 \u6253\u3061\u8CA0\u304B\u3057\u3066 \u307F\u306A\u3055\u3044\u3002",
    "spring_2": "\u65B0\u5E74\u306E\u8A93\u3044\u306F \u4F55\u304B \u3042\u308B\uFF1F\u3042\u305F\u3057\u306F \u5C11\u3057 \u30B7\u30A7\u30A4\u30D7\u30A2\u30C3\u30D7\u3092 \u3057\u3088\u3046\u304B\u306A\u3063\u3066 \u601D\u3063\u3066\u308B\u3002$h",
    "spring_Abigail": "\u5BD2\u3044 \u5B63\u7BC0\u306E\u307B\u3046\u304C \u597D\u304D\u3060\u3051\u3069\u3001 \u3084\u3063\u3071\u308A \u6625\u304C \u304F\u308B\u306E\u304C \u3046\u308C\u3057\u304F \u611F\u3058\u308B\u308F\u3002",
    "summer_1": "\u3059\u3050 \u65E5\u306B \u713C\u3051\u3061\u3083\u3046\u304B\u3089\u3001 \u3053\u306E\u6642\u671F\u306F \u6C17\u3092\u3064\u3051\u306A\u304D\u3083\u3002#$e#\u8272\u767D\u306A \u3042\u305F\u3057\u306E \u307B\u3046\u304C \u597D\u304D\u3088\u306D\uFF01$h",
    "summer_15": "\u590F\u2026 \u30CF\u30A8\u304C \u51FA\u3066\u304F\u308B\u5B63\u7BC0\u3063\u3066\u3053\u3068\u3060\u306D\u3002#$e#\u5927\u4E08\u592B\u3001 \u9000\u6CBB\u3057\u3066\u3042\u3052\u308B\u304B\u3089\u3002\u30CF\u30A8\u9000\u6CBB\u3066 \u697D\u3057\u3044\uFF01$h",
    "summer_4": "\u71B1\u4E2D\u75C7\u306B\u306F \u6C17\u3092\u3064\u3051\u3066\u306D\u3002#$e#\u6C34\u5206\u3092 \u3061\u3083\u3093\u3068 \u53D6\u3063\u3066\u3001 \u4ED5\u4E8B \u3057\u3059\u304E\u306A\u3044\u3088\u3046\u306B \u3059\u308B\u306E\u3088\u3002",
    "summer_8": "\u306B\u304A\u3063\u3066\u305F\u3089 \u3054\u3081\u3093\u2026\u6691\u304F\u3066 \u6C57 \u304B\u304D\u3063\u3071\u306A\u3057 \u3060\u3063\u305F\u304B\u3089\u3055\u3002",
    "summer_Abigail": "\u3042\u30FC\u2026\u30C1\u30E7\u30B3\u30EC\u30FC\u30C8\u30B1\u30FC\u30AD\u304C \u98DF\u3079\u305F\u3044\u308F\u3002",
    "winter_15": "\u51AC\u306E \u30D0\u30EC\u30FC\u3092 \u63A2\u7D22\u3059\u308B\u306E\u3063\u3066 \u697D\u3057\u3044\u308F\uFF01\u4F55\u3082\u304B\u3082 \u96EA\u306B\u8986\u308F\u308C\u3066\u3066\u3001 \u898B\u9055\u3048\u308B \u611F\u3058\u304C\u3059\u308B\u304B\u3089\u3002\u305D\u308C\u306B\u3001 \u3068\u3066\u3082 \u7A4F\u3084\u304B\u3060\u3057\u2026",
    "winter_3": "\u5B9F\u306F\u3001 \u5BD2\u3044\u306E\u3063\u3066 \u597D\u304D\u306A\u306E\u3002\u3060\u3063\u3066 \u5BB6\u3067 \u6696\u307E\u308B \u53E3\u5B9F\u306B \u306A\u308B\u304B\u3089\uFF01$h",
    "winter_Abigail": "\u3042\u305F\u3057\u306E\u90E8\u5C4B\u3067 \u4E00\u7DD2\u306B \u300C\u30D7\u30EC\u30A4\u30EA\u30FC\u30AD\u30F3\u30B0\u300D\u3092 \u3084\u3063\u305F\u6642\u306E \u3053\u3068\u3092 \u899A\u3048\u3066\u308B\uFF1F\u3042\u306E\u6642\u306F \u697D\u3057\u304B\u3063\u305F\u308F\u3002$h"
  }
}