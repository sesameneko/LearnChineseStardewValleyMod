    "AcceptGift_(O)Book_Woodcutting": "\u3048\u3063\u3068\u2026\u300C\u30A6\u30C3\u30C7\u30A3\u306E\u79D8\u5BC6\u300D\u2026\uFF1F@\u3001\u3053\u308C\u306F\u3069\u3093\u306A\u672C\u306A\u306E\uFF1F$6#$b#\u308F\u3042\u3001\u6728\u6750\u52A0\u5DE5\u306E\u672C\u306A\u3093\u3060\u306D\uFF01\u3046\u3075\u3075\u2026\u3059\u3054\u304F\u6C17\u306B\u5165\u3063\u305F\u308F\u3002\u3042\u308A\u304C\u3068\u3046\uFF01$4",
    "AcceptGift_(O)SkillBook_2": "\u300C\u9031\u520A\u30A6\u30C3\u30C9\u30AB\u30C3\u30BF\u30FC\u300D\u2026\u3053\u306E\u6700\u65B0\u53F7\u304C\u307B\u3057\u3044\u3068\u601D\u3063\u3066\u305F\u3093\u3060\uFF01\u65B0\u3057\u3044\u6280\u8853\u304C\u305F\u304F\u3055\u3093\u8F09\u3063\u3066\u308B\u3093\u3060\u3088\uFF01#$b#\u3042\u306A\u305F\u3082\u6728\u3053\u308A\u3060\u304B\u3089\u304D\u3063\u3068\u308F\u304B\u308B\u3088\u306D\u2026\u3042\u308A\u304C\u3068\u3046\u3002$h",
    "AcceptGift_(O)StardropTea": "\u3061\u3087\u3063\u3068\u5F85\u3063\u3066\u2026 \u3053\u308C\u3092\u79C1\u306B\uFF1F\u3068\u3066\u3082\u3059\u3054\u3044\u98F2\u307F\u7269\u306A\u3093\u3060\u3088\uFF01\u3042\u308A\u304C\u3068\u3046\u3002",
    "Fri": "\u606F\u5B50\u306E \u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306B\u306F \u4F1A\u3063\u305F\uFF1F\u4E0B\u306E\u968E\u306B \u3044\u308B\u308F\u3002#$e#\u3061\u3087\u3063\u3068 \u4EBA\u898B\u77E5\u308A\u306A\u5B50\u3060\u3051\u3069\u3001 \u3084\u3055\u3057\u304F \u63A5\u3057\u305F\u3089 \u3059\u3050 \u6253\u3061\u89E3\u3051\u3066\u304F\u308C\u308B\u306F\u305A\u3088\u3002",
    "Fri4": "#$1 RobinSeb#\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306E \u90E8\u5C4B\u3067 \u79C1\u306E \u7070\u76BF\u3092 \u898B\u3064\u3051\u305F\u3051\u3069\u3001 \u5909\u306A \u81ED\u3044\u304C \u3057\u305F\u308F\u3002\u5FC3\u914D\u3057\u305F\u307B\u3046\u304C \u3044\u3044\u308F\u3088\u306D\u2026#$e#\u6642\u3005\u3001 \u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306E\u3053\u3068\u304C \u5FC3\u914D\u306A\u306E\u2026 \u53CB\u9054\u306F \u3042\u3093\u307E\u308A \u3044\u306A\u3044\u3057\u3001 \u81EA\u5206\u306E \u672A\u6765\u306B\u3064\u3044\u3066\u3082 \u305D\u308C\u307B\u3069 \u8003\u3048\u3066\u3044\u306A\u3044\u304B\u3089\u2026#$e#\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u3068 \u8A71\u3092 \u3057\u305F\u3044\u3051\u3069\u3001 \u79C1\u306B\u306F \u6253\u3061\u660E\u3051\u3066\u304F\u308C\u306A\u3044\u306E\u3002",
    "Fri4_inlaw_Sebastian": "\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u304C \u30BF\u30D0\u30B3\u3092 \u3084\u3081\u308B\u3063\u3066 \u8A00\u3063\u3066\u304F\u308C\u305F\u308F\uFF01\u3059\u3054\u304F \u8A87\u3089\u3057\u3044 \u3053\u3068\u3088\u3002",
