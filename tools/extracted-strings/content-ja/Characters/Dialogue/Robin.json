    "GreenRain": "\u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u306F\u3069\u3046\u304B\u3057\u3066\u308B\u3088\uFF01\u3069\u3046\u3057\u3066\u5916\u306B\u51FA\u306A\u304D\u3083\u3044\u3051\u306A\u3044\u306E\uFF1F\u3053\u306E\u96E8\u306F\u5371\u306A\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u306E\u306B\uFF01$u%noturn",
    "GreenRainFinished": "\u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u306F\u30B5\u30F3\u30D7\u30EB\u304C\u96C6\u3081\u3089\u308C\u3066\u304D\u3063\u3068\u6E80\u8DB3\u3060\u308D\u3046\u306D\u3002\u3042\u306E\u4EBA\u306F\u3001\u3061\u3087\u3063\u3068\u3057\u305F\u7814\u7A76\u306E\u65B9\u304C\u81EA\u5206\u306E\u5965\u3055\u3093\u3088\u308A\u3082\u5927\u4E8B\u306A\u3093\u3060\u3088\u3002\u307E\u3063\u305F\u304F\u3082\u3046\u3002$6",
    "GreenRain_2": "\u4E16\u754C\u306B\u306F\u3044\u308D\u3093\u306A\u7A2E\u985E\u306E\u3044\u3044\u6728\u6750\u304C\u3042\u308B\u3088\u306D\u3002\u3055\u3063\u305D\u304F\u5207\u308A\u306B\u884C\u3063\u3066\u307F\u308B\uFF1F",
