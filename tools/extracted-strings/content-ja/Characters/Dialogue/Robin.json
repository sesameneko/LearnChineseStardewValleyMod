    "Mon": "\u3053\u306E\u5BB6\u306F \u79C1\u304C \u571F\u53F0\u304B\u3089 \u5EFA\u3066\u305F\u3063\u3066 \u8A71\u3092 \u3057\u305F\u304B\u3057\u3089\uFF1F#$e#\u79C1\u306E \u7D4C\u9A13\u3057\u305F\u4E2D\u3067 \u4E00\u756A\u306E \u30CF\u30A4\u30E9\u30A4\u30C8\u3060\u308F\u3002",
    "MovieInvitation": "\u308F\u3042\u2026 \u4ECA\u591C\u306E\u30C1\u30B1\u30C3\u30C8\u304C2\u679A\u3042\u308B\u306E\uFF1F \u304A\u3082\u3057\u308D\u305D\u3046\uFF01 \u697D\u3057\u307F\u3060\u308F\uFF01$h",
    "Resort": "\u3046\u308F\u3063\u3001\u898B\u3066\u3088\u3053\u306E\u69CB\u9020\uFF01$h#$b#\u308F\u305F\u3057\u306B\u306F\u3053\u308C\u304C\u540D\u5DE5\u306E\u624B\u306B\u3088\u308B\u3082\u306E\u3060\u3063\u3066\u308F\u304B\u308B\u3088\u3002\u611F\u52D5\u3057\u3061\u3083\u3063\u305F\uFF01",
    "Resort_Bar": "\u3068\u3063\u3066\u3082\u843D\u3061\u7740\u304F\u306D\u2026",
    "Resort_Chair": "\u3084\u3042\u3001@\u3002\u3042\u306A\u305F\u304C\u5F15\u3063\u8D8A\u3057\u3066\u6765\u3066\u304B\u3089\u3001\u753A\u304C\u3069\u308C\u3060\u3051\u767A\u5C55\u3057\u305F\u304B\u8003\u3048\u3066\u3044\u305F\u3093\u3060\u3002#$b#\u3042\u306A\u305F\u306F\u81EA\u5206\u304C\u3084\u3063\u305F\u3053\u3068\u3092\u8A87\u308A\u306B\u601D\u3046\u3079\u304D\u3060\u3088\uFF01$h",
    "Resort_Leaving": "\u3068\u3066\u3082\u697D\u3057\u304B\u3063\u305F\u3088\u3002$h",
    "Resort_Shore": "\u307B\u3089\u3001\u898B\u3066\uFF01\u3053\u3053\u304B\u3089\u4ED6\u306E\u5CF6\u304C\u898B\u3048\u308B\u3088\u3002",
    "Sat": "\u79C1\u9054\u306E\u5BB6\u3063\u3066 \u3044\u3044\u3068\u3053\u308D\u306B \u5EFA\u3063\u3066\u308B\u3068 \u601D\u308F\u306A\u3044\uFF1F#$e#\u5C71\u306E \u65B0\u9BAE\u306A \u7A7A\u6C17\u304C \u5927\u597D\u304D\u306A\u306E\u3002",
    "Sun": "\u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u304C \u79D1\u5B66\u5B9F\u9A13\u3067 \u3053\u306E\u5BB6\u3092 \u5439\u304D\u98DB\u3070\u3055\u306A\u304D\u3083 \u3044\u3044\u3093\u3060\u3051\u3069\u3002#$e#\u3044\u3063\u305F\u3044 \u4F55\u3092 \u3057\u3066\u3044\u308B\u306E\u304B \u79C1\u306B\u306F \u898B\u5F53\u3082\u3064\u304B\u306A\u3044\u308F\u3002\u305F\u3060\u3001 \u690D\u7269\u3068 \u95A2\u4FC2\u304C \u3042\u308B\u3088\u3046\u306B \u601D\u3048\u308B\u306E\u3002",
    "Sun2": "#$1 RobinDem#\u6628\u6669\u306E \u592B\u306E \u5B9F\u9A13\u3067\u3001\u5BB6\u304C \u713C\u3051\u3066\u3057\u307E\u3044\u305D\u3046\u306B \u306A\u3063\u305F\u308F\u3002 \u30D3\u30FC\u30AB\u30FC\u304C \u7206\u767A\u3057\u3066 \u5782\u6728\u306B \u706B\u304C \u98DB\u3073\u79FB\u3063\u305F\u306E\u3088\uFF01\u5BB6\u3092 \u5EFA\u3066\u308B\u969B\u306B \u8010\u706B\u6027\u306E \u5857\u6599\u3092 \u4F7F\u3063\u3066\u3001 \u672C\u5F53\u306B \u826F\u304B\u3063\u305F\u308F\u3002$u#$e#@\u3001\u5909\u306A \u81ED\u3044\u304C \u3057\u305F\u3089 \u3054\u3081\u3093\u306A\u3055\u3044\u306D\u3002\u592B\u306E \u5909\u306A \u79D1\u5B66\u5B9F\u9A13\u306B \u3088\u308B\u3082\u306E\u3060\u304B\u3089\u2026",
    "Sun6": "\u3042\u3089\u3001@\uFF01\u3042\u3048\u3066 \u3046\u308C\u3057\u3044\u308F\u3002#$e#\u4ECA\u3067\u306F \u3042\u306A\u305F\u3082 \u3053\u306E\u753A\u306E \u308A\u3063\u3071\u306A \u4E00\u54E1\u306D\u3002",
    "Thu": "\u8CB7\u3044\u7269\u304C \u76EE\u5F53\u3066\u3058\u3083\u306A\u304F\u3066\u3082\u3001 \u3044\u3064\u3067\u3082 \u4F1A\u3044\u306B\u304D\u3066\u3082 \u3044\u3044\u306E\u3088\u3002$h#$e#\u5C71\u306E\u4E0A\u3058\u3083\u3001 \u7D50\u69CB \u4EBA\u604B\u3057\u304F\u306A\u308B\u304B\u3089\u3002",
    "Tue": "\u3082\u3057 \u7D20\u6750\u3084 \u8A2D\u8A08\u56F3\u304C \u5FC5\u8981\u306A\u3089\u3001 \u79C1\u306E \u5E97\u3092 \u898B\u308B\u3068 \u3044\u3044\u308F\u3088\uFF01#$e#\u3042\u306A\u305F\u306E \u4ED5\u4E8B\u304C \u5730\u5143\u7D4C\u6E08\u3092 \u652F\u3048\u3066\u304F\u308C\u308B\u304B\u3089\u306D\u3002$h",
    "Wed": "\u3053\u3093\u306B\u3061\u306F\u3001@\u3002#$e#\u3061\u3087\u3046\u3069\u4ECA\u3001 \u65B0\u3057\u3044\u3082\u306E\u3092 \u4F5C\u308D\u3046\u3068 \u8003\u3048\u3066\u3044\u305F \u3068\u3053\u308D\u306A\u306E\u3002#$e#\u305D\u3063\u3061\u306E \u8ABF\u5B50\u306F \u3069\u3046\u304B\u3057\u3089\uFF1F\u3042\u306A\u305F\u306E \u5BB6\u306E \u6728\u6750\u306F \u307E\u3060 \u3057\u3063\u304B\u308A \u3057\u3066\u308B\uFF1F",
    "cc_Begin": "\u30EB\u30A4\u30B9\u304C \u30B3\u30DF\u30E5\u30CB\u30C6\u30A3 \u30BB\u30F3\u30BF\u30FC \u306E\u6848\u5185\u3092 \u3057\u3066\u304F\u308C\u305F\u3089\u3057\u3044\u306D\u2026\u3042\u305D\u3053\u3092 \u76F4\u305B\u305F\u3089 \u3069\u3093\u306A\u306B \u3046\u308C\u3057\u3044\u304B\u3002\u672C\u5F53\u306B \u6614\u306F\u7D20\u6575\u306A \u5EFA\u7269\u3060\u3063\u305F\u306E\uFF01",
    "cc_Bridge": "\u6628\u65E5\u306E\u591C \u5909\u306A\u97F3\u304C\u3000\u805E\u3053\u3048\u3066\u305F\u306E\u3001\u305D\u308C\u3067\u4ECA\u671D \u8D77\u304D\u305F\u3089\u3001 \u77F3\u5207\u308A\u5834\u3078\u306E \u6A4B\u304C \u5B8C\u74A7\u306B \u76F4\u3063\u3066\u305F\u306E\uFF01#$b#\u307E\u3055\u304B\u306E\u5947\u8DE1\u304C\u8D77\u304D\u305F\u308F\uFF01",
    "cc_Complete": "\u3042\u306A\u305F\u304C \u30D0\u30B9\u3092\u964D\u308A\u305F \u3042\u306E\u77AC\u9593\u304B\u3089 \u308F\u304B\u3063\u3066\u305F\u306E\u3001@... \u3042\u306A\u305F\u306F \u753A\u306E \u30D2\u30FC\u30ED\u30FC\u306B \u306A\u308B\u3063\u3066\uFF01$h",
    "divorced_Maru": "\u30DE\u30EB\u306F\u4E00\u6669\u4E2D\u6CE3\u3044\u3066\u3044\u305F\u306E\u3088\u2026\u307F\u3093\u306A\u30B7\u30E7\u30C3\u30AF\u3092\u53D7\u3051\u3066\u3044\u308B\u308F\u2026$s",
    "divorced_Sebastian": "\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u304C\u5730\u4E0B\u5BA4\u306B\u5E30\u3063\u3066\u304D\u305F\u3093\u3060\u3051\u3069\u2026 \u4F55\u304C\u3042\u3063\u305F\u306E\uFF1F$s",
    "event_wood1": "\u3048\u3048\u3001 \u305D\u308C\u306A\u3089 \u3053\u306E \u8A2D\u8A08\u56F3\u3082 \u3042\u306A\u305F\u306B \u3068\u3063\u3066\u306F \u7C21\u5358\u305D\u3046\u306D\uFF01$h",
    "event_wood2": "\u305D\u308C\u306A\u3089\u3001 \u521D\u3081\u3066\u306B \u3046\u3063\u3066\u3064\u3051\u306E \u8A2D\u8A08\u56F3\u304C \u3042\u308B\u308F\u3088\uFF01",
    "fall_Fri": "\u5BB6\u306E \u5F8C\u308D\u306B \u4F4F\u3093\u3067\u308B \u91CE\u751F\u306E \u7537\u6027\u306B\u306F \u4F1A\u3063\u305F\uFF1F$s#$e#\u554F\u984C\u3092 \u8D77\u3053\u3055\u306A\u3044\u9650\u308A\u3001 \u79C1\u306F \u3042\u307E\u308A \u5F7C\u306E\u3053\u3068\u3092 \u6C17\u306B\u3057\u306A\u3044\u3051\u3069\u3002",
    "fall_Mon": "#$1 RobinMaru#\u30DE\u30EB\u306F \u5B9D\u77F3\u304C \u597D\u304D\u306A\u306E\u3002\u767A\u660E\u306B \u4F7F\u3046\u3093\u3060\u3063\u3066\u3002#$e#\u3042\u306A\u305F\u306F \u30DE\u30EB\u3068\u306F \u3046\u307E\u304F \u3084\u3063\u3066\u3044\u3051\u3066\u308B\u304B\u3057\u3089\uFF1F",
    "fall_Thu": "\u5EFA\u7269\u306E \u62E1\u5F35\u304C \u76EE\u5F53\u3066\u3058\u3083\u306A\u304F\u3066\u3082\u3001 \u3044\u3064\u3067\u3082 \u4F1A\u3044\u306B\u304D\u3066\u3082 \u3044\u3044\u306E\u3088\u3002$h#$e#\u5C71\u306E\u4E0A\u3058\u3083\u3001 \u7D50\u69CB \u4EBA\u604B\u3057\u304F\u306A\u308B\u304B\u3089\u3002",
    "houseUpgrade_1": "\u3042\u306A\u305F\u306E\u5BB6\u3067\u306E\u4ED5\u4E8B\u306F\u697D\u3057\u304B\u3063\u305F\u3088\u3002\u3053\u308C\u307E\u3067\u3067\u4E00\u756A\u306E\u4ED5\u4E0A\u304C\u308A\u304B\u3082\uFF01$h#$e#\u65B0\u3057\u3044\u30AD\u30C3\u30C1\u30F3\u306E\u4F7F\u3044\u5FC3\u5730\u306F\u3069\u3046\uFF1F",
    "houseUpgrade_2": "\u3042\u306A\u305F\u306E\u5BB6\u306B\u4F5C\u3063\u305F\u65B0\u3057\u3044\u90E8\u5C4B\u306F\u3069\u3046\u4F7F\u3046\u306E\uFF1F#$e#\u305D\u308C\u3068\u3082\u2026 \u3082\u3046\u300C\u304A\u5C4B\u6577\u300D\u3068\u8A00\u3063\u305F\u65B9\u304C\u3044\u3044\u304B\u306A\uFF1F$h",
    "houseUpgrade_3": "\u719F\u6210\u30EF\u30A4\u30F3\u3092\u3064\u304F\u308A\u59CB\u3081\u308B\u306E\uFF1F\u3059\u3054\u304F\u304A\u91D1\u304C\u3082\u3046\u304B\u308B\u3089\u3057\u3044\u306D\u2026 \u5FCD\u8010\u529B\u304C\u3042\u308C\u3070\u3060\u3051\u3069\u3002",
