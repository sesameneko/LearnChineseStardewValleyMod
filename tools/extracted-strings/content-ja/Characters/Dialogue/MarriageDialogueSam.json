  "entries": {
    "Good_1": "\u30AA\u30EC\u306E \u90E8\u5C4B\u306B \u5165\u308A\u8FBC\u3093\u3060 \u3042\u306E\u591C\u306E \u3053\u3068\u3001 \u899A\u3048\u3066\u308B\u304B\uFF1F\u30AA\u30EC\u306F \u3088\u304F \u601D\u3044\u51FA\u3059\u305C\u2026$l",
    "Good_2": "\u306A\u3041\u3001 \u521D\u3081\u3066 \u3042\u3063\u305F\u6642\u304B\u3089\u3001 \u4E00\u7DD2\u306B\u306A\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u3063\u3066 \u611F\u3058\u3066\u3044\u305F\u3093\u3060\u3002\u4FFA\u9054\u306E \u9593\u306B \u7279\u5225\u306A \u4F55\u304B\u304C \u3042\u308B\u3093\u3060\u308D\u3046\u306A\u3002$l",
    "Good_3": "\u304A\u304A\u3001 \u4ECA\u65E5\u306E \u541B\u306F \u672C\u5F53\u306B \u304B\u3063\u3053\u3044\u3044\u306D\uFF01\u3044\u3064\u3082\u3068\u9055\u3046 \u9AEA\u306E\u30BB\u30C3\u30C8\u3067\u3082 \u3057\u305F\u306E\u304B\uFF1F$l^\u304A\u304A\u3001 \u4ECA\u65E5\u306E \u304A\u524D\u306F \u30B7\u30D3\u308C\u308B\u306A\u3002\u4F55\u304B \u65B0\u3057\u3044 \u9AEA\u306E\u30BB\u30C3\u30C8\u3067\u3082 \u3057\u305F\u306E\u304B\uFF1F$l",
    "Good_4": "\u306A\u3041\u3001 \u30AA\u30EC\u306F \u304A\u524D\u306E \u305F\u3081\u306B \u66F2\u3092 \u4F5C\u308D\u3046\u304B\u3068 \u601D\u3063\u3066\u305F\u3093\u3060\u3002\u3067\u3082 \u5E30\u3063\u3066\u304D\u3066\u304F\u308C\u3066 \u5B89\u5FC3\u3057\u305F\u305C\u3002#$e#\u5B64\u72EC\u306A\u6642\u306B \u3088\u304F\u3001 \u30AE\u30BF\u30FC\u3092 \u5F3E\u304D\u305F\u304F\u306A\u308B\u3093\u3060\u3088\u3002",
    "Good_5": "\u306A\u3041\u3001 \u8A71\u3092 \u3057\u3088\u3046\u305C\uFF01\u304A\u524D\u304C \u3069\u3093\u306A \u65E5\u3092 \u904E\u3054\u3057\u305F\u304B\u3001 \u3044\u3064\u3082 \u6C17\u306B\u306A\u308B\u3093\u3060\u3002",
    "Good_6": "\u5916\u3067\u306F \u6C17\u3092\u3064\u3051\u308B\u3093\u3060\u3088\uFF01\u304A\u524D\u304C \u6D1E\u7A9F\u3078 \u6642\u3005 \u3044\u304F\u306E\u306F \u5206\u304B\u3063\u3066\u308B\u304C\u2026 \u30E2\u30F3\u30B9\u30BF\u30FC\u306B \u98DF\u308F\u308C\u306A\u3044\u3088\u3046\u306B \u3059\u308B\u3093\u3060\u305E\uFF01",
    "Indoor_Day_0": "\u3075\u3045\u2026\u30AA\u30EC\u304C \u6614\u306E\u751F\u6D3B\u3067 \u5F8C\u6094\u3057\u3066\u3044\u306A\u3044\u3053\u3068\u304C 1\u3064\u3042\u308B\u3093\u3060\u2026 Joja\u30DE\u30FC\u30C8\u3067\u306E \u4ED5\u4E8B\u3060\u3002",
    "Indoor_Day_1": "\u30A4\u30F3\u30B9\u30BF\u30F3\u30C8\u306E \u30D1\u30F3\u30B1\u30FC\u30AD\u3092 \u4F5C\u3063\u3066\u3084\u3063\u305F\u305C\u3002\u307B\u3089\uFF01[211]$h#$e#\u3048\u3063\uFF1F\u30AA\u30EC\u306F \u6599\u7406\u3092 \u5B66\u3070\u306A\u304B\u3063\u305F\u3093\u3060\u2026 \u3044\u3064\u3082 \u30AA\u30D5\u30AF\u30ED\u304C \u3084\u3063\u3066\u305F\u304B\u3089\u306A\u3002",
    "Indoor_Day_2": "\u306D\u3047\u3001\u30AA\u30EC\u306F \u3044\u3064\u3082 \u4E0D\u771F\u9762\u76EE\u3060\u3063\u3066\u306E\u306F \u3088\u304F\u308F\u304B\u3063\u3066\u308B\u304C\u3001 \u304A\u524D\u3078\u306E \u611B\u306F \u672C\u6C17\u3060\u305C\u2026$l",
    "Indoor_Day_3": "\u4ECA\u65E5\u306F \u3069\u3093\u306A \u5927\u8A08\u753B\u3092 \u8003\u3048\u3066\u308B\u3093\u3060\uFF1F#$e#\u30AA\u30EC\u306F \u306A\u3044\u305C\u2026\u3044\u3064\u3082\u3001 \u884C\u304D\u5F53\u305F\u308A\u3070\u3063\u305F\u308A\u3067 \u8003\u3048\u3066\u3044\u308B\u304B\u3089\u306A\u2026",
    "Indoor_Day_4": "\u3042\u30FC\u2026\u3044\u3064\u304B \u304A\u524D\u306E \u8FB2\u4F5C\u696D\u3092 \u624B\u4F1D\u3063\u3066\u3084\u308C\u308B\u304B\u3082\u306A\u3002\u4ECA\u65E5\u306F \u3084\u308B\u6C17\u304C \u306A\u3044\u3093\u3060\u3002$s#$e#\u6012\u3063\u3066\u306A\u3044\u3088\u306A\uFF1F",
    "Indoor_Night_0": "\u306A\u3041\u3001 \u75B2\u308C\u3066\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u305C\u3002\u4E00\u7DD2\u306B \u75B2\u308C\u3092 \u53D6\u308D\u3046\u305C\u3002\u3044\u3044\u3060\u308D\uFF1F\u5F8C\u3067 \u30DE\u30C3\u30B5\u30FC\u30B8 \u3057\u3066\u3084\u308B\u304B\u3089\u3002",
    "Indoor_Night_1": "\u30AA\u30EC\u306E \u4E00\u65E5\uFF1F\u3042\u3042\u2026\u3042\u3093\u307E\u308A \u899A\u3048\u3066\u306A\u3044\u306A\u3002\u7279\u306B \u8A18\u61B6\u306B \u6B8B\u308B\u3053\u3068\u3082 \u3057\u306A\u304B\u3063\u305F\u3057\u3002\u305F\u3060 \u30EA\u30E9\u30C3\u30AF\u30B9\u3057\u3066\u3001 \u697D\u3057\u3044 \u3072\u3068\u6642\u3092 \u904E\u3054\u3057\u305F \u3060\u3051\u3055\u3002",
    "Indoor_Night_2": "\u3042\u3042\u3001 \u30D9\u30C3\u30C9\u306E \u6E96\u5099 \u3067\u304D\u3066\u306A\u304F\u3066 \u60AA\u3044\u306A\u3002\u30AA\u30EC\u3063\u3066 \u3044\u3044\u52A0\u6E1B\u3060\u304B\u3089\u2026 \u305D\u308C\u3092 \u77E5\u3063\u3066\u3066 \u597D\u304D\u306B \u306A\u3063\u305F\u3093\u3060\u308D\uFF1F$h",
    "Indoor_Night_3": "\u5B9F\u5BB6\u3067 \u604B\u3057\u3044\u3082\u306E\u3068 \u8A00\u3048\u3070 \u30AA\u30D5\u30AF\u30ED\u306E \u9B5A\u306E \u30AD\u30E3\u30BB\u30ED\u30FC\u30EB \u3050\u3089\u3044\u3060\u306A\u3002",
    "Indoor_Night_4": "\u3055\u3041\u3001 \u305D\u308D\u305D\u308D\u5BDD\u308B\u304B\uFF1F\u4F55\u3068\u304B\u3057\u3066 \u30D9\u30C3\u30C9\u306E \u6E96\u5099\u306F \u6574\u3048\u305F\u305C\u2026",
    "OneKid_0": "%kid1\u306E \u30AA\u30E0\u30C4\u3092 \u5909\u3048\u3066\u304F\u308B\u305C\u2026 \u5FC3\u914D\u3059\u308B\u306A\u3002\u304A\u524D\u306F \u81EA\u5206\u306E\u4ED5\u4E8B\u3067 \u624B\u4E00\u676F\u3060\u3082\u3093\u306A\u3002",
    "OneKid_1": "\u5909\u306A\u611F\u3058 \u3060\u3051\u3069\u3001 \u7236\u89AA\u3063\u3066 \u697D\u3057\u3044\u3082\u3093\u3060\u306A\uFF01$h",
    "OneKid_3": "\u3082\u3046\u4E00\u4EBA \u5B50\u3092 \u4F5C\u308B\u3079\u304D\u3060\u3068 \u601D\u3046\u3093\u3060\u3002\u305D\u3046\u3057\u306A\u3044 \u7406\u7531\u306F \u3042\u308B\u304B\uFF1F",
    "Outdoor_0": "\u30B9\u30B1\u30DC\u30FC\u3067 \u3061\u3087\u3063\u3068 \u30AA\u30D5\u30ED\u30FC\u30C9\u3092 \u8D70\u3063\u3066\u3053\u3088\u3046\u304B\u306A\u3002\u30EB\u30A4\u30B9\u5E02\u9577\u306B \u3064\u304B\u307E\u308A\u3084 \u3057\u306A\u3044\u3055\u3002$h",
    "Outdoor_1": "\u30AA\u30EC\u306F \u9752\u304F \u6F84\u3093\u3060 \u7A7A\u3092 \u3088\u30FC\u304F \u898B\u3066\u308B\u3093\u3060\u2026 \u3044\u3064 UFO\u304C \u98DB\u3093\u3067\u304F\u308B\u304B \u5206\u304B\u3089\u306A\u3044\u304B\u3089\u306A\u3002",
    "Outdoor_2": "\u3042\u3089\u3001@\uFF01\u30AA\u30EC\u304C \u3082\u3063\u3068 \u8FB2\u696D\u306E\u3053\u3068\u3092 \u77E5\u3063\u3066\u305F\u3089\u3001 \u304A\u524D\u3092 \u624B\u4F1D\u3048\u305F\u3093\u3060\u304C\u3002\u60AA\u3044\u306A\uFF01#$e#\u307E\u3042\u3001 \u304A\u524D\u3092 \u5FDC\u63F4\u3059\u308B \u3050\u3089\u3044\u306A\u3089 \u3067\u304D\u305D\u3046\u3060\u3002$h",
    "Outdoor_3": "\u7A7A\u6C17\u3092 \u5438\u3046\u3068 \u524D\u5411\u304D\u306A \u6C17\u5206\u306B \u306A\u308B\u305C\u2026 \u30AC\u30B9\u3055\u3093\u306E \u30AA\u30FC\u30D6\u30F3\u306B\u5165\u3063\u305F \u30D4\u30B6\u306E \u5302\u3044\u304C \u6DF7\u3056\u3063\u3066\u308B\u304B\u3089\u304B\u3082\u306A\u3002",
    "Outdoor_4": "\u304A\u304A\u2026 \u4ECA\u65E5\u306F \u30A4\u30B1\u3066\u308B\u3058\u3083\u306A\u3044\u304B\u3002 \u305D\u306E \u6CE5\u306E \u30B7\u30DF\u3082\u3001 \u66F4\u306A\u308B \u30C1\u30E3\u30FC\u30E0\u30DD\u30A4\u30F3\u30C8\u3060\u306A\u3002$l",
    "Rainy_Day_0": "\u5BB6\u3067 \u3086\u3063\u304F\u308A \u30AE\u30BF\u30FC\u3092 \u5F3E\u304F\u306B\u306F \u3061\u3087\u3046\u3069\u3044\u3044 \u65E5\u304B\u3082\u306A\u2026#$e#\u307E\u3042\u3001 \u304A\u524D\u3082 \u3088\u304B\u3063\u305F\u3089 \u3086\u3063\u304F\u308A \u3057\u3066\u3044\u3053\u3046\u305C\u3002",
    "Rainy_Day_1": "\u304A\u524D\u306F \u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u3068 \u30A2\u30D3\u30B2\u30A4\u30EB\u304C \u4E00\u7DD2\u306B \u306A\u308B\u3068 \u601D\u3046\u304B\uFF1F#$e#\u30D8\u30C3\u2026 \u30AA\u30EC\u306F \u7D50\u5A5A\u3057\u305F\u3093\u3060\u304B\u3089\u3001 \u4ED6\u306E \u307F\u3093\u306A\u3082 \u7D50\u5A5A\u3067\u304D\u308B\u3088\u3046\u306B \u3057\u3066\u308B\u306E\u3055\u3002",
    "Rainy_Day_2": "\u306A\u3041\u3001 \u5F15\u304D\u51FA\u3057\u306E \u5F8C\u308D\u306B \u3053\u3093\u306A\u306E\u304C \u8EE2\u304C\u3063\u3066\u305F\u305E\u3002[90 88 86 535]#$e#\u304A\u524D\u306A\u3089 \u4F7F\u3048\u305D\u3046\u3060\u3068 \u601D\u3046\u3093\u3060\u3002",
    "Rainy_Day_3": "\u3042\u3042\u2026\u66C7\u308A\u306E\u65E5\u3063\u3066 \u4E0D\u6109\u5FEB\u3060\u3088\u306A\u2026$7",
    "Rainy_Day_4": "\u3061\u3083\u3093\u3068 \u7720\u308C\u305F\u304B\uFF1F\u30AA\u30EC\u306F \u96E8\u97F3\u306E \u304A\u304B\u3052\u3067 \u30B0\u30C3\u30B9\u30EA \u7720\u308C\u305F\u305C\u3002",
    "Rainy_Night_0": "\u4ECA\u65E5\u306F \u3069\u3093\u306A \u65E5\u3060\u3063\u305F\uFF1F\u30AA\u30EC\u306F \u305F\u3060 \u3054\u308D\u3054\u308D\u3057\u3066\u3001 \u30DE\u30F3\u30AC\u3092 \u8AAD\u3093\u3067 \u904E\u3054\u3059\u2026 \u3044\u3044\u65E5\u3060\u3063\u305F\u3055\u3002$h",
    "Rainy_Night_1": "\u4ECA\u65E5\u306F \u6BD4\u8F03\u7684 \u843D\u3061\u7740\u3044\u305F \u4E00\u65E5\u3060\u3063\u305F\u306A\u2026 \u30B3\u30FC\u30E9\u306B\u51B7\u51CD\u30D4\u30B6\u3001 \u305D\u308C\u3068 \u6570\u6642\u9593\u306E \u30AE\u30BF\u30FC\u7DF4\u7FD2\u3002\u30EA\u30E9\u30C3\u30AF\u30B9 \u3067\u304D\u305F\u305C\u3002",
    "Rainy_Night_2": "\u524D\u306B\u3084\u3063\u305F \u30AA\u30EC\u9054\u306E \u30E9\u30A4\u30D6\u306E \u9332\u97F3\u3092 \u3055\u3063\u304D\u805E\u3044\u3066\u305F\u3093\u3060\u3002\u3042\u306E \u6642\u3092 \u899A\u3048\u3066\u308B\u304B\uFF1F\u7D50\u69CB \u3044\u3044\u52A0\u6E1B\u306A \u3082\u306E\u3060\u3063\u305F\u305C\u3002#$b#\u304A\u524D\u304C \u305D\u3053\u306B \u3044\u305F\u304B\u3089 \u30AA\u30EC\u306F \u3061\u3087\u3063\u3068 \u5FC3\u914D\u3067\u306A\u3001 \u3069\u3053\u304B\u3067 \u30DF\u30B9\u3057\u3066 \u304A\u524D\u306B \u8CA0\u3051\u72AC\u3060\u3068 \u601D\u308F\u308C\u305F\u304F \u306A\u304B\u3063\u305F\u3093\u3060\uFF01$10",
    "Rainy_Night_3": "\u30AA\u30EC\u304C \u3044\u306A\u304F\u306A\u3063\u3066\u3001 \u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u304C \u3042\u307E\u308A \u3055\u3073\u3057\u304C\u3089\u306A\u304D\u3083 \u3044\u3044\u3093\u3060\u304C\u2026\u3042\u3044\u3064\u3092 \u898B\u5B88\u308B \u8CAC\u4EFB\u304C \u30AA\u30EC\u306B \u3042\u308B\u3068 \u601D\u3063\u3066\u305F\u304B\u3089\u3055\u3002$s#$e#\u3067\u3082\u3001 \u4EBA\u751F\u3063\u3066 \u5909\u308F\u308B\u3082\u3093\u3060\u308D\u2026\u306A\u3041\uFF1F\u5B50\u3069\u3082\u9054\u3082 \u3044\u305A\u308C\u3001 \u305D\u308C\u3092 \u5B66\u3076\u3053\u3068\u306B \u306A\u308B\u3093\u3060\u2026\u3055\u3082\u306A\u304D\u3083\u3001 \u5927\u4EBA\u306B \u4EBA\u751F\u3092 \u53F0\u7121\u3057\u306B \u3055\u308C\u3061\u307E\u3046\u3002$7",
    "Rainy_Night_4": "\u306A\u3041\u3001 \u3055\u3063\u304D \u51B7\u51CD\u30D4\u30B6\u3092 \u30EC\u30F3\u30B8\u306B \u5165\u308C\u3066\u305F\u3093\u3060\u3002\u304A\u524D\u306E \u5206\u3082 \u3042\u308B\u305C\u3002[206]$h",
    "TwoKids_0": "\u671D\u65E9\u304F\u306B\u8D77\u304D\u3066\u3001 \u5B50\u3069\u3082\u9054\u306E\u30E1\u30B7\u3068\u30AA\u30E0\u30C4\u66FF\u3048\u3092 \u6E08\u307E\u305B\u3066\u304D\u305F\u305C\uFF01\u3053\u308C\u3067 \u6E96\u5099\u3088\u3057\u3001 \u3060\u306A\u3002\u304A\u524D\u306F \u91D1\u7A3C\u304E\u306B \u96C6\u4E2D\u3057\u3066\u304F\u308C\u308C\u3070 \u3044\u3044\u3093\u3060\u3002$h#$e#\u306A\u3093\u3066\u3001 \u5197\u8AC7\u3060\u3088\u2026\u30AA\u30EC\u306F \u91D1\u306E \u305F\u3081\u306B \u7D50\u5A5A\u3057\u305F\u3093\u3058\u3083\u306A\u3044\u3002",
    "TwoKids_1": "\u4E8C\u4EBA\u76EE\u306E\u5B50\u304C\u3067\u304D\u305F\u304B\u3089\u3001 %kid2\u3060\u3051\u3067\u306A\u304F %kid1\u306B\u3082 \u3061\u3083\u3093\u3068 \u304B\u307E\u3063\u3066\u3042\u3052\u3088\u3046\u3002\u5B50\u3069\u3082\u9054\u306E \u9593\u3067 \u5AC9\u59AC\u304C \u8D77\u3053\u3089\u306A\u3044 \u3088\u3046\u306B\u306D\u3002",
    "TwoKids_2": "\u5B50\u3069\u3082\u9054\u304C \u4E92\u3044\u306B \u904A\u3076\u306E\u3092 \u898B\u3066\u308B\u3068 \u697D\u3057\u3044\u3088\u306A\u3002\u4E8C\u4EBA\u3068\u3082\u3001 \u304B\u306A\u308A \u4EF2\u826F\u304F \u306A\u308C\u305D\u3046\u3060\u3002",
    "TwoKids_3": "\u30AA\u30EC\u304C \u3053\u3093\u306A \u5BB6\u5EAD\u7684\u306A\u7537\u306B \u306A\u308B\u306A\u3093\u3066 \u601D\u3044\u3082 \u3057\u306A\u304B\u3063\u305F\u304C\u3001 \u4ECA\u306E \u751F\u6D3B\u306B\u306F \u3059\u3054\u304F \u6E80\u8DB3 \u3057\u3066\u308B\u305C\u3002\u4EBA\u751F\u3001 \u3044\u3044\u611F\u3058\u3060\u306A\u3002$h",
    "fall_1": "\u4E00\u6669\u3067 \u30D0\u30EC\u30FC \u5168\u4F53\u306E \u96F0\u56F2\u6C17\u304C \u5909\u308F\u3063\u305F \u611F\u3058\u3060\u2026\u79CB\u304C \u6765\u305F\u304B\u3089 \u3060\u308D\u3046\u306A\u3002",
    "fall_15": "\u306A\u3041\u3001 \u660E\u65E5\u306F \u304A\u796D\u308A \u3060\u306A\u3002\u30B9\u30EA\u30F3\u30B0\u30B7\u30E7\u30C3\u30C8\u306E \u6280\u8853\u3092 \u53D6\u308A\u623B\u3055\u306A\u304D\u3083 \u306A\u3089\u3093\u306A\u2026",
    "fall_26": "\u4ECA\u5E74\u3053\u305D\u3001 \u30AA\u30D5\u30AF\u30ED\u304C \u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u306E \u8FF7\u8DEF\u5165\u308A\u3092 \u8A31\u3057\u3066\u304F\u308C\u308B\u304B\u306A\u3002\u305F\u3076\u3093 \u30C0\u30E1\u304B\u2026$h#$e#\u304B\u308F\u3044\u305D\u3046\u306B\u3002\u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u3082 \u3044\u305A\u308C \u7537\u306B \u306A\u3089\u306A\u304D\u3083 \u3044\u3051\u306A\u3044\u306E\u306B\u306A\u2026",
    "funLeave_Sam": "\u4ECA\u65E5\u306F \u5BB6\u65CF\u306B \u4F1A\u3044\u306B\u884C\u304F\u3088\u3002\u591C\u306B\u306F \u5E30\u3063\u3066\u304F\u308B\u305C\u3002",
    "funReturn_Sam": "\u5BB6\u65CF\u306B \u4F1A\u3046\u306E\u306F \u3044\u3044\u3053\u3068\u3060\u304C\u3001 \u305D\u308C\u3068 \u540C\u6642\u306B \u5909\u306A\u610F\u5473\u3067 \u6C17\u304C\u3081\u3044\u308B\u3093\u3060\u3088\u306A\u3002\u306A\u3093\u3066\u3044\u3046\u304B\u2026 \u30AA\u30EC\u3068 \u5BB6\u65CF\u306F \u5225\u3005\u306B \u4F4F\u3093\u3067\u308B\u304B\u3089\u3001 \u524D\u3088\u308A \u5805\u82E6\u3057\u304F\u306A\u3063\u305F \u3068\u3044\u3046\u304B\u3002$7",
    "patio_Sam": "\u30CF\u30A1\u2026\u3053\u306E\u30C8\u30EA\u30C3\u30AF\u3001\u3044\u3064\u307E\u3067\u305F\u3063\u3066\u3082\u6210\u529F\u3057\u305D\u3046\u306B\u306A\u3044\u305C\u2026$s",
    "spring_1": "\u3046\u3045\u2026 \u6625\u304B\u2026 \u30A2\u30EC\u30EB\u30AE\u30FC\u304C\u2026 \u3064\u3089\u3044\u305C\u3002$s",
    "spring_12": "\u660E\u65E5\u306E \u796D\u308A\u3092 \u697D\u3057\u307F\u306B\u3057\u3066\u308B\u306E\u304B\uFF1F\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u3068 \u307E\u305F \u4F1A\u3048\u308C\u3070 \u3044\u3044\u306A\u3002",
    "spring_23": "\u3042\u3042\u2026 \u660E\u65E5\u306F \u30D5\u30E9\u30EF\u30FC\u30C0\u30F3\u30B9 \u3060\u3063\u305F\u304B\uFF1F\u7D50\u5A5A\u3057\u305F \u4ECA\u306A\u3089\u3001 \u884C\u304B\u306A\u304F\u305F\u3063\u3066 \u3044\u3044\u3068 \u601D\u3063\u3066\u305F\u305E\u3002#$e#\u307E\u3042\u3044\u3044\u3002\u3042\u308B\u610F\u5473 \u9762\u767D\u3044\u304B\u3082 \u77E5\u308C\u306A\u3044\u304B\u3089\u306A\u3002",
    "summer_1": "\u590F\u306F \u82B1\u7C89\u304C \u6E1B\u308B\u304B\u3089\u3001 \u30AA\u30EC\u306E\u9F3B\u306B \u3084\u3055\u3057\u3044 \u5B63\u7BC0\u3060\u305C\u3002$h",
    "summer_10": "\u4ECA\u591C\u306E \u30EB\u30A2\u30A6\u30B9\u30FC\u30D7\u306B \u4F55\u3092 \u5165\u308C\u308B\u304B \u8003\u3048\u305F\u304B\uFF1F#$e#\u3072\u3069\u3044\u3082\u306E\u3092 \u5165\u308C\u305F\u307B\u3046\u304C \u697D\u3057\u3044\u3068 \u601D\u3046\u3093\u3060\u3002\u305D\u308A\u3083\u3001 \u77E5\u4E8B\u306B \u30C9\u30C3\u30AD\u30EA\u3092 \u304B\u307E\u3059\u305F\u3081\u3055\uFF01$h#$e#\u3059\u307E\u3093\u2026",
    "summer_27": "\u590F\u306F \u3044\u3044 \u5B63\u7BC0\u3060\u304C\u3001 \u3082\u3046 \u79CB\u306E \u5099\u3048\u306F \u3067\u304D\u3066\u308B\u305C\u3002#$e#\u660E\u65E5\u306E \u591C\u3001 \u4E00\u7DD2\u306B \u30AF\u30E9\u30B2\u3092 \u898B\u306B\u884C\u304B\u306A\u3044\u304B\uFF1F\u3044\u3064 \u898B\u3066\u3082 \u697D\u3057\u3044\u305C\u3002",
    "winter_1": "\u5BD2\u3044\u305B\u3044\u3067 \u9AEA\u306E \u30B8\u30A7\u30EB\u304C \u51CD\u3063\u3061\u307E\u3046\u3002\u3059\u3054\u304F \u30A4\u30E4\u306A \u611F\u3058\u3060\u305C\u3002$s",
    "winter_28": "@\u3001\u4ECA\u5E74\u306F \u3044\u3044\u5E74\u3060\u3063\u305F\u306A\u2026 \u7D42\u308F\u308B\u306E\u304C \u540D\u6B8B\u60DC\u3057\u3044\u305C\u3002#$e#\u6765\u5E74\u306F \u3082\u3063\u3068 \u3044\u3044\u5E74\u306B \u3057\u3088\u3046\u305C\uFF01$h",
    "winter_7": "\u660E\u65E5\u306E \u6C37\u796D\u308A\u3001 \u4E00\u7DD2\u306B \u884C\u304D\u307E\u3059\u304B\uFF1F\u307E\u305F \u307F\u3093\u306A\u3068 \u4F1A\u3046\u306E\u3082 \u697D\u3057\u305D\u3046\u3060\u304B\u3089\u306A\u2026"
  }
}