  "entries": {
    "Abigail": "\u96E8\u306E\u65E5\u3063\u3066\u3001 \u98A8\u666F\u304C \u3088\u308A \u8208\u5473\u6DF1\u304F \u898B\u3048\u308B\u306D\u2026 \u3042\u306A\u305F\u306F \u3069\u3046\u601D\u3046\uFF1F",
    "Alex": "\u3075\u3093\u2026\u3053\u3046\u3044\u3046 \u5929\u6C17\u3058\u3083 \u904B\u52D5\u3067\u304D\u306D\u3048\u306A\u3002$s#$e#\u307E\u3042\u3001 \u5BB6\u306E\u4E2D\u3067 \u3044\u3064\u3067\u3082 \u7B4B\u30C8\u30EC\u3067\u304D\u308B \u3051\u3069\u306A\u3002$h",
    "Caroline": "\u3046\u3061\u306E \u5EAD\u306B\u3068\u3063\u3066 \u826F\u3044\u65E5\u306D\u3002$h#$e#\u2026\u305D\u308C\u306B\u3001 \u4ECA\u6708\u306E \u6C34\u9053\u4EE3\u3082 \u5B89\u304F\u6E08\u3080\u3057\u3002",
    "Clint": "\u4ECA\u65E5\u306F \u9271\u5C71\u3092 \u63A2\u7D22\u3059\u308B\u306B\u306F \u3044\u3044\u65E5 \u304B\u3082\u306A\u2026\u305D\u3053\u3067\u3001 \u73CD\u3057\u3044 \u9271\u77F3\u304C \u898B\u3064\u304B\u308B\u6642\u3082 \u3042\u308B\u305E\u3002",
    "Demetrius": "\u3053\u3093\u306B\u3061\u306F\u3002\u5BD2\u3044\u601D\u3044\u3092 \u3057\u305F\u304F\u306A\u304B\u3063\u305F\u3089\u3001 \u4E2D\u306B \u3044\u3066\u3082 \u3044\u3044\u3088\u3002",
    "Dwarf": "\u96E8\u2026\u30AA\u30EC\u9054\u306B\u3068\u3063\u3066\u306F \u4F1D\u8AAC \u307F\u305F\u3044\u306A \u3082\u306E\u3055\u3002\u4E00\u5EA6\u3082 \u96E8\u3092 \u898B\u308B\u3053\u3068\u306A\u304F \u751F\u6DAF\u3092 \u7D42\u3048\u308B \u30C9\u30EF\u30FC\u30D5\u3060\u3063\u3066 \u3044\u308B\u304B\u3089\u306A\u3002",
    "Elliott": "\u30D9\u30C3\u30C9\u306B \u6A2A\u305F\u308F\u3063\u3066\u3044\u308B\u3068\u3001 \u6642\u3005 \u9727\u7B1B\u306E\u97F3\u304C \u96E8\u8D8A\u3057\u306B \u805E\u3053\u3048\u308B\u3093\u3060\u3002#$b#\u7A93\u3092 \u958B\u3051\u3066 \u5916\u3092 \u898B\u3066\u3082\u3001 \u7070\u8272\u306E \u30AB\u30FC\u30C6\u30F3\u3057\u304B \u898B\u3048\u306A\u3044\u3051\u3069\u306D\u3002",
    "Emily": "\u30AB\u30EA\u30B3\u7802\u6F20\u3067\u306F \u96E8\u306F \u632F\u3089\u306A\u3044\u306E\u2026\u53CB\u9054\u306E \u30B5\u30F3\u30C7\u30A3\u306F \u305D\u3053\u306B \u4F4F\u3093\u3067\u308B\u306E\u3002#$e#\u4ECA\u65E5\u306F \u5F7C\u5973\u306B \u4F1A\u3044\u306B \u3044\u3051\u305F\u3089\u306A\u3041\u3002$s",
    "Evelyn": "\u8D77\u304D\u305F\u6642\u3001 \u6C34\u306E\u843D\u3061\u308B\u97F3\u304C \u805E\u3053\u3048\u305F\u306E\u3088\u2026\u5C4B\u6839\u304B\u3089 \u96E8\u6F0F\u308A \u3057\u3066\u308B\u306E\u304B\u3057\u3089\u306D\u3002$s#$e#\u6614\u306F\u3001 \u30B8\u30E7\u30FC\u30B8\u304C \u3059\u3050\u306B \u767B\u3063\u3066 \u76F4\u3057\u306B\u3044\u3063\u3066\u305F\u3051\u3069\u2026 \u306F\u3041\u2026$s",
    "George": "\u3048\u3089\u304F \u5BD2\u3044\u3068\u306F \u601D\u308F\u3093\u304B\u306D\uFF1F\u30B5\u30A4\u30A2\u30AF\u306E\u65E5\u3058\u3083\u3002",
    "Gus": "\u3053\u3046\u3044\u3046\u65E5\u306F \u8F9B\u53E3\u306E \u8D64\u30EF\u30A4\u30F3\u3092 \u98F2\u3080\u306E\u304C \u4E00\u756A\u3060\u3002#$e#\u3053\u308C\u3060\u304B\u3089 \u30D0\u30FC\u30C6\u30F3\u30C0\u30FC\u306F \u6700\u9AD8\u3055\u3002\u3078\u3078\u3063\u3002",
    "Haley": "\u671D\u306F \u305A\u3063\u3068 \u9AEA\u306E\u30BB\u30C3\u30C8\u3092 \u3057\u3066\u305F\u3051\u3069\u2026 \u96E8\u3058\u3083 \u53F0\u7121\u3057\u306B \u306A\u3063\u3061\u3083\u3046\u308F\u3002$s#$e#\u306F\u3041\u2026\u4EBA\u751F\u3063\u3066 \u3064\u3089\u3044\u6642\u304C \u3042\u308B\u306E\u306D\u3002",
    "Harvey": "\u3042\u3089\u3001@\uFF01\u3048\u3063\u3068\u2026\u6700\u8FD1\u3001 \u56F3\u66F8\u9928\u3067 \u3053\u308C\u3068\u3044\u3046 \u9762\u767D\u3044 \u672C\u3092 \u8AAD\u307F\u307E\u3057\u305F\u304B\uFF1F#$e#\u3046\u3093\u3002\u3048\u3063\u3068\u3001\u3042\u30FC\u2026\u307E\u305F \u5F8C\u3067 \u4F1A\u3044\u307E\u3057\u3087\u3046\u3002",
    "Jodi": "\u3042\u304C\u308B\u524D\u306B \u9774\u306F \u3075\u3044\u305F\u304B\u3057\u3089\uFF1F\u3054\u3081\u3093\u306A\u3055\u3044\u306D\u2026\u5E8A\u6383\u9664\u3092 \u3057\u305F \u3070\u304B\u308A\u306A\u306E\u3088\u3002#$e#\u3067\u3082\u3001 \u3042\u306A\u305F\u306A\u3089 \u3044\u3064\u3067\u3082 \u6B53\u8FCE\u3088\uFF01\u30D5\u30D5\u30C3\u3002$h",
    "Krobus": "\u4ECA\u65E5\u306F \u4E0B\u6C34\u9053\u306E \u6D41\u308C\u304C \u901F\u3044\u3067\u3059\u306D\u3002\u3044\u3044\u611F\u3058\u306B \u6F64\u3063\u3066\u304D\u307E\u3059\u306D\u2026\u3044\u3044\u5869\u6885 \u3067\u3059\u3088\u3002",
    "Leah": "\u4ECA\u65E5\u306F \u4F55\u304B \u65B0\u3057\u3044 \u6599\u7406\u306B \u6311\u6226 \u3057\u3066\u307F\u3088\u3046\u304B\u3057\u3089\u3002\u30B9\u30D1\u30A4\u30B7\u30FC\u306A \u3084\u3064\u3092\u306D\u3002",
    "Leo": "\u96E8\u304C\u964D\u308B\u3068\u3001\u8C37\u304C\u7A4F\u3084\u304B\u306B\u306A\u308B\u3093\u3060\u3088\u3002#$e#\u30DC\u30AF\u306B\u3068\u3063\u3066\u2026\u81EA\u7136\u306F\u8272\u3093\u306A\u611F\u60C5\u3092\u6301\u3063\u305F\u3001\u8EAB\u8FD1\u306A\u53CB\u9054\u306A\u3093\u3060\u3002",
    "Lewis": "\u3084\u3041\u3001@\uFF01\u4ECA\u65E5\u306F \u4F11\u307F\u304B\u306D\uFF1F#$e#\u5DDD\u304C \u6EA2\u308C\u306A\u304D\u3083 \u3044\u3044\u3093\u3058\u3083\u304C\u2026$s",
    "Linus": "\u6696\u304B\u3044\u96E8\u306F\u3001 \u6C5A\u308C\u3092 \u304A\u3068\u3059\u306E\u306B \u3044\u3044\u306A\u3002$h",
    "Marnie": "@\u3055\u3093\u3053\u3093\u306B\u3061\u306F\u3002\u304B\u308F\u3044\u305D\u3046\u306B\u2026\u3042\u306A\u305F\u3001 \u305A\u3076\u306C\u308C \u3058\u3083\u306A\u3044\uFF01$h",
    "Maru": "\u96E8\u3063\u3066\u3001 \u4E00\u65E5\u4E2D \u30AC\u30B8\u30A7\u30C3\u30C8\u3064\u304F\u308A\u306B \u6CA1\u982D\u3059\u308B \u3044\u3044 \u7406\u7531\u306B \u306A\u308B\u306E\u3088\u306D\u3002$h#$e#\u3042\u306A\u305F\u306B\u3068\u3063\u3066\u306F \u9000\u5C48 \u3067\u3057\u3087\u3046\u3051\u3069\u3002",
    "Pam": "\u3042\u3089\u3002\u6FE1\u308C\u306A\u3044\u3088\u3046\u306B \u3057\u3066\u308B\u306E\u304B\u3044\uFF1F",
    "Penny": "\u30C8\u30EC\u30FC\u30E9\u30FC\u30CF\u30A6\u30B9\u306E \u91D1\u5C5E\u306E\u5C4B\u6839\u3058\u3083\u3001 \u96E8\u97F3\u304C \u3068\u3066\u3082 \u3046\u308B\u3055\u3044\u306E\u3088\u3002#$e#\u2026 \u5FC3\u5730\u3088\u3044 \u97F3\u3060\u3051\u3069\u3002$h",
    "Pierre": "\u3053\u3093\u306A\u65E5\u306F \u307F\u3093\u306A \u5BB6\u304B\u3089 \u51FA\u306A\u304F\u306A\u308A\u307E\u3059\u306D\u2026\u5546\u58F2 \u3042\u304C\u3063\u305F\u308A\u3067\u3059\u3088\u3002$s",
    "Robin": "\u96E8\u3050\u3089\u3044\u3067 \u4ED5\u4E8B\u306E \u624B\u3092 \u6B62\u3081\u308B\u308F\u3051\u306B\u306F \u3044\u304B\u306A\u3044\u308F\uFF01$h#$e#\u6728\u6750\u304C \u6E7F\u3063\u3066 \u4F5C\u696D\u304C \u306F\u304B\u3069\u3089\u306A\u304F\u306A\u308B\u3051\u3069\u3002$s",
    "Sam": "\u96E8\u306E \u304A\u304B\u3052\u3067\u3001 \u30AA\u30D5\u30AF\u30ED\u306B \u3057\u304B\u3089\u308C\u305A\u306B \u30AE\u30BF\u30FC\u306E \u7DF4\u7FD2\u304C \u3067\u304D\u308B\u305C\u3002\u3078\u3078\u3063\u3002$h",
    "Sandy": "\u3042\u3063\u3061\u3058\u3083 \u96E8\u304C \u632F\u3063\u3066\u308B\u3063\u3066 \u805E\u3044\u305F\u308F\u3002\u3060\u304B\u3089 \u7802\u6F20\u3078 \u304D\u305F\u306E\uFF1F$h#$e#\u5B9F\u306F\u79C1\u3001 \u96E8\u304C \u604B\u3057\u304B\u3063\u305F\u308A\u3059\u308B\u306E\u3088\u2026$s",
    "Sebastian": "\u904B\u304C\u826F\u304B\u3063\u305F\u3089\u3001 \u96E8\u306E\u65E5\u306B\u306F \u30AB\u30A8\u30EB\u304C \u898B\u308C\u308B\u304B\u3082\u306A\u3002",
    "Shane": "\u3075\u3093\u2026 \u3053\u3093\u306A\u5B63\u7BC0\u306F \u98F2\u307F\u305F\u304F\u306A\u308B\u306A\u3002$s",
    "Wizard": "\u5D50\u306E\u65E5\u306F\u3001 \u7279\u5B9A\u306E \u5143\u7D20\u3068 \u4EA4\u4FE1\u3059\u308B\u3053\u3068\u304C \u3067\u304D\u308B \u552F\u4E00\u306E \u6642\u671F\u3058\u3083\u3002#$e#\u8CB4\u6BBF\u306B\u306F \u7406\u89E3 \u3067\u304D\u308B\u3068\u306F \u601D\u3048\u306C\u304C\u306A\u3002"
  }
}