  "entries": {
    "Good_0": "@\u2026 \u7D50\u5A5A\u3067\u304D\u305F\u306A\u3093\u3066 \u4ECA\u3067\u3082 \u4FE1\u3058\u304C\u305F\u3044\u3067\u3059\u2026$l",
    "Good_1": "\u3042\u306A\u305F\u306F \u79C1\u3092 \u5B64\u72EC\u306A \u751F\u6D3B\u304B\u3089 \u6551\u3044\u51FA\u3057\u3001 \u5FC3\u306E \u7A7A\u3044\u305F\u3068\u3053\u308D\u3092 \u6E80\u305F\u3057\u3066\u304F\u308C\u307E\u3057\u305F\u3002\u672C\u5F53\u306B \u3042\u308A\u304C\u3068\u3046\u3002$l",
    "Good_2": "\u3042\u306A\u305F\u304C \u3053\u3053\u3078 \u5F15\u3063\u8D8A\u3057\u305F\u77AC\u9593\u304B\u3089\u3001 \u904B\u547D\u306E \u51FA\u4F1A\u3044\u3060\u3068 \u601D\u3063\u3066${\u305F\u308F^\u307E\u3057\u305F}$\u2026$l",
    "Good_3": "\u304A\u304A\u3001 \u4ECA\u65E5\u306E \u541B\u306F \u672C\u5F53\u306B \u304B\u3063\u3053\u3044\u3044\u306D\uFF01\u30D2\u30B2\u3092 \u305D\u308A\u307E\u3057\u305F\u304B\uFF1F$l^\u304A\u304A\u2026 \u4ECA\u65E5\u306E \u3042\u306A\u305F\u306F \u3068\u3066\u3082 \u7F8E\u3057\u3044\u3067\u3059\u306D\u3002$l",
    "Good_6": "\u5916\u3067\u306F \u6C17\u3092\u3064\u3051\u308B\u3093\u3060\u3088\uFF01\u3042\u306A\u305F\u304C \u50B7\u3064\u3044\u3066 \u5012\u308C\u3001 \u6551\u6025\u533B\u7642\u5BA4\u3078 \u904B\u3070\u308C\u308B \u60AA\u5922\u3092 \u898B\u308B\u3088\u3046\u306B \u306A\u3063\u305F\u306E\u3067\u3059\u3088\u3002$7",
    "Indoor_Day_0": "\u4EBA\u306F \u307F\u306A\u3001 \u4EBA\u751F\u306B\u304A\u3051\u308B \u8ABF\u548C\u3092 \u4F55\u3089\u304B\u306E \u5F62\u3067 \u6C42\u3081\u3066\u3044\u308B\u3068 \u601D\u3046\u306E\u3067\u3059\u3002\u8907\u96D1\u3055\u304B\u3089\u306E \u5E73\u9759 \u3067\u3059\u306D\u3002#$e#\u79C1\u306B\u3068\u3063\u3066\u306F\u3001 \u3053\u306E \u7267\u5834\u3078 \u5F15\u3063\u8D8A\u3059\u3053\u3068\u3067\u3001 \u6C42\u3081\u3066\u3044\u305F \u8ABF\u548C\u3092 \u5F97\u3089\u308C\u307E\u3057\u305F\u3088\u3002$l",
    "Indoor_Day_1": "\u304A\u306F\u3088\u3046\u3001@\uFF01\u4ECA\u65E5\u306F \u6804\u990A\u4FA1\u306E\u512A\u308C\u305F \u671D\u98DF\u3092 \u4F5C\u308A\u307E\u3057\u305F\u3088\u3002[201]#$e#\u5375\u306F \u6804\u990A\u6E80\u70B9\u3067\u3059\u304B\u3089\u3001 \u3057\u3063\u304B\u308A \u98DF\u3079\u3066\u304F\u3060\u3055\u3044\u306D\u3002",
    "Indoor_Day_2": "\u4ECA\u65E5\u306F \u533B\u7642\u6587\u5B66\u3092 \u5B66\u3076 \u3064\u3082\u308A\u3067\u3059\u3002\u6700\u65B0\u306E \u77E5\u8B58\u3092 \u5F97\u308B\u3053\u3068\u3067\u3001 \u60A3\u8005\u3055\u3093\u306B \u6700\u9AD8\u306E \u30B1\u30A2\u3092 \u65BD\u305B\u307E\u3059\u304B\u3089\u306D\uFF01",
    "Indoor_Day_3": "\u4ECA\u65E5\u306F \u30B8\u30E3\u30BA\u3092 \u805E\u304D\u306A\u304C\u3089 \u533B\u7642\u5831\u544A\u66F8\u3092 \u4ED5\u4E0A\u3052\u308B \u3064\u3082\u308A\u3067\u3059\u3002\u305D\u3061\u3089\u306F \u3069\u3093\u306A \u4E88\u5B9A\u3092 \u7ACB\u3066\u307E\u3057\u305F\u304B\uFF1F",
    "Indoor_Day_4": "\u521D\u3081\u3066 \u4F1A\u3063\u305F\u6642\u3001 \u3042\u306A\u305F\u306E \u3053\u3068\u3092 \u6050\u308C\u3066\u3044\u307E\u3057\u305F\u3002\u305D\u3053\u304B\u3089 \u3053\u3093\u306A \u95A2\u4FC2\u306B \u306A\u308B\u306A\u3093\u3066\u3001 \u8003\u3048\u308B\u3060\u3051\u3067\u3082 \u9762\u767D\u3044\u3067\u3059\u3088\u306D\u3002$h",
    "Indoor_Night_0": "\u304A\u3084\u304A\u3084\u3001 \u75B2\u308C\u3066\u308B \u3088\u3046\u3067\u3059\u306D\u3002\u4ECA\u591C\u306F \u30DE\u30C3\u30B5\u30FC\u30B8 \u3057\u3066\u3042\u3052\u307E\u3057\u3087\u3046\u3002\u7B4B\u8089\u7D44\u7E54\u306E \u708E\u75C7\u3092 \u6291\u3048\u3066\u304F\u308C\u308B \u306F\u305A\u3067\u3059\u3088\uFF01$l",
    "Indoor_Night_1": "\u4ECA\u65E5\u306F \u3086\u3063\u304F\u308A\u2026 \u672C\u3092\u8AAD\u3093\u3067\u3001 \u7121\u7DDA\u3092 \u3044\u3058\u3063\u3066\u3001 \u98DB\u884C\u6A5F\u6A21\u578B\u306E \u4F5C\u6210\u3092\u3057\u3066 \u904E\u3054\u3057\u307E\u3057\u305F\u3002#$e#\u305F\u307E\u306B\u306F\u3001 \u4E38\u4E00\u65E5 \u4F11\u3093\u3067 \u30EA\u30E9\u30C3\u30AF\u30B9 \u3059\u308B\u3053\u3068\u3082 \u5927\u5207\u3067\u3059\u3088\u2026 \u30B9\u30C8\u30EC\u30B9\u306F \u75C5\u306E\u6E90 \u3067\u3059\u304B\u3089\u306D\u3002",
    "Indoor_Night_2": "\u304A\u304B\u3048\u308A\u2026 \u4ECA\u65E5\u306F \u3084\u308B\u3079\u304D \u3053\u3068\u3092 \u5168\u3066 \u7D42\u308F\u3089\u305B\u308B\u3053\u3068\u304C \u3067\u304D\u307E\u3057\u305F\u304B\uFF1F#$e#\u79C1\u306E\u307B\u3046\u306F \u5927\u4E08\u592B\u3067\u3059\u3088\u3002\u81EA\u5206\u3067 \u4F55\u3068\u304B \u3067\u304D\u307E\u3059\u304B\u3089\u3002\u307E\u3060 \u4ED5\u4E8B\u304C \u6B8B\u3063\u3066\u3044\u308B\u306A\u3089\u3001 \u305D\u306E\u307E\u307E \u53D6\u308A\u639B\u304B\u3063\u3066\u3082 \u3044\u3044\u3067\u3059\u3088\u3002",
    "Indoor_Night_3": "\u533B\u8005\u3068\u3057\u3066\u306E \u4ED5\u4E8B\u306F \u30B9\u30C8\u30EC\u30B9\u304C \u305F\u307E\u308A\u304C\u3061 \u3067\u3059\u304B\u3089\u3001 %farm\u7267\u5834 \u307F\u305F\u3044\u306A \u5834\u6240\u306F \u3068\u3066\u3082 \u5C45\u5FC3\u5730\u3088\u304F \u611F\u3058\u307E\u3059\u3088\u3002",
    "Indoor_Night_4": "\u3042\u3063\uFF01\u4ECA\u65E5\u306F \u5FAA\u74B0\u5668\u306E \u3053\u3068\u3092 \u8003\u3048\u3066\u3057\u307E\u3063\u3066\u3001 \u3084\u3063\u3066\u3044\u305F\u3053\u3068\u3092 \u5FD8\u308C\u3066\u3057\u307E\u3063\u305F\u306E\u3067\u3059\u3088\u3002\u533B\u8005\u306A\u3089 \u3088\u304F\u3042\u308B \u554F\u984C\u3067\u3059\u306D\u3002",
    "OneKid_0": "\u3042\u306A\u305F\u3068 %kid1\u306F\u3001\u79C1\u306E \u4EBA\u751F\u3067 \u4E00\u756A \u5927\u5207\u306A \u5B58\u5728\u3067\u3059\u3002",
    "OneKid_1": "%kid1\u306F \u3053\u3053\u3067 \u30AB\u30F3\u30DA\u30AD\u306A \u5E7C\u5C11\u751F\u6D3B\u3092 \u904E\u3054\u305B\u308B\u3060\u308D\u3046\u3002\u3053\u306E\u3088\u3046\u306A \u6A5F\u4F1A\u3092 \u3082\u3066\u308B\u3068\u306F \u307E\u3055\u3057\u304F \u5E78\u904B \u3067\u3059\u3088\u306D\u3002",
    "OneKid_3": "\u7236\u89AA\u3067 \u3044\u3089\u308C\u3066\u3001 \u3068\u3066\u3082 \u3046\u308C\u3057\u3044\u3067\u3059\u3088\uFF01$h",
    "Outdoor_0": "\u3053\u3053\u306F \u3068\u3066\u3082 \u5B89\u5168\u306A \u5834\u6240\u3067\u3059\u306D\u3002\u79C1\u306E\u3053\u3068\u306F \u5FC3\u914D\u3057\u306A\u3044\u3067\u3001 \u601D\u3046\u5B58\u5206 \u4ED5\u4E8B\u306B \u53D6\u308A\u639B\u304B\u3063\u3066\u304F\u3060\u3055\u3044\u3002",
    "Outdoor_1": "\u79D1\u5B66\u7684\u89B3\u70B9\u304B\u3089\u3001 \u3053\u306E\u5BB6\u306F \u5B50\u3069\u3082\u3092 \u80B2\u3066\u308B\u306E\u306B \u6700\u9069\u306A\u5834\u6240 \u3067\u3057\u3087\u3046\u3002\u3042\u306A\u305F\u306F \u3069\u3046 \u304A\u8003\u3048\u3067\u3059\u304B\uFF1F",
    "Outdoor_2": "\u79C1\u306F \u7279\u306B \u523A\u6FC0\u7684\u306A \u7537\u6027\u3067\u306F \u3042\u308A\u307E\u305B\u3093\u304C\u3001 \u751F\u6DAF \u3042\u306A\u305F\u306B \u5C3D\u304F\u3059 \u3064\u3082\u308A\u3067\u3059\u3002$l",
    "Outdoor_3": "@\u2026 \u3042\u306A\u305F\u306F\u2026 \u79C1\u306B \u3068\u3063\u3066 \u4E16\u754C \u305D\u306E\u3082\u306E\u3067\u3059\u3002$l",
    "Outdoor_4": "\u79D1\u5B66\u8005\u3068\u3057\u3066\u3001 \u866B\u3068 \u690D\u7269\u306E \u5FAE\u7D30\u306A \u76F8\u4E92\u4F5C\u7528\u304C \u9B45\u529B\u7684\u306B \u601D\u3048\u308B\u306E\u3067\u3059\u3002",
    "Rainy_Day_0": "\u96E8\u5929\u306E\u65E5\u3068 \u767A\u751F\u3057\u3084\u3059\u304F\u306A\u308B \u30A4\u30F3\u30D5\u30EB\u30A8\u30F3\u30B6\u3068\u306E \u95A2\u4FC2\u6027\u306F \u4E0D\u660E\u3067\u3059\u3002\u3067\u3059\u304C\u3001 \u8DB3\u3092 \u6ED1\u3089\u305B\u306A\u3044\u3088\u3046 \u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\uFF01#$e#\u3042\u306A\u305F\u306E \u3053\u3068\u304C \u305F\u3073\u305F\u3073 \u5FC3\u914D\u306B \u306A\u308B\u306E\u3067\u3059\u3088\u3002",
    "Rainy_Day_1": "\u8A3A\u7642\u6240\u306E 2\u968E\u3067 \u4E00\u4EBA\u66AE\u3089\u3057\u3092 \u3057\u3066\u305F \u9803 \u672C\u5F53\u306B \u3055\u3073\u3057\u304B\u3063\u305F\u3067\u3059\u3088\u2026\u4ECA\u306F \u3068\u3066\u3082 \u5E78\u305B\u3067\u3059\u3002$h",
    "Rainy_Day_2": "\u671D\u306F\u65E9\u304F \u8D77\u304D\u307E\u3057\u305F\u304C\u3001 \u3042\u306A\u305F\u3092 \u8D77\u3053\u3055\u306A\u3044\u3088\u3046\u306B \u3057\u3066\u307E\u3057\u305F\u3002\u3059\u3054\u304F \u7A4F\u3084\u304B\u306A \u5BDD\u9854 \u3067\u3057\u305F\u3082\u306E\u3067\u3002",
    "Rainy_Day_3": "\u96E8\u306F \u7279\u306B \u6C17\u306B\u306A\u308A\u307E\u305B\u3093\u306D\u3002\u98DB\u884C\u6A5F\u306E \u98DB\u3076\u59FF\u3092 \u898B\u308B\u3053\u3068\u306F \u3067\u304D\u307E\u305B\u3093\u304C\u3001 \u7121\u7DDA\u306F \u307E\u3060 \u805E\u3051\u307E\u3059\u304B\u3089\u3002#$e#\u97F3\u58F0\u3060\u3051\u306E \u307B\u3046\u304C\u3001 \u3088\u308A \u8208\u5473\u3092 \u305D\u305D\u3089\u308C\u307E\u3059\u3088\u306D\u3002",
    "Rainy_Day_4": "\u4ECA\u65E5\u306F\u3001\u7D42\u308F\u3089\u305B\u308B \u4E88\u5B9A\u306E \u5BB6\u4E8B\u304C \u6CA2\u5C71 \u3042\u308A\u307E\u3059\u3002\u9000\u5C48 \u3059\u308B\u3053\u3068\u306F \u306A\u3055\u305D\u3046\u3067\u3059\u306D\uFF01",
    "Rainy_Night_0": "\u672C\u65E5\u306F \u3044\u304B\u304C\u3067\u3057\u305F\u304B\uFF1F\u79C1\u306F \u76BF\u6D17\u3044\u3092 \u3059\u308B \u3064\u3082\u308A\u3067\u3057\u305F\u304C\u3001 \u3064\u3044 \u300C\u819D\u306E\u5916\u79D1\u624B\u8853\u30D5\u30A1\u30F3\u300D \u6700\u65B0\u53F7\u3092 \u8AAD\u307F\u3075\u3051\u3063\u3066\u3057\u307E\u3044\u307E\u3057\u305F\u3002",
    "Rainy_Night_1": "\u4EBA\u751F\u304C \u697D\u3057\u3051\u308C\u3070\u3001 \u540C\u3058\u3053\u3068\u306E \u7E70\u308A\u8FD4\u3057\u3067\u3082 \u3044\u3044\u3058\u3083\u306A\u3044\u3067\u3059\u304B\u3002\u79C1\u306F \u305D\u3046\u601D\u3044\u307E\u3059\u3088\u3002",
    "Rainy_Night_2": "\u5C11\u3057 \u6FE1\u308C\u3066\u3044\u308B \u307F\u305F\u3044\u3067\u3059\u306D\u3002\u706B\u306E \u305D\u3070\u3067 \u6E29\u307E\u3063\u3066\u306F \u3044\u304B\u304C\u3067\u3057\u3087\u3046\u304B\uFF1F",
    "Rainy_Night_3": "\u96E8\u97F3\u3092 \u805E\u3044\u3066\u3044\u308B\u3068\u3001 \u4F59\u8A08\u306A\u3053\u3068\u306B \u6C17\u304C\u5411\u304B\u306A\u3044\u3088\u3046 \u7CBE\u795E\u304C \u96C6\u4E2D\u3057\u307E\u3059\u306D\u3002#$e#\u96E8\u97F3\u304C \u5FC3\u5730\u3088\u304F \u611F\u3058\u308B\u306E\u306F \u305D\u3046\u3044\u3046\u3053\u3068 \u3067\u3057\u3087\u3046\u304B\u306D\u2026",
    "Rainy_Night_4": "\u5065\u5EB7\u3092 \u610F\u8B58\u3057\u3066 \u5915\u98DF\u3092 \u4F5C\u308A\u307E\u3057\u305F\u3088\u3002\u30D0\u30EC\u30FC\u3067 \u63A1\u308C\u305F\u3066\u306E\u3001 \u65B0\u9BAE\u306A \u98DF\u6750\u306E\u307F\u3092 \u4F7F\u3044\u307E\u3057\u305F\uFF01[212 214 225 209 200]$h#$e#\u3042\u307E\u308A \u98DF\u3079\u904E\u304E\u306A\u3044\u3088\u3046\u3001 \u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D\u3002",
    "TwoKids_0": "\u3082\u3046 %kid1\u3068%kid2\u306B\u306F \u671D\u98DF\u3092 \u98DF\u3079\u3055\u305B\u307E\u3057\u305F\u3002\u4E8C\u4EBA\u306B\u306F \u30D8\u30EB\u30B7\u30FC\u306A \u98DF\u4E8B\u3092 \u697D\u3057\u3081\u308B\u3088\u3046 \u6559\u3048\u3066\u307E\u3059\u3088\uFF01",
    "TwoKids_1": "\u5B50\u3069\u3082\u306F \u5FC3\u306E \u8D74\u304F\u307E\u307E\u306B \u904A\u3076\u3053\u3068\u3092 \u8A31\u3055\u308C\u308B \u3079\u304D\u3060\u3068 \u601D\u3046\u306E\u3067\u3059\u3002\u5E7C\u5C11\u6642\u4EE3\u306F \u4E00\u5EA6\u304D\u308A \u3067\u3059\u304B\u3089\u306D\u3002",
    "TwoKids_2": "%kid2\u304C \u6210\u9577\u3057\u305F\u3089\u3001 \u79C1\u3067\u306F \u6210\u3057\u3048\u306A\u304B\u3063\u305F \u30D1\u30A4\u30ED\u30C3\u30C8\u306B \u306A\u308C\u308B\u306E \u3067\u3057\u3087\u3046\u304B\u306D\uFF1F",
    "TwoKids_3": "\u79C1\u306E \u4EBA\u751F\u306F \u3042\u306A\u305F\u3068 \u5B50\u3069\u3082\u9054\u306B \u3055\u3055\u3052\u308B \u3064\u3082\u308A\u3067\u3059\u304C\u3001 \u3059\u3054\u304F \u5E78\u305B\u3067\u3059\u3088\u3002\u3053\u3093\u306A \u3059\u3070\u3089\u3057\u3044 \u5BB6\u5EAD\u3092 \u6301\u3061\u305F\u3044\u3068 \u305A\u3063\u3068 \u5922\u898B\u3066\u3044\u307E\u3057\u305F\u304B\u3089\u3002$l#$e#\u72EC\u8EAB\u3067 \u751F\u6DAF\u3092\u904E\u3054\u3059 \u60AA\u5922\u3092 \u898B\u305F\u3053\u3068\u3082 \u3042\u308A\u307E\u3057\u305F\u2026\u3042\u306A\u305F\u306E\u3053\u3068\u304C \u611B\u3057\u304F\u3066 \u305F\u307E\u308A\u307E\u305B\u3093\u3088\u3002$l",
    "fall_1": "\u3053\u306E\u79CB\u306F \u69D8\u3005\u306A \u7A2E\u985E\u306E \u4F5C\u7269\u3092 \u80B2\u3066\u308B\u3088\u3046\u306B \u3059\u308B\u306E\u3067\u3059\u3088\u3002#$e#\u30AF\u30E9\u30F3\u30D9\u30EA\u30FC \u3060\u3051\u3067\u3082 \u304B\u307E\u3044\u307E\u305B\u3093\u304C\u2026\u3042\u306A\u305F\u306B \u304A\u4EFB\u305B\u3057\u307E\u3059\u3002\u79C1\u304C \u6C7A\u3081\u308B\u3053\u3068\u3067\u306F \u3042\u308A\u307E\u305B\u3093\u306E\u3067\u3002",
    "fall_15": "\u660E\u65E5\u306F \u304A\u796D\u308A \u3067\u3059\u306D\u3002\u51FA\u3055\u308C\u308B \u98DF\u3079\u7269\u306E \u5473\u306F \u6FC3\u3044\u3082\u306E \u3070\u304B\u308A\u3067\u3059\u304C\u3001 \u305F\u307E\u306B\u306F \u305C\u3044\u305F\u304F\u3082 \u3044\u3044\u304B\u3082 \u3057\u308C\u307E\u305B\u3093\u306D\u3002$h",
    "fall_26": "\u30B9\u30D4\u30EA\u30C3\u30C8\u30A4\u30D6\u306B\u306A\u308B\u3068\u3001 \u3044\u3064\u3082 \u304A\u8179\u304C \u75DB\u304F\u306A\u308B\u306E\u3067\u3059\u2026 \u3067\u3082 \u52C7\u6C17\u3092\u632F\u308A\u7D5E\u308C\u308B\u3088\u3046 \u52AA\u529B\u3057\u307E\u3059\u3088\u3002",
    "funLeave_Harvey": "\u4ECA\u65E5\u306F \u5C11\u3057 \u6B69\u3053\u3046\u304B\u3068 \u601D\u3046\u3093\u3067\u3059\u3002\u4F53\u3092 \u307B\u3050\u3055\u306A\u3044\u3068\u3001 \u3067\u3059\u306D\u3002",
    "funReturn_Harvey": "\u4ECA\u65E5\u306F \u826F\u3044 \u4E00\u65E5\u3067\u3057\u305F\u3088\u3002\u305F\u307E\u306B\u306F \u4E00\u4EBA\u3067 \u6642\u9593\u3092 \u904E\u3054\u3059\u306E\u3082\u3001 \u6C17\u5206\u8EE2\u63DB\u306B \u826F\u3044\u3067\u3059\u306D\u3002\u3042\u306A\u305F\u3082 \u826F\u3044\u4E00\u65E5\u3092 \u904E\u3054\u305B\u307E\u3057\u305F\u304B\uFF1F",
    "patio_Harvey": "\u306D\u3048\u3001\u5B66\u8853\u8A8C\u3092\u58F0\u306B\u51FA\u3057\u3066\u8AAD\u3093\u3067\u3082\u3044\u3044\u304B\u306A\u3002\u3053\u306E\u201C\u30B8\u30E3\u30FC\u30CA\u30EB\u300C\u8171\u306E\u529B\u5B66\u300D\u201D\u306A\u3089\u3001\u305D\u3053\u307E\u3067\u30B8\u30E3\u30DE\u306B\u306A\u3089\u306A\u3044\u3068\u601D\u3046\u3093\u3060\u3088\u3002",
    "spring_1": "\u690D\u7269\u304C \u606F\u3092 \u5439\u304D\u8FD4\u3059 \u5149\u666F\u306F \u3059\u3070\u3089\u3057\u3044\u3067\u3059\u3002\u771F\u3063\u767D\u306A \u51AC\u306E\u5F8C\u306B\u3001 \u7DD1\u304C \u623B\u3063\u3066\u304D\u3066\u3044\u307E\u3059\u306D\u3002",
    "spring_12": "\u660E\u65E5\u306F \u796D\u308A \u3067\u3057\u305F\u3063\u3051\uFF1F\u6CA2\u5C71\u306E \u4EBA\u3005\u3084 \u6D3B\u6C17\u3092 \u8003\u3048\u308B\u3068\u2026 (\u3054\u304F\u308A)$s",
    "spring_23": "\u3042\u3001\u660E\u65E5\u306E \u30D5\u30E9\u30EF\u30FC\u30C0\u30F3\u30B9\u3067 \u4E00\u7DD2\u306B \u79C1\u3068 \u8E0A\u308A\u307E\u305B\u3093\u304B\uFF1F$7#$e#\u3044\u3064\u3082\u3001 \u8A98\u3046\u6642\u306B \u5C11\u3057 \u6065\u305A\u304B\u3057\u304F \u306A\u308A\u307E\u3059\u306D\u3002$7",
    "summer_1": "\u65E5\u713C\u3051\u306B\u306F \u6C17\u3092\u3064\u3051\u308B\u306E\u3067\u3059\u3088\uFF01\u808C\u306B \u6DF1\u523B\u306A \u30C0\u30E1\u30FC\u30B8\u3092 \u4E0E\u3048\u307E\u3059\u304B\u3089\u306D\u3002$8#$e#\u592B\u3068\u3057\u3066\u3001 \u533B\u8005\u3068\u3057\u3066\u3001 \u3042\u306A\u305F\u306E \u5B89\u5168\u304C \u7B2C\u4E00 \u306A\u306E\u3067\u3059\u3088\uFF01",
    "summer_10": "\u4ECA\u591C\u306E \u30EB\u30A2\u30A6\u30B9\u30FC\u30D7\u306B \u4F55\u3092 \u5165\u308C\u308B\u304B \u8003\u3048\u307E\u3057\u305F\u304B\uFF1F#$e#\u79C1\u306F \u4FA1\u5024\u3068 \u54C1\u8CEA\u306E \u9AD8\u3044\u3082\u306E\u3092 \u5165\u308C\u3088\u3046\u3068 \u601D\u3063\u3066\u3044\u307E\u3059\u3002\u77E5\u4E8B\u3055\u3093\u306B \u597D\u5370\u8C61\u3092 \u6B8B\u3057\u305F\u3044 \u3067\u3059\u304B\u3089\u306D\uFF01",
    "summer_27": "\u590F\u304C \u7D42\u308F\u308B\u306B \u3064\u308C\u3066 \u5BD2\u3044 \u5B63\u7BC0\u304C \u59CB\u307E\u308A\u3001 \u79C1\u306E \u4F5C\u696D\u91CF\u3082 \u5897\u3048\u3066\u3044\u304F\u306E\u3067\u3059\u3088\u3002\u5C11\u3057 \u3061\u8FBC\u3093\u3067\u3057\u307E\u3063\u3066 \u3059\u307F\u307E\u305B\u3093\u306D\u2026",
    "winter_1": "\u51AC\u5834\u306F \u7A7A\u6C17\u304C \u3068\u3066\u3082 \u4E7E\u71E5\u3057\u307E\u3059\u3002\u3060\u304B\u3089 \u808C\u304C \u304B\u3086\u304F\u306A\u308B\u306E\u3067\u3059\u3002#$e#\u6BCE\u6669\u3001 \u3042\u306A\u305F\u306E \u80CC\u4E2D\u306B \u30C8\u30EA\u30E5\u30D5\u30AA\u30A4\u30EB\u3092 \u5857\u3063\u3066\u3042\u3052\u307E\u3059\u304B\u3089 \u5FC3\u914D\u306F \u3044\u308A\u307E\u305B\u3093\u3088\u3002$l",
    "winter_28": "\u826F\u3044 \u5E74\u3092 \u795D\u3063\u3066\u3001 \u4E7E\u676F\u3002\u6765\u5E74\u306F \u78BA\u5B9F\u306B\u3001 \u4ECA\u5E74\u3088\u308A\u3082 \u305A\u3063\u3068 \u826F\u3044 \u5E74\u306B \u306A\u308B\u3067\u3057\u3087\u3046\uFF01$h",
    "winter_7": "\u660E\u65E5\u306E \u6C37\u796D\u308A\u3001 \u4E00\u7DD2\u306B \u884C\u304D\u307E\u3059\u304B\uFF1F\u79C1\u306F \u304B\u307E\u304F\u3089\u304C \u597D\u304D\u3067\u3059\u3088\u2026"
  }
}