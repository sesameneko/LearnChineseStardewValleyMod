    "AcceptBirthdayGift_Negative": "\u8A95\u751F\u65E5\u3092\u899A\u3048\u3066\u3066\u304F\u308C\u3066\u305F\u3093\u3060\u306D\uFF01\u3042\u308A\u304C\u3068\u3046\u3001@\uFF01\u3068\u3063\u3066\u3082\u2026$h#$b#\u2026\uFF08\u30AF\u30F3\u30AF\u30F3\uFF09\u2026 \u5909\u306A\u306B\u304A\u3044\u304C\u3059\u308B\u3088\uFF1F$s#$b#\u2026\u3053\u308C\u306A\u3042\u306B\u2026\uFF1F$s",
    "AcceptBirthdayGift_Positive": "\u8A95\u751F\u65E5\u3092\u899A\u3048\u3066\u3066\u304F\u308C\u3066\u305F\u3093\u3060\u306D\uFF01\u3042\u308A\u304C\u3068\u3046\u3001@\uFF01\u3068\u3063\u3066\u3082\u3046\u308C\u3057\u3044\u3088\u3002$h",
    "AcceptGift_(O)60": "$c 0.5#\u308F\u3042\uFF01\u3046\u3075\u3075\u2026\u3069\u3046\u3057\u3066\u4ECA\u65E5\u3042\u306A\u305F\u304C\u3053\u306E\u77F3\u3092\u304F\u308C\u305F\u306E\u304B\u3001\u79C1\u306B\u306F\u308F\u304B\u308B\u308F\u3002\u3068\u3066\u3082\u4E0D\u601D\u8B70\u3060\u3051\u3069\u2026#\u3042\u3042\u3001\u306A\u3093\u3066\u304D\u308C\u3044\u306A\u306E\uFF01\u68EE\u304C\u6301\u3063\u3066\u3044\u308B\u30B9\u30D4\u30EA\u30C1\u30E5\u30A2\u30EB\u306A\u30D1\u30EF\u30FC\u3092\u611F\u3058\u308B\u308F\u2026\u3042\u306A\u305F\u3082\u6728\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u611F\u3058\u306A\u3044\uFF1F",
    "AcceptGift_(O)62": "$c 0.5#\u3068\u3063\u3066\u3082\u304D\u308C\u3044\u306D\uFF01\u3053\u308C\u3092\u6301\u3063\u3066\u3044\u308B\u3068\u2026\u6D77\u306B\u3044\u308B\u4EBA\u9B5A\u305F\u3061\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u611F\u3058\u308B\u306E\u3002\u3042\u308A\u304C\u3068\u3046\uFF01#\u3046\u308C\u3057\u3044\u3088\uFF01\u6795\u306E\u4E0B\u306B\u7F6E\u3044\u305F\u3089\u3001\u6D77\u306E\u5922\u304C\u898B\u3089\u308C\u308B\u3068\u3044\u3044\u306A\u3002",
    "AcceptGift_(O)64": "$c 0.5#\u308F\u3041\u3001\u3059\u3066\u304D\u306A\u8272\uFF01\u79C1\u306E\u670D\u306B\u3074\u3063\u305F\u308A\u3060\u308F\u3002$h#\u3046\u3093\u3001\u30AB\u30F3\u30DA\u30AD\u2026\u6700\u8FD1\u3001\u5C11\u3057\u5143\u6C17\u304C\u306A\u304B\u3063\u305F\u3093\u3060\u3051\u3069\u2026\u30EB\u30D3\u30FC\u306B\u306F\u7CBE\u795E\u3092\u6D3B\u6027\u5316\u3059\u308B\u529B\u304C\u3042\u308B\u3093\u3060\u3088\uFF01",
    "AcceptGift_(O)66": "$c 0.5#\u3068\u3063\u3066\u3082\u304D\u308C\u3044\u306D\u3001@\uFF01\u3053\u308C\u3092\u898B\u3064\u3051\u308B\u307E\u3067\u306B\u5371\u306A\u3044\u76EE\u306B\u5408\u308F\u306A\u304B\u3063\u305F\uFF1F$h#\u3042\u3042\u3001\u30A2\u30E1\u30B7\u30B9\u30C8\uFF01\u30B5\u30EB\u30FC\u30F3\u3067\u591C\u9045\u304F\u307E\u3067\u50CD\u304F\u79C1\u3092\u5B88\u3063\u3066\u304F\u308C\u308B\u306E\u3088\u3002",
    "AcceptGift_(O)68": "$c 0.5#\u308F\u3041\u2026\u3042\u308A\u304C\u3068\u3046\uFF01\u4ECA\u65E5\u306E\u6C17\u5206\u306B\u3074\u3063\u305F\u308A\u306A\u8272\u3060\u308F\u3002$h#\u3053\u306E\u77F3\u306E\u6E29\u304B\u304F\u3066\u512A\u3057\u3044\u30A8\u30CD\u30EB\u30AE\u30FC\u306F\u3001\u79C1\u305F\u3061\u306E\u5FC3\u3092\u6B63\u3057\u3044\u65B9\u5411\u306B\u5C0E\u3044\u3066\u304F\u308C\u308B\u306E\u3002\u4ECA\u65E5\u307F\u305F\u3044\u306A\u65E5\u3068\u76F8\u6027\u304C\u3044\u3044\u3093\u3060\u3088\u3002\u3042\u308A\u304C\u3068\u3046\uFF01",
    "AcceptGift_(O)70": "$c 0.5#\u3059\u3054\u3044\u308F\uFF01 \u4ECA\u65E5\u3001\u3042\u306A\u305F\u304C\u30D2\u30B9\u30A4\u3092\u304F\u308C\u308B\u5922\u3092\u898B\u305F\u306E\uFF01$h#\u3042\u3042\u3001\u30D2\u30B9\u30A4\uFF01\u91D1\u904B\u30A2\u30C3\u30D7\u306E\u30D1\u30EF\u30FC\u30B9\u30C8\u30FC\u30F3\u3060\u304B\u3089\u2026\u3060\u308C\u304B\u304A\u91D1\u306B\u56F0\u3063\u3066\u308B\u4EBA\u306F\u3044\u306A\u3044\u304B\u306A\uFF1F$h",
    "AcceptGift_(O)StardropTea": "\u308F\u3042\u3001\u3042\u308A\u304C\u3068\u3046\uFF01\u5BDD\u308B\u524D\u306B\u98F2\u3080\u3068\u3001\u3068\u3066\u3082\u9BAE\u3084\u304B\u306A\u5922\u304C\u898B\u308C\u308B\u305D\u3046\u3088\u3002",
    "AcceptGift_(TR)ParrotEgg": "\u3088\u304B\u3063\u305F\u3001\u307E\u3060\u6E29\u304B\u3044\u2026\u304B\u308F\u3044\u305D\u3046\u306B\u3001\u304A\u6BCD\u3055\u3093\u306F\u3069\u3053\uFF1F \u3042\u3042\u2026 \u79C1\u304C\u304A\u6BCD\u3055\u3093\u306B\u306A\u3063\u3066\u3042\u3052\u308B\u304B\u3089\u5FC3\u914D\u3057\u306A\u3044\u3067\u306D\u2026\u304A\u3061\u3073\u3061\u3083\u3093\u3002$s#$b#@\u3001\u3053\u306E\u5B50\u3092\u79C1\u306B\u3042\u305A\u3051\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3002\u3061\u3083\u3093\u3068\u4E16\u8A71\u3092\u3059\u308B\u304B\u3089\u306D\u3002",
    "FlowerDance_Accept": "\u3048\u3048\u3001@\uFF01\u3042\u306A\u305F\u3068\u8E0A\u308A\u305F\u3044\u308F\uFF01$h#$e#\u30EF\u30AF\u30EF\u30AF\u3059\u308B\u306D\u2026\u304D\u3063\u3068\u697D\u3057\u304F\u306A\u308B\u3088\uFF01",
    "FlowerDance_Accept_Spouse": "\u3044\u3044\u3088\u3001\u8E0A\u308D\u3046\u3002\u524D\u304B\u3089\u305A\u3063\u3068\u697D\u3057\u307F\u306B\u3057\u3066\u305F\u3093\u3060\uFF01$h",
    "FlowerDance_Decline": "\u3054\u3081\u3093\u306D\u2026\u30C0\u30F3\u30B9\u306E\u76F8\u624B\u3001\u3082\u3046\u6C7A\u307E\u3063\u3066\u308B\u3093\u3060\u3002$u",
    "Fri": "\u3042\u3042\u3001\u6625\u306D\u3002\u30D1\u30B9\u30C6\u30EB\u30AB\u30E9\u30FC\u306E \u5B63\u7BC0\u3002\u8272\u5408\u3044\u306F \u30D1\u30B9\u30C6\u30EB\u3088\u308A \u5B9D\u77F3\u306E\u307B\u3046\u304C \u597D\u304D\u3060\u3051\u3069\u3002#$b#\u3042\u3089\u3001\u3054\u3081\u3093\uFF01\u307E\u305F\u30D5\u30A1\u30C3\u30B7\u30E7\u30F3\u306E\u3053\u3068\u3067 \u72EC\u308A\u8A00 \u3057\u3066\u305F\uFF1F",
    "GreenRain": "\u3053\u308C\u306B\u306F\u306A\u306B\u304B\u610F\u5473\u304C\u3042\u308B\u3068\u601D\u3046\u3093\u3060\u2026\u81EA\u7136\u304C\u79C1\u305F\u3061\u306B\u4F55\u304B\u4F1D\u3048\u3088\u3046\u3068\u3057\u3066\u308B\u3093\u3060\u3088\u3002$3#$e#\u3067\u3082\u3001\u3044\u3063\u305F\u3044\u306A\u306B\u3092\uFF1F\u79C1\u306B\u306F\u2026\u308F\u304B\u3089\u306A\u3044\u2026\u3067\u3082\u529B\u5F37\u3044\u4F55\u304B\u3092\u611F\u3058\u308B\u306E\u2026$3",
    "GreenRain_2": "\u3042\u306A\u305F\u306F\u611F\u3058\u308B\uFF1F\u68EE\u304C\u6B4C\u3063\u3066\u3044\u308B\u308F\uFF01\u6728\u3005\u304C\u697D\u3057\u305D\u3046\u306B\u8E0A\u3063\u3066\u3044\u308B\u306E\uFF01",
    "Introduction": "\u3042\u3089\u2026\uFF01\u305D\u306E\u9854\u3092\u898B\u305F\u3060\u3051\u3067\u308F\u304B\u308B\u308F\u3002\u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3\u3092 \u6C17\u306B\u5165\u308B \u3060\u308D\u3046\u3063\u3066\u3002#$b#\u3082\u3057\u591C\u306B \u4F55\u304B\u3057\u305F\u304F\u306A\u3063\u305F\u3089\u3001 \u9152\u5834\u306B\u304A\u3044\u3067\u3088\u3002\u79C1\u306F\u305D\u3053\u3067 \u50CD\u3044\u3066\u308B\u304B\u3089\uFF01",
    "Mon": "\u79C1\u3068\u30D8\u30A4\u30EA\u30FC\u306F \u59C9\u59B9\u3060\u3063\u3066 \u8A71\u3057\u305F\u3063\u3051\uFF1F\u304A\u304B\u3057\u3044\u306A\u3041\u3002",
    "Mon2": "\u308F\u305F\u3057\u3001\u30D2\u30DF\u30C4\u306E\u8DA3\u5473\u304C\u3042\u308B\u306E\u3002\u3069\u3093\u306A\u8DA3\u5473\u304B\u306F\u306A\u3044\u3057\u3087\u3002#$e#\u4EF2\u3088\u304F\u306A\u3063\u305F\u3089\u6559\u3048\u3066\u3042\u3052\u308B\u304B\u3082\u306D\u3002$h",
    "Mon4": "\u3053\u306E\u4E16\u754C\u306B\u306F\u3001\u7CBE\u970A\u3084\u9B54\u6CD5\u306E\u30C1\u30AB\u30E9\u304C\u3044\u3063\u3071\u3044\u6E80\u3061\u3066\u308B\u3093\u3060\u2026\u4FE1\u3058\u306A\u3044\u4EBA\u3082\u3044\u308B\u3051\u3069\u3001\u3067\u3082\u30DB\u30F3\u30C8\u306A\u3093\u3060\u3088\u3002#$e#\u76EE\u3092\u898B\u308C\u3070\u308F\u304B\u308B\u3088\u2026\u304D\u307F\u3082\u3001\u76EE\u306B\u898B\u3048\u306A\u3044\u4E16\u754C\u3092\u4FE1\u3058\u3066\u308B\u3093\u3067\u3057\u3087\u3002\u308F\u305F\u3057\u307F\u305F\u3044\u306B\u306D\u3002",
    "Mon6": "\u30D8\u30A4\u30EA\u30FC\u304C \u4ED5\u4E8B\u306B\u3064\u304F\u304B\u3001 \u6599\u7406\u304B\u6383\u9664\u306E \u304A\u624B\u4F1D\u3044\u3092 \u3057\u3066\u304F\u308C\u308C\u3070\u306A\u3041\u3002$s#$e#\u305F\u3076\u3093\u3001 \u7389\u306E\u8F3F\u306B \u306E\u308D\u3046\u3068 \u3057\u3066\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u306A\u3002$u",
    "Mon6_inlaw_Haley": "\u30D8\u30A4\u30EA\u30FC\u304C \u3044\u306A\u304F\u306A\u3063\u3066\u304B\u3089\u3001 \u3044\u308D\u3093\u306A\u7269\u4E8B\u304C \u305A\u3063\u3068\u7C21\u5358\u306B \u6E08\u3080\u3088\u3046\u306B \u306A\u3063\u305F\u306E\u3088\u3002",
    "Mon8": "\u3044\u3044\u4EBA\u306A\u306E\u306B\u5E78\u305B\u3092\u3064\u304B\u3081\u306A\u3044\u3001\u3053\u306E\u753A\u306B\u306F\u305D\u3093\u306A\u4EBA\u3082\u3044\u308B\u306E\u3002\u306A\u3093\u3060\u304B\u304B\u306A\u3057\u3044\u3088\u306D\u3002$u#$e#\u307B\u3089\u3001\u9152\u5834\u3067\u306F\u305F\u3089\u3044\u3066\u308B\u3068\u3001\u307F\u3093\u306A\u306E\u60A9\u307F\u4E8B\u304C\u8033\u306B\u5165\u3063\u3066\u304F\u308B\u304B\u3089\u3002$u",
    "Resort": "\u592A\u967D\u306B\u5FC3\u3092\u958B\u304F\u3068\u3001\u81EA\u5206\u306E\u4E2D\u306E\u611B\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u611F\u3058\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u306E\u3088\u3002$h",
    "Resort_Bar": "\u4E00\u5EA6\u3067\u3044\u3044\u304B\u3089\u30D0\u30FC\u306E\u3053\u3063\u3061\u5074\u306B\u6765\u305F\u304B\u3063\u305F\u306E\uFF01$h",
    "Resort_Chair": "\u697D\u3057\u3093\u3067\u308B\u3001@\uFF1F\u305F\u307E\u306B\u306F\u4F11\u61A9\u3082\u5FD8\u308C\u305A\u306B\u306D\uFF01",
    "Resort_Dance": "%\u30A8\u30DF\u30EA\u30FC\u306F\u97F3\u697D\u306B\u5922\u4E2D\u306B\u306A\u3063\u3066\u3044\u308B\u3002",
    "Resort_Entering": "\u3042\u3042\u3001\u3053\u306E\u5834\u6240\u3092\u6C17\u306B\u5165\u3063\u305F\u308F\uFF01\u30AA\u30A6\u30E0\u304C\u3044\u3063\u3071\u3044\uFF01",
    "Resort_Leaving": "\u3042\u3042\u2026\u6F84\u3093\u3060\u7A7A\u6C17\u306F\u6700\u9AD8\u3060\u3063\u305F\u308F\u3002",
    "Resort_Shore": "\u611F\u3058\u308B\uFF1F\u6D77\u306B\u306F\u7652\u3057\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u304C\u3042\u308B\u306E\u3002",
    "Sat": "\u81EA\u5206\u306E\u670D\u3092 \u4F5C\u308B\u306E\u306F \u597D\u304D\u3060\u3051\u3069\u3001 \u751F\u5730\u3092 \u624B\u306B\u5165\u308C\u308B\u306E\u304C \u96E3\u3057\u3044\u306E\u3088\u306D\u3002#$e#\u753A\u307E\u3067 \u9060\u51FA\u3057\u306A\u304D\u3083 \u3044\u3051\u306A\u3044\u3057\u3002",
    "Sat6": "\u5E03\u306E\u624B\u3056\u308F\u308A\u306B\u3064\u3044\u3066\u8003\u3048\u305F\u3053\u3068\u3042\u308B\u3001@\uFF1F\u3072\u3068\u3064\u3072\u3068\u3064\u306E\u624B\u3056\u308F\u308A\u3054\u3068\u306B\u3001\u305C\u3093\u305C\u3093\u3061\u304C\u3063\u305F\u500B\u6027\u304C\u3042\u308B\u306E\u2026\u308F\u305F\u3057\u306E\u30C9\u30EC\u30B9\u3001\u3055\u308F\u3063\u3066\u307F\u3066\u2026\u307B\u3089\u306D\uFF1F",
    "Sun": "\u3053\u3093\u306B\u3061\u306F\u3001@\u3055\u3093\uFF01#$e#\u304D\u307F\u306F \u7F8A\u3092 \u80B2\u3066\u3066\u308B\u304B\u3057\u3089\uFF1F\u7F8A\u6BDB\u3092 \u7F8E\u3057\u3044 \u751F\u5730\u306B \u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u308F\u3088\uFF01#$e#\u6A5F\u7E54\u308A\u6A5F\u304C \u5FC5\u8981\u3060\u3051\u3069\u306D\u3002\u4F5C\u308A\u65B9\u3055\u3048 \u77E5\u3063\u3066\u3044\u308C\u3070\u3001 \u305D\u308C\u3082 \u4F5C\u308B\u3053\u3068\u304C \u3067\u304D\u308B\u306F\u305A\u3002",
