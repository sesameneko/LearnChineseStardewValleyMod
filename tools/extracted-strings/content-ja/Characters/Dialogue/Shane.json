    "Thu6": "\u3042\u3042\u2026Joja\u30B3\u30FC\u30E9\u306F \u3069\u3053\u3060\uFF1F||\u306A\u305C\u52AA\u529B\u306A\u3093\u3066\u3059\u308B\u3093\u3060\uFF1F \u4EBA\u751F\u306A\u3093\u3066\u30B5\u30A4\u30B3\u30ED\u3092\u632F\u308B\u306E\u3068\u540C\u3058\u3060\u3002#$e#\u30AA\u30EC\u306E\u30B5\u30A4\u30B3\u30ED\u306F\u30C6\u30FC\u30D6\u30EB\u304B\u3089\u8EE2\u3052\u843D\u3061\u3066\u3044\u3063\u305F\u306E\u3055\u3002",
    "Thu8": "\u306A\u3093\u3060\u3088\u3001\u304A\u308C\u3068\u8A71\u3057\u305F\u3044\u306E\u304B\uFF1F\u3069\u3046\u3082\u30DE\u30B8\u307F\u305F\u3044\u3060\u306A\u2026\u304A\u307E\u3048\u3001\u304A\u308C\u3068\u540C\u3058\u304F\u3089\u3044\u30D8\u30F3\u306A\u3084\u3064\u3060\u306A\u3002$h",
    "Tue": "\u3048\u3063\uFF1F\u4F55\u306E\u7528\u3060\uFF1F\u3042\u3063\u3061\u3078 \u884C\u3063\u3066\u304F\u308C\u3002",
    "Tue10": "\u30B8\u30E3\u30B9\u306E\u305F\u3081\u306B\u3082\u3001\u3057\u3063\u304B\u308A\u3057\u306A\u304F\u3061\u3083\u306A\u3089\u306A\u3044\u3002\u3042\u306E\u5B50\u306B\u3068\u3063\u3066\u60AA\u3044\u898B\u672C\u306B\u306F\u306A\u308A\u305F\u304F\u306A\u3044\u3093\u3060\u3002||\u30AA\u30EC\u306F\u30B8\u30E3\u30B9\u306B\u3068\u3063\u3066\u306F\u7236\u89AA\u307F\u305F\u3044\u306A\u3082\u3093\u3060\u3002\u3042\u306E\u5B50\u3092\u304C\u3063\u304B\u308A\u3055\u305B\u3059\u304E\u3066\u306A\u3044\u304B\u3001\u5FC3\u914D\u3057\u3066\u308B\u3088\u3002$s",
    "Tue2": "\u30AA\u30EC\u304B\u3089 \u4F55\u304C \u6B32\u3057\u3044\u3093\u3060\uFF1F\u91D1\u304B\uFF1F\u307B\u3063\u3068\u3044\u3066\u304F\u308C\u308B\u306A\u3089 \u51FA\u3057\u3066\u3084\u308B\u3055\uFF01",
