    "Fri10": "\u9152\u3092\u3072\u304B\u3048\u3066\u304B\u3089\u4F53\u306E\u75DB\u307F\u304C\u3084\u308F\u3089\u3044\u3060\u3088\u3002#$e#\u3067\u3082\u3001\u5D16\u3063\u3077\u3061\u306B\u7ACB\u305F\u3055\u308C\u3066\u3044\u308B\u3088\u3046\u306A\u6C17\u5206\u306F\u307E\u3060\u6D88\u3048\u306A\u3044\u3093\u3060\u2026$s",
    "Fri4": "$d Joja#\u4ED5\u4E8B\u3059\u308B\u3060\u3051\u306E \u4EBA\u751F\u3063\u3066 \u610F\u5473\u306F \u3042\u308B\u306E\u304B\uFF1F|\u5BB6\u8CC3\u3092 \u652F\u6255\u3046\u3053\u3068\u306F \u3067\u304D\u3066\u306A\u3044\u304C\u3001 \u30DE\u30FC\u30CB\u30FC\u306F \u30AA\u30EC\u3092 \u8FFD\u3044\u51FA\u305D\u3046\u3068\u3082 \u3057\u306A\u3044\u3002\u30AA\u30EC\u306F \u30C4\u30A4\u3066\u308B\u306A\u3002",
    "Fri6": "\u4ECA\u591C\u306F \u7D76\u5BFE \u9152\u5834\u306B \u3044\u304F\u305E\u3002\u4ED6\u306B \u3084\u308B\u3053\u3068\u306F \u306A\u3044\u304B\u3089\u306A\u3002",
    "Fri8": "\u3042\u3042\u2026\u30AA\u30EC\u306E\u809D\u81D3\u306F\u30DC\u30ED\u30DC\u30ED\u3060\u308D\u3046\u306A\u3002$s#$e#\u4F53\u5185\u5E74\u9F62\u304C20\u6B73\u3050\u3089\u3044\u8001\u3051\u3066\u305D\u3046\u306A\u6C17\u304C\u3059\u308B\u3088\u2026$s",
    "GreenRain": "\u4ECA\u65E5\u306F\u4ED5\u4E8B\u306B\u3044\u304B\u306A\u304F\u3066\u3044\u3044\u3057\u3001\u6587\u53E5\u306F\u306A\u3044\u3088\u2026",
    "GreenRain_2": "\u3042\u3042\u3001\u4ECA\u65E5\u306F\u306A\u3093\u304B\u5909\u306A\u5929\u6C17\u306A\u306E\u304B\uFF1F\u6C17\u304C\u3064\u304B\u306A\u304B\u3063\u305F\u3088\u3002",
    "JojaMart": "%\u30B7\u30A7\u30FC\u30F3\u306F \u5FD9\u3057\u305D\u3046\u3060\u3002\u8A71\u3092\u3059\u308B \u4F59\u88D5\u304C \u306A\u3044\u3088\u3046\u306B \u307F\u3048\u308B\u3002",
