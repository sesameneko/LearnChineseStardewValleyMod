    "Resort_Leaving": "\u307E\u3042\u20261\u5E74\u5206\u306E\u30D3\u30BF\u30DF\u30F3D\u3092\u6442\u3063\u305F\u306A\u3002\u3057\u3070\u3089\u304F\u306F\u30D6\u30E9\u30A4\u30F3\u30C9\u3092\u9589\u3081\u3066\u30D3\u30C7\u30AA\u30B2\u30FC\u30E0\u304C\u3067\u304D\u305D\u3046\u3060\u3002",
    "Resort_Shore": "\u305D\u3046\u2026\u30AA\u30EC\u306F\u9774\u4E0B\u3082\u9774\u3082\u5C65\u3044\u3066\u306A\u3044\u3002#$b#\u516C\u8846\u885B\u751F\u4E0A\u306F\u3088\u304F\u306A\u3044\u3089\u3057\u3044\u306A\u3002#$b#\u3067\u3082\u30AB\u30CB\u305F\u3061\u306F\u697D\u3057\u305D\u3046\u3060\u305C\u3002$h",
    "Sat": "\u3069\u3046\u3057\u3066 \u8A71\u3057\u304B\u3051\u3066\u304F\u308B\u3093\u3060\uFF1F\u4E00\u4EBA\u306B \u3057\u3066\u304F\u308C\u3002",
    "Sat10": "\u304A\u307E\u3048\u306E\u7267\u5834\u306F\u30CB\u30EF\u30C8\u30EA\u3092\u98FC\u3046\u306B\u306F\u3061\u3087\u3046\u3069\u3044\u3044\u5834\u6240\u3060\u3068\u601D\u3046\u305C\u3002$h",
    "Sat2": "#$1 ShaneJOSH#\u307E\u3060 \u30AA\u30EC\u3068 \u53CB\u9054\u306B \u306A\u308A\u305F\u304C\u308B\u306A\u3093\u3066 \u305F\u3044\u3057\u305F\u3082\u3093\u3060\u3002\u5931\u793C\u3055\u304C\u8DB3\u308A\u3066\u306A\u304B\u3063\u305F\u306E\u304B\uFF1F#$e#\u306F\u3041\u2026$s",
    "Sat4": "$d Joja#\u30DE\u30FC\u30CB\u30FC\u304B\u3089 \u90E8\u5C4B\u3092 \u5B89\u304F \u501F\u308A\u4E0A\u3052\u3066\u308B\u3093\u3060\u3002\u5C0F\u3055\u3044\u304C\u3001 \u6587\u53E5\u306F \u8A00\u3048\u3093\u3002|\u3082\u3057 \u4EBA\u751F\u3092 \u3084\u308A\u76F4\u305B\u305F\u3089\u3001 \u30CB\u30EF\u30C8\u30EA \u7267\u5834\u3092 \u306F\u3058\u3081\u305F\u3044\u3002\u3082\u3061\u308D\u3093\u3001 \u653E\u3057\u98FC\u3044\u3067\u306A\u3002",
    "Sat8": "\u30DE\u30FC\u30CB\u30FC\u306E \u30CB\u30EF\u30C8\u30EA\u306B \u611B\u7740\u304C \u308F\u3044\u3066\u304D\u305F\u306A\u3002$h||\u30CB\u30EF\u30C8\u30EA\u306F\u4EBA\u3092\u88CF\u5207\u3063\u305F\u308A\u3057\u306A\u3044\u304C\u3001\u4EBA\u9593\u306F\u305D\u3046\u3058\u3083\u306A\u3044\u2026",
    "Sun": "\u5FD9\u3057\u3044\u306E\u304C \u308F\u304B\u3089\u306A\u3044\u304B\uFF1F||\u2026\u8AB0\u3068\u3082\u8A71\u3057\u305F\u304F\u306A\u3044\u6C17\u5206\u306A\u3093\u3060\u3002",
