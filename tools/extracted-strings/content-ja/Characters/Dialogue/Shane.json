    "Sun2": "\u307E\u305F\u304A\u524D\u304B\uFF1F\u4F55\u5EA6\u3001 \u4E00\u4EBA\u306B \u3057\u3066\u304F\u308C\u3068 \u8A00\u308F\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u3093\u3060\uFF1F$s",
    "Sun4": "\u3075\u3080\u2026 \u3082\u3046 %time \u304B\u3002\u30EC\u30F3\u30B8\u3067 \u51B7\u51CD\u30D4\u30B6\u3092 \u6696\u3081\u308B\u304B\u3001 \u3082\u3046\u5C11\u3057 \u5F8C\u306B \u3059\u308B\u304B\u3002$u||\u30C8\u30F3\u30CD\u30E9\u30FC\u30BA\u304C\u52DD\u3063\u305F\u3089\u3001\u51B7\u3048\u305F\u30D3\u30FC\u30EB\u3067\u795D\u676F\u3092\u3042\u3052\u308B\u3093\u3060\u3002#$e#\u3082\u3057\u8CA0\u3051\u305F\u3089\uFF1F \u51B7\u3048\u305F\u30D3\u30FC\u30EB\u304C\u30E4\u30B1\u9152\u306B\u306A\u308B\u3060\u3051\u3055\u3002",
    "Sun6": "\u2026\u30AA\u30EC\u3001 \u592A\u3063\u3066\u304D\u305F\u3093\u3058\u3083 \u306A\u3044\u304B\u306A\u3002$s",
    "Sun8": "\u3082\u3063\u3068 \u30C6\u30EC\u30D3\u3092 \u898B\u308C\u3070\u3001 \u4EBA\u751F\u3092 \u5FD8\u308C\u3066\u3044\u3089\u308C\u305D\u3046\u3060\u3002\u6C17\u304C \u697D\u306B \u306A\u308B\u304B\u3082\u306A\u3002$u",
    "Thu": "\u4F55\u306E\u7528\u3060\uFF1F\u307B\u3063\u3068\u3044\u3066\u304F\u308C\u3002",
