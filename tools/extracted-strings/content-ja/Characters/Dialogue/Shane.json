    "Mon10": "\u5BB3\u866B\u3092 \u898B\u308B\u304B\u306E\u3088\u3046\u306A\u76EE\u3067\u3001\u4E16\u754C\u4E2D\u306E \u4EBA\u306B \u898B\u3089\u308C\u3066\u3044\u308B\u3088\u3046\u306A \u6C17\u6301\u3061\u306B \u306A\u3063\u305F\u3053\u3068\u306F \u3042\u308B\u304B\uFF1F",
    "Mon2": "\u3042\u3093\u305F\u306E \u3053\u3068\u306F \u3088\u304F \u77E5\u3089\u306A\u3044\u3002\u3069\u3046\u3057\u3066 \u8A71\u3057\u304B\u3051\u3066\u304F\u308B\u3093\u3060\uFF1F||\u306A\u3093\u3067\u30AA\u30EC\u306B\u8A71\u3057\u304B\u3051\u3066\u304F\u308B\u3093\u3060\uFF1F \u53CB\u3060\u3061\u306A\u3093\u3066\u3044\u3089\u306A\u3044\u3093\u3060\u3088\u3002",
    "Mon4": "\u306A\u3042\u3001\u521D\u3081\u3066 \u3042\u3063\u305F\u6642\u306F \u51B7\u305F\u304F \u3042\u3057\u3089\u3063\u3066 \u60AA\u304B\u3063\u305F\u3088\u3002#$e#\u3088\u305D\u8005\u306B \u3059\u3050 \u6253\u3061\u89E3\u3051\u3089\u308C\u306A\u3044 \u30BF\u30A4\u30D7\u306A\u3093\u3060\u3002||\u8AB0\u304B\u3068\u53CB\u9054\u306B\u306A\u308D\u3046\u3068\u3059\u308B\u306E\u3053\u3068\u306F\u3001\u3048\u3089\u304F\u5927\u5909\u3060\u3002\u4E00\u4EBA\u306E\u65B9\u304C\u697D\u306A\u3093\u3060\u3088\u3002",
    "Mon6": "\u6B63\u76F4\u306A\u3068\u3053\u308D\u3001\u304A\u307E\u3048\u304C\u306A\u3093\u3067\u30AA\u30EC\u306A\u3093\u304B\u3068\u4EF2\u826F\u304F\u306A\u308A\u305F\u3044\u306E\u304B\u3001\u3044\u307E\u3060\u306B\u5206\u304B\u3089\u306A\u3044\u3093\u3060\u3002||\u4EBA\u751F\u306F\u4E0D\u516C\u5E73\u3060\u3002\u30AA\u30EC\u306F\u305D\u308C\u304C\u30E0\u30AB\u3064\u3044\u3066\u4ED5\u65B9\u306A\u3044\u3093\u3060\u3002",
    "Resort": "\u3088\u30FC\u3057\u3001\u3053\u306E\u7802\u306F\u6691\u3044\u305E\u3002\u9774\u3092\u5C65\u3044\u3068\u3051\u3070\u3088\u304B\u3063\u305F\u3002$s",
    "Resort_Bar": "\u3075\u3046\u2026\u51B7\u3048\u305F\u98F2\u307F\u7269\u306F\u3044\u3044\u3082\u3093\u3060\u305C\u2026#$e#\u3082\u3046\u5C11\u3057\u3044\u3063\u3068\u304F\u304B\u306A\u2026",
    "Resort_Chair": "\u3075\u30FC\u2026\u8DB3\u3092\u4F11\u3081\u308B\u306E\u306F\u6C17\u6301\u3061\u304C\u3044\u3044\u3002#$b#\u3082\u3057\u8AB0\u306B\u547C\u3070\u308C\u305F\u3063\u3066\u3001\u30AA\u30EC\u306F\u3053\u3053\u306B\u5EA7\u3063\u3066\u30C0\u30E9\u3063\u3068\u3057\u3066\u308B\u3088\u3002",
