    "AcceptGift_(O)348": "\u50D5\u306B\uFF1F\u6700\u9AD8\u306E\u30D7\u30EC\u30BC\u30F3\u30C8\u3067\u3059\u3088\uFF01\u3068\u3066\u3082\u9B45\u529B\u7684\u3067\u3059\uFF01$h#$b#\u751F\u7269\u5B66\u7684\u306B\u306F\u30A2\u30EB\u30B3\u30FC\u30EB\u306E\u6442\u53D6\u306F\u3059\u3059\u3081\u3089\u308C\u307E\u305B\u3093\u304C\u2026#$b#\u30EA\u30E9\u30C3\u30AF\u30B9\u3057\u3066\u697D\u3057\u3080\u4E0A\u8CEA\u306A\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306E\u30EF\u30A4\u30F3\u306E\u52B9\u80FD\u306F\u5426\u5B9A\u3067\u304D\u307E\u305B\u3093\uFF01$h",
    "AcceptGift_(O)432": "\u3053\u308C\u3092\u50D5\u306B\uFF1F\u3042\u308A\u304C\u3068\u3046\uFF01\u30D1\u30B9\u30BF\u306B\u5408\u308F\u305B\u305F\u3089\u6700\u9AD8\u3067\u3057\u3087\u3046\u306D\u3002$h",
    "AcceptGift_(O)StardropTea": "\u3053\u308C\u3092\u50D5\u306B\uFF1F\u5149\u6804\u3067\u3059\u3002\u3042\u308A\u304C\u3068\u3046\uFF01",
    "FlowerDance_Accept": "\u3048\u3063\uFF01\u50D5\u3068\u2026 \u30C0\u30F3\u30B9\u3092\u8E0A\u308A\u305F\u3044\uFF1F$4#$b#\u2026\u308F\u304B\u308A\u307E\u3057\u305F\u3002\u3044\u3063\u3057\u3087\u306B\u8E0A\u308A\u307E\u3057\u3087\u3046\uFF01$h",
    "FlowerDance_Accept_Spouse": "\u663C\u304B\u3089 \u305A\u3063\u3068 \u671F\u5F85\u3057\u3066\u3044\u305F\u3093\u3067\u3059\u3088\uFF01 \u6625\u306E \u65B0\u9BAE\u306A\u7A7A\u6C17\u306E\u304A\u304B\u3052\u3067\u3001 \u3042\u306A\u305F\u304C \u8F1D\u3044\u3066\u898B\u3048\u307E\u3059\u3088\u3002$l",
    "FlowerDance_Decline": "\u3042\u3063\uFF01\u3054\u3081\u3093\u306A\u3055\u3044\u2026\u79C1\u306F\u2026 \u4ED6\u306E\u8AB0\u304B\u3092 \u8A98\u304A\u3046\u3068 \u8003\u3048\u3066\u3044\u307E\u3057\u305F\u306E\u3067\u3002$s",
    "Fri": "\u4ECA\u65E5\u306F \u3059\u3066\u304D\u306A \u65E5\u3067\u3059\u306D\u3002#$e#\u4ED5\u4E8B\u304C \u5C11\u306A\u3051\u308C\u3070 \u826F\u3044\u306E\u3067\u3059\u304C\u2026$s",
    "Fri10": "\u5FC5\u8981\u3067\u3042\u308C\u3070\u3001 \u533F\u540D\u3067\u306E \u5065\u5EB7\u8A3A\u65AD\u3082 \u3084\u3063\u3066\u3044\u307E\u3059\u3088\u3002$l",
    "Fri4": "\u79C1\u306E\u90E8\u5C4B\u306B \u6765\u305F\u3051\u308C\u3070\u3001 \u3044\u3064\u3067\u3082 \u304B\u307E\u3044\u307E\u305B\u3093\u3088\u3002\u8A3A\u7642\u6240\u306E \u4E0A\u306B \u4F4F\u3093\u3067\u307E\u3059\u304B\u3089\u3002",
    "GreenRain": "\u5FF5\u306E\u305F\u3081\u306B\u533B\u7642\u54C1\u3092\u6301\u3063\u3066\u304D\u305F\u3093\u3067\u3059\u3002\u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u306D\uFF01",
    "GreenRain_2": "\u306F\u3058\u3081\u306F\u3053\u306E\u96E8\u304C\u5371\u967A\u3067\u306F\u306A\u3044\u304B\u3068\u5FC3\u914D\u3057\u3066\u3044\u307E\u3057\u305F\u3002#$b#\u3067\u3059\u304C\u3001\u3080\u3057\u308D\u5065\u5EB7\u306B\u3088\u3044\u5F71\u97FF\u304C\u3042\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\u304F\u308F\u3057\u304F\u306F\u308F\u304B\u308A\u307E\u305B\u3093\u304C\u2026\u5C11\u306A\u304F\u3068\u3082\u690D\u7269\u305F\u3061\u306F\u3088\u3044\u53CD\u5FDC\u3092\u898B\u305B\u3066\u3044\u307E\u3059\u3002",
    "Introduction": "\u3053\u308C\u304B\u3089\u3082 \u3088\u308D\u3057\u304F\u983C\u3080\u3088\u3002\u3053\u306E\u753A\u3067 \u533B\u5E2B\u3092 \u3084\u3063\u3066\u3044\u308B \u30CF\u30FC\u30F4\u30A3\u30FC\u3067\u3059\u3002#$e#\u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3\u306E \u4F4F\u4EBA \u5168\u54E1\u306B \u5B9A\u671F\u5065\u8A3A\u3068 \u533B\u7642\u63AA\u7F6E\u3092 \u884C\u3063\u3066\u3044\u307E\u3059\u3002 \u3084\u308A\u304C\u3044\u306E\u3042\u308B \u4ED5\u4E8B\u3067\u3059\u3088\u3002#$e#\u3042\u306A\u305F\u3082\u3001 \u540C\u3058\u3050\u3089\u3044 \u3084\u308A\u304C\u3044\u306E\u3042\u308B \u4ED5\u4E8B\u3092 \u898B\u3064\u3051\u3089\u308C\u308B\u3068 \u3044\u3044\u3067\u3059\u306D\u3002$h",
    "Mon": "\u8A3A\u7642\u6240\u3067\u306F \u85AC\u306E \u8CA9\u58F2\u3082 \u884C\u3063\u3066\u3044\u307E\u3059\u304B\u3089\u2026 \u304A\u75B2\u308C\u3067\u3057\u305F\u3089 \u305C\u3072 \u7ACB\u3061\u5BC4\u3063\u3066\u304F\u3060\u3055\u3044\u3002#$b#\u7267\u5834\u3067\u306E \u4ED5\u4E8B\u306F \u3068\u3066\u3082 \u75B2\u308C\u308B \u3067\u3057\u3087\u3046\u304C\u2026 \u904E\u52B4\u306B\u306F \u6C17\u3092\u3064\u3051\u3066\u304F\u3060\u3055\u3044\u3088\uFF01",
    "Mon10": "\u3042\u3063\uFF01\u3053\u3093\u306B\u3061\u306F\u3001@\u3002$l#$e#\u4F55\u304B\u2026 \u533B\u5B66\u306B\u95A2\u3059\u308B \u8CEA\u554F\u3067\u3082 \u3042\u308A\u307E\u3059\u304B\uFF1F$l",
    "Mon2": "\u79C1\u306B\u306F\u3001 \u4F4F\u4EBA \u307F\u3093\u306A\u306E \u5065\u5EB7\u3092 \u5B88\u308B \u7FA9\u52D9\u304C \u3042\u308B\u3068 \u81EA\u8CA0\u3057\u3066\u3044\u307E\u3059\u304C\u2026 \u7D50\u69CB \u5FC3\u52B4\u306E \u305F\u307E\u308B\u3082\u306E\u3067\u3059\u3002#$e#\u3053\u306E\u753A\u306E \u30B3\u30DF\u30E5\u30CB\u30C6\u30A3\u306F \u5C0F\u3055\u3044\u3082\u306E\u3067\u3059\u304C\u3001 \u304A\u304B\u3052\u3067 \u60A3\u8005\u306E\u65B9\u3005\u3068 \u826F\u3044\u95A2\u4FC2\u3092 \u7BC9\u3051\u308B\u306E\u3067\u3059\u3088\u3002",
    "Mon6": "\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306B \u3057\u3070\u3089\u304F \u7559\u307E\u308A\u305F\u3044 \u3067\u3059\u306D\u3002\u3088\u3046\u3084\u304F\u3001 \u30B3\u30DF\u30E5\u30CB\u30C6\u30A3\u306E \u4E00\u54E1\u306B \u306A\u308C\u305F \u6C17\u304C\u3057\u307E\u3059\u304B\u3089\u3002#$e#\u307F\u3093\u306A\u306E \u5F79\u306B\u7ACB\u3063\u3066\u308B\u3068 \u5206\u304B\u308B\u3068 \u3046\u308C\u3057\u3044\u3082\u306E\u3067\u3059\u3088\u3002",
    "Resort": "\u3061\u3087\u3063\u3068\u3057\u305F\u79D8\u5BC6\u3092\u6559\u3048\u3066\u3042\u3052\u307E\u3057\u3087\u3046\u2026\u79C1\u306F\u6D6E\u304D\u888B\u304C\u306A\u3044\u3068\u6CF3\u3052\u306A\u3044\u3093\u3067\u3059\u3088\u3002$s",
    "Resort_Bar": "\u3053\u306E\u6691\u3055\u3067\u306F\u3001\u6C34\u5206\u88DC\u7D66\u304C\u91CD\u8981\u306A\u3093\u3067\u3059\u3088\u3002\u30AC\u30B9\u306B\u30B3\u30B3\u30CA\u30C3\u30C4\u30A6\u30A9\u30FC\u30BF\u30FC\u304C\u306A\u3044\u304B\u805E\u3044\u3066\u304D\u307E\u3059\uFF01$h",
    "Resort_Chair": "\u305F\u307E\u306B\u306F\u606F\u629C\u304D\u3092\u3059\u308B\u306E\u3082\u3044\u3044\u3067\u3059\u306D\u3002#$b#\u3042\u306A\u305F\u304C\u672C\u5F53\u306B\u60A9\u307F\u304B\u3089\u89E3\u653E\u3055\u308C\u3066\u3044\u308B\u306E\u304B\u3001\u5FC3\u914D\u3067\u3059\u3088\u2026$s",
    "Resort_Entering": "\u65E5\u713C\u3051\u6B62\u3081\u306F\uFF1F\u3088\u3057\u2026#$b#\u65E5\u3088\u3051\u5E3D\u306F\uFF1F\u3088\u3057\u2026",
    "Resort_Leaving": "\u65E5\u713C\u3051\u3057\u904E\u304E\u305F\u6642\u306B\u306F\u3001\u30A2\u30ED\u30A8\u30D9\u30E9\u306E\u30AF\u30EA\u30FC\u30E0\u3092\u5C11\u3057\u5857\u308B\u3068\u808C\u304C\u697D\u306B\u306A\u308A\u307E\u3059\u3088\u3002",
    "Resort_Shore": "\u3053\u306E\u30D3\u30FC\u30C1\u306E\u9685\u3005\u307E\u3067\u30AC\u30E9\u30B9\u3092\u63A2\u3057\u307E\u308F\u3063\u3066\u305F\u3093\u3067\u3059\u3002\u8AB0\u304B\u304C\u8DB3\u306B\u30B1\u30AC\u3067\u3082\u3057\u305F\u3089\u5927\u5909\u3067\u3059\u304B\u3089\u306D\uFF01",
    "Sat": "\u4F55\u304B \u3054\u7528\u3067\u3057\u3087\u3046\u304B\uFF1F#$e#\u304A\u5927\u4E8B\u306B\u3002",
    "Sat10": "\u30CF\u30A2\u2026\u306A\u3093\u3060\u304B\u5E74\u3092\u611F\u3058\u308B\u3088\u3046\u306B\u306A\u3063\u3066\u304D\u307E\u3057\u305F\u2026#$e#\u5E74\u3092\u3068\u308C\u3070\u3068\u308B\u307B\u3069\u3001\u601D\u3044\u51FA\u304C\u91CD\u304F\u306E\u3057\u304B\u304B\u3063\u3066\u304F\u308B\u3093\u3067\u3059\u3002\u62BC\u3057\u3064\u3076\u3055\u308C\u305D\u3046\u306B\u306A\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002$s#$e#\u3067\u3082\u3001\u3042\u306A\u305F\u3068\u3044\u308C\u3070\u3001\u79C1\u306F\u3082\u3063\u3068\u82E5\u304F\u3044\u3089\u308C\u308B\u3068\u601D\u3046\u3093\u3067\u3059\u3002$l",
    "Sat4": "\u79C1\u306F \u5C0F\u3055\u306A\u753A\u306E\u7A7A\u6C17\u304C\u597D\u304D\u3067\u3001 \u60A3\u8005\u306B\u5BFE\u3059\u308B \u5305\u62EC\u7684\u306A \u30B1\u30A2\u304C \u3067\u304D\u308B\u3068 \u601D\u3063\u305F\u306E\u3067 \u3053\u306E\u753A\u306B \u6765\u307E\u3057\u305F\u3002#$e#\u4ECA\u3067\u306F\u3001 \u3053\u306E\u753A\u304C \u5927\u597D\u304D\u306B\u306A\u308A\u307E\u3057\u305F\u306D\u3002$h",
    "Sun": "\u3046\u30FC\u3093\u2026\u751F\u6D3B\u304C \u7D50\u69CB \u53B3\u3057\u304F\u306A\u3063\u3066\u304D\u307E\u3057\u305F\u3002\u60A3\u8005\u3055\u3093\u304C \u3042\u307E\u308A\u3044\u307E\u305B\u3093\u304B\u3089\u306D\u3002#$e#\u96A3\u753A\u304B\u3089\u3001 \u60A3\u8005\u3092 \u53D7\u3051\u5165\u308C\u3088\u3046\u304B \u3069\u3046\u304B\u2026",
    "Sun6": "\u60A3\u8005\u306E\u547D\u3092 \u5B8C\u5168\u306B \u59D4\u306D\u3089\u308C\u305F\u3082\u306E\u306E\u3001 \u52A9\u3051\u3089\u308C\u305A\u306B \u6B7B\u306A\u305B\u3066\u3057\u307E\u3063\u305F\u77AC\u9593\u3092 \u60F3\u50CF\u3057\u3066\u307F\u3066\u304F\u3060\u3055\u3044\u2026 \u6C38\u9060\u306B \u5FD8\u308C\u3089\u308C\u306A\u3044 \u3082\u306E\u3067\u3059\u3088\u3002$s",
    "Thu": "\u6804\u990A\u3092\u53D6\u308B\u3053\u3068\u306F \u5927\u5207\u3067\u3059\u304B\u3089\u3001 \u3061\u3083\u3093\u3068 \u98DF\u4E8B\u3092 \u53D6\u308A\u307E\u3057\u3087\u3046\u3002\u91CE\u83DC\u306E\u6442\u53D6\u91CF\u3092 \u5897\u3084\u3059\u3088\u3046\u306B \u3057\u307E\u3057\u3087\u3046\u306D\uFF01#$e#\u624B\u4F5C\u308A\u306E \u6599\u7406\u3082 \u4E00\u756A\u3067\u3059\u304C\u3001\u81EA\u708A\u306F \u3055\u308C\u308B\u306E\u3067\u3059\u304B\uFF1F",
    "Thu8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u533B\u8005\u3068\u3057\u3066\u3001\u5BB6\u5EAD\u6599\u7406\u306E\u30E1\u30EA\u30C3\u30C8\u306F\u3088\u304F\u308F\u304B\u3063\u3066\u3044\u307E\u3059\u3002\u3057\u304B\u3057\u3001\u3068\u3066\u3082\u5FD9\u3057\u304F\u3066\u3001\u306A\u304B\u306A\u304B\u6599\u7406\u3059\u308B\u6C17\u306B\u306A\u308C\u307E\u305B\u3093\u3002$s|\u533B\u8005\u306E \u4ED5\u4E8B\u306F \u5927\u5909 \u5FD9\u3057\u3044\u3082\u306E\u3067\u3059\u3002\u5341\u5206 \u98DF\u4E8B\u3082\u53D6\u308C\u306A\u3044\u304F\u3089\u3044\u3067\u3059\u3088\u3002$s#$e#\u4E00\u4EBA\u66AE\u3089\u3057\u3067 \u306A\u3051\u308C\u3070\u3001 \u30DE\u30B7\u306B \u306A\u308B\u304B\u3082\u3002$l",
