    "AcceptBirthdayGift_Negative": "\u3048\u3063\uFF01\u3053\u308C\u306F\u2026 \u307E\u3042\u3001\u305D\u308C\u306F\u3055\u3066\u304A\u304D\u2026\u50D5\u306E\u8A95\u751F\u65E5\u306A\u3093\u3066\u8AB0\u3082\u77E5\u3089\u306A\u3044\u3060\u308D\u3046\u3068\u601D\u3063\u3066\u3044\u307E\u3057\u305F\u3002",
