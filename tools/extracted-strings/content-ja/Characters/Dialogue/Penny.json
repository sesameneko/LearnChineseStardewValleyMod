    "AcceptBirthdayGift_Loved": "\u3048\u3063\uFF01\u3053\u308C\u3092\u79C1\u306B\uFF1F\u8A95\u751F\u65E5\u306E\u2026 \u30D7\u30EC\u30BC\u30F3\u30C8\uFF1F$3#$b#\uFF08\u30B0\u30B9\u30F3\uFF09\u2026\u3054\u3081\u3093\u306A\u3055\u3044\u3002$s#$b#\u3053\u3046\u3044\u3046\u512A\u3057\u3055\u306B\u306F\u6163\u308C\u3066\u3044\u306A\u304F\u3066\u2026#$b#\u2026\u3042\u308A\u304C\u3068\u3046\u3002\u3053\u3093\u306A\u306B\u7D20\u6575\u306A\u3082\u306E\u3092\u2026\u672C\u5F53\u306B\u3042\u308A\u304C\u3068\u3046\uFF01",
    "AcceptBirthdayGift_Negative": "\u79C1\u306E\u8A95\u751F\u65E5\u306B\uFF1F\u3042\u306A\u305F\u306F\u3068\u3066\u3082\u3084\u3055\u3057\u3044\u306E\u306D\uFF01\u3053\u3093\u306A\u2026$h#$b#\u2026\u3048\u3063\uFF01\uFF1F$12#$b#\u2026\u308F\u304B\u3063\u305F\u308F\u3002\u3044\u3058\u308F\u308B\u306A\u30B8\u30E7\u30FC\u30AF\u306D\u3002$s#$b#\u79C1\u3063\u305F\u3089\u65E9\u3068\u3061\u308A\u3057\u3061\u3083\u3063\u305F\u2026$s",
    "AcceptBirthdayGift_Positive": "\u79C1\u306E\u8A95\u751F\u65E5\u306B\uFF1F\u3042\u306A\u305F\u306F\u3068\u3066\u3082\u3084\u3055\u3057\u3044\u306E\u306D\uFF01\u6700\u9AD8\u306E\u30D7\u30EC\u30BC\u30F3\u30C8\u3060\u308F\u3002$h",
    "AcceptGift_(O)StardropTea": "\u3042\u3042\u2026\u3068\u3066\u3082\u3044\u3044\u9999\u308A\u3002\u3053\u308C\u306F\u3059\u3070\u3089\u3057\u3044\u3082\u306E\u3060\u308F\u3002",
    "AcceptGift_Positive_ancient_item": "\u307E\u3042\u2026 \u6B74\u53F2\u304C\u3042\u308A\u305D\u3046\u306A\u3082\u306E\u306D\u3002\u30AE\u30E5\u30F3\u30BF\u30FC\u3055\u3093\u306B\u898B\u305B\u3066\u307F\u308B\u308F\u3002\u3042\u308A\u304C\u3068\u3046\uFF01$h",
    "AcceptGift_Positive_book_item": "\u3042\u308A\u304C\u3068\u3046\uFF01\u3061\u3087\u3046\u3069\u8AAD\u307F\u7D42\u308F\u308A\u305D\u3046\u306A\u672C\u304C\u3042\u308B\u304B\u3089\u3001\u6B21\u306F\u3053\u308C\u3092\u8AAD\u3080\u3053\u3068\u306B\u3059\u308B\u308F\uFF01$h",
    "FlowerDance_Accept": "\u3048\u3063\u2026 \u79C1\u3068\uFF1F\u3048\u3048\u3001\u3082\u3061\u308D\u3093\uFF01$h#$b#\u2026\u30EA\u30FC\u30C9\u3092\u304A\u9858\u3044\u3057\u3066\u3082\u3044\u3044\uFF1F\u79C1\u3001\u7DCA\u5F35\u3057\u3061\u3083\u3063\u3066\u2026$12",
    "FlowerDance_Accept_Spouse": "\u3044\u3044\u308F\uFF01$h#$b#(\u3055\u3055\u3084\u304D) \u3061\u3083\u3093\u3068 \u5F62\u3069\u304A\u308A\u306B \u3084\u3063\u3066\u304F\u308C\u3066 \u3042\u308A\u304C\u3068\u306D\u3002",
    "FlowerDance_Decline": "\u3042\u3042\u2026\u9060\u616E\u3059\u308B\u308F\u3002$s",
    "Fri": "\u571F\u3092 \u6398\u308B\u3068\u3001 \u9762\u767D\u3044\u3082\u306E\u304C \u898B\u3064\u304B\u308B\u6642\u304C \u3042\u308B\u308F\u3002#$e#\u524D\u306B\u3001 \u3059\u3054\u304F\u53E4\u3044 \u9676\u5668\u306E \u304B\u3051\u3089\u3092 \u898B\u3064\u3051\u305F\u306E\u3002\u30AE\u30E5\u30F3\u30BF\u30FC\u3055\u3093\u306B \u898B\u305B\u305F\u3089\u3001 1000\u5E74\u4EE5\u4E0A \u6614\u306E \u3082\u306E\u3060\u3063\u3066\u8A00\u3063\u305F\u308F\u3002",
    "Fri4": "\u3042\u3042\u3001 \u6D17\u3044\u7269\u304C \u7D42\u308F\u3089\u306A\u3044\u308F\u3002\u3046\u30FC\u3093\u2026\u3082\u3057 \u6BCD\u3055\u3093\u304C \u3044\u3064\u3082 \u9045\u304F\u307E\u3067 \u98F2\u3093\u3067 \u4E8C\u65E5\u9154\u3044\u306B \u306A\u3063\u3066\u3070\u304B\u308A\u3058\u3083 \u306A\u304B\u3063\u305F\u3089\u3001 \u5BB6\u4E8B\u306E \u304A\u624B\u4F1D\u3044\u3092 \u5C11\u3057\u3067\u3082 \u983C\u3081\u305F\u306E\u306B\u3002$s",
    "Fri8": "\u5BB6\u4E8B\u306B\u4E0D\u6E80\u3092\u8A00\u3063\u3066\u306F\u3044\u3051\u306A\u3044\u308F\u306D\u2026 \u4E16\u754C\u306B\u306F\u672C\u5F53\u306B\u82E6\u52B4\u3057\u3066\u3044\u308B\u4EBA\u305F\u3061\u3082\u3044\u308B\u306E\u306B\u3001\u79C1\u306F\u76BF\u6D17\u3044\u306B\u3055\u3048\u4E0D\u6E80\u3092\u8A00\u3063\u3066\u308B\u3093\u3060\u3082\u306E\u2026$s",
    "GreenRain": "\u3042\u306A\u305F\u306F\u5E73\u6C17\u306A\u306E\uFF1F\u306A\u306B\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u306E\u304B\u3001\u307F\u3093\u306A\u4E0D\u601D\u8B70\u304C\u3063\u3066\u3044\u308B\u308F\u2026$3",
    "GreenRain_2": "\u3053\u306E\u3081\u305A\u3089\u3057\u3044\u5929\u6C17\u306E\u304A\u304B\u3052\u3067\u3001\u5B50\u4F9B\u305F\u3061\u304C\u81EA\u7136\u306B\u8208\u5473\u3092\u6301\u3063\u3066\u304F\u308C\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u308F\uFF01$h",
    "Introduction": "\u304A\u3063\u2026\u3053\u3093\u306B\u3061\u306F\uFF01\u79C1\u306F\u30DA\u30CB\u30FC...",
    "Mon": "\u3053\u3093\u306B\u3061\u306F\u2026#$e#\u3042\u3089\u3001\u4F55\u304B\u3054\u7528\u304B\u3057\u3089\uFF1F",
    "Mon4": "\u306F\u3041\u2026 \u6BCD\u3055\u3093\u3001 \u9152\u5834\u306B \u5165\u308A\u3073\u305F\u308A\u3059\u304E\u306A\u306E\u3088\u306D\u3002$s#$q 7/8 Mon_old#\u305D\u3046\u3044\u3046 \u60AA\u3044\u3082\u306E\u306B \u306F\u307E\u308B\u306E\u306F \u3088\u304F\u306A\u3044\u3068 \u601D\u3046\u306E\u3088\u3002#$r 7 50 Mon_7#\u3046\u3093\u3002\u524D\u5411\u304D\u306B \u306A\u308D\u3046\uFF01#$r 8 10 Mon_8#\u73FE\u5B9F\u3068 \u5411\u304D\u5408\u3063\u305F\u307B\u3046\u304C \u3044\u3044\u3002",
    "Mon8": "\u65E9\u304F \u5BB6\u3092 \u51FA\u305F\u3044\u306E\u3002\u3044\u3064\u3082 \u6BCD\u3055\u3093\u304C \u5FC3\u914D\u3060\u304B\u3089 \u306A\u304B\u306A\u304B \u305D\u3046\u3067\u304D\u306A\u304F\u3066\u306D\u3002#$e#\u6BCD\u3055\u3093\u3092 \u5E78\u305B\u306B \u3057\u305F\u304F\u3066\u3082\u3001 \u305A\u3063\u3068 \u3053\u3053\u306B \u3044\u3089\u308C\u306A\u3044\u306E\u306F\u2026\u308F\u304B\u308B\u3067\u3057\u3087\uFF1F$s",
    "Mon_7": "\u305D\u3046\u3088\u306D\u3002\u3053\u308C\u304B\u3089\u3092 \u3088\u308A\u3088\u304F\u3059\u308B \u3053\u3068\u3092 \u8003\u3048\u306A\u304D\u3083\u3002",
    "Mon_8": "\u3042\u306A\u305F\u306E \u8A00\u3046\u3068\u304A\u308A\u304B\u3082\u3002\u73FE\u5B9F\u304B\u3089 \u76EE\u3092\u80CC\u3051\u3061\u3083 \u30C0\u30E1\u306D\u3002$u",
    "Mon_old": "#$p 7#\u3042\u304D\u3089\u3081\u306A\u304B\u3063\u305F\u3089\u3001 \u6BCD\u3055\u3093\u3092 \u5909\u3048\u3089\u308C\u308B\u3068 \u601D\u3046\u306E\u3002|\u78BA\u304B\u306B\u305D\u3046\u304B\u3082\u3002\u6BCD\u3055\u3093\u3092 \u5909\u3048\u308B\u305F\u3081\u306B \u79C1\u306B \u3067\u304D\u308B\u3053\u3068\u3063\u3066 \u3042\u307E\u308A\u306A\u3044\u308F\u3002",
    "Resort": "\u3053\u306E\u7802\u306F\u3068\u3066\u3082\u67D4\u3089\u304B\u304F\u3066\u7D30\u304B\u3044\u306E\u306D\u3002\u8DB3\u306E\u6307\u304C\u6C17\u6301\u3061\u3044\u306E\uFF01$h",
    "Resort_Entering": "\u4F55\u3066\u7F8E\u3057\u3044\u5CF6\u306A\u306E\u304B\u3057\u3089\uFF01",
    "Resort_Leaving": "\u7D20\u6674\u3089\u3057\u3044\u6642\u9593\u304C\u904E\u3054\u305B\u305F\u308F\u3002$h",
    "Resort_Shore": "\u4EBA\u524D\u3067\u6C34\u7740\u3092\u7740\u308B\u306E\u306F\u3061\u3087\u3063\u3068\u6065\u305A\u304B\u3057\u3044\u308F\u306D\u3002$s#$b#\u8AB0\u3082\u898B\u3066\u306A\u3044\u3068\u3044\u3044\u3051\u3069\u2026$s",
    "Resort_Shore_2": "\u306A\u3093\u3060\u304B\u3001\u3053\u306E\u6C34\u306F\u7279\u5225\u306A\u6C17\u304C\u3059\u308B\u306E\u2026#$e#\u3053\u308C\u307E\u3067\u773A\u3081\u3066\u3044\u305F\u6D77\u3068\u540C\u3058\u3060\u3068\u306F\u601D\u3048\u306A\u304F\u3066\u3002",
    "Resort_Towel": "\u30DA\u30FC\u30B8\u304C\u3081\u304F\u308C\u3061\u3083\u3046\u3051\u3069\u3001\u3053\u306E\u98A8\u306F\u3068\u3066\u3082\u6C17\u6301\u3061\u304C\u3044\u3044\u308F\u3002$h",
    "Resort_Towel_2": "\u7121\u4EBA\u5CF6\u306B\u6F02\u7740\u3057\u305F\u8239\u4E57\u308A\u306E\u672C\u3092\u8AAD\u3093\u3067\u308B\u306E\u3002#$b#\u3082\u3057\u305D\u3046\u306A\u3063\u305F\u3089\u79C1\u306A\u3089\u3069\u3046\u3059\u308B\u304B\u3057\u3089\uFF1F",
    "Resort_Towel_2_Married": "\u306D\u3048\u30CF\u30CB\u30FC\u3001\u3082\u3046\u3061\u3087\u3063\u3068\u5DE6\u306B\u5BC4\u3063\u3066\u304F\u308C\u306A\u3044\uFF1F#$b#\u3042\u308A\u304C\u3068\u3046\u3001\u65E5\u5DEE\u3057\u304C\u5F37\u304F\u3066\u672C\u3092\u8AAD\u3080\u306E\u304C\u5927\u5909\u3060\u3063\u305F\u306E\uFF01$h",
    "Sat": "\u3068\u3066\u3082 \u5C0F\u3055\u3044 \u753A\u3060\u304B\u3089\u306D\u3002\u5FC5\u305A \u8AB0\u304B\u3068 \u4F1A\u3046\u306E\u3088\u3002#$e#\u90FD\u4F1A\u3067\u306E \u66AE\u3089\u3057\u306F \u3069\u3093\u306A\u611F\u3058 \u306A\u306E\u304B\u306A\uFF1F",
    "Sat2": "$d Joja#Joja\u30DE\u30FC\u30C8\u304C \u3067\u304D\u3066\u304B\u3089\u3001 \u8272\u3005\u3068 \u5909\u308F\u3063\u305F\u308F\u3002\u30D4\u30A8\u30FC\u30EB\u3055\u3093\u306E \u304A\u5E97\u304C \u305D\u306E\u3042\u304A\u308A\u3092 \u53D7\u3051\u305F\u306E\u3088\u3002\u6BCD\u3055\u3093\u306F Joja\u30DE\u30FC\u30C8\u304C \u5927\u597D\u304D\u3060\u3051\u3069\u3002\u5546\u54C1\u304C \u5B89\u3044\u304B\u3089\u3001 \u30D4\u30A8\u30FC\u30EB\u3055\u3093\u306E \u304A\u5E97\u3088\u308A \u305A\u3063\u3068 \u6CA2\u5C71 \u8CB7\u3046\u3053\u3068\u304C \u3067\u304D\u308B\u304B\u3089\u306D\u3002|\u6BCD\u3055\u3093\u3001 Joja\u30DE\u30FC\u30C8\u304C \u9589\u5E97\u3057\u3066\u304B\u3089 \u305A\u3063\u3068 \u4E0D\u6E80\u3092 \u8A00\u3063\u3066\u308B\u306E\u3088\u3002\u3067\u3082 \u305D\u306E\u307B\u3046\u304C \u3044\u3044\u3068 \u601D\u3046\u306E\u3002Joja\u30B3\u30FC\u30E9\u3092 \u98F2\u3080 \u983B\u5EA6\u304C \u3078\u308B\u304B\u3089\u306D\u3002",
    "Sun": "\u3053\u3093\u306B\u3061\u306F\u3002\u3046\u30FC\u3093\u2026$u#$b#\u4ECA\u65E5\u306E\u5929\u6C17\u306F \u8208\u5473\u6DF1\u3044\u3068 \u601D\u308F\u306A\u3044\uFF1F#$e#\u3054\u3081\u3093\u3001\u4F55\u3067\u3082\u306A\u3044\u308F\u2026$u",
    "Sun4": "\u5BB6\u3092 \u30AD\u30EC\u30A4\u306B \u3057\u3088\u3046\u3068 \u304C\u3093\u3070\u3063\u3066\u308B\u3051\u3069\u3001 \u3059\u3050 \u30E1\u30C1\u30E3\u30AF\u30C1\u30E3\u306B \u306A\u3063\u3061\u3083\u3046\u306E\u3088\u306D\u3002$s#$e#\u4E00\u4EBA\u3067 \u5BB6\u4E8B\u3092 \u3059\u3079\u3066 \u3084\u308B\u306E\u3063\u3066 \u5927\u5909\u3002$u",
    "Thu": "\u3053\u3093\u306A \u5C0F\u3055\u306A \u753A\u3067\u3082 \u56F3\u66F8\u9928\u304C \u3042\u308B\u306E\u306F \u3044\u3044\u3053\u3068\u306D\u3002#$e#\u672C\u3092 \u8AAD\u307F\u3075\u3051\u3063\u3066\u3044\u308B\u3068\u3001 \u3059\u3050 \u73FE\u5B9F\u306E \u3053\u3068\u3092 \u5FD8\u308C\u3061\u3083\u3046\u308F\u3002$u#$e#\u2026\u3060\u304B\u3089\u3001 \u79C1\u306F \u8AAD\u66F8\u304C \u5927\u597D\u304D\u306A\u306E\u306D\u3002$s#$e#\u2026\u3054\u3081\u3093\u306A\u3055\u3044\u3002\u5922\u4E2D\u306B \u306A\u3063\u3061\u3083\u3063\u3066\u3002",
    "Thu6": "\u30AC\u30FC\u30C7\u30CB\u30F3\u30B0\u304C \u3067\u304D\u305F\u3089 \u3044\u3044\u3051\u3069\u3001 \u3046\u3061\u306E \u5EAD\u304C \u3042\u308C\u3067\u306F\u306D\u2026$u#$e#\u3044\u3064\u304B\u3001 \u304A\u5EAD\u304C \u6301\u3066\u308B\u5834\u6240\u306B \u4F4F\u307F\u305F\u3044\u306A\u3002#$e#\u7267\u5834\u306B \u3057\u3061\u3083\u304A\u3046\u304B\u3057\u3089\uFF01 \u30D5\u30D5\u30C3\u3002$h",
    "Tue": "\u4ECA\u65E5\u306F \u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u3068 \u30B8\u30E3\u30B9\u3092 \u6559\u3048\u308B\u65E5\u3088\u2026\u4E8C\u4EBA\u306B\u6559\u3048\u308B\u3053\u3068\u306F \u5927\u5909\u3060\u3051\u3069\u3001 \u8AB0\u304B\u306E \u4EBA\u751F\u306B \u5F79\u7ACB\u3066\u308B\u306A\u3089 \u3044\u3044\u3088\u306D\u3002",
