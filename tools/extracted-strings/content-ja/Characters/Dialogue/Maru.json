    "GreenRain": "\u30D1\u30D1\u3068\u3044\u3063\u3057\u3087\u306B\u30B5\u30F3\u30D7\u30EB\u306E\u63A1\u53D6\u306B\u884C\u304D\u305F\u3044\u3093\u3060\u3051\u3069\u3001\u30DE\u30DE\u304C\u30C0\u30E1\u3063\u3066\u8A00\u3046\u306E\u2026",
