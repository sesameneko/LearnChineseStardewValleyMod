    "summer_Thu10": "\u7267\u5834\u3067 \u4ED5\u4E8B\u3057\u3066\u308B\u306E\u306B\u3001 \u3069\u3046\u3057\u3066 \u3042\u306A\u305F\u306E\u624B\u306F \u3053\u3093\u306A\u306B \u3084\u308F\u3089\u304B\u3044\u307E\u307E\u306A\u306E\uFF1F",
    "summer_Tue": "\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306F \u79C1\u306E \u8179\u9055\u3044\u306E \u5144\u306A\u306E\u3088\u3002#$e#\u3060\u304B\u3089 \u898B\u305F\u76EE\u3082 \u305C\u3093\u305C\u3093 \u9055\u3046\u306E\u3002",
    "summer_Tue4": "\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u304C \u79C1\u306B \u8A71\u3057\u304B\u3051\u308B\u3053\u3068\u306F \u307B\u3068\u3093\u3069 \u306A\u3044\u308F\u3002\u79C1\u306E\u3053\u3068 \u597D\u3044\u3066\u308B\u304B \u5168\u304F \u5206\u304B\u3089\u306A\u3044\u3002#$e#\u5144\u304C \u307B\u3057\u3044\u306E\u306B\u3001 \u5F7C\u306F \u305D\u3046 \u632F\u821E\u3063\u3066\u304F\u308C\u306A\u3044\u306E\u304C \u60B2\u3057\u3044\u306E\u3088\u3002",
    "summer_Tue8": "@\u3001\u4ECA\u65E5\u306F \u30AD\u30DE\u3063\u3066\u308B \u308F\u306D\u3002$h",
    "summer_Wed": "\u3053\u306E \u6642\u671F\u3092 \u697D\u3057\u3093\u3067\u308B\uFF1F#$e#\u4ECA\u5E74\u306F \u3044\u3064\u3082\u3088\u308A \u6696\u304B\u3044\u308F\u306D\u3002$h",
    "summer_Wed2": "\u6025\u306B\u6691\u304F\u306A\u3063\u305F\u3068\u601D\u308F\u306A\u3044\uFF1F#$e#\u79C1\u3060\u3051\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u3069\u3002",
    "summer_Wed4": "\u30DA\u30CB\u30FC\u3068\u79C1\u306F\u5B63\u7BC0\u3054\u3068\u306B\u8AAD\u66F8\u4F1A\u3092\u958B\u3044\u3066\u3044\u308B\u306E\u3002#$b#\u79C1\u305F\u3061\u4E8C\u4EBA\u3060\u3051\u306E\u4F1A\u3060\u3051\u3069\u3001\u8AAD\u3093\u3060\u672C\u306E\u611F\u60F3\u3092\u8A9E\u308A\u5408\u3046\u306E\u306F\u3059\u3054\u304F\u697D\u3057\u3044\u308F\uFF01",
