    "Resort_Towel_2": "\u3053\u3053\u306F\u6587\u660E\u3068\u306F\u7121\u7E01\u306E\u5834\u6240\u306D\u3002#$b#\u591C\u306B\u3069\u3093\u306A\u661F\u7A7A\u304C\u898B\u3048\u308B\u304B\u60F3\u50CF\u3057\u3066\u307F\u3066\u3002#$e#\u3072\u3087\u3063\u3068\u3057\u305F\u3089\u3001\u7A7A\u98DB\u3076\u5186\u76E4\u306E\u3072\u3068\u3064\u3084\u3075\u305F\u3064\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u308F\uFF01$h",
    "Sat": "\u30D1\u30D1\u306E \u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u3068\u306F \u77E5\u308A\u5408\u3063\u305F\uFF1F\u3042\u306E\u4EBA\u306F \u79D1\u5B66\u8005\u306A\u3093\u3060\u3002\u7814\u7A76\u306E \u304A\u624B\u4F1D\u3044\u3092 \u3057\u3066\u308B\u3051\u3069\u3001 \u3059\u3054\u304F \u697D\u3057\u3044\u3088\u3002",
    "Sat2": "\u58CA\u308C\u3066\u3057\u307E\u3063\u305F\u3082\u306E\u3092\u6368\u3066\u305A\u306B\u4FEE\u7406\u3067\u304D\u308B\u3068\u672C\u5F53\u306B\u3044\u3044\u6C17\u5206\u306B\u306A\u308B\u308F\u3002",
    "Sat4": "\u300C\u9B54\u6CD5\u306F\u5B9F\u5728\u3057\u306A\u3044\u300D\u3063\u3066\u3044\u3046\u4EBA\u305F\u3061\u306F\u3001\u78C1\u529B\u306E\u3053\u3068\u3092\u3069\u3046\u601D\u3063\u3066\u308B\u306E\u304B\u3057\u3089\uFF1F",
