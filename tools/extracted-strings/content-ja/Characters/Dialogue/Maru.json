    "winter_Sun": "\u5BD2\u3044\u6642\u306F \u7720\u304F\u306A\u308B\u3093\u3060\u2026",
    "winter_Thu": "\u306D\u3047\uFF01\u8ABF\u5B50\u306F\u3069\u3046\uFF1F#$e#\u6D1E\u7A9F\u3092 \u63A2\u691C \u3057\u3066\u307F\u308B\u306E\u3082 \u3044\u3044\u304B\u3082\u306D\u3002#$e#\u79C1\u3082 \u884C\u304D\u305F\u3044\u3051\u3069\u3001 \u30D1\u30D1\u304C \u6012\u308B\u304B\u3089\u2026",
    "winter_Thu10": "@\u3001\u3082\u3063\u3068\u8FD1\u304F\u306B\u304D\u3066\u3002\u5BD2\u3044\u306E\u3002$l#$e#\u51AC\u306E \u7A7A\u6C17\u306E \u305B\u3044\u3067 \u624B\u304C \u4E7E\u71E5\u3057\u3061\u3083\u3063\u3066\u308B\u3002\u3054\u3081\u3093\u306A\u3055\u3044\u306D\u3002$l",
    "winter_Tue": "\u79C1\u306E\u9AEA\u3001 \u7A7A\u6C17\u304C \u4E7E\u71E5\u3057\u3066\u308B\u3068 \u7E2E\u308C\u308B\u306E\u3088\u306D\u3002\u306F\u3041\u2026",
    "winter_Tue4": "\u79C1\u304C\u4F5C\u308C\u305D\u3046\u306A \u65B0\u3057\u3044 \u30AC\u30B8\u30A7\u30C3\u30C8\u306E \u30A2\u30A4\u30C7\u30A2 \u306A\u3044\u304B\u306A\uFF1F#$e#\u3075\u3080\u3075\u3080\u3002\u305D\u306E \u610F\u898B\u3092 \u4FE1\u3058\u308B\u308F\u3002",
    "winter_Wed": "\u51AC\u306F \u30AC\u30B8\u30A7\u30C3\u30C8\u4F5C\u308A\u306B \u96C6\u4E2D\u3067\u304D\u308B \u6642\u671F\u3060\u3068 \u601D\u3046\u306E\u3002#$e#\u7267\u5834\u4E3B\u306B \u5F79\u7ACB\u3061\u305D\u3046\u306A \u3082\u306E\u3092 \u4F5C\u308C\u308B\u304B\u306A\uFF1F"
