    "Sat8": "\u4E16\u754C\u306B\u3069\u3093\u306A\u30C6\u30AF\u30CE\u30ED\u30B8\u30FC\u304C\u3042\u3063\u305F\u3068\u3057\u3066\u3082\u3001\u53CB\u9054\u3068\u306E\u7D46\u306B\u52DD\u308B\u3082\u306E\u306F\u306A\u3044\u308F\u3002",
    "Sun": "\u3053\u3093\u306B\u3061\u306F\uFF01#$q 3/4 Sun_01_old#\u7267\u5834\u3067\u306E \u4ED5\u4E8B\u3092 \u697D\u3057\u3081\u3066\u308B\uFF1F#$r 3 0 Sun_01_01#\u697D\u3057\u3044\u3002#$r 4 0 Sun_01_02#\u697D\u3057\u304F\u306A\u3044\u3002",
    "Sun_01_01": "\u305D\u308C\u306F\u3088\u304B\u3063\u305F\u308F\u3002$h",
    "Sun_01_02": "\u3048\u3063\uFF01\u3054\u3081\u3093\u306D\u3002\u4ED6\u306E\u3053\u3068\u3092 \u3057\u3088\u3046\u3063\u3066 \u8003\u3048\u305F\u3053\u3068\u306F \u3042\u308B\u2026\u304B\u306A\uFF1F$s",
    "Sun_01_old": "$p 3#\u3042\u3089\u3001 \u4ECA\u9031\u3082 \u9806\u8ABF\u306B \u4F5C\u696D\u304C \u9032\u3093\u3067\u308B\u307F\u305F\u3044\u306D\uFF01\u3069\u3046\u3084\u3089 \u8272\u3005\u3068 \u3046\u307E\u3044\u611F\u3058\u3067 \u3044\u3063\u3066\u308B\u307F\u305F\u3044\u3002$h|\u4ECA\u9031\u3082 \u5927\u5909\u306A \u304A\u4ED5\u4E8B \u3060\u3063\u305F\u306E\uFF1F\u672C\u5F53\u306B \u8272\u3005\u3068 \u3084\u308B\u3053\u3068\u304C \u3042\u308B\u306E\u306D\u2026$s",
    "Thu": "\u3053\u306E\u590F\u306F\u3001 \u671B\u9060\u93E1\u3067 \u305F\u304F\u3055\u3093 \u661F\u3092 \u898B\u3088\u3046\u3068 \u601D\u3063\u3066\u308B\u306E\u3002",
