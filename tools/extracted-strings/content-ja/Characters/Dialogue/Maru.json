    "Resort_Bar": "\u3046\u30FC\u3093\u2026\u5357\u56FD\u306E\u679C\u7269\u3063\u3066\u306A\u3093\u3067\u3053\u3093\u306A\u306B\u304A\u3044\u3057\u3044\u3093\u3060\u308D\u3046\uFF1F",
