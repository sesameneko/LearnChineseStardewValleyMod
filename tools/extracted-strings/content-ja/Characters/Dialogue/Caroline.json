    "Sat6": "#$1 Caroline12#\u79C1\u9054\u304C \u3053\u3053\u306B\u5F15\u3063\u8D8A\u3057\u305F\u6642\u3001 \u843D\u3061\u7740\u304F\u307E\u3067\u306B \u6642\u9593\u304C\u304B\u304B\u3063\u305F\u308F\u2026\u5BB6\u5EAD\u7684\u306A \u751F\u6D3B\u3092 \u9001\u308B\u6E96\u5099\u304C \u3067\u304D\u3066\u306A\u304B\u3063\u305F\u306E\u3002#$e#\u30D4\u30A8\u30FC\u30EB\u306F \u4F1D\u7D71\u7684\u3060\u3051\u3069\u2026\u3044\u3044\u4EBA\u3088\u3002\u5927\u304D\u306A\u5922\u3092\u62B1\u304D\u306A\u304C\u3089\u3082\u3001 \u5BB6\u65CF\u3092 \u4E00\u756A\u5927\u4E8B\u306B\u3057\u3066\u304F\u308C\u308B\u304B\u3089\u3002",
