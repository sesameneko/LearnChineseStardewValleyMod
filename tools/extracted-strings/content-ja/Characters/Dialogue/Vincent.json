    "Resort_Leaving": "\u3059\u3050\u306B\u623B\u3063\u3066\u6765\u305F\u3044\u3088\uFF01",
    "Resort_Shore": "\u30B5\u30E1\u3092\u898B\u3066\u307F\u305F\u3044\u306A\uFF01$h",
    "Sat": "\u30DA\u30CB\u30FC\u3055\u3093\u306F \u6BCE\u9031 \u65B0\u3057\u3044 \u672C\u3092 \u8AAD\u307E\u305B\u3066\u304F\u308C\u308B\u3093\u3060\u3002$s#$b#\u6642\u3005\u3001 \u672C\u3092 \u9078\u3070\u305B\u3066\u304F\u308C\u308B\u3053\u3068\u3082 \u3042\u308B\u3093\u3060\u3088\uFF01",
