    "Sat_1": "\u3082\u3046\u3059\u3050 \u304A\u3068\u3046\u3055\u3093\u304C \u5E30\u3063\u3066\u304F\u308B\u3093\u3060\u3063\u3066\uFF01#$b#\u304A\u571F\u7523\u306E \u30AA\u30E2\u30C1\u30E3\u306F \u306A\u3044\u304B\u306A\u3002$u",
    "Sun": "\u3053\u3093\u306B\u3061\u306F\u3001 \u304A\u5144\u3055\u3093\uFF01^\u3053\u3093\u306B\u3061\u306F\u3001 \u304A\u59C9\u3055\u3093\uFF01",
