    "Introduction": "\u306F\u3058\u3081\u307E\u3057\u3066\uFF01\u30DC\u30AF\u306F\u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u3002#$b#\u304A\u304B\u3042\u3055\u3093\u304C \u77E5\u3089\u306A\u3044\u4EBA\u3068 \u8A71\u3057\u3061\u3083 \u30C0\u30E1\u3060\u3063\u3066 \u8A00\u3063\u3066\u308B\u3051\u3069\u2026\u3042\u306A\u305F\u306A\u3089 \u5927\u4E08\u592B\u305D\u3046\u3002",
    "Mon": "\u5927\u304D\u304F\u306A\u3063\u305F\u3089\u3001 \u304A\u5144\u3061\u3083\u3093 \u307F\u305F\u3044\u306B \u306A\u308A\u305F\u3044\u306A\uFF01$h#$e#\u3046\u3093\uFF01\u3058\u3083\u3042\u306D\uFF01",
