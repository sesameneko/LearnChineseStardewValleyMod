    "Fri": "#$c .3#\u3046\u308F\u3063\u3001 \u307E\u305F \u30C6\u30F3\u30B5\u30A4\u306E\u716E\u8FBC\u307F\u2026$s#$e#\u30B5\u30A4\u30A2\u30AF\u3060\u3088\u2026\u4ECA\u591C\u306F \u304A\u304B\u3042\u3055\u3093\u304C \u30EC\u30F3\u30BA\u30DE\u30E1\u306E \u30B9\u30FC\u30D7\u3092 \u4F5C\u308B\u3093\u3060\u3063\u3066\u3002$s",
    "GreenRain": "\u304A\u6BCD\u3055\u3093\uFF01\u5916\u306B\u51FA\u3066\u904A\u3073\u305F\u3044\u3088\uFF01%noturn",
