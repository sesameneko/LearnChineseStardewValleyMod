    "Resort_Bar": "\u30AC\u30B9\u3001\u307F\u3093\u306A\u306E\u5206\u3092\u50D5\u304C\u6CE8\u6587\u3059\u308B\u3088\uFF01#$b#\uFF08\u30D2\u30C3\u30AF\uFF09\u3042\u3063\u2026\u30B4\u30FC\u30EB\u30C9\u304C\u8DB3\u308A\u306A\u3044\u3084\u3002$s#$b#\u3078\u3078\u3078\u2026\u4F55\u3067\u3082\u306A\u3044\uFF01",
