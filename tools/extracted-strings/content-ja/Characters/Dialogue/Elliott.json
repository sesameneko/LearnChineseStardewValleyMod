    "Sat": "\u305F\u3076\u3093\u3001 \u541B\u306F\u50D5\u306E\u5C0F\u5C4B\u3092 \u6C17\u306B\u5165\u3089\u306A\u3044\u304B\u3082\u3002\u6697\u304F\u3066\u3001 \u30AF\u30E2\u304C\u3044\u3063\u3071\u3044\u3060\u304B\u3089\u306D\u3002$s",
    "Sat4": "\u304A\u7C97\u672B\u306A \u5C0F\u5C4B\u3067 \u3059\u307E\u306A\u3044\u3002",
    "Sat6": "\u6065\u305A\u304B\u3057\u304C\u308A\u5C4B\u306A \u4EBA\u3082 \u3044\u308B\u3002\u5F7C\u3089\u3078\u306E \u8208\u5473\u3092 \u793A\u3057\u7D9A\u3051\u3066\u3044\u308C\u3070\u3001 \u541B\u306B\u5FC3\u3092 \u958B\u3044\u3066\u304F\u308C\u308B\u3060\u308D\u3046\u3002#$e#\u307F\u3093\u306A\u3001 \u53CB\u9054\u3092\u307B\u3057\u304C\u3063\u3066\u308B\u306E\u3060\u3088\u3002 \u3042\u306E\u6C17\u96E3\u3057\u3044 \u935B\u51B6\u5C4B\u3082\u306D\u3002",
    "SquidFest": "\u30D3\u30FC\u30C1\u306B\u3053\u3093\u306A\u306B\u5927\u52E2\u306E\u4EBA\u304C\u3044\u308B\u306A\u3093\u3066\u73CD\u3057\u3044\u306D\u3002\u3059\u3079\u3066\u306F\u30A4\u30AB\u3092\u611B\u3059\u308B\u304C\u3086\u3048\u306B\uFF01",
