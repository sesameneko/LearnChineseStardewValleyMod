    "Thu": "\u3053\u3093\u306B\u3061\u306F\u3001@\u3002#$e#\u5143\u6C17\u304B\u3044\uFF1F",
    "Thu2": "\u5C0F\u8AAC\u3092 \u66F8\u304D\u59CB\u3081\u308B\u305F\u3081\u306E \u30A4\u30F3\u30B9\u30D4\u30EC\u30FC\u30B7\u30E7\u30F3\u304C \u898B\u3064\u304B\u3089\u306A\u3044\u3093\u3060\u2026$s",
    "Thu4": "\u6700\u8FD1\u3001 \u3044\u3044\u8ABF\u5B50\u306A\u3093\u3060\u3002\u5929\u6C17\u304C \u5909\u308F\u308B \u5146\u3057\u306A\u3093\u3060\u308D\u3046\u3002",
    "Thu6": "\u6642\u3005\u3001\u81EA\u5206\u306E\u3053\u3068\u3092 \u300C\u30B9\u30AD\u30EB\u306F \u7121\u3044\u306E\u306B \u81EA\u5DF1\u30A4\u30E1\u30FC\u30B8\u304C \u5148\u884C\u3057\u904E\u304E\u3066\u3044\u308B\u300D \u3088\u3046\u306B\u601D\u3048\u308B\u3093\u3060\u2026$s#$e#\u3044\u3084\u2026\u304A\u4E16\u8F9E\u306B\u91E3\u3089\u308C\u308B\u3064\u3082\u308A\u306F\u306A\u3044\u3088\u3002\u8A00\u308F\u308C\u308B\u306E\u306F\u5B09\u3057\u3044\u3051\u3069\u3055\u2026",
    "Thu8": "#$1 elliottApol#\u6D5C\u8FBA\u3067\u306E\u751F\u6D3B\u306F \u5C11\u3057\u3055\u3073\u3057\u304F\u3066\u306D\u2026 \u3082\u3057 \u521D\u3081\u3066\u4F1A\u3063\u305F\u6642\u306E \u614B\u5EA6\u304C \u5C11\u3005 \u306A\u308C\u306A\u308C\u3057\u304B\u3063\u305F\u3089 \u8B1D\u308B\u3088\u3002\u305F\u3060 \u53CB\u9054\u304C \u307B\u3057\u304B\u3063\u305F\u3093\u3060\u3002$k#$e#\u541B\u306E\u3088\u3046\u306A \u89AA\u53CB\u3092 \u6301\u3066\u3066 \u5B09\u3057\u3044\u3088\u3002",
    "Tue": "\u6700\u9AD8\u306E \u30A2\u30A4\u30C7\u30A2\u3068 \u3044\u3046\u3082\u306E\u306F\u3001 \u601D\u3044\u304C\u3051\u306A\u3044\u6642\u306B \u51FA\u3066\u304F\u308B\u3082\u306E\u3060\u3051\u3069\u2026 \u5FD9\u3057\u3059\u304E\u3066 \u982D\u3092 \u56DE\u305B\u306A\u3044\u3068 \u898B\u9003\u3057\u3066\u3057\u307E\u3046\u3060\u308D\u3046\u3002#$e#\u50D5\u3082 \u65E9\u304F\u3001 \u4ED5\u4E8B\u306B \u623B\u3089\u306A\u3044\u3068\u3002",
    "Tue6": "\u30DA\u30F3\u3068\u7D19\u304C \u594F\u3067\u308B \u7518\u7F8E\u306A\u97F3\u306F \u50D5\u306E\u9B42\u306B \u97FF\u304F\u306E\u3055\u3002$u#$b#\u3060\u304B\u3089\u3001 \u3053\u306E\u7A4F\u3084\u304B\u3067\u9759\u304B\u306A\u6D5C\u8FBA\u306B \u5BB6\u3092\u5EFA\u3066\u308B\u3053\u3068\u306B\u3057\u305F\u3002\u305D\u306E\u97F3\u3092\u805E\u304F\u305F\u3081\u306B\u306D\u3002",
