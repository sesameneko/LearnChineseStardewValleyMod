    "GreenRain_2": "\u307E\u305F\u8C37\u306B\u4E0D\u601D\u8B70\u306A\u65E5\u304C\u304A\u3068\u305A\u308C\u305F\u3088\u3046\u3060\u306D\u3002\u63A7\u3048\u3081\u306B\u8A00\u3063\u3066\u3082\u3001\u523A\u6FC0\u7684\u3060\u3088\uFF01",
    "Introduction": "\u3042\u3042\u3001\u307F\u3093\u306A\u304C\u5F85\u3063\u3066\u3044\u305F \u65B0\u5165\u308A\u306E\u7267\u5834\u4E3B\u304B\u2026 \u541B\u306E\u5230\u6765\u3067 \u8A71\u984C\u306F \u6301\u3061\u304D\u308A\u3060\u3063\u305F\u306D\uFF01#$b#\u50D5\u306F\u30A8\u30EA\u30AA\u30C3\u30C8\u2026\u6D5C\u8FBA\u306B\u3042\u308B \u5C0F\u5C4B\u306B \u4F4F\u3093\u3067\u3044\u308B\u3002\u3053\u308C\u304B\u3089\u3082 \u3088\u308D\u3057\u304F\u983C\u3080\u3088\u3002",
