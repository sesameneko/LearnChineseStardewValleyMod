    "Thu": "\u3088\u304A\u3002\u4F55\u304B \u5FC5\u8981\u304B\u3057\u3089\uFF1F#$e#\u8FD1\u3044\u3046\u3061\u306B\u3001 \u4ED6\u306E\u7A2E\u985E\u306E \u52D5\u7269\u3082 \u53D6\u308A\u6271\u3046 \u4E88\u5B9A\u306A\u306E\u3002#$e#\u3067\u3082\u3001 \u9700\u8981\u304C\u3042\u308B\u304B \u3057\u3063\u304B\u308A \u78BA\u8A8D\u3057\u306A\u304D\u3083 \u3044\u3051\u306A\u3044\u304B\u3089\u3001 \u307E\u305A \u52D5\u7269\u306E\u6271\u3044\u306B \u6163\u308C\u3066\u308B\u3053\u3068\u3092 \u3042\u305F\u3057\u306B \u793A\u3057\u3066 \u3061\u3087\u3046\u3060\u3044\u3002#$e#\u52D5\u7269\u3092 \u3061\u3083\u3093\u3068 \u4E16\u8A71 \u3057\u3066\u3042\u3052\u308C\u3070\u3001 \u3044\u3044\u3053\u3068\u304C \u8D77\u3053\u308B\u308F\u3088\u3002",
    "Thu_2": "\u3053\u3053\u3067\u306E \u751F\u6D3B\u306B \u306A\u3058\u3093\u3067\u304D\u305F\u308F\u306D\u3002 \u305D\u308C\u3067\u2026 \u7267\u5834\u306E \u8ABF\u5B50\u306F \u3069\u3046\uFF1F#$e#\u52D5\u7269\u306E \u4E16\u8A71\u306F \u3057\u3063\u304B\u308A \u899A\u3048\u3066\u3044\u308B\u9650\u308A \u7C21\u5358\u306A \u3082\u306E\u3088\uFF01$h",
