    "Saloon_Wed": "#$1 marnieAnimalSal#\u4ECA\u65E5\u306F \u30DF\u30EB\u30AF\u304C \u306A\u307F\u306A\u307F\u5165\u3063\u305F \u30D0\u30B1\u30C4\u3092 \u5E8A\u306B \u3053\u307C\u3057\u3061\u3083\u3063\u305F\u306E\u3002 \u30B5\u30A4\u30A2\u30AF\u3060\u3063\u305F\u308F\u3002\u30D9\u30EA\u30F3\u30C0\u306E \u52AA\u529B\u306E \u7D50\u6676\u304C \u7121\u99C4\u306B \u306A\u3063\u305F \u611F\u3058\u304C \u3057\u305F\u308F\u3002$k$s#$e#\u3042\u3089\u3001 \u6765\u3066\u304F\u308C\u305F\u306E\u306D\uFF01\u3053\u306E\u5834\u6240\u306B \u6D3B\u6C17\u304C \u51FA\u3066\u304D\u305F\u308F\u3002",
    "Sat": "\u3042\u305F\u3057\u306E\u5BB6\u306E \u897F\u306B\u3042\u308B \u5909\u308F\u3063\u305F \u5854\u3078 \u884C\u3063\u305F\u3053\u3068\u306F \u3042\u308B\uFF1F#$e#\u3042\u305D\u3053\u304B\u3089\u3001 \u3053\u306E\u4E16\u306E\u3082\u306E\u3068\u306F \u601D\u3048\u306A\u3044\u3001 \u6050\u308D\u3057\u3044 \u97F3\u304C \u805E\u3053\u3048\u305F\u3053\u3068\u304C \u3042\u308B\u308F\u3002$s#$e#\u3042\u305F\u3057\u3060\u3063\u305F\u3089\u3001 \u3042\u3093\u306A\u5834\u6240\u306B \u8FD1\u3065\u304D\u305F\u304F\u306A\u3044\u308F\u306D\u2026",
    "Sun": "\u3042\u3089\u3001 \u3042\u3048\u3066\u3046\u308C\u3057\u3044\u308F\uFF01#$e#\u6C17\u304C\u5411\u3044\u305F\u3089 \u3044\u3064\u3067\u3082 \u6765\u3066\u306D\u3002",
