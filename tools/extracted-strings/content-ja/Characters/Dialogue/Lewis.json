    "AcceptBirthdayGift_Negative": "\u79C1\u306E\u8A95\u751F\u65E5\u3092\u899A\u3048\u3066\u3044\u3066\u304F\u308C\u305F\u306E\u304B\u2026 \u3053\u308C\u306F\u4F55\u304B\u306D\uFF1F$h#$b#\u307E\u3042\u2026 \u3088\u304F\u8A00\u3046\u3060\u308D\u3046\uFF1F \u300C\u5927\u5207\u306A\u306E\u306F\u6C17\u6301\u3061\u3060\u300D\u3068\u3002",
    "AcceptBirthdayGift_Positive": "\u79C1\u306E\u8A95\u751F\u65E5\u3092\u899A\u3048\u3066\u3044\u3066\u304F\u308C\u305F\u306E\u304B\u3002\u304D\u307F\u306E\u601D\u3044\u3084\u308A\u306B\u611F\u8B1D\u3059\u308B\u3088\u3002\u3059\u3070\u3089\u3057\u3044\u8D08\u308A\u7269\u3060\uFF01$h",
