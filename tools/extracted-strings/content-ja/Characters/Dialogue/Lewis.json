    "Fri": "%farm\u7267\u5834\u306E \u904B\u55B6\u304C \u3046\u307E\u304F \u3044\u3063\u3066\u304A\u308B\u3053\u3068\u3092 \u7948\u3063\u3066\u304A\u308B\u305E\u3002\u5BC2\u308C\u305F \u8FB2\u5834\u306A\u3093\u3066 \u898B\u305F\u304F\u306A\u3044\u304B\u3089\u306E\u3046\u3002",
    "GreenRain": "\u4ECA\u3001\u77E5\u4E8B\u3068\u96FB\u8A71\u3067\u8A71\u3057\u305F\u3093\u3060\u304C\u2026\u3069\u3046\u3084\u3089\u3053\u306E\u96E8\u306F\u307E\u3063\u305F\u304F\u7121\u5BB3\u306E\u3088\u3046\u3060\u3002\u3081\u305A\u3089\u3057\u3044\u81EA\u7136\u73FE\u8C61\u3060\u3088\u3002#$b#\u3057\u304B\u3057\u3001\u753A\u6C11\u306E\u306A\u304B\u306B\u306F\u30D1\u30CB\u30C3\u30AF\u306B\u306A\u3063\u3066\u3044\u308B\u8005\u3082\u3044\u308B\u3088\u3046\u3060\u2026",
    "GreenRainFinished": "\u79C1\u305F\u3061\u306E\u5C0F\u3055\u306A\u753A\u306B\u3068\u3063\u3066\u306F\u3001\u304B\u306A\u308A\u523A\u6FC0\u7684\u306A\u51FA\u6765\u4E8B\u3060\u3063\u305F\u306D\uFF01\u307F\u3093\u306A\u304C\u7121\u4E8B\u306A\u3088\u3046\u3067\u30DB\u30C3\u3068\u3057\u3066\u308B\u3088\u3002$h#$e#\u307E\u305F\u540C\u3058\u3053\u3068\u304C\u8D77\u304D\u305F\u3068\u3057\u3066\u3082\u3001\u6B21\u306F\u307F\u3093\u306A\u843D\u3061\u7740\u3044\u3066\u904E\u3054\u305B\u308B\u3060\u308D\u3046\u3002\u5927\u707D\u5BB3\u3067\u306F\u306A\u3044\u304B\u3089\u306D\uFF01",
    "GreenRain_2": "\u304A\u305D\u3089\u304F\u3001\u3053\u306E\u4E0D\u601D\u8B70\u306A\u96E8\u306F\u6BCE\u5E74\u964D\u308B\u306E\u3060\u308D\u3046\u3002\u3053\u308C\u304C\u7121\u5BB3\u306A\u81EA\u7136\u73FE\u8C61\u3060\u3068\u77E5\u308C\u3070\u3001\u307F\u3093\u306A\u843D\u3061\u7740\u3044\u3066\u3059\u3054\u305B\u308B\u306F\u305A\u3060\u3002",
    "Introduction": "\u3053\u306E\u7267\u5834\u3067\u306E \u521D\u3081\u3066\u306E \u591C\u306F \u3069\u3046\u3060\u3063\u305F\u304B\u306D\uFF1F#$e#\u541B\u306E \u304A\u3058\u3044\u3055\u3093\u306F \u30AC\u30BF\u30AC\u30BF\u306E \u30D9\u30C3\u30C9\u306B \u3088\u304F \u6587\u53E5\u3092 \u8A00\u3063\u3066\u305F\u3088\u3002\u3067\u3082\u3001 \u5F7C\u306F \u3042\u306E\u5BB6\u3092 \u5FC3\u306E\u5E95\u304B\u3089 \u611B\u3057\u3066\u305F\u3093\u3058\u3083\u3002",
    "Mon": "\u3053\u306E\u5B63\u7BC0\u306F \u7267\u5834\u4E3B\u3067\u306A\u3044 \u79C1\u9054\u3067\u3082\u3001\u5712\u82B8\u3092 \u8003\u3048\u3055\u305B\u3089\u308C\u308B\u6642\u671F\u3058\u3083\u3088\u3002#$e#\u3053\u306E\u8C37\u306F \u6625\u306B \u3059\u3070\u3089\u3057\u3044 \u82B1\u304C \u54B2\u304F\u3053\u3068\u3067 \u6709\u540D\u3058\u3083\u304B\u3089\u306A\u3002$h",
    "Resort": "\u672C\u5F53\u306B\u611F\u6FC0\u3057\u3066\u3044\u308B\u3088\u3001@\u3002\u3053\u3093\u306A\u6A5F\u4F1A\u3092\u8A2D\u3051\u3066\u304F\u308C\u308B\u306A\u3093\u3066\uFF01$h",
    "Resort_Bar": "\u306F\u306F\u306F...\u30AC\u30B9\u304C\u5927\u6D3B\u8E8D\u3057\u3066\u3044\u308B\u306A\u3002",
    "Resort_Chair": "\u306F\u306F\u306F\u2026\u3053\u306E\u5834\u6240\u3092\u898B\u3066\u304F\u308C\uFF01\u304D\u307F\u304C\u3069\u3046\u3084\u3063\u305F\u306E\u304B\u5206\u304B\u3089\u306A\u3044\u304C\u3001\u3053\u306E\u5C0F\u3055\u306A\u4F11\u61A9\u30B9\u30DD\u30C3\u30C8\u304C\u753A\u306E\u8A71\u984C\u306B\u306A\u3063\u3066\u3044\u308B\u3093\u3060\u3002$h",
    "Resort_Leaving": "\u307F\u306A\u3055\u3093\u4E57\u3063\u3066\u304F\u3060\u3055\u3044\uFF01\u8C37\u306B\u5E30\u308A\u307E\u3059\u3088\uFF01",
    "Resort_Shore": "\u3053\u3046\u3057\u3066\u4F11\u6687\u3092\u53D6\u308B\u3053\u3068\u3067\u3001\u5730\u57DF\u7D4C\u6E08\u304C\u6D3B\u6027\u5316\u3059\u308B\u304B\u3082\u3057\u308C\u306A\u3044\uFF01#$e#\u3042\u307E\u308A\u9577\u304F\u592A\u967D\u3092\u6D74\u3073\u305F\u3089\u3001\u79C1\u306E\u30D2\u30B2\u304C\u4E7E\u3044\u3066\u3057\u307E\u3044\u305D\u3046\u3060\u3002",
    "Saloon": "\u3044\u3044\u591C\u3058\u3083\u306A\uFF01\u753A\u306E\u4EBA\u3005\u3068 \u306A\u3058\u3082\u3046\u3068\u3057\u3066\u3044\u308B\u3088\u3046\u3067 \u611F\u5FC3\u3058\u3083\u3088\u3002#$b#\u6642\u3005 \u3053\u3046 \u7ACB\u3061\u5BC4\u3063\u3066\u3001 \u6700\u8FD1\u306E \u8A71\u984C\u3092 \u77E5\u308B\u3053\u3068\u306F \u5927\u5207\u3058\u3083\u3002$h",
    "Saloon4": "\u3053\u3093\u3070\u3093\u306F\u3001@\uFF01\u541B\u304C \u9152\u5834\u3067 \u304F\u3064\u308D\u3044\u3067\u308B\u3088\u3046\u3067 \u3046\u308C\u3057\u3044\u305E\u3002\u305F\u307E\u306B\u306F \u606F\u3092\u3064\u304F\u306E\u3082 \u3044\u3044\u304B\u3089\u306A\u3002$h#$b#\u541B\u306E\u304A\u3058\u3044\u3055\u3093\u306F\u672C\u5F53\u306B\u4ED5\u4E8B \u71B1\u5FC3\u306A\u4EBA\u3058\u3083\u3063\u305F\u3088\u2026 \u5F7C\u3092\u79F0\u3048\u3066\u3001\u4ECA\u591C\u306F\u3082\u3046\u4E00\u676F \u98F2\u3080\u3068\u3057\u3088\u3046\u304B\u3002",
    "Saloon_Entry": "\u3084\u3041\u3001\u30AC\u30B9\uFF01",
    "Sat": "\u9031\u672B\u306F \u307F\u3093\u306A \u697D\u3057\u305D\u3046\u306B \u3057\u3066\u3044\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u306E\u306F \u79C1\u3060\u3051\u304B\u306D\uFF1F#$e#\u79C1\u306F \u5E73\u65E5\u3082 \u9031\u672B\u3082 \u95A2\u4FC2\u306A\u3044 \u4ED5\u4E8B\u306B \u5C31\u3044\u3066\u308B\u304C\u306E\u3046\u3002",
    "Sun": "\u79C1\u306F 20\u5E74\u4EE5\u4E0A\u3001 \u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3\u306E \u753A\u9577\u3092 \u3084\u3063\u3066\u304A\u308B\uFF01#$e#\u9078\u6319\u306E\u6642\u3001 \u8AB0\u3082 \u79C1\u306B \u53CD\u5BFE\u7968\u3092 \u51FA\u3055\u306A\u3044\u3093\u3058\u3083\u3088\u3002\u3064\u307E\u308A\u3001 \u307F\u3093\u306A \u79C1\u306E \u4ED5\u4E8B\u3063\u3077\u308A\u306B \u611F\u8B1D \u3057\u3066\u304A\u308B\u3093\u3058\u3083\u306A\u3002#$e#\u3053\u308C\u304B\u3089\u3082 \u753A\u9577\u3067 \u3084\u3063\u3066\u3044\u304D\u305F\u3044\u306E\u3046\u3002",
    "Thu": "\u591C\u306E\u9152\u5834\u306F \u7D50\u69CB \u306B\u304E\u308F\u3063\u3066\u304A\u308B\u305E\u3002\u6642\u3005 \u30B8\u30E5\u30FC\u30AF\u30DC\u30C3\u30AF\u30B9\u306B \u30B3\u30A4\u30F3\u3092 \u5165\u308C\u308B\u3053\u3068\u3082 \u3042\u308B\u306A\u3002\u30DB\u30C3\u30DB\u30C3\u3002$h#$e#\u9031\u306B\u4E00\u5EA6\u306F \u9152\u5834\u306B \u884C\u3063\u3066\u3001 \u8A71\u984C\u306B \u53D6\u308A\u6B8B\u3055\u308C\u306A\u3044\u3088\u3046\u306B \u3057\u3068\u308B\u3002",
    "Town_57_40": "#$c .3#\u305A\u3044\u3076\u3093 \u671D\u65E9\u304F\u306B \u753A\u3078 \u6765\u305F\u3093\u3058\u3083\u306A\u3002\u3082\u3046 \u7551\u4ED5\u4E8B\u306F \u7D42\u308F\u3063\u305F\u306E\u304B\u306D\uFF1F#$e#\u304A\u306F\u3088\u3046\uFF01\u79C1\u306F \u3044\u3064\u3082\u3069\u304A\u308A \u5EAD\u306E \u898B\u56DE\u308A\u3092 \u3057\u3066\u308B\u3068\u3053\u308D\u3058\u3083\u3088\u3002$h#$c .5#\u3075\u3080\u2026\u3053\u308C\u306F \u30A2\u30D6\u30E9\u30E0\u30B7\u304B\uFF1F$s#$e# \u3075\u3080\u2026\u3053\u308C\u304C \u30AB\u30A4\u30AC\u30E9\u30E0\u30B7\u3058\u3083\u306A\u3051\u308C\u3070 \u3044\u3044\u3093\u3058\u3083\u304C\u2026$s",
    "Tue": "\u541B\u306E \u5BB6\u306E \u305D\u3070\u306B\u3042\u308B \u7BB1\u306B\u3001 \u58F2\u308A\u305F\u3044\u3082\u306E\u3092 \u5165\u308C\u3066\u304A\u304F\u308C\u3002#$e#\u3069\u3093\u306A\u3082\u306E\u304C \u5165\u308C\u3089\u308C\u308B\u304B\u3001 \u79C1\u306F \u697D\u3057\u307F\u306B \u3057\u3066\u304A\u308B\u305E\u3002",
    "Tue2": "\u5B63\u7BC0\u59CB\u3081\u306B\u306F\u3001 \u524D\u306E \u5B63\u7BC0\u306E \u4F5C\u7269\u304C \u67AF\u308C\u3066\u3057\u307E\u3046\u304B\u3089 \u5208\u308A\u53D6\u308B \u5FC5\u8981\u304C \u3042\u308B\u305E\u3002\u30AB\u30DE\u3092 \u4F7F\u3048\u3070 \u7C21\u5358\u3058\u3083\u3002",
    "Wed": "\u3046\u30FC\u3080\u2026 \u7A0E\u91D1\u306E\u5FB4\u53CE\u2026 \u3076\u3064\u3076\u3064\u2026 \u6625\u796D\u308A\u306E\u8CBB\u7528\u2026 \u3076\u3064\u3076\u3064\u2026$u#$e#\u3093\uFF1F",
    "cc_Begin": "\u304F\u3093\u304F\u3093\u2026\u53E4\u3044 \u30B3\u30DF\u30E5\u30CB\u30C6\u30A3 \u30BB\u30F3\u30BF\u30FC\u306B \u3057\u3070\u3089\u304F \u3044\u305F\u306E\u304B\u306A\u3002\u305D\u3046\u3084\u3063\u3066 \u5927\u5207\u306A \u5834\u306E\u3053\u3068\u3092 \u8003\u3048\u3066\u304F\u308C\u308B \u4EBA\u304C\u3044\u308B\u3068 \u601D\u3046\u3068 \u3046\u308C\u3057\u304F\u306A\u308B\u3088\u3002",
    "cc_Bridge": "\u3069\u3046\u3044\u3046\u308F\u3051\u304B\u3001\u77F3\u5207\u308A\u5834\u306B\u5411\u304B\u3046\u6A4B\u304C\u4FEE\u7406\u3055\u308C\u305F\u3088\u3046\u3060\u3002#$b#\u304A\u3069\u308D\u304D\u3060\u3088\u2026\u4FEE\u7406\u306B\u306F\u591A\u304F\u306E\u4EBA\u624B\u304C\u5FC5\u8981\u3060\u3063\u305F\u306F\u305A\u3060\uFF01#$b#\u3044\u3063\u305F\u3044\u8AB0\u304C\u3069\u3046\u3084\u3063\u3066\uFF1F",
    "cc_Bus": "@\u3001\u805E\u3044\u305F\u304B\uFF1F\u53E4\u3044\u753A\u30D0\u30B9\u304C \u4E00\u6669\u306B\u3057\u3066 \u4FEE\u7406\u3055\u308C\u3066 \u52D5\u304F\u3088\u3046\u306B\u306A\u3063\u305F \u305D\u3046\u3058\u3083\uFF01$h#$b#\u3042\u308C\u306F\u3082\u3046 \u4F55\u5341\u5E74\u3082 \u52D5\u304B\u306A\u304B\u3063\u305F\u306E\u306B\u2026\u4E0D\u601D\u8B70\u306A \u3053\u3068\u304C \u8D77\u304D\u308B\u3082\u306E\u3058\u3083\u306A\u3002",
    "cc_Complete": "\u3053\u3093\u306A\u306B\u3082 \u3053\u306E\u753A\u306E\u3053\u3068\u3092 \u8A87\u308A\u306B\u601D\u3063\u305F\u306E\u306F \u521D\u3081\u3066\u3058\u3083\u3002\u541B\u306E\u884C\u3044\u306F \u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3 \u306B\u3068\u3063\u3066 \u3068\u3066\u3082 \u5927\u304D\u306A\u3082\u306E\u3058\u3083\u3088\u3001@\u3002$h",
    "cropMatured_24": "\u304D\u306E\u3046\u306E\u591C\u3001\u51FA\u8377\u7BB1\u306B\u7ACB\u3061\u5BC4\u3063\u305F\u3089\u304D\u307F\u304C\u521D\u3081\u3066\u53CE\u7A6B\u3057\u305F\u30D1\u30FC\u30B9\u30CB\u30C3\u30D7\u3092\u898B\u3064\u3051\u305F\u3088\u3002\u304A\u3081\u3067\u3068\u3046\uFF01",
    "cropMatured_254": "%farm\u7267\u5834\u306E\u30E1\u30ED\u30F3\u306F\u672C\u5F53\u306B\u4E0A\u8CEA\u3060\uFF01$h#$b#\u304D\u307F\u306E\u304A\u3058\u3044\u3055\u3093\u304C\u597D\u304D\u3060\u3063\u305F\u4F5C\u7269\u306E\u3072\u3068\u3064\u3060\u3088\u3002",
    "cropMatured_276": "\u79C1\u306F\u30AB\u30DC\u30C1\u30E3\u3092\u898B\u308B\u3068\u79CB\u3092\u611F\u3058\u308B\u3093\u3060\u3002",
    "divorced_once": "\u96E2\u5A5A\u306E\u624B\u7D9A\u304D\u306F\u3059\u3079\u3066\u7D42\u308F\u3063\u305F\u3088\u3002\u3046\u307E\u304F\u3044\u304B\u306A\u304B\u3063\u305F\u306E\u304C\u6B8B\u5FF5\u3060\u3088\u2026",
    "divorced_twice": "\u307E\u305F\u96E2\u5A5A\u304B\u306D\uFF1F@\u2026 \u4ECA\u5F8C\u306F\u8AB0\u3068\u7D50\u5A5A\u3059\u308B\u304B\u3092\u3082\u3046\u5C11\u3057\u614E\u91CD\u306B\u6C7A\u3081\u305F\u65B9\u304C\u3044\u3044\u2026$u",
    "event_secret1": "\u3042\u308A\u304C\u3068\u3046\u3001@\u3002\u3053\u306E\u3053\u3068\u306F\u5FD8\u308C\u3093\u305E\u3002",
