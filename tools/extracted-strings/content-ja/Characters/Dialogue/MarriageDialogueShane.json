    "Bad_5": "\u306A\u3042\u3001\u304A\u308C\u306F\u3072\u3068\u308A\u306B\u306A\u308A\u305F\u3044\u3093\u3060\u3002\u5916\u306B\u51FA\u3066\u3001\u81EA\u5206\u306E\u4ED5\u4E8B\u3067\u3082\u3057\u3066\u304D\u305F\u3089\u3069\u3046\u3060\uFF1F",
