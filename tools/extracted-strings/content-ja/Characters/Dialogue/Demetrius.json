    "Resort_Bar": "\u3044\u3064\u3082\u306F\u98F2\u307E\u306A\u3044\u3093\u3060\u3051\u3069\u2026\u3044\u3064\u3082\u3068\u9055\u3063\u3066\u3001\u3053\u3053\u306F\u5357\u56FD\u306E\u5CF6\u3060\u304B\u3089\u306D\u3002\u30CF\u30CF\u30CF\u3002$h",
