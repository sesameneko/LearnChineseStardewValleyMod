    "Sun": "\u9069\u5EA6\u306B \u4F11\u61A9\u3092 \u53D6\u308B\u3053\u3068\u306F \u826F\u3044\u3053\u3068\u3060\u3088\u3002#$e#\u7267\u5834\u904B\u55B6\u306E \u4ED5\u4E8B\u3067\u306F \u96E3\u3057\u3044\u3053\u3068\u304B\u3082 \u77E5\u308C\u306A\u3044\u3051\u3069\u306D\u3002#$e#\u307E\u3042\u3001\u5C11\u306A\u304F\u3068\u3082 \u51AC\u306E\u9593\u306F \u4F5C\u7269\u306E\u4E16\u8A71\u3092\u3059\u308B \u5FC5\u8981\u304C\u306A\u3044\u304B\u3002",
    "Thu": "\u7267\u5834\u904B\u55B6\u306E \u8ABF\u5B50\u306F\u3069\u3046\u3060\u3044\uFF1F\u4ECA\u306F \u30D1\u30FC\u30B9\u30CB\u30C3\u30D7\u304C \u65EC\u3060\u3063\u305F\u304B\u306A\u3002#$e#\u6BCE\u65E5 \u5916\u306E \u690D\u7269\u306E \u4E16\u8A71\u3092\u3059\u308B\u3001 \u305D\u3093\u306A\u7A4F\u3084\u304B\u306A \u66AE\u3089\u3057\u3092 \u9001\u3063\u3066\u308B\u3093\u3060\u308D\u3046\u306D\u3002",
    "Tue": "\u3053\u306E\u8C37\u306F \u3068\u3066\u3082\u591A\u7A2E\u591A\u69D8\u306A \u751F\u614B\u7CFB\u3092 \u6301\u3063\u3066\u3044\u308B\u3088\u3046\u3060\u3002\u79C1\u304C \u3053\u3053\u3078 \u5F15\u3063\u8D8A\u3057\u305F \u7406\u7531\u306E 1\u3064\u3067\u3082\u3042\u308B\u3002",
