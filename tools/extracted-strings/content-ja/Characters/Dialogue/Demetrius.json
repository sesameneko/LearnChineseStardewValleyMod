    "eventSeen_65_memory_oneweek": "$y \u0027\u3042\u306E\u6D1E\u7A9F\u3067\u306E\u5B9F\u9A13\u306F\u9032\u3093\u3067\u308B\u304B\u3044\uFF1F\u306A\u306B\u304B\u4FA1\u5024\u304C\u3042\u308B\u3082\u306E\u306F\u5F97\u3089\u308C\u305F\u304B\u3044\uFF1F_\u306F\u3044_\u304A\u304A\uFF01\u3068\u3044\u3046\u3053\u3068\u306F\u3001\u79C1\u304C\u8003\u3048\u3066\u3044\u305F\u3088\u308A\u3082\u3044\u3044\u6761\u4EF6\u304C\u305D\u308D\u3063\u3066\u3044\u308B\u306B\u9055\u3044\u306A\u3044\u2026_\u3044\u3044\u3048_\u305D\u3046\u304B\u3001\u305F\u307E\u306B\u306F\u78BA\u8A8D\u3059\u308B\u3088\u3046\u306B\u3057\u3066\u307B\u3057\u3044\u3002\u5C0F\u3055\u306A\u3053\u3068\u304B\u3082\u3057\u308C\u306A\u3044\u304C\u3001\u306A\u306B\u304B\u53CE\u7A6B\u304C\u3042\u308B\u306F\u305A\u3060\u3002\u0027",
    "eventSeen_65_memory_twoweeks": "\u7267\u5834\u306E\u6D1E\u7A9F\u3092\u5FD8\u308C\u305A\u306B\u78BA\u8A8D\u3057\u3066\u304F\u308C\uFF01\u305D\u308D\u305D\u308D\u5F79\u306B\u7ACB\u3064\u3082\u306E\u304C\u5F97\u3089\u308C\u308B\u306F\u305A\u306A\u3093\u3060\u3002",
    "fall_Fri": "\u30DE\u30EB\u306F \u81EA\u5206\u306E\u30AC\u30B8\u30A7\u30C3\u30C8\u306B \u6CA2\u5C71\u306E\u6642\u9593\u3092 \u8CBB\u3084\u3057\u3066\u308B\u306D\u3002#$e#\u3068\u3066\u3082\u71B1\u5FC3\u3067 \u3046\u308C\u3057\u3044\u3088\u3002",
