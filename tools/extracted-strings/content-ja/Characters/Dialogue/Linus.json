    "summer_Mon4": "\u6700\u8FD1\u306B\u306A\u3063\u3066\u3001 \u4EBA\u751F\u306E \u79D8\u5BC6\u3092 \u3044\u304F\u3064\u304B \u767A\u898B\u3057\u305F\u3093\u3060\u3002#$e#\u305D\u308C\u304C \u4F55\u304B\u306F \u81EA\u5206\u3067 \u63A2\u3059\u3093\u3060\u306A\u3002",
    "summer_Sat4": "\u4ECA\u306A\u3089 \u6CA2\u3067 \u30CB\u30B8\u30DE\u30B9\u304C \u3064\u308C\u308B\u3060\u308D\u3046\u3002",
    "summer_Sun": "\u590F\u306F \u30AA\u30EC\u306B\u3068\u3063\u3066 \u4F4F\u307F\u3084\u3059\u3044 \u5B63\u7BC0\u3060\u3002\u6696\u3092\u53D6\u308B \u5FC5\u8981\u304C \u306A\u3044\u304B\u3089\u306A\u3002#$e#\u305D\u308C\u306B\u3001 \u91CE\u751F\u306E\u304F\u3060\u3082\u306E\u3082 \u305D\u3053\u3089\u3058\u3085\u3046\u3067 \u898B\u3064\u304B\u308B\u3002",
    "summer_Thu4": "\u3053\u3093\u306A \u751F\u6D3B\u3092\u3059\u308B\u306B\u306F \u30AA\u30EC\u306A\u308A\u306E \u7406\u7531\u304C \u3042\u308B\u3002#$e#\u79D8\u5BC6\u306E\u307E\u307E\u306B \u3057\u305F\u307B\u3046\u304C \u3044\u3044\u3060\u308D\u3046\u2026#$e#\u305D\u308D\u305D\u308D \u63A1\u96C6\u3057\u306B \u884C\u304F\u304B\u3002",
    "summer_Tue4": "\u82E5\u304D\u53CB\u4EBA\u3088\u3001 \u3069\u3053\u3078 \u884C\u3063\u3066\u305F\u3093\u3060\uFF1F",
    "summer_Wed6": "\u3042\u3042\u2026\u590F\u304B\u3002\u590F\u306E \u65E5\u5DEE\u3057\u306F \u7F36\u3092 \u6696\u3081\u3066\u304F\u308C\u308B\u3002#$b#\u305D\u306E\u304A\u304B\u3052\u3067\u3001 \u591C\u306F \u6696\u304B\u3044 \u98DF\u4E8B\u304C \u98DF\u3079\u3089\u308C\u305D\u3046\u3060\u3002",
    "winter_Fri4": "\u51AC\u306E\u9593\u306F \u6728\u3005\u3082 \u9759\u304B\u306B \u7720\u308B\u3002\u305D\u306E\u305B\u3044\u3067 \u5C11\u3057 \u3055\u3073\u3057\u304F\u611F\u3058\u308B\u3093\u3060\u3002#$e#\u305D\u306E\u7720\u308A\u3092 \u59A8\u3052\u308B\u3064\u3082\u308A\u306F \u306A\u3044\u304C\u306A\u3002$h",
    "winter_Mon": "\u30C6\u30F3\u30C8\u751F\u6D3B\u3092\u3059\u308B\u3068 \u3044\u304B\u306B \u5BD2\u304F\u306A\u308B\u304B \u308F\u304B\u308B\u305E\u3002$s",
    "winter_Mon4": "\u73FE\u4EE3\u7684\u306A\u66AE\u3089\u3057\u304B\u3089\u96E2\u308C\u308B\u3068\u3001\u306A\u3093\u3067\u3082\u306A\u3044\u3088\u3046\u306A\u3053\u3068\u3092\u5FC3\u304B\u3089\u697D\u3057\u3081\u308B\u3088\u3046\u306B\u306A\u308B\u2026 \u305F\u3068\u3048\u3070\u3001\u592A\u967D\u3001\u719F\u3057\u305F\u679C\u7269\u3001\u5F62\u304C\u3044\u3044\u6728\u306E\u68D2\u3092\u898B\u3064\u3051\u308B\u3053\u3068\u3060\u3002",
    "winter_Sat4": "\u6765\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3002\u4ECA\u671D\u3001 \u5C11\u3057 \u3055\u3073\u3057\u304F \u611F\u3058\u3066\u3044\u305F\u3093\u3060\u3002#$e#\u305D\u308C\u3067\u3001 \u9271\u5C71\u306E\u4E2D\u3067 \u4F55\u304B \u8208\u5473\u6DF1\u3044\u3082\u306E\u306F \u898B\u3064\u304B\u3063\u305F\u304B\uFF1F",
    "winter_Sun": "\u5730\u9762\u306E\u4E0A\u3067 \u7720\u308B\u3068 \u80CC\u4E2D\u306B \u3044\u3044\u3093\u3060\u3002#$e#\u3069\u3093\u306A\u3053\u3068\u3067\u3082 \u30DD\u30B8\u30C6\u30A3\u30D6\u306A \u5074\u9762\u3067 \u898B\u305F\u307B\u3046\u304C\u826F\u3044\u3060\u308D\u3046\u3002$h",
    "winter_Thu4": "\u51AC\u306F \u53B3\u3057\u3044 \u5B63\u7BC0\u3060\u304C\u3001 \u91E3\u308A\u3068\u63A1\u96C6\u306F \u307E\u3060 \u3067\u304D\u308B\u3060\u308D\u3046\u3002#$e#\u3082\u3057 \u52D5\u7269\u3092 \u98FC\u3063\u3066\u3044\u308B\u306A\u3089 \u5C4B\u5185\u306B \u5165\u308C\u3066\u3084\u308B\u3093\u3060\u3002",
    "winter_Tue4": "@\u3001 \u30AA\u30EC\u3092 \u907F\u3051\u305A\u306B\u3044\u3066\u304F\u308C\u3066 \u3042\u308A\u304C\u3068\u306A\u3002\u672C\u80FD\u3092 \u62BC\u3055\u3048\u8FBC\u3080\u306B\u306F\u3001 \u76F8\u5F53\u306A \u610F\u5FD7\u306E\u529B\u304C \u5FC5\u8981\u306B\u306A\u308B\u3002#$e#\u30AA\u30EC\u3060\u3063\u3066\u3001 \u4ED6\u306E \u307F\u3093\u306A\u3068 \u540C\u3058 \u4EBA\u9593\u3055\u3002\u305F\u3060 \u751F\u304D\u69D8\u304C \u9055\u3046\u3060\u3051\u3060\u3002",
    "winter_Wed4": "\u3069\u3046\u3057\u3066\u30AA\u30EC\u304C \u3088\u305D\u8005\u306B \u8B66\u6212\u3057\u3066\u3044\u308B\u304B\u3001 \u541B\u306A\u3089 \u308F\u304B\u308B\u3060\u308D\u3046\u3002#$e#\u307E\u3042\u3001 \u904E\u53BB\u306E\u3053\u3068\u306F \u6C34\u306B\u6D41\u305D\u3046\u3002\u541B\u3068\u306F \u53CB\u4EBA\u306B\u306A\u308C\u305F\u3068 \u601D\u3063\u3066\u3044\u308B\u305E\u3002"
  }
}