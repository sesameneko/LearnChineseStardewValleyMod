  "entries": {
    "Bad_0": "\u2026 \u307E\u3060 \u611B\u3057\u3066\u304F\u308C\u3066\u308B\uFF1F$s",
    "Bad_1": "\u306F\u3041\u2026 \u305F\u3076\u3093\u3001 \u7D50\u5A5A\u3059\u308B\u306B\u306F \u65E9\u3059\u304E\u305F \u304B\u3082\u3002$s",
    "Bad_2": "\u79C1\u3068 \u4E00\u7DD2\u3067 \u307E\u3060 \u697D\u3057\u3081\u3066\u308B\uFF1F$s",
    "Bad_3": "\u4F55\u304B \u60AA\u3044\u3053\u3068\u3092 \u3057\u305F\uFF1F\u6700\u8FD1 \u69D8\u5B50\u304C \u304A\u304B\u3057\u3044\u3088\u3002$s",
    "Bad_4": "\u5916\u306E\u4E16\u754C\u306B \u4F55\u304C \u3042\u308B\u304B \u8003\u3048\u305F\u3053\u3068\u306F \u3042\u308B\uFF1F$s",
    "Bad_5": "\u524D\u306F \u3082\u3063\u3068 \u30ED\u30DE\u30F3\u30C1\u30C3\u30AF\u3060\u3063\u305F\u306E\u306B\u2026 \u3069\u3046\u3057\u305F\u306E\uFF1F$s#$e#\u4ECA\u306E\u81EA\u5206\u306F \u3042\u306E\u6642\u307B\u3069 \u82E5\u304F\u306A\u3044\u3051\u3069\u2026 \u305D\u306E\u305F\u3081\u306B\u7D50\u5A5A\u3057\u305F\u306E\u304B\u306A\uFF1F$a",
    "Bad_6": "\u4EBA\u751F\u306F \u77ED\u3044\u3057 \u4E00\u56DE\u304D\u308A\u3060\u3051\u3069\u2026 \u3053\u306E\u307E\u307E\u3067 \u672C\u5F53\u306B \u3044\u3044\u306E\uFF1F$s",
    "Bad_7": "\u4EE5\u524D\u306F \u3084\u3055\u3057\u304B\u3063\u305F\u3051\u3069\u2026 \u4ECA\u306F \u79C1\u304C\u6696\u304B\u3044 \u5915\u98DF\u3092 \u4F5C\u3063\u3066\u308B\u6642\u3060\u3051 \u6211\u6162 \u3057\u3066\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u3002$s",
    "Bad_8": "\u6700\u8FD1\u3001 \u79C1\u306B\u5BFE\u3057\u3066 \u51B7\u305F\u304F\u306A\u3044\uFF1F$s",
    "Bad_9": "\u3082\u3046\u5C11\u3057 \u3042\u306A\u305F\u306E \u305F\u3081\u306B \u4F55\u304B \u3067\u304D\u305F\u3089\u306A\u3041\u3002$s",
    "Good_0": "\u3053\u3053\u3067 \u4F4F\u3093\u3067\u3044\u308B\u3068\u3001 \u307E\u308B\u3067 \u5927\u304D\u306A \u5C71\u306E \u3066\u3063\u307A\u3093\u306B \u3044\u308B\u3088\u3046\u306A \u6C17\u5206\u3060\u308F\u3002",
    "Good_1": "\u524D\u306B\u8A00\u3063\u305F\u304B\u3057\u3089\u2026 \u3042\u306A\u305F\u3068 \u521D\u3081\u3066 \u4F1A\u3063\u305F\u6642\u3001 \u3044\u3064\u304B \u79C1\u9054\u306F \u7D50\u3070\u308C\u308B\u3068 \u601D\u3063\u3066\u305F\u3063\u3066\u3002",
    "Good_2": "\u904B\u547D\u3092 \u4FE1\u3058\u306A\u3044\u3088\u3046\u306B \u3059\u308B\u3053\u3068\u3063\u3066 \u96E3\u3057\u3044 \u6642\u3082 \u3042\u308B\u308F\u2026 \u3053\u3053\u3078 \u5F15\u3063\u8D8A\u3059\u3053\u3068\u3092 \u6C7A\u3081\u305F\u304B\u3089\u3001 \u3042\u306A\u305F\u3068 \u4F1A\u3048\u305F\u3002#$b#\u3069\u3053\u304B\u3067 \u307E\u3063\u305F\u304F \u9055\u3046 \u7D50\u679C\u306B\u3082 \u306A\u308A\u5F97\u305F\u306E\u3088\u306D\u3002",
    "Good_3": "\u4ECA\u65E5\u306F \u3068\u3066\u3082 \u5143\u6C17\u304C \u3042\u3075\u308C\u3066\u308B\u307F\u305F\u3044\u306D\uFF01$l^\u4ECA\u65E5\u306F \u3068\u3066\u3082 \u7F8E\u3057\u3044\u308F\u306D\u3002$l",
    "Good_4": "\u3093\u2026\u4ECA\u65E5\u306E \u3042\u306A\u305F\u3001 \u3044\u3044\u5302\u3044\u306D\u3002",
    "Good_5": "\u7D50\u5A5A\u5F0F\u306B \u3082\u3089\u3063\u305F \u9996\u98FE\u308A\u304C \u7F8E\u3057\u3044\u306D\u2026\u3053\u308C\u304B\u3089\u3082 \u305A\u3063\u3068 \u3053\u306E \u5B9D\u7269\u3092 \u5927\u5207\u306B\u3059\u308B\u308F\u3002$l",
    "Good_6": "\u5916\u3067\u306F \u6C17\u3092\u3064\u3051\u308B\u3093\u3060\u3088\uFF01\u6642\u3005\u3001 \u9271\u5C71\u3067 \u30B1\u30AC\u3057\u306A\u3044\u304B\u3068 \u5FC3\u914D\u306B \u306A\u308B\u3093\u3060\u3002",
    "Good_7": "@\u3055\u3093\u304B\u3002\u541B\u304C \u5BB6\u306E\u305F\u3081\u306B \u5C3D\u304F\u3057\u3066\u304F\u308C\u3066\u3044\u308B\u3053\u3068\u306B\u3001 \u672C\u5F53\u306B \u611F\u8B1D\u3057\u305F\u3044\u3093\u3060\u3002$h",
    "Good_8": "\u81EA\u5206\u306E\u3053\u3068\u306F \u5FC3\u914D\u3057\u306A\u3044\u3067\u2026\u3042\u306A\u305F\u306F \u5BB6\u306E\u5916\u3067 \u3044\u308D\u3093\u306A \u8CAC\u4EFB\u3092 \u8CA0\u3063\u3066\u308B\u304B\u3089\u3002\u3060\u304B\u3089 \u3053\u3063\u3061\u306F \u5927\u4E08\u592B\u3055\u3002$l",
    "Good_9": "\u5168\u304F \u98FD\u304D\u3066\u3082\u3044\u306A\u3044\u3088\u2026\u3053\u3053\u306B\u3042\u308B \u3082\u306E\u3067 \u5341\u5206 \u697D\u3057\u3081\u3066\u308B\u3002#$e#\u30B7\u30F3\u30D7\u30EB\u306A \u751F\u6D3B\u3060\u3051\u3069 \u597D\u304D\u3060\u3088\u3002$h",
    "Indoor_Day_0": "\u79C1\u304C \u6614 \u4F4F\u3093\u3067\u3044\u305F \u3068\u3053\u308D\u3088\u308A \u305A\u3063\u3068 \u3044\u3044\u5BB6\u306D\uFF01\u3042\u306E\u5834\u6240\u306B \u672A\u7DF4\u306F \u306A\u3044\u308F\u3002",
    "Indoor_Day_1": "\u304A\u306F\u3088\u3046\u3001@\u3002\u5916\u3067 \u3053\u308C\u3092 \u9262\u306B \u690D\u3048\u3066\u307F\u305F\u306E\u2026[16 18 20 22 90 259 396 402]#$e#\u79C1\u304C \u4E39\u7CBE\u3053\u3081\u3066 \u80B2\u3066\u305F\u306E\u3088\u3002\u697D\u3057\u3093\u3067\u306D\u3002",
    "Indoor_Day_2": "\u3044\u3064\u3082 \u76EE\u3092 \u3053\u3089\u3057\u3066\u3001 \u91CE\u751F\u306E \u690D\u7269\u3092 \u63A2\u3057\u3066\u307F\u3066\u306D\uFF01\u305D\u3053\u3089\u3058\u3085\u3046\u306B \u3042\u308B\u304B\u3089\u3002",
    "Indoor_Day_3": "\u3053\u3046 \u601D\u3063\u305F\u306E\u2026 \u4E0D\u5065\u5EB7\u306A \u98DF\u4E8B\u3092 \u3057\u3088\u3046\u306B\u3082 \u4EBA\u306F\u77ED\u547D \u3059\u304E\u308B\u3063\u3066\u3002\u3067\u3082\u3001 \u79C1\u9054\u306F \u65B0\u9BAE\u306A \u91CE\u83DC\u304C \u3068\u308C\u308B \u6700\u9AD8\u306E\u5834\u6240\u306B \u4F4F\u3093\u3067\u308B\u306E\u3088\u306D\uFF01#$e#\u307B\u3089\u3001 \u30D8\u30EB\u30B7\u30FC\u306A \u30B5\u30E9\u30C0\u3092 \u4F5C\u3063\u305F\u308F\u3002[196]#$e#\u307E\u3060 \u79C1\u306E \u30B5\u30E9\u30C0\u306B \u98FD\u304D\u3066\u3044\u306A\u3044\u3060\u306A\u3093\u3066 \u9A5A\u304D\u3060\u308F\uFF01",
    "Indoor_Day_4": "\u304A\u306F\u3088\u3046\u3001@\uFF01\u30B3\u30FC\u30D2\u30FC\u3092 \u4F5C\u3063\u305F\u308F\u3088\u3002[395]$h#$e#\u6E29\u304B\u3044 \u30B3\u30FC\u30D2\u30FC\u3092 \u4E00\u676F \u98F2\u307E\u306A\u3044\u3068\u3001 \u30AB\u30F3\u30DA\u30AD\u306A \u671D\u3068\u306F \u8A00\u3048\u306A\u3044\u308F\u306D\u3002",
    "Indoor_Night_0": "\u591C\u306E \u3053\u306E\u6642\u9593\u5E2F\u3063\u3066\u3001 \u306A\u3093\u3060\u304B \u5589\u304C \u304B\u308F\u304F\u306E\u3002",
    "Indoor_Night_1": "\u6642\u9593\u306E\u6D41\u308C\u306F \u3068\u3066\u3082 \u5FAE\u7D30\u3067\u2026 \u3069\u308C\u3060\u3051 \u5C0F\u3055\u306A \u9078\u629E\u3067\u3082 \u672A\u6765\u3092 \u5909\u3048\u3066\u3057\u307E\u3046\u306E\u3088\u3002",
    "Indoor_Night_2": "\u3053\u3053\u3067\u306E \u591C\u306F\u3001 \u90FD\u4F1A\u306E \u30AE\u30E9\u30AE\u30E9\u3057\u305F \u591C\u666F\u3088\u308A\u3082 \u305A\u3063\u3068 \u826F\u3044\u308F\u306D\u3002#$e#\u4F55\u3082\u304B\u3082\u3001 \u79C1\u306B\u3068\u3063\u3066 \u30AB\u30F3\u30DA\u30AD\u306A \u611F\u3058\u3088\u3002\u307B\u3093\u3068\u3001 \u79C1\u306F \u904B\u304C\u3044\u3044\u308F\u3002",
    "Indoor_Night_3": "\u3053\u306E\u753A\u3078 \u5F15\u3063\u8D8A\u3057\u3066 \u3053\u3093\u306A\u306B \u65E9\u304F\u3001 \u4EBA\u9B5A\u306E \u30DA\u30F3\u30C0\u30F3\u30C8\u3092 \u53D7\u3051\u53D6\u308B\u306A\u3093\u3066 \u601D\u308F\u306A\u304B\u3063\u305F\u308F\uFF01\u53D7\u3051\u53D6\u3063\u305F\u306E\u306F \u3046\u308C\u3057\u3044\u3051\u3069\u3002$l",
    "Indoor_Night_4": "\u4ECA\u65E5\u306F\u3000\u91CE\u751F\u306E \u30A6\u30B5\u30AE\u3092 \u898B\u305F\u306E\u3002\u3044\u3064\u304B \u4E00\u5339 \u98FC\u3044\u305F\u3044\u308F\u3002\u3060\u3063\u3066 \u3042\u306E \u30D5\u30EF\u30D5\u30EF\u304C\u306D\u2026 ",
    "Neutral_0": "\u3042\u306A\u305F\u304C \u5E74\u3092\u53D6\u3063\u3066\u3082\u3001 \u305A\u3063\u3068 \u597D\u304D\u3067 \u3044\u3066\u304F\u308C\u308B\u3088\u306D\u3002",
    "Neutral_1": "\u79C1\u9054\u306E\u524D\u306B\u306F\u3001 \u3060\u308C\u304C \u3053\u3053\u306B \u4F4F\u3093\u3067\u305F\u306E\u304B\u3057\u3089\u306D\u3002",
    "Neutral_2": "\u3042\u306A\u305F\u3001 \u4ECA\u65E5\u306F \u3084\u308B\u3053\u3068\u304C \u3042\u308B\u304B\u3057\u3089\uFF1F",
    "Neutral_3": "\u3082\u3057 \u753A\u3078 \u884C\u3063\u305F\u3089\u3001 \u79C1\u306E \u4EE3\u308F\u308A\u306B \u307F\u3093\u306A\u3068 \u3042\u3044\u3055\u3064 \u3057\u3066\u304F\u308C\u308B\u304B\u306A\u3002",
    "Neutral_4": "\u660E\u65E5\u3001 \u3042\u306A\u305F\u304C \u8D77\u304D\u308B\u524D\u306B \u6D17\u6FEF\u3092 \u3059\u308B\u308F\u306D\u2026 \u305D\u3046\u3059\u308C\u3070 \u52B9\u7387\u304C \u3044\u3044\u304B\u3089\u3002",
    "Neutral_5": "@\u3001\u304A\u91D1\u306B\u306F \u56F0\u3063\u3066\u306A\u3044\uFF1F",
    "Neutral_6": "\u753A\u306E \u307F\u3093\u306A\u306F \u4ECA\u65E5 \u4F55\u3092 \u3057\u3066\u308B\u306E\u304B\u306A\u3002",
    "Neutral_7": "\u4ECA\u65E5\u306F \u672C\u5F53\u306B \u4F55\u3082\u3057\u305F\u304F\u306A\u3044 \u6C17\u5206\u3060\u308F\u3002",
    "Neutral_8": "\u3069\u308C\u3060\u3051 \u304C\u3093\u3070\u3063\u3066 \u30AD\u30EC\u30A4\u306B\u3057\u3066\u3082\u3001 \u5BB6\u304C \u3059\u3050\u306B \u6C5A\u308C\u3061\u3083\u3046\u3002#$e#\u7267\u5834\u3063\u3066 \u305D\u3046\u3044\u3046\u3082\u306E\u304B\u306A\u3002",
    "Neutral_9": "\u305A\u3063\u3068 \u3053\u306E\u307E\u307E \u3053\u3053\u3067 \u66AE\u3089\u305B\u308B\u304B\u306A\uFF1F",
    "OneKid_3": "\u89AA\u306B \u306A\u308B\u306E\u3063\u3066 \u697D\u3057\u3044\u308F\u306D\u3002%kid1 \u304C \u81EA\u7136\u3092 \u611B\u3059\u308B\u5B50\u306B \u306A\u308B\u3088\u3046\u3001 \u3057\u3063\u304B\u308A \u80B2\u3066\u305F\u3044\u308F\u3002",
    "Outdoor_0": "\u98A8\u304C \u6DBC\u3057\u304F\u3066 \u6C17\u6301\u3061\u3044\u3044\u3002\u5DDD\u306E \u305D\u3070\u3067\u306E \u751F\u6D3B\u3092 \u601D\u3044\u51FA\u3059\u308F\u3002",
    "Outdoor_1": "\u3046\u30FC\u3093\u2026\u3061\u3087\u3046\u3069 \u3053\u306E\u8FBA\u3092 \u6574\u5099\u3057\u3088\u3046\u3068 \u3057\u3066\u305F\u306E\u3002\u6642\u3005\u3001 \u4F55\u304B\u3092 \u30CF\u30F3\u30DE\u30FC\u3067 \u6253\u3061\u305F\u304F\u306A\u308B\u885D\u52D5\u304C \u3042\u3063\u3066\u306D\u3002",
    "Outdoor_2": "\u4ECA\u65E5\u306F \u7279\u5225\u306A\u65E5\u306B \u306A\u308A\u305D\u3046\u306D\u3002 \u305D\u3046 \u611F\u3058\u308B\u308F\u3002",
    "Outdoor_3": "\u3042\u3042\u2026 \u65B0\u9BAE\u306A \u571F\u306E\u5302\u3044\u3002\u3059\u3054\u304F \u3044\u3044 \u5302\u3044\u3060\u308F\u3002$h#$e#\u3053\u3053\u306E \u7A7A\u6C17\u306F \u3059\u3054\u304F \u30AD\u30EC\u30A4\u3067\u2026 \u4F53\u306B \u3044\u3044 \u611F\u3058\u304C \u3059\u308B\u308F\u306D\u3002",
    "Outdoor_4": "\u3042\u307E\u308A \u50CD\u304D\u3059\u304E\u306A\u3044\u3067\u306D\u3002#$e#\u3061\u3083\u3093\u3068\u3001 \u5B9A\u671F\u7684\u306A \u4F11\u606F\u3084 \u98DF\u4E8B\u3092 \u53D6\u308B\u3088\u3046\u306B \u3059\u308B\u3093\u3060\u3088\u3002$h",
    "Rainy_Day_0": "\u6642\u3005\u3001 \u601D\u3044\u304C\u3051\u306A\u3044\u5834\u6240\u304B\u3089 \u7740\u60F3\u3092 \u5F97\u3089\u308C\u308B\u306E\u3088\u3002",
    "Rainy_Day_1": "\u90FD\u4F1A\u306B \u4F4F\u3093\u3067\u3044\u305F \u9803\u3001 \u96E8\u306F \u6C17\u304C \u91CD\u304F\u306A\u308B\u3063\u3066 \u601D\u3063\u3066\u305F\u306E\u3002\u3067\u3082 \u30B9\u30BF\u30FC\u30C7\u30E5\u30FC \u30D0\u30EC\u30FC\u3058\u3083\u3001 \u96E8\u304C \u7F8E\u3057\u304F \u898B\u3048\u308B\u308F\u3002",
    "Rainy_Day_2": "\u304A\u306F\u3088\u3046\uFF01\u65E9\u304F\u306B \u8D77\u304D\u3066\u3001 \u30AD\u30CE\u30B3\u72E9\u308A\u3092 \u3057\u3066\u305F\u308F\u3002\u307B\u3089\u3001 \u3072\u3068\u3064 \u3042\u3052\u308B\u3002[281 404 420 257]#$e#\u30AD\u30CE\u30B3\u72E9\u308A\u3063\u3066\u3001 \u307E\u308B\u3067 \u5B9D\u63A2\u3057\u307F\u305F\u3044\u306A \u3082\u306E\u306D\u3002\u3059\u3054\u304F \u697D\u3057\u3044\u308F\u3088\u3002$h",
    "Rainy_Day_3": "\u3053\u3046\u3044\u3046 \u65E5\u306F \u4F5C\u696D\u7528 \u30D6\u30FC\u30C4\u3092 \u5C65\u3044\u3066\u3066 \u826F\u304B\u3063\u305F\u3063\u3066 \u601D\u3046\u3002$h",
    "Rainy_Day_4": "\u6728\u3005\u3082 \u3053\u306E \u96E8\u3092 \u307B\u3057\u304C\u3063\u3066\u305F\u3093\u3067\u3057\u3087\u3046\u306D\u2026\u79C1\u3082 \u3046\u308C\u3057\u304F \u611F\u3058\u308B\u308F\u3002",
    "Rainy_Night_0": "\u3042\u306A\u305F\u306E \u4E00\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\uFF1F\u5916\u3067 \u3069\u3093\u306A \u52D5\u7269\u3092 \u898B\u3066\u304D\u305F\u306E\uFF1F",
    "Rainy_Night_1": "\u666E\u6BB5\u306F \u30B5\u30E9\u30C0\u3092 \u98DF\u3079\u308B\u3051\u3069\u2026 \u3053\u3046\u3044\u3046 \u6FE1\u308C\u305F \u591C\u306F \u6696\u304B\u3044 \u30B9\u30FC\u30D7\u304C \u307B\u3057\u304F\u306A\u308B\u308F\u3002$h",
    "Rainy_Night_2": "\u3053\u3093\u306A\u591C\u306F \u843D\u3061\u7740\u3044\u3066 \u7720\u308A\u306B \u3064\u3051\u305D\u3046\u306D\u2026$l",
    "Rainy_Night_3": "\u4ECA\u65E5\u306F \u5C11\u3057 \u6728\u5F6B\u308A\u3092 \u3084\u3063\u3066\u307F\u305F\u3051\u3069\u3001 \u51FA\u6765\u304C \u3072\u3069\u304B\u3063\u305F\u304B\u3089 \u71C3\u3084\u3057\u305F\u308F\u3002$u#$e#\u5049\u5927\u306A \u82B8\u8853\u5BB6\u306B \u306A\u308B\u306B\u306F\u3001 \u81EA\u5206\u306E \u4F5C\u54C1\u306B\u3082 \u53B3\u3057\u304F \u8A55\u4FA1\u3057\u306A\u3044\u3068\u3002",
    "Rainy_Night_4": "\u5BB6\u306B \u3044\u3066\u304F\u308C\u3066 \u3046\u308C\u3057\u3044\u2026\u5C4B\u5185\u3067 \u3057\u3063\u304B\u308A\u4F53\u3092 \u6696\u3081\u308B\u306B\u306F \u826F\u3044\u591C \u306D\u3002",
    "Rainy_Night_Leah": "\u4ECA\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\u304B\u3057\u3089\uFF1F\u3042\u3093\u307E\u308A \u3088\u304F\u306A\u304B\u3063\u305F\uFF1F",
    "TwoKids_3": "\u3059\u3070\u3089\u3057\u3044 \u7267\u5834\u3068 \u5B8C\u5168\u306A \u5BB6\u65CF\u3002\u79C1\u9054\u306E \u65B0\u751F\u6D3B\u3082\u3001 \u3044\u3044\u611F\u3058\u306B \u306A\u3063\u305F\u3088\u306D\uFF1F",
    "fall_1": "\u79CB\u306F \u30AD\u30CE\u30B3\u72E9\u308A\u306E \u6A5F\u4F1A\u304C \u3042\u308B\u304B\u3089 \u5927\u597D\u304D\u3088\u3002\u3042\u3063\u3068\u3044\u3046\u9593\u306B \u7D42\u308F\u3063\u3061\u3083\u3046\u3051\u3069\u3002",
    "fall_2": "\u53CE\u7A6B\u306E \u5B63\u7BC0\u306F \u5FD9\u3057\u304F \u306A\u308A\u305D\u3046\u306D\u3002\u79C1\u3082 \u3067\u304D\u308B\u3060\u3051 \u3042\u306A\u305F\u3092 \u624B\u4F1D\u3046\u308F\u3002",
    "fall_20": "\u51AC\u306F \u3069\u3093\u306A \u4E88\u5B9A\u3092 \u7ACB\u3066\u3066\u308B\u306E\uFF1F\u308F\u3089\u306E \u5099\u84C4\u3092 \u7528\u610F\u3057\u3066\u304A\u304F\u3068 \u3044\u3044\u308F\u3088\u3002",
    "funLeave_Leah": "\u4ECA\u65E5\u306F \u81EA\u7136\u3092 \u6563\u6B69\u3057\u3088\u3046\u3068 \u601D\u3046\u306E\u3002\u5BB6\u306E\u5916\u3078 \u51FA\u3066 \u6B69\u304B\u306A\u304D\u3083\u306D\u3002",
    "funReturn_Leah": "\u4ECA\u65E5\u306F \u843D\u3061\u7740\u3044\u305F\u3001 \u826F\u3044 \u4E00\u65E5\u3060\u3063\u305F\u308F\u3002\u3042\u306A\u305F\u306E \u4E00\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\uFF1F",
    "patio_Leah": "\u305D\u3093\u306A\u30B8\u30ED\u30B8\u30ED\u898B\u306A\u3044\u3067\u3088\u3001\u307E\u3060\u5236\u4F5C\u306E\u3068\u3061\u3085\u3046\u306A\u3093\u3060\u3002",
    "spring_1": "\u4F55\u3068\u304B \u5927\u6666\u65E5\u3092 \u7D42\u3048\u3066\u3001 \u65B0\u5E74\u3092 \u8FCE\u3048\u3089\u308C\u305F\u308F\u306D\u2026 $l",
    "spring_15": "\u306F\u3041\u2026 \u307E\u305F \u300C\u6625\u306E\u5927\u6383\u9664\u300D\u306E \u5B63\u7BC0\u304C \u3084\u3063\u3066\u304D\u305F\u308F\u3002$s",
    "spring_2": "\u3053\u306E \u5B63\u7BC0\u306F \u4F55\u3092 \u690D\u3048\u308B\u306E\uFF1F",
    "summer_1": "\u3042\u3042\u3001\u590F\u306D\u2026\u3082\u3046 \u30B9\u30D1\u30A4\u30B9\u30D9\u30EA\u30FC\u306E \u5302\u3044\u304C \u3059\u308B\u308F\u306D\u3002$h",
    "summer_2": "\u590F\u2026 \u30CF\u30A8\u304C \u51FA\u3066\u304F\u308B\u5B63\u7BC0\u3063\u3066\u3053\u3068\u3060\u306D\u3002#$e#\u5927\u4E08\u592B\u3001 \u9000\u6CBB\u3057\u3066\u3042\u3052\u308B\u304B\u3089\u3002",
    "summer_9": "\u3082\u3057 \u30D9\u30C8\u30D9\u30C8\u3060\u3063\u305F\u3089 \u3054\u3081\u3093\u306D\u2026\u6691\u304F\u3066 \u6C57 \u304B\u304D\u3063\u3071\u306A\u3057 \u3060\u3063\u305F\u304B\u3089\u3055\u3002",
    "winter_1": "\u51AC\u304C \u304D\u305F\u308F\u306D\u3002 \u30AF\u30EA\u30B9\u30BF\u30EB\u30D5\u30EB\u30FC\u30C4\u306E \u30B7\u30FC\u30BA\u30F3\u3067\u3082 \u3042\u308B\u306E\u3088\u3002\u30AF\u30EA\u30B9\u30BF\u30EB\u30D5\u30EB\u30FC\u30C4\u306E \u5473\u306F \u30E6\u30CB\u30FC\u30AF\u3060\u3068 \u601D\u308F\u306A\u3044\uFF1F",
    "winter_28": "\u6765\u5E74\u306E %farm \u7267\u5834\u3082 \u3059\u3070\u3089\u3057\u3044 \u5E74\u306B \u306A\u308B\u3053\u3068\u3092 \u7948\u3063\u3066 \u4E7E\u676F\uFF01\u4ECA\u591C\u306F \u697D\u3057\u307F\u307E\u3057\u3087\u3046\uFF01[348]$h#$e#\u6765\u5E74\u306F \u826F\u3044\u5E74\u306B\u306A\u308B\u308F\u3002 \u9593\u9055\u3044\u306A\u3044\u3002",
    "winter_7": "\u660E\u65E5\u306E \u6C37\u7D30\u5DE5\u306B \u3059\u3054\u304F \u671F\u5F85\u3057\u3066\u308B\u308F\u3002\u5E74\u306B1\u56DE\u3057\u304B \u3067\u304D\u306A\u3044\u3051\u3069\u3001 \u3059\u3054\u304F \u697D\u3057\u3044\u304B\u3089\uFF01"
  }
}