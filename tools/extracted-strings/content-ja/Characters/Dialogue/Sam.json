    "10": "\u6628\u6669\u306E \u8A66\u5408\u306F \u898B\u305F\u304B\uFF1F#$b#\u305D\u3082\u305D\u3082\u3001 \u304A\u524D\u306E \u5BB6\u306B \u30C6\u30EC\u30D3\u306F \u3042\u3063\u305F\u3063\u3051\uFF1F",
    "14": "\u3046\u308F\u3063\u3001 \u3055\u3063\u304D \u8CB7\u3063\u305F \u3070\u304B\u308A\u306E \u9774\u306A\u306E\u306B\u2026 \u30B0\u30ED\u3044 \u3082\u306E\u3092 \u8E0F\u3093\u3058\u307E\u3063\u305F\u3002$s",
    "AcceptBirthdayGift_Negative": "\u304A\u3044\u304A\u3044\uFF01\u899A\u3048\u3066\u2026$h#$b#\u2026\uFF08\u30AF\u30F3\u30AF\u30F3\uFF09\u2026\u306A\u3093\u3060\u3053\u306E\u306B\u304A\u3044\u2026\uFF1F$8#$b#\u2026\u3046\u308F\u3063$5",
    "AcceptBirthdayGift_Positive": "\u304A\u3044\u304A\u3044\uFF01\u899A\u3048\u3066\u3066\u304F\u308C\u305F\u3093\u3060\u306A\uFF01\u305D\u3046\u3053\u306A\u304F\u3063\u3061\u3083\uFF01$h",
    "AcceptGift_(O)206": "\u304A\u3063\u3001\u3044\u3044\u306D\u2026\u30D4\u30B6\u3067\u3082\u98DF\u304A\u3046\u305C\uFF01$h",
    "AcceptGift_(O)StardropTea": "\u304A\u3063\u3068\u2026\u30DE\u30B8\u304B\u3088\u2026 \u3053\u308C\u3092\u30AA\u30EC\u306B\uFF1F\u601D\u3063\u3066\u3082\u307F\u306A\u304B\u3063\u305F\u305C\uFF01\u3042\u308A\u304C\u3068\u3088\uFF01 ",
    "Event_band1": "\u3048\u3063\u3001 \u306A\u3093\u3060\u3063\u3066\uFF1F\u305D\u308C\u3063\u3066 \u307E\u3055\u306B \u30AA\u30EC\u304C \u305A\u3063\u3068 \u8003\u3048\u3066\u305F\u2026 \u30D0\u30F3\u30C9\u306E \u30B9\u30BF\u30A4\u30EB\u3058\u3083\u3093\u3002",
    "Event_band2": "\u3048\u3063\u3001 \u306A\u3093\u3060\u3063\u3066\uFF1F\u305D\u308C\u3063\u3066 \u307E\u3055\u306B \u30AA\u30EC\u304C \u305A\u3063\u3068 \u8003\u3048\u3066\u305F\u2026 \u30D0\u30F3\u30C9\u306E \u30B9\u30BF\u30A4\u30EB\u3058\u3083\u3093\u3002",
    "Event_band3": "\u3048\u3063\u3001 \u306A\u3093\u3060\u3063\u3066\uFF1F\u305D\u308C\u3063\u3066 \u307E\u3055\u306B \u30AA\u30EC\u304C \u305A\u3063\u3068 \u8003\u3048\u3066\u305F\u2026 \u30D0\u30F3\u30C9\u306E \u30B9\u30BF\u30A4\u30EB\u3058\u3083\u3093\u3002",
    "Event_band4": "\u3048\u3063\u3001 \u306A\u3093\u3060\u3063\u3066\uFF1F\u305D\u308C\u3063\u3066 \u307E\u3055\u306B \u30AA\u30EC\u304C \u305A\u3063\u3068 \u8003\u3048\u3066\u305F\u2026 \u30D0\u30F3\u30C9\u306E \u30B9\u30BF\u30A4\u30EB\u3058\u3083\u3093\u3002",
    "FlowerDance_Accept": "\u3048\u2026 \u304A\u308C\u3068\uFF1F\u3078\u3078\u2026\u3042\u3042\u3001\u3082\u3061\u308D\u3093\u3055\u3002\u697D\u3057\u304F\u306A\u308A\u305D\u3046\u3060\uFF01$10",
    "FlowerDance_Accept_Spouse": "\u3042\u30FC\u3001 \u3042\u306E\u30C0\u30B5\u3044\u30B9\u30FC\u30C4\u3092 \u304D\u306A\u304D\u3083 \u306A\u3089\u306D\u3048\u306E\u304B\uFF1F \u7D50\u5A5A\u3057\u305F\u3093\u3060\u304B\u3089 \u305D\u3093\u306A\u306E\u2026 \u307E\u3041\u3001 \u3044\u3044\u304B\u3002$s",
    "FlowerDance_Decline": "\u3046\u30FC\u3093\u2026\u30AA\u30EC\u306B\u306F\u308F\u304B\u3089\u3093\u3002\u6765\u5E74\u306B \u3059\u308B\u304B\u306A\u3002$s",
    "Fri": "\u6614 \u90FD\u4F1A\u306B \u4F4F\u3093\u3067\u3044\u305F \u3053\u3068\u3001 \u8A71\u3057\u305F\u304B\uFF1F#$e#\u3053\u3053\u3068 \u6BD4\u3079\u3066 \u8272\u3005\u3068 \u6D3B\u767A\u3060\u304C\u3001 \u305D\u306E\u5206 \u9A12\u304C\u3057\u304F\u3066 \u305B\u308F\u3057\u306A\u3044 \u3068\u3053\u308D\u3067\u306A\u2026\u3069\u3063\u3061\u304C \u3044\u3044\u304B\u306F \u65AD\u8A00 \u3067\u304D\u306A\u3044\u306D\u3002",
    "Fri10": "\u6210\u9577\u3059\u308B\u306B \u3064\u308C\u3066\u3001 \u3053\u306E\u753A\u306B \u611B\u7740\u304C \u5897\u3057\u3066\u304D\u305F\u306A\u3002#$b#\u305D\u306E \u611B\u7740\u3082\u2026 \u504F\u3063\u3066\u308B \u304B\u3082 \u3057\u308C\u306A\u3044\u3051\u3069\u306A\u3002$10#$e#\u305D\u308C\u3067\u3001 \u4ECA\u65E5\u306E \u8ABF\u5B50\u306F \u3069\u3046\u3060\uFF1F$h",
    "Fri4": "\u30AA\u30E4\u30B8\u306F \u90FD\u4F1A\u3067 \u30B4\u30DF\u53CE\u96C6\u4EBA\u3092 \u3084\u3063\u3066\u3044\u305F\u3002#$e#\u30AA\u30E4\u30B8\u304C \u3069\u3093\u306A \u30B4\u30DF\u3092 \u76EE\u306B\u3057\u305F\u304B\u3001 \u304A\u524D\u306F \u77E5\u308A\u305F\u304F\u3082 \u306A\u3044\u3060\u308D\u3046\u306A\u3002",
    "GreenRain": "\u306A\u3001\u306A\u3093\u3060\uFF01\u9178\u306E\u96E8\u304B\uFF1F\u5C4B\u6839\u3092\u30C9\u30ED\u30C9\u30ED\u306B\u3057\u3066\u3001\u30AA\u30EC\u305F\u3061\u3092\u751F\u304D\u305F\u307E\u307E\u6EB6\u304B\u305D\u3046\u3063\u3066\u306E\u304B\uFF1F$8#$b#\u30AA\u30EC\u304C\u5F1F\u3092\u5B88\u3089\u306A\u3044\u3068\uFF01$7",
    "GreenRainFinished": "\u306A\u306B\u3082\u88AB\u5BB3\u306F\u306A\u3055\u305D\u3046\u3060\u306A\u2026\u30D8\u30F3\u306A\u3053\u3068\u3082\u3042\u308B\u3082\u3093\u3060\u3002\u305D\u3063\u3061\u306F\u306A\u306B\u304B\u3042\u3063\u305F\u304B\uFF1F",
    "GreenRain_2": "\u3053\u306E\u96E8\u306F\u6E29\u304B\u3044\u3088\u306A\u3002\u306A\u3093\u304B\u751F\u304D\u3066\u308B\u3063\u3066\u611F\u3058\u304C\u3059\u308B\u3088\u2026",
    "Introduction": "\u3088\u3049\u3001 \u30AA\u30EC\u306F\u30B5\u30E0\u3002\u3088\u308D\u3057\u304F\u306A\u3002$h",
    "Mon": "\u3088\u3049\u3001 \u7267\u5834\u4E3B\u3002",
    "Mon2": "\u3088\u3049\u3001 \u8ABF\u5B50\u306F \u3069\u3046\u3060\uFF1F#$e#\u30AA\u30EC\u306F \u6628\u6669\u3001 4\u6642\u9593 \u3076\u3063\u901A\u3057\u3067 \u30AE\u30BF\u30FC\u306E \u7DF4\u7FD2\u3092 \u3057\u3066\u305F\u3093\u3060\u3002\u304A\u304B\u3052\u3067 \u6307\u304C \u75DB\u304F\u3066 \u305F\u307E\u3093\u306D\u3048\u3002$s#$e#\u3058\u3083\u3042\u306A\u3001 \u3084\u308B\u3053\u3068\u304C \u3042\u308B\u3093\u3060\u2026",
    "Mon8": "\u3053\u3053\u3060\u3051\u306E \u8A71\u3060\u304C\u2026 \u30AA\u30EC\u306E\u672C\u540D\u306F \u30B5\u30E0\u30BD\u30F3\u3067\u3001 \u30B5\u30E0\u306F \u7565\u79F0\u306A\u3093\u3060\u3088\u3002$10#$e#\u3067\u3082 \u8AB0\u3082 \u77E5\u3089\u306A\u3044\u304B\u3089 \u8A00\u308F\u306A\u3044\u3060\u3051\u3055\u3002",
    "Resort": "\u5CF6\u306E\u5965\u306B\u306F\u4F55\u304B\u30A4\u30A4\u30E2\u30CE\u304C\u3042\u308B\u306F\u305A\u3060\u3002#$e#\u30AA\u30EC\u305F\u3061\u306F\u3053\u3053\u306B\u6B8B\u308C\u3063\u3066\u30A6\u30A3\u30EA\u30FC\u304C\u8A00\u3063\u3066\u305F\u3051\u3069\u2026\u305F\u3076\u3093\u8CAC\u4EFB\u554F\u984C\u3068\u304B\u305D\u306E\u3078\u3093\u3060\u308D\u3046\u3002$s",
    "Resort_Bar": "\u9154\u3063\u6255\u3063\u3061\u307E\u3063\u305F\u3057\u3001\u30D3\u30FC\u30C1\u306B\u623B\u308B\u304B\u306A\u3002",
    "Resort_Entering": "\u30EF\u30A9\u3001\u306A\u3093\u3066\u5834\u6240\u3060\uFF01",
    "Resort_Leaving": "\u592A\u967D\u3092\u5168\u8EAB\u306B\u6D74\u3073\u308B\u3063\u3066\u306E\u306F\u6C17\u6301\u3061\u304C\u3044\u3044\u3082\u3093\u3060\u306A\u3002$h",
    "Resort_Shore": "\u3053\u306E\u5384\u4ECB\u306A\u6CE2\u3092\u3088\u304F\u899A\u3048\u3068\u3053\u3046\u2026\u306A\u305C\u304B\u3063\u3066\uFF1F\u30B5\u30FC\u30D5\u30DC\u30FC\u30C9\u306E\u305F\u3081\u306B\u91D1\u3092\u8CAF\u3081\u308B\u306E\u3055\u3002",
    "Resort_Towel": "%\u30B5\u30E0\u306F\u30AE\u30BF\u30FC\u3067\u30B8\u30E3\u30B8\u30FC\u306A\u66F2\u3092\u5F3E\u3044\u3066\u3044\u308B\u3002",
    "Resort_Towel_2": "\u30A6\u30AF\u30EC\u30EC\u3092\u7FD2\u3063\u3066\u307F\u3088\u3046\u304B\u306A\u3002#$e#\u30A2\u30D3\u30FC\u304C\u30B3\u30F3\u30AC\u3067\u3001\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306F\u30B9\u30C1\u30FC\u30EB\u30C9\u30E9\u30E0\u2026\u300C\u30B6\u30FB\u30DA\u30EA\u30AB\u30F3\u30BA\u30FB\u30AA\u30D6\u30FB\u30D1\u30E9\u30C0\u30A4\u30B9\u300D\u304B\u306A\u2026$s#$e#\u3069\u3046\u3057\u305F\u3001\u5FC3\u914D\u305D\u3046\u306A\u9854\u3057\u3066\u3002$h",
    "Sat": "\u3075\u30FC\u3093\u3002\u4F55\u304B\u3092 \u3084\u3089\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u3053\u3068\u306F \u601D\u3044\u51FA\u3057\u305F\u304C\u2026\u305D\u306E\u4F55\u304B\u3092 \u5FD8\u308C\u305F\u3002#$e#\u3044\u3064\u3082 \u3053\u3046\u306A\u3093\u3060\u3088\u3002",
    "Sat4": "\u3042\u3063\uFF01\u3070\u3042\u3061\u3083\u3093\u3092 \u547C\u3070\u306A\u304D\u3083 \u306A\u3089\u306A\u3044\u3053\u3068\u3092 \u601D\u3044\u51FA\u3057\u305F\u3002\u624B\u9996\u306B \u3053\u306E \u30B4\u30E0\u30D0\u30F3\u30C9\u3092 \u3064\u3051\u3066\u3001 \u5FD8\u308C\u306A\u3044\u3088\u3046\u306B \u3057\u3088\u3046\u3002#$e#\u3053\u3046\u3084\u3063\u3066 \u304A\u304B\u306A\u3044\u3068\u3001 \u3059\u3050\u306B \u5FD8\u308C\u3066\u3057\u307E\u3046\u3093\u3060\u3088\u3002$h",
    "Sun": "\u4ECA\u65E5\u306F \u3044\u3044\u65E5\u3060\u306A\u2026 \u305D\u3046\u3060\u308D\uFF1F",
    "Sun8": "\u6642\u3005\u3001 \u30AA\u30D5\u30AF\u30ED\u304C \u4ECA\u306E \u4EBA\u751F\u306B \u6E80\u8DB3\u3057\u3066\u3044\u308B\u304B \u7591\u554F\u3067\u306A\u2026$s#$e#\u4E00\u5EA6 \u805E\u3044\u3066\u307F\u305F\u3051\u3069\u3001 \u306A\u3093\u304B \u5FC3\u306E \u75DB\u307F\u3092 \u96A0\u3057\u3066\u308B \u611F\u3058\u304C \u3042\u3063\u305F\u3002",
    "Thu": "\u3053\u306E\u5B63\u7BC0\u306F \u96F2\u304C \u30AD\u30EC\u30A4\u3060\u3088\u306A\u3002 \u305D\u3046\u601D\u3046\u3060\u308D\uFF1F#$e#\u307E\u308B\u3067\u3001 \u9752\u3044 \u30E9\u30BA\u30D9\u30EA\u30FC\u30BD\u30FC\u30B9\u3092 \u304B\u3051\u305F \u30D0\u30CB\u30E9\u30A2\u30A4\u30B9 \u307F\u305F\u3044\u3067\u3055\u2026\u3044\u3084\u3001 \u7A7A\u8179\u3060\u304B\u3089 \u305D\u3046 \u898B\u3048\u308B\u3060\u3051\u304B\u3002",
    "Thu2": "\u30AA\u30E4\u30B8\u306F \u5175\u58EB\u3067\u3001 \u30B4\u30C8\u30ED\u5E1D\u56FD\u3068 \u6226\u3063\u3066\u308B\u3002\u3060\u304B\u3089 \u4ECA \u30AA\u30E4\u30B8\u306F \u3053\u3053\u306B \u3044\u306A\u3044\u3093\u3060\u2026#$e#\u3044\u3064\u304B \u5E30\u3063\u3066\u304F\u308B \u306F\u305A\u3002#$e#\u2026 \u30B4\u30C8\u30ED\u5E1D\u56FD\u306B \u3064\u3044\u3066\u306F \u6050\u308D\u3057\u3044\u8A71\u3092 \u805E\u3044\u305F\u3053\u3068\u304C \u3042\u308B\u305C\u2026$s",
    "Thu2_2": "\u30AA\u30E4\u30B8\u304C \u5E30\u3063\u3066\u304D\u305F\u306A\u3002\u304A\u524D\u3082 \u4F1A\u3063\u305F\u304B\uFF1F#$b#\u7121\u4E8B\u306A\u3088\u3046\u3067 \u672C\u5F53\u306B \u4F55\u3088\u308A\u3060\u3002",
    "Thu6_1": "\u4E00\u5E74\u304B \u305D\u3053\u3089\u3067 \u30AA\u30E4\u30B8\u304C \u623B\u3063\u3066\u304D\u3066\u304F\u308C\u308B\u3068 \u601D\u3046\u3093\u3060\u3002#$e#\u305D\u3057\u305F\u3089 \u304A\u524D\u3082 \u30AA\u30E4\u30B8\u306B \u4F1A\u3048\u308B\u304B\u3082\u306A\u3002\u307E\u3060 \u3053\u306E\u753A\u306B \u3044\u308C\u3070\u306E \u8A71\u3060\u3051\u3069\u3002#$e#\u3042\u308C\u3060\u3051 \u4E39\u7CBE\u3053\u3081\u305F \u7267\u5834\u3092 \u898B\u6368\u3066\u308B\u308F\u3051\u306B\u306F \u3044\u304B\u306A\u3044\u3088\u306A\uFF01",
    "Thu6_2": "\u2026 \u30AA\u30E4\u30B8\u304C \u623B\u3063\u3066\u304D\u305F\u3053\u3068\u3067\u3001 \u3061\u3087\u3063\u3068 \u8907\u96D1\u306A \u6C17\u6301\u3061\u306B \u306A\u3063\u3066\u308B\u3093\u3060\u3002\u30AA\u30E4\u30B8\u306E \u69D8\u5B50\u304C \u5909\u3060\u304B\u3089\u306A\u3002$s#$b#\u3067\u3082 3\u5E74\u3082 \u9854\u3092 \u898B\u3066\u306A\u3044\u304B\u3089\u2026 \u305D\u308C\u304C \u539F\u56E0\u304B\u3082\u3002",
    "Thu_2": "\u30AA\u30E4\u30B8\u304C \u5E30\u3063\u3066\u304D\u305F\u306A\u3002\u304A\u524D\u3082 \u4F1A\u3063\u305F\u304B\uFF1F#$b#\u7121\u4E8B\u306A\u3088\u3046\u3067 \u672C\u5F53\u306B \u4F55\u3088\u308A\u3060\u3002",
    "Thu_3": "\u306F\u3041\u2026 \u30AA\u30EC\u306F\u3053\u3053\u3067 \u4F55\u3092 \u3084\u3063\u3066\u3044\u308B\u3093\u3060\uFF1F",
