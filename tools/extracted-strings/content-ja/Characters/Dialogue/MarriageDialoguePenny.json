  "entries": {
    "Good_0": "@\u2026 \u7D50\u5A5A\u3067\u304D\u305F\u306A\u3093\u3066 \u4ECA\u3067\u3082 \u4FE1\u3058\u304C\u305F\u3044\u3067\u3059\u2026$l",
    "Good_1": "\u3059\u3054\u304F \u524D\u304B\u3089\u3001 \u3042\u306A\u305F\u3068 \u7D50\u5A5A\u3059\u308B \u5922\u3092 \u898B\u3066\u3044\u305F\u306E\u3002$l",
    "Good_2": "\u3042\u306A\u305F\u304C \u3053\u3053\u3078 \u5F15\u3063\u8D8A\u3057\u305F\u77AC\u9593\u304B\u3089\u3001 \u904B\u547D\u306E \u51FA\u4F1A\u3044\u3060\u3068 \u601D\u3063\u3066\u305F\u308F\u2026$l",
    "Good_3": "\u304A\u304A\u3001 \u4ECA\u65E5\u306E \u541B\u306F \u672C\u5F53\u306B \u304B\u3063\u3053\u3044\u3044\u306D\uFF01\u30D2\u30B2\u3092 \u305D\u3063\u305F\u306E\uFF1F$l^\u3042\u3089\u3001 \u4ECA\u65E5\u306E \u3042\u306A\u305F\u306F \u3068\u3066\u3082 \u7F8E\u3057\u3044\u308F\u306D\u3002\u3044\u3064\u3082\u3068\u9055\u3046 \u9AEA\u306E\u30BB\u30C3\u30C8\u3067\u3082 \u3057\u305F\u306E\u304B\uFF1F$l",
    "Good_4": "\u3053\u306E \u5834\u6240\u304C \u672C\u5F53\u306B \u5FC3\u5730\u3088\u3044\u3068 \u601D\u3044\u59CB\u3081\u3066\u304D\u305F\u308F\u3002$l",
    "Good_6": "\u5916\u3067\u306F \u6C17\u3092\u3064\u3051\u308B\u3093\u3060\u3088\uFF01\u6642\u3005\u3001 \u3042\u306A\u305F\u304C \u3061\u3083\u3093\u3068 \u98DF\u4E8B\u3092 \u53D6\u308C\u3066\u3044\u308B\u304B \u5FC3\u914D\u306B \u306A\u3063\u3061\u3083\u3046\u306E\u3002",
    "Indoor_Day_0": "\u3053\u3053\u306F \u672C\u5F53\u306B \u7A4F\u3084\u304B\u306D\u3002\u6614\u306F \u6050\u308D\u3057\u3044 \u60AA\u5922\u3092 \u898B\u3066\u3044\u305F\u3051\u3069\u3001 \u4ECA\u306F \u8D64\u3061\u3083\u3093\u307F\u305F\u3044\u306B \u30B0\u30C3\u30B9\u30EA \u7720\u308C\u308B\u308F\u3002",
    "Indoor_Day_1": "\u304A\u306F\u3088\u3046\u3001@\uFF01\u6696\u304B\u3044 \u671D\u98DF\u3092 \u4F5C\u3063\u305F\u308F\u3088\u3002[195 210 211]#$e#\u3042\u306A\u305F\u304C \u6E80\u8179\u3067 \u4ED5\u4E8B\u306B \u884C\u3051\u308B\u3088\u3046\u306B \u3059\u308B\u306E\u306F \u79C1\u306E \u5F79\u76EE\u3060\u304B\u3089\u306D\u3002$h",
    "Indoor_Day_2": "\u4ECA\u65E5\u306F\u306D\u3001 \u672C\u3092 \u8AAD\u3082\u3046\u304B\u306A\u3063\u3066 \u601D\u3063\u3066\u308B\u3002\u524D\u306B \u56F3\u66F8\u9928\u3078 \u884C\u3063\u305F\u6642\u3001 \u65B0\u3057\u3044 \u672C\u3092 \u501F\u308A\u3066\u304D\u305F\u306E\u3088\u3002#$e#\u30AE\u30E5\u30F3\u30BF\u30FC\u3055\u3093\u304C \u3042\u306A\u305F\u306B \u3088\u308D\u3057\u304F\u3063\u3066\u3002",
    "Indoor_Day_3": "\u3042\u306A\u305F\u304C \u898B\u3064\u3051\u3066\u304D\u305F \u767A\u6398\u54C1\u306E \u8A71\u3001 \u5927\u597D\u304D\u3088\u3002\u8003\u53E4\u5B66\u3063\u3066 \u7D20\u6674\u3089\u3057\u3044\u308F\u3088\u306D\uFF01#$e#\u601D\u3063\u305F\u306E\u2026 1\u4E07\u5E74 \u8FD1\u304F \u6614\u306B\u3082\u3001 \u3053\u306E\u5834\u6240\u3067 \u8FB2\u696D\u3092 \u3084\u3063\u3066\u3044\u305F \u4EBA\u306F \u3044\u305F\u306E\u304B\u3082\u77E5\u308C\u306A\u3044\u3063\u3066\u3002",
    "Indoor_Day_4": "\u521D\u3081\u3066 \u4F1A\u3063\u305F\u6642\u3001 \u79C1\u306F \u4EBA\u898B\u77E5\u308A \u3057\u3066\u305F\u308F\u3088\u306D\uFF1F\u305D\u3053\u304B\u3089 \u3053\u3093\u306A \u95A2\u4FC2\u306B \u306A\u308B\u306A\u3093\u3066\u3001 \u8003\u3048\u308B\u3060\u3051\u3067\u3082 \u9762\u767D\u3044\u308F\u3002$h",
    "Indoor_Night_0": "\u304A\u304B\u3048\u308A\u306A\u3055\u3044\u3002\u4ECA\u65E5\u306F \u3084\u308A\u305F\u304B\u3063\u305F\u3053\u3068 \u5168\u90E8 \u3046\u307E\u304F\u3067\u304D\u305F\uFF1F#$e#\u3067\u304D\u3066\u306A\u304F\u3066\u3082\u3001 \u5927\u4E08\u592B\u3002\u6642\u9593\u306F \u6CA2\u5C71 \u3042\u308B\u304B\u3089\uFF01",
    "Indoor_Night_1": "\u30B9\u30AB\u30FC\u30C8\u304B \u30BA\u30DC\u30F3\u2026 \u660E\u65E5\u306F \u3069\u3063\u3061\u306B\u3057\u3088\u3046\u304B\u306A\uFF1F\u79C1\u3063\u305F\u3089 \u4F55\u3092 \u8003\u3048\u3066\u308B\u306E\u304B\u3057\u3089\u2026\u3044\u3064\u3082 \u30B9\u30AB\u30FC\u30C8\u3092 \u306F\u3044\u3066\u308B \u304B\u3089\u306D\u3002",
    "Indoor_Night_2": "\u79C1\u9054\u3063\u3066 \u3044\u3044\u66AE\u3089\u3057 \u3057\u3066\u308B\u3088\u306D\u3002\u6075\u307E\u308C\u306A\u3044 \u4EBA\u3005\u304C \u3053\u306E\u4E16\u306B \u3044\u308B\u3063\u3066\u3053\u3068\u3092 \u5FD8\u308C\u306A\u3044\u3088\u3046\u306B \u3057\u307E\u3057\u3087\u3046\u3002#$e#\u3053\u3046\u3044\u3046 \u751F\u6D3B\u3092 \u3082\u3066\u308B\u3053\u3068\u306B \u79C1\u306F \u3059\u3054\u304F \u611F\u8B1D\u3057\u3066\u308B\u308F\u3002",
    "Indoor_Night_3": "\u6BCD\u3055\u3093\u3001 \u79C1\u304C \u3044\u306A\u304F\u306A\u3063\u3066 \u3055\u3073\u3057\u304C\u3063\u3066\u308B\u304B\u3082\u3002\u305D\u306E \u3055\u3073\u3057\u3055\u3092 \u7D1B\u3089\u308F\u305B\u308B\u305F\u3081\u306B \u9152\u5834\u3078 \u3082\u3063\u3068 \u884C\u304F\u3053\u3068\u306B\u3000\u306A\u3063\u3066\u306A\u304D\u3083 \u3044\u3044\u3051\u3069\u3002#$e#\u3067\u3082\u3001 \u3042\u306A\u305F\u306F \u60AA\u304F\u306A\u3044\u308F\uFF01\u6BCD\u3055\u3093\u306F\u3001 \u81EA\u529B\u3067 \u4F55\u3068\u304B\u3059\u308B \u5FC5\u8981\u304C \u3042\u308B\u306E\u3088\u3002",
    "Indoor_Night_4": "\u305D\u308D\u305D\u308D \u4E00\u7DD2\u306B\u5BDD\u308B\uFF1F\u30D9\u30C3\u30C9\u306E \u6E96\u5099\u306F \u3057\u305F\u308F\u3088\u2026$11",
    "OneKid_0": "\u4ECA\u65E5\u306F %kid1\u3068 \u904A\u3076 \u6642\u9593\u3001 \u3061\u3083\u3093\u3068 \u4F5C\u308C\u305F \u304B\u306A\uFF1F\u4E8C\u4EBA\u76EE\u306E \u5B50\u3069\u3082\u304C \u3067\u304D\u308C\u3070\u3001 \u30E9\u30AF\u306B \u306A\u308B\u304B\u3082\u3002",
    "OneKid_1": "%kid1\u306F \u3053\u3053\u3067 \u30B9\u30C6\u30AD\u306A \u5E7C\u5C11\u751F\u6D3B\u3092 \u904E\u3054\u305B\u308B \u308F\u306D\u3002",
    "OneKid_3": "\u5B50\u3069\u3082\u304C \u3067\u304D\u3066\u3001 \u3060\u3044\u3076 \u5E74\u3092 \u3068\u3063\u305F \u6C17\u304C\u3057\u305F\u308F\u3002\u305F\u3076\u3093\u3001 \u79C1\u306B \u65B0\u3057\u304F \u304B\u304B\u3063\u305F \u8CAC\u4EFB\u306E \u91CD\u3055\u3067 \u305D\u3046 \u611F\u3058\u3066\u308B\u3060\u3051\u304B\u3082\u3002#$e#\u3067\u3082 \u60AA\u304F\u306A\u3044\u308F\uFF01\u6614\u304B\u3089 \u5B50\u3069\u3082\u304C \u307B\u3057\u304B\u3063\u305F\u304B\u3089\u3002$11",
    "Outdoor_0": "\u3053\u3093\u306A \u7F8E\u3057\u3044 \u5834\u6240\u306B \u4F4F\u307F\u305F\u3044\u3063\u3066 \u305A\u3063\u3068 \u601D\u3063\u3066\u305F\u3051\u3069\u3001 \u5922\u304C \u3064\u3044\u306B \u304B\u306A\u3063\u305F\u306E\u306D\u3002#$e#\u524D\u306E\u5BB6\u306B \u4F4F\u3093\u3067\u3044\u305F \u9803\u306F \u6563\u3005\u3060\u3063\u305F\u308F\u3002$s",
    "Outdoor_1": "\u3053\u306E\u5BB6\u3001 \u5B50\u3069\u3082\u3092 \u80B2\u3066\u308B\u306B\u306F \u30AB\u30F3\u30DA\u30AD\u3058\u3083\u306A\u3044\u304B\u3057\u3089\uFF1F#$e#\u7267\u5834\u306A\u3089 \u5E78\u305B\u306B \u80B2\u3064\u3067\u3057\u3087\u3046\u306D\u3002",
    "Outdoor_2": "\u3084\u3041\u3001\u30CF\u30CB\u30FC\u3002\u30AA\u30EC\u304C \u3082\u3063\u3068 \u8FB2\u696D\u306E\u3053\u3068\u3092 \u77E5\u3063\u3066\u305F\u3089\u3001 \u304A\u524D\u3092 \u624B\u4F1D\u3048\u305F\u3093\u3060\u304C\u3002\u3054\u3081\u3093\u3088\u3002#$e#\u541B\u306E\u3053\u3068\u3092 \u8003\u3048\u3066\u308B\u304B\u3089\u3002$h",
    "Outdoor_3": "\u4E00\u5339\u306E \u9CE5\u304C \u897F\u3078 \u98DB\u3093\u3067\u3044\u304F\u306E\u3092 \u898B\u305F\u308F\u3002\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC \u30D0\u30EC\u30FC\u3067\u306F\u3001 \u5409\u5146\u306E \u5370\u306A\u306E\u3088\u3002$h",
    "Outdoor_4": "\u3042\u3042\u2026\u5916\u306B \u51FA\u308B\u3068 \u3044\u3044\u6C17\u5206\u306B \u306A\u308B\u308F\u3002\u305A\u3063\u3068 \u5916\u306B \u3044\u3066\u3001 \u3044\u308D\u3093\u306A\u3082\u306E\u3092 \u89B3\u5BDF\u3057\u3066 \u4E00\u65E5\u3092 \u904E\u3054\u3057\u305F\u3044\u3002",
    "Rainy_Day_0": "\u96E8\u306E\u65E5\u306F \u3044\u3064\u3082 \u30B7\u30CA\u30E2\u30F3\u3068 \u30AF\u30C3\u30AD\u30FC\u306E \u3053\u3068\u3092 \u8003\u3048\u3061\u3083\u3046\u306E\u3088\u306D\u3002",
    "Rainy_Day_1": "\u30DE\u30EB\u3068 \u30CF\u30FC\u30F4\u30A3\u30FC\u5148\u751F\u304C \u4ED8\u304D\u5408\u3046\u3053\u3068\u3063\u3066 \u3042\u308B\u306E\u304B\u306A\uFF1F\u5148\u751F\u306F \u3042\u306E\u5B50\u306E\u3053\u3068 \u597D\u304D\u3060\u3068 \u601D\u3046\u3051\u3069\u2026#$e#\u30DE\u30EB\u306E \u307B\u3046\u304B\u3089 \u52D5\u304F\u3053\u3068\u306B \u306A\u308A\u305D\u3046\u306D\u3002$h",
    "Rainy_Day_2": "\u3084\u3041\u3001\u30CF\u30CB\u30FC\u3002\u4ECA\u671D \u304A\u8CB7\u3044\u7269\u306B \u884C\u3063\u3066\u305F\u3051\u3069\u3001 \u3053\u3093\u306A\u3082\u306E\u3092 \u8CB7\u3063\u3066\u304D\u305F\u308F\u3002[186 180 770 535]#$e#\u3042\u306A\u305F\u306E \u5F79\u306B\u7ACB\u3064\u3068 \u601D\u3063\u305F\u306E\u3088\u3002$11",
    "Rainy_Day_3": "\u3046\u30FC\u3093\u2026 \u65B0\u3057\u3044 \u30EC\u30B7\u30D4\u3092 \u8A66\u3057\u3066\u307F\u3088\u3046\u304B\u3057\u3089\u3002\u3042\u306A\u305F\u306F \u524D\u306E \u6599\u7406\u3001 \u6C17\u306B\u5165\u3063\u3066\u304F\u308C\u305F\u308F\u3088\u306D\uFF1F#$e#\u305F\u3057\u304B \u3042\u308C\u306F\u2026\u300C\u30C1\u30EA\u30FB \u30C7\u30FB @\u300D\u3060\u3063\u305F\u304B\u306A\uFF1F",
    "Rainy_Day_4": "\u3053\u3046\u3044\u3046\u65E5\u306F\u3001 \u826F\u66F8\u3092 \u56F2\u3046\u306E\u304C \u4E00\u756A\u306D\u3002",
    "Rainy_Night_0": "\u672C\u65E5\u306F \u3044\u304B\u304C\u3067\u3057\u305F\u304B\uFF1F\u79C1\u306F \u5C0F\u8AAC\u3092\u8AAD\u3093\u3067 \u5348\u5F8C\u3092 \u904E\u3054\u3057\u305F\u308F\u3002",
    "Rainy_Night_1": "\u6BCD\u3055\u3093\u306F \u305F\u3076\u3093 \u4ECA\u3001 \u9152\u5834\u306B \u3044\u308B\u304B\u306A\u2026\u3082\u3046 \u6C17\u306E\u6BD2\u3060\u306A\u3093\u3066 \u601D\u308F\u306A\u304F\u306A\u3063\u305F\u3051\u3069\u3002\u79C1\u306E\u624B\u306B \u8CA0\u3048\u306A\u304F\u306A\u3063\u305F\u304B\u3089\u3002",
    "Rainy_Night_2": "\u3042\u306E \u6D74\u5834\u3067 \u3042\u306A\u305F\u3068 \u4F1A\u3063\u305F\u591C\u3092 \u601D\u3044\u51FA\u3057\u3066\u3044\u305F\u306E\u3002$l#$e#\u3042\u306E \u591C\u306F \u5FD8\u308C\u3089\u308C\u306A\u3044\u308F\u2026$l",
    "Rainy_Night_3": "\u30C8\u30EC\u30FC\u30E9\u30FC\u30CF\u30A6\u30B9\u306B \u4F4F\u3093\u3067\u3044\u305F\u9803\u306F\u3001 \u96E8\u97F3\u304C \u82E6\u624B\u3060\u3063\u305F\u308F\u3002\u3067\u3082 \u3053\u3053\u3067\u306F \u5FC3\u5730\u3088\u3044 \u611F\u3058\u304C \u3059\u308B\u306E\u3002",
    "Rainy_Night_4": "\u4ECA\u591C\u306E \u6599\u7406\u306F \u3044\u3063\u305D\u3046 \u304C\u3093\u3070\u3063\u3066\u307F\u305F\u306E\u3002\u3042\u306A\u305F\u306E \u53E3\u306B\u5408\u3046\u3068 \u3044\u3044\u306A\u3002[212 214 225 209 200]$h",
    "TwoKids_0": "%kid1\u3068%kid2\u306B\u306F \u3082\u3046 \u3054\u306F\u3093\u3092 \u98DF\u3079\u3055\u305B\u305F\u3088\u3002\u4E8C\u4EBA\u3068\u3082 \u3044\u3063\u3071\u3044 \u98DF\u3079\u308B\u306E\u306D\uFF01",
    "TwoKids_1": "\u4E8C\u4EBA\u76EE\u306E\u5B50\u304C\u3067\u304D\u305F\u304B\u3089\u3001 %kid2\u3060\u3051\u3067\u306A\u304F %kid1\u306B\u3082 \u3061\u3083\u3093\u3068 \u304B\u307E\u3063\u3066\u3042\u3052\u3088\u3046\u3002\u5B50\u3069\u3082\u9054\u306E \u9593\u3067 \u5AC9\u59AC\u304C \u8D77\u3053\u3089\u306A\u3044 \u3088\u3046\u306B\u306D\u3002",
    "TwoKids_2": "%kid2\u304C \u7FFC\u3092\u751F\u3084\u3057\u3066\u3001 \u591C\u7A7A\u3092 \u98DB\u3076 \u5922\u3092 \u898B\u305F\u306E\u3002\u3069\u3046\u3044\u3046 \u610F\u5473\u304B\u306A\uFF1F",
    "TwoKids_3": "\u4F4F\u307F\u3084\u3059\u3044\u5BB6\u3001 \u30B9\u30C6\u30AD\u306A\u4E8C\u4EBA\u306E \u5B50\u3069\u3082\u3001\u3059\u3070\u3089\u3057\u3044 \u571F\u5730\u3002\u79C1\u9054\u3063\u3066 \u672C\u5F53\u306B \u5E78\u904B\u306D\u3002",
    "fall_1": "\u79CB\u2026\u30AB\u30E9\u30D5\u30EB\u306A \u7D19\u3068 \u30CE\u30EA\u3092 \u601D\u308F\u305B\u3066\u304F\u308C\u308B\u308F\u3002\u5B50\u3069\u3082\u3068 \u904A\u3073\u3059\u304E\u305F\u304B\u3089 \u305D\u3046 \u601D\u3046\u3060\u3051\u304B\u3082\u3002$h",
    "fall_2": "\u4ECA\u5E74\u306F \u5DE8\u5927 \u30AB\u30DC\u30C1\u30E3\u3092 \u80B2\u3066\u308B \u3064\u3082\u308A\u304B\u3057\u3089\uFF1F$11",
    "fall_5": "\u79CB\u306E \u5302\u3044\u306F \u672C\u306E \u9999\u308A\u3092 \u601D\u3044\u51FA\u3055\u305B\u3066\u304F\u308C\u308B\u308F\u2026 \u305D\u308C\u3063\u3066 \u5909\u3060\u3068\u601D\u3046\uFF1F",
    "funLeave_Penny": "\u4ECA\u65E5\u306F \u305F\u3060 \u697D\u3057\u3080\u305F\u3081\u306B \u753A\u3078 \u51FA\u6B69\u3053\u3046\u3068 \u601D\u3063\u3066\u308B\u306E\u3002\u3059\u3050\u306B \u623B\u308B\u304B\u3089\u306D\uFF01",
    "funReturn_Penny": "\u3042\u3042\u3001 \u697D\u3057\u304B\u3063\u305F\u308F\u2026\u307F\u3093\u306A\u3068 \u89E6\u308C\u5408\u3046\u306E\u3063\u3066 \u3084\u3063\u3071\u308A \u826F\u3044\u308F\u306D\u3002\u4ECA\u65E5\u306F \u3069\u3093\u306A\u4E00\u65E5\u304B \u805E\u304B\u305B\u3066\u304F\u308C\u308B\u304B\u3002",
    "patio_Penny": "\u3053\u306E\u5BB6\u3001\u308F\u305F\u3057\u306E\u5B9F\u5BB6\u3088\u308A\u3068\u3063\u3066\u3082\u9759\u304B\u3067\u3057\u3087\u3002\u3060\u304B\u3089\u5927\u597D\u304D\u306A\u306E\u3002",
    "spring_1": "\u4ECA\u5E74\u306F \u9577\u304F\u3001 \u6696\u304B\u3044 \u5E74\u306B \u306A\u308A\u305D\u3046\u306D\u3002\u5B9F\u308A\u3042\u308B \u4E00\u5E74\u306B \u3057\u307E\u3057\u3087\u3046\u3002",
    "spring_15": "\u3042\u3042\u3001 \u6625\u306E\u5927\u6383\u9664\u306D\u2026\u79C1\u306F \u6383\u9664\u3092 \u697D\u3057\u3080\u3064\u3082\u308A\u3088\u3002",
    "spring_8": "\u6625\u306F \u305F\u3076\u3093\u3001 \u79C1\u306E \u304A\u6C17\u306B\u5165\u308A\u306E \u5B63\u7BC0\u304B\u306A\u3002\u65B0\u9BAE\u306A \u98A8\u304C\u3001 \u79C1\u3092 \u5E0C\u671B\u3067 \u6E80\u305F\u3057\u3066\u304F\u308C\u308B\u306E\u3002",
    "summer_1": "\u590F\u306F \u3059\u3054\u304F \u6691\u3044\u3051\u3069\u3001 \u808C\u306B \u826F\u3044\u611F\u3058\u306E \u6E7F\u5EA6\u304C \u3042\u308B\u306E\u3088\u306D\u3002",
    "summer_16": "\u3075\u3045\u2026\u3053\u306E \u6691\u3055\u3092 \u4E57\u308A\u5207\u308B\u305F\u3081\u306B\u3001 \u3082\u3063\u3068 \u30E1\u30ED\u30F3\u304C \u98DF\u3079\u305F\u3044\u308F\uFF01",
    "summer_2": "\u590F\u306F \u30A2\u30EA\u9054\u304C \u3068\u3066\u3082 \u6D3B\u767A\u306B \u306A\u308B\u308F\u3002\u305A\u3063\u3068 \u89B3\u5BDF\u3057\u3066\u3044\u305F\u3044\u306A\u2026 \u30A2\u30EA\u3063\u3066\u3001 \u898B\u305F\u76EE\u306B \u3088\u3089\u305A \u8907\u96D1\u306A \u7D44\u7E54\u4F53\u5236\u3092 \u6301\u3063\u3066\u308B\u304B\u3089\u306D\u3002",
    "winter_1": "\u51AC\u3063\u3066\u3001\u4F11\u3080\u306B\u306F \u826F\u3044 \u6642\u671F\u3060\u3068\u601D\u3046\u306E\u3002\u3042\u306A\u305F\u306F \u9577\u3044\u9593 \u304A\u4ED5\u4E8B\u3092 \u304C\u3093\u3070\u3063\u305F\u304B\u3089\u306D\uFF01",
    "winter_3": "\u79C1\u9054\u306F \u3069\u3046\u3084\u3063\u3066 \u51AC\u3092 \u4E57\u308A\u5207\u308B\u306E\u304B\u3057\u3089\uFF1F\u3042\u3042\u3001 \u8A00\u308F\u306A\u304F\u3066\u3082 \u5927\u4E08\u592B\u3088\u2026\u3042\u306A\u305F\u306E \u5224\u65AD\u3092 \u4FE1\u3058\u3066\u308B\u304B\u3089\u3002",
    "winter_6": "\u96EA\u3092 \u898B\u308B\u3068\u3001 \u6696\u7089\u306E \u305D\u3070\u3067 \u30ED\u30C3\u30AD\u30F3\u30B0\u30C1\u30A7\u30A2\u306B \u5EA7\u308B \u304A\u3070\u3042\u3061\u3083\u3093\u3092 \u601D\u3044\u51FA\u3059\u306E\u3002\u71C3\u3048\u308B \u30DE\u30AD\u304C \u3046\u3064\u3059 \u304A\u3070\u3042\u3061\u3083\u3093\u306E \u5F71\u304C \u4E00\u756A \u5370\u8C61\u306B \u6B8B\u3063\u3066\u308B\u304B\u306A\u3002\u3059\u3054\u304F \u6614\u306E \u3053\u3068\u3088\u3002"
  }
}