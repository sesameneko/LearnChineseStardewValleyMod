    "AcceptGift_(O)StardropTea": "\u3053\u308C\u306F\u306A\u306B\u304B\u306D\uFF1F\u5E0C\u5C11\u3067\u5F37\u529B\u306A\u30A8\u30EA\u30AF\u30B5\u30FC\u306E\u3088\u3046\u3060\u3002\u3088\u3057\u3001\u543E\u8F29\u306E\u8A66\u85AC\u68DA\u306B\u52A0\u3048\u308B\u3053\u3068\u306B\u3057\u3088\u3046\u3002",
    "Fri": "\u304A\u305D\u3089\u304F\u3001\u753A\u306E\u4F4F\u6C11\u306F\u6211\u8F29\u3092\u6050\u308C\u3066\u304A\u308B\u3002#$e#\u6B8B\u5FF5\u3067\u306F\u3042\u308B\u304C\u3001\u4FD7\u4EBA\u306F\u672A\u77E5\u306A\u308B\u3082\u306E\u306B\u6050\u6016\u3092\u3044\u3060\u304F\u3082\u306E\u3060\u304B\u3089\u306A\u3002",
    "Fri6": "\u304B\u3064\u3066\u3001\u6211\u8F29\u306B\u306F\u59BB\u304C\u3044\u305F\u3002\u304A\u4E92\u3044\u5225\u308C\u3092\u544A\u3052\u305F\u3042\u3068\u3001\u5F7C\u5973\u306F\u3042\u305F\u308A\u3092\u98DB\u3073\u56DE\u308A\u3001\u76EE\u306B\u5165\u308B\u3082\u306E\u3059\u3079\u3066\u3092\u546A\u3046\u3088\u3046\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3002#$e#\u6012\u308A\u3092\u767A\u6563\u3059\u308B\u306B\u3057\u3066\u3082\u3001\u307E\u3063\u305F\u304F\u5206\u5225\u306B\u6B20\u3051\u3066\u304A\u308B\u3002",
    "GreenRain": "\u3053\u306E\u96E8\u3092\u7570\u5E38\u3060\u3068\u611F\u3058\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304C\u3001\u306A\u306B\u3082\u6050\u308C\u308B\u3053\u3068\u306F\u306A\u3044\u3002#$e#\u5B9F\u969B\u306F\u591A\u304F\u306E\u751F\u304D\u7269\u306B\u3068\u3063\u3066\u5927\u304D\u306A\u3088\u308D\u3053\u3073\u306E\u65E5\u306A\u306E\u3060\u3002",
    "GreenRain_2": "\u81EA\u7136\u306F\u5F37\u5927\u306A\u529B\u3092\u6301\u3063\u3066\u3044\u308B\u3002 \u6C7A\u3057\u3066\u3042\u306A\u3069\u3063\u3066\u306F\u306A\u3089\u306A\u3044\u3002#$e#\u5931\u793C\u3059\u308B\u3088\u3002 \u3053\u306E\u65E5\u306B\u3057\u304B\u3067\u304D\u306A\u3044\u7279\u5225\u306A\u7528\u4E8B\u304C\u3042\u308B\u306E\u3060\u3002",
    "Introduction": "\u304A\u304A\u3002\u82E5\u304D @\u3088\u3001 \u8CB4\u6BBF\u304C \u3053\u3053\u3078 \u6765\u308B\u3053\u3068\u306F \u306F\u308B\u304B \u6614\u304B\u3089 \u4E88\u898B\u3057\u3066\u304A\u3063\u305F\u3002#$e#\u3058\u3083\u304C\u3001 \u904B\u547D\u306F \u81EA\u5206\u81EA\u8EAB\u3067 \u6C7A\u3081\u308B\u306E\u3058\u3083\u3002",
    "Mon": "\u82E5\u304D @\u3088\u3001\u6211\u8F29\u306F \u8CB4\u6BBF\u306E \u672A\u6765\u306E \u591A\u304F\u3092 \u898B\u305F\u3002#$e#\u6050\u308B\u3079\u304D \u4E8B\u614B\u306B \u306A\u308A\u3046\u308B\u304C\u305F\u3081\u3001 \u5B50\u7D30\u3092 \u4F1D\u3048\u308B\u3053\u3068\u306F \u3067\u304D\u306C\u3002",
    "Mon4": "\u4EBA\u985E\u306E\u6587\u660E\u304B\u3089\u96E2\u308C\u305F\u5834\u6240\u3067\u3053\u305D\u3001\u81EA\u7136\u306F\u305D\u306E\u771F\u306E\u79D8\u5BC6\u3092\u660E\u3089\u304B\u306B\u3059\u308B\u306E\u3060\u3002",
    "Mon8": "\u4E16\u754C\u306B\u306F\u3001\u73FE\u4EE3\u7684\u306A\u601D\u8003\u306B\u3068\u3089\u308F\u308C\u305A\u3001\u9B54\u6CD5\u3092\u4F7F\u3044\u7D9A\u3051\u3066\u3044\u308B\u5834\u6240\u3082\u3042\u308B\u306E\u3060\u2026",
    "MovieInvitation": "\u3075\u3080\u2026 \u3067\u306F\u3001\u8CB4\u6BBF\u306B\u540C\u884C\u3059\u308B\u3068\u3057\u3088\u3046\u3002\u8CB4\u6BBF\u304C\u7740\u3044\u305F\u3053\u308D\u306B\u306F\u543E\u8F29\u3082\u73FE\u308C\u308B\u3060\u308D\u3046\u3002\u305D\u308C\u3067\u306F\u307E\u305F\u3002",
    "Sat": "\u6C17\u3092\u3064\u3051\u308B\u3053\u3068\u3060\u3002\u8CB4\u6BBF\u306F\u3001\u5F37\u529B\u306A\u9B54\u8853\u529B\u5834\u306E\u4E0A\u306B\u7ACB\u3063\u3066\u3044\u308B\u306E\u3060\u304B\u3089\u306A\u3002#$e#\u3053\u306E\u529B\u5834\u304C\u3042\u308B\u3086\u3048\u3001\u6211\u8F29\u306F\u3053\u3053\u306B\u5C45\u3092\u304B\u307E\u3048\u3066\u3044\u308B\u306E\u3060\u3002",
    "Sat2": "\u68EE\u306E \u7CBE\u970A\u3068\u306F \u4F55\u3089\u304B\u306E \u9032\u5C55\u304C \u3042\u3063\u305F\u304B\u306D\uFF1F",
    "Sat6": "\u79D1\u5B66\u7684\u5B9F\u8DF5\u306F\u3001\u79C1\u305F\u3061\u306E\u4E16\u754C\u306E\u7269\u8CEA\u3092\u6B63\u78BA\u306B\u8A18\u8FF0\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u3066\u3082\u3001\u6700\u3082\u6DF1\u3044\u8B0E\u3092\u8AAC\u660E\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u2026",
    "Sun": "\u6642\u3005\u3001 \u753A\u306E \u4EBA\u3005\u3092 \u3072\u305D\u304B\u306B \u89B3\u5BDF\u3057\u3066\u304A\u308B\u3002#$e#\u5F1F\u5B50\u306B \u306A\u308A\u3046\u308B\u8005\u3092 \u63A2\u3059\u305F\u3081\u306B\u306A\u3002\u3044\u3064\u306E\u65E5\u304B\u3001 \u6211\u8F29\u306F\u3053\u306E \u547D\u3042\u308B\u4E16\u754C\u304B\u3089 \u96E2\u308C\u308B\u3053\u3068\u306B \u306A\u308B\u304C\u3001 \u79D8\u8853\u306E \u7814\u7A76\u3092 \u5F15\u304D\u7D99\u304C\u306D\u3070 \u306A\u3089\u3093\u3002",
    "Thu": "\u8EAB\u306E \u5468\u308A\u306B\u306F \u8B0E\u304C \u6CA2\u5C71 \u5B58\u5728\u3059\u308B\u3002\u89E3\u304D\u660E\u304B\u3059 \u3064\u3082\u308A\u3067 \u3042\u308C\u3070\u3001 \u5FCD\u8010\u5F37\u304F\u306A\u3051\u308C\u3070 \u306A\u3089\u3093\u3002",
    "Thu10": "\u3053\u308C\u306F \u7D76\u5BFE\u306B \u4ED6\u8A00\u3057\u3066\u306F \u3044\u304B\u3093\u305E\u2026 \u753A\u306E \u4F4F\u4EBA\u306E \u3046\u3061\u306E \u4E00\u4EBA\u304C\u3001 \u6211\u8F29\u306E \u5A18\u3060\u3068 \u601D\u3046\u3093\u3058\u3083\u2026#$e#\u65AD\u8A00\u306F \u3067\u304D\u306C\u304C\u306A\u2026\u73CD\u3057\u304F\u306F \u3042\u308B\u304C\u3001 \u5B9F\u969B\u306B \u8D77\u3053\u308A\u3046\u308B\u3002",
    "Tue": "\u6211\u8F29\u306B \u4F1D\u3048\u305F\u3044\u3053\u3068\u304C \u306A\u3044\u306A\u3089\u3070\u3001 \u304B\u307E\u3046\u3067\u306A\u3044\u3002\u6210\u3059\u3079\u304D\u3053\u3068\u304C \u6CA2\u5C71 \u3042\u308B\u306E\u3058\u3083\u3002",
    "Tue10": "\u73FE\u5B9F\u304C\u7CBE\u795E\u3067\u69CB\u7BC9\u3055\u308C\u3066\u3044\u308B\u306E\u306A\u3089\u3001\u7CBE\u795E\u306E\u529B\u3092\u9AD8\u3081\u308C\u3070\u73FE\u5B9F\u3092\u30B3\u30F3\u30C8\u30ED\u30FC\u30EB\u3067\u304D\u308B\u306F\u305A\u3060\u2026",
    "Tue4": "\u5730\u4E0B\u5BA4\u3078 \u5165\u308C\u3066\u3082 \u826F\u3044\u304F\u3089\u3044\u306B\u306F \u8CB4\u6BBF\u3092 \u4FE1\u7528 \u3057\u3066\u304A\u308B\u3002\u5730\u4E0B\u5BA4\u306B \u3042\u308B\u3082\u306E\u306F \u5927\u5207\u306B \u6271\u3046\u306E\u3058\u3083\u3088\u3002",
    "Tue8": "\u3054\u304D\u3052\u3093\u3088\u3046\u3001 @\u3002\u305D\u306A\u305F\u306F\u95C7\u306E\u546A\u8853\u306B\u624B\u3092\u51FA\u3057\u3066\u3044\u306A\u3044\u3060\u308D\u3046\u306D\uFF1F",
    "Wed": "\u7CBE\u970A\u306E \u8A00\u8449\u3092 \u7406\u89E3\u3059\u308B\u306B \u6570\u5E74\u306E \u7814\u7A76\u304C \u5FC5\u8981\u3068 \u306A\u308B\u3002#$e#\u5B9F\u969B\u306B \u7CBE\u970A\u306E \u8A00\u8449\u3092 \u8A71\u3059\u3068 \u306A\u308C\u3070\u3001 \u751F\u6DAF\u3092\u304B\u3051\u3066 \u7814\u7A76\u305B\u306D\u3070 \u306A\u3089\u3093\u3002#$e#\u305D\u308C\u3067\u306F\u3001 \u5931\u793C\u2026",
    "accept_868": "\u3042\u3042\u2026\u5317\u6975\u306E\u304B\u3051\u3089\u3002#$b#\u3068\u3066\u3082\u529B\u5F37\u3044\u3082\u306E\u3001\u6C37\u306E\u529B\u304C\u30AE\u30E5\u30C3\u3068\u3064\u307E\u3063\u305F\u3082\u306E\u3002#$b#\u3082\u3089\u3063\u3066\u3044\u304F\u3088\u3001\u3082\u3057\u8CB4\u6BBF\u304C\u3088\u3051\u308C\u3070\u3002#$b#\u2026#$b#\u2026\u3048\u30FC\u3068\u2026\u307E\u3060\u4F55\u304B\u3042\u308B\u306E\uFF1F\u3042\u3042\u3002\u4F55\u304B\u304C\u6B32\u3057\u3044\u3093\u3060\u306D\uFF1F#$b#\u2026\u3053\u308C\u3092\u6301\u3063\u3066\u884C\u3063\u3066\u3002",
    "married": "\u7D50\u5A5A\u304B\u2026 \u3046\u30FC\u3080\u2026\u305D\u306A\u305F\u304C\u543E\u8F29\u3088\u308A\u3082\u5E78\u904B\u306B\u6075\u307E\u308C\u308B\u3053\u3068\u3092\u7948\u308D\u3046\u2026",
    "roommates_Krobus": "\u30AF\u30ED\u30D0\u30B9\u306E\u3088\u3046\u306A\u8005\u3068\u4E00\u7DD2\u306B\u66AE\u3089\u3059\u306E\u306F\u5927\u5909\u306A\u3053\u3068\u3060\u3002\u3057\u304B\u3057\u3001\u304A\u4E92\u3044\u306B\u5927\u304D\u306A\u5229\u76CA\u304C\u3042\u308B\u306E\u306F\u78BA\u304B\u3060\u3002#$e#\u543E\u8F29\u306B\u3068\u3063\u3066\u4E00\u756A\u306E\u95A2\u5FC3\u4E8B\u306F\u3001\u3053\u306E\u3088\u3046\u306A\u4E00\u98A8\u5909\u308F\u3063\u305F\u53CB\u60C5\u306E\u7D50\u672B\u304C\u3069\u3046\u306A\u308B\u304B\u3060\u3002"
  }
