    "18": "\u521D\u3081\u3066\u3053\u3053\u306B\u7740\u3044\u305F\u3068\u304D\u3001\u30E9\u30A4\u30CA\u30B9\u304C\u8449\u3063\u3071\u3067\u670D\u3092\u4F5C\u3063\u3066\u304F\u308C\u305F\u3093\u3060\u3001\u5F7C\u307F\u305F\u3044\u306A\u2026#$b#\u3067\u3082\u304A\u304B\u3057\u306A\u611F\u3058\u3060\u3063\u305F\u3088\u2026\u30B1\u30D0\u30B1\u30D0\u3057\u305F\u30DE\u30F3\u30B4\u30FC\u307F\u305F\u3044\u3067\uFF01$h#$e#\u30DC\u30AF\u306F\u3044\u3064\u3082\u306E\u7FBD\u6839\u3067\u3044\u3044\u3068\u601D\u3063\u305F\u306D\u3002",
    "4": "\u7A7A\u306B\u5927\u304D\u306A\u30DE\u30F3\u30B4\u30FC\u304C\u6D6E\u304B\u3093\u3067\u308B\u306E\u3092\u898B\u305F\u3093\u3060\u3002\u30E9\u30A4\u30CA\u30B9\u304C\u3001\u305D\u308C\u306F\u71B1\u6C17\u7403\u3060\u3063\u3066\u6559\u3048\u3066\u304F\u308C\u305F\u3093\u3060\u3088\uFF01$u#$b#\u30DC\u30AF\u306F\u3001\u7A7A\u3092\u98DB\u3079\u308B\u306E\u306F\u9CE5\u3060\u3051\u3060\u3068\u601D\u3063\u3066\u305F\u3088\u2026",
    "AcceptGift_(O)StardropTea": "\u308F\u3042\uFF01 \u91D1\u306E\u30AF\u30EB\u30DF\u307F\u305F\u3044\u306A\u5473\u3060\u306D\uFF01\u3059\u3063\u3054\u304F\u304A\u3044\u3057\u3044\u3088\uFF01",
    "Fri": "\u30E9\u30A4\u30CA\u30B9\u304C\u3001\u8C37\u306B\u3042\u308B\u91CE\u751F\u306E\u98DF\u3079\u7269\u3092\u305C\u3093\u3076\u6559\u3048\u3066\u304F\u308C\u305F\u3093\u3060\u3002\u3053\u3053\u306B\u306F\u3044\u3044\u3082\u306E\u304C\u305F\u304F\u3055\u3093\u3042\u308B\u3093\u3060\u306D\uFF01$h#$e#\u3067\u3082\u2026\u671D\u3054\u306F\u3093\u306B\u91D1\u306E\u30AF\u30EB\u30DF\u304C\u98DF\u3079\u3089\u308C\u306A\u3044\u306E\u306F\u5BC2\u3057\u3044\u306A\u2026$s",
    "Fri8": "\u30E9\u30A4\u30CA\u30B9\u306F\u9B5A\u3092\u98DF\u3079\u308B\u6642\u306B\u306F\u300C\u6599\u7406\u300D\u3092\u3057\u305F\u65B9\u304C\u3044\u3044\u3063\u3066\u8A00\u3046\u3093\u3060\u3002$s#$b#\u305C\u3093\u305C\u3093\u6163\u308C\u306A\u3044\u3088\u2026\u3068\u3063\u3066\u3082\u4E7E\u3044\u3066\u308B\u304B\u3089\u2026$s",
    "GreenRain": "\u30DC\u30AF\u306F\u3053\u306E\u5929\u6C17\u306F\u597D\u304D\u3060\u306A\u2026 \u6E7F\u6C17\u304C\u3042\u3063\u3066\u3002\u3075\u308B\u3055\u3068\u306E\u68EE\u3092\u601D\u3044\u51FA\u3059\u3093\u3060\u3002",
    "LeoDeparture": "\u4F4F\u3080\u5834\u6240\u3092\u63A2\u3055\u306A\u304F\u3061\u3083\u2026$s#$b#\u3067\u3082\u8003\u3048\u3066\u308B\u3053\u3068\u304C\u3042\u308B\u3093\u3060\u2026\u30DC\u30AF\u306E\u53CB\u9054\u3092\u983C\u308D\u3046\u3068\u601D\u3063\u3066\u308B\u3093\u3060\u3002",
    "Mon": "\u3084\u3042\u3001@\u3002\u6614\u307F\u305F\u3044\u306B\u3001\u307E\u305F\u5CF6\u3067\u4F1A\u3048\u3066\u3046\u308C\u3057\u3044\u3088\u3002\u9762\u767D\u3044\u3088\u306D\uFF01#$e#\u521D\u3081\u3066\u307F\u3093\u306A\u304C\u6765\u305F\u6642\u306F\u3001\u3068\u3066\u3082\u6016\u304B\u3063\u305F\u3093\u3060\u3088\u2026\u30DC\u30AF\u306E\u751F\u6D3B\u304C\u5909\u308F\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3063\u3066\u601D\u3063\u305F\u3093\u3060\u3002$u",
    "Sat": "\u3044\u3064\u304B\u3001\u30BA\u30BA\u30B7\u30C6\u30A3\u306B\u3082\u884C\u3063\u3066\u307F\u3088\u3046\u304B\u306A\u2026$u#$b#\u3067\u3082\u4ECA\u306F\u307E\u3060\u5FC3\u306E\u6E96\u5099\u304C\u3067\u304D\u3066\u3044\u306A\u3044\u3093\u3060\u3002\u3053\u306E\u4E16\u754C\u306F\u30DC\u30AF\u306B\u3068\u3063\u3066\u4E0D\u601D\u8B70\u306A\u3082\u306E\u3060\u3051\u3069\u3001\u3053\u3053\u306F\u672C\u5F53\u306B\u5B89\u5FC3\u3067\u304D\u308B\u3068\u3053\u308D\u3060\u3088\uFF01$h",
    "Sat10": "@\uFF1F\u3046\u30FC\u3093\u2026\u805E\u304F\u306E\u304C\u3061\u3087\u3063\u3068\u6065\u305A\u304B\u3057\u3044\u3093\u3060\u3051\u3069\u2026$u#$b#\u30B8\u30E3\u30B9\u306F\u30DC\u30AF\u305F\u3044\u306A\u3084\u3064\u3092\u597D\u304D\u306B\u306A\u308B\u3068\u601D\u3046\uFF1F$u#$b#\u3084\u3063\u3071\u308A\u30DC\u30AF\u306F\u5909\u308F\u308A\u8005\u304B\u306A\uFF1F$s#$e#\u306F\u306F\u306F\u2026\u307E\u3042\u3044\u3044\u3084\u3002\u3044\u3064\u304B\u3001\u308F\u304B\u308B\u3068\u3044\u3044\u306A\u3002$h",
    "Sun": "\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u304C\u30DC\u30AF\u306E\u65B0\u3057\u3044\u5BB6\u306A\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u3069\u2026\u5CF6\u306F\u3044\u3064\u307E\u3067\u3082\u30DC\u30AF\u306E\u5BB6\u306A\u3093\u3060\u3088\u3002#$e#\u307E\u305F\u5E30\u3063\u3066\u6765\u308C\u3066\u672C\u5F53\u306B\u5B09\u3057\u3044\u3088\u3002",
    "Sun10": "\u30AA\u30A6\u30E0\u305F\u3061\u304C\u3001\u91D1\u306E\u30AF\u30EB\u30DF\u3092\u898B\u3064\u3051\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3063\u3066\u304A\u793C\u3092\u8A00\u3063\u3066\u308B\u3088\u3002\u3042\u308C\u306F\u307F\u3093\u306A\u306E\u304A\u6C17\u306B\u5165\u308A\u306A\u3093\u3060\u3002$h",
    "Thu": "\u3053\u3053\u306B\u4F4F\u3093\u3067\u308B\u9762\u767D\u3044\u9CE5\u305F\u3061\u3092\u77E5\u3063\u3066\u308B\uFF1F#$e#\u8033\u3092\u3059\u307E\u3057\u305F\u3089\u3001\u4F55\u304B\u6559\u3048\u3066\u304F\u308C\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3088\u3002",
    "Thu10": "\u6700\u521D\u306F\u3068\u3066\u3082\u5BC2\u3057\u304B\u3063\u305F\u3093\u3060\u3002\u3067\u3082\u30DC\u30AF\u306B\u306F\u305F\u304F\u3055\u3093\u53CB\u9054\u304C\u3067\u304D\u305F\uFF01$h#$b#\u4ECA\u306F\u3001\u5C45\u5FC3\u5730\u304C\u3044\u3044\u3093\u3060\u3088\u2026",
    "Thu8": "\u6700\u521D\u306F\u5ACC\u3060\u3063\u305F\u3093\u3060\u2026\u5CF6\u3092\u51FA\u3066\u898B\u77E5\u3089\u306C\u571F\u5730\u306B\u884C\u304F\u306A\u3093\u3066\u3002$s#$e#\u3067\u3082\u3001\u3082\u3046\u6163\u308C\u3066\u304D\u305F\u3088\u3002#$b#\u30DC\u30AF\u306F\u3069\u3053\u306B\u3060\u3063\u3066\u99B4\u67D3\u3081\u308B\u3093\u3060\uFF01$h",
    "Tue": "\u30DA\u30CB\u30FC\u3055\u3093\u306F\u3001\u30DC\u30AF\u304C\u65B0\u3057\u3044\u3053\u3068\u3092\u52C9\u5F37\u3059\u308B\u306E\u3092\u4E00\u751F\u61F8\u547D\u624B\u4F1D\u3063\u3066\u304F\u308C\u308B\u3093\u3060\u3002\u5F7C\u5973\u306F\u672C\u5F53\u306B\u3044\u3044\u4EBA\u3060\u306D\u2026#$e#\u2026\u305D\u308C\u306B\u30DC\u30AF\u306F\u3001\u3068\u3066\u3082\u6614\u306E\u3053\u3068\u3092\u5C11\u3057\u61B6\u3048\u3066\u3044\u308B\u3093\u3060\u2026\u5CF6\u306B\u6D41\u308C\u7740\u304F\u524D\u306E\u3053\u3068\u2026\u3060\u304B\u3089\u3001\u305D\u3093\u306A\u306B\u96E3\u3057\u304F\u306F\u306A\u3044\u3093\u3060\u3088\u3002#$e#\u30DC\u30AF\u304C\u8272\u3093\u306A\u4E8B\u3092\u77E5\u3063\u3066\u308B\u3063\u3066\u3001\u30DA\u30CB\u30FC\u3055\u3093\u304C\u611F\u5FC3\u3057\u3066\u304F\u308C\u308B\u3093\u3060\u3002",
    "Tue10": "\u30B8\u30E3\u30B9\u3082\u30F4\u30A3\u30F3\u30BB\u30F3\u30C8\u3082\u3001\u6700\u521D\u306F\u30DC\u30AF\u3092\u5909\u306A\u3084\u3064\u3060\u3068\u601D\u3063\u3066\u305F\u3093\u3060\u308D\u3046\u306A\u3002\u3046\u3063\u304B\u308A\u5B66\u6821\u306E\u673A\u306B\u5EA7\u3063\u3061\u3083\u3063\u305F\u3053\u3068\u304C\u4F55\u56DE\u304B\u3042\u3063\u3066\u2026\u305D\u308C\u306F\u3057\u3087\u3046\u304C\u306A\u3044\u3093\u3060\u3051\u3069\u3002$s#$e#\u305D\u308C\u304B\u3089\u8272\u3093\u306A\u3053\u3068\u304C\u5909\u308F\u3063\u305F\u3093\u3060\u3002\u4ECA\u306F\u3001\u3068\u3066\u3082\u3044\u3044\u53CB\u9054\u3060\u3088\uFF01$h",
    "Wed": "\u30E9\u30A4\u30CA\u30B9\u3068\u30DA\u30CB\u30FC\u3055\u3093\u304B\u3089\u8272\u3093\u306A\u4E8B\u3092\u7FD2\u3046\u3064\u3082\u308A\u306A\u3093\u3060\uFF01$h#$e#\u30EB\u30A4\u30B9\u753A\u9577\u306F\u3001\u30DC\u30AF\u304C\u300C\u535A\u8B58\u306A\u753A\u6C11\u300D\u306B\u306A\u308B\u305F\u3081\u306E\u9AD8\u901F\u30D0\u30B9\u306B\u4E57\u3063\u305F\u3063\u3066\u8A00\u3046\u3093\u3060\u3051\u3069\u2026\u305C\u3093\u305C\u3093\u610F\u5473\u304C\u308F\u304B\u3089\u306A\u3044\u3088\u3002",
    "winter_Fri": "\u30E9\u30A4\u30CA\u30B9\u304B\u3089\u3001\u7279\u88FD\u306E\u30B9\u30D1\u30A4\u30B9\u30D9\u30EA\u30FC\u304C\u5165\u3063\u305F\u9B5A\u306E\u3059\u308A\u8EAB\u306E\u4F5C\u308A\u65B9\u3092\u7FD2\u3063\u305F\u3093\u3060\u2026#$b#\u305F\u304F\u3055\u3093\u98DF\u3079\u308B\u3068\u51AC\u3067\u3082\u6E29\u304B\u304F\u904E\u3054\u305B\u308B\u3093\u3060\u3063\u3066\uFF01$h",
    "winter_Thu": "\u3053\u306E\u8C37\u306E\u9CE5\u305F\u3061\u306F\u3001\u5BD2\u3055\u304C\u6C17\u306B\u306A\u3089\u306A\u3044\u307F\u305F\u3044\u306A\u3093\u3060\u3002#$e#\u307F\u3093\u306A\u306E\u6E29\u304B\u305D\u3046\u306A\u7FBD\u6BDB\u304C\u3061\u3087\u3063\u3068\u3046\u3089\u3084\u307E\u3057\u3044\u306A\u2026$s"
  }
