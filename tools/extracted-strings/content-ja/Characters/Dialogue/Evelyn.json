    "Tue": "\u592B\u306E\u30B8\u30E7\u30FC\u30B8\u306E\u3053\u3068\u3001 \u3042\u307E\u308A\u6C17\u306B\u3057\u306A\u3044\u3067\u3061\u3087\u3046\u3060\u3044\u3002\u898B\u77E5\u3089\u306C\u4EBA\u306B \u597D\u610F\u3092\u3082\u3066\u306A\u3044\u30BF\u30A4\u30D7\u306A\u306E\u3088\u3002#$e#\u3067\u3082\u77E5\u308A\u5408\u3063\u305F\u3089 \u6253\u3061\u89E3\u3051\u3066\u304F\u308C\u308B\u306F\u305A\u3002#$e#\u304D\u3063\u3068 \u3042\u306A\u305F\u9054\u4E8C\u4EBA\u306F \u3044\u3044 \u304A\u53CB\u9054\u306B \u306A\u308C\u308B\u308F\uFF01$h#$e#\u592B\u306B \u8208\u5473\u3092 \u6301\u3063\u3066\u304F\u308C\u308B \u3042\u306A\u305F\u306B\u306F \u79D8\u5BC6\u3092 \u6559\u3048\u3066\u3042\u3052\u308B\u3002 \u3042\u306E\u4EBA\u3001\u30DD\u30ED\u306D\u304E\u304C \u5927\u597D\u304D\u306A\u306E\uFF01\u30DD\u30ED\u306D\u304E\u306F\u3001 \u3053\u306E\u5B63\u7BC0\u306B\u5C71\u3078\u884C\u3051\u3070 \u898B\u3064\u304B\u308B\u306F\u305A\u3088\u3002",
    "Tue6": "\u308F\u3056\u308F\u3056 \u79C1\u3068\u30B8\u30E7\u30FC\u30B8\u306B \u4F1A\u3044\u306B \u304D\u3066\u304F\u308C\u308B\u306A\u3093\u3066 \u3046\u308C\u3057\u3044\u308F\u3002#$e#\u82E5\u3044\u5B50\u304C \u305D\u3070\u306B \u3044\u306A\u3044\u3068\u3001\u5E74\u3092\u53D6\u308B\u306E\u304C \u65E9\u304F\u611F\u3058\u308B\u306E\u3088\u3002$h",
    "Wed": "#$1 evelynGarden1#\u6628\u65E5\u3001 \u753A\u306E\u516C\u5712\u3067 \u3068\u3066\u3082\u7F8E\u3057\u3044 \u8776\u306E \u3064\u304C\u3044\u304C \u65E5\u5411\u307C\u3063\u3053\u3092 \u3057\u3066\u3044\u308B\u306E\u3092 \u898B\u305F\u308F\u3002$k#$e#\u753A\u9577\u3055\u3093\u304C\u3001 \u3053\u306E\u516C\u5712\u3092 \u79C1\u306B \u4EFB\u305B\u3066\u304F\u3060\u3055\u3063\u3066\u3044\u308B\u306E\u3002#$e#\u4F55\u9031\u9593\u3082\u304B\u3051\u3066\u3001 \u82B1\u58C7\u306E\u304A\u624B\u5165\u308C\u3092\u3057\u3066\u3044\u308B\u304B\u3089\u3001 \u8E0F\u307E\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u3061\u3087\u3046\u3060\u3044\uFF01",
