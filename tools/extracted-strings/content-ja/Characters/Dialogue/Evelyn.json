    "summer_Sun": "\u30B9\u30A4\u30FC\u30C8\u30D4\u30FC\u304C\u54B2\u304F\u5B63\u7BC0\u306D\u3002#$e#\u3059\u3070\u3089\u3057\u3044 \u9999\u308A\u3060\u3068 \u601D\u308F\u306A\u3044\uFF1F",
    "summer_Thu": "\u4ECA\u65E5\u306F \u30AF\u30C3\u30AD\u30FC\u3092 \u713C\u3053\u3046\u3068 \u601D\u3063\u3066\u308B\u306E\u3002\u5C0F\u3055\u306A \u30E4\u30B7\u306E\u6728\u307F\u305F\u3044\u306A \u5F62\u306E \u30B3\u30B3\u30CA\u30C3\u30C4\u30AF\u30C3\u30AD\u30FC\u3088\uFF01\u3075\u3075\u3075\u3002$h#$e#\u8FD1\u3044\u3046\u3061\u306B\u3001 \u4F5C\u308A\u65B9\u3092 \u6559\u3048\u3066\u3042\u3052\u308B\u308F\u306D\u3002",
    "summer_Thu4": "\u30AF\u30C3\u30AD\u30FC\u3092 \u713C\u304D\u59CB\u3081\u308B\u3068\u3001 \u3044\u3064\u3082 \u304A\u5BA2\u69D8\u304C \u5897\u3048\u308B\u3088\u3046\u306A \u6C17\u304C\u3059\u308B\u308F\u306D\u3002#$e#\u6BCD\u304B\u3089 \u4F5C\u308A\u65B9\u3092 \u6559\u308F\u3063\u305F\u306E\u3088\u3002",
    "summer_Tue": "\u590F\u306F\u3044\u3064\u3082\u3001 \u30B8\u30E7\u30FC\u30B8\u306E \u6A5F\u5ACC\u304C \u5C11\u3057 \u826F\u304F\u306A\u308B\u306E\u3088\u3002\u590F\u306E\u6691\u3055\u3067 \u6C17\u304C \u7DE9\u3080\u306E\u3067\u3057\u3087\u3046\u306D\u3002#$e#\u3042\u306A\u305F\u306B\u306F \u5206\u304B\u3089\u306A\u3044\u3067\u3057\u3087\u3046\u3051\u3069\u3001 \u79C1\u306B\u306F\u5206\u304B\u308B\u3002\u3042\u306E\u4EBA\u3068\u306F 60\u5E74\u3082 \u4ED8\u304D\u5408\u3063\u3066\u308B\u304B\u3089\u306D\uFF01",
    "summer_Wed": "\u753A\u9577\u3055\u3093\u304C\u3001 \u3053\u306E\u516C\u5712\u3092 \u79C1\u306B \u4EFB\u305B\u3066\u304F\u3060\u3055\u3063\u3066\u3044\u308B\u306E\u3002#$e#\u4F55\u30F6\u6708\u3082\u304B\u3051\u3066\u3001 \u82B1\u58C7\u306E\u304A\u624B\u5165\u308C\u3092\u3057\u3066\u3044\u308B\u304B\u3089\u3001 \u8E0F\u307E\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u3061\u3087\u3046\u3060\u3044\uFF01",
    "winter_Mon": "\u6C37\u3067\u6ED1\u3089\u306A\u3044\u3088\u3046\u3001 \u6C17\u3092\u3064\u3051\u308B\u306E\u3088\u3002",
    "winter_Sat": "\u79C1\u9054\u306F 30\u5E74\u4EE5\u4E0A \u3053\u3053\u306B \u4F4F\u3093\u3067\u308B\u306E\u3002#$e#\u3044\u308D\u3093\u306A\u4EBA\u3068\u306E \u51FA\u4F1A\u3044\u3068 \u5225\u308C\u3092 \u898B\u3066\u304D\u305F\u308F\u3002\u3042\u306A\u305F\u306E \u304A\u3058\u3044\u3055\u3093\u3082\u306D\u3002\u3042\u306E\u9803\u304C\u61D0\u304B\u3057\u3044\u308F\u2026 \u3075\u3045\u2026",
    "winter_Sat6": "\u3042\u3089\u3001\u3088\u304F\u304D\u3066\u304F\u308C\u305F\u308F\u306D\u3002\u3042\u306A\u305F\u3001\u304A\u3058\u3044\u3055\u3093\u3068 \u540C\u3058\u76EE\u3092 \u3057\u3066\u308B\u306E\u306D\u2026$s#$e#\u3048\u3048\u2026\u3042\u306E\u4EBA\u306E\u3053\u3068\u306F \u3088\u304F\u77E5\u3063\u3066\u305F\u308F\u3002",
    "winter_Sat8": "@\u3001\u30B8\u30E7\u30FC\u30B8\u3068\u4E00\u7DD2\u306B\u3053\u3053\u306730\u5E74\u66AE\u3089\u3057\u305F\u3053\u3068\u306F \u8A71\u3057\u305F\u304B\u3057\u3089\uFF1F#$e#\u3042\u306A\u305F\u3082\u3001 \u3053\u306E\u753A\u306B \u9577\u5C45\u3057\u3066\u304F\u308C\u308B\u3068 \u3044\u3044\u308F\u306D\u3002$h",
    "winter_Sun": "\u4F53\u3092 \u51B7\u3084\u3055\u306A\u3044\u3088\u3046\u3001 \u30B9\u30FC\u30D7\u3092 \u4F5C\u3063\u305F\u307B\u3046\u304C \u3044\u3044\u308F\u3088\u3002#$e#\u3042\u3068\u3001 \u30B8\u30E3\u30B1\u30C3\u30C8\u3082 \u5FD8\u308C\u306A\u3044\u3067\u306D\uFF01",
    "winter_Thu": "\u4ECA\u65E5\u306F\u30AF\u30C3\u30AD\u30FC\u3092\u713C\u3044\u3066\u3044\u308B\u306E\u3088\u3002\u5C0F\u3055\u306A\u51AC\u661F\u306E\u5F62\u306A\u306E\u3088\u3002$h#$e#\u3044\u3064\u304B\u30EC\u30B7\u30D4\u3092\u6559\u3048\u3066\u3042\u3052\u308B\u308F\u306D\u3002",
    "winter_Tue": "\u5BD2\u304F\u306A\u3044\uFF1F\u3082\u3063\u3068 \u539A\u624B\u306E \u30B8\u30E3\u30B1\u30C3\u30C8\u3092 \u7740\u305F\u307B\u3046\u304C\u3044\u3044\u308F\u3088\uFF01#$e#\u3053\u306E\u5BD2\u3055\u306F \u79C1\u306E \u4F53\u306B\u3082 \u826F\u304F\u306A\u3044\u308F\u2026$s",
    "winter_Wed": "\u3044\u3064\u3082 \u82B1\u58C7\u306E\u4E16\u8A71\u3092 \u3057\u3066\u308B\u3051\u3069\u3001 \u4ECA\u306F \u96EA\u3067 \u8986\u308F\u308C\u3066\u3057\u307E\u3063\u3066\u308B\u308F\u3002#$e#\u3067\u3082\u3001 \u69D8\u5B50\u3092\u898B\u306B\u884C\u304F\u306E\u306F \u597D\u304D\u3088\u3002"
  }
}