    "cropMatured_591": "\u81EA\u5206\u3067\u80B2\u3066\u305F\u30C1\u30E5\u30FC\u30EA\u30C3\u30D7\u306F\u6625\u306E\u7D20\u6575\u306A\u8D08\u308A\u7269\u306B\u306A\u308B\u306E\u3088\u3002",
