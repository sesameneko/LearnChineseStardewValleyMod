    "summer_10": "\u3078\u3078\u2026\u660E\u65E5\u306E \u5BC4\u305B\u934B\u306B\u306F \u3072\u3069\u3044\u3082\u306E\u3092 \u3044\u308C\u3066 \u53CD\u5FDC\u3092 \u697D\u3057\u3082\u3046\u304B\u3068 \u601D\u3046\u3093\u3060\u3002\u3082\u3061\u308D\u3093\u3001 \u7121\u5BB3\u306A\u3082\u306E\u3092\u306D\u3002#$e#\u3069\u3046\u3057\u3066 \u53F0\u7121\u3057\u306B \u3059\u308B\u304B\u3063\u3066\uFF1F\u3046\u30FC\u3093\u2026\u5805\u82E6\u3057\u3044 \u793E\u4F1A\u69CB\u9020\u3084 \u6C7A\u307E\u308A\u3054\u3068\u3092 \u3076\u3061\u58CA\u3059\u3053\u3068\u3067 \u89E3\u653E\u3055\u308C\u305F \u6C17\u5206\u306B \u306A\u308B\u4EBA\u3082 \u3044\u308B\u3093\u3060\u308D\u3046\u3002\u305F\u3060 \u30AA\u30EC\u304C \u5909\u306A\u3060\u3051\u304B\u3082 \u3057\u308C\u306A\u3044\u3051\u3069\u3002",
    "summer_27": "\u660E\u65E5\u306F \u307F\u3093\u306A\u3067 \u685F\u6A4B\u306B \u96C6\u307E\u3063\u3066\u3001 \u30AF\u30E9\u30B2\u306E \u5927\u79FB\u52D5\u3092 \u898B\u308B\u3093\u3060\u300210\u6642\u3050\u3089\u3044\u304B\u3089 \u59CB\u307E\u308B\u3068 \u601D\u3046\u3002",
    "summer_Fri": "\u3075\u308F\u3041\u2026 \u3069\u3046\u3082\u3002",
    "summer_Fri6": "\u3084\u3041\u3001 \u6765\u3066\u304F\u308C\u3066 \u3046\u308C\u3057\u3044\u3088\u3002$h#$e#\u304A\u524D\u306F \u3069\u3046\u3084\u3063\u3066 \u6691\u3055\u3092 \u3057\u306E\u3044\u3067\u308B\u3093\u3060\u3044\uFF1F",
    "summer_Mon": "\u307F\u3093\u306A \u6674\u308C\u306E\u65E5\u306F \u5E78\u305B\u305D\u3046\u3060\u306A\u3002\u30AA\u30EC\u306B\u306F \u7406\u89E3\u3067\u304D\u306A\u3044\u3088\u3002",
    "summer_Mon6": "\u3088\u304F \u6674\u308C\u305F \u65E5\u306F \u307F\u3093\u306A \u3059\u3054\u304F \u5E78\u305B\u305D\u3046\u3060\u3088\u306A\u2026#$e#\u4EBA\u306B\u3088\u3063\u3066 \u597D\u307F\u306F \u9055\u3046\u304B\u3089 \u3060\u308D\u3046\u306A\u3002||\u305F\u3044\u3066\u3044\u306E\u4EBA\u9593\u306F\u592A\u967D\u304C\u597D\u304D\u3060\u308D\uFF1F#$b#\u30D3\u30BF\u30DF\u30F3D\u306F\u6700\u4F4E\u9650\u306E\u91CF\u304C\u5FC5\u8981\u3063\u3066\u3053\u3068\u3060\u3088\u306A\u2026",
    "summer_Mountain_58_35": "#$c .5#\u65E5\u304C\u66AE\u308C\u308B\u307E\u3067\u3001 \u5916\u306E \u6C17\u6E29\u306F \u672C\u5F53\u306B \u4E0D\u5FEB\u306A\u3082\u306E\u3055\u3002#$e#\u6C60\u306E \u305D\u3070\u306F \u5C11\u3057 \u6DBC\u3057\u3044\u304B\u306A\u3002",
    "summer_Sat": "\u4ECA\u591C\u306F \u30AD\u30CE\u30B3\u306E \u30AD\u30E3\u30BB\u30ED\u30FC\u30EB \u3058\u3083\u306A\u3044\u3053\u3068\u3092 \u7948\u3063\u3066\u308B\u3088\u2026$s||\u304A\u3044\u304A\u3044\u3001\u591C\u306F\u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u306E\u30BF\u30B3\u30B9\u3060\u3063\u3066\uFF1F \u306F\u3042\u2026$s",
    "summer_Sun": "\u30AA\u30EC\u306F \u666E\u6BB5\u3001 \u6697\u304F\u306A\u3063\u3066\u304B\u3089 \u5916\u3078 \u51FA\u308B\u3093\u3060\u3002\u304A\u524D\u306F \u5909\u3060\u3068 \u601D\u3046\u304B\u3044\uFF1F",
    "summer_Sun4": "\u6628\u6669\u3001 \u30B3\u30A6\u30E2\u30EA\u306E\u7FA4\u308C\u304C \u6C60\u306E\u5468\u308A\u3092 \u98DB\u3093\u3067\u308B\u306E\u3092 \u898B\u305F\u3093\u3060#$e#\u305F\u3076\u3093\u3001 \u3053\u306E\u6642\u671F\u306E \u868A\u3092 \u30A8\u30B5\u306B \u3057\u3066\u308B\u3093\u3058\u3083\u306A\u3044\u306E\u304B\u306A\u3002",
    "summer_Thu": "\u3082\u3057 \u30AA\u30EC\u3092 \u6CF3\u304E\u306B \u8A98\u3063\u3066\u308B\u306E\u306A\u3089\u3001 \u7D76\u5BFE\u306B \u304A\u65AD\u308A\u3060\u3002$s#$e#\u3063\u3066\u3001 \u305F\u3060 \u3042\u3044\u3055\u3064\u3092 \u3057\u305F\u304B\u3063\u305F\u3060\u3051\u304B\uFF1F\u3054\u3081\u3093\u306D\u3002",
    "summer_Thu10": "\u3082\u3057 \u304A\u524D\u304C \u672C\u5F53\u306B \u6CF3\u3050\u306A\u3089\u2026\u50D5\u3082 \u3084\u308B\u304B\u306A\u3002$l",
    "summer_Tue": "\u5BD2\u304F\u3066 \u6E7F\u3063\u305F \u5B63\u7BC0\u304C \u5F85\u3061\u9060\u3057\u3044\u3088\u3002\u305D\u306E\u307B\u3046\u304C \u843D\u3061\u7740\u304F\u3093\u3060\u3002",
    "summer_Tue4": "\u5BD2\u304F\u3066\u6E7F\u3063\u307D\u3044\u5B63\u7BC0\u304C\u5F85\u3061\u9060\u3057\u3044\u3002\u30AA\u30EC\u306F\u30D2\u30AD\u30AC\u30A8\u30EB\u3092\u898B\u7FD2\u3063\u305F\u65B9\u304C\u3044\u3044\u306E\u304B\u3082\u306A\u3002$h",
    "summer_Wed": "\u5916\u3078\u51FA\u308B \u610F\u5473\u306A\u3093\u3066 \u3042\u308B\u306E\u304B\uFF1F\u76EE\u65B0\u3057\u3044\u3082\u306E\u306F \u306A\u3044\u306E\u306B\u3002",
    "summer_Wed10": "\u306A\u305C\u6A5F\u5ACC\u304C\u3088\u3055\u305D\u3046\u306A\u306E\u304B\u3063\u3066\uFF1F\u6700\u8FD1\u3084\u3051\u306B\u3044\u3044\u3053\u3068\u304C\u7D9A\u304F\u3093\u3060\u2026$l",
    "summer_Wed6": "\u843D\u3061\u8FBC\u3093\u3067\u3044\u308B\u3068\u304D\u306F\u3001\u3059\u3079\u3066\u304C\u30D0\u30AB\u30D0\u30AB\u3057\u304F\u601D\u3048\u308B\u3002\u9006\u306B\u8ABF\u5B50\u304C\u3044\u3044\u3068\u304D\u306F\u3001\u3061\u3087\u3063\u3068\u3057\u305F\u3053\u3068\u3067\u3082\u697D\u3057\u304F\u611F\u3058\u308B\u3002#$e#\u8ABF\u5B50\u306E\u3088\u3055\u3092\u4FDD\u3064\u306B\u306F\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3093\u3060\uFF1F\u30AA\u30EC\u306B\u306F\u308F\u304B\u3089\u306A\u3044\u3002#$e#\u2026\u3044\u3064\u306B\u306A\u3063\u305F\u3089\u308F\u304B\u308B\u3093\u3060\u308D\u3046\u306A\u3002",
    "winter_24": "\u4ECA\u65E5\u306F \u51AC\u306E \u661F \u796D\u308A \u3060\u306D\u3002\u7FCC\u65E5\u306E \u3054\u3061\u305D\u3046\u306E \u305F\u3081\u306B\u3001 \u3061\u3083\u3093\u3068 \u8179\u3092 \u7A7A\u3051\u305F\u307B\u3046\u304C \u307B\u3046\u304C \u3044\u3044\u3088\u3002",
    "winter_Fri": "\u7DDA\u8DEF\u306E \u8FD1\u304F\u306B \u4F4F\u3080\u306E\u3063\u3066 \u7D50\u69CB \u697D\u3057\u3044\u3088\u3002\u5916\u306E\u4E16\u754C\u304C \u5B58\u5728\u3059\u308B\u306E\u3092 \u601D\u3044\u51FA\u3055\u305B\u3066 \u304F\u308C\u308B\u304B\u3089\u3055\u3002",
    "winter_Fri8": "\u6614\u3001 \u5217\u8ECA\u306E \u6765\u308B\u97F3\u304C \u805E\u3053\u3048\u305F\u3089 \u7DDA\u8DEF\u307E\u3067 \u884C\u3063\u3066 \u898B\u306B\u884C\u3063\u305F\u3093\u3060\u3002#$e#\u3042\u306E\u65E5\u3005\u306F \u3044\u3063\u305F\u3044 \u3069\u3053\u3078 \u3044\u3063\u305F\u3093\u3060\u308D\u3046\u2026 \u306F\u3041\u2026$s",
    "winter_Mon": "\u3053\u306E \u6697\u3044 \u5929\u6C17\u3092 \u697D\u3057\u3093\u3067\u3044\u308B\u3093\u3060\u2026 \u3067\u3082\u3001 \u5C11\u3057\u5BD2\u3044\u304B\u306A\u3002",
    "winter_Mon4": "\u3082\u3046 \u4F55\u306B \u5BFE\u3057\u3066\u3082 \u9A5A\u304B\u306A\u3044\u3057\u3001 \u4F55\u306B \u5BFE\u3057\u3066\u3082 \u7B11\u3048\u306A\u3044\u3002#$e#\u3042\u3042\u2026\u3061\u3087\u3063\u3068 \u30AB\u30C3\u30B3\u3064\u3051\u3066\u305F \u3060\u3051\u3055\u3002",
    "winter_Mon8": "\u6614\u306E\u81EA\u5206\u3092\u601D\u3044\u51FA\u3057\u3066\u6065\u305A\u304B\u3057\u304F\u306A\u308B\u3053\u3068\u306F\u306A\u3044\u304B\uFF1F#$e#\u305D\u308C\u304C\u6210\u9577\u3063\u3066\u3084\u3064\u306A\u306E\u304B\u3082\u306A\u3002",
    "winter_Sat": "\u51AC\u306F \u30AB\u30A8\u30EB\u306B\u3068\u3063\u3066 \u53B3\u3057\u3044 \u5B63\u7BC0\u3060\u306A\u3002#$e#\u304B\u308F\u3044\u305D\u3046\u306B\u3002$s||\u51AC\u306E\u9593\u3001\u30AB\u30A8\u30EB\u306F\u3069\u3046\u904E\u3054\u3057\u3066\u308B\u3093\u3060\u308D\u3046\u306A\uFF1F \u5BD2\u3055\u3067\u51CD\u3063\u3061\u307E\u3063\u3066\u3001\u6625\u306B\u306A\u3063\u305F\u3089\u89E3\u51CD\u3055\u308C\u308B\u306E\u304B\uFF1F",
    "winter_Sat6": "\u51AC\u306F \u597D\u304D\u3060\u3051\u3069\u3001 \u52D5\u7269\u304C \u5BD2\u304C\u308B\u306E\u3092 \u307F\u308B\u3068 \u6C17\u306E\u6BD2\u306B \u601D\u3048\u308B\u3093\u3060\u3002#$e#\u305F\u3076\u3093\u3001 \u30AA\u30EC\u307F\u305F\u3044\u306B \u6163\u308C\u3066\u308B\u3060\u308D\u3046\u3051\u3069\u3055\u2026",
    "winter_Sun": "\u96EA\u3060\u308B\u307E\u3092 \u4F5C\u3063\u305F\u3051\u3069\u3001 \u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u306B \u51E6\u5206 \u3055\u305B\u3089\u308C\u305F\u3093\u3060\u3002#$e#\u4F55\u304C \u4E0D\u6E80\u306A\u3093\u3060\uFF1F$u",
    "winter_Sun6": "\u96EA\u3060\u308B\u307E\u3092 \u4F5C\u3063\u305F\u3051\u3069\u3001 \u30C7\u30A3\u30E1\u30C8\u30EA\u30A6\u30B9\u306B \u51E6\u5206 \u3055\u305B\u3089\u308C\u305F\u2026 \u3067\u3082 \u30DE\u30EB\u306E \u5C0F\u3055\u306A \u96EA\u3060\u308B\u307E\u306F \u305D\u306E\u307E\u307E\u306A\u3093\u3060\uFF01$a#$e#\u3072\u3069\u3059\u304E\u308B\u3088\u3002",
    "winter_Thu": "\u4ECA\u591C\u306E \u5915\u98DF\u306F \u306A\u3093\u3060\u308D\u3046\u2026 \u3076\u3064\u3076\u3064\u2026$s",
    "winter_Thu6": "\u6599\u7406\u3092 \u899A\u3048\u3088\u3046\u304B\u306A\u3002\u3044\u305A\u308C \u5F79\u306B \u7ACB\u3061\u305D\u3046\u3060\u3002",
    "winter_Tue": "\u3046\u30FC\u3093\u2026\u7279\u306B \u4F55\u3082 \u8A00\u3046\u3053\u3068\u306F \u306A\u3044\u306D\u3002\u304A\u524D\u306E \u3053\u3068\u306F \u3042\u307E\u308A \u77E5\u3089\u306A\u3044\u304B\u3089\u3002",
    "winter_Tue10": "\u30AA\u30EC\u306B \u4F1A\u3044\u306B\u304D\u305F\u306E\u304B\u3044\uFF1F$l#$e#\u2026$h",
    "winter_Tue4": "\u306A\u3041\u2026#$b#\u65B0\u3057\u3044 \u8A71\u984C\u3092 \u8003\u3048\u308B\u306E\u306F \u6642\u3005\u96E3\u3057\u304F \u601D\u3048\u308B\u3093\u3060\u3002\u3044\u304F\u3089 \u76F8\u624B\u306E\u3053\u3068\u3092 \u77E5\u3063\u3066\u3066\u3082\u3055\u3002#$e#\u2026\u3054\u3081\u3093\u306A\u3002",
    "winter_Tue6": "\u6BCD\u3055\u3093\u304C \u30DE\u30F3\u30AC\u306E \u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u3092 \u6368\u3066\u305F\u6642\u3001 \u50D5\u306F \u5927\u58F0\u3092\u4E0A\u3052\u305D\u3046\u306A \u304F\u3089\u3044 \u6012\u3063\u305F\u3088\u2026\u3067\u3082\u3001 \u306A\u305C\u304B \u58F0\u3092 \u51FA\u305B\u306A\u304B\u3063\u305F\u3002#$e#\u3046\u30FC\u3093\u2026 \u3053\u308C\u304C \u5E74\u306E\u529F\u304B\u306A\u3002",
    "winter_Wed": "%\u30BB\u30D0\u30B9\u30C1\u30E3\u30F3\u306F \u7269\u601D\u3044\u306B \u3075\u3051\u3063\u3066\u3044\u308B\u2026",
    "winter_Wed4": "\u306A\u3041\u3001 \u4ED5\u4E8B\u306E\u624B\u3092 \u6B62\u3081\u3066\u307E\u3067 \u30AA\u30EC\u306B \u4F1A\u3046 \u5FC5\u8981\u306F \u306A\u3044\u3093\u3060\u3002#$e#\u5FD9\u3057\u304F\u306A\u304B\u3063\u305F\u3089\u3001 \u4E00\u7DD2\u3067\u3082 \u3044\u3044\u3051\u3069\u3002$h"
  }
}