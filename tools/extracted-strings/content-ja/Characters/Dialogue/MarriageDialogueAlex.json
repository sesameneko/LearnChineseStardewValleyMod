    "Good_0": "@\u2026\u3044\u3064\u3082 \u611B\u3057\u3066\u308B\u305C\u3002$l",
    "Good_1": "\u304A\u524D\u3001 \u672C\u5F53\u306B \u30CF\u30F3\u30B5\u30E0\u3060\u2026 \u524D\u306B\u3082 \u305D\u3046 \u8A00\u3063\u305F\u304B\u306A\uFF1F$l^\u304A\u524D\u3001 \u672C\u5F53\u306B \u30AD\u30EC\u30A4\u3060\u2026 \u524D\u306B\u3082 \u305D\u3046 \u8A00\u3063\u305F\u304B\u306A\uFF1F$l",
    "Good_6": "\u304A\u524D\u306E \u5F37\u3055\u306F \u5206\u304B\u3063\u3066\u308B\u304C\u3001 \u6642\u3005 \u30B9\u30E9\u30A4\u30E0\u306B \u98DF\u308F\u308C\u305F\u308A\u2026 \u9177\u3044\u76EE\u306B \u3042\u3063\u305F\u308A \u3057\u306A\u3044\u304B \u5FC3\u914D\u306A\u3093\u3060\u3002\u3068\u306B\u304B\u304F \u6C17\u3092\u3064\u3051\u3066\u304F\u308C\u3002$9",
    "Indoor_Day_0": "\u3042\u3042\u2026 \u592B\u3068 \u4E00\u7DD2\u306B \u30B0\u30C3\u30B9\u30EA \u5BDD\u308B\u306E\u306F \u6700\u9AD8\u3060\u306A\uFF01$h^\u3042\u3042\u2026 \u59BB\u3068 \u4E00\u7DD2\u306B \u30B0\u30C3\u30B9\u30EA \u5BDD\u308B\u306E\u306F \u6700\u9AD8\u3060\u306A\uFF01$h",
    "Indoor_Day_1": "\u306A\u3041\uFF01\u6696\u304B\u3044 \u671D\u98DF\u3092 \u4F5C\u3063\u305F\u305E\u3002[195 210 211]#$e#\u5F37\u304F\u306A\u308A\u305F\u3051\u308C\u3070\u3001 \u3061\u3083\u3093\u3068 \u98DF\u4E8B\u3092 \u53D6\u308D\u3046\u305C\uFF01",
    "Indoor_Day_2": "\u3053\u3063\u3061\u3078 \u304D\u3066\u304F\u308C\u3002 \u30AE\u30E5\u30FC\u30C3\u2026\u3075\u3080\u3075\u3080\u3002\u7267\u5834\u3067\u306E \u4ED5\u4E8B\u3067\u3001 \u4F53\u304C \u7DE0\u307E\u3063\u3066\u304D\u3066\u308B\u306A\u3002",
    "Indoor_Day_3": "\u6599\u7406\u3068 \u6D17\u6FEF\u306B \u5C11\u3057\u305A\u3064 \u6163\u308C\u3066\u304D\u305F\u305E\u2026\u30AA\u30EC\u304C\u672C\u5F53\u306B \u3084\u308A\u305F\u3044\u3053\u3068\u3068\u306F \u9055\u3046\u3051\u3069\u3001 \u7D50\u5A5A\u3059\u308B\u6642\u304B\u3089 \u3053\u3046\u3044\u3046\u306E\u3092 \u3084\u308B\u3093\u3060\u308D\u3046\u306A\u3063\u3066 \u601D\u3063\u3066\u305F\u3055\u3002$h",
    "Indoor_Day_4": "\u4ECA\u65E5\u306F \u5BB6\u306E\u307E\u308F\u308A\u306E \u3082\u306E\u3092 \u76F4\u3057\u306B \u3044\u304F\u3064\u3082\u308A\u3055\u3002\u98FD\u304D\u3066\u306F\u3044\u306A\u3044\u304B\u3089\u3001 \u30AA\u30EC\u306E\u3053\u3068\u306F \u5FC3\u914D\u3059\u308B\u306A\u3002",
    "Indoor_Night_0": "\u9650\u754C\u307E\u3067 \u304C\u3093\u3070\u308B\u3063\u3066 \u3044\u3044\u6C17\u5206\u306B \u306A\u3089\u306A\u3044\u304B\uFF1F\u304C\u3093\u3070\u3063\u305F\u5F8C\u306F \u3084\u308F\u3089\u304B\u3044\u30D9\u30C3\u30C9\u3067 \u826F\u304F\u7720\u308C\u308B \u6A29\u5229\u3092 \u5F97\u305F\u6C17\u306B \u306A\u308B\u304B\u3089\u306A\u3002",
    "Indoor_Night_1": "\u9AEA\u3067\u3082 \u5207\u3063\u305F\u306E\u304B\uFF1F\u4ECA\u65E5\u306F \u3044\u3044\u611F\u3058\u3060\u306A\u3002\u305F\u3076\u3093\u3001 \u65B0\u9BAE\u306A \u7A7A\u6C17\u306E\u304A\u304B\u3052 \u304B\u3082\u306A\u2026$l",
    "Indoor_Night_2": "\u4ECA\u65E5\u306F \u3069\u3093\u306A\u4E00\u65E5 \u3060\u3063\u305F\u304B\u306A\u3002\u305F\u307E\u306B\u306F \u62B1\u3048\u3066\u308B\u3082\u306E\u3092 \u5168\u90E8 \u964D\u308D\u3059\u306E\u3082 \u3044\u3044\u3053\u3068\u3060\u3002",
    "Indoor_Night_3": "\u306A\u3041\u2026\u65B0\u3057\u3044 \u30D1\u30F3\u30C4\u306B \u3057\u305F\u305C\u3002\u304A\u524D\u304C \u8208\u5473\u3042\u308B\u3068 \u601D\u3063\u3066\u306A\u2026$l",
    "Indoor_Night_4": "\u4E00\u4EBA\u304D\u308A\u306E \u9759\u304B\u306A\u3072\u3068\u6642\u304C \u307B\u3057\u304B\u3063\u305F\u3089\u3001 \u30AA\u30EC\u306F \u304B\u307E\u308F\u306A\u3044\u305C\u3002",
    "OneKid_0": "\u307E\u3060 \u5C02\u696D\u4E3B\u592B\u3068\u3057\u3066\u306E \u751F\u6D3B\u306B \u6163\u308C\u3088\u3046\u3068 \u3057\u3066\u308B\u3068\u3053\u308D\u3055\u3002$h",
    "OneKid_1": "\u5C0F\u3055\u3044 %kid1\u3088\u3001 \u30D1\u30D1\u307F\u305F\u3044\u306B \u5F37\u304F \u80B2\u3064\u3093\u3060\u305E\u3002",
    "OneKid_3": "\u598A\u5A20\u3057\u3066\u308B \u6642\u3063\u3066 \u3069\u3093\u306A \u6C17\u5206 \u306A\u3093\u3060\u308D\u3046\u304B\u2026$h",
    "Outdoor_0": "\u306D\u3047\u3001\u3053\u3053\u304B\u3089 \u30AA\u30EC\u9054\u306E \u571F\u5730\u3092 \u898B\u4E0B\u308D\u3059\u3068\u2026\u3059\u3054\u304F \u8A87\u3089\u3057\u304F \u601D\u3048\u308B\u305C\u3002\u672C\u5F53\u306B \u826F\u3044\u4ED5\u4E8B\u3092 \u3057\u305F\u306A\u3002",
    "Outdoor_1": "\u3053\u3053\u306F \u5B50\u3069\u3082\u3092 \u80B2\u3066\u308B\u306B\u306F \u6700\u9AD8\u306E \u5834\u6240\u3060\u306A\u3002\u30AA\u30EC\u3082 \u3053\u3093\u306A \u5834\u6240\u3067 \u80B2\u3061\u305F\u304B\u3063\u305F\u305C\u3002\u8D70\u308A\u56DE\u308C\u308B\u307B\u3069 \u90E8\u5C4B\u304C \u5E83\u3044\u304B\u3089\u306A\uFF01",
    "Outdoor_2": "\u30AA\u30EC\u306F \u3067\u304D\u308B\u3060\u3051 \u5916\u306B \u51FA\u3066\u3044\u305F\u3044\u3093\u3060\u3002\u305D\u306E\u307B\u3046\u304C \u6C17\u5206\u304C \u3044\u3044\u304B\u3089\u3055\u3002",
    "Outdoor_3": "\u7267\u5834\u306B\u3044\u308B\u3001 \u30AA\u30EC\u9054\u4E8C\u4EBA\u3092 \u898B\u308D\u3088\u3002\u3044\u3044 \u30AB\u30C3\u30D7\u30EB \u3058\u3083\u306A\u3044\u304B\u3002$h^\u306A\u3041\u3002\u305F\u3076\u3093 \u65E5\u306E\u5149\u306B \u6620\u3063\u3066\u308B\u304B\u3089\u304B\u3001 \u4ECA\u65E5\u306F \u304A\u524D\u304C \u7F8E\u3057\u304F \u898B\u3048\u308B\u3002$l",
    "Outdoor_4": "\u3042\u3042\u2026\u5916\u306B \u51FA\u308B\u3068 \u3044\u3044\u6C17\u5206\u306B \u306A\u308B\u308F\u3002\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306F \u6700\u9AD8\u306B \u7F8E\u3057\u3044\u5834\u6240\u3060\u2026",
    "Rainy_Day_0": "\u3053\u308C\u3060\u3051 \u5E83\u304B\u3063\u305F\u3089\u3001 \u5168\u8EAB\u904B\u52D5\u3082 \u30E9\u30AF\u306B \u3067\u304D\u308B\u305C\u3002",
    "Rainy_Day_1": "\u753A\u306B \u53CB\u9054\u306A\u3093\u3066 \u3042\u3093\u307E\u308A \u3044\u306A\u304F\u3066\u306A\u2026\u3082\u3057 \u304A\u524D\u304C \u6765\u306A\u304B\u3063\u305F\u3089 \u30AA\u30EC\u306F \u3069\u3046\u306A\u3063\u3066\u305F\u3093\u3060\u308D\u3046\u3001\u3068 \u8003\u3048\u308B \u6642\u304C \u3042\u308B\u3093\u3060\u3002$9",
    "Rainy_Day_2": "\u3042\u3042\u2026\u5916\u3067 \u30B8\u30E7\u30AE\u30F3\u30B0 \u3057\u3088\u3046\u3068 \u601D\u3063\u3066\u305F\u306E\u306B\u3002\u3053\u3093\u306A\u5929\u6C17\u3058\u3083 \u7121\u7406\u3060\u306A\u3002",
    "Rainy_Day_3": "\u30D6\u30C4\u30D6\u30C4\u2026\u8D77\u304D\u305F \u3070\u304B\u308A\u306A\u306E\u306B \u30D7\u30ED\u30C6\u30A4\u30F3\u304C \u307B\u3057\u304F\u306A\u3063\u3066\u304D\u305F\u305C\u3002$9",
    "Rainy_Day_4": "\u305D\u308D\u305D\u308D \u8AAD\u66F8\u3092 \u306F\u3058\u3081\u3088\u3046\u304B\u306A\u3002\u30AA\u30EC\u306F\u3082\u3046 \u7D50\u5A5A\u3057\u305F\u3093\u3060\u304B\u3089\u3001 \u3061\u3083\u3093\u3068 \u4F55\u304B \u3057\u306A\u3044\u3068\u306A\uFF01",
    "Rainy_Night_0": "\u3044\u3044\u4E00\u65E5 \u3060\u3063\u305F\u304B\uFF1F\u660E\u65E5\u306F \u3082\u3063\u3068 \u3044\u3044\u65E5\u306B \u306A\u308B\u306F\u305A\u3055\u3002$h",
    "Rainy_Night_1": "\u8ABF\u5B50\u306F \u3069\u3046\u3060\uFF1F\u30AA\u30EC\u306F \u3044\u3064\u3082 \u53E4\u3044 \u30B0\u30EA\u30C3\u30C9\u30DC\u30FC\u30EB\u3092 \u6301\u3061\u6B69\u3044\u3066\u308B\u305C\u3002\u9078\u624B\u306B\u306A\u3063\u305F \u6C17\u5206\u3067 \u3044\u305F\u3044\u304B\u3089\u306A\u2026$u",
    "Rainy_Night_2": "\u3048\u3063\u2026 \u3053\u306E\u5302\u3044\u306F\u3001\u3063\u3066\uFF1F\u305A\u3063\u3068 \u30CB\u30F3\u30CB\u30AF\u3092 \u98DF\u3079\u3066\u305F\u304B\u3089\u3060\u306A\u3002\u7537\u3089\u3057\u304F \u306A\u308A\u305F\u304F\u3066\u3055\u2026\u3054\u3081\u3093\u306D\u3002$l",
    "Rainy_Night_3": "\u30C0\u30B9\u30C6\u30A3\u306E \u305F\u3081\u306B \u5C11\u3057\u3060\u3051 \u6B8B\u3057\u3066\u308B\u3093\u3060\u3002\u3042\u3044\u3064\u306B\u3082 \u6642\u3005 \u30A8\u30B5\u3092 \u4E0E\u3048\u306A\u3044\u3068\u306A\u3002",
    "Rainy_Night_4": "\u8179\u304C \u6E1B\u3063\u3066\u305F\u304B\u3089\u3001 \u5915\u98DF\u3092 \u4F5C\u3063\u3066\u305F\u3093\u3060\u3002\u304A\u524D\u306E \u5206\u3082 \u3068\u3063\u3066\u3042\u308B\u305C\u3002[241 242 225 214 198]$h",
    "TwoKids_2": "\u3044\u305A\u308C %kid2\u306F \u30DA\u30EA\u30AB\u30F3\u30BF\u30A6\u30F3\u521D\u306E \u30D7\u30ED \u30B0\u30EA\u30C3\u30C9\u30DC\u30FC\u30EB \u9078\u624B\u306B \u306A\u308B\u306E\u304B\u306A\uFF1F$h",
    "TwoKids_3": "\u30AA\u30EC\u304C \u30AC\u30AD\u306E\u9803\u306B \u6301\u3066\u306A\u304B\u3063\u305F \u5BB6\u65CF\u3063\u3066\u3082\u306E\u3092 \u3088\u3046\u3084\u304F \u6301\u3064\u3053\u3068\u304C \u3067\u304D\u305F\u3088\u2026 \u3042\u308A\u304C\u3068\u306A\u3002$l",
    "fall_1": "\u590F\u306F \u7D42\u308F\u3063\u305F\u304C\u2026 \u30DD\u30B8\u30C6\u30A3\u30D6\u306B \u8003\u3048\u3088\u3046\u3002\u590F\u306F \u304B\u306A\u3089\u305A \u623B\u3063\u3066\u304F\u308B \u3063\u3066\u306A\u3002",
    "fall_15": "\u660E\u65E5\u306F \u796D\u308A\u3060\u304C\u3001 \u884C\u304F\u4E88\u5B9A\u306F \u3042\u308B\u306E\u304B\uFF1F#$e#\u30AA\u30EC\u306F \u3069\u3063\u3061\u3067\u3082 \u3044\u3044\u305C\u3002",
    "fall_26": "\u3058\u3044\u3061\u3083\u3093\u3068 \u3070\u3042\u3061\u3083\u3093\u306F \u5143\u6C17\u304B\u306A\u3002\u3058\u3044\u3061\u3083\u3093\u306F \u304B\u307E\u3069\u306E \u706B\u3092 \u30AE\u30EA\u30AE\u30EA\u307E\u3067 \u7BC0\u7D04 \u3059\u308B\u307B\u3069 \u30B1\u30C1\u3060\u304B\u3089\u306A\u3002",
    "funLeave_Alex": "\u4ECA\u65E5\u306F \u753A\u3078 \u884C\u304F\u3064\u3082\u308A\u3055\u3002\u307E\u305F \u591C\u306B \u4F1A\u3044\u307E\u3057\u3087\u3046\u3002",
    "funReturn_Alex": "\u4ECA\u65E5\u306F \u826F\u3044 \u4E00\u65E5\u3060\u3063\u305F\u3002\u3058\u3044\u3061\u3083\u3093\u3068 \u3070\u3042\u3061\u3083\u3093\u3001 \u7D50\u69CB \u5E74\u3044\u3063\u3066\u308B\u304B\u3089 \u4F55\u5EA6\u3082 \u9854\u3092 \u898B\u305B\u305F\u304F \u306A\u308B\u3093\u3060\u3002",
    "patio_Alex": "\u3075\u3046\u3063\u20261\u2026\u3050\u3046\u3063\u20262\u2026\u5916\u3067\u3059\u308B\u7B4B\u30C8\u30EC\u3063\u3066\u306E\u306F\u6C17\u5206\u304C\u3044\u3044\u306A\uFF01$6",
    "spring_1": "\u3084\u3063\u3068 \u96EA\u304C \u6EB6\u3051\u3066\u3001 \u65E5\u304C \u3067\u3066\u304D\u305F\u304B\uFF01\u4F53\u3082 \u6696\u307E\u3063\u3066\u304D\u305F\u305C\u3002$h",
    "spring_12": "\u660E\u65E5\u306E \u796D\u308A\u3092 \u697D\u3057\u307F\u306B\u3057\u3066\u308B\u306E\u304B\uFF1F\u30A8\u30C3\u30B0\u3092 \u4E00\u676F \u96C6\u3081\u308B\u306E\u306F \u697D\u3057\u3044\u3082\u3093\u306A\u3002",
    "spring_23": "\u3042\u3042\u2026 \u660E\u65E5\u306F \u30D5\u30E9\u30EF\u30FC\u30C0\u30F3\u30B9 \u3060\u3063\u305F\u304B\uFF1F\u4ECA\u591C\u306F \u3082\u3046\u5C11\u3057 \u8155\u7ACB\u3066\u3092 \u3057\u3088\u3046\u3002$9#$e#\u30B8\u30E3\u30F3\u30D7\u30B9\u30FC\u30C4\u306F \u7D50\u69CB \u304D\u3064\u3044\u3057\u3001 \u307F\u3093\u306A\u306B \u8FD1\u304F\u304B\u3089 \u898B\u3089\u308C\u308B\u304B\u3089\u306A\u3002",
    "spring_6": "\u30B9\u30BF\u30FC\u30C9\u30ED\u30C3\u30D7\u306E \u7C89\u306A\u3089 \u30AA\u30EC\u306E \u4F53\u3082 \u5F37\u304F\u306A\u308C\u308B\u306E \u3060\u308D\u3046\u304B\u2026",
    "summer_1": "\u590F\u306F \u30A8\u30CD\u30EB\u30AE\u30C3\u30B7\u30E5\u306A \u6642\u671F\u3060\u3002 \u4F53\u304C \u305D\u3046 \u611F\u3058\u308B\u3088\u306A\uFF01\u8EAB\u304C \u5F15\u304D\u7DE0\u307E\u308B \u6C17\u304C \u3059\u308B\u305C\u3002",
    "summer_10": "\u4ECA\u591C\u306E \u30EB\u30A2\u30A6\u30B9\u30FC\u30D7\u306B \u4F55\u3092 \u5165\u308C\u308B\u304B \u8003\u3048\u305F\u304B\uFF1F#$e#\u30AA\u30EC\u306F \u4F55\u304C \u3044\u3044\u304B \u5206\u304B\u3089\u306A\u3044\u304C\u306A\u2026 \u304A\u524D\u304C \u6C7A\u3081\u3066\u304F\u308C\uFF01$h",
    "summer_27": "\u3042\u3042\u2026 \u590F\u304C \u3082\u3046\u3059\u3050 \u7D42\u308F\u308A\u305D\u3046\u3060\u3002\u7B4B\u8089\u304C \u3057\u307C\u3093\u3067\u3044\u304F \u611F\u3058\u304C \u3059\u308B\u305C\u2026$s",
