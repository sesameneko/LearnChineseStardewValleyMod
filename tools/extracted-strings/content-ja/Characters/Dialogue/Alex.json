    "winter_Fri": "\u30AA\u30EC\u306B\u4F1A\u3046\u305F\u3081\u306B\u3001 \u308F\u3056\u308F\u3056\u3053\u306E\u96EA\u306E\u4E2D\u3092 \u3084\u3063\u3066\u304D\u305F\u306E\u304B\uFF1F#$e#\u306A\u308B\u307B\u3069\u306A\u3002",
