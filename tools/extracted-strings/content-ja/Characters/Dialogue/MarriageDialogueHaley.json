  "entries": {
    "Indoor_Day_0": "\u304A\u306F\u3088\u3046\uFF01\u6628\u6669\u306F \u3088\u304F \u7720\u308C\u305F\uFF1F$h#$e#\u4ECA\u65E5\u306F \u660E\u308B\u3044 \u826F\u3044\u65E5\u3060\u304B\u3089\u3001 \u53E4\u3044 \u30AB\u30E1\u30E9\u3092 \u5F15\u3063\u5F35\u308A\u51FA\u305D\u3046\u304B\u306A\u3063\u3066\u601D\u3063\u3066\u308B\u306E\u3002",
    "Indoor_Day_1": "\u304A\u306F\u3088\u3046\u3001 \u3042\u306A\u305F\uFF01\u3044\u3044 \u5302\u3044\u3067\u3057\u3087\uFF1F\u671D\u3054\u306F\u3093\u3092 \u4F5C\u3063\u305F\u306E\u3088\uFF01[194 195 210 211 216]#$e#\u4ED5\u4E8B\u3067 \u5FD9\u3057\u3044\u306E\u306F \u5206\u304B\u3063\u3066\u308B\u3002\u3067\u304D\u308B\u9650\u308A\u306E \u3053\u3068\u3067 \u3042\u306A\u305F\u3092 \u652F\u3048\u3066\u3042\u3052\u308B\u308F\uFF01",
    "Indoor_Day_2": "\u3061\u3083\u3093\u3068 \u7720\u308C\u305F\uFF1F\u5C11\u3057 \u3044\u3073\u304D\u3092 \u304B\u3044\u3066\u305F\u308F\u3088\u3002$h#$e#\u3053\u308C\u304B\u3089 \u5C11\u3057 \u3084\u308B\u3053\u3068\u304C \u3042\u308B\u306E\u3002\u3088\u3044 \u4E00\u65E5\u3092\u3002",
    "Indoor_Day_3": "\u6383\u9664\u304C \u3053\u3093\u306A\u306B \u697D\u3057\u3044\u3068\u306F \u601D\u308F\u306A\u304B\u3063\u305F\u308F\uFF01\u3053\u306E\u5BB6\u306F \u3059\u3050 \u6C5A\u308C\u3061\u3083\u3046\u304B\u3089\u3002$10#$e#\u4F55\u3082\u304B\u3082 \u30D4\u30AB\u30D4\u30AB\u306B \u306A\u308B\u307E\u3067\u6383\u9664\u3059\u308B\u306E\u3063\u3066 \u6E80\u8DB3\u3044\u304F\u3088\u306D\u3002#$e#\u304A\u51FA\u304B\u3051\u306E \u30AD\u30B9\u3001 \u3044\u3044\u304B\u306A\uFF1F$11",
    "Indoor_Day_4": "\u304A\u306F\u3088\u3046\u3002\u4ECA\u65E5\u3082 \u307E\u305F \u7267\u5834\u3067 \u304A\u4ED5\u4E8B\uFF1F#$e#\u79C1\u306F \u3042\u306A\u305F\u306E \u3053\u3068\u3001 \u60F3\u3063\u3066\u308B\u308F\u3088\u3002 \u2661$h",
    "Indoor_Day_Haley": "\u3042\u306A\u305F\u306B \u4F1A\u3046\u307E\u3067\u3001 \u4EBA\u751F\u306E \u76EE\u6A19\u3063\u3066 \u3082\u306E\u304C \u306A\u3044\u611F\u3058 \u3060\u3063\u305F\u308F\u3002\u3067\u3082 \u4ECA\u306F \u5C06\u6765\u306E\u5922\u304C \u3042\u308B\u306E\u3002$l",
    "Indoor_Night_Haley": "\u4ED5\u4E8B\u3067 \u75B2\u308C\u3066\u3044\u308B \u3088\u3046\u306B \u898B\u3048\u308B\u308F\u3002\u7652\u3057\u3066\u3042\u3052\u308B\u308F\u3088\u3002$l",
    "OneKid_3": "\u5909\u306A \u611F\u3058\u3060\u3068 \u601D\u308F\u306A\u3044\uFF1F\u6BCD\u89AA\u306B \u306A\u308B\u306A\u3093\u3066 \u521D\u3081\u3066\u3088\u3002",
    "Outdoor_0": "\u5916\u3067 \u65B0\u9BAE\u306A \u7A7A\u6C17\u3092 \u3059\u3046\u3068 \u3044\u3044 \u6C17\u5206\u306B \u306A\u308C\u308B\u308F\u3002#$b#\u3042\u306A\u305F\u306E \u304A\u3058\u3044\u3055\u3093\u306E \u30B3\u30C6\u30FC\u30B8\u3060\u3063\u3066 \u306A\u304B\u306A\u304B \u3044\u3044\u6240\u3088\uFF01\u3067\u3082 \u3053\u306E \u7F8E\u3057\u3044 \u571F\u5730\u306F \u6700\u9AD8\u306D\u3002",
    "Outdoor_1": "\u7267\u5834\u3092 \u304B\u308F\u3044\u3044 \u611F\u3058\u306B \u3057\u306A\u304D\u3083\uFF01\u305D\u308C\u3063\u3066 \u91CD\u8981\u306A\u3053\u3068\u3060\u3068\u60F3\u3046\u306E\u2026 \u305D\u3046\u3067\u3057\u3087\u3001\u3042\u306A\u305F\uFF1F",
    "Outdoor_2": "\u3084\u3041\u3001\u30CF\u30CB\u30FC\u3002\u30AA\u30EC\u304C \u3082\u3063\u3068 \u8FB2\u696D\u306E\u3053\u3068\u3092 \u77E5\u3063\u3066\u305F\u3089\u3001 \u304A\u524D\u3092 \u624B\u4F1D\u3048\u305F\u3093\u3060\u304C\u3002\u3054\u3081\u3093\u3088\u3002#$e#\u541B\u306E\u3053\u3068\u3092 \u8003\u3048\u3066\u308B\u304B\u3089\u3002$h",
    "Outdoor_3": "\u3061\u3087\u3046\u3069 \u3053\u306E\u8FBA\u3092 \u6383\u9664\u3057\u3088\u3046\u3068 \u3057\u3066\u305F\u3093\u3060\u3002\u541B\u304C \u52A9\u304B\u308B\u3060\u308D\u3046\u3068 \u601D\u3063\u3066\u306D\u3002#$e#\u3075\u3045\u2026 \u5916\u306F \u6691\u3044\u306A\u3002",
    "Outdoor_4": "\u3042\u307E\u308A \u50CD\u304D\u3059\u304E\u306A\u3044\u3067\u306D\u3002#$e#\u3061\u3083\u3093\u3068\u3001 \u5B9A\u671F\u7684\u306A \u4F11\u606F\u3084 \u98DF\u4E8B\u3092 \u53D6\u308B\u3088\u3046\u306B \u3059\u308B\u3093\u3060\u3088\u3002$h",
    "Outdoor_Haley": "\u65E5\u713C\u3051\u3059\u308B\u306B\u306F \u3044\u3044 \u65E5\u306D\u3002 \u3042\u306A\u305F\u306F \u305D\u3046\u601D\u308F\u306A\u3044\u304B\u3057\u3089\uFF1F",
    "Rainy_Day_0": "\u7269\u306E\u898B\u65B9\u306F \u7D50\u69CB \u5909\u308F\u3063\u305F\u3051\u3069\u3001 \u96E8\u3088\u308A \u6674\u308C\u306E \u307B\u3046\u304C \u307E\u3060\u597D\u304D\u3060\u308F\u3002",
    "Rainy_Day_1": "\u6642\u3005\u3001 \u5F15\u9000\u5F8C\u306E \u751F\u6D3B\u3063\u3066\u306E\u3092 \u8003\u3048\u308B\u306E\u2026 \u30D5\u30A7\u30FC\u30F3\u8AF8\u5CF6\u306E \u30D3\u30FC\u30C1\u3067 \u304F\u3064\u308D\u3044\u3067\u308B \u59FF\u3092\u306D\uFF01#$e#@\u306F \u672A\u6765\u306E\u3053\u3068\u3092 \u8003\u3048\u305F\u3053\u3068\u306F \u3042\u308B\uFF1F",
    "Rainy_Day_2": "\u304A\u306F\u3088\u3046\uFF01\u65E9\u304F\u306B \u8D77\u304D\u3066\u3001 \u304A\u83D3\u5B50\u3092 \u713C\u3044\u3066\u3042\u3052\u305F \u308F\u3088\uFF01[223 234 211 651 731]#$e#\u3042\u306A\u305F\u306F \u5F37\u3044\u4EBA\u3060\u3063\u3066 \u5206\u304B\u3063\u3066\u308B\u3051\u3069\u3001 \u3061\u3083\u3093\u3068 \u98DF\u3079\u306A\u304D\u3083\uFF01$h",
    "Rainy_Day_3": "\u4ECA\u65E5\u306F \u5916\u3078 \u51FA\u3089\u308C\u306A\u3044\u308F\u2026 \u9AEA\u304C \u4E71\u308C\u3061\u3083\u3046\u3082\u306E\u3002\u3054\u3081\u3093\u306D\u3002$s#$e#\u3042\u306A\u305F\u306B\u306F \u30AD\u30EC\u30A4\u306A\u59FF\u306E\u307E\u307E\u3067 \u3044\u305F\u3044\u304B\u3089\u3002",
    "Rainy_Day_4": "\u3053\u3093\u306A \u5929\u6C17\u306A\u306E\u306B \u5916\u3078 \u51FA\u308B\u306E\uFF1F\u5BB6\u306B \u4E0A\u304C\u308B\u3068\u304D\u306F \u3061\u3083\u3093\u3068 \u6FE1\u308C\u305F \u9774\u3092 \u62ED\u304F\u306E\u3088\u3002#$e#\u79C1\u306F \u5916\u3078 \u51FA\u306A\u3044\u3067 \u5BB6\u4E8B\u3092 \u3084\u308B\u308F\u3002",
    "Rainy_Day_Haley": "\u3042\u3042\u2026\u3053\u3093\u306A\u5929\u6C17\u304C \u7D9A\u3044\u305F\u3089 \u3084\u3063\u3066\u3089\u308C\u306A\u3044\u308F\u3002$s",
    "Rainy_Night_0": "\u304A\u304B\u3048\u308A\u306A\u3055\u3044\u3001\u3042\u306A\u305F\u3002\u4E00\u4EBA\u3058\u3083 \u3068\u3066\u3082 \u5BD2\u304B\u3063\u305F\u306E\u2026\u660E\u304B\u308A\u3092 \u5207\u308B \u6E96\u5099\u306F \u3067\u304D\u305F\u304B\u3057\u3089\uFF1F",
    "Rainy_Night_1": "\u660E\u65E5\u306F \u3044\u3044 \u6674\u308C\u306E\u65E5\u306B \u306A\u3063\u3066\u304F\u308C\u308B\u3068\u3044\u3044\u306A\u3002\u96E8\u3070\u3063\u304B\u308A\u3060\u3068 \u6C17\u5206\u304C \u843D\u3061\u8FBC\u3093\u3058\u3083\u3046\u3002$s",
    "Rainy_Night_2": "\u30A8\u30DF\u30EA\u30FC\u304C \u4E00\u4EBA\u304D\u308A\u3067 \u3055\u3073\u3057\u304F\u306A\u3044\u304B\u3057\u3089\u3002\u8FD1\u3044\u3046\u3061\u306B \u4F1A\u3044\u306B \u884C\u3053\u3046\u304B\u306A\u3002$7",
    "Rainy_Night_3": "\u96E8\u306F \u5199\u771F\u5BB6\u306B \u3068\u3063\u3066\u306F \u3064\u3089\u3044 \u65E5\u3088\u306D\u3002\u7167\u660E\u306F \u30B5\u30A4\u30A2\u30AF\u3060\u3057\u3001 \u5916\u3078 \u51FA\u305F\u3089 \u6A5F\u5668\u304C \u3073\u3057\u3087\u306C\u308C\u306B \u306A\u3063\u3061\u3083\u3046\u304B\u3089\uFF01$s",
    "Rainy_Night_4": "\u6696\u304B\u3044 \u3054\u98EF\u3092 \u4F5C\u3063\u305F\u308F\u3088\u3002\u3042\u306A\u305F \u597D\u307F\u306B \u306A\u308B\u3088\u3046\u3001 \u5473\u4ED8\u3051\u3092 \u3057\u305F\u308F\u3002\u3069\u3046\u305E \u53EC\u3057\u4E0A\u304C\u308C\uFF01[727 231 207 199]$h",
    "Rainy_Night_5": "\u7530\u820E\u66AE\u3089\u3057\u304C \u3053\u3093\u306A\u306B \u79C1\u306B \u4F3C\u5408\u3046\u306A\u3093\u3066\u3001 \u4ECA\u307E\u3067 \u60F3\u50CF\u3082 \u3067\u304D\u306A\u304B\u3063\u305F\u308F\u3002$h",
    "Rainy_Night_Haley": "\u3042\u3089\u3002\u304A\u304B\u3048\u308A\u306A\u3055\u3044\u3002\u3055\u3073\u3057\u3044\u3063\u3066 \u601D\u3044\u59CB\u3081\u305F \u3068\u3053\u308D\u3060\u3063\u305F\u306E\u3088\u3002$l",
    "TwoKids_2": "%kid2\u3063\u3066\u3001 \u3068\u3063\u3066\u3082 \u304B\u308F\u3044\u304F\u306A\u3044\u304B\u3057\u3089\uFF1F",
    "TwoKids_3": "\u4F4F\u307F\u3084\u3059\u3044\u5BB6\u3001 \u30B9\u30C6\u30AD\u306A\u4E8C\u4EBA\u306E \u5B50\u3069\u3082\u3001\u3059\u3070\u3089\u3057\u3044 \u571F\u5730\u3002\u3053\u308C\u4EE5\u4E0A \u4F55\u3092 \u671B\u3081\u3070 \u3044\u3044\u306E\u304B\u3057\u3089\u306D\u3002",
    "fall_1": "\u79CB\u306F \u4F55\u3082\u304B\u3082 \u6B7B\u3093\u3067\u3044\u304F\u3001 \u60B2\u3057\u3044 \u5B63\u7BC0\u3060\u3068 \u601D\u3046\u306E\u3002$5",
    "fall_2": "\u3059\u3067\u306B \u590F\u304C \u604B\u3057\u3044\u308F\u2026",
    "fall_Haley": "\u590F\u306E\u307B\u3046\u304C \u597D\u304D\u3060\u3051\u3069\u3001 \u79CB\u306F \u5199\u771F\u3092\u64AE\u308B\u306B\u306F \u4E00\u756A\u306E \u5B63\u7BC0\u304B\u3082\u3002\u3042\u306E \u9577\u304F\u3066 \u4F4E\u3044 \u5F71\u3092\u306D\u2026",
    "funLeave_Haley": "\u4ECA\u65E5\u306F \u753A\u3067 \u307F\u3093\u306A\u3068 \u89E6\u308C\u5408\u304A\u3046\u304B\u3057\u3089\u3002",
    "funReturn_Haley": "\u753A\u306E \u307F\u3093\u306A\u3068 \u3042\u3048\u3066 \u3088\u304B\u3063\u305F\u308F\u3002\u3042\u306A\u305F\u306F \u3044\u3044\u4E00\u65E5\u3092 \u904E\u3054\u305B\u305F \u304B\u3057\u3089\uFF1F",
    "patio_Haley": "\u306F\u3044\u3063\u3001\u201C\u30E4\u30AE\u306E\u30C1\u30FC\u30BA\u201D\uFF01",
    "spring_1": "\u51AC\u304C \u3088\u3046\u3084\u304F \u7D42\u308F\u3063\u3066\u3001 \u3053\u308C\u304B\u3089 \u6674\u308C\u306E\u65E5\u304C \u5897\u3048\u3066\u304F\u308B\u308F\u306D\u3002\u30EF\u30AF\u30EF\u30AF \u3057\u3066\u304D\u305F\u308F\u3002",
    "spring_2": "\u3053\u306E \u5B63\u7BC0\u306F \u4F55\u3092 \u690D\u3048\u308B\u306E\uFF1F",
    "spring_Haley": "\u3084\u3063\u3068 \u51AC\u304C \u7D42\u308F\u3063\u3066 \u3046\u308C\u3057\u3044\u3093\u3067\u3057\u3087\uFF1F\u3053\u308C\u304B\u3089\u306E\u6642\u671F\u3001 \u8272\u3005\u3068 \u671F\u5F85\u3067\u304D\u305D\u3046\u306D\u3002",
    "summer_15": "\u590F\u2026 \u30CF\u30A8\u3084 \u30A2\u30EA\u304C \u51FA\u3066\u304F\u308B\u5B63\u7BC0\u3063\u3066\u3053\u3068\u306D\u2026 \u30A4\u30E4\u3060\u308F\u3002$s",
    "summer_3": "\u79C1\u306E \u898B\u6804\u3048\u304C \u3042\u3093\u307E\u308A \u3088\u304F\u306A\u304B\u3063\u305F\u3089 \u3054\u3081\u3093\u306D\u2026 \u6E7F\u5EA6\u306E \u305B\u3044\u3067 \u9AEA\u304C \u3044\u3044\u611F\u3058\u306B \u307E\u3068\u307E\u3089\u306A\u3044\u306E\u3002",
    "summer_Haley": "\u6691\u3044 \u590F\u306E \u591C\u306F \u30DB\u30BF\u30EB\u3092 \u89B3\u5BDF\u3059\u308B\u306E\u304C \u597D\u304D\u306A\u306E\u3088\u3002\u661F\u3005\u304C \u3059\u3050\u305D\u3070\u306B \u3042\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u304B\u3089\u306D\u3002",
    "winter_14": "\u3053\u306E \u5929\u6C17\u3058\u3083 \u808C\u304C \u3059\u3054\u304F \u4E7E\u71E5 \u3057\u3061\u3083\u3046\u308F\u3002",
    "winter_2": "\u3088\u304F\u308F\u304B\u3089\u306A\u3044\u3051\u3069\u3001 \u96EA\u3092 \u898B\u308B\u3068 \u30D4\u30F3\u30AF\u30B1\u30FC\u30AD\u304C \u98DF\u3079\u305F\u304F\u306A\u308B\u308F\u2026",
    "winter_Haley": "\u3042\u306A\u305F\u304C \u30D4\u30AF\u30EB\u30B9\u306E\u30D3\u30F3\u3092 \u958B\u3051\u3066\u304F\u308C\u305F\u6642\u306E \u3053\u3068\u3092 \u601D\u3044\u51FA\u3057\u3066\u305F\u306E\u3002\u899A\u3048\u3066\u308B\uFF1F$h#$e#\u79C1\u9054\u3001 \u3042\u306E\u6642\u304B\u3089 \u59CB\u307E\u3063\u305F\u306E\u3088\u306D\u3002$l"
  }
}