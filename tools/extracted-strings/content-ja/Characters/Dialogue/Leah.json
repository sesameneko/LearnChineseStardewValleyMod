    "summer_1": "\u98A8\u306B\u4E57\u3063\u3066 \u904B\u3070\u308C\u308B \u3053\u306E\u7518\u3044\u9999\u308A\u304C \u590F\u306E\u5230\u6765\u3092 \u6559\u3048\u3066\u304F\u308C\u3066\u308B\u308F\u306D\uFF01$h",
    "summer_Fri": "\u6A39\u6DB2\u63A1\u96C6\u5668\u3092 \u4F7F\u3048\u3070 \u6728\u304B\u3089 \u30B7\u30ED\u30C3\u30D7\u3084 \u4ED6\u306E\u4FBF\u5229\u306A \u6DB2\u4F53\u3092 \u63A1\u96C6 \u3067\u304D\u308B\u308F\u3002#$e#\u6642\u9593\u304C \u304B\u304B\u308B\u3051\u3069\u3001 \u305D\u308C\u3060\u3051\u306E \u4FA1\u5024\u306F\u3042\u308B\u308F\u3088\u3002",
    "summer_Fri2": "\u30CF\u30C3\u30AD\u30EA\u8A00\u3063\u3066\u3001 \u79C1\u9054\u304C \u81EA\u7136\u3092 \u5927\u5207\u306B \u3057\u306A\u3044\u3068\u3001 \u6B21\u306E\u4E16\u4EE3\u304C \u82E6\u3057\u3044\u76EE\u306B \u4F1A\u3046\u308F\u3002#$e#\u305D\u3046 \u601D\u308F\u306A\u3044\uFF1F",
    "summer_Fri4": "\u68EE\u306E\u4E2D\u3092\u6B69\u3044\u305F\u3053\u3068\u306F\u3042\u308B\uFF1F\u7ACB\u3061\u6B62\u307E\u3063\u3066\u2026\u305F\u3060\u81EA\u7136\u306E\u7F8E\u3057\u3055\u3092\u611F\u3058\u308B\u306E\u3002#$e#\u3053\u306E\u4E16\u754C\u304C\u3069\u308C\u307B\u3069\u3059\u3070\u3089\u3057\u3044\u3082\u306E\u306A\u306E\u304B\u3001\u5FD8\u308C\u3066\u306F\u3044\u3051\u306A\u3044\u308F\u2026",
    "summer_Fri6": "\u304A\u3084\u3001@\u304B\u3002\u5927\u304D\u306A\u7267\u5834\u3067 \u4E00\u4EBA\u304D\u308A\u3063\u3066 \u3055\u3073\u3057\u304F\u306A\u3044\uFF1F#$e#\u8AB0\u304B\u3068 \u304A\u8A71 \u3057\u305F\u304F\u306A\u3063\u305F\u3089\u3001 \u79C1\u306E \u5BB6\u306B \u6765\u3066\u306D\u3002$h",
    "summer_Mon": "\u4ECA\u671D\u3001\u91CE\u751F\u306E \u304F\u3060\u3082\u306E\u3092 \u898B\u3064\u3051\u305F\u306E\uFF01#$e#\u3054\u3081\u3093\u306A\u3055\u3044\u3001 \u3082\u3046\u6B8B\u3063\u3066\u306A\u3044\u306E\u3002$s#$e#\u63A2\u3057\u7D9A\u3051\u3066\u305F\u3089\u3001 \u4F55\u304B \u898B\u3064\u304B\u308B\u306F\u305A\u3088\u3002",
    "summer_Sat": "\u8FD1\u304F\u306E\u5C0F\u5DDD\u306E \u304A\u304B\u3052\u3067\u3001 \u590F\u3067\u3082 \u5BB6\u306E\u5468\u308A\u306F \u5C11\u3057\u3060\u3051 \u6DBC\u3057\u3044\u306E\u3088\u3002#$e#\u79C1\u3001 \u3042\u3093\u307E\u308A \u6691\u3044\u306E\u306F \u82E6\u624B\u306A\u306E\u3002",
    "summer_Sat4": "\u3044\u3064\u306E\u590F\u3060\u3063\u305F\u304B\u3001\u6691\u304F\u3066\u5BDD\u4ED8\u3051\u306A\u304B\u3063\u305F\u304B\u3089\u3001\u591C\u4E2D\u306B\u30D9\u30C3\u30C9\u304B\u3089\u98DB\u3073\u8D77\u304D\u3066\u5DDD\u306B\u98DB\u3073\u8FBC\u3093\u3060\u306E\uFF01#$e#\u304D\u3063\u3068\u8AB0\u3082\u898B\u3066\u306A\u304B\u3063\u305F\u306F\u305A\u3088\uFF01$h",
    "summer_Sun": "\u3053\u3093\u306A \u6696\u304B\u304F\u3066\u3001 \u3084\u308B\u6C17\u306E\u51FA\u306A\u3044\u65E5\u306F \u4F55\u3092\u3057\u3088\u3046\u304B\u3057\u3089\uFF1F \u306F\u3041\u2026#$e#\u4F55\u304B\u3042\u308B\uFF1F",
    "summer_Thu6": "\u91CE\u751F\u306E\u304F\u3060\u3082\u306E\u3092 \u63A2\u3059\u306E\u306F \u5F97\u610F\u3088\u3002\u3044\u3064\u304B \u541B\u306B\u3082 \u30D5\u30EB\u30FC\u30C4\u30B5\u30E9\u30C0\u3092 \u4F5C\u3063\u3066\u3042\u3052\u308B\u3002$h",
    "summer_Tue": "\u7267\u5834\u306E \u52D5\u7269\u306E \u9CF4\u304D\u58F0\u3063\u3066 \u826F\u304F\u306A\u3044\uFF1F",
    "summer_Tue4": "\u4EBA\u751F\u306F \u30B7\u30F3\u30D7\u30EB\u306B \u904E\u3054\u3059\u306E\u304C \u4E00\u756A\u3088\u306D\u3002 \u590F\u306E\u6696\u304B\u3044 \u7A7A\u6C17\u3001 \u30AD\u30EC\u30A4\u306A\u7A7A\u3001 \u305D\u3057\u3066 \u30B8\u30E7\u30C3\u30AD\u306B\u6CE8\u304C\u308C\u305F \u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u30FB\u30EC\u30C3\u30C9\u30D3\u30FC\u30EB\u3002",
    "winter_Fri": "\u3053\u3053\u3067\u306F\u3001 \u6642\u306E\u6D41\u308C\u304C \u9045\u304F\u611F\u3058\u308B\u306E\u3002#$e#\u90FD\u4F1A\u306B \u3044\u305F\u9803\u306F\u3001 \u5E74\u6708\u306A\u3093\u3066 \u3042\u3063\u3068\u3044\u3046\u9593\u306B \u904E\u304E\u305F\u308F\u3002",
    "winter_Fri6": "\u541B\u306E\u5BB6\u306F \u51B7\u3048\u8FBC\u3093\u3060\u308A\u3059\u308B\u306E\u304B\u3057\u3089\uFF1F#$e#\u3082\u3057 \u6BDB\u5E03\u306B \u304F\u308B\u307E\u3063\u3066\u3001 \u30B5\u30A4\u30C0\u30FC\u3092 \u98F2\u307F\u305F\u3044\u3063\u3066 \u6C17\u5206\u306A\u3089 \u79C1\u306E\u5BB6\u306B\u6765\u3066\u306D\u3002$h",
    "winter_Mon": "\u96EA\u304C \u7A4D\u3082\u3063\u305F\u3070\u304B\u308A\u306E \u5149\u666F\u3063\u3066 \u672C\u5F53\u306B \u30B9\u30C6\u30AD\u3002",
    "winter_Sat": "\u3053\u3093\u306B\u3061\u306F\u3002\u4F55\u304B\u7528\u304B\u3057\u3089\uFF1F",
    "winter_Sat2": "\u304A\u3084\u3001@\u304B\u3002\u4F55\u304B\u3000\u304A\u8A71\u3057\u305F\u3044\u3053\u3068\u3067\u3082 \u3042\u308B\u306E\u304B\u3057\u3089\uFF1F",
    "winter_Sun": "\u4E38\u4E00\u65E5 \u4F11\u307F\u3092 \u3068\u308B\u3053\u3068\u3063\u3066 \u3042\u308B\uFF1F#$e#\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5 \u3067\u304D\u308B\u308F\u3088\u3002",
    "winter_Sun4": "\u305F\u307E\u306B\u306F\u4E38\u4E00\u65E5\u4F11\u3093\u3060\u65B9\u304C\u3044\u3044\u3088\u3002#$b#\u6C17\u6301\u3061\u304C\u8EFD\u304F\u306A\u308B\u3060\u3051\u3058\u3083\u306A\u304F\u3066\u3001\u9577\u3044\u76EE\u3067\u898B\u308C\u3070\u751F\u7523\u6027\u3082\u4E0A\u304C\u308B\u306E\u3002",
    "winter_Thu": "\u65B0\u9BAE\u306A \u98DF\u3079\u7269\u304C \u306A\u304B\u306A\u304B \u898B\u3064\u304B\u3089\u306A\u3044\u308F\u3002#$e#\u6700\u8FD1\u306F \u30D1\u30F3\u3070\u304B\u308A \u98DF\u3079\u3066\u308B\u3002$s",
    "winter_Thu6": "\u306F\u3041\u2026 \u51AC\u306F \u65B0\u9BAE\u306A \u98DF\u3079\u7269\u304C \u624B\u306B\u5165\u308A\u3065\u3089\u3044\u308F\u3002#$e#\u541B\u306E \u7267\u5834\u306E \u5099\u84C4\u306F \u5341\u5206\u304B\u3057\u3089\uFF1F",
    "winter_Tue": "\u79C1\u306E\u5BB6\u3001 \u51AC\u5834\u306F \u7D50\u69CB \u5BD2\u304F\u306A\u308B\u306E\u3088\u3002$s#$e#\u5927\u304D\u306A \u6BDB\u5E03\u306B \u304F\u308B\u307E\u308C\u3070\u3001 \u5927\u4E08\u592B\u3060\u3051\u3069\u3002$h",
    "winter_Wed": "\u4ECA\u671D\u65E9\u304F\u306B\u3001 \u96EA\u30A6\u30B5\u30AE\u3092\u898B\u305F\u306E\uFF01\u7D50\u69CB \u73CD\u3057\u3044 \u3053\u3068\u3060\u3088\u306D\uFF1F"
  }
}