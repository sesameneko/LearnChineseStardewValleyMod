    "AcceptGift_(O)430": "\u306D\u3048\u3001\u3053\u308C\u3092\u3069\u3053\u3067\u898B\u3064\u3051\u305F\u306E\uFF1F \uFF08\u30AF\u30F3\u30AF\u30F3\uFF09\u2026\u3046\u30FC\u3093\u2026\u30B9\u30E9\u30A4\u30B9\u3057\u3066\u751F\u30D1\u30B9\u30BF\u306B\u306E\u305B\u305F\u3089\u30AB\u30F3\u30DA\u30AD\u306D\u3002\u3042\u308A\u304C\u3068\u3046\uFF01$h",
    "AcceptGift_(O)StardropTea": "\u307E\u3042\u2026\u5B50\u4F9B\u306E\u9803\u306B\u3072\u3068\u304F\u3061\u3060\u3051\u98F2\u3093\u3060\u3053\u3068\u304C\u3042\u308B\u308F\u3002\u4ECA\u3067\u3082\u3053\u306E\u5473\u3092\u899A\u3048\u3066\u308B\u3002",
    "Beach": "\u6D77\u306E\u97F3\u3092 \u805E\u304D\u306B \u6765\u305F\u306E\u3088\u3002\u7F8E\u3057\u3044\u97F3\u8272 \u3060\u3068\u601D\u308F\u306A\u3044\uFF1F",
    "FlowerDance_Accept": "\u79C1\u3068\u30C0\u30F3\u30B9\u3092\u8E0A\u308A\u305F\u3044\u306E\uFF1F\u3082\u3061\u308D\u3093\u30A4\u30A8\u30B9\u3088\uFF01$h#$e#\u3055\u305D\u3063\u3066\u307B\u3057\u3044\u306A\u3063\u3066\u601D\u3063\u3066\u305F\u306E\u2026$h",
    "FlowerDance_Accept_Spouse": "\u3084\u3063\u3068\u304D\u305F\u306E\u306D\uFF01 \u4ED6\u306E\u8AB0\u304B\u3068 \u8E0A\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u3068 \u5FC3\u914D\u3057\u306F\u3058\u3081\u305F \u3068\u3053\u308D\u3060\u3063\u305F\u306E\u3088\uFF01$h",
    "FlowerDance_Decline": "\u6B63\u76F4\u3001\u541B\u3068\u306F \u8E0A\u308A\u305F\u304F\u306A\u3044 \u304B\u306A\u3002$u",
    "Fri": "\u53CB\u9054\u306B\u306A\u308B\u306A\u3089 \u6728\u306E\u307B\u3046\u304C \u305A\u3063\u3068 \u7C21\u5358\u3088\u306D\u3002\u3060\u3063\u3066 \u53E3\u6570\u304C \u591A\u304F\u306A\u3044\u304B\u3089\u3002$h",
    "Fri2": "\u81EA\u7136\u306E\u6075\u307F \u306A\u3057\u3058\u3083\u3001 \u79C1\u9054\u306F \u751F\u304D\u3066\u3044\u3051\u306A\u3044\u308F\u3002\u305D\u306E\u3053\u3068\u3092 \u899A\u3048\u3066\u304A\u3044\u3066\u306D\u3002",
    "Fri4": "\u304A\u3084\u3001@\u304B\u3002\u4ECA\u65E5\u306F \u826F\u3044\u65E5\u306D\u3002#$e#\u8AB0\u304B\u3068 \u304A\u8A71 \u3057\u305F\u304F\u306A\u3063\u305F\u3089\u3001 \u79C1\u306E \u5BB6\u306B \u6765\u3066\u306D\u3002$h",
    "Fri6": "\u6642\u3005\u4E0D\u601D\u8B70\u306A\u611F\u899A\u306B\u304A\u305D\u308F\u308C\u308B\u3053\u3068\u304C\u3042\u308B\u306E\u3002\u982D\u306E\u4E2D\u304C\u304B\u3089\u3063\u307D\u306B\u306A\u3063\u3066\u2026 \u3068\u3066\u3082\u5E78\u305B\u3067\u843D\u3061\u7740\u3044\u305F\u6C17\u5206\u306B\u306A\u308B\u306E\u3088\u3002#$e#\u3067\u3082\u306D\uFF01\u305D\u308C\u3068\u30EF\u30A4\u30F3\u3092\u98F2\u3080\u3053\u3068\u306F\u307E\u3063\u305F\u304F\u5225\u306E\u8A71\u3060\u308F\uFF01$h",
    "Fri8": "\u3082\u3057\u81EA\u5206\u304C\u5225\u306E\u4EBA\u9593\u306B\u306A\u3063\u305F\u3089\u3063\u3066\u8003\u3048\u305F\u3053\u3068\u306F\u3042\u308B\uFF1F#$e#\u4ECA\u306E\u81EA\u5206\u3068\u540C\u3058\u3088\u3046\u306B\u8003\u3048\u3066\u884C\u52D5\u3059\u308B\u306E\u304B\u3057\u3089\uFF1F \u305D\u308C\u3068\u3082\u307E\u3063\u305F\u304F\u9055\u3046\u3053\u3068\u3092\u3059\u308B\u306E\u304B\u3057\u3089\uFF1F#$e#\u6C17\u306B\u3057\u306A\u3044\u3067\u3001\u79C1\u306F\u3068\u304D\u3069\u304D\u5909\u306A\u3053\u3068\u3092\u8003\u3048\u3061\u3083\u3046\u306E\u2026$h",
    "GreenRain": "\u3053\u306E\u690D\u7269\u306F\u3069\u3053\u304B\u3089\u6765\u305F\u306E\u304B\u3057\u3089\uFF1F\u9A5A\u3044\u305F\u3051\u3069\u3001\u3044\u3084\u306A\u611F\u3058\u306F\u3057\u306A\u3044\u308F\u2026",
    "GreenRainFinished": "\u753A\u306E\u307F\u3093\u306A\u306F\u3001\u3042\u306E\u96E8\u3092\u3053\u308F\u304C\u3063\u3066\u3044\u305F\u306E\u304B\u3057\u3089\uFF1F\u3046\u307E\u304F\u8A00\u3048\u306A\u3044\u3051\u3069\u2026\u3068\u306B\u304B\u304F\u4FE1\u3058\u3089\u308C\u306A\u3044\u51FA\u6765\u4E8B\u3060\u3063\u305F\u308F\uFF01$h",
    "GreenRain_2": "\u3053\u306E\u96E8\u304C\u590F\u306E\u9593\u305A\u3063\u3068\u7D9A\u3044\u305F\u3089\u2026\u8C37\u3058\u3085\u3046\u304C\u3053\u306E\u690D\u7269\u306B\u304A\u304A\u308F\u308C\u3066\u3057\u307E\u3046\u3067\u3057\u3087\u3046\u306D\uFF01",
    "Introduction": "\u3053\u3093\u306B\u3061\u306F\u3001\u4F1A\u3048\u3066\u3046\u308C\u3057\u3044\u308F\u3002$h#$e#\u3061\u3087\u3046\u3069 \u3044\u3044\u6642\u671F\u306B \u5F15\u3063\u8D8A\u305B\u305F\u308F\u306D\u3002\u6625\u306F \u30B9\u30C6\u30AD\u306A \u5B63\u7BC0\u3088\u3002",
    "Mon": "\u4ECA\u65E5\u306F \u6728\u3005\u304C \u7F8E\u3057\u304F \u898B\u3048\u308B\u308F\u306D\u3002#$q 21/22/211132 Mon_old#\u305D\u308C\u3067\u3001 \u541B\u306F \u3069\u3046\u3057\u3066 \u7267\u5834\u4E3B\u306B\u306A\u3063\u305F\u306E\uFF1F#$r 21 -5 Mon_21#\u304A\u91D1\u3092 \u305F\u304F\u3055\u3093 \u7A3C\u304E\u305F\u3044\u304B\u3089\u3002#$r 22 5 Mon_22#\u90FD\u4F1A \u66AE\u3089\u3057\u3088\u308A \u300C\u73FE\u5B9F\u7684\u300D \u3060\u304B\u3089\u3002#$r 211132 5 Mon_211132#\u7956\u7236\u306E \u8DE1\u3092\u7D99\u3050 \u305F\u3081\u3002#$r 22 5 Mon_22#\u6614\u306E \u751F\u6D3B\u304B\u3089 \u629C\u3051\u51FA\u3057\u305F\u304B\u3063\u305F\u3002",
    "Mon_21": "\u3075\u30FC\u3093\u3002\u305D\u308C\u306F\u3061\u3087\u3063\u3068 \u6D45\u306F\u304B\u306A \u611F\u3058\u304C\u3059\u308B\u308F\u3002$s",
    "Mon_211132": "\u305D\u3046\u3084\u3063\u3066 \u7956\u7236\u306E\u3053\u3068\u3092 \u8A87\u308A\u306B \u601D\u3046\u306E\u3063\u3066 \u826F\u3044\u3053\u3068\u306D\u3002",
    "Mon_22": "\u305D\u308C\u3063\u3066\u2026 \u79C1\u304C\u3053\u3053\u306B\u6765\u305F\u7406\u7531\u3068\u307B\u3068\u3093\u3069\u4E00\u7DD2\u306D\uFF01$h#$b#\u79C1\u306F\u3082\u3063\u3068\u81EA\u7136\u3068\u3075\u308C\u5408\u3044\u305F\u304B\u3063\u305F\u3093\u3060\u2026",
    "Mon_old": "$p 21#\u305D\u308C\u3058\u3083\u3042\u3001 \u601D\u3046\u3088\u3046\u306B \u7A3C\u3052\u3066\u3044\u308B\u306E\u304B\u3057\u3089\uFF1F|\u81EA\u7136\u306E\u4E2D\u3067 \u66AE\u3089\u3059\u306E\u3063\u3066 \u30B9\u30C6\u30AD\u3060\u3088\u306D\u3002",
    "Resort": "\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306E\u6C17\u5019\u306F\u5927\u597D\u304D\u3088\u3002\u3067\u3082\u6642\u3005\u9055\u3063\u305F\u6C17\u5019\u3092\u4F53\u9A13\u3059\u308B\u3053\u3068\u3067\u3001\u7269\u4E8B\u3092\u5927\u304D\u306A\u8996\u91CE\u3067\u3068\u3089\u3048\u3089\u308C\u308B\u3088\u3046\u306B\u306A\u308B\u306E\u3002",
    "Resort_Bar": "\u30D4\u30CB\u30E3\u30B3\u30E9\u30FC\u30C0\u3092\u98F2\u3093\u3060\u3053\u3068\u304C\u3042\u308B\uFF1F\u3053\u308C\u306F2\u676F\u76EE\u306A\u306E\u2026\u3078\u3078\u3078\u3002",
    "Resort_Chair": "\u307E\u3063\u305F\u304F\u52D5\u304B\u305A\u306B\u3044\u308C\u3070\u3001\u3053\u306E\u6691\u3055\u3082\u60AA\u304F\u306A\u3044\u308F\u306D\u3002$h",
    "Resort_Entering": "\u8AB0\u306B\u3082\u8A00\u308F\u306A\u3044\u3067\u306D\u3001\u30A6\u30A3\u30EA\u30FC\u304C\u3061\u3087\u3063\u3068\u3060\u3051\u30DC\u30FC\u30C8\u3092\u64CD\u7E26\u3055\u305B\u3066\u304F\u308C\u305F\u306E\u3002$h",
    "Resort_Leaving": "\u3042\u3042\u3001\u672C\u5F53\u306B\u30EA\u30E9\u30C3\u30AF\u30B9\u3067\u304D\u305F\u308F\u3002",
    "Resort_Shore": "\u3053\u3053\u306E\u6CE2\u306E\u9020\u5F62\u306B\u611F\u52D5\u3057\u3066\u3044\u308B\u306E\u3002#$e#\u5F62\u304C\u306A\u3044\u7269\u3092\u3001\u79C1\u306F\u5F6B\u523B\u3067\u8868\u73FE\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u306E\u304B\u3057\u3089\u3002",
    "Resort_Wander": "\u3046\u30FC\u3093\u3001\u3053\u306E\u3042\u305F\u308A\u306E\u6728\u3092\u4F7F\u3048\u3070\u3001\u304D\u3063\u3068\u8C4A\u304B\u306A\u8868\u73FE\u304C\u3067\u304D\u308B\u3068\u601D\u3046\u306E\u3002#$e#\u3067\u3082\u79C1\u304C\u8239\u306B\u4E38\u592A\u3092\u904B\u3073\u8FBC\u3093\u3060\u3089\u3001\u30A6\u30A3\u30EA\u30FC\u306F\u304D\u3063\u3068\u5ACC\u306A\u9854\u3092\u3059\u308B\u308F\u306D\uFF01$h",
    "Resort_Wander_2": "\u3053\u3053\u3067\u306F\u3069\u3093\u306A\u3082\u306E\u304C\u63A1\u308C\u308B\u306E\u304B\u3057\u3089\u3002#$e#\u8FD1\u304F\u306E\u6797\u306B\u3001\u304A\u3044\u3057\u305D\u3046\u306A\u30AF\u30EB\u30DF\u304C\u3042\u3063\u305F\u308F\u3002",
    "Sat": "\u5B63\u7BC0\u3054\u3068\u306B \u98FE\u308A\u3092 \u5909\u3048\u308B\u306E\u304C \u597D\u304D\u306A\u306E\u3002",
    "Sat8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u4F5C\u7269\u3092\u80B2\u3066\u3066\u307F\u305F\u3044\u6C17\u6301\u3061\u3082\u3042\u308B\u3051\u3069\u3001\u305D\u306E\u305F\u3081\u306B\u305F\u304F\u3055\u3093\u306E\u91CE\u8349\u3092\u5208\u308A\u53D6\u3089\u306A\u304D\u3083\u3044\u3051\u306A\u3044\u3068\u601D\u3046\u3068\u3001\u6C17\u304C\u5F15\u3051\u3061\u3083\u3046\u306A\u2026|\u8FB2\u696D\u3063\u3066 \u3059\u3054\u304F \u697D\u3057\u305D\u3046\u3002\u3044\u3064\u304B \u79C1\u3082 \u3084\u308A\u305F\u3044\u306A\u3002$l",
    "Sun": "\u79C1\u306E\u5BB6\u3067 \u4F55\u304B \u53E9\u304F\u97F3\u304C \u805E\u3053\u3048\u305F\u3089\u3001 \u305D\u308C\u306F \u79C1\u304C \u5F6B\u523B\u306B \u53D6\u308A\u639B\u304B\u3063\u3066\u308B \u6642\u306E \u97F3\u3060\u308F\u3002",
    "Sun8": "\u3082\u3057 \u9762\u767D\u3044\u5F62\u306E \u6D41\u6728\u3092 \u898B\u3064\u3051\u305F\u3089\u3001 \u79C1\u306B \u3061\u3087\u3046\u3060\u3044\u3002#$e#\u3053\u308C\u3092 \u79C1\u306B \u304F\u308C\u305F\u306E\u3063\u3066 \u4F55\u304B \u7279\u5225\u306A \u611F\u3058\u304C\u3059\u308B\u308F\u3002",
    "Thu": "\u3061\u3083\u3093\u3068 \u63A2\u305B\u3070\u3001 \u3053\u306E\u8FBA\u306B\u306F \u91CE\u751F\u306E \u98DF\u3079\u7269\u304C \u6CA2\u5C71 \u898B\u3064\u304B\u308B\u308F\u3002#$e#\u305D\u308C\u3067 \u65B0\u9BAE\u306A \u30B5\u30E9\u30C0\u3092 \u307B\u307C\u6BCE\u65E5 \u4F5C\u3063\u3066\u308B\u306E\u3002$h",
    "Thu6": "\u63A1\u53D6\u306F \u5927\u5F97\u610F\u3088\u3002\u3044\u3064\u304B \u541B\u306B\u3082 \u30B5\u30E9\u30C0\u3092 \u4F5C\u3063\u3066\u3042\u3052\u308B\u3002$h",
