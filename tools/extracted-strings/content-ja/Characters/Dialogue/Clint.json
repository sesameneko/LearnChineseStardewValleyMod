    "AcceptGift_(O)SkillBook_3": "\u3053\u308C\u306F\u304A\u3082\u3057\u308D\u305D\u3046\u3060\u2026\u8C37\u3067\u306F\u3053\u3046\u3044\u3046\u672C\u304C\u306A\u304B\u306A\u304B\u624B\u306B\u5165\u3089\u306A\u3044\u304B\u3089\u306A\u3002#$b#\u3044\u3044\u30A2\u30A4\u30C7\u30A3\u30A2\u304C\u305F\u304F\u3055\u3093\u8F09\u3063\u3066\u3044\u305D\u3046\u3060\u3002\u3042\u308A\u304C\u3068\u3046\u3001@\u3002",
    "AcceptGift_(O)StardropTea": "\u305D\u308C\u3092\u2026 \u304A\u308C\u306B\uFF1F\u304A\u308C\u306B\u306F\u3082\u3063\u305F\u3044\u306A\u3044\u3082\u306E\u3060\u304C\u2026 \u3042\u308A\u304C\u3068\u3046\u3002",
    "Fri": "\u5916\u306E\u5929\u6C17\u306A\u3093\u3066\u3001 \u304A\u308C\u306B\u306F\u3042\u307E\u308A \u95A2\u4FC2\u306E\u306A\u3044\u3053\u3068\u3060\u3002\u4E00\u5E74\u4E2D\u3001 \u5E97\u304B\u3089\u96E2\u308C\u306A\u3044\u304B\u3089\u306D\u3002#$e#\u6C17\u304C\u3081\u3044\u308B\u3060\u308D\u3046\uFF1F",
    "Fri8": "\u304A\u91D1\u3092\u305F\u3081\u3066\u30D1\u30BD\u30B3\u30F3\u3092\u8CB7\u308F\u306A\u3044\u3068\u2026#$e#\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u3067\u604B\u4EBA\u3092\u898B\u3064\u3051\u3089\u308C\u308B\u304B\u3082\u77E5\u308C\u306A\u3044\u2026$s#$e#\u306A\u3093\u3060\u3063\u3066\uFF1F\u5225\u306B\u304A\u304B\u3057\u3044\u3053\u3068\u3058\u3083\u306A\u3044\u3060\u308D\uFF01\u307F\u3093\u306A\u304C\u307F\u3093\u306A\u3001\u30AB\u30C3\u30B3\u3088\u304F\u3066\u793E\u4EA4\u7684\u306A\u7267\u5834\u4E3B\u3063\u3066\u308F\u3051\u3058\u3083\u306A\u3044\u3093\u3060\uFF01$u#$e#\u304A\u308C\u307F\u305F\u3044\u306A\u7537\u306F\u3044\u3063\u305F\u3044\u3069\u3046\u3057\u305F\u3089\u3044\u3044\u3093\u3060\uFF1F \u3046\u30FC\u3093\u2026$s",
    "GreenRain": "\u3053\u3046\u3044\u3046\u6642\u306F\u3001\u4EBA\u9593\u306E\u672C\u5F53\u306E\u6027\u683C\u304C\u8A66\u3055\u308C\u308B\u3093\u3060\u3002#$e#\u304A\u308C\u306F\u30A8\u30DF\u2026\u3044\u3084\u3001\u3053\u306E\u6BD2\u306E\u96E8\u304B\u3089\u307F\u3093\u306A\u3092\u5B88\u308B\u305E\uFF01",
    "GreenRainFinished": "\u4F55\u4E8B\u3082\u306A\u304B\u3063\u305F\u306A\u3002\u3084\u3063\u3068\u30D2\u30FC\u30ED\u30FC\u306B\u306A\u308C\u308B\u30C1\u30E3\u30F3\u30B9\u304C\u304D\u305F\u3068\u601D\u3063\u305F\u306E\u306B\u2026\u307E\u3042\u3044\u3044\u3084\u2026\u4ED5\u4E8B\u306B\u3082\u3069\u308B\u3088\u3002",
    "GreenRain_2": "\u7E01\u8D77\u3067\u3082\u306A\u3044\u3053\u3068\u3060\u3051\u3069\u3001\u3053\u3093\u306A\u5909\u306A\u96E8\u3058\u3083\u306A\u304F\u3066\u672C\u5F53\u306E\u707D\u5BB3\u304C\u8D77\u304D\u305F\u3089\u3044\u3044\u306E\u306B\u3068\u601D\u3046\u3053\u3068\u304C\u3042\u308B\u3088\u3002#$b#\u306A\u306B\u3082\u304B\u3082\u3092\u63FA\u3055\u3076\u308B\u3088\u3046\u3053\u3068\u304C\u8D77\u304D\u305F\u3089\u2026#$b#\u3051\u304C\u4EBA\u304C\u51FA\u305F\u3089\u3044\u3044\u306A\u3093\u3066\u601D\u3063\u3061\u3083\u3044\u306A\u3044\u2026#$b#\u81EA\u5206\u304C\u751F\u304D\u3066\u3044\u308B\u3053\u3068\u3092\u611F\u3058\u305F\u3044\u3093\u3060\u2026\u306A\u306B\u304B\u306E\u305F\u3081\u306B\u751F\u304D\u3066\u3044\u308B\u3068\u601D\u3044\u305F\u3044\u3093\u3060\u2026",
    "Introduction": "\u304A\u3084\u2026\u3053\u3093\u306B\u3061\u306F\u3002\u304A\u308C\u306F\u30AF\u30EA\u30F3\u30C8\u3002#$e#\u3053\u306E\u753A\u306E \u935B\u51B6\u5C4B\u3060\u3002\u9053\u5177\u306E \u6027\u80FD\u3092 \u4E0A\u3052\u305F\u304F\u306A\u3063\u305F\u3089\u3001 \u304A\u308C\u306B\u4EFB\u305B\u3066\u304F\u308C\u3002",
    "Mon": "\u3042\u3042\u3002\u304A\u308C\u306F\u935B\u51B6\u5C4B\u3060\u3002#$e#\u7236\u3082\u305D\u3046\u3060\u3063\u305F\u3002#$e#\u7956\u7236\u3082\u307E\u305F\u3001 \u935B\u51B6\u3092 \u3084\u3063\u3066\u3044\u305F\u3002$u#$q 9/9 Mon_old#\u3067\u3082\u66FD\u7956\u7236\u306F \u4F55\u3060\u3063\u305F\u304B\u3001 \u5206\u304B\u308B\u304B\u306D\u2026#$r 9 30 Mon_9#\u935B\u51B6\u5C4B\u3002#$r 9 50 Mon_clown#\u3072\u3087\u3046\u304D\u3093\u306A \u9053\u5316\u5E2B\u3002#$r 9 -50 Mon_rude#\u30A4\u30E4\u30DF\u306A \u76AE\u8089\u5C4B\u3002",
    "Mon4": "\u7267\u5834\u4E3B\u3067 \u3044\u308B\u3053\u3068\u3092 \u611F\u8B1D\u3059\u308B\u3093\u3060\u306D\u3001@\u3002\u3044\u3064\u3082\u9AD8\u6E29\u306A \u304B\u307E\u3069\u306E\u305D\u3070\u306B \u3044\u308B\u3088\u308A\u3001 \u5916\u3067\u50CD\u304F\u307B\u3046\u304C \u305A\u3063\u3068\u3044\u3044\u3002#$e#\u7236\u306E\u305B\u3044\u3067\u3001 \u304A\u308C\u306B\u306F \u935B\u51B6\u5C4B\u306E\u9053\u3057\u304B \u306A\u304B\u3063\u305F\u3002",
    "Mon8": "\u8A00\u3044\u305F\u304F\u306F\u306A\u3044\u3051\u3069\u3001\u7236\u89AA\u304B\u3089\u7121\u7406\u3084\u308A\u935B\u51B6\u5C4B\u306B\u3055\u305B\u3089\u308C\u305F\u3053\u3068\u306B\u611F\u8B1D\u3057\u305F\u304F\u306A\u308B\u3068\u304D\u3082\u3042\u308B\u3093\u3060\u3002\u304A\u308C\u306B\u306F\u624B\u306B\u8077\u304C\u3042\u308B\u3002#$e#\u3082\u3057\u4ED5\u4E8B\u304C\u306A\u304B\u3063\u305F\u3089\u3001\u4E00\u65E5\u4E2D\u305F\u3060\u5EA7\u3063\u3066\u81EA\u5206\u3092\u3042\u308F\u308C\u3093\u3067\u3044\u305F\u304B\u3082\u3057\u308C\u306A\u3044\u3002$s",
    "Mon_9": "\u3069\u3046\u3057\u3066 \u308F\u304B\u3063\u305F\uFF1F$u",
    "Mon_clown": "\u30CF\u30CF\u30CF\u30C3\u3002\u305D\u308C\u306F\u826F\u3044\u3002$h",
    "Mon_old": "\u305D\u3046\u3001 \u304A\u308C\u306E\u66FD\u7956\u7236\u3082 \u935B\u51B6\u5C4B\u3060\u3063\u305F\u306E\u3055\u3002",
    "Mon_rude": "\u304A\u3084\u304A\u3084\u3002\u306A\u3093\u3066\u3053\u3068\u3092 \u8A00\u3046\u3093\u3060\u3002\u78BA\u304B\u306B\u304A\u308C\u3082 \u5931\u793C\u3060\u3063\u305F\u304B\u3082 \u3057\u308C\u306A\u3044\u304C\u3001 \u3042\u3093\u305F\u307B\u3069\u3067\u306F \u306A\u304B\u3063\u305F\u305E\u3002",
    "Resort": "\uFF08\u306F\u3041\uFF09\u2026\u307F\u3093\u306A\u3067\u30D3\u30FC\u30C1\u306B\u3044\u3066\u3082\u3001\u307E\u3060\u5B64\u72EC\u3092\u611F\u3058\u308B\u3093\u3060\u2026$s",
    "Resort_Bar": "\u8179\u304C\u6E1B\u3063\u305F\u2026$s",
    "Resort_Chair": "\u75DB\u3044\u2026\u5168\u8EAB\u3092\u65E5\u713C\u3051\u3057\u305F\u3002$s",
    "Resort_Entering": "\u7279\u88FD\u306E\u8D64\u3044\u30C8\u30E9\u30F3\u30AF\u30B9\u3092\u5C65\u3044\u3066\u307F\u308B\u304B\u3002\u3059\u3054\u304F\u6CE8\u76EE\u3092\u96C6\u3081\u308B\u306F\u305A\u3060\u3002",
    "Resort_Leaving": "\u307E\u3042\u3001\u60F3\u50CF\u3057\u305F\u3088\u3046\u306B\u306F\u3044\u304B\u306A\u304B\u3063\u305F\u306A\u2026",
    "Resort_Shore": "\u3042\u3042\u3001\u3057\u307E\u3063\u305F...\u8DB3\u306E\u722A\u3092\u5207\u308B\u306E\u3092\u5FD8\u308C\u3066\u3044\u305F\u3002$s",
    "Resort_Shore_2": "\u6EB6\u9271\u7089\u3067\u4ED5\u4E8B\u3092\u3057\u3066\u3044\u308B\u304B\u3089\u3001\u3053\u306E\u304F\u3089\u3044\u306E\u6691\u3055\u306F\u4F55\u3068\u3082\u306A\u3044\u3068\u601D\u3063\u3066\u305F\u304C\u3001\u3044\u3064\u306E\u9593\u306B\u304B\u6C57\u3060\u304F\u3060\u3002$s#$e#\u8AB0\u3082\u6C17\u3065\u3044\u3066\u306A\u3044\u3068\u3044\u3044\u3093\u3060\u304C\u2026#$e#%\u30AF\u30EA\u30F3\u30C8\u306E\u4F53\u306F\u30C6\u30AB\u3063\u3066\u3044\u308B\u2026",
    "Sat": "\u6642\u3005\u3001 \u3069\u3046\u3057\u3066 \u3053\u306E\u753A\u306B \u5B9A\u4F4F\u3059\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u304B \u8003\u3048\u3066 \u3057\u307E\u3046\u3093\u3060\u3002$u",
    "Sat10": "\u3069\u3046\u3050\u306E\u8ABF\u5B50\u306F\u3069\u3046\u3060\uFF1F#$b#\u4FEE\u7406\u304C\u5FC5\u8981\u306B\u306A\u3063\u305F\u3089\u304A\u308C\u306E\u5E97\u306B\u6765\u3066\u304F\u308C\u3002\u304A\u308C\u306E\u3069\u3046\u3050\u306F\u6C38\u4E45\u4FDD\u8A3C\u3064\u304D\u3060\uFF01",
    "Sat6": "\u4F55\u304B \u30A8\u30AD\u30B5\u30A4\u30C6\u30A3\u30F3\u30B0\u306A \u3053\u3068\u3092 \u3084\u308B\u306B\u306F \u5E74\u3092\u53D6\u308A\u3059\u304E\u305F\u3002\u3053\u306E\u5148\u5F85\u3063\u3066\u3044\u308B\u306E\u306F\u3001 \u6C57\u304C\u6D41\u308C\u308B\u307B\u3069 \u6691\u3044\u304B\u307E\u3069\u3067\u306E \u4F5C\u696D\u3060\u3051\u3055\u3002",
    "Sun": "\u3042\u3093\u305F\u3001 \u3084\u308B\u3053\u3068\u306F \u306A\u3044\u306E\u304B\uFF1F",
    "Sun4": "\u9053\u5177\u306E \u8ABF\u5B50\u306F \u3069\u3046\u3060\u3044\uFF1F",
    "Sun8": "\u307F\u3093\u306A\u304C\u77E5\u3063\u3066\u3044\u308B\u304B\u3001\u6C17\u306B\u3057\u3066\u3044\u308B\u304B\u3069\u3046\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\u304A\u308C\u306F\u81EA\u5206\u306E\u4ED5\u4E8B\u306B\u8A87\u308A\u3092\u6301\u3063\u3066\u3044\u308B\u3093\u3060\u3002#$e#\u3064\u307E\u308A\u2026\u5B50\u4F9B\u306E\u9803\u306F\u3001\u81EA\u5206\u304C\u935B\u51B6\u5C4B\u306B\u306A\u308B\u306A\u3093\u3066\u601D\u3063\u3066\u306A\u304B\u3063\u305F\u3002\u3067\u3082\u3001\u4ECA\u306E\u304A\u308C\u304C\u3044\u308B\u3002\u305D\u3057\u3066\u3001\u304A\u308C\u306F\u6700\u9AD8\u306E\u935B\u51B6\u5C4B\u306B\u306A\u308A\u305F\u3044\u3093\u3060\u3002",
    "Thu": "\u6700\u8FD1\u3001 \u4ED5\u4E8B\u304C\u306A\u304B\u306A\u304B\u6765\u306A\u304F\u3066\u306A\u3002#$e# \u9053\u5177\u3092 \u5F37\u5316\u3057\u305F\u307B\u3046\u304C \u3044\u3044\u3002\u304A\u308C\u3082\u5132\u304B\u308B\u304B\u3089\u3055\u3002",
    "Thu8": "\u30A8\u30DF\u30EA\u30FC\u306B\u306F\u7802\u6F20\u306B\u53CB\u9054\u304C\u3044\u308B\u3089\u3057\u3044\u3002\u305D\u306E\u5973\u6027\u306E\u3053\u3068\u3092\u306A\u306B\u304B\u77E5\u3089\u306A\u3044\u304B\uFF1F#$e#\u72EC\u8EAB\u306A\u306E\u304B\u306A\u2026$s",
    "Tue": "\u3082\u3057 \u9053\u5177\u3092 \u5F37\u5316\u3057\u305F\u3044\u306A\u3089\u3001 \u6B63\u3057\u3044\u7A2E\u985E\u306E \u539F\u77F3\u3092 \u6301\u3063\u3066\u304D\u3066\u304F\u308C\u3002#$e#\u3082\u3061\u308D\u3093\u3001 \u4F5C\u696D\u6599\u3082 \u652F\u6255\u3046 \u5FC5\u8981\u304C\u3042\u308B\u305E\u3002",
    "Wed": "\u306D\u3047\u3001\u4F55\u304B \u5FC5\u8981\u304B\u306A\uFF1F",
    "Wed6": "\u3042\u3089\u3001 @\u3055\u3093\u3053\u3093\u306B\u3061\u306F\u3002\u5C11\u3057 \u6C5A\u308C\u3066\u308B\u3088\u3046\u306B \u898B\u3048\u3066\u305F\u3089 \u3059\u307E\u306A\u3044\u3002\u4ECA\u671D\u304B\u3089 \u305A\u3063\u3068 \u304B\u307E\u3069\u3067 \u4F5C\u696D\u3057\u3066\u3044\u305F\u304B\u3089\u306A\u3002$h#$e#\u305D\u308C\u3067\u3001 \u4F55\u304B\u5FC5\u8981\u304B\uFF1F \u9854\u3092\u51FA\u3057\u306B \u6765\u305F\u3060\u3051\u304B\u3044\uFF1F",
    "cc_Minecart": "\u3069\u3046\u3044\u3046\u308F\u3051\u304B\u3001 \u753A\u306E\u53E4\u3044 \u30C8\u30ED\u30C3\u30B3\u304C \u307E\u305F\u52D5\u304D \u51FA\u3057\u305F\u3093\u3060\u3002\u304A\u304B\u3052\u3067 \u9271\u5C71\u306E\u884C\u304D\u6765\u304C \u672C\u5F53\u306B \u697D\u306B\u306A\u3063\u3066\u306D\u3002#$b#\u307E\u3042\u3067\u3082\u3001 \u5F53\u7136\u3068 \u601D\u3063\u3061\u3083\u30C0\u30E1\u3060\u3088\u306D\u2026\u3068\u3064\u305C\u3093\u52D5\u304F\u3088\u3046\u306B \u306A\u3063\u305F\u3093\u3060\u304B\u3089\u3001\u307E\u305F\u3068\u3064\u305C\u3093 \u6B62\u307E\u308B\u304B\u3082 \u3057\u308C\u306A\u3044\u308F\u3051\u3060\u3057\u2026",
