    "AcceptBirthdayGift_Negative": "\u3053\u308C\u304C\u8A95\u751F\u65E5\u30D7\u30EC\u30BC\u30F3\u30C8\u3060\u3063\u3066\uFF1F\u3053\u308C\u306F\u3001\u3046\u30FC\u3093\u2026 \u3069\u3046\u3057\u3066\u3053\u3093\u306A\u3082\u306E\u3092\u2026\u3068\u306B\u304B\u304F\u3001\u8A95\u751F\u65E5\u3092\u899A\u3048\u3068\u3044\u3066\u304F\u308C\u305F\u3053\u3068\u306B\u306F\u611F\u8B1D\u3059\u308B\u3088\u3002",
