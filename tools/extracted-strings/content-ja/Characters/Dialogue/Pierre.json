    "Tue6": "\u79C1\u306F\u6614\u3001 \u7D50\u69CB\u5F37\u3044 \u30DC\u30AF\u30B5\u30FC \u3060\u3063\u305F\u306E\u3067\u3059\u2026 \u3053\u306E\u53F3\u30D5\u30C3\u30AF\u306F \u5F53\u6642 \u8A71\u984C\u306B\u3082 \u306A\u308A\u307E\u3057\u305F\u3088\uFF01$h",
    "Wed": "$d Joja#\u4ECA\u65E5\u306F \u304A\u4F11\u307F\u3067\u3059\u3088\u3002#$e#\u3046\u30FC\u3093\u2026 \u4F55\u3092\u3057\u3088\u3046\u304B\u2026$s|\u3082\u3057 \u91CE\u751F\u306E \u8FB2\u7523\u7269\u3092 \u898B\u3064\u3051\u305F\u3089\u3001 \u3044\u3044 \u304A\u5024\u6BB5\u3067 \u8CB7\u3044\u53D6\u308A\u307E\u3059\u3088\u3002",
    "Wed4": "#$1 pierre1#\u306F\u3041\u2026 \u3069\u308C\u3060\u3051 \u5546\u58F2\u304C \u3088\u304F \u884C\u3063\u3066\u3082\u3001 \u6210\u529F\u3057\u305F\u3044\u3068\u3044\u3046 \u6C17\u6301\u3061\u304C \u306A\u304B\u306A\u304B \u6E80\u305F\u305B\u307E\u305B\u3093\u306D\u3002\u79C1\u3001 \u3044\u3063\u305F\u3044 \u3069\u3046\u3057\u305F\u306E \u3067\u3057\u3087\u3046\uFF1F\u305F\u3076\u3093\u3001 \u666E\u901A\u306E \u751F\u6D3B\u306B \u98FD\u304D\u305F \u3060\u3051\u304B\u3082\u3002$s#$e#\u82E5\u304B\u3063\u305F\u9803\u306F\u3001 \u4F55\u3092 \u3057\u3066\u3044\u3066\u3082 \u697D\u3057\u304B\u3063\u305F\u306E\u3067\u3059\u304C\u2026 \u4ECA\u3068\u306A\u3063\u3066\u306F \u4ED5\u4E8B\u3092\u3057\u3066\u3044\u306A\u3044 \u6642\u9593\u3092 \u7121\u99C4\u306B \u904E\u3054\u3057\u3066\u308B\u3088\u3046\u306A \u6C17\u304C\u3059\u308B\u306E\u3067\u3059\u3002$s",
