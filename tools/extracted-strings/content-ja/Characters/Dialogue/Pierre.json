    "Thu8": "#$1 pierre2#\u30A2\u30D3\u30B2\u30A4\u30EB\u306F \u79C1\u306B \u4F3C\u3066\u3044\u307E\u3059\u304B\u306D\uFF1F\u59BB\u306B\u306F \u79D8\u5BC6 \u3067\u3059\u304C\u3001 \u6642\u3005 \u81EA\u5206\u304C \u672C\u5F53\u306B \u3042\u306E\u5B50\u306E \u7236\u89AA\u304B \u308F\u304B\u3089\u306A\u304F \u306A\u308B\u306E\u3067\u3059\u3002$k$s#$e#\u59BB\u306B\u306F \u79D8\u5BC6\u3067\u3059\u304C\u3001 \u5915\u98DF\u3092 \u4F5C\u308B\u306E\u304C \u30A4\u30E4\u306A\u3093\u3067\u3059\u3002",
