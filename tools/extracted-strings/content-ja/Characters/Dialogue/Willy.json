    "Sun": "\u9AD8\u54C1\u8CEA\u306A \u91E3\u7AFF\u3092 \u8CB7\u3048\u3070\u3001 \u91E3\u308A\u30A8\u30B5\u3068 \u91E3\u5177\u3092 \u3064\u3051\u3089\u308C\u308B\u3088\u3046\u306B\u306A\u308B\u305E\u3002#$b#\u91E3\u308A\u30A8\u30B5\u306F \u9B5A\u304C \u65E9\u304F \u91DD\u306B \u98DF\u3044\u3064\u304F\u3088\u3046\u306B\u306A\u308B\u3002\u91E3\u5177\u306F \u9B5A\u3092 \u7C21\u5358\u306B \u5F15\u304D\u4E0A\u3052\u3089\u308C\u308B\u3088\u3046\u306B \u306A\u308B\u305E\u3002#$e#\u91E3\u5177\u306B\u3088\u3063\u3066\u3001 \u7570\u306A\u308B \u52B9\u679C\u3092 \u6301\u3063\u3066\u3044\u308B\u304C\u3001\u5927\u4F53\u306E \u91E3\u5177\u306F \u3082\u308D\u3044\u304B\u3089\u3001 \u4F7F\u3063\u3066\u3044\u308B\u9593\u306B \u58CA\u308C\u3066\u3082 \u9A5A\u304F\u3093\u3058\u3083 \u306D\u3048\u305E\u3002",
