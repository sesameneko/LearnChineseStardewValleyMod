    "AcceptGift_(O)StardropTea": "\u308F\u3042\uFF01 \u91D1\u306E\u30AF\u30EB\u30DF\u307F\u305F\u3044\u306A\u5473\u3060\u306D\uFF01\u3059\u3063\u3054\u304F\u304A\u3044\u3057\u3044\u3088\uFF01",
    "AcceptGift_(TR)ParrotEgg": "\u3053\u308C\u306F\u5927\u5207\u306A\u30BF\u30DE\u30B4\u2026\u8D64\u3061\u3083\u3093\u3060\u3088\uFF01\u6301\u3063\u3066\u304D\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3002\u30DC\u30AF\u304C\u305C\u3063\u305F\u3044\u5B88\u308B\u3088\u3002",
    "Fri": "\u4E00\u5EA6\u3060\u3051\u2026\u591C\u306B\u706B\u5C71\u306E\u9802\u4E0A\u306B\u3044\u305F\u3089\u3001\u3068\u3066\u3082\u9060\u304F\u306B\u660E\u304B\u308A\u304C\u898B\u3048\u305F\u3093\u3060\u3002#$b#\u4ED6\u306B\u3082\u9CE5\u306E\u5BB6\u65CF\u304C\u3044\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u306A\uFF1F$3",
    "Fri4": "\u706B\u5C71\u306E\u4E0A\u304B\u3089\u30AD\u30DF\u306E\u5BB6\u304C\u898B\u3048\u308B\u304B\u306A\uFF1F",
    "Mon": "\u3084\u3042\u2026\u8ABF\u5B50\u306F\u3069\u3046\uFF1F",
    "Mon4": "\u30DC\u30AF\u306F\u30AA\u30A6\u30E0\u306E\u5BB6\u65CF\u304B\u3089\u8272\u3005\u306A\u4E8B\u3092\u6559\u308F\u3063\u305F\u3093\u3060\u2026#$b#\u3067\u3082\u3001\u30DC\u30AF\u306B\u306F\u307E\u3060\u307E\u3060\u77E5\u3089\u306A\u3044\u3053\u3068\u304C\u305F\u304F\u3055\u3093\u3042\u308B\u3068\u601D\u3046\u3093\u3060\u3002$s",
    "Sat": "\u2026\u4ECA\u65E5\u306F\u306A\u3093\u3060\u304B\u60B2\u3057\u3044\u3093\u3060\u3002$s#$e#\u3082\u3046\u884C\u3063\u3066\u2026\u697D\u3057\u3093\u3067\u304D\u3066\u306D\u3002\u4ECA\u306F\u60B2\u3057\u3044\u6C17\u6301\u3061\u3067\u3044\u3055\u305B\u3066\u3002$s",
    "Sun": "\u96E8\u304C\u964D\u308B\u3068\u5909\u308F\u3063\u305F\u9CE5\u304C\u73FE\u308C\u308B\u3093\u3060\u3002#$b#\u58F0\u3092\u304B\u3051\u3088\u3046\u3068\u3059\u308B\u3093\u3060\u3051\u3069\u2026\u98DB\u3093\u3067\u884C\u3063\u3061\u3083\u3046\u3093\u3060\u3002$s#$b#\u53CB\u9054\u306B\u306A\u308A\u305F\u304F\u306A\u3044\u306E\u304B\u306A\u2026$s",
    "Thu": "\u30AD\u30DF\u306F\u3001\u30AD\u30DF\u307F\u305F\u3044\u306A\u4EBA\u305F\u3061\u3068\u4F1A\u3063\u305F\uFF1F#$b#\u30DC\u30AF\u306F\u3042\u3093\u307E\u308A\u8A71\u3057\u304B\u3051\u306A\u3044\u3093\u3060\u3002\u540C\u3058\u7A2E\u65CF\u306E\u65B9\u304C\u5B89\u5FC3\u3067\u304D\u308B\u3088\u2026$3",
    "Tue": "\u592A\u967D\u304C\u6012\u3063\u305F\u3089\u3001\u30B8\u30E3\u30F3\u30B0\u30EB\u306B\u3044\u308B\u3068\u5FEB\u9069\u306A\u3093\u3060\u3002#$e#\u8449\u3063\u3071\u306E\u4E0B\u306B\u3044\u308B\u30DC\u30AF\u3089\u3092\u3001\u592A\u967D\u306F\u898B\u3064\u3051\u3089\u308C\u306A\u3044\u304B\u3089\u306D\u3002\u9A19\u305B\u3070\u3044\u3044\u3060\u3051\u3060\u3088\uFF01\u306F\u306F\u3063\u2026$h",
    "Wed": "\u2026\u3054\u3081\u3093\u2026\u4ECA\u65E5\u306F\u8AB0\u3068\u3082\u8A71\u3057\u305F\u304F\u306A\u3044\u3093\u3060\u3002$3",
    "Wed2": "\u706B\u5C71\u3067\u306F\u6C17\u3092\u4ED8\u3051\u3066\u306D\u2026\u7CBE\u970A\u305F\u3061\u306F\u90E8\u5916\u8005\u3092\u5ACC\u3046\u3093\u3060\u3002"
