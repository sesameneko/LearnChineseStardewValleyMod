  "entries": {
    "Good_1": "\u4E00\u7DD2\u306B \u4F4F\u3080\u3088\u3046\u306B \u306A\u3063\u3066\u304B\u3089\u3001 \u307E\u305F \u4E00\u4EBA\u306B \u306A\u308B\u59FF\u304C \u60F3\u50CF \u3057\u3065\u3089\u304F\u306A\u3063\u305F\u308F\u3002",
    "Good_2": "\u4F11\u61A9\u4E2D\uFF1F\u3044\u3044\u308F\u306D\uFF01",
    "Good_3": "\u7267\u5834\u904B\u55B6\u306E \u8A08\u753B\u306B\u306F \u69D8\u3005\u306A \u6226\u7565\u304C \u3042\u308B\u308F\u306D\u3002\u601D\u3063\u305F\u4EE5\u4E0A\u306B\u3001 \u982D\u3092 \u523A\u6FC0\u3055\u305B\u3066\u304F\u308C\u308B\u308F\uFF01",
    "Good_4": "\u524D\u306B\u3001 \u30ED\u30DC\u30C3\u30C8\u306E ${\u592B\u3092^\u59BB\u3092}$ \u4F5C\u308D\u3046\u3068 \u601D\u3063\u3066\u305F\u3053\u3068\u304C \u3042\u3063\u305F\u306E\u3002\u3067\u3082\u3001 \u3042\u306A\u305F\u306E \u307B\u3046\u304C \u305A\u3063\u3068 \u3044\u3044\u308F\uFF01$h",
    "Good_5": "\u7D50\u5A5A\u5F0F\u306B \u3082\u3089\u3063\u305F \u9996\u98FE\u308A\u304C \u7F8E\u3057\u3044\u306D\u2026\u7279\u306B \u3053\u306E \u8C9D\u6BBB\u306F \u30AB\u30F3\u30DA\u30AD\u3002\u3068\u3066\u3082 \u73CD\u3057\u3044 \u7A2E\u985E\u3060\u304B\u3089\u306D\uFF01$l",
    "Good_6": "\u6628\u6669\u3001 \u5DE8\u5927\u306A \u671B\u9060\u93E1\u3092 \u8997\u304D\u8FBC\u3080 \u5922\u3092 \u898B\u3066\u3044\u305F\u306E\u3002%noun \u661F\u96F2\u3067 \u4F55\u304B\u304C \u52D5\u304F\u306E\u3092 \u898B\u305F\u308F\u3002\u7D50\u69CB \u6016\u304B\u3063\u305F\u3002",
    "Indoor_Day_0": "\u3093\uFF1F\u3054\u3081\u3093\u306A\u3055\u3044\u3001 \u6642\u3005 \u7269\u601D\u3044\u306B \u3075\u3051\u3063\u3061\u3083\u3063\u3066\u3001 \u4ECA \u4F55\u3092 \u3057\u3066\u308B\u304B \u5FD8\u308C\u3061\u3083\u3046\u3053\u3068\u304C \u3042\u308B\u306E\u3002",
    "Indoor_Day_1": "\u3053\u308C\u3092 \u30AC\u30E9\u30AF\u30BF\u306E \u5C71\u304B\u3089 \u898B\u3064\u3051\u305F\u306E\u3002\u3042\u306A\u305F\u306A\u3089 \u4F55\u3089\u304B\u306E \u5F62\u3067 \u4F7F\u3048\u305D\u3046\u304B\u306A\uFF1F[286 287 205 732]",
    "Indoor_Day_2": "\u3042\u3042\u3001 \u3084\u3063\u3068 \u8D77\u304D\u305F\u306E\u306D\uFF01\u304A\u8179\u304C \u30DA\u30B3\u30DA\u30B3\u3088\u2026 (\u30B0\u30A5)$h",
    "Indoor_Day_3": "\u7267\u5834\u751F\u6D3B\u3067 \u3059\u3070\u3089\u3057\u3044\u3053\u3068\u3068 \u8A00\u3048\u3070\u3001 \u9CE5\u306E\u58F0\u3067 \u76EE\u3092 \u899A\u307E\u3059\u77AC\u9593 \u306D\u3002",
    "Indoor_Day_4": "\u7267\u5834\u3067 \u4ED5\u4E8B\u3057\u3066\u308B\u306E\u306B\u3001 \u3069\u3046\u3057\u3066 \u3042\u306A\u305F\u306E\u624B\u306F \u3053\u3093\u306A\u306B \u3084\u308F\u3089\u304B\u3044\u307E\u307E\u306A\u306E\uFF1F",
    "Indoor_Night_0": "\u4ECA\u591C\u306E \u6708\u3092 \u898B\u305F\uFF1F\u5730\u5E73\u7DDA\u4E0A\u306B \u3042\u308B\u6642\u306F \u5727\u5DFB\u306B \u898B\u3048\u308B\u3088\u306D\u3002",
    "Indoor_Night_1": "\u3055\u3063\u304D \u6D41\u308C\u661F\u3092 \u307F\u305F\u306E\u3002MARILDA\u304C \u79C1\u9054\u306E \u69D8\u5B50\u3092 \u898B\u306B\u6765\u305F\u3063\u3066 \u3053\u3068\u304B\u3057\u3089\u306D\u3002$h",
    "Indoor_Night_2": "\u30C1\u30E7\u30B3\u30EC\u30FC\u30C8\u30B1\u30FC\u30AD\u304B \u5B8C\u719F\u30A4\u30C1\u30B4\u3001 \u3069\u3063\u3061\u306B \u3057\u3088\u3046\u304B\u3057\u3089\u3002\u4E21\u65B9\u3082 \u30A2\u30EA\u304B\u306A\u2026\uFF1F#$e#\u3067\u3082\u2026 \u305D\u308C\u3058\u3083\u592A\u308B\u304B\u3082\uFF1F$s",
    "Indoor_Night_3": "\u4ECA\u65E5\u306F \u304C\u3093\u3070\u3063\u305F\u308F\u306D\uFF01\u50CD\u3044\u305F\u5206\u3001 \u591C\u306F \u3086\u3063\u304F\u308A \u3084\u3059\u307F\u307E\u3057\u3087\u3002",
    "Indoor_Night_4": "\u3053\u306E\u5BB6\u3001 \u3059\u3054\u304F \u597D\u304D\u306B \u306A\u3063\u3066\u304D\u3066\u308B\u306E\u3002\u591C\u306F \u5C45\u5FC3\u5730\u304C \u3059\u3054\u304F \u3044\u3044\u304B\u3089\u3002#$e#\u30DE\u30DE\u306F \u3053\u306E\u5BB6\u306E \u6539\u7BC9\u3092 \u304C\u3093\u3070\u3063\u305F\u306E\u306D\u3002$h",
    "Neutral_0": "\u79C1\u304C \u592A\u3063\u3066\u3082\u3001 \u597D\u304D\u306A \u307E\u307E\u3067 \u3044\u3066\u304F\u308C\u308C\u3070 \u3044\u3044\u3051\u3069\u3002",
    "Neutral_8": "\u4ECA\u65E5\u306F \u51B4\u3048\u306A\u3044 \u6C17\u5206\u3060\u308F\u3002$s",
    "OneKid_0": "\u4ECA\u65E5\u306F %kid1\u3068 \u4E00\u7DD2\u306B \u3044\u3089\u308C\u305F\uFF1F\u5B50\u3069\u3082\u9054\u306E \u30DD\u30C6\u30F3\u30B7\u30E3\u30EB\u3092 \u767A\u63EE \u3059\u308B\u306B\u306F\u3001 \u904A\u3076 \u6642\u9593\u304C \u5FC5\u8981\u3060\u304B\u3089\u306D\u3002",
    "OneKid_1": "%kid1\u304C \u6210\u9577\u3057\u305F\u3089\u2026 \u3042\u306A\u305F \u307F\u305F\u3044\u306A \u7267\u5834\u4E3B\u306B \u306A\u308B\u306E\u304B\u306A\uFF1F\u305D\u308C\u3068\u3082 \u79C1\u307F\u305F\u3044\u306A \u30A8\u30F3\u30B8\u30CB\u30A2\u304B\u306A\uFF1F",
    "OneKid_3": "\u79C1\u9054\u306E \u5B50\u306B\u306F \u5927\u5909 \u671F\u5F85\u3057\u3066\u308B\u306E\u3002\u5B50\u80B2\u3066\u306E \u6700\u826F\u306A \u65B9\u6CD5\u3092 \u8A18\u3057\u305F\u3001 \u79D1\u5B66\u30C7\u30FC\u30BF\u3092 \u6700\u8FD1 \u3088\u307F\u3042\u3055\u3063\u3066\u308B\u306E\u3088\u3002",
    "Outdoor_0": "\u3042\u3042\u2026 \u3044\u3044\u5302\u3044\u306E \u7267\u5834\u306D\u3002 \u5B9F\u5BB6\u8FD1\u304F\u306E \u5C71\u3092 \u601D\u3044\u51FA\u3059\u308F\u3002",
    "Outdoor_1": "\u5C11\u3057 \u8A08\u753B\u3059\u308C\u3070\u3001 \u7267\u5834\u306E \u5927\u90E8\u5206\u3092 \u81EA\u52D5\u5316\u3057\u3066 \u697D\u3067\u304D\u308B\u3088\u3046\u306B \u306A\u308B\u308F\u306D\u3002",
    "Outdoor_2": "\u4ECA\u591C\u306F \u96F2\u306E\u306A\u3044 \u591C\u306B \u306A\u308A\u305D\u3046\u306D\u2026%noun \u5EA7\u304C \u3061\u3083\u3093\u3068 \u898B\u3048\u308B\u3088\u3046\u306B \u306A\u308B\u304B\u306A\uFF1F",
    "Outdoor_3": "\u5927\u4E08\u592B\u3001 \u6CE5\u306E \u8DB3\u8DE1\u3092 \u5BB6\u306B \u6B8B\u3057\u3066\u3082 \u6C17\u306B\u3057\u306A\u3044\u308F\u3002\u3061\u3087\u3063\u3068\u3050\u3089\u3044 \u6C5A\u308C\u3066\u3082 \u3044\u3044\u3058\u3083\u306A\u3044\u3002",
    "Outdoor_4": "\u7267\u5834\u3092 \u7D4C\u55B6\u3059\u308B\u306E\u306B\u3001 \u3053\u308C\u3060\u3051 \u8A08\u753B\u3068 \u914D\u616E\u304C \u3044\u308B\u306A\u3093\u3066 \u601D\u308F\u306A\u304B\u3063\u305F\u308F\uFF01\u7814\u7A76\u6240\u3067\u306E \u4F5C\u696D\u306B \u3059\u3054\u304F \u8FD1\u3044\u308F\u306D\u3002",
    "Rainy_Day_0": "\u6700\u8FD1 \u30DA\u30CB\u30FC\u306F \u3069\u3046\u3057\u3066\u308B\u306E\u304B\u3057\u3089\u3002\u3042\u3068\u3067 \u96FB\u8A71\u3067\u3082 \u3057\u3066\u307F\u3088\u3046\u304B\u306A\u3002",
    "Rainy_Day_1": "\u3061\u3087\u3063\u3068 \u601D\u3063\u3066\u305F\u306E\u2026 MARILDA\u306F \u5143\u6C17\u306B \u3084\u3063\u3066\u308B\u306E\u304B\u306A\u3063\u3066\u3002\u3042\u306E\u5B50\u306E \u672C\u5F53\u306E \u5C45\u5834\u6240\u304C \u898B\u3064\u304B\u308B\u3053\u3068\u3092 \u7948\u3063\u3066\u308B\u308F\u2026",
    "Rainy_Day_2": "\u306D\u3047\uFF01\u6628\u6669 \u3042\u3093\u307E\u308A \u7720\u308C\u306A\u304B\u3063\u305F\u304B\u3089\u3001 \u3061\u3087\u3063\u3068 \u4F5C\u696D\u3092 \u3057\u3066\u3044\u305F\u306E\u3002\u3053\u3093\u306A\u306E\u3092 \u4F5C\u3063\u305F\u304B\u3089 \u3042\u3052\u308B\u308F\u3002[688 369 338 325 287]#$e#\u3069\u3053\u304B\u3067 \u3042\u306A\u305F\u306E \u5F79\u306B\u7ACB\u3064\u3068 \u3044\u3044\u3051\u3069\u3002",
    "Rainy_Day_3": "\u96E8\u3067 \u552F\u4E00 \u30A4\u30E4\u306A \u3053\u3068\u3063\u3066\u3001 \u307E\u3063\u305F\u304F \u5929\u4F53\u89B3\u6E2C\u304C \u3067\u304D\u306A\u3044\u3053\u3068 \u3060\u308F\uFF01",
    "Rainy_Day_4": "\u5C4B\u6839\u304B\u3089 \u96E8\u6F0F\u308A \u3057\u3066\u308B\u306E\u304B\u3057\u3089\uFF1F\u30C1\u30A7\u30C3\u30AF\u3057\u306A\u304D\u3083\u3002\u30DE\u30DE\u3092\u898B\u3066\u3001 \u5927\u5DE5\u306E \u77E5\u8B58\u3092 \u5C11\u3005 \u5B66\u3093\u3060\u306E\u3088\u3002",
    "Rainy_Night_0": "\u9053\u5177\u3092 \u96E8\u306E\u4E2D\u306B \u3055\u3089\u3055\u306A\u3044\u3088\u3046\u306B \u3059\u308B\u306E\u3088\uFF01\u9053\u5177\u304C \u9306\u3073\u305F\u3089 \u3059\u3054\u304F \u56F0\u308B\u3067\u3057\u3087\u3002",
    "Rainy_Night_1": "@\u3055\u3093\u3053\u3093\u306B\u3061\u306F\u3002\u4ECA\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\u304B\u3057\u3089\u2026 \u3073\u3057\u3087\u306C\u308C\u306B \u306A\u3063\u305F\uFF1F#$e#\u96E8\u3067 \u601D\u3044\u3064\u3044\u305F\u308F\u2026 \u96C6\u3081\u305F \u96E8\u6C34\u3067 \u6C34\u8ECA\u3092 \u56DE\u3059\u306E\u306F \u3069\u3046\u304B\u3057\u3089\uFF1F",
    "Rainy_Night_2": "\u30D1\u30D1\u304C \u3053\u305320\u5E74\u9593\u3001 \u5929\u6C17\u306E \u5909\u308F\u308A\u5177\u5408\u3092 \u8A18\u9332\u3057\u3066\u3044\u308B\u306E\u3002#$e#\u7D50\u8AD6\u4ED8\u3051\u308B\u306E\u306F \u307E\u3060\u65E9\u3044\u3051\u3069\u3001 \u305D\u306E\u8A18\u9332\u304C \u3044\u304F\u3064\u304B\u306E \u7570\u5E38\u306A \u50BE\u5411\u3092 \u660E\u3089\u304B\u306B\u3057\u305F\u308F\u3002",
    "Rainy_Night_3": "\u4ECA\u591C\u306F \u30D9\u30C3\u30C9\u3067 \u30B9\u30D1\u30B2\u30C6\u30A3\u3092 \u98DF\u3079\u306A\u3044\uFF1F",
    "Rainy_Night_4": "\u30C7\u30B6\u30FC\u30C8\u3092 \u4F5C\u3063\u305F\u308F\u3088\uFF01\u3067\u3082\u3001 \u5BDD\u308B\u524D\u306B \u3061\u3083\u3093\u3068 \u6B6F\u3092\u78E8\u304B\u306A\u3044\u3068\u306D\u3002[232 234 223 220]$h",
    "Rainy_Night_5": "\u4ECA\u65E5\u306F \u3042\u3093\u307E\u308A \u523A\u6FC0\u7684\u306A\u4E00\u65E5\u3058\u3083 \u306A\u304B\u3063\u305F\u308F\u2026\u5929\u6C17\u306E\u305B\u3044\u3067 \u305A\u3063\u3068 \u5BB6\u306B\u3044\u305F\u304B\u3089\u3002#$e#\u3067\u3082\u3001 \u843D\u3061\u7740\u3044\u305F \u4E00\u65E5\u3060\u3063\u305F\u3002\u3086\u3063\u304F\u308A\u3068 \u300C\u9031\u9593\u57FA\u76E4\u56DE\u8DEF\u300D\u306E \u6700\u65B0\u53F7\u3092 \u8AAD\u3093\u3067\u305F\u308F\u3002",
    "TwoKids_3": "\u81EA\u5206\u3060\u3051\u306E \u4F5C\u696D\u5834\u3001 \u30B9\u30C6\u30AD\u306A\u4E8C\u4EBA\u306E \u5B50\u3069\u3082\u3001\u3059\u3070\u3089\u3057\u3044 \u571F\u5730\u3002\u4EBA\u751F \u3044\u3044\u611F\u3058\u306B \u884C\u3063\u3066\u308B\u308F\u3002",
    "fall_1": "\u5B63\u7BC0 \u3054\u3068\u306B\u3001 \u65B0\u3057\u3044 \u591C\u7A7A\u306E \u4E00\u90E8\u304C \u898B\u3048\u308B\u3088\u3046\u306B \u306A\u308B\u306E\u3088\u3002\u898B\u3066\u3044\u3066 \u697D\u3057\u3044\u308F\u3002",
    "fall_25": "\u3082\u3046\u3059\u3050 \u51AC\u3060\u306D\u3002\u6696\u623F\u3092 \u3061\u3083\u3093\u3068 \u30C1\u30A7\u30C3\u30AF\u3057\u3066\u3001 \u6C34\u9053\u306E \u86C7\u53E3\u3092 \u9589\u3081\u3066\u3001 \u5BB6\u306B \u30B9\u30AD\u30DE\u304C \u306A\u3044\u304B \u78BA\u8A8D \u3057\u306A\u3044\u3068\u3002#$e#\u3067\u3082\u3001 \u5927\u4E08\u592B\u3088\u3002\u79C1\u304C \u5168\u90E8 \u3084\u3063\u3066\u3042\u3052\u308B\u3002",
    "fall_3": "\u79CB\u306F\u3001 \u30DE\u30DE\u3068 \u6728\u3092\u5207\u308A\u306B \u3044\u3063\u3066\u305F\u6642\u3092 \u601D\u3044\u51FA\u3059\u306E\u2026 \u5207\u3063\u305F\u3070\u304B\u308A\u306E \u6728\u3068 \u6A39\u6DB2\u306E \u9999\u308A\u306E\u305B\u3044 \u304B\u3057\u3089\u306D\u3002",
    "fall_Maru": "\u7267\u5834 \u751F\u6D3B\u306F \u7D20\u6674\u3089\u3057\u3044\u3051\u3069\u3001 \u307E\u3060\u307E\u3060 \u8A3A\u7642\u6240\u3067 \u50CD\u3051\u3066 \u3046\u308C\u3057\u3044\u308F\u2026\u753A\u306E\u4EBA\u9054\u306B \u3068\u3063\u3066 \u5927\u5207\u306A \u30B5\u30FC\u30D3\u30B9 \u3060\u304B\u3089\u306D\u3002",
    "funLeave_Maru": "\u4ECA\u65E5\u306F \u30D1\u30D1\u3068 \u30DE\u30DE\u306B \u4F1A\u3044\u306B \u884C\u3053\u3046\u304B\u306A\u3002\u3057\u3070\u3089\u304F \u4F1A\u3063\u3066\u306A\u3044\u304B\u3089\u306D\u3002",
    "funReturn_Maru": "\u30DE\u30DE\u3082 \u30D1\u30D1\u3082 \u5143\u6C17\u306B\u3057\u3066\u305F\u308F\u3002\u79C1\u304C \u3044\u306A\u304F\u306A\u3063\u3066\u3082\u3001 \u3044\u3064\u3082\u3069\u304A\u308A\u306E \u751F\u6D3B\u3060\u3063\u305F\u3002\u3042\u306A\u305F\u306E \u4E00\u65E5\u306F \u3069\u3046\u3060\u3063\u305F\uFF1F",
    "patio_Maru": "\u3053\u308C\u3092\u3069\u3046\u3059\u308B\u304B\u306F\u3001\u307E\u3060\u6C7A\u3081\u3066\u306A\u3044\u3051\u3069\u2026\u305F\u307E\u306B\u306F\u3053\u3046\u3057\u3066\u3001\u304A\u6C17\u306B\u5165\u308A\u306E\u30EC\u30F3\u30C1\u3092\u305F\u3060\u632F\u308B\u3046\u306E\u3082\u305F\u306E\u3057\u3044\u306A\u3002",
    "spouseRoom_Maru": "#$c .5#\u5C11\u3057 \u661F\u3092 \u898B\u305F\u304B\u3063\u305F\u304B\u3089 \u65E9\u304F \u8D77\u304D\u305F\u306E\u3002#$e#\u4ECA\u65E5\u306F \u81EA\u5206\u306E \u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u306B \u6642\u9593\u3092\u5272\u3053\u3046\u3068 \u601D\u3046\u3051\u3069 \u3044\u3044\u304B\u3057\u3089\u3002",
    "spring_1": "\u6625\u306B \u690D\u7269\u3068 \u52D5\u7269\u304C \u307E\u305F \u52D5\u304D\u51FA\u3059\u306E\u3063\u3066 \u3059\u3070\u3089\u3057\u3044 \u5149\u666F\u306D\u3002",
    "spring_2": "\u4ECA\u5E74\u306F \u3069\u3093\u306A \u65B9\u6CD5\u3067 \u7267\u5834\u904B\u55B6\u3092 \u52B9\u7387\u5316 \u3059\u308B\u306E\uFF1F",
    "spring_22": "\u304A\u5144\u3061\u3083\u3093\u304C \u3042\u305D\u3053\u307E\u3067 \u5F15\u304D\u3053\u3082\u308A\u3058\u3083 \u306A\u304B\u3063\u305F\u3089\u3001 \u6642\u3005 \u5915\u98DF\u306B \u8A98\u3063\u3066\u305F\u3002",
    "spring_Maru": "@\u3001 \u65B0\u5E74\u306E \u521D\u4ED5\u4E8B\u304C \u3059\u3054\u304F \u697D\u3057\u307F\u3060\u308F\uFF01$h",
    "summer_2": "\u590F\u306F \u3044\u308D\u3093\u306A \u866B\u306E \u6A19\u672C\u3092 \u4F5C\u308B\u306E\u304C \u597D\u304D\u3088\u3002",
    "summer_20": "\u304A\u5144\u3061\u3083\u3093\u3001 \u30A2\u30D3\u30B2\u30A4\u30EB\u306B \u544A\u767D\u3059\u308B \u52C7\u6C17\u3092 \u3082\u3066\u308B\u304B\u306A\uFF1F",
    "summer_Maru": "\u591C\u304C \u6696\u304B\u3044 \u3053\u306E\u6642\u671F\u306F\u3001 \u5929\u4F53\u89B3\u6E2C\u306B \u3046\u3063\u3066\u3064\u3051\u306D\u3002\u3069\u3093\u306A\u3082\u306E\u304C \u898B\u3048\u308B\u304B\u306A\uFF1F",
    "winter_15": "\u6700\u8FD1\u306E \u51AC\u3063\u3066\u3001 \u5999\u306B \u5BD2\u304F\u306A\u304F\u306A\u3063\u3066\u304D\u3066\u308B \u3088\u306D\u3002",
    "winter_2": "\u305D\u308C\u3067\u3001 \u51AC\u306E \u53CE\u5165\u7DAD\u6301\u306F \u3069\u3046\u3059\u308B \u4E88\u5B9A\u304B\u3057\u3089\uFF1F#$e#\u91E3\u308A\u3084 \u53CE\u7A6B\u3092 \u3057\u306B\u884C\u3063\u3066\u3082 \u3044\u3044\u3057\u2026#$e#\u3082\u3057 \u63A1\u6398\u306B \u51FA\u304B\u3051\u308B\u306A\u3089\u3001 \u6C17\u3092\u3064\u3051\u3066\u306D\u3002",
    "winter_5": "\u30D1\u30D1\u306F \u5927\u4E08\u592B\u304B\u306A\u2026 \u91CE\u5916\u7814\u7A76\u306E \u6A5F\u4F1A\u304C \u6E1B\u308B\u304B\u3089\u3001 \u51AC\u306B\u306A\u308B\u3068 \u30D1\u30D1\u306F \u843D\u3061\u8FBC\u3093\u3067\u3057\u307E\u3046\u306E\u3088\u2026",
    "winter_Maru": "\u6625\u306F \u30EB\u30D0\u30FC\u30D6\u30D1\u30A4\u304C \u98DF\u3079\u3089\u308C\u308B\u304B\u3089 \u672C\u5F53\u306B \u697D\u3057\u307F\u3060\u308F\u3002\u3042\u306E \u98A8\u5473\u3068 \u5473\u3068\u304D\u305F\u3089\uFF01"
  }
