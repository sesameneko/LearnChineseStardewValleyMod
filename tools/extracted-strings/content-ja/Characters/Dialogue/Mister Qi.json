  "entries": {
    "Fri": "\u5B8C\u74A7\u3092\u76EE\u6307\u3059\u52AA\u529B\u3092 \u6020\u305F\u308B\u3067\u306A\u3044\u3002#$e#\u541B\u306E \u6210\u3059\u3053\u3068 \u5168\u3066\u306B \u6E80\u8DB3 \u3044\u304F\u307E\u3067\u3001 \u304C\u3093\u3070\u308B\u306E\u3060\u3002",
    "Mon": "\u305D\u306E\u8ABF\u5B50\u3067 \u304C\u3093\u3070\u308A\u305F\u307E\u3048\u3002\u541B\u306A\u3089 \u30B9\u30BF\u30FC\u306B \u306A\u308C\u308B\u3060\u308D\u3046\u3002#$e#\u4F55\u304B \u3044\u308B\u306A\u3089 \u79C1\u306B \u8A00\u3063\u3066\u304F\u308C\u3002",
    "QiNutRoom_Fri": "\u4E00\u756A\u9060\u3044\u661F\u3092\u898B\u636E\u3048\u3066\u3001\u305D\u308C\u3092\u76EE\u6A19\u306B\u3057\u306A\u3055\u3044\u3002#$b#\u305D\u308C\u304C\u4E00\u6B69\u5148\u306B\u8E0F\u307F\u51FA\u3059\u305F\u3081\u306E\u539F\u52D5\u529B\u306A\u306E\u3060\u3002",
    "QiNutRoom_Mon": "\u3053\u306E\u4E16\u754C\u306B\u306F\u3001\u76EE\u306B\u898B\u3048\u306A\u3044\u3082\u306E\u304C\u3042\u308B\u306E\u3002\u3044\u3064\u304B\u541B\u306B\u3082\u5206\u304B\u308B\u6642\u304C\u6765\u308B\u3060\u308D\u3046\u3002#$b#\u4ECA\u306F\u3001\u81EA\u5206\u306E\u884C\u52D5\u304C\u6700\u9AD8\u306E\u7D50\u679C\u3092\u751F\u3080\u3088\u3046\u306B\u52AA\u529B\u3057\u306A\u3055\u3044\u3002",
    "QiNutRoom_Sat": "\u6642\u7A7A\u3092\u8D85\u3048\u308B\u3082\u306E\u3082\u3042\u308B\u3002\u305D\u308C\u306F\u5FC3\u306E\u4E2D\u306B\u3042\u308B\u72EC\u7279\u306E\u611F\u899A\u2026\u305D\u306E\u5148\u306B\u3042\u308B\u3001\u3055\u3055\u3084\u304D\u3060\u3002",
    "QiNutRoom_Sun": "\u5DE6\u306B\u306F\u3001\u7279\u5225\u306A\u6311\u6226\u304C\u8CBC\u3089\u308C\u305F\u63B2\u793A\u677F\u2026\u541B\u306E\u305F\u3081\u306E\u7279\u5225\u306A\u7269\u3060\u3002#$b#\u53F3\u306F\u3001\u79C1\u306E\u6311\u6226\u3092\u4E57\u308A\u8D8A\u3048\u305F\u8005\u306B\u4E0E\u3048\u3089\u308C\u308B\u5831\u916C\u3060\u2026#$b#\u5065\u95D8\u3092\u7948\u308B\u3002",
    "QiNutRoom_Thu": "\u541B\u304C\u3069\u3053\u306B\u884C\u3053\u3046\u3068\u3082\u2026\u79C1\u306F\u3044\u3064\u3082\u30AB\u30FC\u30C6\u30F3\u306E\u5F8C\u308D\u3067\u3001\u305D\u306E\u30B7\u30E7\u30FC\u304C\u9762\u767D\u3044\u3082\u306E\u304B\u3069\u3046\u304B\u898B\u5B9A\u3081\u3066\u3044\u308B\u3002\u30CF\u30CF\u30CF\u2026#$b#\u3082\u3057\u304F\u306F\u79C1\u304C\u3001\u304B\u306A\uFF1F",
    "QiNutRoom_Tue": "\u79C1\u306F\u3001\u7D14\u7C8B\u306A\u610F\u5FD7\u306E\u529B\u3067\u3053\u3053\u306B\u3044\u308B\u3002#$b#\u305D\u3046\u3060\u306A\u2026\u5FC3\u306F\u3068\u3066\u3082\u5F37\u529B\u306A\u9053\u5177\u3060\u3002#$b#\u305D\u308C\u306F\u5B9F\u969B\u3001\u73FE\u5B9F\u4E16\u754C\u306B\u304A\u3051\u308B\u6700\u3082\u5F37\u529B\u306A\u9053\u5177\u3060...\u305D\u3057\u3066\u3001\u305D\u306E\u5148\u306E\u4E16\u754C\u3067\u3082\u3002",
    "QiNutRoom_Wed": "\u541B\u306E\u7C98\u308A\u5F37\u3055\u306B\u306F\u611F\u5FC3\u3055\u305B\u3089\u308C\u308B\u2026\u3053\u3053\u307E\u3067\u6765\u308B\u306B\u306F\u6CA2\u5C71\u306E\u30AF\u30EB\u30DF\u304C\u5FC5\u8981\u3060\u3063\u305F\u306F\u305A\u3060\u3002",
    "Sat": "\u30EA\u30E9\u30C3\u30AF\u30B9\u3057\u305F\u3051\u308C\u3070 \u3044\u3064\u3067\u3082 \u6765\u308B\u3068\u3044\u3044\u3002",
    "Sun": "\u52AA\u529B\u3057\u7D9A\u3051\u308C\u3070 \u3044\u305A\u308C \u541B\u3082 \u79C1\u307F\u305F\u3044\u306B \u306A\u308C\u308B\u3060\u308D\u3046\u3002",
    "Thu": "\u306D\u3047\u3001\u8AB0\u306B\u3082 \u3053\u306E\u5834\u6240\u306E\u3053\u3068\u3092 \u8A00\u308F\u306A\u3044\u3067 \u304F\u308C\u305F\u307E\u3048\u3002\u79C1\u306F \u3053\u3053\u3092\u2026 \u6392\u4ED6\u7684\u306A\u5834\u6240\u306B \u3057\u305F\u3044\u3002#$e#\u541B\u306A\u3089\u3001 \u53CB\u4EBA\u306E \u79D8\u5BC6\u3092 \u5B88\u3063\u3066\u304F\u308C\u308B\u3060\u308D\u3046\uFF1F",
    "Tue": "\u3044\u3064\u304B \u541B\u304C \u3053\u3053\u306B \u6765\u308B\u3068 \u601D\u3063\u3066\u3044\u305F\u3088\u3002\u3082\u3061\u308D\u3093\u3001 \u305D\u308C\u307E\u3067\u306E \u904E\u7A0B\u3092 \u5C11\u3005 \u96E3\u3057\u304F\u3057\u305F\u304C\u3001 \u541B\u306E \u512A\u8D8A\u611F\u3092 \u6E80\u305F\u3059\u305F\u3081\u306E \u3053\u3068\u3055\u3002",
    "Wed": "\u79C1\u306F \u751F\u307E\u308C\u3064\u304D \u305F\u3060\u306E \u5C11\u5E74\u3060\u3063\u305F\u304C\u3001 \u65E9\u3044\u3046\u3061\u306B \u3068\u3042\u308B \u9078\u629E\u3092\u3057\u305F \u304A\u304B\u3052\u3067 \u7279\u5225\u306A \u5B58\u5728\u306B \u306A\u308C\u305F\u3002",
    "married": "\u3068\u3066\u3082\u3088\u3044\u7D50\u5A5A\u5F0F\u3060\u3063\u305F\u306D\u3001@\u3002#$b#\u2026\u3093\uFF1F\u79C1\u3092\u898B\u304B\u3051\u306A\u304B\u3063\u305F\u3063\u3066\uFF1F#$b#\u30CF\u30CF\u30CF\u2026\u77E5\u3063\u3066\u3044\u308B\u3060\u308D\u3046\u2026\u30DF\u30B9\u30BF\u30FCQi\u306B\u79D8\u5BC6\u306F\u901A\u3058\u306A\u3044\u3093\u3060\u3088\u3002"
  }
