    "summer_Wed": "\u5BB6\u306E\u98FE\u308A\u3064\u3051\u3001 \u5C11\u3057\u306F\u3084\u3063\u3066\u308B\uFF1F\u3042\u305F\u3057\u3060\u3063\u305F\u3089\u3001 \u305D\u3046\u3057\u3066\u308B\u3055\u3002",
    "summer_Wed2": "\u3042\u306A\u305F\u306E\u3068\u3053 \u307F\u305F\u3044\u306A\u3001 \u53E4\u3044\u611F\u3058\u306E \u8FB2\u5BB6\u3067 \u66AE\u3089\u3057\u3066\u307F\u305F\u3044\u3002#$b# \u5E8A\u306E\u304D\u3057\u3080\u97F3\u3084\u3001 \u305F\u308C\u6728\u306B \u9759\u304B\u306B\u821E\u3046 \u7DBF\u307B\u3053\u308A\u2026\u53E4\u3044\u5EFA\u7269\u3063\u3066\u3001 \u7279\u5225\u306A\u4F55\u304B\u304C \u3042\u308B\u306E\u3088\u306D\u3002",
    "winter_1": "\u79CB\u304C \u7D42\u308F\u3063\u305F\u306D\u2026$s#$e#\u3067\u3082\u3001\u3042\u305F\u3057\u306F\u51AC\u3082\u597D\u304D\u3060\u3088\uFF01$h",
    "winter_24": "\u660E\u65E5\u306F\u30AF\u30E9\u30F3\u30D9\u30EA\u30FC\u30BD\u30FC\u30B9\u3092\u4E00\u676F\u98DF\u3079\u308B\u3064\u3082\u308A\u3002$h",
    "winter_7": "\u660E\u65E5\u3001\u96EA\u3060\u308B\u307E\u3092 \u4F5C\u308B\u306E\u304C\u697D\u3057\u307F\u3002",
    "winter_Fri": "\u3053\u3053\u3067\u66AE\u3089\u3057\u3066\u3066 \u5B66\u3093\u3060\u3053\u3068\u306F\u2026 \u5468\u308A\u3068\u9055\u3046 \u683C\u597D\u3092\u3057\u3066\u308B\u3068 \u30B8\u30ED\u30B8\u30ED\u898B\u3089\u308C\u308B\u3063\u3066 \u3053\u3068\u304B\u306A\u3002",
    "winter_Fri10": "@\u3001 \u8A00\u3044\u305F\u3044\u3053\u3068\u304C \u3042\u308B\u3093\u3060\u3051\u3069\u2026#$e#\u3048\u3063\u3068\u2026 \u305D\u306E\u2026 \u3042\u30FC\u2026 \u305D\u306E\u9774\uFF01\u672C\u5F53\u306B\u3001\u3046\u3045\u2026 \u30AD\u30EC\u30A4\u306B\u3057\u3066\u308B\u306D\u2026#$e#\u305D\u308C\u3060\u3051\u3088\u2026 \u306F\u3041\u2026$s",
    "winter_Mon": "\u5BD2\u3044\u304B\u3089 \u3042\u307E\u308A\u5916\u306B \u51FA\u305F\u304F\u306A\u3044\u304B\u306A\u3002#$e#\u3067\u3082 \u96EA\u3060\u308B\u307E\u3092 \u4F5C\u308B\u306E\u306F \u697D\u3057\u3044\u304B\u3082\u3002$h",
    "winter_Sat": "\u4ECA\u65E5\u306F \u9031\u672B\u3060\u306D\uFF01#$e#\u3064\u307E\u308A\u3001 \u30D3\u30C7\u30AA\u30B2\u30FC\u30E0\u3092 \u3044\u3064\u3082\u306E\u500D \u904A\u3079\u308B\u3063\u3066\u308F\u3051\u3002$h#$e#\u3058\u3083\u3042\u306D\u3002",
    "winter_Sat6": "\u6700\u8FD1\u3001 \u3088\u304F\u7269\u601D\u3044\u306B \u3075\u3051\u3063\u3061\u3083\u3046\u306E\u3088\u2026#$e#\u3048\u3063\uFF1F\u3069\u3093\u306A\u5185\u5BB9\u304B \u77E5\u308A\u305F\u3044\u3063\u3066\uFF1F\u3048\u3063\u3068\u2026$u#$b#\u2026\u6559\u3048\u3066\u3042\u3052\u306A\u3044\u3002$h",
    "winter_Sun": "\u3042\u3089\u3001\u3053\u3093\u306B\u3061\u306F\u3002#$q 29/30 winter_Sun_old#\u7D75\u30922\u679A\u63CF\u3044\u305F\u306E\u3002\u3053\u308C\u3001\u3069\u3046\u601D\u3046\uFF1F#$r 29 20 Sun_29#\u71B1\u5E2F\u306E\u5CF6\u3068 \u30C8\u30E9\u306E\u7D75\u304C\u597D\u304D\u3002#$r 30 5 Sun_30#\u65A7\u3092\u6301\u3063\u305F \u30AA\u30FC\u30AF\u306E\u7D75\u304C\u597D\u304D\u3002#$r 29 -50 Sun_Bad#\u3069\u3063\u3061\u3082 \u597D\u307F\u3058\u3083\u306A\u3044\u3002",
    "winter_Sun_old": "$p 29#\u5C11\u3057\u524D\u306B \u3042\u305F\u3057\u304C\u898B\u305B\u305F\u7D75\u3092 \u899A\u3048\u3066\u308B\uFF1F\u3046\u3063\u304B\u308A \u6368\u3066\u3066\u3057\u307E\u3063\u305F\u306E\u3002$s|\u3042\u305F\u3057\u304C \u63CF\u3044\u3066\u898B\u305B\u305F \u30AA\u30FC\u30AF\u306E\u7D75\u3001 \u899A\u3048\u3066\u308B\uFF1F\u30AA\u30F3\u30E9\u30A4\u30F3\u306E \u30B3\u30F3\u30C6\u30B9\u30C8\u306B\u51FA\u3057\u305F\u3089\u3001 50G\u306E\u8CDE\u91D1\u3092\u8CB0\u3063\u305F\u306E\uFF01$h",
    "winter_Thu": "\u4ECA\u5E74\u3082 \u3082\u3046\u3059\u3050\u7D42\u308F\u308A\u304B\u3002#$e#\u6642\u9593\u304C\u904E\u304E\u308B\u306E\u3063\u3066 \u672C\u5F53\u306B\u901F\u3044\u3088\u306D\u3002$s",
    "winter_Thu10": "\u307E\u305F\u4E00\u5E74\u304C \u904E\u304E\u3066\u884C\u304F\u306E\u306D\u2026#$b#\u3067\u3082\u3001\u4ECA\u5E74\u306F \u3059\u3054\u304F\u3044\u3044\u5E74\u3060\u3063\u305F\u3002 \u305D\u3046\u601D\u3046\u3067\u3057\u3087\uFF1F$h",
    "winter_Tue": "\u4ECA\u3059\u3050\u3001\u71B1\u3005\u306E\u30B3\u30B3\u30A2\u3092\u4E00\u676F\u3044\u308C\u308B\u306E\u3063\u3066\u3088\u304F\u306A\u3044\u304B\u306A\uFF1F",
    "winter_Tue4": "\u3059\u3054\u304F\u5BD2\u3044\u308F\u306D\u3002 \u3042\u305F\u305F\u304B\u3044\u30B3\u30B3\u30A2\u3092 \u5206\u3051\u5408\u3048\u305F\u3089\u306A\u3041\u3002$h",
    "winter_Wed": "\u3088\u304A\u3002\u7267\u5834\u4E3B\u3063\u3066\u51AC\u306E\u9593\u306F\u9000\u5C48\u3060\u3063\u305F\u308A\u3057\u306A\u3044\uFF1F",
    "winter_Wed2": "\u3088\u304A\u3002\u30D2\u30DE\u3060\u3063\u305F\u3089\u3001 \u3044\u3064\u3067\u3082\u90E8\u5C4B\u306B \u6765\u3066\u3044\u3044\u308F\u3088\u3002#$e#\u3082\u3061\u308D\u3093\u3001 \u3042\u305F\u3057\u304C\u7740\u66FF\u3048\u3066\u308B \u9014\u4E2D\u3067\u306A\u3051\u308C\u3070\u306D\uFF01",
    "winter_Wed6": "\u3053\u306E\u5B63\u7BC0\u306F\u3001 \u4F5C\u7269\u3092\u6C17\u306B\u3057\u306A\u304F\u3066 \u6E08\u3080\u304B\u3089\u3044\u3044\u3088\u306D\u3002#$e#\u305D\u306E\u5206\u3001\u3042\u305F\u3057\u3068 \u4E00\u7DD2\u306B\u904E\u3054\u305B\u308B\u3088\u3046\u306B \u306A\u308B\u304B\u3089\uFF01$h",
    "wonEggHunt": "\u304D\u306E\u3046\u306F\u3068\u3066\u3082\u3044\u3044\u6C17\u5206\u3060\u3063\u305F\u3067\u3057\u3087\uFF1F\u3067\u3082\u6765\u5E74\u306F\u305D\u3046\u7C21\u5358\u306B\u306F\u3044\u304B\u306A\u3044\u308F\u3088\u2026$u",
    "wonEggHunt_memory_oneyear": "\u53BB\u5E74\u306E\u30A8\u30C3\u30B0\u30CF\u30F3\u30C8\u3067\u3042\u306A\u305F\u306B\u8CA0\u3051\u305F\u3053\u3068\u3092\u5FD8\u308C\u3066\u306A\u3044\u304B\u3089\u306D\u3002\u305D\u308D\u305D\u308D\u7DF4\u7FD2\u3057\u3066\u304A\u3044\u305F\u65B9\u304C\u3044\u3044\u308F\u3088\u2026"
  }
