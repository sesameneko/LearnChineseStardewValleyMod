    "winter_Fri": "\u30DA\u30CB\u30FC\u306F \u53E4\u66F8\u304C \u5927\u597D\u304D\u306A\u3088\u3046\u306D\u3002\u3042\u305F\u3057\u3088\u308A\u3082 \u305A\u3063\u3068 \u982D\u304C \u3088\u304F\u306A\u3063\u3066\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u3057\u3089\u3002#$e#\u3044\u3044\u3053\u3068\u3060\u3088\u3002",
