    "married_Penny": "\u3042\u306E\u5B50\u304C\u3044\u306A\u304F\u3066\u672C\u5F53\u306B\u3055\u3073\u3057\u3044\u3093\u3060\u2026$s#$b#\u79C1\u306E\u30DA\u30CB\u30FC\u3092\u5927\u5207\u306B\u3057\u3066\u304A\u304F\u308C\u3088\u3002\u805E\u3044\u3066\u308B\u306E\u304B\u3044\uFF1F$u",
    "pamHouseUpgrade": "\u307E\u3055\u304B \u5BB6\u306A\u3093\u304B \u30D7\u30EC\u30BC\u30F3\u30C8\u3057\u3066 \u304F\u308C\u308B\u306A\u3093\u3066\uFF01\u4F55\u304B \u7406\u7531\u3067\u3082 \u3042\u308B\u306E\u304B\u3044\uFF1F#$e#\u306A\u3093\u304B\u3054\u3081\u3093\u306D\u3001 \u4EBA\u306B\u3053\u3093\u306A\u306B \u89AA\u5207\u306B \u3055\u308C\u308B\u306A\u3093\u3066 \u306A\u308C\u3066\u306A\u304F\u3066\u3055\u2026$s",
    "pamHouseUpgradeAnonymous": "\u77E5\u3089\u306A\u3044 \u8AB0\u304B\u3055\u3093\u304C \u79C1\u306B\u5BB6\u3092 \u8CB7\u3063\u3066 \u304F\u308C\u305F\u3093\u3060\u3088\uFF01\u306A\u306B\u304B\u306E \u30B5\u30AE\u3068\u304B\u3058\u3083 \u306A\u3044\u306E\u304B\u306D\u3048\uFF1F#$e#\u306A\u3093\u304B\u3054\u3081\u3093\u306D\u3001 \u4EBA\u306B\u3053\u3093\u306A\u306B \u89AA\u5207\u306B \u3055\u308C\u308B\u306A\u3093\u3066 \u306A\u308C\u3066\u306A\u304F\u3066\u3055\u2026$s",
    "pamHouseUpgrade_memory_oneweek": "\u65B0\u3057\u3044\u5BB6\u306E\u4F4F\u307F\u5FC3\u5730\u306F\u6700\u9AD8\u3055\u3002\u611F\u8B1D\u3057\u3066\u308B\u3088\u3001\u82E5\u3044\u306E\uFF01$h",
    "reject_867": "\u3046\u308F\u3063\u3001\u3042\u308C\u3092\u3054\u3089\u3093\u3088\u2026\u306A\u3093\u3060\u304B\u672A\u6765\u304B\u3089\u51FA\u3066\u304D\u305F\u307F\u305F\u3044\u3060\u306D\u3002#$b#\u3078\u3078\u3078\u3001\u60AA\u3044\u306D\u3001\u82E5\u3044\u306E\u2026\u3042\u305F\u3057\u306B\u306F\u4F7F\u3048\u306A\u3044\u3088\u3002\u30DC\u30BF\u30F3\u306E\u6570\u304C\u3001\u3042\u305F\u3057\u306E\u8133\u7D30\u80DE\u3088\u308A\u3082\u591A\u3044\u3093\u3060\uFF01$h",
    "structureBuilt_Fish Pond": "\u9B5A\u306E\u3044\u308B\u6C60\u3092\u4F5C\u3063\u305F\u3089\u3057\u3044\u306D\u2026\u3078\u3078\u3063\u3001\u3042\u305F\u3057\u306F\u9B5A\u306E\u3044\u308B\u6C60\u306E\u305D\u3070\u3067\u80B2\u3063\u305F\u3093\u3060\u3002#$b#\u3042\u306E\u6C60\u304C\u3042\u308C\u3070\u4F55\u3067\u3082\u80B2\u3066\u3089\u308C\u308B\u3088\u2026\u3060\u3051\u3069\u3001\u6B32\u5F35\u308A\u306A\u9B5A\u306F\u672C\u5F53\u306B\u3084\u3063\u304B\u3044\u3082\u306E\u3055\uFF01",
    "summer_Fri": "\u2026\u3093\uFF1F#$e#\u3042\u3093\u305F\u3001 \u7D50\u69CB \u30A4\u30B1\u3066\u308B \u3058\u3083\u306A\u3044\u3002\u3069\u3046\u3057\u3066 \u3042\u305F\u3057 \u307F\u305F\u3044\u306A \u304A\u3070\u3055\u3093\u306B \u3088\u304F \u8A71\u3057\u304B\u3051\u308B\u3093\u3060\u3044\uFF1F^\u3042\u3093\u305F\u3001 \u7D50\u69CB \u304B\u308F\u3044\u3044\u3058\u3083\u306A\u3044\u3002\u3069\u3046\u3057\u3066 \u3042\u305F\u3057\u307F\u305F\u3044\u306A \u4EBA\u306B \u3088\u304F \u8A71\u3057\u304B\u3051\u308B\u3093\u3060\u3044\uFF1F",
    "summer_Sat": "\u8AB0\u304B\u304C \u3042\u305F\u3057\u306E \u5BB6\u306E\u5EAD\u3092\u2026 \u30E1\u30C1\u30E3\u30AF\u30C1\u30E3\u3060\u3063\u3066 \u6587\u53E5 \u8A00\u3063\u3066\u308B\u308F\u3002\u3042\u3093\u305F\u306A\u306E\uFF1F$u#$e#\u3075\u30FC\u3093\u2026",
    "summer_Sat2": "\u5BB6\u306E \u96A3\u306B\u3044\u308B \u72AC\u306F \u6C17\u306B\u3057\u306A\u3044\u3067\u3002#$b#\u3042\u3093\u305F\u306E\u3053\u3068\u3092 \u30B8\u30C3\u3068 \u898B\u3066\u3044\u3066\u3082\u3001 \u3042\u306E\u7BB1\u304B\u3089 \u51FA\u308B\u3053\u3068\u306A\u3093\u3066 \u5F53\u5206 \u306A\u3044\u308F\u3088\u3002#$b#\u3042\u3044\u3064\u306E \u540D\u524D\uFF1F\u30C0\u30B9\u30C6\u30A3\u3088\u3002",
    "summer_Thu": "\u3053\u3093\u306B\u3061\u306F\u3001 \u7267\u5834\u4E3B\u3055\u3093\u3002#$e#\u3042\u305F\u3057\u306F \u3088\u305D\u8005\u3068\u306F \u3042\u3093\u307E\u308A \u8A71\u3092 \u3057\u306A\u3044\u306E\u3088\u3002",
    "summer_Thu4": "\u3044\u3064\u3082 \u6C17\u3065\u3044\u305F\u3089 \u9152\u5834\u306B\u3044\u308B\u3088\u3046\u306A \u611F\u3058\u304C \u3059\u308B\u306E\u3088\u3002#$e#\u5BB6\u306B \u8FD1\u3059\u304E\u308B\u304B\u3089 \u304B\u3082\u306D\u3002\u307B\u3093\u3068 \u5065\u5EB7\u306B \u3088\u304F\u306A\u3044\u308F\u3002",
    "summer_Tue": "\u3069\u3046\u3082\u3001 \u3088\u305D\u8005\u3055\u3093\u3002",
    "summer_Tue2": "\u3042\u3089\u3001 @ \u574A\u3061\u3083\u3093 \u3058\u3083\u306A\u3044\u3002^\u3042\u3089\u3001 @ \u5B22\u3061\u3083\u3093 \u3058\u3083\u306A\u3044\u3002#$e#\u4F55\u304B \u7528\u4E8B\u3067\u3082 \u3042\u308B\u306E\uFF1F",
    "summer_Tue6": "\u3042\u305F\u3057\u3082\u3001\u6614\u306F \u5922\u3068\u5E0C\u671B\u3092 \u6301\u3063\u3066\u305F\u3055\u2026\u3067\u3082\u4ECA\u306E\u3000\u3042\u305F\u3057\u3092 \u898B\u306A\u3088\u3002$s#$e#\u4EBA\u751F\u3063\u3066 \u3044\u3064\u3082 \u601D\u3044\u901A\u308A\u306B\u306F \u884C\u304B\u306A\u3044\u3082\u3093\u3060\u3002#$e#\u307E\u3042\u3002\u81EA\u5206\u304C \u6301\u3063\u3066\u3044\u306A\u3044\u3082\u306E\u306B \u30B0\u30C0\u30B0\u30C0 \u8A00\u3046\u306E\u306F \u7121\u99C4\u3088\u306D\u3002",
    "summer_Wed": "\u7267\u5834\u304C \u3042\u308B\u306E\u306F \u3053\u306E\u753A\u306B\u3068\u3063\u3066 \u3044\u3044\u3053\u3068\u3060\u306D\u3002",
