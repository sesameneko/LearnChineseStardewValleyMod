    "AcceptGift_(O)StardropTea": "\u3053\u3044\u3064\u306F\u3059\u3054\u3044\u306D\u2026\u3053\u3093\u306A\u30D7\u30EC\u30BC\u30F3\u30C8\u3092\u3082\u3089\u3048\u308B\u306A\u3093\u3066\u601D\u3063\u3066\u306A\u304B\u3063\u305F\u3088\u3002\u3042\u3093\u305F\u306E\u304A\u304B\u3052\u3067\u3044\u3044\u65E5\u306B\u306A\u3063\u305F\u3088\uFF01 \u82E5\u3044\u306E\uFF01",
    "Fri": "\u6BCE\u65E5 \u304A\u306A\u3058\u3053\u3068\u306E \u7E70\u308A\u8FD4\u3057\u3060\u3088\u2026$s#$b#\u3082\u3057 \u3042\u305F\u3057\u304C \u304A\u91D1\u6301\u3061 \u3060\u3063\u305F\u3089\u2026$s",
    "Fri2": "\u3042\u306E\u306D\u3001 \u8003\u3048\u3066\u3044\u305F\u3051\u3069\u3055\u2026\u306A\u3093\u304B \u8DA3\u5473\u3092 \u6301\u3063\u3068\u3051\u3070 \u826F\u304B\u3063\u305F\u3063\u3066\u3002\u6BCE\u6669 \u9152\u5834\u3067 \u9154\u3044\u3064\u3076\u308C\u308B \u4EE5\u5916\u306B\u3001 \u3067\u304D\u308B\u3053\u3068\u3092\u306D\u3002#$e#\u306A\u306B\u304B \u30A2\u30A4\u30C7\u30A2\u306F \u3042\u308B\uFF1F#$e#\u2026\u3075\u30FC\u3093\u3002\u4E00\u4EBA\u3067 \u30C1\u30A7\u30C3\u30AB\u30FC\u3067\u3082 \u3059\u308B\u304B\u306D\u3048\u3002",
    "GreenRain": "\u3053\u308C\u306F\u5929\u7F70\u3060\u3088\u2026\u79C1\u305F\u3061\u306F\u3082\u3046\u304A\u3057\u307E\u3044\u3060\u2026%noturn$s",
    "GreenRainFinished": "\u3042\u3042\u3001\u307E\u3060\u7D42\u308F\u308A\u306E\u6642\u306F\u6765\u3066\u306A\u3044\u3088\u3046\u3060\u306D\u3001\u82E5\u3044\u306E\u2026#$e#\u3055\u3066\u3001\u65E5\u8AB2\u306B\u623B\u308D\u3046\u304B\u306D\u2026",
    "GreenRain_2": "\u3053\u306E\u96E8\u306F\u304D\u3063\u3068\u306A\u306B\u304B\u306E\u8B66\u544A\u306A\u3093\u3060\u3088\u2026#$b#\u81EA\u7136\u73FE\u8C61\u3001\u30E8\u30D0\u795E\u306E\u601D\u3057\u53EC\u3057\u3001\u8003\u3048\u65B9\u306F\u3044\u308D\u3044\u308D\u3042\u308B\u3060\u308D\u3046\u3051\u3069\u3001\u3042\u305F\u3057\u306F\u305D\u3046\u601D\u3063\u3066\u308B\u3088\u3002#$e#\u3068\u306B\u304B\u304F\u3001\u3046\u306C\u307C\u308C\u3059\u304E\u3061\u3083\u3044\u3051\u306A\u3044\u3063\u3066\u3053\u3068\u3055\u3002\u3055\u3082\u306A\u3051\u308A\u3083\u3001\u7DD1\u306E\u96E8\u306E\u304B\u308F\u308A\u306B\u8840\u306E\u3088\u3046\u306A\u8D64\u3044\u96E8\u304C\u964D\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304B\u3089\u306D\u2026\u3042\u305F\u3057\u306E\u8A00\u3044\u305F\u3044\u3053\u3068\u304C\u308F\u304B\u308B\u304B\u3044\uFF1F",
    "Introduction": "\u306D\u3047\u3001\u82E5\u3044\u306E\u3002\u3042\u305F\u3057\u306F\u30D1\u30E0\u3002#$e#\u30D0\u30AB\u306A\u3053\u3068\u3092 \u3057\u306A\u3044\u9650\u308A\u3001 \u3088\u308D\u3057\u304F \u3084\u3063\u3066\u3044\u3051\u308B\u308F\u306D\u3002",
    "Mon": "#$1 PamDrank#\u3046\u30FC\u3093\u2026 \u982D\u304C \u75DB\u3044\u2026$k#$e#\u8CB7\u3048\u308B\u307B\u3069 \u5B89\u304B\u3063\u305F\u3089\u3001 \u3082\u3063\u3068 \u5065\u5EB7\u306A \u98DF\u4E8B\u3092 \u53D6\u3063\u3066\u305F\u3055\u3002#$e#\u3042\u3093\u305F\u306E \u7267\u5834\u3058\u3083 \u3046\u307E\u305D\u3046\u306A \u91CE\u83DC\u3092 \u6CA2\u5C71 \u80B2\u3066\u3066\u308B\u306E\u3088\u306D\uFF1F",
    "MovieInvitation": "\u3053\u306E\u3042\u305F\u3057\u3068\u30C7\u30FC\u30C8\u304C\u3057\u305F\u3044\u306E\u304B\u3044\uFF1F \u30CF\u30CF\u30CF\uFF01$h^\u3053\u306E\u3042\u305F\u3057\u3068\u591C\u306E\u5973\u5B50\u4F1A\u3067\u3082\u3059\u308B\u6C17\u304B\u3044\uFF1F \u30CF\u30CF\u30CF\uFF01$h#$b#\u308F\u304B\u3063\u305F\u3088\u3001\u82E5\u3044\u306E\u2026 \u305D\u3053\u3067\u5F85\u3063\u3066\u308B\u3088\u3002",
    "Resort": "\u30D8\u3078\u30D8\u2026\u6765\u308B\u9014\u4E2D\u3001\u30A6\u30A3\u30EA\u30FC\u304B\u3089\u9B5A\u306E\u30B8\u30E3\u30FC\u30AD\u30FC\u3092\u3082\u3089\u3063\u305F\u3093\u3060\u3002\u3046\u307E\u3044\u306D\u3048\uFF01",
    "Resort_Bar": "\u3053\u3093\u306A\u6A5F\u4F1A\u306F\u3081\u3063\u305F\u306B\u306A\u3044\u3088\u3001\u82E5\u3044\u306E\u2026\u3042\u305F\u3057\u306F\u306D\u3001\u30A4\u30A4\u30E2\u30CE\u306E\u3092\u6CE8\u6587\u3057\u3066\u308B\u3093\u3060\u3002\u30C0\u30D6\u30EB\u3067\u306D\uFF01$h",
    "Resort_Chair": "\u6C17\u6301\u3061\u3044\u3044\u3082\u3093\u3060\u306D\uFF01\u9774\u3082\u8131\u3044\u3058\u307E\u304A\u3046\uFF01$h#$e#\u3042\u3093\u307E\u308A\u4EBA\u306E\u8DB3\u3092\u3058\u308D\u3058\u308D\u898B\u308B\u3093\u3058\u3083\u306A\u3044\u3088\u3001\u82E5\u3044\u306E\u3002",
    "Resort_Shore": "\u4F55\u3060\u304B\u5909\u306A\u9B5A\u304C\u305F\u304F\u3055\u3093\u3044\u308B\u3088\u3002\u6B21\u306B\u6765\u308B\u6642\u306F\u3001\u91E3\u308A\u7AFF\u304C\u5FC5\u8981\u3060\u306D\u3002",
    "Saloon": "\u3044\u3044\u9152\u3092 \u3044\u3063\u3071\u3044 \u3084\u308B\u3068 \u3053\u306E\u8EAB\u306B \u3057\u307F\u308B\u308F\u2026$h",
    "Saloon6": "\u306D\u3047\u3001\u82E5\u3044\u306E\u3002\u91D1\u304C \u3042\u3063\u305F\u3089 \u3042\u3093\u305F\u306B \u4E00\u676F \u304A\u3054\u3063\u3066 \u3042\u3052\u3089\u308C\u305F\u308F\u3002",
    "Saloon_Entry": "\u3042\u3042\u2026\u3084\u3063\u3068\u304B\u3002 /\u98F2\u307F\u7269\u3092 \u3061\u3087\u3046\u3060\u3044\u3002/\u30AC\u30B9\uFF01\u3044\u3064\u3082\u306E\u3092 \u3061\u3087\u3046\u3060\u3044\u3002/\u307E\u305F \u6765\u305F\u308F\u3088\uFF01/\u3042\u3042\u3001\u5589\u304C \u6E07\u3044\u305F\u308F\uFF01/\u5589\u304C \u30AB\u30E9\u30AB\u30E9\u3088\uFF01",
    "Saloon_Fri": "\u304A\u3044\u3001\u30AC\u30B9\uFF01\u4E00\u756A \u30AD\u30C4\u3044 \u9152\u3092 \u3082\u3046\u4E00\u676F \u3088\u3053\u3057\u306A\uFF01",
    "Saloon_Sat": "%\u8FD4\u4E8B\u304C \u306A\u3044\u3088\u3046\u3060\u3002",
    "Saloon_Sun": "%\u30D1\u30E0\u306F \u6CE5\u9154\u3057\u3066\u3044\u308B\u3002\u305D\u3063\u3068 \u3057\u3066\u304A\u3044\u305F\u307B\u3046\u304C \u3044\u3044\u3060\u308D\u3046\u3002",
    "Saloon_Thu": "\u30B2\u30C3\u30D7\u2026\u663C\u306F \u3053\u3044\u3064\u304C \u697D\u3057\u307F\u3067 \u4ED5\u65B9\u306A\u3044\u3093\u3060\u3088\u3002\u30CF\u30CF\u30C3\u3002",
    "Saloon_Tue": "\u30AC\u30B9\uFF01\u3082\u3046\u4E00\u676F \u3061\u3087\u3046\u3060\u3044\uFF01 \u30D2\u30C3\u30AF\u2026$h",
    "Saloon_Wed": "\u306F\u3041\u2026 \u306D\u3047\u3001\u82E5\u3044\u306E\u3002\u3042\u3093\u305F\u306F \u307E\u3060\u82E5\u3044\u306E\u306B\u3001 \u3053\u3093\u306A\u3068\u3053\u308D\u306B \u3044\u3066\u3044\u3044\u306E\u304B\u3057\u3089\u3002",
    "Sat": "\u3042\u305F\u3057\u306E \u5BB6\u306B \u5165\u308B\u524D\u306B\u3001 \u3061\u3083\u3093\u3068 \u9774\u3092 \u30AD\u30EC\u30A4\u306B \u3059\u308B\u3093\u3060\u3088\u3002$u#$e#\u6C5A\u308C\u3092 \u843D\u3068\u3059\u306E\u304C \u9762\u5012\u3060\u304B\u3089\u3055\u3002\u3044\u3044\u52A0\u6E1B \u77E5\u3063\u3066\u304A\u304D\u306A\u3002",
    "Sat4": "\u591C\u306B \u5996\u7CBE\u306E \u96C6\u56E3\u304C \u73FE\u308C\u3066\u3001 \u3042\u305F\u3057\u306E \u5BB6\u3092 \u30AD\u30EC\u30A4\u306B \u3057\u3066\u304F\u308C\u308C\u3070\u306A\u3041\u2026\u30CF\u30CF\u30CF\u30C3\uFF01$h#$e#\u30D1\u30FC\u30B9\u30CB\u30C3\u30D7\u304C \u3059\u3054\u304F \u307B\u3057\u3044\u308F\u3002#$e#\u8DB3\u304C \u3082\u3063\u3068 \u52D5\u3044\u3066\u304F\u308C\u305F\u3089\u3001 \u6642\u3005 \u5C71\u3067 \u30D1\u30FC\u30B9\u30CB\u30C3\u30D7\u63A1\u308A\u306B \u884C\u3051\u305F\u306E\u306B\u3002",
    "Sun": "\u30AC\u30B9\u3068\u306F \u53CB\u9054\u304B\u3044\uFF1F\u3042\u3044\u3064\u306F \u7D50\u69CB \u3044\u3044\u3084\u3064\u3055\u3002#$e#\u8A95\u751F\u65E5\u306B\u306F \u3044\u3064\u3082 \u30D3\u30FC\u30EB\u3092 \u304A\u3054\u3063\u3066\u304F\u308C\u308B\u3002",
    "Thu": "#$1 PamDrunk#\u3042\u3042\u2026\u6628\u6669\u3001 \u9152\u5834\u3067 \u30DD\u30FC\u30BF\u30FC\u3092 \u3057\u3053\u305F\u307E \u98F2\u3093\u3060\u306E\u3088\u2026\u3042\u3063\u3061\u3078 \u884C\u304D\u306A\u3002$k#$e#\u3042\u305F\u3057\u306E\u5BB6\u306F \u305D\u3093\u306A \u3044\u3044\u3082\u3093\u3058\u3083\u306A\u3044\u3051\u3069\u3001 \u5DDD\u306E\u305D\u3070\u306B \u3042\u308B\u3093\u3060\u3002#$e#\u3042\u3089\u3001\u30DA\u30CB\u30FC\u306F \u3042\u305F\u3057\u306E \u304B\u308F\u3044\u3044\u5A18\u3088\u3002\u3084\u3055\u3057\u304F\u3059\u308B\u304B\u3001 \u3067\u306A\u304D\u3083 \u69CB\u308F\u306A\u3044\u3067 \u304F\u308C\u308B\u304B\u3044\uFF1F",
    "Thu4": "\u30DA\u30CB\u30FC\u304C\u3001 \u9152\u5834\u306B \u5165\u308A\u6D78\u308A \u3059\u304E\u3060\u3063\u3066 \u8A00\u3046\u3093\u3060\u3088\u2026$s",
    "Thu4_inlaw_Penny": "\u30C8\u30EC\u30FC\u30E9\u30FC\u306E\u4E2D\u3058\u3083 \u3042\u305F\u3057\u4E00\u4EBA\u3063\u304D\u308A\u306A\u3093\u3060\u3088\u2026",
    "Trailer_Entry": "\u30DA\u30CB\u30FC\uFF01\u5915\u98DF\u306F \u3067\u304D\u305F\u306E\uFF1F/\u30DA\u30CB\u30FC\uFF01\u5BB6\u4E8B\u306F \u7D42\u308F\u3063\u305F\uFF1F/\u30DA\u30CB\u30FC\uFF01\u5BB6\u306B\u3044\u308B\u306E\uFF1F/ \u305F\u3060\u3044\u307E\uFF01\u5E30\u3063\u305F\u308F\u3088\uFF01",
    "Tue": "\u3061\u3087\u3063\u3068\u3001\u3042\u3093\u305F\uFF01\u3042\u305F\u3057\u304C \u3044\u306A\u3044\u9593\u306B \u30C8\u30EC\u30FC\u30E9\u30FC\u3092 \u304B\u304E\u307E\u308F\u308B\u3093\u3058\u3083\u306A\u3044\u3088\u3002\u308F\u304B\u3063\u305F\uFF1F$u#$e#\u60AA\u3044\u3051\u3069\u3001 \u3088\u305D\u8005\u306B\u306F \u6C17\u3092\u3064\u3051\u306A\u304D\u3083 \u306A\u3089\u306A\u304F\u3066\u306D\u3002",
    "Tue2": "\u4ECA\u671D\u306F \u65B0\u805E\u3092 \u8AAD\u3093\u3067\u305F\u3051\u3069\u3001 \u305D\u306E\u305B\u3044\u3067 \u30A4\u30E4\u306A\u6C17\u5206\u306B\u306A\u3063\u305F\u306E\u3088\u3002\u307B\u3093\u3068 \u3053\u306E\u4E16\u754C\u306F \u8150\u3063\u3066\u308B\u308F\u3002#$e#\u3057\u3063\u304B\u308A \u5206\u5225\u3092 \u3064\u3051\u3066\u3044\u308C\u3070 \u7121\u4E8B\u306B \u3084\u3063\u3066\u3044\u3051\u308B\u2026#$b#\u30AA\u30E4\u30B8\u306F\u3044\u3064\u3082 \u305D\u3046 \u8A00\u3063\u3066\u305F\u3002\u30D8\u30D8\u30C3\u3002$h",
    "Wed": "$d bus#\u30D0\u30B9\u304C \u5FA9\u65E7\u3057\u3066\u304F\u308C\u3066 \u3046\u308C\u3057\u3044\u3063\u305F\u3089 \u3042\u308A\u3083\u3057\u306A\u3044\u308F\uFF01\u751F\u304D\u8FD4\u308B\u3088\u3046\u306A \u6C17\u5206\u3088\u3002|\u3053\u306E\u9803\u306E \u3054\u6642\u52E2\u306F \u3064\u3089\u3044\u308F\u3088\u306D\u3002\u30D0\u30B9\u306E \u904B\u8EE2\u624B \u3060\u3063\u305F\u3051\u3069 \u30AF\u30D3\u306B \u3055\u308C\u305F\u306E\u3088\u3002\u307E\u305F \u30D0\u30B9\u3092 \u904B\u8EE2\u3067\u304D\u308B\u3088\u3046\u306B \u306A\u3063\u305F\u3089\u3001\u30AB\u30EA\u30B3 \u7802\u6F20\u3078 \u904B\u3093\u3067\u3042\u3052\u308B\u308F\u3002",
    "cc_Bus": "\u306D\u3048\u3042\u3093\u305F\u3001 \u53E4\u3044\u30D0\u30B9\u306E \u3053\u3068\u306F \u805E\u3044\u305F\u304B\u3044\uFF1F#$b#\u305D\u3046\u2026\u5B9F\u306F\u307E\u305F \u904B\u8EE2\u3059\u308B\u3053\u3068\u306B \u3057\u305F\u3093\u3060\u3002\u3075\u3075\u3001\u306A\u3093\u3060\u304B \u3046\u308C\u3057\u304F\u3066\u306D\u3048\u3002$h",
    "divorced_Penny": "\u30DA\u30CB\u30FC\u304C\u6CE3\u304D\u306A\u304C\u3089\u5E30\u3063\u3066\u304D\u305F\u3093\u3060\u2026 \u3042\u3093\u305F\u3001\u3042\u306E\u5B50\u306B\u4F55\u3057\u305F\u3093\u3060\u3044\uFF1F$3",
    "event_credit1": "\u3061\u3087\u3063\u3068\u3001 \u53E3\u306B\u306F \u6C17\u3092\u3064\u3051\u306A\uFF01\u3042\u305F\u3057\u306F \u8AB0\u306E \u6307\u56F3\u3082 \u53D7\u3051\u306A\u3044\u3093\u3060\u3088\uFF01$u",
    "event_credit2": "\u2026\u305D\u3046\u304B\u3044\uFF1F\u5927\u5909\u3060\u308F\uFF01$s#$b#\u2026\u3042\u3089\u3002$s",
    "fall_Fri": "\u6BCE\u65E5 \u540C\u3058\u3053\u3068\u306E \u7E70\u308A\u8FD4\u3057\u3060\u306D\u2026$s#$e#\u7267\u5834\u4E3B\u306E \u3042\u3093\u305F\u306F \u305D\u3093\u306A\u3053\u3068 \u3042\u308B\u304B\u3044\uFF1F",
    "fall_Sat": "\u304A\u9858\u3044\u304C \u3042\u308B\u3093\u3060\u3051\u3069\u3001 \u3046\u3061\u3092 \u6383\u9664 \u3057\u3066\u304F\u308C\u306A\u3044\uFF1F#$e#\u5197\u8AC7\u3088\u3002$h",
    "fall_Sun": "\u4ED5\u4E8B\u306F \u3069\u3046\u3057\u305F\u306E\uFF1F#$e#\u753A\u3067 \u307B\u3063\u3064\u304D\u3042\u308B\u304F\u4EE5\u5916\u306B \u3084\u308B\u3079\u304D \u3053\u3068\u304C \u3042\u308B\u3060\u3051 \u611F\u8B1D\u3057\u305F\u307B\u3046\u304C \u3044\u3044\u308F\u3088\u3002",
