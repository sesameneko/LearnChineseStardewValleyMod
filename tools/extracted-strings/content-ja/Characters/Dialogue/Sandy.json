    "AcceptGift_(O)18": "\u307E\u3042\uFF01\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306E\u30B9\u30A4\u30BB\u30F3\u3092\u898B\u308B\u3068\u3001\u6625\u304C\u304D\u305F\u3063\u3066\u611F\u3058\u308B\u308F\uFF01$h",
    "AcceptGift_(O)402": "\uFF08\u30AF\u30F3\u30AF\u30F3\uFF09\u2026\u3046\u30FC\u3093\u2026 \u30B9\u30A4\u30FC\u30C8\u30D4\u30FC\u9999\u308A\u306F\u672C\u5F53\u306B\u3059\u3066\u304D\u3002",
    "AcceptGift_(O)418": "\u3042\u3042\u2026 \u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306B\u306F\u51AC\u3067\u3082\u304D\u308C\u3044\u306A\u82B1\u304C\u3055\u3044\u3066\u3044\u308B\u306E\u306D\u3002",
    "AcceptGift_(O)StardropTea": "\u307E\u3042\u3001\u3053\u3093\u306A\u306B\u8CB4\u91CD\u306A\u3082\u306E\u3092\u2026\u79C1\u306B\u304F\u308C\u308B\u306A\u3093\u3066\u4FE1\u3058\u3089\u308C\u306A\u3044\u308F\uFF01\u3042\u308A\u304C\u3068\u3046\u3001\u30CF\u30CB\u30FC\uFF01",
    "Fri": "\u3053\u3093\u306A\u3068\u3053\u3058\u3083 \u8FB2\u696D\u306A\u3093\u3066 \u30ED\u30AF\u306B \u3084\u3063\u3066\u3089\u308C\u306A\u3044\u308F\u3088\u3002#$e#\u30B5\u30DC\u30C6\u30F3\u3092 \u80B2\u3066\u308B\u306A\u3089 \u8A71\u306F \u5225\u3060\u3051\u3069\u3002$h",
    "Fri4": "\u79C1\u306E\u672C\u5F53\u306E \u540D\u524D\u306F \u30B5\u30F3\u30C7\u30A3 \u3058\u3083\u306A\u3044\u306E\u3002\u4ED5\u4E8B\u4E0A \u305D\u3046\u3057\u3066\u308B\u3060\u3051\u3002#$e#\u3067\u3082 \u307F\u3093\u306A \u30B5\u30F3\u30C7\u30A3\u3063\u3066 \u547C\u3093\u3067\u308B\u304B\u3089\u3001 \u3059\u3063\u304B\u308A \u6163\u308C\u3066\u304D\u305F\u308F\u3002",
    "GreenRain": "\u8C37\u306F\u3081\u305A\u3089\u3057\u3044\u5929\u6C17\u306B\u306A\u3063\u3066\u308B\u3063\u3066\u805E\u3044\u305F\u308F\u3002#$e#\u305F\u307E\u306B\u306F\u3053\u3053\u306B\u3082\u96E8\u304C\u964D\u3063\u3066\u304F\u308C\u305F\u3089\u3044\u3044\u306E\u306B\u2026$s",
    "Mon": "\u3042\u3089\u3001 \u3054\u304D\u3052\u3093\u3088\u3046\uFF01#$b#\u30D0\u30B9\u304C \u3084\u3063\u3068 \u5FA9\u65E7\u3057\u3066 \u3088\u304B\u3063\u305F\u308F\u3002\u4E00\u4EBA\u3067 \u3055\u3073\u3057\u304F \u306A\u3063\u3066\u304D\u305F \u3068\u3053\u308D\u3060\u3063\u305F\u306E\u3088\u3002#$e#\u2026 \u5E97\u3058\u307E\u3044 \u5BF8\u524D\u3060\u3063\u305F\u308F\u3002$s#$e#\u305D\u308C\u3067\u3001 \u3042\u306A\u305F\u306F \u30BF\u30CD\u3092 \u8CB7\u3044\u306B \u3053\u3053\u307E\u3067 \u304D\u305F\u306E\u3088\u306D\u2026 \u305D\u3046\u3067\u3057\u3087\uFF1F$h",
    "Sat": "\u3042\u3089\u3001\uFF01\u30AB\u30EA\u30B3\u7802\u6F20 \u30CA\u30F3\u30D0\u30FC\u30EF\u30F3\u306E \u76EE\u7684\u5730\u3001 \u30B5\u30F3\u30C7\u30A3\u306E \u30AA\u30A2\u30B7\u30B9\u3078 \u3088\u3046\u3053\u305D\uFF01#$e#(\u3055\u3055\u3084\u304D) \u3046\u307E\u304F \u8A00\u3048\u305F\u304B\u3057\u3089\uFF1F$h#$e#\u9078\u3073\u629C\u304B\u308C\u305F \u5B63\u7BC0\u7279\u6709\u306E \u30BF\u30CD\u3092 \u30C1\u30A7\u30C3\u30AF \u3057\u3066\u3044\u3063\u3066\u306D\u3002#$e#\u306E\u3069\u304C \u4E7E\u3044\u3066\u308B\u3088\u3046\u306B \u898B\u3048\u308B\u308F\u3088\u3002\u307B\u3089\u3001 \u51B7\u3048\u305F \u30DF\u30EB\u30AF\u3067\u3082 \u3069\u3046\u305E\u3002 [184]#$e#\u304A\u3044\u3057\u3044\u3067\u3057\u3087\uFF1F$h",
    "Sun": "\u3053\u3053\u306F \u51AC\u3067\u3082 \u6674\u308C\u7D9A\u304D \u306A\u306E\u3088\uFF01#$e#\u6B63\u76F4\u3001 \u3061\u3087\u3063\u3068 \u6691\u3044\u3068 \u79C1\u306F\u601D\u3046\u3051\u3069\u2026 \u808C\u304C \u3059\u3050\u306B \u65E5\u713C\u3051\u3057\u3061\u3083\u3046\u308F\u3002$s",
    "Sun8": "\u306D\u3047\u3001\u3042\u306A\u305F\u3002\u3048\u3048\u3001 \u3053\u306E \u53E4\u304F\u3066 \u5927\u304D\u306A\u5E97\u3067 \u4E00\u4EBA\u3063\u304D\u308A\u3088\u3002\u3046\u30FC\u3093\u2026 #$e#\u88CF\u306B\u3044\u308B \u3042\u306E \u602A\u3057\u3044 \u4EBA\u3092 \u9664\u3044\u3066\u306F\u306D\u3002\u3067\u3082 \u5F7C\u306F \u5168\u304F \u52D5\u304B\u306A\u3044\u304B\u3089\u3001 \u6642\u3005 \u5B58\u5728\u3092 \u5FD8\u308C\u3066\u3057\u307E\u3046\u306E\u3088\u3002",
    "Thu": "\u88CF\u306B\u3044\u308B \u602A\u3057\u3044 \u611F\u3058\u306E \u4EBA\u304C \u3069\u3046\u3057\u305F\u3063\u3066\uFF1F\u305D\u308C\u306B\u3064\u3044\u3066\u306F \u8A71\u3057\u305F\u304F\u306A\u3044\u308F\u3002#$e#\u307E\u3042\u2026 \u30D0\u30EC\u30FC\u306E \u5929\u6C17\u306F \u3069\u3093\u306A \u611F\u3058\u304B\u3057\u3089\uFF1F",
    "Thu2": "\u88CF\u306B\u3044\u308B \u602A\u3057\u3044 \u611F\u3058\u306E \u4EBA\u304C \u3069\u3046\u3057\u305F\u3063\u3066\uFF1F\u305D\u308C\u306B\u3064\u3044\u3066\u306F \u8A71\u3057\u305F\u304F\u306A\u3044\u308F\u3002#$e#\u307E\u3042\u2026 \u30D0\u30EC\u30FC\u306E \u5929\u6C17\u306F \u3069\u3093\u306A \u611F\u3058\u304B\u3057\u3089\uFF1F",
    "Thu4": "\u306A\u3041\u2026\u3042\u306A\u305F\u306B\u306A\u3089 \u8A71\u3057\u3066\u3082 \u3044\u3044\u304B\u3068 \u601D\u3046\u306E\u3002\u79D8\u5BC6\u306B \u3057\u3066\u304F\u308C\u308B\u3088\u306D\uFF1F#$b#(\u3055\u3055\u3084\u304D) \u3042\u306E \u88CF\u306B\u3044\u308B \u7537\u3060\u3051\u3069\u2026 \u4F55\u304B \u79D8\u5BC6\u30AF\u30E9\u30D6 \u307F\u305F\u3044\u306A\u306E\u3092 \u3084\u3063\u3066\u308B\u306E\u3002\u4E2D\u306B \u5165\u3063\u305F\u3053\u3068\u306F \u306A\u3044\u3051\u3069\u3001 \u6BCE\u6708\u306E \u8CC3\u6599\u3092 \u305F\u3093\u307E\u308A \u652F\u6255\u3063\u3066\u304F\u308C\u308B\u304B\u3089 \u4F55\u3082 \u805E\u304B\u306A\u3044\u3053\u3068\u306B \u3057\u3066\u308B\u306E\u3002#$e#\u305D\u308C\u3067\u306D\uFF01\u30D0\u30EC\u30FC\u306E \u5929\u6C17\u306F \u3044\u307E \u3069\u3093\u306A \u611F\u3058 \u304B\u3057\u3089\uFF1F",
    "Tue": "\u5916\u3067\u306F \u30B3\u30B3\u30CA\u30C3\u30C4\u3068 \u30B5\u30DC\u30C6\u30F3\u304C \u898B\u3064\u304B\u308B\u308F\u3002\u898B\u3064\u3051\u305F\u306E\u306F \u81EA\u7531\u306B \u6301\u3063\u3066\u3044\u3063\u3066 \u3044\u3044\u308F\u3088\u3002#$e#\u3059\u3063\u3054\u304F \u304A\u3044\u3057\u3044 \u304F\u3060\u3082\u306E\u3060\u304B\u3089\u3002\u30D5\u30D5\u30C3\u3002$h",
    "Tue10": "\u3053\u3093\u306B\u3061\u306F\uFF01 \u597D\u304D\u306A\u3060\u3051 \u3086\u3063\u304F\u308A \u3057\u3066\u3044\u3063\u3066\u306D\u3002#$e#\u30A8\u30A2\u30B3\u30F3\u304C \u6C17\u6301\u3061\u3044\u3044 \u3067\u3057\u3087\uFF1F",
    "Wed": "\u3042\u3089\u3001\u3053\u3093\u306B\u3061\u306F\uFF01\u753A\u306B\u3044\u308B \u53CB\u9054\u306E \u30A8\u30DF\u30EA\u30FC\u3092 \u898B\u304B\u3051\u305F\u3089\u3001 \u3088\u308D\u3057\u304F \u8A00\u3063\u3066\u304F\u308C\u308B\uFF1F#$e#\u983C\u3093\u3060\u308F\u3088\uFF01$h",
    "Wed10": "@\u3042\u3089\u3001\u3058\u3083\u306A\u3044\uFF01\u4F1A\u3044\u305F\u304B\u3063\u305F\u308F\u3002\u3082\u3046 \u6765\u3066\u304F\u308C\u306A\u3044\u304B\u3068 \u601D\u3063\u3066\u305F\u306E\u3088\uFF01#$e#\u3082\u3057 \u5E97\u3092 \u904B\u55B6\u3059\u308B \u5FC5\u8981\u304C \u306A\u304B\u3063\u305F\u3089\u3001 \u30D0\u30EC\u30FC\u3078 \u623B\u3063\u3066 1\u30012\u65E5\u304F\u3089\u3044\u2026 \u7267\u5834\u3067 \u3042\u306A\u305F\u3068 \u904E\u3054\u3057\u305F\u3044 \u304F\u3089\u3044\u3088\u3002$s#$e#\u3082\u3063\u3068 \u305F\u304F\u3055\u3093 \u4F1A\u3044\u306B\u304D\u3066\u304F\u308C\u308C\u3070 \u79C1\u3082 \u305D\u308C\u3060\u3051 \u3055\u3073\u3057\u3044\u601D\u3044\u3092 \u3057\u306A\u3044\u3067 \u3059\u3080\u308F\u3002$h",
    "Wed8": "\u7802\u6F20\u306B \u4F55\u5EA6\u3082 \u3084\u3063\u3066\u304F\u308B\u306E\u3063\u3066 \u7D50\u69CB \u91D1\u304C \u304B\u304B\u3063\u305F\u308A\u3057\u306A\u3044\uFF1F#$e#\u305D\u3093\u306A\u306B \u79C1\u3068 \u4F1A\u3044\u305F\u3044\u306E\uFF1F\u3075\u30FC\u3093\u2026$h||\u306F\u3042\u2026 \u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306E\u304D\u308C\u3044\u306A\u82B1\u3005\u304C\u604B\u3057\u3044\u308F\u2026$s",
    "accept_866": "\u30B9\u30BF\u30FC\u30C7\u30E5\u30FC\u30D0\u30EC\u30FC\u306E\u30D0\u30E9\uFF1F\u306A\u3093\u3066\u611B\u3089\u3057\u3044\u306E\uFF01\u3042\u308A\u304C\u3068\u3046\uFF01$h#$b#\u8C37\u304C\u604B\u3057\u304F\u306A\u3063\u305F\u3089\u3001\u3053\u306E\u30D0\u30E9\u306E\u9999\u308A\u3092\u697D\u3057\u3080\u308F\u3002\u3075\u3075\u3075\u3063\u3002$h#$b#\u306F\u3044\u3001\u3053\u308C\u3092\u3042\u3052\u308B\u308F\u300210\u5E74\u524D\u304B\u3089\u68DA\u306B\u7F6E\u3044\u3066\u308B\u3093\u3060\u3051\u3069\u3001\u8AB0\u3082\u8CB7\u308F\u306A\u3044\u306E\u3088\u3002\u306F\u3044\u3001\u6301\u3063\u3066\u884C\u3063\u3066\uFF01",
    "married_Emily": "\u306D\u3048\u3001\u7D50\u5A5A\u5F0F\u306F\u3069\u3046\u3060\u3063\u305F\uFF1F\u3053\u306E\u3042\u3044\u3060\u30A8\u30DF\u30EA\u30FC\u304C\u6765\u3066\u3001\u3042\u306A\u305F\u306E\u30D7\u30E9\u30F3\u3092\u305C\u3093\u3076\u6559\u3048\u3066\u304F\u308C\u305F\u306E\u3002#$b#\u3044\u3064\u304B2\u4EBA\u306E\u7267\u5834\u306B\u904A\u3073\u306B\u884C\u304B\u306A\u304F\u3061\u3083\u306D\uFF01"
  }
