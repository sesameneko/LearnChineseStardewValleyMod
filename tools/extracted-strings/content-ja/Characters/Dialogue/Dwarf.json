    "AcceptBirthdayGift_Negative": "\u304A\u304A\uFF01\u3053\u306E\u7FD2\u6163\u306B\u3064\u3044\u3066\u8AAD\u3093\u3060\u3053\u3068\u304C\u3042\u308B\u2026 \u300C\u8A95\u751F\u65E5\u30D7\u30EC\u30BC\u30F3\u30C8\u300D\u3060\u308D\u3046\uFF1F#$b#\u3057\u304B\u3057\u3001\u3053\u3093\u306A\u30B4\u30DF\u3092\u308F\u305F\u3059\u306E\u304C\u4F1D\u7D71\u306A\u306E\u304B\uFF1F",
    "AcceptBirthdayGift_Positive": "\u304A\u304A\uFF01\u3053\u306E\u7FD2\u6163\u306B\u3064\u3044\u3066\u8AAD\u3093\u3060\u3053\u3068\u304C\u3042\u308B\u2026 \u300C\u8A95\u751F\u65E5\u30D7\u30EC\u30BC\u30F3\u30C8\u300D\u3060\u308D\u3046\uFF1F\u3075\u3080\u3001\u8208\u5473\u6DF1\u3044\u2026",
    "AcceptGift_(O)StardropTea": "\uFF08\u30AF\u30F3\u30AF\u30F3\uFF09\u2026 \u3053\u308C\u306F\u30DF\u30EB\u30AF\u304B\uFF1F \uFF08\u30B4\u30AF\u30F3\uFF09 \u3042\u3042\u2026 \u3046\u307E\u3044\u3002",
    "AcceptGift_Neutral_milk_item": "\u3042\u3042\u2026 \u30DF\u30EB\u30AF\u2026 \uFF08\u30B4\u30AF\u30F3\uFF09\u2026\u5B9F\u306B\u8208\u5473\u6DF1\u3044\u3002\u3053\u306E\u98F2\u307F\u7269\u306F\u2026 \u3069\u3046\u3084\u3063\u305F\u3089\u624B\u306B\u5165\u308B\u3093\u3060\uFF1F #$b#\u2026\uFF01\uFF01 \uFF08\u30B4\u30DB\u30C3\uFF09",
    "Fri": "\u304A\u524D\u3001 \u30C9\u30EF\u30FC\u30D5\u3092\u898B\u308B\u306E\u306F \u521D\u3081\u3066\u304B\uFF1F",
    "Fri_2": "\u4EBA\u9593\u306E\u591A\u304F\u306F \u77E5\u3089\u306A\u3044\u3082\u306E\u3092 \u6050\u308C\u308B\u2026 \u3060\u304B\u3089\u30AA\u30EC\u306E\u5E97\u3092 \u3053\u3053\u306B\u96A0\u3057\u305F\u3002#$e#\u304A\u524D\u306F \u4FE1\u983C\u3067\u304D\u308B\u3060\u3051\u306E \u63A1\u6398\u6280\u8853\u3092 \u6301\u3063\u3066\u3044\u308B\u3002",
    "GreenRain": "\u7DD1\u8272\u306E\u3082\u306E\u306F\u3088\u304F\u898B\u3048\u306A\u3044\u3093\u3060\u3002#$b#\u9577\u3044\u3053\u3068\u5730\u4E0B\u3067\u66AE\u3089\u3057\u3066\u304D\u305F\u305B\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u306A\u3002",
    "Introduction": "\u4EBA\u9593\u306B\u3057\u3061\u3083\u3001 \u63A1\u6398\u304C\u7D50\u69CB\u3046\u3081\u3047\u306A\u3002",
    "Mon": "\u5168\u90E8\u3001\u5730\u4E0A\u3067\u898B\u3064\u3051\u305F\u3082\u3093\u3060\u3002\u591C\u306E\u9593\u306B\u3001\u3042\u3093\u305F\u3089\u4EBA\u9593\u304B\u3089\u9802\u3044\u305F\u3082\u306E\u3055\u3002#$e#\u3093\uFF1F\u300C\u3057\u3086\u3046\u3056\u3044\u3055\u3093\u300D\u3063\u3066\u4F55\u306E\u3053\u3068\u3060\uFF1F",
    "Sat": "\u9271\u5C71\u306E\u4E2D\u306F \u5371\u967A\u3060\u3002\u30AA\u30EC\u306E\u5E97\u3067 \u4F55\u304B\u8CB7\u3063\u3066\u3044\u3063\u305F\u307B\u3046\u304C\u3001 \u8EAB\u306E\u305F\u3081\u306B\u306A\u308B\u305E\u3002",
