    "Sun": "\u3044\u3064\u304B\u3001\u300C\u304E\u3085\u3046\u306B\u3085\u3046\u300D\u3063\u3066\u304A\u524D\u304C\u547C\u3076\u98F2\u307F\u7269\u306B\u3064\u3044\u3066\u6559\u3048\u3066\u304F\u308C\u3088\u306A\u3002",
    "Thu": "\u5F71\u306E\u4EBA\u3005\u304B\u3089 \u9001\u3089\u308C\u305F \u30B9\u30D1\u30A4\u3058\u3083\u306A\u3044\u3088\u306A\uFF1F#$e#\u304A\u524D\u306E\u3053\u3068\u3001 \u76EE\u3092\u96E2\u3055\u305A \u898B\u3066\u3044\u308B\u304B\u3089\u306A\u3002",
    "Thu_4": "\u5730\u4E0B\u306E\u307B\u3046\u304C \u843D\u3061\u7740\u304F\u3002#$e#\u6DF1\u3051\u308C\u3070 \u6DF1\u3044\u307B\u3069 \u3044\u3044\u3002",
    "Tue": "\u3042\u3042\u2026\u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u306E \u30B7\u30C1\u30E5\u30FC\u3001 \u30ED\u30FC\u30B9\u30C8 \u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u3001\u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u306E \u30B9\u30FC\u30D7\u3001\u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u306E \u30B0\u30E9\u30BF\u30F3\u3002#$e#\u2026\u305D\u3057\u3066\u4E00\u6669\u5BDD\u304B\u305B\u305F \u6D1E\u7A9F\u30CB\u30F3\u30B8\u30F3\u30D6\u30EA\u30E5\u30EC\u306E\u30E9\u30E0\u30AB\u30F3\u3002#$e#\u4F55\u3060\uFF1F",
    "Wed": "\u3088\u3046\u3001\u4F55\u304B\u8CB7\u308F\u306D\u3048\u304B\uFF1F",
    "Wed_6": "\u306F\u308B\u304B\u6614\u3001\u30AA\u30EC\u9054\u306F \u53E4\u4EE3\u6280\u8853\u306E\u79D8\u5BC6\u3092 \u77E5\u3063\u3066\u3044\u305F\u3002\u767A\u6398\u3055\u308C\u305F\u3082\u306E\u304C \u305D\u308C\u3092 \u7269\u8A9E\u3063\u3066\u3044\u308B\u3002#$e#\u3060\u304C\u3001 \u305D\u306E\u6280\u8853\u306F \u3069\u3053\u304B\u3089\u6765\u305F\uFF1F\u305D\u3057\u3066 \u3069\u3053\u3078\u884C\u3063\u305F\uFF1F\u305D\u306E\u7B54\u3048\u306F \u5206\u304B\u308A\u305D\u3046\u306B \u306A\u3044\u304B\u3082\u3057\u308C\u3093\u306A\u2026",
    "firstVisit_Caldera": "\u4F1D\u8AAC\u306E\u30C9\u30EF\u30FC\u30D5\u306E\u935B\u51B6\u5834\u3092\u898B\u3064\u3051\u305F\u306E\u304B\uFF1F\u4FE1\u3058\u3089\u308C\u306A\u3044\u2026\u79C1\u306F\u898B\u305F\u3053\u3068\u304C\u306A\u3044\u3002#$e#\u6A5F\u68B0\u304C\u53E4\u3059\u304E\u3066\u3001\u79C1\u306E\u4EF2\u9593\u306F\u8AB0\u3082\u305D\u306E\u4ED5\u7D44\u307F\u3092\u7406\u89E3\u3057\u3066\u3044\u306A\u3044\u3002\u3057\u304B\u3057\u3001\u30C9\u30EF\u30FC\u30D5\u306E\u6280\u8853\u3067\u3042\u308B\u3053\u3068\u306F\u9593\u9055\u3044\u306A\u3044\u3002",
    "firstVisit_IslandNorth": "\u30B8\u30F3\u30B8\u30E3\u30FC\u30A2\u30A4\u30E9\u30F3\u30C9\u306E\u706B\u5C71\u306B\u5165\u3063\u305F\u3089\u3001\u79C1\u306E\u3088\u3046\u306A\u8005\u306B\u4F1A\u3046\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u5B89\u5FC3\u3057\u3066\u304F\u308C\uFF01\u79C1\u305F\u3061\u306F\u4EBA\u9593\u3068\u306F\u5E73\u548C\u306A\u95A2\u4FC2\u3060\u3002",
