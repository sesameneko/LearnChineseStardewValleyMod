    "22": "\u6B22\u8FCE\uFF0C @\u2026\u2026^^\u4F60\u5DF2\u5728\u9ED1\u6697\u96A7\u9053\u4E2D\u627E\u5230\u4E86\u6211\u7684\u201C\u79D8\u5BC6\u201D\u5417\uFF1F^^\u6211\u671F\u5F85\u7740\u4E0E\u4F60\u4F1A\u9762\uFF01^^\u2014\u2014\u9F50",
    "23": "^^^\u5982\u679C\u4F32\u6E0E\u5230\u7740\u4E2A\u2026\u2026\u5230\u5BC6\u8C1C\u7AD6\u6797\u6765\u3002\u6E05\u5E26\u70B9\u6CA8\u5510\u9171\u3002",
    "24": "\u8FD9\u662F M\u00B7\u8D3E\u601D\u535A\u7684\u4E66\u4E2D\u7684\u4E00\u9875\uFF1A^^\u2026\u2026\u8FD9\u4E9B\u751F\u7269\uFF0C\u6709\u4E00\u4E9B\u4EBA\u79F0\u4E4B\u4E3A\u201C\u68EE\u6797\u7CBE\u7075\u201D\u6216\u662F\u201C\u795D\u5C3C\u9B54\u201D\u3002\u636E\u8BF4\u5B83\u4EEC\u4F1A\u51FA\u73B0\u5728\u5E9F\u5F03\u7834\u8D25\u7684\u5EFA\u7B51\u7269\u4E4B\u4E2D\u3002^^\u901A\u5E38\u6765\u8BF4\u2026\u2026\u5F53\u4EBA\u7C7B\u79BB\u5F00\u4E00\u4E2A\u5730\u65B9\uFF0C\u5927\u81EA\u7136\u5F00\u59CB\u6536\u56DE\u5979\u7684\u9886\u571F\u65F6\uFF0C\u795D\u5C3C\u9B54\u5C31\u4E00\u5B9A\u4F1A\u51FA\u73B0\u3002^^\u6C11\u95F4\u4F20\u8BF4\u8BA4\u4E3A\uFF0C\u795D\u5C3C\u9B54\u8DDF\u4ED6\u4EEC\u7684\u5C0F\u5C4B\u91CC\u653E\u7F6E\u7684\u5B9D\u77F3\u4F1A\u663E\u793A\u51FA\u67D0\u79CD\u5171\u9E23\u5173\u7CFB\u2026\u2026^^\u53E6\u5916\uFF0C\u636E\u8BF4\u4ED6\u4EEC\u6700\u559C\u6B22\u5403\u8461\u8404\u5E72\uFF0C\u4E0D\u8FC7\u5F88\u817C\u8146\uFF0C\u4E0D\u6562\u76F4\u63A5\u4ECE\u4EBA\u7684\u624B\u4E0A\u62FF\u3002^^\u5F53\u7136\uFF0C\u8FD9\u4E9B\u8BF4\u6CD5\u7684\u6765\u6E90\u90FD\u5F88\u53EF\u7591\uFF0C\u672A\u7ECF\u9A8C\u8BC1\u2026\u2026\u636E\u6211\u6240\u77E5\uFF0C\u751A\u81F3\u8FD8\u6CA1\u6709\u4EFB\u4F55\u5B9E\u9645\u8BC1\u636E\u8868\u660E\u8FD9\u79CD\u751F\u7269\u786E\u5B9E\u5B58\u5728\uFF01",
    "25": "^^\u6211\u5411\u5988\u5988\u501F\u4E86\u4E00\u6761\u9879\u94FE\uFF0C\u4F46\u5728\u6FA1\u5802\u9644\u8FD1\u4E22\u4E86\u2026\u2026\u5982\u679C\u5979\u53D1\u73B0\u9879\u94FE\u4E0D\u89C1\u4E86\uFF0C\u80AF\u5B9A\u4F1A\u5927\u53D1\u96F7\u9706\uFF01",
    "26": "\u300A\u53E4\u4EE3\u519C\u8015\u79D8\u8F9B\u300B\u7B2C 37 \u884C\uFF1A^^\u5582\u795D\u5C3C\u9B54\u5403\u8461\u8404\u5E72\uFF0C\u5B83\u4EEC\u5E72\u8D77\u6D3B\u6765\u53EF\u5E26\u52B2\u4E86\u2026\u2026^^",
    "27": "\u4EB2\u7231\u7684\u5B69\u5B50\uFF1A^\u4F60\u627E\u5230\u8FD9\u5F20\u7EB8\u6761\u7684\u65F6\u5019\uFF0C\u60F3\u5FC5\u5DF2\u7ECF\u5728\u661F\u9732\u8C37\u4F4F\u4E86\u5F88\u957F\u4E00\u6BB5\u65F6\u95F4\u4E86\u5427\u3002\u5E0C\u671B\u4F60\u7684\u751F\u6D3B\u4E00\u5207\u987A\u5229\uFF01^\u661F\u9732\u8C37\u5BF9\u6211\u6765\u8BF4\u662F\u4E00\u4E2A\u5F88\u4EB2\u5207\u7684\u5730\u65B9\u2026\u2026\u4F60\u80FD\u7EE7\u627F\u5BB6\u91CC\u8015\u79CD\u7684\u4F20\u7EDF\uFF0C\u7528\u6734\u7D20\u7684\u884C\u52A8\u7ED9\u8FD9\u91CC\u5E26\u6765\u751F\u673A\u548C\u5BCC\u9976\uFF0C\u6211\u611F\u5230\u975E\u5E38\u5149\u8363\u3002^\u7EE7\u7EED\u52A0\u6CB9\u5427\uFF01^^\u2014\u2014\u7237\u7237^^\u9644\uFF1A\u2026\u2026\u6211\u5728\u5C71\u8C37\u7684\u67D0\u4E2A\u5730\u65B9\u7ED9\u4F60\u7559\u4E86\u4E00\u4E2A\u7279\u522B\u7684\u79D8\u5BC6\uFF0C\u90A3\u91CC\u6C47\u96C6\u4E86\u6211\u627E\u5230\u7684\u6700\u5389\u5BB3\u7684\u4E1C\u897F\u3002\u7B49\u4F60\u51C6\u5907\u597D\u7684\u65F6\u5019\uFF0C\u81EA\u7136\u4F1A\u627E\u5230\u7684\u3002",
    "3": "\u8FD9\u662F\u8389\u4E9A\u7684\u7B14\u8FF9\u5199\u7684\u3002^^\u6211\u5BF9\u5B8C\u7F8E\u665A\u9910\u7684\u6784\u60F3\u662F\u6C99\u62C9\u3001\u5C71\u7F8A\u4E73\u916A\u3001\u677E\u9732\u548C\u679C\u9152\u3002\u81F3\u4E8E\u751C\u70B9\uFF0C\u6211\u9700\u8981\u4E00\u4E2A\u865E\u7F8E\u4EBA\u7C7D\u677E\u7CD5\u3002\u597D\u5403\uFF01\u5982\u679C\u6709\u4EBA\u7ED9\u6211\u5176\u4E2D\u4E4B\u4E00\uFF0C\u6211\u4F1A\u5F88\u611F\u52A8\u7684\u3002%revealtaste:Leah:196%revealtaste:Leah:426%revealtaste:Leah:430%revealtaste:Leah:348%revealtaste:Leah:651",
    "4": "\u8FD9\u662F\u739B\u9C81\u7684\u7B14\u8BB0^^\u6211\u6700\u4F1F\u5927\u7684\u53D1\u660E\u8FD8\u9700\u8981\u4E00\u4E9B\u90E8\u4EF6\uFF01^^*\u91D1\u952D^*\u94F1\u952D^*\u7535\u6C60\u7EC4^*\u94BB\u77F3^*\u8349\u8393%revealtaste:Maru:336%revealtaste:Maru:337%revealtaste:Maru:787%revealtaste:Maru:72%revealtaste:Maru:400",
    "5": "\u770B\u8D77\u6765\u50CF\u662F\u6F58\u59AE\u7684\u7B14\u8FF9\uFF1A^^\u6211\u60F3\u7ED9\u6BCF\u4E2A\u4EBA\u4E70\u4ED6\u4EEC\u559C\u6B22\u7684\u4E1C\u897F\uFF01^^\u5988\u5988\uFF1A\u9632\u98CE\u8349\u3001\u7409\u7483\u5C71\u836F\u3001\u4E0D\u8981\u5564\u9152\uFF01^\u8D3E\u65AF\uFF1A\u73AB\u7470\u4ED9\u5B50\u3001\u8461\u8404\u5E72\u5E03\u4E01^\u6587\u68EE\u7279\uFF1A\u7C89\u7EA2\u86CB\u7CD5\u3001\u8461\u8404^\u83AB\u5C14\u7EB3\u5148\u751F\uFF1A\u97ED\u8471\u3001\u7092\u8611\u83C7^\u83AB\u5C14\u7EB3\u5976\u5976\uFF1A\u751C\u83DC\u3001\u90C1\u91D1\u9999%revealtaste:Pam:24%revealtaste:Pam:208%revealtaste:Pam:346%revealtaste:Jas:595%revealtaste:Jas:604%revealtaste:Vincent:398%revealtaste:Vincent:221%revealtaste:George:20%revealtaste:George:205%revealtaste:Evelyn:284%revealtaste:Evelyn:591",
    "6": "\u661F\u4E4B\u679C\u5B9E\u9910\u5427\u7279\u522B\u8BA2\u5355^^\u5218\u6613\u65AF\u9547\u957F\uFF1A\u79CB\u65E5\u6069\u8D50^\uFF08\u914D\u4E24\u4EFD\u9AD8\u7EA4\u7EF4\u9762\u5305\uFF09^^\u739B\u59AE\uFF1A\u5357\u74DC\u6D3E^\uFF08\u591A\u52A0\u9C9C\u5976\u6CB9\uFF01\uFF09^^\u5FB7\u7C73\u7279\u91CC\u5384\u65AF\uFF1A\u8C46\u7C7B\u706B\u9505^\uFF08\u52A0\u8FA3\uFF09^^\u5361\u6D1B\u7433\uFF1A\u9C7C\u8089\u5377^\uFF08\u5979\u8981\u4E09\u500D\u9171\u6C41\uFF01\u6700\u597D\u591A\u653E\u51E0\u5F20\u9910\u5DFE\u7EB8\u2026\u2026\uFF09%revealtaste:Lewis:235%revealtaste:Marnie:608%revealtaste:Demetrius:207%revealtaste:Caroline:213",
    "7": "\u8FD9\u662F\u67D0\u4EBA\u65E5\u8BB0\u4E2D\u7684\u4E00\u9875\u2026\u2026^^\u2026\u2026\u9547\u91CC\u53EA\u6709\u5C11\u6570\u51E0\u4E2A\u201C\u8001\u201D\u5355\u8EAB\u6C49\uFF0C\u4ED6\u4EEC\u90FD\u5E76\u4E0D\u5B8C\u7F8E\uFF01\u54C8\u7EF4\u786E\u5B9E\u7126\u8651\u800C\u8F6F\u5F31\uFF0C\u4F46\u6211\u77E5\u9053\u4ED6\u4F1A\u6210\u4E3A\u4E00\u4E2A\u5FE0\u8BDA\u4E13\u4E00\u7684\u4E08\u592B\u3002\u4ED6\u559C\u6B22\u5496\u5561\u548C\u814C\u83DC\u3002^^\u827E\u5229\u6B27\u7279\u6709\u4E9B\u6D6E\u5938\u548C\u77EB\u60C5\uFF0C\u4F46\u4ED6\u7684\u4E0B\u5DF4\u786E\u5B9E\u5F88\u597D\u770B\u3002\u4ED6\u559C\u6B22\u87F9\u9EC4\u7CD5\u548C\u77F3\u69B4\u3002^^\u8C22\u6069\u908B\u9062\u4E14\u53CD\u793E\u4F1A\u3002\u4F46\u6211\u8BA4\u4E3A\u4ED6\u7C97\u9C81\u7684\u5916\u5728\u662F\u4E00\u79CD\u4FDD\u62A4\u673A\u5236\uFF0C\u5C06\u4ED6\u5185\u5FC3\u7684\u67D4\u8F6F\u4E0E\u4E16\u754C\u9694\u79BB\u5F00\u6765\u3002\u4ED6\u559C\u6B22\u5564\u9152\u3001\u62AB\u8428\u548C\u7206\u7092\u9752\u6912\u3002%revealtaste:Harvey:395%revealtaste:Harvey:342%revealtaste:Elliott:732%revealtaste:Elliott:637%revealtaste:Shane:346%revealtaste:Shane:206%revealtaste:Shane:215",
    "8": "^\u81F4\u6D77\u8389\u548C\u827E\u7C73\u4E3D^^\u5E0C\u671B\u4F60\u4EEC\u4FE9\u4E00\u5207\u5B89\u597D\uFF01\u7ED9\u4F60\u4EEC\u5BC4\u4E86\u6700\u7231\u7684\u793C\u7269\uFF1A\u6D77\u8389\u7684\u7C89\u7EA2\u86CB\u7CD5\u548C\u5411\u65E5\u8475\uFF0C\u827E\u7C73\u4E3D\u7684\u5B9D\u77F3\u548C\u52A8\u7269\u6BDB\uFF01^^\u2014\u2014\u7231\u4F60\u4EEC\u7684\u5988\u5988\u548C\u7238\u7238\u3002%revealtaste:Haley:221%revealtaste:Haley:421%revealtaste:Emily:440%revealtaste:Emily:66%revealtaste:Emily:62%revealtaste:Emily:60%revealtaste:Emily:70%revealtaste:Emily:64%revealtaste:Emily:68",
