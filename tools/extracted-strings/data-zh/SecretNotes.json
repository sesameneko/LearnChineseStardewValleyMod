    "1": "\u8FD9\u662F\u963F\u6BD4\u76D6\u5C14\u65E5\u8BB0\u4E2D\u7684\u4E00\u9875^^\u201C\u6211\u559C\u6B22\u7684\u4E8B\u7269\uFF1A\u96D5\u523B\u5357\u74DC\u7684\u9999\u6C14\u3001\u5728\u6211\u7684\u6795\u5934\u4E0B\u653E\u5757\u7D2B\u6C34\u6676\u3001\u5DE7\u514B\u529B\u86CB\u7CD5\u3001\u9999\u8FA3\u9CD7\u9C7C\u7684\u523A\u6FC0\uFF0C\u4EE5\u53CA\u5988\u5988\u505A\u7684\u9ED1\u8393\u8106\u76AE\u997C\u5E26\u6765\u7684\u6170\u85C9\uFF08\u6211\u7231\u5403\uFF01\uFF09\u201D%revealtaste:Abigail:276%revealtaste:Abigail:66%revealtaste:Abigail:220%revealtaste:Abigail:226%revealtaste:Abigail:611",
    "10": "\u6709\u4EBA^    \u5728^      \u5934\u9AA8\u5C71\u6D1E^      \u7684^      \u7B2C 100 \u5C42^      \u7B49\u4F60\u2026\u2026",
    "1001": "\u7B2C 1 \u5929^^\u2026\u2026\u6211\u7684\u8239\u6CA1\u4E86\u2026\u2026\u5B83\u5728\u66B4\u98CE\u96E8\u4E2D\u88AB\u65E0\u60C5\u7684\u5927\u6D77\u6467\u6BC1\u4E86\u3002^^\u6211\u73B0\u5728\u88AB\u56F0\u5728\u8FD9\u7247\u964C\u751F\u7684\u6D77\u5CB8\u4E0A\u3002\u6211\u7684\u8239\u5458\u90FD\u53BB\u4E16\u4E86\uFF0C\u53EA\u6709\u6211\u8FD8\u6D3B\u7740\u3002\u4E5F\u8BB8\u5E78\u8FD0\u5973\u795E\u4FDD\u4F51\u4E86\u6211\u8FD9\u628A\u6076\u4E8B\u505A\u5C3D\u7684\u8001\u9AA8\u5934\u2026\u2026\u4E5F\u6709\u53EF\u80FD\u5979\u5BF9\u6211\u7684\u547D\u8FD0\u8FD8\u6709\u5176\u4ED6\u7684\u5B89\u6392\u3002^^\u4E0D\u7BA1\u600E\u6837\uFF0C\u6211\u522B\u65E0\u9009\u62E9\uFF0C\u53EA\u80FD\u5728\u8FD9\u4E2A\u5730\u65B9\u8FC7\u65E5\u5B50\u4E86\u3002\u6709\u5145\u8DB3\u7684\u6DE1\u6C34\uFF0C\u6709\u98DF\u7269\u53EF\u4EE5\u91C7\u96C6\uFF0C\u6709\u80A5\u6C83\u7684\u571F\u58E4\u53EF\u4EE5\u8015\u79CD\u2026\u2026^^\u9996\u5148\u6211\u5F97\u5EFA\u4E00\u4E2A\u4F4F\u5904\u2026\u2026^^\uFF08\u6709\u51E0\u9875\u7F3A\u5931\u4E86\uFF09",
    "1002": "\u7B2C 6 \u5929^^\u6211\u5728\u8FD9\u91CC\u518D\u4E5F\u4E0D\u4F1A\u6328\u997F\u4E86\u2026\u2026\u6C34\u91CC\u5168\u662F\u53EF\u4EE5\u5403\u7684\uFF08\u4E0D\u5BF9\uFF0C\u662F\u5F88\u7F8E\u5473\u7684\uFF01\uFF09\u9C7C\u3002^^\u6211\u751A\u81F3\u5728\u4E1C\u5357\u6D77\u5CB8\u7684\u6D1E\u7A74\u91CC\u6293\u5230\u4E86\u4E00\u6761\u9EC4\u8C82\u9C7C\u3002\u4E0D\u8FC7\u6211\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u5904\u7406\uFF01^^\u524D\u4E9B\u65E5\u5B50\uFF0C\u6211\u751A\u81F3\u635E\u5230\u4E86\u51E0\u4E2A\u91D1\u8272\u6838\u6843\u3002\u5B83\u4EEC\u4F3C\u4E4E\u904D\u5E03\u5168\u5C9B\u3002\u5F53\u5730\u7684\u9E66\u9E49\u62A2\u75AF\u4E86\uFF01",
    "1003": "\u7B2C 14 \u5929^^\u5728\u8FD9\u4E2A\u5C9B\u4E0A\u5F85\u4E86\u534A\u4E2A\u6708\u540E\uFF0C\u6211\u5BF9\u5982\u4F55\u627E\u5230\u8FD9\u4E9B\u91D1\u8272\u575A\u679C\u5DF2\u7ECF\u7565\u61C2\u95E8\u9053\u4E86\u3002^^\u5FC5\u987B\u8981\u7741\u5927\u773C\u775B\u5BFB\u627E\u5FAE\u5C0F\u7684\u7EBF\u7D22\uFF0C\u5982\u679C\u6709\u4EC0\u4E48\u4E1C\u897F\u770B\u8D77\u6765\u4E0D\u540C\u5BFB\u5E38\uFF0C\u90A3\u9644\u8FD1\u53EF\u80FD\u5C31\u6709\u4E2A\u9690\u85CF\u7684\u575A\u679C\u3002^^\u6211\u53D1\u73B0\u6C99\u5B50\u91CC\u6709\u2026\u2026\u6811\u53F6\u91CC\u4E5F\u6709\u2026\u2026^^\u6211\u751A\u81F3\u5728\u706B\u5C71\u9644\u8FD1\u7684\u4E00\u68F5\u6811\u4E0A\u770B\u5230\u4E86\u4E00\u4E2A\u575A\u679C\u3002\u53EF\u60DC\u6211\u6CA1\u529E\u6CD5\u628A\u5B83\u6253\u4E0B\u6765\u2026\u2026^^\u6BCF\u6B21\u6211\u53D1\u73B0\u6709\u575A\u679C\u7684\u690D\u682A\u65F6\uFF0C\u603B\u80FD\u627E\u5230\u65B9\u6CD5\u53BB\u591F\u5230\u5B83\u3002",
    "1004": "!image 10",
    "1005": "\u7B2C 23 \u5929^^\u5F53\u5730\u7684\u706B\u5C71\u57CB\u85CF\u7740\u8BB8\u591A\u79D8\u5BC6\u3002^^\u6211\u770B\u5230\u773C\u775B\u53D1\u5149\u7684\u5C0F\u4EBA\uFF0C\u5728\u9ED1\u6697\u91CC\u56DB\u5904\u8E66\u8DF3\uFF0C\u5C31\u50CF\u591C\u91CC\u7684\u732B\u2026\u2026^^\uFF08\u4ED6\u4EEC\u662F\u4E0D\u662F M\u00B7\u8D3E\u601D\u535A\u5728\u4ED6\u7684\u300A\u95FB\u540D\u4E4B\u65C5\u300B\u91CC\u63D0\u5230\u7684\u77EE\u4EBA\uFF1F\uFF09^^\u6211\u8FD8\u770B\u5230\u6709\u5947\u602A\u7684\u673A\u5668\uFF0C\u602A\u5F02\u79BB\u5947\uFF0C\u4E0D\u50CF\u662F\u4EBA\u7C7B\u5DF2\u77E5\u7684\u4E1C\u897F\u3002^^\u5728\u5C71\u9876\uFF0C\u6211\u627E\u5230\u4E86\u4E00\u6761\u901A\u5F80\u706B\u5C71\u53E3\u7684\u901A\u9053\u3002\u8FD8\u6709\uFF0C\u534A\u6DF9\u6CA1\u5728\u5192\u6CE1\u7684\u7194\u5CA9\u4E2D\uFF0C\u6709\u4E00\u53F0\u5947\u7279\u7684\u673A\u5668\u2026\u2026\u662F\u4E00\u79CD\u201C\u953B\u9020\u7089\u201D\u3002 ^^\u6211\u660E\u5929\u4F1A\u7EE7\u7EED\u8C03\u67E5\u3002",
    "1006": "!image 8",
    "1007": "\u2014\u2014\u953B\u9020\u8868\u2014\u2014^^\u9EC4\u6C34\u6676 \u2014\u2014 \u9632\u5FA1^\u7EFF\u5B9D\u77F3 \u2014\u2014 \u901F\u5EA6^\u7FE1\u7FE0 \u2014\u2014 \u66B4\u51FB\u80FD\u91CF^\u6D77\u84DD\u5B9D\u77F3 \u2014\u2014 \u66B4\u51FB\u51E0\u7387^\u7D2B\u6C34\u6676 \u2014\u2014 \u51FB\u9000^\u7EA2\u5B9D\u77F3 \u2014\u2014 \u4F24\u5BB3^^\u4E94\u5F69\u788E\u7247 \u2014\u2014 \u9644\u9B54^^\u5907\u6CE8\uFF1A\u6B66\u5668\u53EF\u4EE5\u7528\u5B9D\u77F3\u953B\u9020\u4E09\u6B21\uFF0C\u4E5F\u53EF\u4EE5\u7528\u4E94\u5F69\u788E\u7247\u9644\u9B54\u4E00\u6B21\u3002^^\u5907\u6CE8 2\uFF1A\u201C\u56FA\u6709\u9644\u9B54\u201D\uFF08\u83B7\u5F97\u6B66\u5668\u65F6\u81EA\u5E26\u7684\u5C5E\u6027\uFF09\u53EF\u4EE5\u4F7F\u7528\u9F99\u7259\u6765\u589E\u52A0\u6216\u5237\u65B0\u3002\u636E\u63A8\u6D4B\uFF0C\u4E00\u5B9A\u54C1\u8D28\u4E4B\u4E0A\u7684\u6B66\u5668\u65E0\u6CD5\u83B7\u5F97\u6B64\u7C7B\u9644\u9B54\u3002^^\u5DE5\u5177\u53EA\u80FD\u9644\u9B54\uFF0C\u4E0D\u80FD\u953B\u9020\u3002",
    "1008": "\u2014\u2014\u6B66\u5668\u9644\u9B54\u2014\u2014^^\u5DE7\u5999\uFF1A\u80FD\u8BA9\u4F60\u66F4\u5FEB\u5730\u505A\u51FA\u201C\u7279\u6B8A\u52A8\u4F5C\u201D\u3002^^\u866B\u5B50\u6740\u624B\uFF1A\u5BF9\u866B\u5B50\u9020\u6210\u66F4\u591A\u4F24\u5BB3\u3002^^\u5438\u8840\uFF1A\u5076\u5C14\u80FD\u4ECE\u602A\u7269\u8EAB\u4E0A\u5438\u53D6\u751F\u547D\u3002^^\u5341\u5B57\u519B\uFF1A\u5BF9\u201C\u90AA\u6076\u201D\u602A\u7269\u9020\u6210\u66F4\u591A\u4F24\u5BB3\u3002^^\u5E72\u8349\uFF1A\u5272\u6742\u8349\u65F6\uFF0C\u4F60\u4F1A\u5F97\u5230\u66F4\u591A\u7684\u7EA4\u7EF4\uFF0C\u4E5F\u6709\u51E0\u7387\u83B7\u5F97\u5E72\u8349\u3002^^\u2014\u2014\u5DE5\u5177\u9644\u9B54\u2014\u2014^^\u5F3A\u529B\uFF1A\u5BF9\u77F3\u5934\u3001\u6811\u6728\u7B49\u9020\u6210\u66F4\u591A\u5DE5\u5177\u4F24\u5BB3\u3002^^\u8303\u56F4\uFF1A\u589E\u5F3A\u84C4\u529B\u80FD\u529B\uFF0C\u4F5C\u7528\u8303\u56F4\u66F4\u5927\u3002^^\u6728\u5C51\uFF1A\u780D\u6811\u65F6\u6709\u51E0\u7387\u83B7\u5F97\u989D\u5916\u7684\u6728\u6750\u3002^^\u65E0\u5E95\u6D1E\uFF1A\u55B7\u58F6\u6C38\u8FDC\u4E0D\u4F1A\u5E72\u6DB8\u3002^^\u4E30\u5BCC\uFF1A\u80FD\u4ECE\u5730\u4E0B\u6316\u51FA\u66F4\u591A\u4E1C\u897F\u3002^^\u8003\u53E4\u5B66\u5BB6\uFF1A\u6709\u66F4\u9AD8\u51E0\u7387\u53D1\u73B0\u6587\u7269\u548C\u9AA8\u5934\u3002^^\u7701\u529B\uFF1A\u4F7F\u7528\u4E0D\u8D39\u4F53\u529B\u3002^^\u8FC5\u6377\uFF1A\u66F4\u5FEB\u5730\u6325\u52A8\u5DE5\u5177\u3002^^\u7CBE\u901A\uFF1A\u63D0\u5347\u9493\u9C7C\u7B49\u7EA7\u3002^^\u81EA\u52A8\u4E0A\u94A9\uFF1A\u9C7C\u54AC\u94A9\u65F6\u81EA\u52A8\u5F00\u59CB\u9493\u9C7C\u3002^^\u8010\u7528\uFF1A\u6709 50% \u7684\u51E0\u7387\u4E0D\u6D88\u8017\u9C7C\u9975\u548C\u6E14\u5177\u3002",
    "1009": "\u90A3\u662F\u4E00\u4E2A\u9634\u96E8\u5929\uFF0C\u6211\u770B\u89C1\u7F8E\u4E3D\u7684\u5C11\u5973\u5B64\u72EC\u5730\u5750\u5728\u5CA9\u77F3\u4E4B\u4E0A\u3002^^\u4F20\u8BF4\u6709\u6D77\u7684\u5973\u513F\u4EEC\u6B4C\u5531\u6D77\u5996\u4E4B\u6B4C\uFF0C^\u4F46\u662F\u5979\u5374\u62FC\u4E0D\u51FA\u534A\u4E2A\u97F3\u7B26\u2026\u2026^^\u7B2C\u4E8C\u5929\u65E9\u4E0A\uFF0C\u6211\u53D1\u73B0\u6EE1\u662F\u6CE1\u6CAB\u7684\u5CB8\u4E0A\u6709\u4E00\u6392\u77F3\u5934\u2026\u2026^\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014^\u5BF9\u2026\u2026\u6709\u4E00\u5206\u94B1\u786C\u5E01\u90A3\u4E48\u5927\u7684\u77F3\u5934\uFF0C\u4E5F\u6709\u4E94\u5206\u94B1\u90A3\u4E48\u5927\u7684\u2026\u2026^\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014^\u8981\u662F\u6211\u8FD9\u526F\u8001\u55D3\u5B50\u80FD\u543C\u51FA\u4EC0\u4E48\u66F2\u8C03\uFF0C\u4E5F\u8BB8\u5979\u80FD\u5E26\u9886\u6211\u53BB\u5BFB\u627E\u9ED1\u6D77\u9E25\u7684\u5B9D\u85CF\u2026\u2026",
    "1010": "!image 9",
    "1011": "\u7B2C 37 \u5929^^\u6211\u5341\u5C81\u7684\u65F6\u5019\uFF0C\u7236\u4EB2\u7ED9\u4E86\u6211\u4E00\u4E2A\u5149\u8F89\u6212\u6307\u548C\u4E00\u4E2A\u78C1\u94C1\u6212\u6307\u3002\u4ECE\u90A3\u4EE5\u540E\u6211\u5C31\u4E00\u76F4\u6234\u7740\u5B83\u4EEC\u3002^^\u4F46\u662F\uFF0C\u5F53\u6211\u7AD9\u5728\u706B\u5C71\u9876\u4E0A\u7684\u65F6\u5019\u2026\u2026\u6211\u7A81\u7136\u6709\u4E86\u4E00\u4E2A\u5947\u602A\u7684\u60F3\u6CD5\u3002^^\u6211\u62FF\u51FA\u6211\u7684\u4E24\u4E2A\u6212\u6307\uFF0C\u628A\u5B83\u4EEC\u6254\u8FDB\u4E86\u953B\u9020\u7089\u3002^^\u5929\u54EA\uFF01\u5B83\u4EEC\u5408\u4E8C\u4E3A\u4E00\u4E86\uFF01^^\u73B0\u5728\u6211\u62E5\u6709\u4E86\u4E00\u4E2A\u5149\u8F89\u78C1\u94C1\u6212\u6307\u2026\u2026\u6211\u5E0C\u671B\u8001\u7236\u4EB2\u4E0D\u4F1A\u4ECB\u610F\uFF0C\u613F\u4ED6\u7684\u7075\u9B42\u5B89\u606F\u2026\u2026",
    "11": "!image 6",
    "12": "\u5728\u8D70\u8FD0\u7684\u65E5\u5B50\u91CC\uFF0C\u6211\u5728\u5783\u573E\u6876\u91CC\u627E\u5230\u4E86\u4E00\u4E9B\u597D\u4E1C\u897F\u3002^^\u6709\u65F6\u4F60\u4F1A\u5728\u661F\u4E4B\u679C\u5B9E\u9910\u5427\u7684\u5783\u573E\u6876\u91CC\u627E\u5230\u201C\u5F53\u65E5\u7279\u4F9B\u201D\u2026\u2026\u901A\u5E38\u8FD8\u5F88\u65B0\u9C9C\uFF01^^\u81F3\u4E8E\u751C\u70B9\uFF0C\u6211\u4F1A\u7FFB\u7FFB\u4E54\u6CBB\u00B7\u83AB\u5C14\u7EB3\u5BB6\u7684\u5783\u573E\u6876\uFF0C\u770B\u770B\u6709\u6CA1\u6709\u997C\u5E72\u3002^^\u73CD\u5B9D\u7684\u8BDD\uFF0C\u6211\u4F1A\u770B\u770B\u94C1\u5320\u94FA\u548C\u535A\u7269\u9986\u65C1\u7684\u5783\u573E\u6876\u3002",
    "13": "^^\u6BCF\u4E2A\u5B63\u8282\u6700\u540E\u4E00\u5929\u7684\u4E2D\u5348 12 \u70B9\u6574\uFF0C\u68C0\u67E5\u4E00\u4E0B\u6E38\u4E50\u573A\u4E0A\u65B9\u7684\u704C\u6728\u4E1B\u5427\u3002",
    "14": "^^^    \u6211\u5728\u793E\u533A\u4E2D\u5FC3\u80CC\u9762\u85CF\u4E86\u4E9B\u4E1C\u897F\u3002",
    "15": "^^       \u7F8E\u4EBA\u9C7C\u79C0\uFF1A1-5-4-2-3",
    "16": "!image 0",
