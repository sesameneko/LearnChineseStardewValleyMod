  "entries": {
    "Abigail0": "\u5475\u5475\u3002\u6211\uFF1F\u7ED3\u5A5A\uFF1F\u6211\u4ECE\u6CA1\u60F3\u8FC7\u8FD9\u4F1A\u6210\u771F\u3002$h#$e#\u6211\u4EEC\u5728\u4E00\u8D77\u4F1A\u5F88\u5F00\u5FC3\u7684\u3002$h",
    "Abigail1": "\u6211\u548C\u4E00\u4E2A\u519C\u592B\u8BA2\u5A5A\u4E86\u3002\u54C7\uFF01$h#$e#\u4ECE\u73B0\u5728\u5F00\u59CB\uFF0C\u6211\u4EEC\u7684\u751F\u6D3B\u5C06\u622A\u7136\u4E0D\u540C\u3002$l",
    "Alex0": "@\uFF0C\u8FD9\u662F\u8FD9\u4E2A\u4E16\u4E0A\u6700\u68D2\u7684\u4E8B\u60C5\u3002$l#$e#\u6211\u5DF2\u7ECF\u7B49\u4E0D\u53CA\u4E86\u3002$h",
    "Alex1": "\u6211\u4E00\u5B9A\u4F1A\u7231\u4E0A\u519C\u592B\u7684\u751F\u6D3B\u7684\u3002$h",
    "Elliott0": "\u519C\u573A\u662F\u4E00\u4E2A\u503C\u5F97\u5927\u4E66\u7279\u4E66\u7684\u597D\u5730\u65B9\u3002\u6211\u597D\u671F\u5F85\u554A\u3002$h#$e#\u6211\u4EEC\u4F1A\u6210\u4E3A\u8BA9\u4EBA\u7FA1\u6155\u7684\u592B\u59BB\u3002$l",
    "Elliott1": "\u8FD9\u5C06\u662F\u4E00\u573A\u5927\u5192\u9669\uFF01\u6211\u597D\u6FC0\u52A8\u3002\u4F60\u4E5F\u662F\u5427\uFF1F$h#$e#\u6211\u4EEC\u53EF\u4EE5\u628A\u6211\u7684\u5C0F\u5C4B\u5F53\u4F5C\u6D77\u6EE8\u522B\u5885\u3002$l",
    "Emily0": "\u4F60\u80FD\u76F8\u4FE1\u6211\u4EEC\u8981\u642C\u4E00\u8D77\u4F4F\u4E86\u5417\uFF1F\u6211\u9664\u4E86\u548C\u5BB6\u4EBA\u8FD8\u4ECE\u6CA1\u548C\u5176\u4ED6\u4EBA\u4F4F\u4E00\u8D77\u8FC7\u3002#$e#\u771F\u2026\u2026\u523A\u6FC0\u3002",
    "Emily1": "\u6211\u5C31\u77E5\u9053\u6211\u4FE9\u4E4B\u95F4\u4F1A\u6709\u4E9B\u91CD\u5927\u7684\u4E8B\u60C5\u53D1\u751F\u2026\u2026\u4F46\u6211\u4ECE\u6765\u6CA1\u60F3\u5230\u4F1A\u662F\u8FD9\u4E2A\uFF01$h#$e#\u8FDE\u9E66\u9E49\u90FD\u5F88\u5174\u594B\u554A\u3002",
    "Haley0": "\u6211\u597D\u9AD8\u5174\u554A\uFF01$h#$e#\u6211\u7EC8\u4E8E\u8981\u7F8E\u68A6\u6210\u771F\u4E86\u3002$l",
    "Haley1": "\u6CA1\u5173\u7CFB\u3002\u6211\u77E5\u9053\u4F60\u8981\u7167\u987E\u519C\u573A\uFF0C\u6240\u4EE5\u6CA1\u6CD5\u513F\u5EA6\u871C\u6708\u3002#$e#\u6211\u73B0\u5728\u4E5F\u662F\u79CD\u5E84\u7A3C\u7684\u4EBA\u4E86\uFF01",
    "Harvey0": "\u5929\u54EA\uFF01\u5A5A\u793C\u8FD8\u6709\u90A3\u4E48\u591A\u4E8B\u60C5\u8981\u51C6\u5907\uFF01\u7D27\u5F20\u6B7B\u4E86\u3002$l#$e#\u53EA\u6709\u7B49\u5728\u4F60\u7684\u519C\u573A\u91CC\u5B89\u987F\u4E0B\u6765\u540E\uFF0C\u6211\u624D\u80FD\u6B47\u4F1A\u4E86\u3002$h",
    "Harvey1": "\u6211\u771F\u7684\u597D\u5F00\u5FC3\u554A\u3002$h#$e#\u8FD9\u4E00\u76F4\u4EE5\u6765\u90FD\u662F\u6211\u5185\u5FC3\u6DF1\u5904\u7684\u613F\u671B\u3002$l",
    "Krobus0": "@\u2026\u2026\u6050\u6015\u6211\u4EEC\u5FC5\u987B\u5F97\u4FDD\u5BC6\u2026\u2026\u6211\u548C\u4F60\u7684\u540C\u65CF\u4EBA\u90FD\u4E0D\u4F1A\u63A5\u53D7\u6211\u4EEC\u4F4F\u5728\u4E00\u8D77\u3002",
    "Krobus1": "\u4F60\u5E94\u8BE5\u660E\u767D\u8DDF\u6211\u4E00\u8D77\u4F4F\u4F1A\u611F\u89C9\u6211\u5F88\u5947\u602A\u7684\uFF0C\u662F\u5427\uFF1F\u6BD5\u7ADF\u6211\u4E0D\u80FD\u51FA\u95E8\u2026\u2026",
    "Leah0": "\u2026\u2026$l#$e#\u6211\u6709\u70B9\u7D27\u5F20\u3002\u4F46\u662F\u4E5F\u5F88\u9AD8\u5174\u3002$h",
    "Leah1": "\u6211\u4E00\u76F4\u6E34\u671B\u7740\u80FD\u591F\u4F4F\u8FDB\u519C\u573A\u3002$h#$e#\u6211\u7B80\u76F4\u592A\u9AD8\u5174\u4E86\u3002",
    "Maru0": "\u6211\u597D\u6FC0\u52A8\u3002$h#$b#\u6211\u5C31\u8981\u5AC1\u7ED9\u4F60\u4E86\u3002\u5475\u5475\u3002$l",
    "Maru1": "\u6211\u5F97\u505A\u597D\u6210\u4E3A\u519C\u592B\u7684\u59BB\u5B50\u7684\u5FC3\u7406\u51C6\u5907\u3002",
    "Penny0": "@\u2026\u6211\u6709\u4E9B\u5BB3\u6015\u3002\u8FD9\u662F\u5929\u7FFB\u5730\u8986\u7684\u53D8\u5316\uFF01#$e#\u522B\u62C5\u5FC3\uFF0C\u6211\u771F\u7684\u5F88\u9AD8\u5174\u3002$h",
    "Penny1": "\u6211\u4EEC\u5F88\u5FEB\u5C31\u4F1A\u7EC4\u6210\u4E00\u4E2A\u5C0F\u5C0F\u7684\u519C\u6237\u5BB6\u5EAD\u3002$l#$e#\u771F\u9AD8\u5174\u4F60\u90A3\u4E48\u559C\u6B22\u6211\u3002$h",
    "Sam0": "\u4F5C\u4E3A\u4F60\u7684\u4E08\u592B\uFF0C\u6211\u4F1A\u975E\u5E38\u5E78\u798F\uFF0C@\u3002$l#$e#\u6211\u597D\u6FC0\u52A8\u3002",
    "Sam1": "\u6211\u4ECE\u6CA1\u60F3\u8FC7\u8FD9\u4F1A\u6210\u771F\u3002\u6211\u592A\u5E78\u8FD0\u4E86\u3002$l#$e#\u6211\u7B49\u4E0D\u53CA\u4E3E\u884C\u5A5A\u793C\u4E86\u3002$h",
    "Sebastian0": "\u51E0\u5929\u540E\u6211\u5C31\u8981\u5728\u519C\u573A\u5F00\u59CB\u65B0\u751F\u6D3B\u4E86\u3002\u8FD9\u7B80\u76F4\u96BE\u4EE5\u7F6E\u4FE1\u3002$h#$e#\u53EF\u662F\u6211\u4E5F\u597D\u9AD8\u5174\u554A\u3002$l",
    "Sebastian1": "\u4F60\u521A\u51FA\u73B0\u5728\u9547\u4E0A\u90A3\u4F1A\u513F\uFF0C\u6211\u53EF\u60F3\u4E0D\u5230\u4F1A\u6709\u548C\u4F60\u7ED3\u5A5A\u7684\u90A3\u4E00\u5929\u3002$l#$e#\u751F\u547D\u771F\u662F\u5947\u5999\uFF0C\u5BF9\u4E0D\u5BF9\uFF1F$h",
    "Shane0": "\u6211\u4E0D\u7981\u6000\u7591\u8FD9\u4E00\u5207\u53EA\u662F\u4E2A\u7CBE\u5FC3\u7B56\u5212\u7684\u6076\u4F5C\u5267\u3002#$e#\u6211\u7B80\u76F4\u4E0D\u6562\u76F8\u4FE1\u4F60\u4F1A\u771F\u7684\u60F3\u548C\u6211\u8FD9\u6837\u7684\u4EBA\u7ED3\u5A5A\u3002",
    "Shane1": "@\u2026\u2026\u6211\u5934\u597D\u6655,\u6211\u4ECA\u5929\u8FDE\u5564\u9152\u90FD\u6CA1\u559D\u3002"
  }
}