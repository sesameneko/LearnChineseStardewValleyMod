    "Bad_5": "\u62DC\u6258\uFF0C\u6211\u53EA\u60F3\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u5446\u7740\u3002\u4F60\u4E3A\u4EC0\u4E48\u4E0D\u53BB\u5916\u9762\u505A\u4F60\u81EA\u5DF1\u7684\u4E8B\u60C5\uFF1F",
    "Bad_6": "\u4F60\u60F3\u5E72\u561B\uFF1F\u4F60\u542C\u8D77\u6765\u5C31\u50CF\u5FC3\u60C5\u5F88\u574F\u7684\u739B\u5C3C\u3002\u8D70\u5F00\u3002$a",
    "Bad_7": "\u519C\u573A\u751F\u6D3B\u5176\u5B9E\u771F\u7684\u633A\u65E0\u804A\u7684\u3002\u6211\u5230\u5E95\u5728\u8FD9\u5E72\u561B\uFF1F$s",
    "Bad_8": "\u662F\u7684\u2026\u2026*\u55DD*\u2026\u2026\u5F53\u7136\uFF0C\u4EB2\u7231\u7684\u3002\u968F\u4F60\u600E\u4E48\u8BF4\u2026\u2026*\u55DD*",
    "Good_0": "*\u95FB*\u2026\u2026*\u95FB*\u2026\u2026\u55EF\u2026\u2026\u4F60\u8EAB\u4E0A\u90A3\u7F8E\u5999\u7684\u9999\u5473\u662F\u4EC0\u4E48\uFF1F\u610F\u5927\u5229\u8FA3\u8089\u80A0\u9999\u6C34\uFF1F$6",
    "Good_1": "\u4F60\u77E5\u9053\u81EA\u5DF1\u6BD4\u6211\u6F02\u4EAE\u5F97\u591A\u4E86\u5417\uFF1F$h",
    "Good_2": "\u201C\u8C22\u6069\u201D\u8FD9\u4E2A\u540D\u5B57\u7684\u610F\u601D\u662F\u201C\u6765\u81EA\u7531\u5DF4\u7684\u793C\u7269\u201D\u2026\u2026\u771F\u662F\u4E2A\u7B11\u8BDD\u3002",
    "Good_3": "\u6211\u4ECA\u5929\u5FC3\u60C5\u5F88\u597D\u2026\u2026\u96A7\u9053\u6398\u8FDB\u961F\u6628\u665A\u8D62\u5927\u4E86\u3002$h",
    "Good_4": "\u563F\uFF0C\u5982\u679C\u6211\u8868\u73B0\u5F97\u5F88\u66B4\u8E81\uFF0C\u65E0\u89C6\u6211\u5C31\u597D\u3002\u6709\u65F6\u6211\u7684\u60C5\u7EEA\u4F1A\u5F88\u5947\u602A\uFF0C\u4F46\u4E0D\u662F\u9488\u5BF9\u4F60\u2026\u2026\u597D\u5417\uFF1F",
    "Good_5": "\u554A\u2026\u2026\u5728\u519C\u573A\u751F\u6D3B\u80AF\u5B9A\u6BD4\u5728 Joja \u5DE5\u4F5C\u5F3A\u3002\u90A3\u4E2A\u5730\u65B9\u5F88\u6076\u5FC3\u3002$h#$e#\u4F60\u8BA4\u4E3A\u5728\u524D\u9762\u5F88\u6CAE\u4E27\u5417\uFF1F\u5B69\u5B50\uFF0C\u4F60\u5E94\u8BE5\u770B\u770B\u540E\u9762\u7684\u623F\u95F4\u2026\u2026",
    "Good_6": "\u554A\u2026\u2026\u8FD9\u7B80\u76F4\u5C31\u662F\u5B8C\u7F8E\u7684\u751F\u6D3B\u3002\u4E0D\u9700\u8981\u8D1F\u8D23\u4EFB\uFF0C\u665A\u4E0A\u6709\u96A7\u9053\u6398\u8FDB\u961F\u7684\u6BD4\u8D5B\uFF0C\u51B0\u7BB1\u91CC\u585E\u6EE1\u4E86\u6211\u60F3\u8981\u7684\u4E00\u5207\u3002$h",
    "Good_8": "\u6211\u4ECA\u5929\u6CA1\u4EC0\u4E48\u5DE5\u4F5C\u7684\u5FC3\u60C5\u3002\u4E5F\u8BB8\u6211\u5E94\u8BE5\u770B\u7535\u89C6\u3002",
    "Good_9": "\u55EF\u2026\u2026\u4F60\u60F3\u77E5\u9053\u6211\u4E3A\u4EC0\u4E48\u5728\u50BB\u7B11\u5417\uFF1F\u4F60\u7684\u8BB0\u6027\u771F\u5F97\u4E0D\u592A\u597D\u554A\uFF0C\u4E0D\u662F\u5417\uFF1F*\u8138\u7EA2*$h",
    "Indoor_Day_0": "\u54CE\u2026\u2026\u751F\u6D3B\u6709\u65F6\u5019\u5C31\u50CF\u662F\u4E00\u56E2\u7F13\u6162\u800C\u6A21\u7CCA\u7684\u666F\u8C61\u2026\u2026\u61C2\u6211\u7684\u610F\u601D\u5417\uFF1F",
    "Indoor_Day_1": "\u563F\u3002\u62FF\u7740\u2026\u2026\u6211\u5F80\u5FAE\u6CE2\u7089\u91CC\u653E\u592A\u591A\u4E86\u3002[195 215 206]#$e#\u5982\u679C\u9ECF\u7CCA\u7CCA\u7684\uFF0C\u53EF\u522B\u4ECB\u610F\u554A\u3002",
    "Indoor_Day_2": "\u7B54\u5E94\u6211\u4E00\u4EF6\u4E8B\u2026\u2026\u7B49\u6211\u53BB\u4E16\u4EE5\u540E\uFF0C\u7528\u6211\u7684\u9AA8\u7070\u7ED9\u7389\u7C73\u65BD\u80A5\u6765\u5582\u6BCD\u9E21\u5427\u3002",
    "Indoor_Day_3": "*\u4EB2\u543B*\u2026\u2026\u55EF\uFF0C\u5473\u9053\u50CF\u662F\u6709\u4EBA\u521A\u5403\u8FC7\u62AB\u8428\u5377\u3002$6",
    "Indoor_Day_4": "\u6211\u53EF\u80FD\u4F1A\u7ECF\u5E38\u95F7\u4E0D\u4F5C\u58F0\uFF0C\u6709\u65F6\u6211\u53EF\u80FD\u770B\u8D77\u6765\u4E0D\u592A\u5F00\u5FC3\u2026\u2026\u4F46\u6211\u5F88\u611F\u6FC0\u4F60\u4ED8\u51FA\u7684\u6240\u6709\u52AA\u529B\u3002\u6211\u771F\u662F\u4E2A\u5E78\u8FD0\u7684\u5BB6\u4F19\u3002$6",
    "Indoor_Night_0": "\u6211\u53EA\u60F3\u5728\u4E0A\u5E8A\u7761\u89C9\u4E4B\u524D\u518D\u591A\u559D\u4E00\u4E9B\u5564\u9152\u3002",
    "Indoor_Night_1": "\u8981\u662F\u2026\u2026\u8981\u662F\u90A3\u65F6\u2026\u2026\u554A\uFF0C\u6211\u53EA\u662F\u5728\u56DE\u5FC6\u5F53\u5E74\u5728\u6821\u961F\u6253\u683C\u7403\u7684\u8F89\u714C\u5C81\u6708\u3002$6#$b#\u4E0D\u8FC7\u73B0\u5728\u6211\u53C8\u8001\u53C8\u5F31\u4E86\u2026\u2026",
    "Indoor_Night_2": "\u5443\u2026\u2026*\u55DD*\u2026\u2026\u6211\u89C9\u5F97Joja\u4E07\u80FD\u8638\u9171\u6709\u70B9\u2026\u2026\u592A\u591A\u4E86\u2026\u2026",
    "Indoor_Night_3": "\u54CE\u2026\u2026\u6211\u5E0C\u671B\u81EA\u5DF1\u80FD\u518D\u957F\u9AD8 6 \u82F1\u5BF8\u5E76\u4E14\u518D\u806A\u660E\u4E00\u70B9\u2026\u2026#$e#\u4F60\u5C31\u559C\u6B22\u6211\u8FD9\u6837\u7684\u4E48\uFF1F\u6211\u8FD8\u662F\u5F88\u96BE\u7406\u89E3\u2026\u2026",
    "Indoor_Night_4": "\u6211\u4E00\u6574\u5929\u90FD\u5728\u770B\u7535\u89C6\uFF0C\u73B0\u5728\u6211\u7684\u817F\u611F\u89C9\u50CF\u67D4\u8F6F\u7684\u9762\u56E2\u3002\u6211\u60F3\u6211\u5F97\u653E\u8F7B\u677E\u5230\u660E\u5929\u3002",
    "Neutral_0": "\u5662\uFF0C\u4F60\u6709\u4E8B\u8981\u627E\u6211\u5417\uFF1F\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u8FD9\u4F1A\u513F\u6709\u70B9\u5FD9\u3002",
    "Neutral_2": "\u7B49\u6211\u4EEC\u4ECA\u665A\u8EBA\u5728\u5E8A\u4E0A\u7684\u65F6\u5019\u518D\u7ED9\u6211\u8BB2\u8BB2\u4F60\u7684\u4E00\u5929\u5427\uFF1F\u6211\u73B0\u5728\u6709\u70B9\u5FD9\u2026\u2026",
    "Neutral_3": "\u5728 Joja \u5546\u573A\u5DE5\u4F5C\u662F\u5F88\u7D2F\uFF0C\u4F46\u81F3\u5C11\u6211\u8FD8\u5076\u5C14\u4E0E\u4EBA\u4E92\u52A8\u3002",
    "Neutral_4": "\u4EC0\u4E48\uFF0C\u4F60\u60F3\u8BA9\u6211\u6D17\u76D8\u5B50\uFF1F\u6211\u4F1A\u6D17\u7684\u2026\u2026\u8FDF\u65E9\u5427\u2026\u2026",
    "Neutral_5": "\u6211\u4EEC\u8D5A\u7684\u94B1\u591A\u5417\uFF1F\u6211\u4E0D\u60F3\u88AB\u8FEB\u56DE\u5230 Joja \u5546\u573A\u5DE5\u4F5C\u3002",
    "Neutral_6": "\u5982\u679C\u4F60\u8981\u53BB\u9547\u91CC\u770B\u4F60\u7684\u670B\u53CB\u5C31\u53BB\u5427\u3002\u6709\u7535\u89C6\u548C\u51E0\u4E2A\u9AD8\u4E2A\u5B50\u7537\u5B69\u966A\u6211\u5C31\u5F88\u9AD8\u5174\u4E86\u3002",
    "Neutral_8": "\u5443\u2026\u2026\u6E05\u626B\u3001\u6E05\u626B\u3001\u6E05\u626B\u3002\u6253\u626B\uFF0C\u6253\u626B\uFF0C\u6253\u626B\u3002\u6D17\u6FA1\u3002\u505A\u996D\u3002\u6574\u7406\u5E8A\u94FA\u2026\u2026\u54CE\uFF0C\u597D\u5427\u3002\u751F\u6D3B\u5C31\u662F\u8FD9\u6837\u3002",
    "OneKid_0": "\u5F88\u5947\u602A\uFF0C\u5F53\u6211\u5E74\u8F7B\u7684\u65F6\u5019\uFF0C\u6211\u53D1\u8A93\u6211\u4E0D\u8981\u5B69\u5B50\u3002\u6211\u4E0D\u77E5\u9053\u81EA\u5DF1\u5230\u5E95\u600E\u4E48\u4E86\uFF1F$6",
    "OneKid_1": "\u6211\u4EEC\u4E00\u5B9A\u8981\u7ED9%kid1\u5403\u5F88\u591A\u9E21\u86CB\u2026\u2026\u8FD9\u6837\u5B9D\u5B9D\u624D\u4F1A\u957F\u5F97\u5F88\u9AD8\uFF01",
    "OneKid_3": "\u8C22\u6069\u7238\u7238\u62A5\u5230\u2026\u2026$6#$e#\u54CE\u2026\u2026\u6211\u5DF2\u7ECF\u53D8\u5F97\u53C8\u8001\u53C8\u571F\u4E86\u3002",
    "Outdoor_0": "\u6211\u6628\u665A\u7761\u5F97\u4E0D\u597D\u6240\u4EE5\u6211\u5E0C\u671B\u8FD9\u65B0\u9C9C\u7A7A\u6C14\u80FD\u4FC3\u8FDB\u679C\u6C41\u6D41\u52A8\u3002#$e#\u4F60\u95EE\u4EC0\u4E48\u679C\u6C41\uFF1F\u5475\u2026\u2026\u4F60\u771F\u5947\u602A\u3002$h",
    "Outdoor_1": "\u6709\u65F6\u6211\u4F1A\u7A81\u7136\u610F\u8BC6\u5230\u81EA\u5DF1\u53EA\u4E0D\u8FC7\u662F\u4E00\u526F\u67D4\u5F31\u7684\u8840\u8089\u4E4B\u8EAF\u3002#$e#\u4F46\u662F\u5462\u2026\u2026\u90A3\u4E5F\u5F88\u597D\u2026\u2026\u53CD\u6B63\u751F\u6D3B\u5C31\u662F\u5982\u6B64\u5440\uFF1F$h",
    "Outdoor_2": "\u5982\u679C\u6211\u4ED4\u7EC6\u60F3\u60F3\u7684\u8BDD\u2026\u2026\u6211\u73B0\u5728\u5904\u5883\u633A\u4E0D\u9519\u7684\u3002\u6211\u8FC7\u5F97\u5F88\u597D\u3002$6",
    "Outdoor_3": "\u5662\u2026\u2026\u5403\u4E86\u592A\u591A\u8FA3\u6912\u6CE2\u666E\u5C14\u5976\u916A\u9762\u5305\uFF0C\u6211\u7684\u820C\u5934\u90FD\u80BF\u4E86\u3002$s",
    "Outdoor_4": "\u563F\uFF0C@\u3002\u4F60\u719F\u7761\u5F97\u50CF\u4E2A\u5C0F\u5B69\u4E00\u6837\uFF0C\u4E8E\u662F\u6211\u4ECE\u5E8A\u4E0A\u6E9C\u4E86\u51FA\u53BB\uFF0C\u5728\u519C\u573A\u91CC\u6563\u4E86\u4E00\u4F1A\u6B65\u3002\u4E00\u5207\u770B\u8D77\u6765\u90FD\u5F88\u597D\u3002",
    "Rainy_Day_0": "\u4F46\u613F\u6211\u4E0D\u5728\u7684\u65F6\u5019\u8D3E\u65AF\u548C\u739B\u59AE\u4E5F\u8FC7\u5F97\u5F88\u597D\u3002#$e#\u6211\u4E0D\u662F\u592A\u62C5\u5FC3\u7684\u2026\u2026\u2026\u8D3E\u65AF\u73B0\u5728\u957F\u5927\u4E86\uFF0C\u53EF\u4EE5\u81EA\u5DF1\u7167\u987E\u8FD9\u4E9B\u52A8\u7269\u4E86\u3002",
    "Rainy_Day_1": "\u4F60\u77E5\u9053\u5417\uFF1F\u81EA\u4ECE\u4E0E\u4F60\u5728\u4E00\u8D77\u540E\uFF0C\u6211\u7684\u4F53\u91CD\u5DF2\u7ECF\u51CF\u8F7B\u4E86\u4E00\u4E9B\u3002$6",
    "Rainy_Day_2": "\u6765\u2026\u2026\u8FD9\u4E2A\u62FF\u53BB\u5427\u3002[346 174 303 305 215]#$e#\u6211\u524D\u4E00\u6BB5\u65F6\u95F4\u4E70\u4E86\u4E00\u4E9B\uFF0C\u73B0\u5728\u90FD\u5FEB\u8981\u8FC7\u671F\u4E86\u2026\u2026",
    "Rainy_Day_3": "\u54CE\u2026\u2026\u6211\u4ECA\u5929\u611F\u89C9\u6CA1\u4EC0\u4E48\u52A8\u529B\u3002",
    "Rainy_Day_4": "@\uFF0C\u6211\u4ECA\u5929\u8BE5\u5E72\u70B9\u4EC0\u4E48\u5B9E\u4E8B\u5417\uFF1F\u2026\u2026\u8FD8\u662F\u6C38\u8FDC\u7761\u4E0B\u53BB\uFF1F",
    "Rainy_Night_0": "\u55EF\u2026\u2026\u4ECA\u665A\u4F3C\u4E4E\u5F88\u9002\u5408\u7528\u5FAE\u6CE2\u7089\u505A\u51E0\u4E2A\u62AB\u8428\u5377\u3002#$e#\u6709\u4E9B\u4EBA\u559C\u6B22\u7528\u70E4\u7089\u505A\uFF0C\u4F46\u662F\u5BF9\u6211\u6765\u8BF4\u90A3\u592A\u6162\u4E86\u3002\u53E6\u5916\u6211\u559C\u6B22\u90A3\u79CD\u9ECF\u7CCA\u7CCA\u7684\u53E3\u611F\u3002$h",
    "Rainy_Night_1": "\u96E8\u6C34\u7684\u6EF4\u7B54\u58F0\u4EFF\u4F5B\u628A\u6211\u5E26\u5230\u4E86\u4E00\u4E2A\u4E0D\u540C\u7684\u65F6\u95F4\u2026\u2026\u4E0D\u540C\u7684\u5730\u70B9\u3002",
    "Rainy_Night_2": "\u6211\u731C\u2026\u2026\u5982\u679C\u6211\u6709\u51E0\u6761\u5E72\u88E4\u5B50\u7684\u8BDD\u6211\u4ECA\u5929\u53EF\u80FD\u4F1A\u51FA\u53BB\u2026\u2026\u4F46\u8FD8\u662F\u7B97\u4E86\u5427\u3002",
    "Rainy_Night_3": "\u6211\u559C\u6B22\u9634\u5929\uFF0C\u4F46\u6211\u611F\u89C9\u6BCD\u9E21\u4EEC\u6709\u70B9\u53EF\u601C\u3002",
    "Rainy_Night_4": "\u6EF4\u7B54\u6EF4\u7B54\u6EF4\u2026\u2026\u6211\u5F00\u59CB\u89C9\u5F97\u6E34\u4E86\u3002$6",
    "TwoKids_0": "\u6211\u5DF2\u7ECF\u5582\u4E86\u5B69\u5B50\u4EEC\u4E24\u7897\u6BD4\u8428\u6CE1\u8299\u9EA6\u7247\u3002\u4ED6\u4EEC\u8FD9\u4F1A\u513F\u4E0D\u4F1A\u997F\u4E86\u3002",
    "TwoKids_1": "\u8001\u5B9E\u8BF4\u2026\u2026\u4E24\u4E2A\u5B69\u5B50\u5BF9\u6211\u6765\u8BF4\u8DB3\u591F\u4E86\u3002",
    "TwoKids_2": "\u5443\u2026\u2026%kid2\u4ECA\u5929\u6709\u70B9\u8C03\u76AE\u3002\u4E00\u5B9A\u662F\u4F20\u6211\u7684\u4EE3\u2026\u2026",
    "TwoKids_3": "*\u5509*\u2026\u2026\u5982\u679C\u6211\u4EEC\u80FD\u9001\u5B69\u5B50\u53BBJoja\u5DE5\u4F5C\u8425\u5E72\u4E00\u6BB5\u65F6\u95F4\u5C31\u597D\u4E86\u2026\u2026#$e#\u6211\u53EA\u662F\u5728\u5F00\u73A9\u7B11\u3002$h",
    "fall_1": "\u55EF\u2026\u2026\u6211\u53EF\u80FD\u9700\u8981\u4E70\u4E00\u4E9B\u5357\u74DC\u5564\u9152\u6765\u5E86\u795D\u8FD9\u4E2A\u5B63\u8282\u2026\u2026$6",
    "fall_15": "\u6211\u4F1A\u50CF\u5F80\u5E38\u4E00\u6837\u5728\u660E\u5929\u7684\u5E02\u96C6\u4E0A\u5E2E\u52A9\u739B\u59AE\u7167\u987E\u52A8\u7269\u3002\u4F60\u5E94\u8BE5\u4F11\u606F\u4F11\u606F\uFF0C\u597D\u597D\u73A9\u4E00\u4E0B\u3002$6",
    "fall_17": "\u6211\u771F\u7684\u5F00\u59CB\u611F\u89C9\u5230\u81EA\u5DF1\u53D8\u8001\u4E86\u2026\u2026\u6211\u5BF9\u6B64\u4E00\u70B9\u90FD\u4E0D\u5F00\u5FC3\u3002",
    "funLeave_Shane": "\u6211\u4ECA\u5929\u8981\u51FA\u95E8\uFF0C\u597D\u5427\uFF1F",
    "funReturn_Shane": "\u62B1\u6B49\u6211\u6EE1\u8EAB\u90FD\u662F\u6C57\u2026\u2026\u6211\u8DD1\u4E86\u597D\u8FDC\u2026\u2026\u54CE\uFF0C\u6211\u592A\u80D6\u4E86\u3002$6",
    "patio_Shane": "\u67E5\u7406\u8FC7\u5F97\u5F88\u597D\u3002$8",
    "spring_1": "\u5662\u2026\u2026\u6211\u7684\u5934\u597D\u75DB\u3002\u6628\u665A\u6211\u5230\u5E95\u559D\u4E86\u591A\u5C11\uFF1F",
    "spring_12": "\u86CB\u86CB\u8282\u65E5\u5927\u6982\u662F\u6211\u6700\u559C\u6B22\u7684\u8282\u65E5\u2026\u2026\u4F60\u4E86\u89E3\u6211\u7684\uFF0C\u4E0E\u9E21\u6709\u5173\u7684\u4EFB\u4F55\u4E8B\u60C5\u90FD\u80FD\u8BA9\u6211\u4E3A\u4E4B\u75AF\u72C2\u3002$h",
    "spring_23": "\u5662\uFF0C\u5BF9\u4E86\u3002\u660E\u5929\u662F\u82B1\u821E\u8282\u3002\u563F\uFF0C\u5982\u679C\u4F60\u89C9\u5F97\u5F00\u5FC3\uFF0C\u90A3\u6211\u4E5F\u5F00\u5FC3\u3002",
    "summer_1": "\u6211\u559C\u6B22\u5728\u6BCF\u5E74\u7684\u8FD9\u4E2A\u65F6\u5019\u770B\u5230\u90A3\u4E9B\u70ED\u5E26\u690D\u7269\u3002\u5C71\u8C37\u53D8\u5F97\u90C1\u90C1\u8471\u8471\u3002",
    "summer_10": "\u76F4\u5230\u660E\u5929\u7684\u590F\u5A01\u5937\u5F0F\u5BB4\u4F1A\u4E3A\u6B62\u6211\u5E94\u8BE5\u7981\u98DF\u3002\u6211\u9700\u8981\u653E\u7A7A\u81EA\u5DF1\u7684\u809A\u5B50\uFF0C\u8FD9\u6837\u624D\u597D\u75DB\u996E\u6EDA\u70EB\u7684\u6C64\u3002$h",
    "summer_27": "\u4F60\u79CB\u5929\u7684\u8BA1\u5212\u662F\u4EC0\u4E48\uFF1F\u6211\u8981\u8BD5\u7740\u628A\u8461\u8404\u9152\u878D\u5165\u6211\u7684\u996E\u98DF\u3002",
    "winter_1": "\u4ECA\u5E74\u51AC\u5929\u6709\u4EC0\u4E48\u5927\u8BA1\u5212\uFF1F\u6211\u53EF\u80FD\u4F1A\u6574\u5929\u770B\u7535\u89C6\uFF0C\u5728\u5BB6\u91CC\u60A0\u95F2\u5730\u5EA6\u8FC7\u3002",
    "winter_28": "\u597D\u5427\uFF0C\u53C8\u4E00\u5E74\u8FC7\u53BB\u4E86\u2026\u2026\u6211\u770B\u8D77\u6765\u53C8\u8001\u4E86\u4E00\u70B9\uFF0C\u4F46\u4EC5\u6B64\u800C\u5DF2\u3002$6"
  }
}