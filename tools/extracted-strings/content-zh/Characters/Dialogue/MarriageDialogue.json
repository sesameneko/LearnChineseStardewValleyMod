    "spring_1": "\u65B0\u7684\u4E00\u5E74\u5230\u6765\u4E86\u3002\u4F60\u5BF9\u4ECA\u5E74\u8981\u8FBE\u6210\u7684\u76EE\u6807\u6709\u8BA1\u5212\u5417\uFF1F#$e#\u6211\u89C9\u5F97\u5F88\u6709\u5E0C\u671B\u3002",
    "spring_23": "\u6211\u5E0C\u671B\u4F60\u5DF2\u7ECF\u7EC3\u8FC7\u821E\u6B65\u4E86\u2026\u2026\u660E\u5929\u662F\u82B1\u821E\u8282\uFF01",
    "spring_8": "\u51AC\u5929\u8FC7\u53BB\u4E86\uFF0C\u5E0C\u671B\u4ECA\u5E74\u80FD\u98CE\u8C03\u96E8\u987A\u5462\u3002",
    "spring_Abigail": "\u867D\u7136\u6211\u4E5F\u559C\u6B22\u51B7\u70B9\u7684\u5B63\u8282\uFF0C\u4F46\u6700\u7EC8\u6211\u8FD8\u662F\u5F88\u559C\u6B22\u770B\u5230\u6625\u5929\u7684\u6765\u4E34\u3002",
    "spring_Alex": "\u563F\uFF0C@\u3002\u4ECA\u5929\u6211\u4EEC\u90FD\u8981\u52AA\u529B\u5DE5\u4F5C\u54E6\uFF01",
    "spring_Elliott": "\u5E0C\u671B\u4ECA\u5E74%farm\u519C\u573A\u80FD\u98CE\u8C03\u96E8\u987A\uFF0C\u4E00\u5207\u90FD\u597D\u3002$h",
    "spring_Haley": "\u751C\u5FC3\uFF0C\u51AC\u5929\u7ED3\u675F\u4E86\u4F60\u4E0D\u5F00\u5FC3\u5417\uFF1F\u73B0\u5728\u4E00\u5207\u53C8\u5145\u6EE1\u4E86\u5E0C\u671B\u3002",
    "spring_Harvey": "\u4ECA\u5E74\u6625\u5929\u6211\u4EEC\u79CD\u4E9B\u6709\u76CA\u5065\u5EB7\u7684\u852C\u83DC\u5427\u3002$h",
    "spring_Leah": "\u51FA\u53BB\u7684\u65F6\u5019\uFF0C\u522B\u5FD8\u4E86\u627E\u627E\u91CE\u5C71\u8475\u3001\u97ED\u83DC\u548C\u84B2\u516C\u82F1\uFF01",
    "spring_Maru": "\u65B0\u7684\u4E00\u5E74\u8015\u79CD\u5F00\u59CB\u4E86\uFF0C\u6211\u597D\u5174\u594B\u554A\uFF0C@\uFF01$h",
    "spring_Penny": "\u767D\u832B\u832B\u7684\u51AC\u5B63\u8FC7\u540E\uFF0C\u7EFF\u8471\u8471\u7684\u666F\u8C61\u771F\u662F\u8BA9\u4EBA\u6B23\u559C\u3002",
    "spring_Sam": "*\u5438\u6C14*\u2026\u2026\u9F3B\u5B50\u90FD\u5835\u7740\u4E86\u2026\u2026\u8FC7\u654F\u3002",
    "spring_Sebastian": "\u54C7\uFF0C\u6211\u7684\u76AE\u80A4\u597D\u82CD\u767D\u554A\u2026\u2026\u4E5F\u8BB8\u8FD9\u4E2A\u5B63\u5EA6\u6211\u8BE5\u5E2E\u4F60\u505A\u70B9\u519C\u6D3B\u3002",
    "spring_Shane": "\u4E5F\u8BB8\u6211\u4ECA\u5E74\u4F1A\u5B66\u4E60\u4E00\u9879\u65B0\u6280\u80FD\u2026\u2026",
    "summer_1": "\u5343\u4E07\u522B\u4E2D\u6691\u554A\uFF0C\u4EB2\u7231\u7684\u3002#$e#\u8981\u591A\u559D\u6C34\uFF0C\u522B\u7D2F\u7740\u81EA\u5DF1\u3002",
    "summer_15": "\u590F\u5929\u5230\u4E86\u2026\u2026\u4F30\u8BA1\u8981\u6EE1\u623F\u5B50\u82CD\u8747\u4E86\u3002#$e#\u522B\u62C5\u5FC3\uFF0C\u6211\u4F1A\u5904\u7406\u5B83\u4EEC\u7684\u3002",
    "summer_8": "\u62B1\u6B49\u6211\u8EAB\u4E0A\u6709\u5F02\u5473\u2026\u2026\u4ECA\u665A\u70ED\u5F97\u6211\u5168\u8EAB\u5192\u6C57\u3002",
    "summer_Abigail": "\u54CE\u54DF\u2026\u2026\u6211\u771F\u60F3\u5403\u5DE7\u514B\u529B\u86CB\u7CD5\u3002",
    "summer_Alex": "\u5728\u590F\u5929\uFF0C\u6211\u6700\u6709\u6D3B\u529B\u3002",
    "summer_Elliott": "\u8BF4\u8D77\u5927\u6D77\uFF0C\u6211\u6700\u60F3\u5FF5\u7684\u662F\u90A3\u91CC\u65B0\u9C9C\u7684\u9C7C\u3002",
    "summer_Emily": "\u54BB\uFF01\u5F88\u70ED\uFF0C\u4F46\u611F\u89C9\u5F88\u597D\uFF0C\u4E0D\u662F\u5417\uFF1F#$e#\u4E5F\u8BB8\u4ECA\u5929\u6211\u4EEC\u4F1A\u770B\u5230\u4E00\u4E9B\u91CE\u751F\u9E66\u9E49\u3002",
    "summer_Haley": "\u4F60\u73B0\u5728\u4E00\u5B9A\u731C\u5230\u4E86\uFF0C\u6211\u6700\u559C\u6B22\u7684\u5B63\u8282\u5C31\u662F\u590F\u5929\u3002$h",
    "summer_Harvey": "\u5343\u4E07\u522B\u6652\u4F24\u4E86\uFF0C\u751C\u5FC3\u2026\u2026\u90A3\u5BF9\u4F60\u76AE\u80A4\u4E0D\u597D\u3002",
    "summer_Leah": "\u4E00\u676F\u7518\u7F8E\u7684\u7EA2\u9152\u914D\u8FD9\u76DB\u590F\u518D\u5408\u9002\u4E0D\u8FC7\u4E86\u3002\u4E0D\u662F\u5417\uFF0C\u751C\u5FC3\uFF1F",
    "summer_Maru": "\u6BCF\u5E74\u8FD9\u4E2A\u65F6\u5019\u90FD\u5F88\u9002\u5408\u770B\u661F\u661F\u3002",
    "summer_Penny": "\u4ECA\u5E74\u590F\u5929\u4F60\u79CD\u897F\u74DC\u4E86\u5417\uFF1F",
    "summer_Sam": "\u5230\u4E86\u590F\u5929\uFF0C\u6211\u603B\u662F\u60F3\u591A\u5403\u70B9\u70E7\u70E4\u3002",
    "summer_Sebastian": "\u4ECA\u5E74\u590F\u5929\u6211\u5C31\u5C3D\u91CF\u5F85\u5728\u5BA4\u5185\u5427\u3002",
    "summer_Shane": "\u6211\u4ECA\u5929\u7684\u65E5\u7A0B\u662F\u4EC0\u4E48\u2026\u2026\u5514\u2026\u2026#$e#\u6211\u60F3\u8BE5\u6765\u70B9\u8FA3\u8106\u997C\u96F6\u98DF\u548C\u4E24\u4E2A\u201C\u51B7\u9177\u7537\u5B69\u201D\u96EA\u7CD5\u3002",
    "winter_1": "\u54CE\u5440\u2026\u2026\u597D\u51B7\u554A\u3002\u6211\u731C\u5DF2\u7ECF\u51AC\u5929\u4E86\u3002",
    "winter_28": "\u611F\u8C22\u8FD9\u7F8E\u597D\u7684\u4E00\u5E74\uFF0C@\u3002\u6211\u5F88\u671F\u5F85\u4E0E\u4F60\u5171\u5EA6\u660E\u5E74\u3002$l",
    "winter_7": "\u4F60\u8981\u53C2\u52A0\u4ECA\u5E74\u7684\u9493\u9C7C\u5927\u8D5B\u5417\uFF1F",
    "winter_Abigail": "\u8FD8\u8BB0\u5F97\u4EE5\u524D\u6211\u4EEC\u4E00\u8D77\u5728\u6211\u5C4B\u91CC\u73A9\u201C\u8349\u539F\u4E4B\u738B\u201D\u7684\u6E38\u620F\u5417\uFF1F\u90A3\u65F6\u771F\u662F\u5F00\u5FC3\u3002$h",
    "winter_Alex": "\u5E0C\u671B\u6211\u7684\u7956\u7236\u6BCD\u4E00\u5207\u90FD\u597D\u3002\u4ED6\u4EEC\u4EE5\u524D\u9700\u8981\u6211\u5E2E\u5F88\u591A\u5FD9\u3002\u50CF\u662F\u642C\u91CD\u7269\u4E4B\u7C7B\u7684\u3002",
    "winter_Elliott": "\u4ECA\u5E74\u51AC\u5929\u6211\u51C6\u5907\u5199\u70B9\u4E1C\u897F\u3002\u53CD\u6B63\u4E5F\u6CA1\u591A\u5C11\u4E8B\u53EF\u505A\u3002",
    "winter_Emily": "\u54CE\u5466\uFF0C\u6211\u7684\u5934\u53D1\u53C8\u51DD\u56FA\u4E86\u3002$s",
    "winter_Haley": "\u6211\u53C8\u56DE\u60F3\u8D77\u4F60\u5E2E\u6211\u5F00\u54B8\u83DC\u7F50\u5934\u7684\u90A3\u4E00\u5929\u3002$h#$e#\u6211\u4EEC\u4E5F\u662F\u5728\u90A3\u4E4B\u540E\u597D\u4E0A\u7684\u3002$l",
    "winter_Harvey": "\u51AC\u5929\u662F\u6D41\u611F\u76DB\u884C\u7684\u5B63\u8282\uFF0C\u6240\u4EE5\u5DE5\u4F5C\u8D77\u6765\u53EF\u80FD\u4F1A\u66F4\u6709\u538B\u529B\u5427\u3002\u6211\u5148\u63D0\u524D\u9053\u4E2A\u6B49\uFF0C\u4F30\u8BA1\u4E4B\u540E\u6211\u53C8\u8981\u53D1\u7262\u9A9A\u4E86\u3002",
    "winter_Leah": "\u51AC\u5929\u6211\u603B\u662F\u60F3\u5403\u852C\u83DC\u6C99\u62C9\u2026\u2026\u6211\u4E5F\u77E5\u9053\u8FD9\u4E0D\u592A\u65B9\u4FBF\u3002",
    "winter_Maru": "\u6625\u5929\u5373\u5C06\u6765\u4E34\u3002\u6211\u5341\u5206\u671F\u5F85\u5927\u9EC4\u6D3E\u5462\u3002",
    "winter_Penny": "\u4ECA\u5E74\u51AC\u5929\u6211\u51C6\u5907\u591A\u8BFB\u8BFB\u4E66\u3002",
    "winter_Sam": "\u6211\u51B3\u5B9A\u4E0D\u505A\u97F3\u4E50\u5BB6\u4E86\u3002\u6211\u73B0\u5728\u8981\u5F53\u5C45\u5BB6\u597D\u7537\u4EBA\uFF01",
    "winter_Sebastian": "\u4E0D\u77E5\u9053\u5C71\u59C6\u600E\u4E48\u6837\u4E86\uFF1F\u6211\u4EEC\u4EE5\u524D\u662F\u5F88\u8981\u597D\u7684\u670B\u53CB\u3002",
    "winter_Shane": "\u5916\u9762\u6709\u4E00\u4E2A\u5F88\u5927\u5F88\u5927\u7684\u4E16\u754C\u2026\u2026\u4F46\u6211\u5B81\u613F\u5446\u5728\u81EA\u5DF1\u7684\u623F\u95F4\u91CC\u3002"
  }
}