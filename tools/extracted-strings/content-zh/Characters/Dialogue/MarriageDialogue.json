    "Bad_0": "\u2026\u2026\u4F60\u8FD8\u7231\u6211\u5417\uFF1F$s",
    "Bad_1": "*\u5509* \u2026\u2026\u4E5F\u8BB8\u6211\u4EEC\u7ED3\u5A5A\u592A\u65E9\u4E86\u3002$s",
    "Bad_2": "\u4F60\u548C\u6211\u5728\u4E00\u8D77\u8FD8\u5E78\u798F\u5417\uFF1F$s",
    "Bad_3": "\u6211\u505A\u9519\u4EC0\u4E48\u4E86\u5417\uFF1F\u4F60\u6700\u8FD1\u7684\u53CD\u5E94\u4E0D\u592A\u4E00\u6837\u3002$s",
    "Bad_4": "\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\u5916\u9762\u8FD8\u6709\u4EC0\u4E48\u65B0\u4E8B\u7269\uFF1F$s",
    "Bad_5": "\u4F60\u4EE5\u524D\u90A3\u4E48\u6D6A\u6F2B\u2026\u2026\u5230\u5E95\u600E\u4E48\u4E86\uFF1F$s#$e#\u6211\u77E5\u9053\u81EA\u5DF1\u6CA1\u6709\u4EE5\u524D\u90A3\u4E48\u5E74\u8F7B\u4E86\u2026\u2026\u96BE\u9053\u4F60\u548C\u6211\u7ED3\u5A5A\u5C31\u662F\u4E3A\u4E86\u6211\u5F53\u65F6\u7684\u5E74\u8F7B\u8C8C\u7F8E\uFF1F$a",
    "Bad_6": "\u6211\u4EEC\u7684\u4EBA\u751F\u77ED\u6682\u2026\u2026\u5C31\u8FD9\u6837\u5B50\u5EA6\u8FC7\u771F\u7684\u597D\u5417\uFF1F$s",
    "Bad_7": "\u6211\u66FE\u7ECF\u662F\u4F60\u773C\u4E2D\u7684\u5B9D\u8D1D\u2026\u2026\u4F46\u73B0\u5728\uFF0C\u53EA\u6709\u505A\u987F\u70ED\u817E\u817E\u7684\u665A\u9910\u624D\u80FD\u8BA9\u4F60\u5BB9\u5FCD\u6211\u3002$s",
    "Bad_8": "\u6700\u8FD1\u4F60\u5BF9\u6211\u597D\u51B7\u6DE1\u2026\u2026$s",
    "Bad_9": "\u4E5F\u8BB8\u6211\u5E94\u8BE5\u66F4\u52AA\u529B\u4E9B\u3002$s",
    "Good_0": "\u771F\u4E0D\u6562\u76F8\u4FE1\u6211\u4EEC\u7ED3\u5A5A\u4E86\u2026\u2026$l",
    "Good_1": "\u4F60\u77E5\u9053\u5417\uFF0C\u6211\u4E00\u76F4\u611F\u89C9\u6211\u4EEC\u603B\u6709\u4E00\u5929\u4F1A\u5728\u4E00\u8D77\u7684\u3002$l",
    "Good_2": "\u7ED3\u5A5A\u4E86\u5F00\u5FC3\u5417\uFF0C@\uFF1F#$e#\u6211\u51C6\u5907\u597D\u4E86\u3002$l",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5E05\u5446\u4E86\uFF01$l^\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u7F8E\u6781\u4E86\u3002$l",
    "Good_4": "\u4EE5\u540E\u8FD9\u91CC\u5C31\u662F\u6211\u7684\u5BB6\u4E86\u2026\u2026\u6211\u5728\u8FD9\u91CC\u5F88\u5E78\u798F\u3002$l",
    "Good_5": "\u6211\u521A\u521A\u5728\u6B23\u8D4F\u6211\u7684\u5A5A\u793C\u62A4\u8EAB\u7B26\u5462\u2026\u2026\u8FD9\u8D1D\u58F3\u5B8C\u7F8E\u65E0\u7455\u3002\u4E00\u5B9A\u82B1\u4E86\u4F60\u5F88\u591A\u94B1\u5427\u3002$l",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6709\u65F6\u6211\u603B\u4F1A\u62C5\u5FC3\u4F60\u8DCC\u5230\u77FF\u4E95\u91CC\u3002",
    "Good_7": "@\uFF1F\u6211\u53EA\u662F\u60F3\u8BF4\uFF0C\u6211\u8981\u611F\u8C22\u4F60\u4E3A\u6211\u4EEC\u4E00\u5BB6\u505A\u51FA\u7684\u5168\u90E8\u52AA\u529B\u3002$h",
    "Good_8": "\u522B\u62C5\u5FC3\u6211\u2026\u2026\u6211\u77E5\u9053\u4F60\u5728\u5916\u9762\u62C5\u8D1F\u7740\u8BB8\u591A\u8D23\u4EFB\u3002\u6211\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u6CA1\u4E8B\u7684\uFF01$l",
    "Good_9": "\u54E6\uFF0C\u6211\u5E76\u4E0D\u65E0\u804A\u2026\u2026\u6211\u53EA\u662F\u4EAB\u53D7\u6211\u4EEC\u6240\u62E5\u6709\u7684\u4E00\u5207\u3002#$e#\u751F\u6D3B\u867D\u6734\u7D20\uFF0C\u4F46\u6211\u5F88\u559C\u6B22\u3002$h",
    "Indoor_Day_0": "\u65E9\u4E0A\u597D ~\u003C$h#$e#\u4ECA\u5929\u51C6\u5907\u597D\u8FCE\u63A5\u5FD9\u788C\u7684\u4E00\u5929\u4E86\u5417\uFF1F\u6211\u51C6\u5907\u597D\u4E86\u3002$h",
    "Indoor_Day_1": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u95FB\u5230\u9999\u5473\u4E86\u5427\uFF1F\u6211\u7ED9\u4F60\u505A\u4E86\u65E9\u9910\uFF01[194 195 210 211 216]#$e#\u8981\u5403\u597D\u5403\u9971\uFF0C\u624D\u80FD\u4E00\u5929\u7CBE\u529B\u5145\u6C9B\u3002",
    "Indoor_Day_2": "\u7761\u5F97\u8FD8\u597D\u5417\uFF1F#$e#\u6211\u8FD8\u8981\u505A\u4E9B\u5BB6\u52A1\u3002",
    "Indoor_Day_3": "\u6628\u665A\u4F60\u6709\u6CA1\u6709\u505A\u5947\u602A\u7684\u68A6\uFF1F#$e#\u6211\u505A\u68A6\u4E86\uFF0C\u4F46\u6211\u53EA\u8BB0\u5F97\u597D\u50CF\u548C%adj%noun\u6709\u5173\u3002\u5947\u602A\u3002$s#$e#\u5475\u5475\u3002\u68A6\u5883\u5E76\u6CA1\u4EC0\u4E48\u610F\u4E49\u2026\u2026\u662F\u5427\uFF0C\u751C\u5FC3\uFF1F$l#$e#\u597D\u4E86\uFF0C\u6211\u4EEC\u53EF\u4E0D\u80FD\u6574\u5929\u90FD\u5728\u95F2\u804A\u3002\u4F60\u8FD8\u6709\u4E8B\u8981\u505A\u5462\uFF01",
    "Indoor_Day_4": "\u4EB2\u7231\u7684\uFF0C\u65E9\u4E0A\u597D\u3002\u4E00\u5929\u519C\u6D3B\u53C8\u5F00\u59CB\u4E86\uFF0C\u55EF\uFF1F#$e#\u6211\u4F1A\u4E3A\u4F60\u52A0\u6CB9\u7684\u3002\u003C$h",
    "Indoor_Day_Abigail": "\u6211\u4EEC\u7684\u519C\u573A\u603B\u662F\u6709\u65B0\u9C9C\u4E8B\u53D1\u751F\u2026\u2026\u6211\u7231\u8FD9\u6837\u7684\u751F\u6D3B\u3002",
    "Indoor_Day_Alex": "\u9633\u5149\u660E\u5A9A\uFF0C\u800C\u6211\u4E5F\u5145\u6EE1\u6D3B\u529B\uFF01\u6240\u4EE5\u4F60\u6700\u597D\u5C0F\u5FC3\u54E6\uFF01\u563F\u563F\u3002$h",
    "Indoor_Day_Elliott": "\u6211\u4EEC\u642C\u5230\u8FD9\u91CC\u540E\uFF0C\u6211\u5C31\u4E00\u76F4\u575A\u6301\u5199\u65E5\u5FD7\u3002\u73B0\u5728\u6211\u6709\u4E86\u81EA\u5DF1\u7684\u751F\u6D3B\uFF0C\u8981\u5199\u7684\u4E1C\u897F\u597D\u591A\u554A\u3002$h#$e#\u6211\u4E00\u5B9A\u8981\u94ED\u8BB0\u5728\u8FD9\u91CC\u7684\u65E5\u5B50\u3002",
    "Indoor_Day_Emily": "\u6211\u4EEC\u901A\u8FC7\u751F\u4EA7\u65B0\u9C9C\u3001\u5065\u5EB7\u7684\u98DF\u7269\u6765\u4E3A\u793E\u533A\u505A\u8D21\u732E\uFF01",
    "Indoor_Day_Haley": "\u6674\u5929\u603B\u662F\u8BA9\u6211\u5FC3\u60C5\u8212\u7545\u3002$h",
    "Indoor_Day_Harvey": "\u4ECA\u5929\u7684\u5929\u7A7A\u592A\u7F8E\u4E86\u2026\u2026\u5982\u6B64\u6F84\u6F88\uFF01#$e#\u4ECE\u73B0\u5728\u8D77\uFF0C\u6211\u6253\u7B97\u53EA\u6709\u63A5\u5230\u9884\u7EA6\u624D\u53BB\u8BCA\u6240\u3002\u5E73\u65F6\u6211\u5C31\u5728\u5BB6\u529E\u516C\u5427\uFF01",
    "Indoor_Day_Krobus": "\u6211\u5F88\u5E0C\u671B\u80FD\u5230\u519C\u573A\u4E0A\u5E2E\u4F60\uFF0C\u4F46\u662F\u6211\u6CA1\u6CD5\u5446\u5728\u592A\u9633\u5E95\u4E0B\u2026\u2026",
    "Indoor_Day_Leah": "\u5982\u679C\u6211\u5728\u8FD9\u513F\u7684\u6728\u5236\u54C1\u4E0A\u53D1\u6325\u70B9\u5EFA\u7B51\u5929\u8D4B\uFF0C\u4F60\u4E0D\u4F1A\u4ECB\u610F\u5427\uFF1F\u6211\u62FF\u7740\u51FF\u5B50\u7684\u624B\u90FD\u53D1\u75D2\u4E86\uFF01",
    "Indoor_Day_Maru": "\u8981\u662F\u4F60\u60F3\u8C08\u8C08\u5982\u4F55\u6700\u5927\u5316\u519C\u4F5C\u7269\u4EA7\u91CF\u4E4B\u7C7B\u7684\u2026\u2026\u6211\u968F\u65F6\u5949\u966A\uFF01",
    "Indoor_Day_Penny": "\u8FD9\u91CC\u6BD4\u623F\u8F66\u5927\u591A\u4E86\uFF0C\u6211\u6709\u70B9\u9002\u5E94\u4E0D\u4E86\u2026\u2026\u4F46\u8FD9\u662F\u597D\u4E8B\uFF01",
    "Indoor_Day_Sam": "\u6211\u4ECA\u5929\u60F3\u505A\u7684\u4E8B\u60C5\u5B9E\u5728\u662F\u592A\u591A\u4E86\u2026\u2026\u4E5F\u8BB8\u6211\u8FD8\u662F\u770B\u7535\u89C6\u597D\u4E86\u3002",
    "Indoor_Day_Sebastian": "\u55EF\uFF0C\u8FD9\u91CC\u786E\u5B9E\u5B8C\u7206\u6211\u90A3\u95F4\u8001\u65E7\u7684\u5730\u4E0B\u5BA4\u554A\uFF0C\u4E0D\u662F\u5417\uFF1F$h",
    "Indoor_Day_Shane": "\u7A7A\u6C14\u4E2D\u6709\u79CD\u7279\u522B\u7684\u5473\u9053\u2026\u2026*\u5438\u6C14*\u2026\u2026\u662F\u4EC0\u4E48\uFF1F\u54E6\u2026\u2026#$b#\uFF1F\u662F\u6211\u51E0\u5468\u524D\u653E\u5728\u53E3\u888B\u91CC\u7684\u7389\u7C73\u7247\u3002 *\u56BC\u56BC*",
    "Indoor_Night_0": "\u4ECA\u5929\u7684\u4E8B\u90FD\u505A\u5B8C\u4E86\u5417\uFF0C@\uFF1F#$e#\u6211\u505A\u4E86\u4E9B\u5BB6\u52A1\u2026\u2026\u4F46\u73B0\u5728\u597D\u7D2F\u554A\u3002#$e#\u4F60\u51C6\u5907\u597D\u4E86\u6211\u4EEC\u5C31\u4E0A\u5E8A\u7761\u89C9\u5427\u3002$h",
    "Indoor_Night_1": "\u54C7\uFF0C\u4F60\u4ECA\u5929\u597D\u50CF\u5E72\u4E86\u4E0D\u5C11\u6D3B\u554A\u3002#$e#\u73B0\u5728\uFF0C\u4F60\u5C31\u653E\u8F7B\u677E\uFF0C\u597D\u597D\u4F11\u606F\u4E00\u665A\u5427\u3002$h",
    "Indoor_Night_2": "\u5F88\u9AD8\u5174\u4F60\u56DE\u6765\u4E86\u3002#$e#\u6211\u665A\u4E0A\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u4F1A\u5BB3\u6015\u7684\u3002$s^\u665A\u4E0A\u6211\u4E5F\u603B\u662F\u5F88\u5B64\u5355\u5462\u2026\u2026$s#$e#\u2026\u2026$h",
    "Indoor_Night_3": "\u4ECA\u5929\u7684\u4E8B\u90FD\u505A\u5B8C\u4E86\u5417\uFF1F\u6211\u521A\u51C6\u5907\u597D\u627E\u70B9\u4E50\u5B50\u5462\u3002$h#$e#\u4E0D\u8FC7\u5982\u679C\u4F60\u7D2F\u4E86\uFF0C\u6211\u4E5F\u53EF\u4EE5\u7406\u89E3\u3002",
    "Indoor_Night_4": "*\u547C*\uFF01\u6211\u521A\u505A\u5B8C\u5BB6\u52A1\u3002\u73B0\u5728\u6211\u4EEC\u53EF\u4EE5\u5171\u5904\u4E00\u6BB5\u65F6\u95F4\u4E86\u3002$h#$e#\u7ED9\u6211\u8BB2\u8BB2\u4F60\u4ECA\u5929\u600E\u4E48\u8FC7\u7684\u5427\u3002$l#$e#\u2026\u2026$h",
    "Indoor_Night_Abigail": "\u51C6\u5907\u8FC7\u4E00\u4F1A\u513F\u5C31\u7761\u5417\uFF1F\u6211\u53BB\u628A\u7535\u70ED\u6BEF\u6253\u5F00\u2026\u2026$l",
    "Indoor_Night_Alex": "\u6211\u7684\u624B\u81C2\u6709\u4E9B\u4E0D\u8212\u670D\u4E86\u2026\u2026\u505A\u4E2A\u6DF1\u5C42\u6309\u6469\u600E\u4E48\u6837\uFF1F$l^\u6211\u611F\u5230\u7CBE\u75B2\u529B\u7AED\u2026\u2026\u8FD9\u662F\u4EF6\u597D\u4E8B\uFF01\u8BF4\u660E\u6211\u4ECA\u5929\u5F88\u52AA\u529B\u3002$h",
    "Indoor_Night_Elliott": "#$c .5#\u5728\u4E00\u5929\u7684\u8F9B\u52E4\u52B3\u4F5C\u4E4B\u540E\uFF0C\u4F60\u8EAB\u4E0A\u6709\u79CD\u7279\u522B\u597D\u95FB\u7684\u9999\u5473\u3002\u662F\u4F60\u7684\u5929\u7136\u9999\u5473\uFF01^\u4EB2\u7231\u7684\uFF0C\u4F60\u8EAB\u4E0A\u6709\u80A1\u751C\u5473\u3002\u5C31\u597D\u50CF\u9999\u6599\u8336\u4E0A\u6F02\u6D6E\u7684\u8702\u871C\u3002#$e#\u6765\uFF0C\u8BA9\u6211\u7ED9\u4F60\u6309\u6469\u6309\u6469\u80CC\u3002\u4F60\u770B\u8D77\u6765\u6709\u70B9\u7D27\u5F20\u3002$l^\u4EB2\u7231\u7684\uFF0C\u4F60\u8EAB\u4E0A\u6709\u80A1\u751C\u5473\u3002\u5C31\u50CF\u5728\u590F\u65E5\u5FAE\u98CE\u4E2D\u6447\u66F3\u7684\u8089\u6842\u53F6\u3002",
    "Indoor_Night_Emily": "\u8FD9\u662F\u4E00\u4E2A\u975E\u5E38\u8212\u9002\u7684\u623F\u5B50\u2026\u2026\u6211\u559C\u6B22\u5B83\u3002",
    "Indoor_Night_Haley": "\u4EB2\u7231\u7684\uFF0C\u4F60\u770B\u8D77\u6765\u5E72\u4E86\u4E0D\u5C11\u6D3B\u554A\u3002\u8BA9\u6211\u5E2E\u4F60\u51CF\u51CF\u538B\u3002$l",
    "Indoor_Night_Harvey": "\u770B\u4E0A\u53BB\u4F60\u4ECA\u665A\u9700\u8981\u70B9\u6309\u6469\u3002$l#$e#\u8C28\u9075\u533B\u5631\u2026\u2026\u8FD9\u5BF9\u8840\u6DB2\u5FAA\u73AF\u6709\u597D\u5904\uFF01",
    "Indoor_Night_Krobus": "\u55E8\uFF0C@\u3002\u6B22\u8FCE\u56DE\u5BB6\u3002\u770B\u8D77\u6765\u4F60\u5E72\u6D3B\u633A\u8F9B\u82E6\u7684\uFF01$h",
    "Indoor_Night_Leah": "\u665A\u4E0A\u771F\u662F\u5B89\u5B81\u5E73\u9759\u554A\u3002\u6CA1\u6709\u4E1C\u897F\u6253\u6270\u4F60\u4EAB\u53D7\u751F\u6D3B\u7684\u4E50\u8DA3\u3002",
    "Indoor_Night_Maru": "\u662F\u51C6\u5907\u4E0A\u5E8A\u4E86\u5417\uFF0C@\u3002\u8981\u4E0D\u8981\u6211\u8BB2\u4E9B\u6211\u6700\u65B0\u9879\u76EE\u7684\u6280\u672F\u7EC6\u8282\u6765\u50AC\u4F60\u5165\u7761\uFF1F$h#$e#*\u54C8\u6B20*\u2026\u2026\u8BF4\u5B9E\u8BDD\uFF0C\u6211\u4E5F\u6709\u70B9\u56F0\u4E86\u3002",
    "Indoor_Night_Penny": "\u55E8\uFF0C\u751C\u5FC3\u3002\u51C6\u5907\u597D\u5728\u5BB6\u5EA6\u8FC7\u5E73\u9759\u7684\u591C\u665A\u4E86\u5417\uFF1F",
    "Indoor_Night_Sam": "#$c .5#\u4E0D\u77E5\u9053\u4ECA\u5929\u80FD\u4E0D\u80FD\u770B\u5230\u6708\u4EAE\u5462\uFF1F#$e#\u5BF9\u4E86\uFF0C\u4ECA\u5929\u6240\u6709\u7684\u519C\u6D3B\u4F60\u90FD\u505A\u5B8C\u4E86\u5417\uFF1F\u5C31\u7B97\u6CA1\u6709\u6211\u4E5F\u4E0D\u4F1A\u751F\u6C14\u5566\u3002",
    "Indoor_Night_Sebastian": "#$c .5#\u6211\u53EF\u80FD\u662F\u4E2A\u4E0E\u4E16\u9694\u7EDD\u7684\u4EBA\uFF0C\u4F46\u4F60\u5728\u6211\u7684\u8EAB\u65C1\u6211\u5C31\u4F1A\u5F88\u5E78\u798F\u3002$h#$e#\u55E8\uFF0C@\u3002\u771F\u9AD8\u5174\u770B\u5230\u4F60\u3002\u6709\u4F60\u5728\u6211\u5C31\u5B89\u5FC3\u4E86\u3002$h",
    "Indoor_Night_Shane": "\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u5B9E\u9645\u4E0A\u6211\u8FC7\u5F97\u76F8\u5F53\u597D\u3002",
    "Neutral_0": "\u7B49\u5230\u6211\u767D\u53D1\u82CD\u82CD\uFF0C\u6211\u5E0C\u671B\u4F60\u8FD8\u4F1A\u559C\u7231\u6211\u3002$s",
    "Neutral_1": "\u4F60\u89C9\u5F97\u7237\u7237\u4F1A\u4E3A\u6211\u4EEC\u505A\u7684\u4E8B\u611F\u5230\u9A84\u50B2\u5417\uFF1F",
    "Neutral_2": "\u5728\u4F11\u606F\u5417\uFF1F\u6211\u731C\u5F53\u4E00\u540D\u519C\u592B\u8981\u6BD4\u6211\u60F3\u7684\u7B80\u5355\u2026\u2026",
    "Neutral_3": "\u8981\u662F\u4F60\u53BB\u9547\u5B50\u91CC\uFF0C\u8BB0\u5F97\u66FF\u6211\u5411\u5927\u5BB6\u6253\u4E2A\u62DB\u547C\u3002",
    "Neutral_4": "\u660E\u65E9\u4F60\u8D77\u6765\u4E4B\u524D\u6211\u4F1A\u628A\u8863\u670D\u6D17\u4E86\u2026\u2026\u8FD9\u6837\u4F60\u5C31\u53EF\u4EE5\u4E13\u5FC3\u52B3\u4F5C\u4E86\u3002",
    "Neutral_5": "\u5BB6\u91CC\u662F\u4E0D\u662F\u6709\u4E9B\u62EE\u636E\uFF0C@\uFF1F",
    "Neutral_6": "\u4E0D\u77E5\u9053\u9547\u91CC\u7684\u670B\u53CB\u4EEC\u4ECA\u5929\u4F1A\u505A\u4E9B\u4EC0\u4E48\u5462\uFF1F",
    "Neutral_7": "\u4ECA\u5929\u6211\u771F\u7684\u4EC0\u4E48\u90FD\u4E0D\u60F3\u505A\u3002",
    "Neutral_8": "\u4E0D\u7BA1\u6211\u600E\u4E48\u6253\u626B\uFF0C\u623F\u5B50\u8FD8\u662F\u4F1A\u53D8\u810F\u3002#$e#\u4E5F\u8BB8\u662F\u519C\u573A\u672C\u6765\u5C31\u633A\u810F\u7684\u5427\u3002",
    "Neutral_9": "\u4E0D\u77E5\u9053\u6211\u4EEC\u8FD9\u8F88\u5B50\u4F1A\u4E0D\u4F1A\u4E00\u76F4\u4F4F\u5728\u8FD9\u91CC\uFF1F",
    "NoBed_0": "\u6211\u8BE5\u7761\u5728\u54EA\u2026\u2026\uFF1F$s",
    "NoBed_1": "\u6211\u6628\u665A\u6CA1\u7761\u597D\u2026\u2026$s",
    "NoBed_2": "\u6211\u6628\u665A\u53EA\u80FD\u7761\u5728\u5730\u4E0A\u2026\u2026$s",
    "NoBed_3": "\u6211\u4EEC\u7684\u5E8A\u600E\u4E48\u4E86\u2026\u2026\uFF1F$s",
    "OneKid_0": "\u4F60\u4ECA\u5929\u6709\u82B1\u65F6\u95F4\u966A%kid1\u73A9\u800D\u5417\uFF1F",
    "OneKid_1": "\u4E0D\u77E5\u9053%kid1\u5C06\u6765\u4F1A\u4E0D\u4F1A\u50CF\u4F60\u4E00\u6837\u6210\u4E3A\u519C\u592B\u5462\uFF1F",
    "OneKid_2": "\u522B\u62C5\u5FC3\uFF0C\u4ECA\u5929\u6211\u6765\u5582%kid1\u3002\u4F60\u5C31\u4E13\u5FC3\u7ECF\u8425\u519C\u573A\u5427\u3002",
    "OneKid_3": "\u81EA\u4ECE\u6211\u4EEC\u6709\u4E86\u5B69\u5B50\u540E\uFF0C\u751F\u6D3B\u5C31\u5927\u4E0D\u76F8\u540C\u4E86\u3002",
    "Outdoor_0": "\u4ECA\u5929\u5929\u6C14\u4E0D\u9519\uFF0C\u5BF9\u5427\uFF1F$h#$e#\u8FD9\u79CD\u5929\u6C14\u4F1A\u8BA9\u5DE5\u4F5C\u66F4\u60EC\u610F\u3002",
    "Outdoor_1": "\u6211\u4ECA\u5929\u5C31\u653E\u677E\u4E00\u4E0B\uFF0C\u63A5\u7740\u68C0\u89C6\u519C\u573A\u600E\u4E48\u6837\uFF1F#$e#\u8FD9\u4E00\u5E26\u98CE\u666F\u771F\u662F\u4E0D\u9519\u5462\u3002$h",
    "Outdoor_2": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u8981\u662F\u6211\u591A\u61C2\u4E9B\u8015\u79CD\u7684\u77E5\u8BC6\uFF0C\u6211\u4E00\u5B9A\u4F1A\u591A\u5E2E\u5E2E\u4F60\u7684\u3002\u5BF9\u4E0D\u8D77\uFF01#$e#\u6211\u4F1A\u4E00\u76F4\u60F3\u7740\u4F60\u7684\u3002$h",
    "Outdoor_3": "\u6211\u5C31\u5728\u8FD9\u626B\u626B\u7070\u3002\u8FD9\u4F1A\u5E2E\u5230\u4F60\u5427\uFF1F#$e#*\u547C*\u2026\u2026\u8FD9\u513F\u8FD8\u771F\u70ED\u554A\u3002",
    "Outdoor_4": "\u4EB2\u7231\u7684\uFF0C\u522B\u7D2F\u7740\u81EA\u5DF1\u4E86\u3002#$e#\u8BB0\u5F97\u4E0D\u65F6\u5730\u4F11\u606F\u4E00\u4E0B\uFF0C\u6216\u8005\u5403\u70B9\u4E1C\u897F\u3002$h",
    "Outdoor_Abigail": "\u6211\u5C31\u5728\u8FD9\u901B\u901B\uFF0C\u53EF\u4EE5\u5417\uFF1F#$e#\u8FD9\u513F\u6709\u8BB8\u591A\u6709\u8DA3\u7684\u866B\u5B50\u548C\u5C0F\u4E1C\u897F\u3002*\u8F7B\u7B11*$h",
    "Outdoor_Alex": "\u6211\u4ECA\u5929\u8981\u505A\u5F88\u591A\u8FD0\u52A8\uFF01\u54C8\u54C8\uFF01\u6211\u7231\u519C\u573A\u7684\u751F\u6D3B\u3002$h",
    "Outdoor_Elliott": "\u4ECA\u5929\uFF0C\u6211\u8981\u7EE7\u7EED\u5199\u6211\u7684\u65B0\u5C0F\u8BF4\u3002\u8FD8\u6709\u6BD4\u6211\u4EEC\u7684\u519C\u573A\u66F4\u597D\u7684\u5730\u65B9\u5417\uFF1F$h#$e#\u8FD9\u91CC\u7B80\u76F4\u5B8C\u7F8E\u3002$l",
    "Outdoor_Emily": "@\uFF0C\u4F60\u505A\u5F97\u5F88\u597D\u3002\u575A\u6301\u4E0B\u53BB\u3002",
    "Outdoor_Haley": "\u751C\u5FC3\uFF0C\u4F60\u4E0D\u89C9\u5F97\u4ECA\u5929\u662F\u4E2A\u6652\u592A\u9633\u7684\u597D\u65E5\u5B50\u5417\uFF1F$h",
    "Outdoor_Harvey": "\u8FD9\u8981\u6BD4\u6574\u5929\u7A9D\u5728\u8BCA\u6240\u91CC\u597D\u591A\u4E86\u3002$l#$e#\u6211\u8FD8\u7231\u770B\u4F60\u8015\u79CD\u7684\u6837\u5B50\u2026\u2026\u5475\u5475\u3002",
    "Outdoor_Krobus": "\u53EA\u8981\u662F\u8FD9\u6837\u7684\u5929\u6C14\uFF0C\u6211\u5C31\u53EF\u4EE5\u548C\u4F60\u4E00\u8D77\u4EAB\u53D7\u6237\u5916\u751F\u6D3B\u3002\u8FD9\u53EF\u771F\u68D2\uFF01$h#$b#\u53EA\u8981\u4F60\u770B\u5230\u6709\u4EBA\u6765\u5C31\u544A\u8BC9\u6211\uFF0C\u8FD9\u6837\u6211\u5C31\u53EF\u4EE5\u8EB2\u8D77\u6765\u4E86\u3002$u",
    "Outdoor_Leah": "\u54C7\uFF0C\u592A\u68D2\u4E86\uFF01\u6211\u5F00\u59CB\u559C\u6B22\u4E0A\u519C\u573A\u7684\u751F\u6D3B\u4E86\uFF0C@\u3002$h#$e#\u8FD9\u7B80\u76F4\u5C31\u662F\u6211\u68A6\u5BD0\u4EE5\u6C42\u7684\u751F\u6D3B\u554A\u3002$l",
    "Outdoor_Maru": "\u6211\u559C\u6B22\u5446\u5728\u8FD9\u5916\u9762\u3002\u8FD9\u662F\u4E2A\u601D\u8003\u65B0\u53D1\u660E\u7684\u597D\u5730\u65B9\u3002$h#$e#\u6211\u8FD8\u5728\u60F3\u80FD\u5E2E\u4F60\u5206\u62C5\u4E9B\u5DE5\u4F5C\u7684\u70B9\u5B50\u3002",
    "Outdoor_Penny": "\u6211\u5728\u6211\u4EEC\u7684\u5C0F\u519C\u573A\u91CC\u5341\u5206\u5E78\u798F\uFF0C@\u3002$h",
    "Outdoor_Sam": "\u563F\uFF0C\u751C\u5FC3\uFF0C\u4F60\u770B\u5929\u4E0A\u90A3\u84EC\u677E\u7684\u4E91\u6735\uFF01$h#$e#\u4F60\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\u6211\u5C31\u5728\u8FD9\u513F\u591A\u770B\u4E00\u4F1A\u513F\u3002",
    "Outdoor_Sebastian": "\u8FD9\u548C\u6211\u4EE5\u524D\u7684\u751F\u6D3B\u5927\u4E0D\u76F8\u540C\uFF0C\u4F46\u6211\u771F\u7684\u5F00\u59CB\u7231\u4E0A\u8FD9\u91CC\u4E86\u3002$h#$e#\u6211\u89C9\u5F97\u6211\u771F\u7684\u5C5E\u4E8E\u8FD9\u91CC\u3002$l",
    "Outdoor_Shane": "\u6211\u4E0D\u77E5\u9053\u5982\u679C\u6211\u7684\u80BA\u80FD\u5904\u7406\u8FD9\u6837\u7684\u65B0\u9C9C\u3002\u6211\u6BD4\u8F83\u4E60\u60EF Joja \u7A7A\u6C14\u3002",
    "Rainy_Day_0": "\u5916\u9762\u4E0B\u96E8\u4E86\u3002\u4EB2\u7231\u7684\uFF0C\u5C0F\u5FC3\u522B\u611F\u5192\u54E6\u3002#$e#\u5C3D\u91CF\u5F85\u5728\u5C4B\u91CC\u5427\u3002$h#$e#\u6709\u65F6\u5019\u771F\u662F\u62C5\u5FC3\u4F60\u554A\uFF01",
    "Rainy_Day_1": "\u4E0B\u96E8\u4E86\uFF01\u6240\u4EE5\u4ECA\u5929\u6211\u4EEC\u5C31\u4E0D\u7528\u704C\u6E89\u4E86\u5462\u3002$h#$e#\u5927\u81EA\u7136\u6709\u65F6\u5019\u4E5F\u80FD\u5E2E\u5927\u5FD9\u5462\u3002#$e#\u4EB2\u7231\u7684\uFF0C\u4F60\u5582\u52A8\u7269\u4E86\u5417\uFF1F",
    "Rainy_Day_2": "\u65E9\u554A\uFF01\u6211\u4E00\u65E9\u5C31\u88AB\u96E8\u58F0\u5F04\u9192\u4E86\uFF0C\u6211\u8FD8\u7ED9\u4F60\u505A\u4E86\u4E9B\u65E9\u996D\u3002[194 195 210 211 216]#$e#\u522B\u51BB\u7740\u4E86\uFF0C\u4E5F\u4E0D\u7528\u5DE5\u4F5C\u90A3\u4E48\u8F9B\u82E6\u3002\u6211\u5E0C\u671B\u4F60\u5065\u5065\u5EB7\u5EB7\u7684\u3002",
    "Rainy_Day_3": "\u4EB2\u7231\u7684\uFF0C\u4ECA\u5929\u4F60\u6709\u4EC0\u4E48\u5B89\u6392\u5417\uFF1F#$e#\u8FD9\u79CD\u5929\u6C14\u6211\u53EF\u4E0D\u60F3\u51FA\u53BB\u2026\u2026\u6211\u5C31\u5728\u5BB6\u91CC\u5FD9\u6D3B\u5427\u3002#$e#\u8981\u4E0D\u665A\u9910\u5C31\u505A\u70B9\u70ED\u4E4E\u7684\u5427\u3002",
    "Rainy_Day_4": "\u4ECA\u665A\u60F3\u5403\u70B9\u4EC0\u4E48\uFF1F",
    "Rainy_Day_Abigail": "\u90CA\u5916\u7684\u666F\u8272\u5728\u8FD9\u79CD\u5929\u6C14\u4E0B\u5E94\u8BE5\u4F1A\u66F4\u6709\u8DA3\uFF0C\u4F60\u4E0D\u89C9\u5F97\u5417\uFF1F",
    "Rainy_Day_Alex": "\u55EF\u2026\u2026\u770B\u6765\u6211\u4ECA\u5929\u53EA\u80FD\u5728\u5BA4\u5185\u505A\u4FEF\u5367\u6491\u548C\u4EF0\u5367\u8D77\u5750\u4E86\u3002",
    "Rainy_Day_Elliott": "\u96E8\u5929\u53C8\u8BA9\u6211\u56DE\u60F3\u8D77\u4EE5\u524D\u5728\u6D77\u8FB9\u7684\u65E5\u5B50\u4E86\u3002#$e#\u6CA1\u5173\u7CFB\uFF0C\u6539\u53D8\u4E5F\u662F\u751F\u6D3B\u7684\u4E00\u90E8\u5206\u3002",
    "Rainy_Day_Emily": "\u6211\u77E5\u9053\u4F60\u4E3A\u81EA\u5DF1\u7684\u5DE5\u4F5C\u611F\u5230\u81EA\u8C6A\uFF0C\u4F46\u4E0D\u8981\u592A\u8FC7\u3002\u597D\u5427\uFF0C\u4EB2\u7231\u7684\uFF1F$u",
    "Rainy_Day_Haley": "\u54FC~~~\u8FD9\u5929\u6C14\u518D\u8FD9\u4E48\u4E0B\u53BB\uFF0C\u76AE\u80A4\u90FD\u8981\u53D8\u6210\u60E8\u767D\u8272\u4E86\u3002$s",
    "Rainy_Day_Harvey": "\u4EB2\u7231\u7684\uFF0C\u5343\u4E07\u522B\u6DCB\u96E8\u54E6\u3002\u6211\u53EF\u4E0D\u60F3\u8BA9\u4F60\u51BB\u7740\u4E86\u3002",
    "Rainy_Day_Krobus": "\u554A\uFF0C\u4ECA\u5929\u4E0B\u4E86\u96E8\uFF0C\u7A7A\u6C14\u66F4\u6F6E\u6E7F\u4E86\u2026\u2026\u6211\u611F\u89C9\u66F4\u52A0\u8212\u670D\u4E86\u3002",
    "Rainy_Day_Leah": "\u4ECA\u5929\u8981\u4E0D\u8981\u53BB\u9493\u4E2A\u9C7C\u6216\u6316\u4E2A\u77FF\u554A\uFF1F",
    "Rainy_Day_Maru": "\u867D\u7136\u73B0\u5728\u6280\u672F\u5F88\u53D1\u8FBE\uFF0C\u4F46\u96E8\u5929\u8FD8\u662F\u704C\u6E89\u4F5C\u7269\u6700\u597D\u7684\u5DE5\u5177\u3002",
    "Rainy_Day_Penny": "\u6211\u770B\u6211\u4ECA\u5929\u5C31\u70E4\u4E9B\u4E1C\u897F\u5403\u5427\u3002$h",
    "Rainy_Day_Sam": "\u4ECA\u5929\u6211\u53EF\u80FD\u5F97\u82B1\u65F6\u95F4\u4FEE\u8865\u4E00\u4E0B\u5C4B\u9876\u7684\u6F0F\u6D1E\u548C\u7A97\u6237\u3002",
    "Rainy_Day_Sebastian": "\u5929\u8FD8\u6CA1\u4EAE\u6211\u5C31\u8D77\u6765\u4E86\uFF0C\u7136\u540E\u5728\u519C\u573A\u91CC\u8F6C\u4E86\u4F1A\u513F\u3002\u9ECE\u660E\u524D\u7684\u519C\u573A\u771F\u662F\u5E73\u9759\u554A\u3002",
    "Rainy_Day_Shane": "\u5C4B\u9876\u6F0F\u6C34\uFF1F\u5514\u2026\u2026\u4E00\u70B9\u9709\u83CC\u4E5F\u65E0\u5173\u7D27\u8981\u3002",
    "Rainy_Night_0": "\u8FD9\u96E8\u8BA9\u6211\u89C9\u5F97\u4E16\u4E0A\u597D\u50CF\u53EA\u5269\u6211\u4EEC\u4E24\u4E2A\u4EBA\u3002$l#$e#\u6211\u597D\u51B7\u554A\u2026\u2026\u4F60\u4E0D\u6253\u7B97\u94BB\u8FDB\u88AB\u7A9D\u5417\uFF1F$l",
    "Rainy_Night_1": "\u8BB0\u5F97\u7A7F\u539A\u70B9\u3002\u6211\u4E0D\u5E0C\u671B\u4F60\u751F\u75C5\u3002#$e#\u4F60\u80FD\u542C\u5230\u5C4B\u9876\u4E0A\u96E8\u6C34\u6EF4\u6EF4\u7B54\u7B54\u7684\u58F0\u97F3\u5417\uFF0C@\uFF1F",
    "Rainy_Night_2": "\u5934\u9876\u4F20\u6765\u8212\u5FC3\u7684\u96E8\u58F0\u2026\u2026\u4ECA\u665A\u53EF\u4EE5\u7761\u4E2A\u597D\u89C9\u4E86\u3002$h",
    "Rainy_Night_3": "\u4E0B\u96E8\u5929\u91CC\uFF0C\u6211\u4EEC\u7684\u5BB6\u770B\u8D77\u6765\u683C\u5916\u6E29\u99A8\u5462\u3002$h^\u5728\u8FD9\u6837\u7684\u96E8\u591C\uFF0C\u6211\u597D\u5E86\u5E78\u6211\u4EEC\u6709\u4E2A\u5B8C\u597D\u7684\u5C4B\u9876\u3002",
