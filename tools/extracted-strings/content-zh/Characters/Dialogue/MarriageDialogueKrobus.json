    "Indoor_Day_Krobus": "\u6211\u5F88\u5E0C\u671B\u80FD\u5230\u519C\u573A\u4E0A\u5E2E\u4F60\uFF0C\u4F46\u662F\u6211\u6CA1\u6CD5\u5446\u5728\u592A\u9633\u5E95\u4E0B\u2026\u2026",
    "Indoor_Night_0": "\u4ECA\u5929\u6211\u628A\u5C4B\u5B50\u91CC\u7684\u866B\u5B50\u90FD\u9664\u6389\u4E86\u2026\u2026\u62B1\u6B49\uFF0C\u4E00\u4E2A\u90FD\u6CA1\u7ED9\u4F60\u7559\uFF01\uFF08\u556A\uFF09$7",
    "Indoor_Night_1": "\u4F60\u5F88\u7ED3\u5B9E\u7684\u6837\u5B50\u2026\u2026\u6709\u65F6\u6211\u4E5F\u4F1A\u60F3\uFF0C\u8981\u662F\u6211\u4E5F\u6709\u9AA8\u5934\u5C31\u597D\u4E86\u2026\u2026$s",
    "Indoor_Night_2": "\u6709\u65F6\u6211\u4F1A\u6000\u7591\u4EBA\u7C7B\u548C\u6697\u5F71\u4EBA\u662F\u5426\u771F\u7684\u80FD\u591F\u5171\u5B58\u2026\u2026\u60F3\u6CD5\u542C\u8D77\u6765\u5F88\u68D2\uFF0C\u4F46\u662F\u8FD9\u7B26\u5408\u5B9E\u9645\u5417\uFF1F$s#$e#\u6211\u5E0C\u671B\u5982\u6B64\u2026\u2026",
    "Indoor_Night_3": "\u6709\u65F6\u6211\u4F1A\u505C\u4E0B\u6765\uFF0C\u56DE\u60F3\u6211\u4ECE\u4F60\u8FD9\u91CC\u4E86\u89E3\u7684\u4EBA\u7C7B\u7684\u4E8B\u60C5\u2026\u2026#$b#\u8981\u662F\u6211\u4EEC\u540C\u65CF\u7684\u6697\u5F71\u4EBA\u90FD\u80FD\u7406\u89E3\u8FD9\u79CD\u611F\u53D7\u8BE5\u6709\u591A\u597D\u3002",
    "Indoor_Night_4": "\u6211\u60F3\u5C3D\u53EF\u80FD\u597D\u5730\u4E0E\u4F60\u540C\u5C45\uFF0C\u4F46\u662F\u6211\u4E0D\u77E5\u9053\u6211\u505A\u7684\u662F\u4E0D\u662F\u591F\u597D\u2026\u2026\uFF08\u5495\u54DD\uFF09$s#$e#\u60F3\u8981\u7406\u89E3\u4EBA\u7C7B\u7684\u8868\u8FBE\u633A\u96BE\u7684\u3002\u4E0D\u2026\u2026\u4E0D\u8FC7\u2026\u2026\u4F60\u548C\u6211\u4E00\u8D77\u4F4F\u89C9\u5F97\u5F00\u5FC3\u5417\uFF1F#$e#\u597D\u7684\uFF01$7",
    "Indoor_Night_Krobus": "\u55E8\uFF0C@\u3002\u6B22\u8FCE\u56DE\u5BB6\u3002\u770B\u8D77\u6765\u4F60\u5E72\u6D3B\u633A\u8F9B\u82E6\u7684\uFF01$h",
    "Neutral_0": "\u6211\u4E0D\u4F1A\u53D8\u8001\uFF0C\u4F46\u662F\u4F60\u4F1A\u3002\u6709\u65F6\u8FD9\u4F1A\u8BA9\u6211\u6709\u70B9\u4F24\u611F\u2026\u2026\u4E0D\u8FC7\u4E5F\u4E0D\u662F\u4EC0\u4E48\u5927\u4E8B\u3002$s",
    "Neutral_1": "\u4F60\u89C9\u5F97\u4F60\u7237\u7237\u4F1A\u540C\u610F\u8BA9\u602A\u7269\u4F4F\u5728\u4ED6\u7684\u623F\u5B50\u91CC\u5417\uFF1F",
    "Neutral_2": "\u4F60\u89C9\u5F97\u6211\u4EEC\u540C\u4F4F\u4F1A\u60F9\u4E0A\u9EBB\u70E6\u5417\uFF1F$s",
    "Neutral_3": "\u8FD9\u91CC\u5934\u597D\u4EAE\u2026\u2026\u6211\u5F97\u95ED\u4E0A\u773C\u51E0\u4E2A\u5C0F\u65F6\u3002$s",
    "Neutral_4": "\u6211\u6CA1\u6CD5\u5916\u51FA\uFF0C\u6211\u5F88\u6311\u98DF\uFF0C\u6211\u5BF9\u6E29\u5EA6\u4E5F\u6709\u8981\u6C42\u2026\u2026\u4F46\u613F\u4F60\u8DDF\u6211\u540C\u4F4F\u65F6\u6CA1\u6709\u611F\u5230\u5F88\u70E6\u607C\uFF0C@\u3002$s",
    "Neutral_5": "\u7EF4\u5C14\u7EF4\u514B\u8BF4\u6211\u4ECA\u5929\u88AB\u8BC5\u5492\u4E86\u3002$s",
