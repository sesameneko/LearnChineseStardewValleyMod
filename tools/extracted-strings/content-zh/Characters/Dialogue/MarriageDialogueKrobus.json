    "Neutral_9": "\u6211\u4EEC\u4E00\u751F\u90FD\u4F1A\u4F4F\u5728\u8FD9\u91CC\u5417\uFF1F\u642C\u5BB6\u5BF9\u6211\u6765\u8BF4\u53EF\u80FD\u592A\u5371\u9669\u4E86\u3002",
    "OneKid_3": "\u7531\u5DF4\u7ED9\u8FD9\u95F4\u5C4B\u5B50\u8D50\u4E0B\u4E86\u4E00\u4E2A\u201C\u5B69\u5B50\u201D\u7684\u795D\u798F\uFF0C\u4E0D\u8FC7\u6211\u4E0D\u77E5\u9053\u662F\u600E\u4E48\u6837\u2026\u2026",
    "Outdoor_0": "\u6211\u4F1A\u5728\u5916\u9762\u5446\u4E00\u4F1A\u513F\uFF0C\u4F46\u662F\u8FD8\u662F\u5F97\u5C0F\u5FC3\u2026\u2026\u4E07\u4E00\u6709\u4EBA\u6765\u4E86\u6211\u5F97\u85CF\u8D77\u6765\uFF01",
    "Outdoor_1": "\u6211\u80FD\u5230\u5916\u9762\u6765\u771F\u662F\u7A00\u7F55\uFF01",
    "Outdoor_2": "\u5929\u6C14\u771F\u597D\uFF01$h",
    "Outdoor_3": "\u5728\u5F00\u9614\u7684\u7A7A\u95F4\u91CC\u6211\u4F1A\u7D27\u5F20\u2026\u2026$s",
    "Outdoor_4": "\u4F60\u53BB\u5FD9\u7740\uFF0C\u6211\u8FD8\u662F\u5446\u5728\u8FD9\u91CC\u770B\u7740\u623F\u5B50\u5427\u3002",
    "Outdoor_Krobus": "\u6211\u4F1A\u5728\u8FD9\u91CC\u7B49\u7740\uFF0C\u770B\u770B\u6709\u6CA1\u6709\u866B\u5B50\u8FC7\u6765\u3002#$e#\u6211\u8FD8\u6CA1\u5403\u65E9\u996D\u5462\uFF01",
    "Rainy_Day_0": "\u6211\u5F88\u559C\u6B22\u96E8\u5929\uFF0C\u4F60\u5462\uFF0C@\uFF1F",
    "Rainy_Day_1": "\u6211\u4EEC\u5404\u65B9\u9762\u90FD\u4E0D\u592A\u4E00\u6837\u5462\u2026\u2026\u4E0D\u8FC7\u8FD9\u4E0D\u8981\u7D27\u3002",
    "Rainy_Day_2": "\u65E9\u4E0A\u597D\uFF0C@\u3002\u6211\u65E9\u8D77\u51FA\u95E8\u7ED9\u4F60\u627E\u5230\u4E86\u8FD9\u4E2A\u3002[305 308 203 795 397]#$e#\u5E0C\u671B\u8FD9\u4E1C\u897F\u4E0D\u4F1A\u592A\u5947\u602A\u3002",
    "Rainy_Day_3": "\u4E0D\u77E5\u9053\u6CD5\u5E08\u662F\u4E0D\u662F\u77E5\u9053\u2026\u2026\u8FD9\u4E2A\uFF1F\u6211\u5E0C\u671B\u4ED6\u80FD\u4FDD\u5BC6\u3002$s",
    "Rainy_Day_4": "\u5C3D\u7BA1\u6211\u52AA\u529B\u8BA9\u81EA\u5DF1\u4FDD\u6301\u793C\u8C8C\uFF0C\u6709\u65F6\u6211\u8FD8\u662F\u6709\u6076\u4F5C\u5267\u7684\u51B2\u52A8\u2026\u2026$6#$e#\u4ED6\u4EEC\u8BF4\u8FD9\u662F\u6211\u79CD\u65CF\u7684\u901A\u75C5\u3002",
    "Rainy_Day_Krobus": "\u554A\uFF0C\u4ECA\u5929\u4E0B\u4E86\u96E8\uFF0C\u7A7A\u6C14\u66F4\u6F6E\u6E7F\u4E86\u2026\u2026\u6211\u611F\u89C9\u66F4\u52A0\u8212\u670D\u4E86\u3002",
    "Rainy_Night_0": "\u5728\u8FD9\u6837\u7684\u591C\u665A\uFF0C\u5411\u7A97\u5916\u773A\u671B\u7684\u4EBA\u6709\u65F6\u4F1A\u770B\u89C1\u5F71\u5B50\u4E00\u6837\u7684\u4EBA\u5F62\u3002\u4ED4\u7EC6\u60F3\u60F3\u2026\u2026\u5927\u6982\u662F\u6211\u5427\u3002$7",
    "Rainy_Night_1": "\u5047\u5982\u522B\u7684\u6697\u5F71\u4EBA\u542C\u5230\u6211\u4EEC\u7684\u5C45\u4F4F\u65B9\u5F0F\uFF0C\u4ED6\u4EEC\u4F1A\u2026\u2026\u201C\u60E9\u7F5A\u201D\u6211\u7684\u3002$s#$e#\u8981\u77E5\u9053\uFF0C\u4ED6\u4EEC\u5927\u591A\u770B\u4E0D\u8D77\u4EBA\u7C7B\u3002",
    "Rainy_Night_2": "\u4F60\u6E7F\u900F\u4E86\uFF0C\u8FD8\u51B0\u51C9\u51B0\u51C9\u7684\uFF01\u8FD9\u5BF9\u4F60\u4EEC\u7684\u79CD\u65CF\u6765\u8BF4\u4E0D\u662F\u5F88\u5371\u9669\u5417\uFF1F$s",
    "Rainy_Night_3": "\u6211\u5DF2\u7ECF\u5403\u8FC7\u665A\u9910\u4E86\uFF0C\u4E0D\u8FC7\u90A3\u4E9B\u4E0D\u662F\u4F60\u80FD\u5403\u7684\u4E1C\u897F\u2026\u2026\u62B1\u6B49\u3002",
    "Rainy_Night_4": "\u81EA\u4ECE\u6211\u79BB\u5F00\u6211\u4EEC\u4E00\u65CF\u4E4B\u540E\uFF0C\u6211\u4E00\u76F4\u5728\u5BFB\u627E\u4E00\u4E2A\u65B0\u5BB6\u2026\u2026\u73B0\u5728\u6211\u6709\u5F52\u5C5E\u4E86\u3002\u8FD9\u5BF9\u6211\u6765\u8BF4\u5C31\u662F\u4E00\u5207\u3002",
    "Rainy_Night_5": "\u542C\u8BF4\u5F88\u4E45\u4EE5\u524D\u53D1\u751F\u4E86\u4E00\u573A\u5DE8\u5927\u7684\u707E\u96BE\uFF0C\u5E7D\u7075\u90FD\u80FD\u4ECE\u865A\u7A7A\u7A7F\u5165\u7269\u8D28\u4E16\u754C\u3002\u6211\u4EEC\u4E00\u65CF\u5C31\u662F\u90A3\u4E2A\u65F6\u5019\u6765\u5230\u8FD9\u91CC\u7684\u3002",
    "Rainy_Night_Krobus": "\u96E8\u70B9\u7684\u58F0\u97F3\u8BA9\u6211\u60F3\u8D77\u4E86\u4E0B\u6C34\u9053\u2026\u2026\u90A3\u91CC\u771F\u7684\u5F88\u8212\u9002\u3002#$e#\u4E0B\u6C34\u9053\u66FE\u662F\u6211\u7684\u907F\u96BE\u6240\u2026\u2026\u6211\u5728\u90A3\u91CC\u6709\u5B89\u5168\u611F\u3002\u4E0D\u8FC7\u522B\u62C5\u5FC3\u2026\u2026\u6211\u5728\u65B0\u5BB6\u91CC\u4E5F\u662F\u540C\u6837\u7684\u611F\u53D7\u3002",
    "TwoKids_0": "\u522B\u62C5\u5FC3\u2026\u2026\u6211\u5DF2\u7ECF\u7ED9%kid1\u548C%kid2\u505A\u4E86\u865A\u7A7A\u714E\u86CB\u5377\u3002",
