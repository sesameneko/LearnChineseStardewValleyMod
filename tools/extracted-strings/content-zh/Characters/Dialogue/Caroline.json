    "summer_Sun": "\u4ECA\u5929\u6211\u8981\u653E\u677E\u4E00\u4E0B\uFF0C\u5404\u79CD\u70E6\u607C\u653E\u4E0B\uFF0C\u8FC7\u4E00\u5929\u79EF\u6781\u7684\u751F\u6D3B\u3002#$e#\u4F60\u7ED9\u81EA\u5DF1\u653E\u8FC7\u5047\u5417\uFF1F",
    "summer_Tue": "\u6211\u6700\u8FD1\u5728\u68EE\u6797\u91CC\u89C1\u8FC7\u91CE\u679C\u3002#$e#\u91C7\u96C6\u5C71\u8D27\u662F\u6323\u94B1\u7684\u597D\u65B9\u6CD5\u3002\u4F60\u4E5F\u53EF\u4EE5\u628A\u4F60\u627E\u5230\u7684\u4E1C\u897F\u5F53\u4F5C\u793C\u7269\u9001\u4EBA\u6216\u8005\u81EA\u5DF1\u7559\u7740\u5403\u4E86\u3002",
    "summer_Wed": "\u55E8\u3002\u4F60\u519C\u573A\u91CC\u7684\u4E1C\u897F\u90FD\u7F6E\u529E\u9F50\u4E86\u5417\uFF1F#$e#\u5982\u679C\u8FD8\u7F3A\u4EC0\u4E48\u7684\u8BDD\uFF0C\u5C3D\u7BA1\u6765\u627E\u6211\u4EEC\u5E2E\u5FD9\u3002#$e#\u6211\u4EEC\u4EC0\u4E48\u597D\u4E1C\u897F\u90FD\u6709\u3002",
    "summer_Wed6": "\u957F\u5927\u540E\uFF0C\u4F60\u5C31\u66F4\u5BB9\u6613\u7406\u89E3\u4EC0\u4E48\u53EB\u65F6\u5149\u98DE\u901D\uFF0C\u65E5\u6708\u5982\u68AD\u4E86\u2026\u2026$s",
    "winter_Fri": "\u867D\u7136\u73B0\u5728\u5929\u6C14\u5F88\u51B7\u4E86\uFF0C\u53EF\u6211\u8FD8\u662F\u4F1A\u65F6\u4E0D\u65F6\u5730\u53BB\u68C0\u67E5\u4E0B\u516C\u5171\u82B1\u56ED\u3002#$e#\u6211\u8FD9\u4E48\u505A\u53EA\u662F\u4E3A\u4E86\u8BA9\u5B83\u4EEC\u5728\u6625\u5929\u5230\u6765\u4E4B\u524D\u4E0D\u4F1A\u51CB\u96F6\u3002",
    "winter_Sat": "\u4E0D\u89C9\u5F97\u963F\u6BD4\u76D6\u5C14\u53D1\u8272\u81EA\u7136\u7684\u65F6\u5019\u66F4\u597D\u770B\u5417\uFF1F#$e#\u5979\u7684\u5934\u53D1\u4E4B\u524D\u662F\u6D45\u6817\u8272\u7684\u3002",
    "winter_Tue": "\u51AC\u5929\u7684\u751F\u6D3B\u5F88\u8270\u96BE\uFF0C\u4E0D\u8FC7\u5E78\u8FD0\u7684\u8BDD\u8FD8\u662F\u53EF\u4EE5\u6316\u5230\u4E00\u4E9B\u690D\u7269\u7684\u6839\u3002#$e#\u91C7\u96C6\u5C71\u8D27\u662F\u6323\u94B1\u7684\u597D\u65B9\u6CD5\u3002\u4F60\u4E5F\u53EF\u4EE5\u628A\u4F60\u627E\u5230\u7684\u4E1C\u897F\u5F53\u4F5C\u793C\u7269\u9001\u4EBA\u6216\u8005\u81EA\u5DF1\u7559\u7740\u5403\u4E86\u3002",
    "winter_Wed6": "\u662F\u4E0D\u662F\u8FEB\u4E0D\u53CA\u5F85\u8981\u8FCE\u63A5\u65B0\u7684\u4E00\u5E74\u4E86\uFF1F#$e#\u6211\u76F8\u4FE1\u4F60\u7684\u519C\u573A\u4E00\u5B9A\u4F1A\u8D85\u6210\u529F\u7684\u3002$h",
    "wonGrange": "\u76AE\u57C3\u5C14\u4E4B\u524D\u5728\u661F\u9732\u8C37\u96C6\u5E02\u4E0A\u8F93\u7ED9\u4F60\uFF0C\u4ED6\u88C5\u4F5C\u4E0D\u5728\u610F\uFF0C\u5176\u5B9E\u8FD8\u803F\u803F\u4E8E\u6000\u5462\u3002"
  }
}