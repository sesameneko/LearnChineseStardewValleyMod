    "Bad_3": "\u6211\u505A\u9519\u4EC0\u4E48\u4E86\u5417\uFF1F\u4F60\u6700\u8FD1\u7684\u53CD\u5E94\u4E0D\u592A\u4E00\u6837\u3002$s",
    "Bad_4": "\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\u5916\u9762\u8FD8\u6709\u4EC0\u4E48\u65B0\u4E8B\u7269\uFF1F$s",
    "Bad_5": "\u4F60\u4EE5\u524D\u90A3\u4E48\u6D6A\u6F2B\u2026\u2026\u5230\u5E95\u600E\u4E48\u4E86\uFF1F$s#$e#\u6211\u77E5\u9053\u81EA\u5DF1\u6CA1\u6709\u4EE5\u524D\u90A3\u4E48\u5E74\u8F7B\u4E86\u2026\u2026\u96BE\u9053\u4F60\u548C\u6211\u7ED3\u5A5A\u5C31\u662F\u4E3A\u4E86\u6211\u5F53\u65F6\u7684\u5E74\u8F7B\u8C8C\u7F8E\uFF1F$a",
    "Bad_6": "\u6211\u4EEC\u7684\u4EBA\u751F\u77ED\u6682\u2026\u2026\u5C31\u8FD9\u6837\u5B50\u5EA6\u8FC7\u771F\u7684\u597D\u5417\uFF1F$s",
    "Bad_7": "\u6211\u66FE\u7ECF\u662F\u4F60\u773C\u4E2D\u7684\u5B9D\u8D1D\u2026\u2026\u4F46\u73B0\u5728\uFF0C\u53EA\u6709\u505A\u987F\u70ED\u817E\u817E\u7684\u665A\u9910\u624D\u80FD\u8BA9\u4F60\u5BB9\u5FCD\u6211\u3002$s",
    "Bad_8": "\u6700\u8FD1\u4F60\u5BF9\u6211\u597D\u51B7\u6DE1\u2026\u2026$s",
    "Bad_9": "\u4E5F\u8BB8\u6211\u5E94\u8BE5\u66F4\u52AA\u529B\u4E9B\u3002$s",
    "Good_0": "\u4F4F\u5728\u8FD9\u91CC\uFF0C\u6211\u611F\u89C9\u5C31\u50CF\u50CF\u7AD9\u5728\u5C71\u9876\u4E00\u6837\u3002",
    "Good_1": "\u6211\u6709\u6CA1\u6709\u544A\u8BC9\u8FC7\u4F60\u2026\u2026\u4F60\u7B2C\u4E00\u6B21\u642C\u5230\u8FD9\u91CC\u7684\u65F6\u5019\uFF0C\u6211\u68A6\u5230\u8FC7\u6709\u4E00\u5929\u6211\u4EEC\u4F1A\u5728\u4E00\u8D77\u3002",
    "Good_2": "\u6709\u65F6\u5019\u5F88\u96BE\u4E0D\u76F8\u4FE1\u547D\u8FD0\u2026\u2026\u4E8B\u5B9E\u662F\u6211\u51B3\u5B9A\u642C\u5230\u8FD9\u91CC\uFF0C\u5E76\u627E\u5230\u4E86\u5F7C\u6B64\u3002#$b#\u5728\u4EFB\u4F55\u4E00\u4E2A\u70B9\u4E0A\u751F\u6D3B\u53EF\u80FD\u90FD\u4F1A\u53D8\u5F97\u5B8C\u5168\u4E0D\u540C\u3002",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u7CBE\u529B\u5145\u6C9B\uFF01$l^\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5F88\u7F8E\u3002$l",
    "Good_4": "\u55EF\u2026\u2026\u4F60\u4ECA\u5929\u7684\u5473\u9053\u5F88\u597D\u95FB\u3002",
    "Good_5": "\u6211\u521A\u521A\u5728\u6B23\u8D4F\u6211\u7684\u5A5A\u793C\u62A4\u8EAB\u7B26\u5462\u2026\u2026\u6211\u4F59\u751F\u90FD\u4F1A\u73CD\u60DC\u8FD9\u4E2A\u5B9D\u8D1D\u3002$l",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6709\u65F6\u6211\u603B\u4F1A\u62C5\u5FC3\u4F60\u8DCC\u5230\u77FF\u4E95\u91CC\u3002",
    "Good_7": "@\uFF1F\u6211\u53EA\u662F\u60F3\u8BF4\uFF0C\u6211\u8981\u611F\u8C22\u4F60\u4E3A\u6211\u4EEC\u4E00\u5BB6\u505A\u51FA\u7684\u5168\u90E8\u52AA\u529B\u3002$h",
    "Good_8": "\u522B\u62C5\u5FC3\u6211\u2026\u2026\u6211\u77E5\u9053\u4F60\u5728\u5916\u9762\u62C5\u8D1F\u7740\u8BB8\u591A\u8D23\u4EFB\u3002\u6211\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u6CA1\u4E8B\u7684\uFF01$l",
    "Good_9": "\u54E6\uFF0C\u6211\u5E76\u4E0D\u65E0\u804A\u2026\u2026\u6211\u53EA\u662F\u4EAB\u53D7\u6211\u4EEC\u6240\u62E5\u6709\u7684\u4E00\u5207\u3002#$e#\u751F\u6D3B\u867D\u6734\u7D20\uFF0C\u4F46\u6211\u5F88\u559C\u6B22\u3002$h",
    "Indoor_Day_0": "\u8FD9\u623F\u5B50\u6BD4\u6211\u65E7\u65E7\u7684\u5C0F\u6728\u5C4B\u597D\u591A\u4E86\uFF01\u6211\u4E0D\u60F3\u5FF5\u5B83\u3002",
    "Indoor_Day_1": "\u65E9\u4E0A\u597D\u554A\uFF0C@\u3002\u6211\u5728\u5916\u9762\u7684\u82B1\u76C6\u91CC\u79CD\u4E86\u8FD9\u4E9B\u2026\u2026[16 18 20 22 90 259 396 402]#$e#\u6211\u82B1\u4E86\u5F88\u591A\u5FC3\u601D\u6765\u79CD\u5B83\u3002\u597D\u597D\u4EAB\u53D7\u5427\u3002",
    "Indoor_Day_2": "\u8BB0\u4F4F\u7559\u610F\u5BFB\u627E\u91CE\u751F\u98DF\u7269\uFF01\u8FD9\u91CC\u6709\u5F88\u591A\u3002",
    "Indoor_Day_3": "\u6211\u5728\u60F3\u2026\u2026\u751F\u547D\u77ED\u6682\uFF0C\u4E0D\u80FD\u5403\u4E0D\u597D\u7684\u98DF\u7269\u3002\u5E78\u8FD0\u7684\u662F\uFF0C\u6211\u4EEC\u4F4F\u7684\u5730\u65B9\u5C31\u662F\u65B0\u9C9C\u852C\u83DC\u7684\u6700\u4F73\u4EA7\u5730\u4E4B\u4E00\uFF01#$e#\u6765\uFF0C\u6211\u4E3A\u4F60\u505A\u4E86\u5065\u5EB7\u7684\u6C99\u62C9\u3002[196]#$e#\u6211\u5F88\u60CA\u8BB6\u4F60\u7ADF\u7136\u4E0D\u8BA8\u538C\u6211\u505A\u7684\u6C99\u62C9\uFF01",
    "Indoor_Day_4": "\u65E9\u4E0A\u597D\u554A\uFF0C@\uFF01\u6211\u6CE1\u4E86\u4E9B\u5496\u5561\u3002[395]$h#$e#\u6CA1\u6709\u4E00\u676F\u70ED\u5496\u5561\uFF0C\u6211\u7684\u65E9\u4E0A\u5C31\u662F\u4E0D\u5B8C\u6574\u7684\u3002",
    "Indoor_Night_0": "\u665A\u4E0A\u8FD9\u4E2A\u65F6\u5019\u8BA9\u6211\u89C9\u5F97\u5F88\u6E34\u3002",
    "Indoor_Night_1": "\u65F6\u95F4\u7684\u6D41\u901D\u771F\u662F\u5FAE\u5999\u2026\u2026\u5373\u4F7F\u662F\u6700\u5C0F\u7684\u51B3\u5B9A\u4E5F\u4F1A\u6C38\u8FDC\u5730\u6539\u53D8\u672A\u6765\u3002",
    "Indoor_Night_2": "\u8FD9\u91CC\u7684\u665A\u4E0A\u6BD4\u57CE\u5E02\u7684\u9713\u8679\u66F4\u5438\u5F15\u4EBA\u3002#$e#\u5BF9\u6211\u6765\u8BF4\u4E00\u5207\u90FD\u5F88\u5B8C\u7F8E\u3002\u6211\u5F88\u5E78\u8FD0\u3002",
    "Indoor_Night_3": "\u6211\u4ECE\u6CA1\u60F3\u5230\u8FC7\u6211\u642C\u6765\u8FD9\u91CC\u540E\u8FD9\u4E48\u5FEB\u5C31\u80FD\u6536\u5230\u7F8E\u4EBA\u9C7C\u540A\u5760\uFF01\u4F46\u662F\u6211\u5F88\u5F00\u5FC3\u3002$l",
    "Indoor_Night_4": "\u4ECA\u5929\u6211\u770B\u5230\u4E86\u4E00\u53EA\u91CE\u5154\u3002\u6211\u5E0C\u671B\u54EA\u4E00\u5929\u6211\u80FD\u517B\u4E00\u53EA\u3002\u5B83\u4EEC\u770B\u8D77\u6765\u5F88\u6E29\u548C\u2026\u2026",
    "Neutral_0": "\u7B49\u5230\u6211\u767D\u53D1\u82CD\u82CD\uFF0C\u6211\u5E0C\u671B\u4F60\u8FD8\u4F1A\u559C\u7231\u6211\u3002",
    "Neutral_1": "\u6211\u5728\u60F3\uFF0C\u5728\u6211\u4EEC\u6765\u4E4B\u524D\uFF0C\u8C01\u4F4F\u5728\u8FD9\u91CC\uFF1F",
    "Neutral_2": "\u4F60\u4ECA\u5929\u4E0D\u662F\u6709\u4E8B\u8981\u505A\u5417\uFF1F",
    "Neutral_3": "\u8981\u662F\u4F60\u53BB\u9547\u5B50\u91CC\uFF0C\u8BB0\u5F97\u66FF\u6211\u5411\u5927\u5BB6\u6253\u4E2A\u62DB\u547C\u3002",
    "Neutral_4": "\u660E\u65E9\u4F60\u8D77\u6765\u4E4B\u524D\u6211\u4F1A\u628A\u8863\u670D\u6D17\u4E86\u2026\u2026\u8FD9\u6837\u4F60\u5C31\u53EF\u4EE5\u4E13\u5FC3\u52B3\u4F5C\u4E86\u3002",
    "Neutral_5": "\u5BB6\u91CC\u662F\u4E0D\u662F\u6709\u4E9B\u62EE\u636E\uFF0C@\uFF1F",
    "Neutral_6": "\u4E0D\u77E5\u9053\u9547\u91CC\u7684\u670B\u53CB\u4EEC\u4ECA\u5929\u4F1A\u505A\u4E9B\u4EC0\u4E48\u5462\uFF1F",
    "Neutral_7": "\u4ECA\u5929\u6211\u771F\u7684\u4EC0\u4E48\u90FD\u4E0D\u60F3\u505A\u3002",
    "Neutral_8": "\u4E0D\u7BA1\u6211\u600E\u4E48\u6253\u626B\uFF0C\u623F\u5B50\u8FD8\u662F\u4F1A\u53D8\u810F\u3002#$e#\u4E5F\u8BB8\u662F\u519C\u573A\u672C\u6765\u5C31\u633A\u810F\u7684\u5427\u3002",
    "Neutral_9": "\u4E0D\u77E5\u9053\u6211\u4EEC\u8FD9\u8F88\u5B50\u4F1A\u4E0D\u4F1A\u4E00\u76F4\u4F4F\u5728\u8FD9\u91CC\uFF1F",
    "OneKid_3": "\u4E3A\u4EBA\u7236\u6BCD\u5F88\u6709\u8DA3\u3002\u6211\u8981\u786E\u4FDD%kid1\u957F\u5927\u540E\u559C\u6B22\u6237\u5916\u751F\u6D3B\u3002",
    "Outdoor_0": "\u51C9\u723D\u7684\u5FAE\u98CE\u8BA9\u4EBA\u5F88\u8212\u670D\u3002\u8FD9\u8BA9\u6211\u60F3\u8D77\u4E86\u4F4F\u5728\u6CB3\u8FB9\u7684\u65F6\u5149\u3002",
    "Outdoor_1": "\u55EF\u2026\u2026\u6211\u8981\u7EF4\u62A4\u4E00\u4E0B\u8FD9\u91CC\u3002\u6709\u65F6\u5019\u6211\u53EA\u662F\u5F88\u60F3\u6572\u6572\u6253\u6253\u3002",
    "Outdoor_2": "\u6211\u80FD\u611F\u89C9\u5230\uFF0C\u4ECA\u5929\u4F1A\u662F\u5F88\u7279\u522B\u7684\u4E00\u5929\u3002",
    "Outdoor_3": "\u554A\u2026\u2026\u65B0\u9C9C\u6CE5\u571F\u7684\u82AC\u82B3\u3002\u7B80\u76F4\u72EC\u4E00\u65E0\u4E8C\u3002$h#$e#\u8FD9\u91CC\u7684\u7A7A\u6C14\u660E\u663E\u5F88\u5E72\u51C0\u2026\u2026\u80BA\u91CC\u611F\u89C9\u5F88\u597D\u3002",
    "Outdoor_4": "\u4EB2\u7231\u7684\uFF0C\u522B\u7D2F\u7740\u81EA\u5DF1\u4E86\u3002#$e#\u8BB0\u5F97\u4E0D\u65F6\u5730\u4F11\u606F\u4E00\u4E0B\uFF0C\u6216\u8005\u5403\u70B9\u4E1C\u897F\u3002$h",
    "Rainy_Day_0": "\u6709\u65F6\u5019\u6211\u4F1A\u5728\u6700\u4E0D\u53EF\u80FD\u7684\u5730\u65B9\u627E\u5230\u7075\u611F\u3002",
    "Rainy_Day_1": "\u6211\u66FE\u4F4F\u5728\u57CE\u5E02\u7684\u65F6\u5019\uFF0C\u53D1\u73B0\u96E8\u5929\u8BA9\u4EBA\u6D88\u6C89\u3002\u4F46\u662F\u5728\u661F\u9732\u8C37\uFF0C\u96E8\u5929\u5F88\u7F8E\u3002",
    "Rainy_Day_2": "\u65E9\u554A\uFF01\u6211\u8D77\u5F97\u5F88\u65E9\uFF0C\u7136\u540E\u91C7\u4E86\u4E9B\u8611\u83C7\u3002\u6765\uFF0C\u62FF\u4E00\u4E2A\u53BB\u5427\u3002[281 404 420 257]#$e#\u5BFB\u627E\u8611\u83C7\u5C31\u50CF\u662F\u5728\u5BFB\u627E\u5B9D\u85CF\u4E00\u6837\u3002\u5F88\u6709\u8DA3\u3002$h",
    "Rainy_Day_3": "\u5728\u8FD9\u6837\u7684\u5929\u6C14\uFF0C\u6211\u5F88\u9AD8\u5174\u6211\u6709\u4E00\u53CC\u7ED3\u5B9E\u7684\u9774\u5B50\u3002$h",
    "Rainy_Day_4": "\u6811\u6797\u6025\u9700\u8FD9\u573A\u96E8\u2026\u2026\u6211\u5F88\u9AD8\u5174\u2026\u2026",
    "Rainy_Night_0": "\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u4F60\u5728\u8FD9\u91CC\u770B\u5230\u4EC0\u4E48\u52A8\u7269\u4E86\u5417\uFF1F",
    "Rainy_Night_1": "\u6211\u5E38\u5403\u6C99\u62C9\u2026\u2026\u4F46\u662F\u50CF\u8FD9\u6837\u96E8\u591C\u8BA9\u6211\u5F88\u60F3\u559D\u70B9\u513F\u70ED\u6C64\u3002$h",
    "Rainy_Night_2": "\u5728\u8FD9\u6837\u7684\u665A\u4E0A\u7761\u89C9\u5F88\u4EE4\u4EBA\u653E\u677E\u2026\u2026$l",
    "Rainy_Night_3": "\u4ECA\u5929\u6211\u523B\u4E86\u4E2A\u5C0F\u6728\u96D5\uFF0C\u4F46\u662F\u592A\u4E11\u4E86\uFF0C\u6240\u4EE5\u6211\u628A\u5B83\u70E7\u4E86\u3002$u#$e#\u6211\u8BA4\u4E3A\u8981\u6210\u4E3A\u4E00\u4E2A\u4F1F\u5927\u7684\u827A\u672F\u5BB6\uFF0C\u5FC5\u987B\u6279\u5224\u5BF9\u5F85\u5BF9\u81EA\u5DF1\u7684\u4F5C\u54C1\u3002",
    "Rainy_Night_4": "\u4F60\u56DE\u6765\u771F\u662F\u592A\u597D\u4E86\u2026\u2026\u4ECA\u665A\u5F88\u9002\u5408\u8EB2\u5728\u5C4B\u6A90\u4E0B\u53D6\u6696\u3002",
    "Rainy_Night_Leah": "\u4EB2\u7231\u7684\uFF0C\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u8EAB\u4E0A\u6CA1\u7C98\u4E0A\u6CE5\u5427\uFF1F",
    "TwoKids_3": "\u6211\u4EEC\u7684\u519C\u573A\u751F\u6D3B\u5F88\u7F8E\u597D\uFF0C\u5E76\u62E5\u6709\u4E00\u4E2A\u5B8C\u6574\u7684\u5BB6\u5EAD\u3002\u6211\u4EEC\u7684\u65B0\u751F\u6D3B\u5F88\u68D2\uFF0C\u5BF9\u5427\uFF1F",
    "fall_1": "\u6211\u559C\u6B22\u79CB\u5929\u91C7\u8611\u83C7\u3002\u5B83\u4EEC\u957F\u5F97\u5FEB\u4E5F\u53BB\u5F97\u5FEB\u3002",
    "fall_2": "\u6211\u77E5\u9053\u5728\u6536\u83B7\u5B63\u4F60\u5F88\u5FD9\u3002\u6211\u4F1A\u5C3D\u529B\u5E2E\u52A9\u4F60\u7684\u3002",
    "fall_20": "\u4F60\u5B89\u6392\u597D\u51AC\u5929\u7684\u8BA1\u5212\u4E86\u5417\uFF1F\u50A8\u85CF\u5E72\u8349\u5F88\u4E0D\u9519\u3002",
    "funLeave_Leah": "\u6211\u4ECA\u5929\u8981\u6563\u4E00\u4E0B\u6B65\u3002\u6211\u8981\u5230\u623F\u5B50\u5916\u9762\u53BB\u3002",
    "funReturn_Leah": "\u4ECA\u5929\u6211\u8FC7\u5F97\u8F7B\u677E\u6109\u5FEB\u3002\u4F60\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F",
    "patio_Leah": "\u4E0D\u8981\u9760\u592A\u8FD1\u53BB\u770B\uFF0C\u5B83\u8FD8\u53EA\u662F\u4E00\u4E2A\u534A\u6210\u54C1\u3002",
    "spring_1": "\u6628\u665A\u6572\u54CD\u65B0\u5E74\u7684\u949F\u58F0\u7684\u65B9\u5F0F\u8FD8\u771F\u7279\u522B\u2026\u2026$l",
    "spring_15": "*\u5509* \u2026\u2026\u770B\u6765\u53C8\u5230\u201C\u6625\u5B63\u5927\u626B\u9664\u201D\u7684\u65F6\u95F4\u4E86\u3002$s",
    "spring_2": "\u8BDD\u8BF4\uFF0C\u8FD9\u4E2A\u5B63\u5EA6\u6211\u4EEC\u79CD\u4E9B\u4EC0\u4E48\u5462\uFF1F",
    "summer_1": "\u554A\uFF0C\u590F\u5929\u2026\u2026\u6211\u5DF2\u7ECF\u80FD\u95FB\u5230\u6D46\u679C\u7684\u82B3\u9999\u4E86\u3002$h",
    "summer_2": "\u590F\u5929\u5230\u4E86\u2026\u2026\u4F30\u8BA1\u8981\u6EE1\u623F\u5B50\u82CD\u8747\u4E86\u3002#$e#\u522B\u62C5\u5FC3\uFF0C\u6211\u4F1A\u5904\u7406\u5B83\u4EEC\u7684\u3002",
    "summer_9": "\u5982\u679C\u6211\u8EAB\u4E0A\u6E7F\u6E7F\u7684\u90A3\u6211\u5F88\u62B1\u6B49\u2026\u2026\u4ECA\u665A\u70ED\u5F97\u6211\u5168\u8EAB\u5192\u6C57\u3002",
    "winter_1": "\u51AC\u5929\u4E86\uFF0C\u8FD9\u610F\u5473\u7740\u4F1A\u51FA\u73B0\u6C34\u6676\u679C\u3002\u5B83\u5473\u9053\u975E\u5E38\u72EC\u7279\uFF0C\u4F60\u4E0D\u89C9\u5F97\u5417\uFF1F",
    "winter_28": "\u563F\uFF0C%farm\u519C\u573A\u53C8\u5EA6\u8FC7\u4E86\u7F8E\u597D\u7684\u4E00\u5E74\uFF01\u6211\u4EEC\u4ECA\u665A\u5E86\u795D\u4E00\u4E0B\u5427\u3002[348]$h#$e#\u6211\u6709\u9884\u611F\u660E\u5E74\u4F1A\u66F4\u597D\u3002",
    "winter_7": "\u6211\u975E\u5E38\u671F\u5F85\u660E\u5929\u7684\u51B0\u96D5\u3002\u6211\u6BCF\u5E74\u53EA\u73A9\u4E00\u6B21\uFF0C\u4F46\u662F\u5F88\u6709\u8DA3\uFF01"
  }
