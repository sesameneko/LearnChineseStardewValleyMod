    "AcceptBirthdayGift_Negative": "\u554A\uFF01\u8FD9\u4E2A\u2026\u2026\u5443\uFF0C\u804A\u80DC\u4E8E\u65E0\u5427\u3002\u6211\u6CA1\u60F3\u5230\u4F1A\u6709\u4EBA\u77E5\u9053\u4ECA\u5929\u662F\u6211\u7684\u751F\u65E5\u3002",
    "AcceptBirthdayGift_Positive": "\u554A\uFF01\u975E\u5E38\u611F\u8C22\uFF01\u6211\u6CA1\u60F3\u5230\u4F1A\u6709\u4EBA\u77E5\u9053\u4ECA\u5929\u662F\u6211\u7684\u751F\u65E5\u3002$h",
    "AcceptGift_(O)348": "\u7ED9\u6211\u7684\u5417\uFF1F\u8FD9\u4E2A\u793C\u7269\u5F88\u4E0D\u9519\uFF01$h#$b#\u5443\uFF0C\u4ECE\u751F\u7406\u5B66\u7684\u89D2\u5EA6\u6765\u8BB2\uFF0C\u6211\u4E0D\u662F\u5F88\u5EFA\u8BAE\u559D\u9152\u2026\u2026#$b#\u4E0D\u8FC7\u4E0D\u53EF\u5426\u8BA4\uFF0C\u5076\u5C14\u653E\u677E\u4E00\u4E0B\u5C0F\u914C\u4E00\u676F\uFF0C\u8FD8\u662F\u6709\u597D\u5904\u7684\uFF01$h",
    "AcceptGift_(O)432": "\u662F\u9001\u7ED9\u6211\u7684\u5417\uFF1F\u8C22\u8C22\u4F60\uFF01\u8FD9\u4E2A\u6DCB\u5728\u610F\u5927\u5229\u9762\u4E0A\u80AF\u5B9A\u5F88\u597D\u5403\u3002$h",
    "AcceptGift_(O)StardropTea": "\u4F60\u8981\u9001\u6211\u8FD9\u4E2A\u5417\uFF1F\u6211\u5F88\u8363\u5E78\uFF0C\u8C22\u8C22\u4F60\uFF01",
    "FlowerDance_Accept": "\u554A\uFF01\u4F60\u2026\u2026\u4F60\u60F3\u8DDF\u6211\u8DF3\u821E\u5417\uFF1F$4#$b#\u2026\u2026\u597D\u7684\uFF0C\u6211\u975E\u5E38\u613F\u610F\uFF01$h",
    "FlowerDance_Accept_Spouse": "\u6211\u90FD\u7B49\u4E86\u4E00\u4E2A\u4E0B\u5348\u4E86\uFF01\u5728\u6625\u5929\u6E05\u65B0\u7684\u6C14\u606F\u4E2D\uFF0C\u4F60\u771F\u662F\u5149\u8292\u56DB\u5C04\u554A\uFF0C\u4EB2\u7231\u7684\u3002$l",
    "FlowerDance_Decline": "\u5662\uFF01\u4E0D\u597D\u610F\u601D\u2026\u2026\u6211\uFF0C\u5443\u2026\u2026\u6253\u7B97\u9080\u8BF7\u522B\u4EBA\u3002$s",
    "Fri": "\u4ECA\u5929\u5929\u6C14\u771F\u597D\u554A\u3002#$e#\u5E0C\u671B\u5DE5\u4F5C\u80FD\u5C11\u70B9\u3002$s",
    "Fri10": "\u5982\u679C\u9700\u8981\u4F53\u68C0\u7684\u8BDD\u5C31\u6765\u6211\u8FD9\u513F\u3002$l",
    "Fri4": "\u5982\u679C\u4F60\u60F3\u53BB\u6211\u7684\u516C\u5BD3\u91CC\u901B\u901B\uFF0C\u6CA1\u95EE\u9898\u3002\u6211\u4F4F\u5728\u8BCA\u6240\u4E0A\u9762\u3002",
    "GreenRain": "\u6211\u5E26\u4E86\u4E00\u4E9B\u533B\u7597\u7528\u54C1\u4EE5\u9632\u4E07\u4E00\uFF0C\u51FA\u95E8\u7684\u65F6\u5019\u5C0F\u5FC3\u70B9\uFF01",
    "GreenRain_2": "\u7B2C\u4E00\u6B21\u4E0B\u8FD9\u79CD\u96E8\u7684\u65F6\u5019\uFF0C\u6211\u4EEC\u90FD\u62C5\u5FC3\u4F1A\u5F88\u5371\u9669\u3002#$b#\u53EF\u662F\u8BF4\u4E0D\u51C6\u8FD9\u96E8\u6C34\u53CD\u800C\u6709\u76CA\u5065\u5EB7\u5462\uFF1F\u5929\u77E5\u9053\u2026\u2026\u81F3\u5C11\u690D\u7269\u90FD\u957F\u52BF\u5F88\u597D\u3002",
    "Introduction": "\u5F88\u9AD8\u5174\u8BA4\u8BC6\u4F60\u3002\u6211\u662F\u54C8\u7EF4\uFF0C\u8FD9\u91CC\u7684\u533B\u751F\u3002#$e#\u6211\u4E3A\u9E48\u9E55\u9547\u7684\u5C45\u6C11\u63D0\u4F9B\u5E38\u89C4\u7684\u4F53\u68C0\u548C\u533B\u7597\u670D\u52A1\u3002\u8FD9\u662F\u4E2A\u5F88\u6709\u610F\u4E49\u7684\u5DE5\u4F5C\u3002#$e#\u5E0C\u671B\u6709\u5929\u4F60\u4E5F\u4F1A\u89C9\u5F97\u81EA\u5DF1\u7684\u5DE5\u4F5C\u5F88\u6709\u610F\u4E49\u3002$h",
    "Mon": "\u6211\u4EEC\u8BCA\u6240\u51FA\u552E\u4E00\u4E9B\u975E\u5904\u65B9\u836F\u2026\u2026\u5982\u679C\u611F\u5230\u75B2\u60EB\u4E4F\u529B\u8FD8\u8BF7\u6765\u5149\u4E34\u3002#$b#\u6211\u77E5\u9053\u5F53\u4E00\u540D\u519C\u592B\u662F\u975E\u5E38\u52B3\u7D2F\u7684\u2026\u2026\u4E0D\u8981\u592A\u52C9\u5F3A\u54E6\uFF01",
    "Mon10": "\u5662\uFF01\u55E8\uFF0C@\u3002$l#$e#\u4F60\u2026\u2026\u8981\u95EE\u8BCA\u5417\uFF1F$l",
    "Mon2": "\u5BF9\u5168\u9547\u7684\u5C45\u6C11\u5065\u5EB7\u8D1F\u8D23\uFF0C\u8FD9\u662F\u6211\u5185\u5FC3\u7684\u4F7F\u547D\u2026\u2026\u538B\u529B\u4E0D\u5C0F\u3002#$e#\u6211\u4EEC\u8FD9\u91CC\u4EBA\u4E0D\u591A\uFF0C\u6211\u5F88\u5E78\u8FD0\u7684\u53EF\u4EE5\u8DDF\u6211\u7684\u75C5\u4EBA\u5EFA\u7ACB\u826F\u597D\u7684\u5173\u7CFB\u3002",
    "Mon6": "\u6211\u60F3\u5728\u661F\u9732\u8C37\u591A\u5F85\u4E00\u9635\u5B50\u3002\u6211\u7EC8\u4E8E\u611F\u89C9\u5F00\u59CB\u878D\u5165\u8FD9\u4E2A\u96C6\u4F53\u4E86\u3002#$e#\u5F53\u4F60\u611F\u89C9\u81EA\u5DF1\u7684\u5B58\u5728\u6709\u4EF7\u503C\u7684\u65F6\u5019\uFF0C\u4F60\u7684\u5FC3\u60C5\u4E5F\u4F1A\u5F88\u4E0D\u9519\u3002",
    "Resort": "\u6211\u8981\u544A\u8BC9\u4F60\u4E00\u4E2A\u5C0F\u79D8\u5BC6\u2026\u2026\u6211\u5FC5\u987B\u6234\u7740\u6551\u751F\u5708\u624D\u80FD\u6E38\u6CF3\u3002$s",
    "Resort_Bar": "\u5929\u6C14\u8FD9\u4E48\u70ED\uFF0C\u8865\u6C34\u662F\u5F88\u91CD\u8981\u7684\u3002\u6211\u8981\u53BB\u95EE\u95EE\u683C\u65AF\uFF0C\u770B\u4ED6\u6709\u6CA1\u6709\u6930\u5B50\u6C34\uFF01$h",
    "Resort_Chair": "\u80FD\u65F6\u4E0D\u65F6\u5730\u627E\u5230\u653E\u677E\u7684\u673A\u4F1A\uFF0C\u8FD9\u8FD8\u633A\u597D\u7684\u3002#$b#\u5F7B\u5E95\u653E\u4E0B\u4F60\u7684\u70E6\u607C\u624D\u662F\u771F\u6B63\u56F0\u96BE\u7684\u4E8B\u2026\u2026$s",
    "Resort_Entering": "\u9632\u6652\u971C\uFF1F\u5E26\u4E86\u2026\u2026#$b#\u906E\u9633\u5E3D\uFF1F\u5E26\u4E86\u2026\u2026",
    "Resort_Leaving": "\u5982\u679C\u4F60\u6652\u4F24\u4E86\uFF0C\u62B9\u4E00\u70B9\u82A6\u835F\u80F6\u5E94\u8BE5\u80FD\u8BA9\u76AE\u80A4\u611F\u89C9\u8212\u670D\u4E9B\u3002",
    "Resort_Shore": "\u6211\u68C0\u67E5\u4E86\u6574\u7247\u6C99\u6EE9\uFF0C\u770B\u6709\u6CA1\u6709\u73BB\u7483\u3002\u5927\u5BB6\u90FD\u4E0D\u5E0C\u671B\u6709\u4EBA\u88AB\u5212\u4F24\u811A\u7684\uFF01",
    "Sat": "\u6211\u80FD\u5E2E\u4F60\u4EC0\u4E48\uFF1F#$e#\u4FDD\u91CD\u3002",
    "Sat10": "\u5509\u2026\u2026\u6211\u5F00\u59CB\u611F\u89C9\u81EA\u5DF1\u6709\u70B9\u8001\u4E86\u2026\u2026#$e#\u5E74\u7EAA\u8D8A\u5927\uFF0C\u8BB0\u7740\u7684\u4E8B\u60C5\u5C31\u8D8A\u591A\uFF0C\u6709\u53EF\u80FD\u4F1A\u4E0D\u582A\u91CD\u8D1F\u3002$s#$e#\u6709\u4F60\u5728\u7684\u65F6\u5019\uFF0C\u6211\u6709\u79CD\u53D8\u5E74\u8F7B\u7684\u611F\u89C9\u3002$l",
    "Sat4": "\u6211\u6765\u8FD9\u662F\u56E0\u4E3A\u6211\u559C\u6B22\u5C0F\u9547\u7684\u6C1B\u56F4\uFF0C\u548C\u96C6\u4F53\u5BF9\u75C5\u4EBA\u7684\u5173\u6000\u3002#$e#\u6211\u771F\u7684\u662F\u8D8A\u6765\u8D8A\u559C\u6B22\u8FD9\u79CD\u6C1B\u56F4\u4E86\u3002$h",
    "Sun": "\u55EF\u2026\u2026\u6211\u73B0\u5728\u5DF2\u7ECF\u8981\u5165\u4E0D\u6577\u51FA\u4E86\u3002\u73B0\u5728\u6765\u627E\u6211\u770B\u75C5\u7684\u75C5\u4EBA\u4E0D\u662F\u5F88\u591A\u3002#$e#\u6211\u89C9\u5F97\u6211\u5F97\u8BD5\u7740\u4ECE\u90BB\u9547\u627E\u75C5\u4EBA\u4E86\u2026\u2026",
    "Sun6": "\u4F60\u60F3\u60F3\uFF0C\u75C5\u4EBA\u7684\u6027\u547D\u5C31\u638C\u63E1\u5728\u4F60\u624B\u91CC\uFF0C\u800C\u4F60\u6CA1\u80FD\u628A\u4ED6\u6551\u6D3B\u2026\u2026\u8FD9\u4E8B\u60C5\u4F1A\u4E00\u76F4\u5728\u4F60\u5FC3\u91CC\u6325\u4E4B\u4E0D\u53BB\u3002$s",
    "Thu": "\u8425\u517B\u5F88\u91CD\u8981\uFF0C\u4E00\u5B9A\u8981\u597D\u597D\u5403\u996D\u3002\u5C3D\u91CF\u591A\u5403\u852C\u83DC\uFF01#$e#\u81EA\u5BB6\u505A\u7684\u996D\u662F\u6700\u597D\u7684\u3002\u4F60\u505A\u996D\u5417\uFF1F",
    "Thu8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u6211\u81EA\u5DF1\u662F\u533B\u751F\uFF0C\u6211\u77E5\u9053\u81EA\u5DF1\u505A\u996D\u6709\u5F88\u591A\u597D\u5904\uFF0C\u53EF\u662F\u6211\u592A\u5FD9\u4E86\uFF0C\u6839\u672C\u6CA1\u65F6\u95F4\u505A\u996D\u3002$s|\u533B\u751F\u6709\u5F88\u591A\u5DE5\u4F5C\uFF0C\u5F88\u96BE\u597D\u597D\u5403\u4E0A\u996D\u3002$s#$e#\u5982\u679C\u6211\u4E0D\u662F\u5355\u8EAB\u7684\u8BDD\u5E94\u8BE5\u4F1A\u597D\u5F97\u591A\u3002$l",
    "Tue": "\u5982\u679C\u611F\u89C9\u751F\u75C5\u4E86\u8BF7\u5C3D\u7BA1\u6765\u6211\u529E\u516C\u5BA4\u3002#$e#\u5F53\u7136\uFF0C\u4F60\u8FD8\u5E74\u8F7B\u3002\u8EAB\u4F53\u4E0D\u7528\u600E\u4E48\u4FDD\u62A4\u4E5F\u4F1A\u5F88\u5065\u5EB7\u7684\u3002$h",
    "Tue8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#@\uFF0C\u522B\u628A\u81EA\u5DF1\u7D2F\u574F\u4E86\uFF0C\u8FD9\u662F\u533B\u5631\uFF01#$e#\u8981\u662F\u4F60\u75C5\u5012\u4E86\uFF0C\u6CA1\u4E86\u5E84\u7A3C\u6211\u4EEC\u8BE5\u600E\u4E48\u5403\u996D\uFF1F\u6211\u4EEC\u9700\u8981\u4F60\uFF01$h|\u4E0D\u8981\u8FC7\u5EA6\u52B3\u7D2F\uFF0C@\u3002\u8FD9\u662F\u533B\u5631\uFF01#$e#\u4F60\u7684\u5065\u5EB7\u5BF9\u6211\u6765\u8BF4\u5F88\u91CD\u8981\u3002$l",
    "Wed": "\u8BB0\u5F97\u6253\u55B7\u568F\u7684\u65F6\u5019\u7528\u624B\u6342\u4F4F\u5634\u3002#$e#\u7136\u540E\u522B\u5FD8\u4E86\u6D17\u624B\u3002",
    "Wed4": "\u6211\u5F88\u613F\u610F\u8FDB\u4E00\u6B65\u4E86\u89E3\u4F60\uFF0C@\u3002\u6211\u4EEC\u5148\u628A\u533B\u60A3\u5173\u7CFB\u629B\u5230\u4E00\u8FB9\u3002",
    "Wed6": "\u5728\u9547\u5B50\u91CC\u6709\u4E2A\u670B\u53CB\u771F\u4E0D\u9519\u3002$h",
    "Wed8": "\u4F60\u8138\u8272\u5F88\u4E0D\u9519\u3002\u5F88\u597D\u3002$h",
    "breakUp": "\u2026\u2026\u4F60\u2026\u2026\u4F60\u2026\u2026\uFF1F$s#$b#\uFF08\u54BD\u53E3\u6C34\uFF09\u2026\u2026\u6211\u2026\u2026\u6211\u5927\u6982\u662F\u8981\u751F\u75C5\u4E86\u2026\u2026$s",
    "dating_Harvey": "\u6211\u662F\u7B2C\u4E00\u6B21\u4EA7\u751F\u8FD9\u6837\u7684\u611F\u89C9\u2026\u2026$l",
    "dating_Harvey_memory_oneday": "\u6211\u60F3\u4F60\u60F3\u5F97\u90FD\u5FEB\u6CA1\u6CD5\u5DE5\u4F5C\u4E86\u3002$l",
    "dating_Maru_memory_oneday": "\u739B\u9C81\u6700\u8FD1\u7279\u522B\u5174\u594B\u2026\u2026\u542C\u8BF4\u8DDF\u4F60\u6709\u5173\u7CFB\u3002",
    "divorced": "\u6211\u2026\u2026\u6211\u65E0\u6CD5\u518D\u9762\u5BF9\u4F60\u4E86\u3002\u6C42\u4F60\u522B\u8BA9\u6211\u627F\u53D7\u66F4\u591A\u7684\u75DB\u82E6\u3002$s",
    "dumped_Guys": "\u6211\u5FD9\u4E8E\u5DE5\u4F5C\u3002\u65E0\u6CD5\u548C\u4F60\u8BF4\u8BDD\u3002$s",
    "eventSeen_56": "\u4F5C\u4E3A\u5C0F\u9547\u533B\u751F\uFF0C\u603B\u4F1A\u4E0D\u53EF\u907F\u514D\u5730\u4E0E\u75C5\u4EBA\u5EFA\u7ACB\u8D77\u4E2A\u4EBA\u8054\u7CFB\uFF0C\u8FD9\u65E2\u6709\u597D\u5904\u4E5F\u6709\u574F\u5904\u2026\u2026",
    "eventSeen_56_memory_fourweeks": "\u8FD9\u51E0\u5E74\u6211\u4E00\u76F4\u5728\u5236\u4F5C\u201C\u52A8\u7269\u6E05\u5355\u201D\u2014\u2014\u6211\u60F3\u89C2\u5BDF\u661F\u9732\u8C37\u91CC\u7684\u6BCF\u4E00\u79CD\u751F\u7269\uFF01",
    "eventSeen_56_memory_twoweeks": "\u6211\u5C1D\u8BD5\u8FC7\u81EA\u5DF1\u505A\u6CE1\u83DC\u2026\u2026$s#$e#\u5443\uFF0C\u8FD9\u4E48\u8BF4\u5427\u2026\u2026\u8DDF\u90A3\u4E2A\u6BD4\u8D77\u6765\uFF0C\u6211\u4EEC\u9AD8\u4E2D\u89E3\u5256\u7684\u9752\u86D9\u7B80\u76F4\u662F\u6C81\u4EBA\u5FC3\u813E\u2026\u2026",
    "eventSeen_571102_memory": "\u6211\u4E4B\u524D\u4ECE\u6765\u6CA1\u8DDF\u522B\u4EBA\u8BF4\u8FC7\u6211\u5BF9\u98DE\u673A\u611F\u5174\u8DA3\u2026\u2026\u4E0D\u8FC7\u8DDF\u4F60\u8BF4\u7684\u65F6\u5019\u8FD8\u662F\u633A\u8F7B\u677E\u7684\u3002",
