  "entries": {
    "Indoor_Day_0": "\u65E9\u554A\uFF01\u7761\u5F97\u8FD8\u597D\u5417\uFF1F$h#$e#\u6211\u60F3\u6211\u4ECA\u5929\u53EF\u80FD\u628A\u8001\u76F8\u673A\u62FF\u51FA\u6765\u7528\u2026\u2026\u5149\u7EBF\u5B9E\u5728\u662F\u592A\u5B8C\u7F8E\u5566\u3002",
    "Indoor_Day_1": "\u4EB2\u7231\u7684\uFF0C\u65E9\u4E0A\u597D\u3002\u662F\u4E0D\u662F\u6709\u5F88\u9999\u7684\u5473\u9053\uFF1F\u6211\u7ED9\u4F60\u505A\u4E86\u65E9\u9910\uFF01[194 195 210 211 216]#$e#\u6211\u77E5\u9053\u4F60\u5DE5\u4F5C\u5F88\u5FD9\u3002\u6211\u4F1A\u5C3D\u529B\u652F\u6301\u4F60\u3002",
    "Indoor_Day_2": "\u7761\u5F97\u8FD8\u597D\u5417\uFF1F\u4F60\u6709\u70B9\u513F\u6253\u9F3E\u3002$h#$e#\u6211\u8FD8\u8981\u505A\u4E9B\u5BB6\u52A1\u3002\u795D\u4F60\u4ECA\u5929\u6109\u5FEB\u3002",
    "Indoor_Day_3": "\u6211\u5F88\u9AD8\u65B0\u81EA\u5DF1\u5B66\u7740\u4EAB\u53D7\u6253\u626B\uFF01\u623F\u5B50\u5F88\u5BB9\u6613\u53D8\u810F\u3002$10#$e#\u628A\u6240\u6709\u4E1C\u897F\u6E05\u7406\u597D\u662F\u4EF6\u8BA9\u4EBA\u6709\u6210\u5C31\u611F\u7684\u4E8B\u3002#$e#\u5728\u4F60\u8D70\u4E4B\u524D\u6211\u80FD\u543B\u4F60\u5417\uFF1F$11",
    "Indoor_Day_4": "\u4EB2\u7231\u7684\uFF0C\u65E9\u4E0A\u597D\u3002\u4E00\u5929\u7684\u519C\u6D3B\u53C8\u5F00\u59CB\u4E86\u5427\uFF1F#$e#\u6211\u4F1A\u4E00\u76F4\u60F3\u7740\u4F60\u7684\u3002\u003C$h",
    "Indoor_Day_Haley": "\u6211\u89C9\u5F97\u5728\u9047\u5230\u4F60\u4E4B\u524D\u6211\u7684\u4EBA\u751F\u6CA1\u6709\u65B9\u5411\u3002\u73B0\u5728\u6211\u77E5\u9053\u81EA\u5DF1\u5230\u5E95\u60F3\u8981\u4EC0\u4E48\u4E86\u3002$l",
    "Indoor_Night_Haley": "\u4EB2\u7231\u7684\uFF0C\u4F60\u770B\u8D77\u6765\u5E72\u4E86\u4E0D\u5C11\u6D3B\u554A\u3002\u8BA9\u6211\u5E2E\u4F60\u51CF\u51CF\u538B\u3002$l",
    "OneKid_3": "\u4E0D\u89C9\u5F97\u5F88\u5947\u602A\u5417\uFF1F\u6211\u8FD8\u4E0D\u4E60\u60EF\u5F53\u4E2A\u6BCD\u4EB2\u3002",
    "Outdoor_0": "\u6211\u5728\u5916\u9762\u547C\u5438\u65B0\u9C9C\u7A7A\u6C14\u7684\u65F6\u5019\u603B\u662F\u611F\u89C9\u5F88\u597D\u3002#$b#\u522B\u8BEF\u4F1A\u6211\uFF0C\u4F60\u7237\u7237\u7684\u8001\u519C\u820D\u5F88\u4E0D\u9519\uFF01\u4F46\u4EC0\u4E48\u90FD\u4E0D\u6BD4\u4E0D\u4E0A\u8FD9\u91CC\u7F8E\u4E3D\u7684\u98CE\u666F\u3002",
    "Outdoor_1": "\u6211\u4EEC\u8981\u8BA9\u519C\u573A\u5F88\u5438\u5F15\u4EBA\u3002\u90A3\u5F88\u91CD\u8981\u2026\u2026\u5BF9\u5427\uFF0C\u4EB2\u7231\u7684\uFF1F",
    "Outdoor_2": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u8981\u662F\u6211\u591A\u61C2\u4E9B\u8015\u79CD\u7684\u77E5\u8BC6\uFF0C\u6211\u4E00\u5B9A\u4F1A\u591A\u5E2E\u5E2E\u4F60\u7684\u3002\u5BF9\u4E0D\u8D77\uFF01#$e#\u6211\u4F1A\u4E00\u76F4\u60F3\u7740\u4F60\u7684\u3002$h",
    "Outdoor_3": "\u6211\u5C31\u5728\u8FD9\u626B\u626B\u7070\u3002\u8FD9\u4F1A\u5E2E\u5230\u4F60\u5427\uFF1F#$e#*\u547C*\u2026\u2026\u8FD9\u513F\u8FD8\u771F\u70ED\u554A\u3002",
    "Outdoor_4": "\u4EB2\u7231\u7684\uFF0C\u522B\u7D2F\u7740\u81EA\u5DF1\u4E86\u3002#$e#\u8BB0\u5F97\u4E0D\u65F6\u5730\u4F11\u606F\u4E00\u4E0B\uFF0C\u6216\u8005\u5403\u70B9\u4E1C\u897F\u3002$h",
    "Outdoor_Haley": "\u751C\u5FC3\uFF0C\u4F60\u4E0D\u89C9\u5F97\u4ECA\u5929\u662F\u4E2A\u6652\u592A\u9633\u7684\u597D\u65E5\u5B50\u5417\uFF1F",
    "Rainy_Day_0": "\u591A\u5E74\u6765\u6211\u5DF2\u7ECF\u53D8\u4E86\u5F88\u591A\uFF0C\u4F46\u6211\u8FD8\u662F\u66F4\u559C\u6B22\u6674\u5929\u3002",
    "Rainy_Day_1": "\u6709\u65F6\u5019\u6211\u4F1A\u5E7B\u60F3\u6211\u4EEC\u7684\u9000\u4F11\u751F\u6D3B\u2026\u2026\u5728\u82AC\u7FA4\u5C9B\u7684\u9633\u5149\u6C99\u6EE9\u4E0A\u653E\u677E\uFF01#$e#\u4F60\u60F3\u8FC7\u672A\u6765\u5417\uFF0C@\uFF1F",
    "Rainy_Day_2": "\u65E9\u554A\uFF01\u6211\u4ECA\u5929\u8D77\u5F97\u65E9\uFF0C\u7ED9\u4F60\u70E4\u4E86\u4E9B\u751C\u70B9\uFF01[223 234 211 651 731]#$e#\u6211\u77E5\u9053\u4F60\u8EAB\u4F53\u5F3A\u58EE\uFF0C\u4F46\u8FD8\u662F\u8981\u5403\u5F97\u597D\u70B9\u513F\uFF0C\u4FDD\u6301\u6700\u4F73\u72B6\u6001\uFF01$h",
    "Rainy_Day_3": "\u4ECA\u5929\u6211\u4E0D\u80FD\u51FA\u53BB\u4E86\u2026\u2026\u6211\u5934\u53D1\u4F1A\u53D8\u8F6F\u7684\u3002\u4EB2\u7231\u7684\uFF0C\u539F\u8C05\u6211\u3002$s#$e#\u6211\u60F3\u5411\u4F60\u5C55\u793A\u6211\u6700\u597D\u7684\u4E00\u9762\u3002",
    "Rainy_Day_4": "\u8FD9\u79CD\u5929\u6C14\u4F60\u8981\u51FA\u53BB\u5417\uFF1F\u4EB2\u7231\u7684\uFF0C\u5728\u8FDB\u6765\u7684\u65F6\u5019\u628A\u9774\u5B50\u64E6\u5E72\u51C0\u3002#$e#\u6211\u4F1A\u5F85\u5728\u8FD9\u91CC\uFF0C\u505A\u4E9B\u5BB6\u52A1\u3002",
    "Rainy_Day_Haley": "\u7CDF\u4E86\u2026\u2026\u8FD9\u5929\u6C14\u518D\u8FD9\u4E48\u4E0B\u53BB\uFF0C\u76AE\u80A4\u90FD\u8981\u53D8\u6210\u60E8\u767D\u8272\u4E86\u3002$s",
    "Rainy_Night_0": "\u5662\uFF0C\u6211\u5F88\u9AD8\u5174\u4F60\u56DE\u6765\u4E86\u3002\u6211\u4E00\u4E2A\u4EBA\u5728\u8FD9\u513F\u7684\u65F6\u5019\u611F\u89C9\u592A\u51B7\u4E86\u2026\u2026\u4F60\u51C6\u5907\u597D\u5173\u706F\u4E86\u5417\uFF1F",
    "Rainy_Night_1": "\u6211\u5E0C\u671B\u660E\u5929\u4E0A\u5348\u9633\u5149\u660E\u5A9A\u3002\u4E00\u76F4\u4E0B\u96E8\u4F1A\u8BA9\u6211\u90C1\u95F7\u7684\u3002$s",
    "Rainy_Night_2": "\u6211\u5E0C\u671B\u827E\u7C73\u4E3D\u4E00\u4E2A\u4EBA\u7684\u65F6\u5019\u4E0D\u4F1A\u592A\u5B64\u72EC\u3002\u6211\u5E94\u8BE5\u5C3D\u5FEB\u518D\u53BB\u770B\u5979\u7684\u3002$7",
    "Rainy_Night_3": "\u4E0B\u96E8\u5BF9\u6444\u5F71\u5E08\u6765\u8BF4\u592A\u8BA8\u538C\u4E86\u3002\u5149\u7EBF\u7CDF\u900F\u4E86\uFF0C\u800C\u4E14\u4E00\u51FA\u95E8\u51C6\u4F1A\u6BC1\u4E86\u8BBE\u5907\uFF01$s",
    "Rainy_Night_4": "\u4EB2\u7231\u7684\uFF0C\u6211\u4E3A\u4F60\u505A\u4E86\u4E00\u987F\u70ED\u996D\u3002\u6309\u4F60\u559C\u6B22\u7684\u53E3\u5473\u52A0\u4E86\u8BB8\u591A\u9999\u6599\u3002\u5C3D\u60C5\u4EAB\u7528\u5427\u3002 [727 231 207 199]$h",
    "Rainy_Night_5": "\u6211\u4ECE\u6CA1\u60F3\u8FC7\u6211\u4F1A\u8FD9\u4E48\u8BF4\uFF0C\u4F46\u662F\u4E61\u6751\u751F\u6D3B\u771F\u7684\u5F88\u9002\u5408\u6211\u3002$h",
    "Rainy_Night_Haley": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u771F\u9AD8\u5174\u4F60\u56DE\u6765\u4E86\u3002\u6211\u90FD\u6709\u70B9\u5B64\u5355\u4E86\u3002$l",
    "TwoKids_2": "%kid2\u53EF\u771F\u662F\u4E2A\u6F02\u4EAE\u7684\u5B9D\u8D1D\u5440\uFF01",
    "TwoKids_3": "\u4E00\u680B\u5927\u623F\u5B50\uFF0C\u4E24\u4E2A\u5B69\u5B50\u8FD8\u6709\u4E00\u65B9\u7F8E\u4E3D\u7684\u571F\u5730\u3002\u6211\u4E0D\u77E5\u9053\u6211\u8FD8\u60F3\u8981\u4EC0\u4E48\u3002",
    "fall_1": "\u5BF9\u6211\u6765\u8BF4\u79CB\u5929\u4EE4\u4EBA\u60B2\u4F24\u2026\u2026\u4E00\u5207\u90FD\u5728\u6D88\u4EA1\u3002$5",
    "fall_2": "\u6211\u5DF2\u7ECF\u5F00\u59CB\u6000\u5FF5\u590F\u5929\u4E86\u2026\u2026",
    "fall_Haley": "\u5C3D\u7BA1\u6211\u66F4\u559C\u6B22\u590F\u5929\uFF0C\u4F46\u662F\u79CB\u5929\u53EF\u80FD\u662F\u6700\u9002\u5408\u6444\u5F71\u7684\u5B63\u8282\u3002\u90A3\u4E9B\u957F\u957F\u7684\u9634\u5F71\u2026\u2026",
    "funLeave_Haley": "\u4ECA\u5929\u6211\u8981\u53BB\u9547\u5B50\u91CC\u73A9\u4E00\u4F1A\u513F\u3002",
    "funReturn_Haley": "\u5728\u9547\u5B50\u91CC\u770B\u5230\u5927\u5BB6\u771F\u597D\u3002\u4F60\u4ECA\u5929\u8FC7\u5F97\u597D\u5417\uFF1F",
    "patio_Haley": "\u8BF4\u201C\u5C71\u7F8A\u5976\u916A\u201D\uFF01",
    "spring_1": "\u51AC\u5929\u8FC7\u53BB\u4E86\uFF0C\u63A5\u4E0B\u6765\u4F1A\u6709\u5F88\u591A\u9633\u5149\u660E\u5A9A\u7684\u5929\u6C14\u3002\u6211\u597D\u671F\u5F85\u5440\u3002",
    "spring_2": "\u8BDD\u8BF4\uFF0C\u8FD9\u4E2A\u5B63\u5EA6\u6211\u4EEC\u79CD\u4E9B\u4EC0\u4E48\u5462\uFF1F",
    "spring_Haley": "\u751C\u5FC3\uFF0C\u51AC\u5929\u7ED3\u675F\u4E86\u4F60\u4E0D\u5F00\u5FC3\u5417\uFF1F\u73B0\u5728\u4E00\u5207\u53C8\u5145\u6EE1\u4E86\u5E0C\u671B\u3002",
    "summer_15": "\u73B0\u5728\u662F\u590F\u5929\u4E86\u2026\u2026\u610F\u5473\u7740\u623F\u5B50\u91CC\u90FD\u662F\u82CD\u8747\u548C\u8682\u8681\u2026\u2026\u771F\u6076\u5FC3\u3002$s",
    "summer_3": "\u62B1\u6B49\u6211\u7684\u6837\u5B50\u53EF\u80FD\u4E0D\u592A\u597D\u770B\u2026\u2026\u7A7A\u6C14\u592A\u6E7F\u4E86\uFF0C\u6211\u5934\u53D1\u90FD\u584C\u4E0B\u53BB\u4E86\u3002",
    "summer_Haley": "\u6211\u559C\u6B22\u590F\u5929\u665A\u4E0A\u770B\u8424\u706B\u866B\u2026\u2026\u90A3\u662F\u6211\u6700\u63A5\u8FD1\u661F\u661F\u7684\u65F6\u5019\u3002",
    "winter_14": "\u5728\u8FD9\u79CD\u5929\u6C14\uFF0C\u6211\u76AE\u80A4\u5F88\u5E72\u71E5\u3002",
    "winter_2": "\u7531\u4E8E\u67D0\u4E9B\u539F\u56E0\uFF0C\u4E0B\u96EA\u5929\u8BA9\u6211\u6E34\u671B\u5403\u7C89\u7EA2\u8272\u7684\u86CB\u7CD5\u2026\u2026",
    "winter_Haley": "\u6211\u53C8\u56DE\u60F3\u8D77\u4F60\u5E2E\u6211\u5F00\u54B8\u83DC\u7F50\u5934\u7684\u90A3\u4E00\u5929\u3002\u8FD8\u8BB0\u5F97\u5417\uFF1F$h#$e#\u6211\u4EEC\u4E5F\u662F\u5728\u90A3\u4E4B\u540E\u597D\u4E0A\u7684\u3002$l"
  }
}