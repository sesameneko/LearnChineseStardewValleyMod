  "entries": {
    "Fri": "\u6C38\u8FDC\u4E0D\u8981\u653E\u5F03\u52AA\u529B\u3002#$e#\u505A\u4EC0\u4E48\u4E8B\u60C5\u90FD\u8981\u505A\u5230\u5C3D\u5584\u5C3D\u7F8E\u3002",
    "Mon": "\u7EE7\u7EED\u52AA\u529B\uFF0C\u5B69\u5B50\u3002\u4F60\u4E00\u5B9A\u4F1A\u529F\u6210\u540D\u5C31\u7684\u3002#$e#\u9700\u8981\u4EC0\u4E48\u4E1C\u897F\u7684\u8BDD\uFF0C\u53EA\u7BA1\u544A\u8BC9\u6211\u5C31\u662F\u4E86\u3002",
    "QiNutRoom_Fri": "\u5C06\u4F60\u7684\u76EE\u5149\u843D\u5728\u6700\u9065\u8FDC\u7684\u661F\u661F\u4E0A\uFF0C\u7136\u540E\u628A\u5B83\u5F53\u4F5C\u4F60\u7684\u76EE\u6807\u3002#$b#\u4F60\u603B\u662F\u80FD\u591F\u767E\u5C3A\u7AFF\u5934\u66F4\u8FDB\u4E00\u6B65\uFF0C\u8D85\u51FA\u4F60\u539F\u672C\u4EE5\u4E3A\u7684\u6781\u9650\u3002",
    "QiNutRoom_Mon": "\u5B69\u5B50\uFF0C\u4E16\u754C\u5E76\u4E0D\u53EA\u6709\u89C6\u529B\u6240\u53CA\u7684\u8303\u56F4\u3002\u603B\u6709\u4E00\u5929\uFF0C\u4F60\u4F1A\u660E\u767D\u7684\u3002#$b#\u73B0\u5728\uFF0C\u4F60\u53EA\u8981\u5728\u505A\u6BCF\u4E00\u4EF6\u4E8B\u60C5\u65F6\u7CBE\u76CA\u6C42\u7CBE\u5C31\u597D\u3002",
    "QiNutRoom_Sat": "\u6709\u4E9B\u4E1C\u897F\u8D85\u8D8A\u4E86\u65F6\u95F4\u4E0E\u7A7A\u95F4\uFF0C\u5B69\u5B50\u3002\u8FD9\u662F\u5185\u5FC3\u6DF1\u5904\u7684\u4E00\u79CD\u72EC\u7279\u611F\u53D7\u2026\u2026\u662F\u6765\u81EA\u9065\u8FDC\u4E4B\u7269\u7684\u4F4E\u8BED\u3002",
    "QiNutRoom_Sun": "\u5728\u5DE6\u8FB9\uFF0C\u4F60\u80FD\u627E\u5230\u4E00\u5757\u677F\u5B50\uFF0C\u4E0A\u9762\u6709\u6211\u7684\u7279\u6B8A\u6311\u6218\u2026\u2026\u662F\u4E13\u95E8\u4E3A\u4F60\u91CF\u8EAB\u8BA2\u5236\u7684\uFF0C\u5B69\u5B50\u3002#$b#\u5728\u53F3\u8FB9\uFF0C\u6709\u5F88\u591A\u5956\u8D4F\uFF0C\u4E13\u95E8\u7559\u7ED9\u90A3\u4E9B\u5B8C\u6210\u6311\u6218\u7684\u4EBA\u2026\u2026#$b#\u795D\u4F60\u597D\u8FD0\uFF0C\u5B69\u5B50\u3002",
    "QiNutRoom_Thu": "\u65E0\u8BBA\u4F60\u8D70\u5230\u54EA\u2026\u2026\u6211\u603B\u4F1A\u5728\u5E37\u5E55\u4E4B\u540E\uFF0C\u786E\u4FDD\u597D\u620F\u5728\u4E0A\u6F14\u3002\u54C8\u54C8\u54C8\u2026\u2026#$b#\u4E0D\u8FC7\u2026\u2026\u662F\u8FD9\u6837\u5417\uFF1F",
    "QiNutRoom_Tue": "\u5B69\u5B50\uFF0C\u6211\u662F\u901A\u8FC7\u7EAF\u7CB9\u7684\u610F\u5FD7\u529B\u6765\u5230\u6211\u6240\u5904\u7684\u4F4D\u7F6E\u7684\u3002#$b#\u4F60\u770B\u2026\u2026\u5934\u8111\u662F\u4E00\u4EF6\u5341\u5206\u5F3A\u5927\u7684\u5DE5\u5177\u3002#$b#\u4E8B\u5B9E\u4E0A\uFF0C\u5B83\u662F\u6574\u4E2A\u73B0\u5B9E\u4E16\u754C\u4E2D\u6700\u4E3A\u5F3A\u5927\u7684\u5DE5\u5177\u2026\u2026\u751A\u81F3\u4E0D\u4EC5\u4EC5\u6B62\u4E8E\u73B0\u5B9E\u4E16\u754C\u3002",
    "QiNutRoom_Wed": "\u6211\u60CA\u8BB6\u4E8E\u4F60\u7684\u987D\u5F3A\uFF0C\u5B69\u5B50\u2026\u2026\u60F3\u8981\u5230\u8FD9\u91CC\u53EF\u662F\u9700\u8981\u5F88\u591A\u6838\u6843\u7684\u3002",
    "Sat": "\u60F3\u8981\u653E\u677E\u7684\u65F6\u5019\uFF0C\u5C31\u6765\u8FD9\u91CC\u5427\u3002",
    "Sun": "\u7EE7\u7EED\u52AA\u529B\uFF0C\u603B\u6709\u4E00\u5929\u4F60\u4E5F\u4F1A\u50CF\u6211\u4E00\u6837\u3002",
    "Thu": "\u563F\u3002\u4F60\u53EF\u4E0D\u8981\u5230\u5904\u8DD1\u6765\u8DD1\u53BB\uFF0C\u5BA3\u626C\u8FD9\u4E2A\u5730\u65B9\uFF0C\u77E5\u9053\u5417\uFF1F\u8FD9\u91CC\u53EF\u662F\u6211\u7684\u2026\u2026\u79D8\u5BC6\u57FA\u5730\u5462\u3002#$e#\u5C31\u8BF7\u4F60\u4E3A\u4E86\u6211\uFF0C\u4FDD\u5B88\u8FD9\u4E2A\u79D8\u5BC6\u5427\uFF1F",
    "Tue": "\u6211\u5C31\u77E5\u9053\u4F60\u603B\u6709\u4E00\u5929\u4F1A\u5230\u8FD9\u91CC\u3002\u5F53\u7136\uFF0C\u4E3A\u4E86\u80FD\u8BA9\u4F60\u66F4\u52A0\u52AA\u529B\uFF0C\u6211\u7A0D\u5FAE\u63D0\u5347\u4E86\u4E00\u70B9\u96BE\u5EA6\u3002",
    "Wed": "\u6211\u51FA\u751F\u65F6\u4E5F\u53EA\u662F\u4E2A\u666E\u901A\u7684\u7537\u5B69\u5B50\u3002\u4F46\u6211\u4ECE\u5C0F\u5C31\u4E0B\u5B9A\u4E3B\u610F\uFF0C\u8981\u53D8\u5F97\u66F4\u52A0\u51FA\u8272\u3002",
    "married": "@\uFF0C\u4F60\u7684\u5A5A\u793C\u529E\u5F97\u975E\u5E38\u5409\u5229\u3002#$b#\u2026\u2026\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u6CA1\u770B\u5230\u6211\uFF1F#$b#\u54C8\u54C8\u54C8\u2026\u2026\u5E74\u8F7B\u4EBA\u2026\u2026\u9F50\u5148\u751F\u53EF\u662F\u65E0\u6240\u4E0D\u77E5\u3001\u65E0\u6240\u4E0D\u6653\u3002"
  }
}