    "Good_0": "@\u2026\u2026\u6211\u4F1A\u4E00\u76F4\u7231\u4F60\u3002$l",
    "Good_1": "\u4F60\u5F88\u5E05\u2026\u2026\u6211\u8DDF\u4F60\u8BF4\u8FC7\u5417\uFF1F$l^\u4F60\u5F88\u7F8E\u2026\u2026\u6211\u8DDF\u4F60\u8BF4\u8FC7\u5417\uFF1F$l",
    "Good_6": "\u6211\u77E5\u9053\u4F60\u5F88\u5F3A\u58EE\uFF0C\u4F46\u662F\u6709\u65F6\u5019\u6211\u62C5\u5FC3\u4F60\u4F1A\u88AB\u53F2\u83B1\u59C6\u5403\u6389\u2026\u2026\u751A\u81F3\u66F4\u7CDF\u7CD5\u3002\u5343\u4E07\u8981\u5C0F\u5FC3\u3002$9",
    "Indoor_Day_0": "\u554A\u2026\u2026\u5728\u6211\u8001\u516C\u65C1\u8FB9\u7F8E\u7F8E\u7684\u7761\u4E00\u89C9\u7B80\u76F4\u518D\u597D\u4E0D\u8FC7\u4E86\uFF01$h^\u554A\u2026\u2026\u5728\u6211\u8001\u5A46\u65C1\u8FB9\u7F8E\u7F8E\u7684\u7761\u4E00\u89C9\u7B80\u76F4\u518D\u597D\u4E0D\u8FC7\u4E86\uFF01$h",
    "Indoor_Day_1": "\u563F\uFF0C\u4EB2\u7231\u7684\uFF01\u6211\u7ED9\u4F60\u505A\u4E86\u70ED\u817E\u817E\u7684\u65E9\u9910\uFF01[195 210 211]#$e#\u5982\u679C\u4F60\u60F3\u8EAB\u4F53\u5F3A\u58EE\uFF0C\u90A3\u4F60\u5FC5\u987B\u628A\u5403\u5F53\u505A\u4E00\u56DE\u4E8B\uFF01",
    "Indoor_Day_2": "\u8FC7\u6765\u3002*\u634F\u7D27*\u2026\u2026\u5514\u3002\u90A3\u4E9B\u519C\u6D3B\u513F\u8BA9\u4F60\u6108\u53D1\u5F3A\u58EE\u4E86\u3002",
    "Indoor_Day_3": "\u6211\u8FD8\u5728\u52AA\u529B\u9002\u5E94\u505A\u996D\u3001\u6D17\u8863\u670D\u2026\u2026\u8FD9\u5E76\u4E0D\u662F\u6211\u559C\u6B22\u7684\uFF0C\u4F46\u662F\u6211\u77E5\u9053\u6211\u548C\u4F60\u7ED3\u5A5A\u4E4B\u540E\u8981\u505A\u8FD9\u4E9B\u4E8B\u60C5\u3002$h",
    "Indoor_Day_4": "\u6211\u4ECA\u5929\u8981\u5904\u7406\u623F\u5B50\u91CC\u7684\u4E00\u4E9B\u4E8B\u60C5\u3002\u522B\u62C5\u5FC3\u6211\uFF0C\u6211\u6CA1\u611F\u5230\u538C\u70E6\u3002",
    "Indoor_Night_0": "\u628A\u81EA\u5DF1\u63A8\u5230\u6781\u9650\u611F\u89C9\u5F88\u597D\uFF0C\u4E0D\u662F\u5417\uFF1F\u4ECA\u665A\u4F60\u4F1A\u89C9\u5F97\u5728\u8212\u670D\u7684\u8F6F\u5E8A\u4E0A\u6709\u4E86\u4E00\u5E2D\u4E4B\u5730\u3002",
    "Indoor_Night_1": "\u4F60\u662F\u526A\u5934\u53D1\u4E86\u8FD8\u662F\u505A\u4E86\u4EC0\u4E48\uFF1F\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u6C14\u8272\u4E0D\u9519\u3002\u53EF\u80FD\u662F\u56E0\u4E3A\u65B0\u9C9C\u7684\u7A7A\u6C14\u2026\u2026$l",
    "Indoor_Night_2": "\u8BF4\u8BF4\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\u554A\u3002\u65F6\u4E0D\u65F6\u628A\u81EA\u5DF1\u653E\u7A7A\u4E5F\u5F88\u597D\u3002",
    "Indoor_Night_3": "\u563F\u2026\u2026\u6211\u4E70\u4E86\u4E9B\u65B0\u77ED\u88E4\u3002\u6211\u89C9\u5F97\u4F60\u53EF\u80FD\u4F1A\u60F3\u77E5\u9053\u2026\u2026$l",
    "Indoor_Night_4": "\u5982\u679C\u4F60\u9700\u8981\u4E00\u4E9B\u72EC\u5904\u7684\u5B89\u9759\u65F6\u5149\u4E5F\u53EF\u4EE5\u3002",
    "OneKid_0": "\u6211\u8FD8\u5728\u52AA\u529B\u9002\u5E94\u6211\u5C45\u5BB6\u5976\u7238\u7684\u65B0\u751F\u6D3B\u3002$h",
    "OneKid_1": "\u5C0F%kid1\u6B63\u5728\u8301\u58EE\u6210\u957F\uFF0C\u5C31\u50CF\u4ED6\u7238\u7238\u4E00\u6837\u3002",
    "OneKid_3": "\u4E0D\u77E5\u9053\u6000\u5B55\u611F\u89C9\u600E\u4E48\u6837\uFF1F$h",
    "Outdoor_0": "\u563F\u3002\u5F53\u6211\u7AD9\u5728\u8FD9\u91CC\uFF0C\u4FEF\u77B0\u6211\u4EEC\u7684\u571F\u5730\u2026\u2026\u6211\u771F\u7684\u5F88\u9A84\u50B2\u3002\u4F60\u505A\u5F97\u771F\u68D2\u3002",
    "Outdoor_1": "\u8FD9\u771F\u662F\u629A\u80B2\u5B69\u5B50\u7684\u597D\u5730\u65B9\u3002\u6211\u559C\u6B22\u5728\u8FD9\u6837\u7684\u5730\u65B9\u957F\u5927\u3002\u6709\u5F88\u5927\u7684\u7A7A\u95F4\u53EF\u4EE5\u5230\u5904\u8DD1\u6765\u8DD1\u53BB\uFF01",
    "Outdoor_2": "\u6211\u559C\u6B22\u5C3D\u53EF\u80FD\u5F85\u5728\u5916\u9762\u3002\u5F85\u5728\u8FD9\u91CC\u611F\u89C9\u5F88\u68D2\u3002",
    "Outdoor_3": "\u770B\u770B\u6211\u4EEC\uFF0C\u8FD8\u6709\u6211\u4EEC\u7684\u5C0F\u519C\u573A\u3002\u6211\u4EEC\u662F\u5F88\u914D\u7684\u4E00\u5BF9\u3002$h^\u563F\u3002\u53EF\u80FD\u662F\u5149\u7EBF\u7684\u7F18\u6545\uFF0C\u4F46\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5F88\u6F02\u4EAE\u3002$l",
    "Outdoor_4": "\u554A\u2026\u2026\u5728\u5916\u9762\u611F\u89C9\u53EF\u771F\u4E0D\u9519\uFF01\u661F\u9732\u8C37\u771F\u662F\u6700\u7F8E\u7684\u5730\u65B9\u2026\u2026",
    "Rainy_Day_0": "\u6709\u4E86\u8FD9\u4E48\u5927\u7684\u7A7A\u95F4\uFF0C\u6211\u771F\u7684\u53EF\u4EE5\u5168\u8EAB\u953B\u70BC\u4E86\u3002",
    "Rainy_Day_1": "\u6211\u5728\u9547\u5B50\u4E0A\u7684\u670B\u53CB\u4ECE\u6765\u90FD\u4E0D\u591A\u2026\u2026\u6709\u65F6\u5019\u6211\u4F1A\u60F3\u5982\u679C\u4F60\u6CA1\u642C\u5230\u8FD9\u91CC\u6765\uFF0C\u6211\u4F1A\u843D\u5165\u4EC0\u4E48\u5730\u6B65\u3002$9",
    "Rainy_Day_2": "\u554A\u2026\u2026\u6211\u672C\u60F3\u5728\u6237\u5916\u6162\u8DD1\u3002\u4F46\u8FD9\u79CD\u5929\u6C14\u53EF\u4E0D\u884C\u3002",
    "Rainy_Day_3": "*\u561F\u56D4*\u2026\u2026\u6211\u521A\u9192\uFF0C\u800C\u4E14\u6025\u9700\u8865\u5145\u86CB\u767D\u8D28\u3002$9",
    "Rainy_Day_4": "\u6216\u8BB8\u6211\u8BE5\u5F00\u59CB\u8BFB\u4E66\u3002\u65E2\u7136\u6211\u5DF2\u7ECF\u7ED3\u5A5A\u4E86\uFF0C\u53EF\u4E0D\u80FD\u53D8\u5F97\u7B28\u5934\u7B28\u8111\u7684\uFF01",
    "Rainy_Night_0": "\u563F\uFF0C\u4F60\u4ECA\u5929\u8FC7\u5F97\u597D\u5417\uFF1F\u6211\u76F8\u4FE1\u660E\u5929\u4F1A\u66F4\u597D\u3002$h",
    "Rainy_Night_1": "\u600E\u4E48\u6837\u4E86\uFF1F\u6211\u4E00\u5929\u90FD\u5E26\u7740\u90A3\u53EA\u65E7\u683C\u7403\u3002\u4EBA\u53EF\u4EE5\u5047\u88C5\u2026\u2026$u",
    "Rainy_Night_2": "\u5662\u2026\u2026\u8FD9\u4E2A\u5473\u9053\uFF1F\u6211\u5403\u4E86\u4E00\u5929\u7684\u5927\u849C\u2026\u2026\u6211\u52AA\u529B\u4FDD\u6301\u6709\u7537\u5B50\u6C14\u6982\u2026\u2026\u62B1\u6B49\u3002$l",
    "Rainy_Night_3": "\u6211\u4E00\u76F4\u7ED9\u8FBE\u65AF\u8FEA\u7559\u4E9B\u5269\u996D\u3002\u5076\u5C14\u4E5F\u8BE5\u5BF9\u4ED6\u597D\u4E00\u70B9\u3002",
    "Rainy_Night_4": "\u6211\u5F88\u997F\uFF0C\u6240\u4EE5\u6211\u505A\u4E86\u665A\u9910\u3002\u6765\uFF0C\u6211\u4E3A\u4F60\u7559\u4E86\u4E00\u76D8\u3002 [241 242 225 214 198]$h",
    "TwoKids_2": "\u53EF\u80FD%kid2\u5C06\u662F\u9E48\u9E55\u9547\u7B2C\u4E00\u4F4D\u4E13\u4E1A\u683C\u7403\u9009\u624B\uFF1F$h",
    "TwoKids_3": "\u6211\u7EC8\u4E8E\u62E5\u6709\u4E86\u7AE5\u5E74\u9519\u5931\u7684\u5BB6\u5EAD\u751F\u6D3B\u2026\u2026\u8C22\u8C22\u4F60\u3002$l",
    "fall_1": "\u597D\u5427\uFF0C\u590F\u5929\u8FC7\u53BB\u4E86\u2026\u2026\u4F46\u662F\u6211\u8981\u4FDD\u6301\u79EF\u6781\u3002\u70ED\u5929\u603B\u4F1A\u56DE\u6765\u7684\u3002",
    "fall_15": "\u660E\u5929\u662F\u96C6\u5E02\uFF0C\u4F60\u4F1A\u53BB\u5417\uFF1F#$e#\u4E0D\u7BA1\u600E\u6837\uFF0C\u6211\u90FD\u4E0D\u5173\u5FC3\u3002",
    "fall_26": "\u5E0C\u671B\u6211\u7684\u7956\u7236\u6BCD\u4E00\u5207\u90FD\u597D\u3002\u7237\u7237\u603B\u662F\u8282\u4FED\u5230\u51B7\u5230\u4E0D\u884C\u7684\u65F6\u5019\u624D\u628A\u7089\u5B50\u6253\u5F00\u3002",
    "funLeave_Alex": "\u4ECA\u5929\u6211\u8981\u5230\u9547\u5B50\u91CC\u53BB\u3002\u665A\u4E0A\u89C1\u3002",
    "funReturn_Alex": "\u6211\u4ECA\u5929\u5F88\u6109\u5FEB\u3002\u6211\u60F3\u7ECF\u5E38\u770B\u770B\u6211\u7684\u7956\u7236\u6BCD\uFF0C\u4ED6\u4EEC\u5F88\u8001\u4E86\u3002",
    "patio_Alex": "\u554A\u2026\u2026\u4E00\u2026\u2026\u554A\u2026\u2026\u4E8C\u2026\u2026\u5728\u6237\u5916\u4E3E\u91CD\u611F\u89C9\u771F\u597D\uFF01$6",
    "spring_1": "\u7EC8\u4E8E\uFF0C\u79EF\u96EA\u6D88\u878D\uFF0C\u592A\u9633\u53C8\u56DE\u5347\u4E86\uFF01\u6211\u7684\u8EAB\u4F53\u611F\u89C9\u5F88\u597D\u3002$h",
    "spring_12": "\u4F60\u5BF9\u660E\u5929\u7684\u8282\u65E5\u611F\u5230\u5174\u594B\u5417\uFF1F\u6211\u60F3\u5403\u5F88\u591A\u514D\u8D39\u7684\u9E21\u86CB\u5BF9\u6211\u6709\u597D\u5904\u3002",
    "spring_23": "\u5662\u2026\u2026\u660E\u5929\u662F\u82B1\u821E\u8282\uFF0C\u5BF9\u5427\uFF1F\u6211\u4ECA\u665A\u6700\u597D\u591A\u505A\u51E0\u4E2A\u4FEF\u5367\u6491\u3002$9#$e#\u8FD9\u4E9B\u8FDE\u8EAB\u8863\u592A\u7D27\u4E86\u2026\u2026\u5927\u5BB6\u90FD\u4F1A\u4ED4\u7EC6\u770B\u3002",
    "spring_6": "\u6211\u5728\u60F3\u661F\u4E4B\u679C\u5B9E\u7684\u679C\u7C89\u80FD\u4E0D\u80FD\u5E2E\u6211\u589E\u5F3A\u4F53\u683C\u2026\u2026",
    "summer_1": "\u590F\u5929\u662F\u4E00\u5E74\u91CC\u6700\u6709\u6D3B\u529B\u7684\u5B63\u8282\uFF0C\u800C\u8EAB\u4F53\u4E5F\u4F1A\u611F\u53D7\u5230\uFF01\u6211\u611F\u89C9\u81EA\u5DF1\u5F88\u7ED3\u5B9E\u3002",
    "summer_10": "\u4F60\u60F3\u597D\u5728\u5BB4\u4F1A\u7684\u6C64\u91CC\u9762\u653E\u4EC0\u4E48\u4E86\u5417\uFF1F#$e#\u6211\u4E0D\u77E5\u9053\u653E\u4EC0\u4E48\u597D\u2026\u2026\u4F60\u624D\u662F\u53A8\u5E08\uFF01$h",
    "summer_27": "\u5443\u2026\u2026\u590F\u5929\u90FD\u8981\u8FC7\u5B8C\u4E86\u3002\u6211\u7684\u808C\u8089\u5F00\u59CB\u840E\u7F29\u4E86\u2026\u2026$s",
    "winter_1": "\u4ECA\u5E74\u51AC\u5929\u6CE8\u610F\u4FDD\u6696\u54E6\u3002\u6211\u62C5\u5FC3\u4F60\u5A07\u5AE9\u7684\u76AE\u80A4\u3002",
    "winter_28": "\u771F\u662F\u4E86\u4E0D\u8D77\u7684\u4E00\u5E74\uFF0C@\u3002\u6211\u5F88\u671F\u5F85\u660E\u5E74\u3002\u73B0\u5728\uFF0C\u9760\u8FD1\u4E00\u70B9\u561B\u3002 $l",
    "winter_7": "\u4F60\u8981\u53C2\u52A0\u4ECA\u5E74\u7684\u9493\u9C7C\u5927\u8D5B\u5417\uFF1F\u6211\u89C9\u5F97\u4F60\u4F1A\u83B7\u80DC\uFF01"
  }
