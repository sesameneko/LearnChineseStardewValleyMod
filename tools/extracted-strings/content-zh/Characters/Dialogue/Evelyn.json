    "AcceptGift_(O)170": "\u4EB2\u7231\u7684\uFF0C\u8C22\u8C22\u4F60\uFF0C\u6211\u627E\u4E86\u534A\u5929\u90FD\u6CA1\u627E\u5230\u6211\u7684\u8001\u82B1\u955C\u2026\u2026#$b#\u54CE\u5466\u5582\uFF01\u600E\u4E48\u5F04\u8FD9\u4E48\u810F\u2026\u2026",
    "AcceptGift_(O)StardropTea": "\u554A\uFF0C\u8FD9\u4E2A\u662F\u9001\u7ED9\u6211\u7684\u5417\uFF1F\u4EB2\u7231\u7684\uFF0C\u8C22\u8C22\u4F60\u554A\uFF0C\u8FD9\u4E2A\u793C\u7269\u5F88\u7279\u522B\uFF01",
    "AcceptGift_Positive_forage_item_beach": "\u4EB2\u7231\u7684\uFF0C\u8C22\u8C22\u4F60\u3002\u8FD9\u8BA9\u6211\u60F3\u8D77\u4E86\u7F8E\u597D\u7684\u65F6\u5149\u2026\u2026",
    "Event_cookies1": "\u975E\u5E38\u611F\u8C22\uFF01$h",
    "Event_cookies2": "\u4EB2\u7231\u7684\uFF0C\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u6211\u542C\u5230\u4F60\u8BF4\u7684\u662F\u201C\u51B0\u7403\u201D\u3002*\u5509* \u6211\u7684\u8033\u6735\u4E0D\u50CF\u4EE5\u524D\u90A3\u4E48\u597D\u4F7F\u4E86\u3002$s",
    "Fri": "\u4E54\u6CBB\u4E00\u6574\u5929\u90FD\u5750\u5728\u90A3\u8BE5\u6B7B\u7684\u7535\u89C6\u524D\u3002#$e#\u6211\u5E0C\u671B\u4ED6\u80FD\u591A\u51FA\u53BB\u8D70\u8D70\u3002\u547C\u5438\u70B9\u65B0\u9C9C\u7A7A\u6C14\u5BF9\u4ED6\u6709\u597D\u5904\u3002",
    "GreenRain": "\u4E54\u6CBB\uFF0C\u8001\u5934\u5B50\u2026\u2026\u672B\u65E5\u6765\u4E86\u5417\uFF1F\u6211\u4E00\u751F\u8FC7\u5F97\u633A\u597D\u7684\uFF0C\u5047\u5982\u80FD\u770B\u5230\u4E9A\u5386\u514B\u65AF\u51FA\u606F\u7684\u90A3\u4E00\u5929\uFF0C\u6211\u5C31\u6B7B\u800C\u65E0\u61BE\u4E86\u2026\u2026$s%noturn",
    "GreenRainFinished": "\u6211\u7684\u5929\u54EA\u2026\u2026\u5927\u5BB6\u6CA1\u4E8B\u771F\u7684\u592A\u597D\u4E86\u3002\u6211\u7684\u82B1\u597D\u50CF\u8FD8\u957F\u5F97\u66F4\u597D\u4E86\uFF01",
    "GreenRain_2": "\u8FD9\u573A\u96E8\u4E0B\u6765\uFF0C\u82B1\u5E94\u8BE5\u4F1A\u957F\u5F97\u66F4\u597D\u2026\u2026",
    "Introduction": "\u554A\uFF0C\u6B22\u8FCE\u4F60\u6765\u6211\u4EEC\u7684\u5C0F\u5BB6\u56ED\u554A\uFF0C\u4EB2\u7231\u7684\uFF01#$b#\u5982\u679C\u4E50\u610F\u7684\u8BDD\uFF0C\u5C31\u53EB\u6211\u201C\u5976\u5976\u201D\u5427\u3002$h",
    "Mon": "\u54CE\u5440\uFF01\u5929\u6C14\u771F\u597D\u554A\u3002$u",
    "MovieInvitation": "\u54CE\u5440\uFF01\u4F60\u771F\u597D\uFF0C\u4EB2\u7231\u7684\u3002\u5F53\u7136\u4E86\u2026\u2026\u6211\u5F88\u613F\u610F\u53BB\u770B\u7535\u5F71\uFF01$h#$b#\u4F60\u5148\u53BB\u5427\uFF0C\u6211\u4EEC\u7535\u5F71\u9662\u89C1\u3002",
    "Sat": "\u6211\u559C\u6B22\u770B\u4E91\u5F69\uFF0C\u4E0D\u8FC7\u73B0\u5728\u662F\u770B\u4E0D\u5230\u4E86\u3002#$e#\u6211\u7684\u773C\u775B\u4E0D\u50CF\u4EE5\u524D\u90A3\u4E48\u597D\u4F7F\u4E86\u3002$s",
    "Sun": "\u79BB\u5927\u6D77\u8FD9\u4E48\u8FD1\u771F\u597D\u3002\u6D77\u7684\u58F0\u97F3\u8BA9\u6211\u5B89\u7136\u5165\u7761\u3002#$e#\u5C0F\u65F6\u5019\u6211\u4EEC\u603B\u5728\u9000\u6F6E\u540E\u53BB\u627E\u8D1D\u58F3\u3002\u90A3\u4E9B\u65E5\u5B50\u771F\u662F\u2026\u2026",
    "Thu": "\u4ECA\u5929\u6211\u8981\u70E4\u70B9\u66F2\u5947\u3002\u6625\u5929\u7684\u65F6\u5019\uFF0C\u6211\u559C\u6B22\u628A\u66F2\u5947\u505A\u6210\u82B1\u74E3\u5F62\u72B6\u7684\u3002$h#$e#\u4EE5\u540E\u6211\u6CA1\u51C6\u4F1A\u628A\u505A\u6CD5\u544A\u8BC9\u4F60\u54E6\u3002",
    "Tue": "\u4E0D\u8981\u5728\u610F\u6211\u7684\u4E08\u592B\uFF0C\u4E54\u6CBB\u3002\u4ED6\u5BF9\u964C\u751F\u4EBA\u4E0D\u592A\u53CB\u597D\u3002#$e#\u8981\u662F\u4F60\u548C\u4ED6\u719F\u4E86\u4EE5\u540E\u4ED6\u4F1A\u5BF9\u4F60\u5F88\u70ED\u60C5\u7684\u3002#$e#\u6211\u76F8\u4FE1\u4F60\u4EEC\u6709\u4E00\u5929\u4F1A\u6210\u4E3A\u597D\u670B\u53CB\u7684\uFF01$h#$e#\u65E2\u7136\u4F60\u5BF9\u4ED6\u5F88\u611F\u5174\u8DA3\uFF0C\u6211\u53EF\u4EE5\u544A\u8BC9\u4F60\u4E00\u4E2A\u5C0F\u79D8\u5BC6\uFF1A\u4ED6\u5F88\u559C\u6B22\u97ED\u83DC\uFF01\u5728\u8FD9\u4E2A\u65F6\u8282\uFF0C\u4F60\u53EF\u4EE5\u5230\u5C71\u91CC\u6458\u4E00\u4E9B\u7ED9\u4ED6\u3002",
    "Tue6": "\u8C22\u8C22\u4F60\u6765\u770B\u6211\u548C\u4E54\u6CBB\u3002#$e#\u6CA1\u6709\u5E74\u8F7B\u4EBA\u966A\u7740\u6211\u4EEC\u7684\u8BDD\uFF0C\u6211\u4EEC\u53EF\u80FD\u5C31\u8001\u5F97\u66F4\u5FEB\u4E86\u3002$h",
    "Wed": "#$1 evelynGarden1#\u6211\u6628\u5929\u5728\u82B1\u56ED\u91CC\u770B\u89C1\u4E86\u4E00\u7FA4\u8774\u8776\uFF0C\u771F\u662F\u7F8E\u4E3D\u81F3\u6781\u3002$k#$e#\u9547\u957F\u4EBA\u4E0D\u9519\uFF0C\u4ED6\u8BA9\u6211\u8D1F\u8D23\u5168\u9547\u7684\u516C\u5171\u82B1\u56ED\u3002#$e#\u8FD9\u4E2A\u56ED\u5703\uFF0C\u6211\u5DF2\u7ECF\u62A4\u7406\u6570\u5468\u4E86\uFF0C\u53EF\u4E0D\u8981\u968F\u610F\u8E29\u8E0F\u554A\uFF01",
    "cc_Complete": "\u793E\u533A\u4E2D\u5FC3\u80FD\u6062\u590D\u771F\u662F\u592A\u597D\u4E86\uFF0C\u4EE5\u524D\u53EF\u559C\u6B22\u5F85\u5728\u90A3\u91CC\u4E86\u2026\u2026\u5BF9\u6211\u4EEC\u6765\u8BF4\u610F\u4E49\u975E\u51E1\u3002",
    "cropMatured_591": "\u6625\u5929\u9001\u522B\u4EBA\u4E00\u679D\u81EA\u5BB6\u79CD\u7684\u90C1\u91D1\u9999\uFF0C\u90A3\u662F\u6781\u597D\u7684\u3002",
    "divorce": "\u4E0B\u6B21\u7ED3\u5A5A\u7684\u65F6\u5019\uFF0C\u4F60\u4E00\u5B9A\u8981\u627E\u5230\u771F\u7231\u554A\u2026\u2026$s",
    "fall_Mon": "\u968F\u7740\u65F6\u95F4\u6D41\u901D\uFF0C\u6211\u8D8A\u6765\u8D8A\u559C\u6B22\u5404\u4E2A\u5B63\u8282\u3002\u5BF9\u4E8E\u5E74\u8F7B\u4EBA\u6765\u8BF4\uFF0C\u603B\u662F\u8BA9\u8FD9\u4E9B\u7F8E\u597D\u7684\u65F6\u5149\u6084\u6084\u6D41\u901D\u5462\u3002",
    "fall_Sat": "\u4F60\u4EEC\u662F\u4E9A\u5386\u514B\u65AF\u7684\u670B\u53CB\u5417\uFF1F#$e#\u4ED6\u6709\u65F6\u5019\u603B\u62C5\u5FC3\u6211\u751F\u75C5\u3002",
    "fall_Sat_inlaw_Alex": "\u54E6\uFF0C\u4F60\u597D\u554A\uFF0C\u4EB2\u7231\u7684\u3002\u6211\u73B0\u5728\u628A\u4F60\u5F53\u505A\u6211\u7684\u4EB2\u5B59${\u5B50^\u5973}$\u3002$h",
    "fall_Sun": "\u6211\u89C6\u529B\u53EF\u80FD\u4E0D\u592A\u597D\uFF0C\u4F46\u662F\u9F3B\u5B50\u5F88\u7075\uFF01#$e#\u6211\u80FD\u95FB\u5230\u843D\u53F6\u548C\u8611\u83C7\u7684\u5473\u9053\u3002\u8FD9\u4F7F\u6211\u60F3\u8D77\u4E86\u6211\u8FD8\u662F\u5C0F\u5973\u5B69\u7684\u65F6\u5019\u53BB\u73A9\u800D\u7684\u68EE\u6797\u3002",
    "fall_Thu": "\u6211\u4ECA\u5929\u8981\u70E4\u4E9B\u997C\u5E72\u3002\u662F\u5C0F\u5357\u74DC\u5F62\u72B6\u7684\u54E6\u3002$h#$e#\u4EE5\u540E\u6211\u6CA1\u51C6\u4F1A\u628A\u505A\u6CD5\u544A\u8BC9\u4F60\u54E6\u3002",
    "fall_Tue": "\u6211\u5728\u4E54\u6CBB\u7684\u71D5\u9EA6\u91CC\u9762\u653E\u4E86\u8461\u8404\u5E72\u2026\u2026\u4F46\u4ED6\u4E00\u53E5\u8BDD\u90FD\u6CA1\u8BF4\u3002\u6211\u5728\u60F3\u4ED6\u5230\u5E95\u6CE8\u610F\u5230\u6CA1\u6709\uFF1F",
    "fall_Wed": "\u9547\u957F\u4EBA\u4E0D\u9519\uFF0C\u4ED6\u8BA9\u6211\u8D1F\u8D23\u5168\u9547\u7684\u516C\u5171\u82B1\u56ED\u3002#$e#\u79CB\u5929\u7684\u82B1\u5F88\u5A07\u8D35\uFF0C\u6240\u4EE5\u522B\u8FDB\u53BB\u8E29\uFF01\u6211\u77E5\u9053\u4F60\u4EEC\u8FD9\u4E9B\u5B69\u5B50\u5C31\u559C\u6B22\u8FD9\u6837\u5E72\u3002",
    "married": "\u4EB2\u7231\u7684\uFF0C\u6211\u771F\u4E3A\u4F60\u9AD8\u5174\u3002$h#$e#\u770B\u5230\u5E74\u8F7B\u4EBA\u76F8\u7231\uFF0C\u6211\u8FD9\u4E2A\u8001\u5A46\u5A46\u5FC3\u91CC\u6696\u6D0B\u6D0B\u7684\u3002",
    "pamHouseUpgrade": "\u54E6\uFF0C\u751C\u5FC3\u2026\u2026\u4F60\u771F\u597D\uFF0C\u8BA9\u6F58\u59C6\u4F4F\u8FDB\u4E00\u95F4\u7F8E\u4E3D\u7684\u65B0\u623F\u5B50\uFF01$h#$e#\u5F53\u4EBA\u4EEC\u50CF\u8FD9\u6837\u7167\u987E\u5F7C\u6B64\u65F6\uFF0C\u6211\u7684\u5FC3\u6696\u6696\u7684\u2026\u2026",
    "pamHouseUpgradeAnonymous": "\u867D\u7136\u4F60\u53EF\u4EE5\u53EB\u6211\u8822\u8822\u7684\u8001\u50BB\u74DC\u2026\u2026\u4F46\u6211\u60F3\u6211\u77E5\u9053\uFF0C\u8C01\u4E3A\u6F58\u59C6\u4E70\u4E86\u65B0\u623F\u5B50\u2026\u2026*\u7728\u773C*",
    "reject_866": "\u4EB2\u7231\u7684\uFF0C\u8FD9\u6735\u73AB\u7470\u82B1\u771F\u6F02\u4EAE\u3002\u4F60\u7ED9\u827E\u7C73\u4E3D\u770B\u8FC7\u4E86\u5417\uFF1F\u8FD9\u8BA9\u6211\u60F3\u8D77\u4E86\u5979\u3002",
    "reject_867": "\u554A\uFF0C\u4E54\u6CBB\u80AF\u5B9A\u4F1A\u5F88\u611F\u5174\u8DA3\uFF01",
    "summer_Mon": "\u5728\u8FD9\u79CD\u597D\u5929\u6C14\u91CC\u6211\u611F\u89C9\u66F4\u6709\u6D3B\u529B\u4E86\u3002$u",
    "summer_Mon_inlaw_Alex": "\u6211\u7684\u5B59\u5B50\u600E\u4E48\u6837\u4E86\uFF1F\u6211\u60F3\u4ED6\u4F4F\u5728\u519C\u573A\u91CC\u5E94\u8BE5\u5F88\u5F00\u5FC3\u3002#$e#\u4ED6\u5E94\u8BE5\u5F97\u5230\u5E78\u798F\u2026\u2026\u4ED6\u662F\u4E2A\u597D\u5B69\u5B50\u3002",
    "summer_Sat": "\u5728\u5916\u9762\u6CE8\u610F\u70B9\u3002\u4F60\u53EF\u80FD\u4F1A\u88AB\u6652\u4F24\u7684\uFF01",
    "summer_Sun": "\u751C\u8C4C\u8C46\u82B1\u6B63\u5F00\u7740\u5462\u3002#$e#\u771F\u597D\u95FB\u554A\uFF0C\u4E0D\u662F\u5417\uFF1F",
    "summer_Thu": "\u6211\u4ECA\u5929\u8981\u70E4\u4E9B\u997C\u5E72\u3002\u597D\u5403\u7684\u6930\u5B50\u5473\u54E6\uFF0C\u8FDE\u5F62\u72B6\u4E5F\u662F\u6930\u6811\u5F62\u7684\uFF01\u563B\u563B\u3002$h#$e#\u4EE5\u540E\u6211\u6CA1\u51C6\u4F1A\u628A\u505A\u6CD5\u544A\u8BC9\u4F60\u54E6\u3002",
    "summer_Thu4": "\u597D\u50CF\u6211\u4E00\u70E4\u997C\u5E72\u5C31\u603B\u6709\u5F88\u591A\u5BA2\u4EBA\u6765\u3002#$e#\u914D\u65B9\u662F\u6211\u5988\u5988\u6559\u6211\u7684\u3002",
    "summer_Tue": "\u4E54\u6CBB\u590F\u5929\u7684\u65F6\u5019\u813E\u6C14\u6CA1\u90A3\u4E48\u66B4\u8E81\u2026\u2026\u6E29\u6696\u7684\u5929\u6C14\u8BA9\u4ED6\u7684\u9AA8\u5934\u53D1\u8F6F\u3002#$e#\u4F60\u53EF\u80FD\u770B\u4E0D\u51FA\u6765\uFF0C\u4F46\u662F\u6211\u80FD\u3002\u6211\u8BA4\u8BC6\u4ED6\u516D\u5341\u5E74\u4E86\uFF01",
    "summer_Wed": "\u9547\u957F\u4EBA\u4E0D\u9519\uFF0C\u4ED6\u8BA9\u6211\u8D1F\u8D23\u5168\u9547\u7684\u516C\u5171\u82B1\u56ED\u3002#$e#\u8FD9\u4E2A\u56ED\u5703\u6211\u5DF2\u7ECF\u62A4\u7406\u6570\u5468\u4E86\uFF0C\u53EF\u4E0D\u8981\u968F\u610F\u8E29\u8E0F\u554A\uFF01",
    "winter_Mon": "\u5C0F\u5FC3\u522B\u5728\u51B0\u4E0A\u6ED1\u5012\u4E86\u54E6\u3002",
    "winter_Sat": "\u6211\u4EEC\u5728\u8FD9\u91CC\u5DF2\u7ECF\u4F4F\u4E86 30 \u591A\u5E74\u4E86\u3002#$e#\u6211\u4EEC\u89C1\u60EF\u4E86\u4EBA\u6765\u4EBA\u5F80\u3002\u6BD4\u5982\u4F60\u7684\u7237\u7237\u3002\u4E0A\u5E1D\u4FDD\u4F51\u2026\u2026*\u5509*",
    "winter_Sat6": "\u54E6\u2026\u2026\u4EB2\u7231\u7684\uFF01\u4F60\u7684\u773C\u775B\u8DDF\u4F60\u7237\u7237\u7684\u4E00\u6837\u2026\u2026$s#$e#\u5BF9\u2026\u2026\u5BF9\u2026\u2026\u6211\u8DDF\u4ED6\u5F88\u719F\u3002",
    "winter_Sat8": "@\uFF0C\u6211\u8DDF\u4F60\u8BF4\u8FC7\u6211\u548C\u4E54\u6CBB\u5728\u6211\u4EEC\u7684\u623F\u5B50\u91CC\u5DF2\u7ECF\u4F4F\u4E86 30 \u5E74\u4E86\u5417\uFF1F#$e#\u6211\u5E0C\u671B\u4F60\u518D\u591A\u7559\u4E00\u9635\u5B50\u3002$h",
    "winter_Sun": "\u4F60\u5E94\u8BE5\u7172\u70B9\u70ED\u6C64\u6696\u6696\u8EAB\u5B50\u3002#$e#\u522B\u5FD8\u4E86\u7A7F\u4E0A\u5939\u514B\uFF01",
