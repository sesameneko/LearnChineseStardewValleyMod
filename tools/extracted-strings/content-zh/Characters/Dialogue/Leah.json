    "Resort_Chair": "\u6211\u559C\u6B22\u8FD9\u6837\u7684\u70ED\u5929\u6C14\uFF0C\u53EA\u8981\u6211\u4E00\u52A8\u4E0D\u52A8\u5C31\u5F88\u8212\u670D\u3002$h",
    "Resort_Entering": "\u522B\u544A\u8BC9\u5176\u4ED6\u4EBA\u54E6\uFF0C\u5A01\u5229\u5141\u8BB8\u6211\u5F00\u51E0\u5206\u949F\u7684\u8239\u3002$h",
