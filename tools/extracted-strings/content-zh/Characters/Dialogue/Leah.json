    "Resort_Wander": "\u5514\uFF0C\u8FD9\u91CC\u7684\u6811\u6728\u80AF\u5B9A\u80FD\u591F\u6210\u4E3A\u975E\u5E38\u6709\u8DA3\u7684\u539F\u6750\u6599\uFF0C\u503C\u5F97\u96D5\u7422\u4E00\u756A\u3002#$e#\u4F46\u5982\u679C\u6211\u628A\u4E00\u5927\u5806\u5706\u6728\u62D6\u5230\u5A01\u5229\u7684\u8239\u4E0A\uFF0C\u4ED6\u6050\u6015\u4F1A\u751F\u6211\u7684\u6C14\uFF01$h",
    "Resort_Wander_2": "\u4E0D\u77E5\u9053\u4F60\u5728\u8FD9\u91CC\u80FD\u91C7\u96C6\u5230\u4EC0\u4E48\u6837\u7684\u4E1C\u897F\u3002#$e#\u6211\u4F3C\u4E4E\u5728\u9644\u8FD1\u7684\u704C\u6728\u4E0A\u89C1\u5230\u4E86\u4E00\u4E9B\u770B\u8D77\u6765\u5F88\u7F8E\u5473\u7684\u6838\u6843\u3002",
    "Sat": "\u6211\u5F88\u559C\u6B22\u6839\u636E\u5B63\u8282\u6765\u8FDB\u884C\u88C5\u9970\u3002",
    "Sat8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u6211\u6709\u8003\u8651\u8FC7\u79CD\u70B9\u4E1C\u897F\uFF0C\u4F46\u4E3A\u4E86\u817E\u51FA\u5730\u65B9\u5C31\u8981\u9664\u6389\u91CE\u8349\u6211\u4F1A\u6709\u7F6A\u6076\u611F\u7684\u3002|\u79CD\u7530\u542C\u8D77\u6765\u597D\u6709\u8DA3\u554A\u3002\u6211\u4EE5\u540E\u4E5F\u60F3\u8BD5\u8BD5\u3002$l",
    "Sun": "\u5982\u679C\u4F60\u542C\u5230\u6211\u7684\u5C0F\u5C4B\u91CC\u4F20\u51FA\u7830\u7830\u7684\u58F0\u97F3\uFF0C\u90A3\u53EF\u80FD\u662F\u6211\u5728\u5236\u4F5C\u77F3\u818F\u3002",
    "Sun8": "\u5982\u679C\u4F60\u6709\u627E\u5230\u6837\u8C8C\u6709\u8DA3\u7684\u6D6E\u6728\u7684\u8BDD\uFF0C\u6211\u53EF\u80FD\u4F1A\u7528\u7684\u7740\u3002#$e#\u4ECE\u4F60\u90A3\u91CC\u5F97\u5230\u8FD9\u6837\u7684\u793C\u7269\u771F\u7684\u5F88\u7279\u522B\u3002",
    "Thu": "\u8FD9\u9644\u8FD1\u5176\u5B9E\u6709\u5F88\u591A\u91CE\u751F\u7684\u98DF\u7269\uFF0C\u53EA\u8981\u4F60\u77E5\u9053\u53BB\u54EA\u513F\u627E\u5C31\u884C\u3002#$e#\u6211\u51E0\u4E4E\u6BCF\u5929\u90FD\u5403\u65B0\u9C9C\u7684\u6C99\u62C9\u3002$h",
    "Thu6": "\u6211\u7684\u7279\u957F\u4E4B\u4E00\u5C31\u662F\u91C7\u96C6\u3002\u6211\u4EE5\u540E\u4E5F\u4F1A\u4E3A\u4F60\u505A\u4E00\u987F\u65B0\u9C9C\u7684\u6C99\u62C9\u7684\u3002$h",
    "Tue": "\u90BB\u5C45\uFF0C\u4F60\u597D\u554A\u3002#$e#\u6211\u4EEC\u90FD\u4F4F\u5728\u9547\u5B50\u5916\u9762\u3002\u8FD9\u662F\u4E0D\u662F\u610F\u5473\u7740\u4EC0\u4E48\u5462\uFF1F",
    "Tue4": "\u55E8\u3002\u5662\uFF0C\u4F60\u60F3\u804A\u804A\u662F\u5417\uFF1F#$e#\u8FD9\u9644\u8FD1\u7684\u98CE\u666F\u7ED9\u6211\u5F88\u591A\u7075\u611F\u3002\u5927\u5730\u672C\u8EAB\u5C31\u5982\u540C\u4E00\u4EF6\u96D5\u5851\u3002#$e#\u6211\u521B\u4F5C\u4E0D\u662F\u4E3A\u4E86\u94B1\u3002\u6211\u7684\u827A\u672F\u521B\u4F5C\u5B8C\u5168\u662F\u4E00\u79CD\u51B2\u52A8\u3002#$e#\u611F\u89C9\u79CD\u5730\u662F\u4E2A\u597D\u5904\u5F88\u591A\u7684\u804C\u4E1A\u3002\u4F60\u80FD\u4E3A\u5927\u5BB6\u79CD\u51FA\u5F88\u591A\u597D\u5403\u7684\u98DF\u7269\u3002$h#$e#\u4F60\u5927\u6982\u5F88\u5FD9\u5427\u3002\u62B1\u6B49\u3002",
    "Wed": "#$1 LeahBug#\u4ECA\u5929\u65E9\u4E0A\u6211\u4E00\u4E0D\u5C0F\u5FC3\u8E29\u5230\u4E86\u4E00\u53EA\u866B\u5B50\u3002$s#$e#\u6709\u65F6\u5019\u6211\u89C9\u5F97\uFF0C\u67D0\u79CD\u7A0B\u5EA6\u4E0A\uFF0C\u6D3B\u7740\u800C\u53C8\u4E0D\u7834\u574F\u5927\u81EA\u7136\u662F\u4EF6\u4E0D\u53EF\u80FD\u7684\u4E8B\u60C5\u3002",
    "Wed6": "\u6211\u559C\u6B22\u548C\u52A8\u7269\u5446\u5728\u4E00\u8D77\u3002\u5B83\u4EEC\u662F\u5982\u6B64\u7684\u5929\u771F\u3002#$e#\u519C\u573A\u91CC\u7684\u52A8\u7269\u4E5F\u5F88\u68D2\u3002$h",
    "Wed8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u6536\u83B7\u4E00\u6574\u5757\u5730\u7684\u5E84\u7A3C\u80AF\u5B9A\u5F88\u6709\u6210\u5C31\u611F\u5427\uFF1F\u7B80\u76F4\u5C31\u50CF\u662F\u51ED\u7A7A\u53D8\u51FA\u4E86\u996D\u83DC\u4E00\u6837\uFF01$h|\u55E8\uFF0C@\uFF01\u6211\u521A\u521A\u8FD8\u5728\u8003\u8651\u4F60\u519C\u573A\u7684\u4E8B\u60C5\u5462\u3002#$e#\u6709\u8FD9\u4E48\u5927\u4E00\u5757\u5730\uFF0C\u6536\u83B7\u8D77\u6765\u4E00\u5B9A\u611F\u89C9\u4E0D\u9519\u5427\u3002$h#$e#\u4E0D\u8FC7\u5982\u679C\u6709\u4EBA\u80FD\u5E2E\u4F60\u5C31\u597D\u4E86\u3002$l",
    "breakUp": "\u54E6\u2026\u2026\u77E5\u9053\u4E86\u3002\u55EC\u2026\u2026\u5728\u8FD9\u79CD\u4E8B\u60C5\u4E0A\u6211\u771F\u662F\u5012\u9709\u6781\u4E86\u3002$s",
    "dating_Leah": "\u6211\u4E4B\u524D\u6709\u9884\u611F\u4F60\u4F1A\u6765\u7EA6\u6211\u2026\u2026$l",
