    "summer_Fri": "\u7528\u5F00\u5B54\u5668\u53EF\u4EE5\u76F4\u63A5\u4ECE\u6811\u4E0A\u6536\u96C6\u7CD6\u6D46\u6216\u662F\u5176\u4ED6\u6709\u7528\u7684\u6DB2\u4F53\u3002#$e#\u8FD9\u662F\u4E2A\u7F13\u6162\u7684\u8FC7\u7A0B\uFF0C\u4F46\u662F\u5374\u6709\u53EF\u80FD\u6536\u83B7\u5F88\u73CD\u8D35\u7684\u4E1C\u897F\u3002",
    "summer_Fri2": "\u6211\u8BA8\u538C\u8BF4\u8BDD\u8FD9\u4E48\u76F4\u767D\uFF0C\u4F46\u5982\u679C\u6211\u4EEC\u4E0D\u5BF9\u81EA\u7136\u5FC3\u6000\u656C\u754F\u7684\u8BDD\uFF0C\u6211\u4EEC\u7684\u5B50\u5B59\u5C31\u6CA1\u6709\u672A\u6765\u3002#$e#\u4F60\u4E0D\u8FD9\u4E48\u89C9\u5F97\u5417\uFF1F",
