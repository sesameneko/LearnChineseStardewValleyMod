    "Fri4": "\u60A8\u597D\uFF0C@\u3002\u4ECA\u5929\u5929\u6C14\u771F\u597D\uFF0C\u4E0D\u662F\u5417\uFF1F#$e#\u5982\u679C\u4F60\u60F3\u627E\u4EBA\u804A\u5929\u7684\u8BDD\uFF0C\u5C31\u6765\u6211\u7684\u5C0F\u5C4B\u5750\u5750\u5427\u3002$h",
    "Fri6": "\u6709\u65F6\u5019\u6211\u4F1A\u9677\u5165\u4E00\u79CD\u5947\u602A\u7684\u611F\u89C9\uFF0C\u5927\u8111\u4E00\u7247\u7A7A\u767D\u2026\u2026\u611F\u89C9\u7279\u522B\u5E73\u9759\uFF0C\u751A\u81F3\u6709\u70B9\u5E78\u798F\u3002#$e#\u5582\uFF01\u8FD9\u8DDF\u559D\u9152\u6CA1\u5173\u7CFB\uFF01$h",
    "Fri8": "\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\uFF0C\u5047\u5982\u53D8\u6210\u53E6\u4E00\u4E2A\u4EBA\u4F1A\u662F\u4EC0\u4E48\u611F\u89C9\uFF1F#$e#\u6211\u4EEC\u7684\u601D\u60F3\u662F\u8868\u73B0\u51FA\u7C7B\u4F3C\u7684\u6A21\u5F0F\uFF0C\u8FD8\u662F\u622A\u7136\u4E0D\u540C\uFF1F#$e#\u4E0D\u7528\u7BA1\u6211\uFF0C\u6211\u5076\u5C14\u4F1A\u60F3\u4E00\u4E9B\u5947\u5947\u602A\u602A\u7684\u4E8B\u60C5\u2026\u2026$h",
    "GreenRain": "\u8FD9\u4E9B\u690D\u7269\u662F\u4ECE\u54EA\u6765\u7684\uFF1F\u6709\u70B9\u60CA\u559C\uFF0C\u6211\u89C9\u5F97\u8FD8\u633A\u597D\u7684\u2026\u2026",
    "GreenRainFinished": "\u9547\u4E0A\u7684\u5927\u4F19\u662F\u4E0D\u662F\u90FD\u88AB\u5947\u602A\u7684\u96E8\u5413\u5230\u4E86\uFF1F\u6211\u7684\u8BDD\u2026\u2026\u6211\u53CD\u800C\u89C9\u5F97\u8FD9\u573A\u96E8\u592A\u597D\u4E86\uFF01$h",
    "GreenRain_2": "\u5047\u5982\u8FD9\u573A\u96E8\u4E0B\u4E00\u6574\u4E2A\u590F\u5929\u2026\u2026\u661F\u9732\u8C37\u91CC\u80AF\u5B9A\u4F1A\u957F\u6EE1\u690D\u7269\uFF01",
    "Introduction": "\u4F60\u597D\uFF0C\u5F88\u9AD8\u5174\u89C1\u5230\u4F60\u3002$h#$e#\u4F60\u642C\u8FC7\u6765\u7684\u65F6\u673A\u9009\u5F97\u633A\u597D\u561B\u2026\u2026\u8FD9\u91CC\u7684\u6625\u5929\u975E\u5E38\u8FF7\u4EBA\u3002",
