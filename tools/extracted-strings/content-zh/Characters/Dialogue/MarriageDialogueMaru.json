    "Good_1": "\u65E2\u7136\u6211\u4EEC\u4F4F\u5728\u4E00\u8D77\u4E86\uFF0C\u90A3\u5C31\u5F88\u96BE\u518D\u60F3\u8C61\u4E00\u4E2A\u4EBA\u7684\u751F\u6D3B\u4E86\u3002",
    "Good_2": "\u5728\u4F11\u606F\u5417\uFF1F\u5F88\u597D\u5440\uFF01",
    "Good_3": "\u89C4\u5212\u548C\u7BA1\u7406\u519C\u573A\u65F6\u9700\u8981\u8003\u8651\u5F88\u591A\u65B9\u9762\u3002\u8FD9\u6BD4\u6211\u60F3\u7684\u66F4\u52A0\u8D39\u8111\uFF01",
    "Good_4": "\u6211\u66FE\u7ECF\u8003\u8651\u8FC7\u9020\u4E00\u4E2A\u673A\u5668\u8001${\u516C^\u5A46}$\u3002\u4F46\u662F\u4F60\u66F4\u6709\u8DA3\uFF01$h",
    "Good_5": "\u6211\u521A\u521A\u5728\u6B23\u8D4F\u6211\u7684\u5A5A\u793C\u62A4\u8EAB\u7B26\u5462\u2026\u2026\u8FD9\u8D1D\u58F3\u5B8C\u7F8E\u65E0\u7455\u3002\u8FD9\u662F\u5F88\u7F55\u89C1\u7684\u6807\u672C\u3002$l",
    "Good_6": "\u6628\u665A\uFF0C\u6211\u68A6\u5230\u6211\u4F7F\u7528\u4E00\u67B6\u5DE8\u5927\u7684\u671B\u8FDC\u955C\u3002\u6211\u770B\u89C1%noun\u661F\u4E91\u91CC\u9762\u6709\u4E1C\u897F\u5728\u79FB\u52A8\u3002\u6709\u70B9\u5413\u4EBA\u3002",
    "Indoor_Day_0": "\u55EF\uFF1F\u62B1\u6B49\uFF0C\u6709\u65F6\u5019\u6211\u4F1A\u6C89\u6D78\u5728\u81EA\u5DF1\u7684\u601D\u7EEA\u91CC\uFF0C\u751A\u81F3\u6CA1\u6709\u610F\u8BC6\u5230\u81EA\u5DF1\u5728\u5E72\u4EC0\u4E48\u3002",
    "Indoor_Day_1": "\u6211\u5728\u5E9F\u6599\u5806\u91CC\u627E\u5230\u4E86\u8FD9\u4E2A\u3002\u4F60\u89C9\u5F97\u80FD\u628A\u5B83\u6D3E\u4E0A\u7528\u573A\u5417\uFF1F [286 287 205 732]",
    "Indoor_Day_2": "\u4F60\u7EC8\u4E8E\u8D77\u5E8A\u4E86\uFF01\u6211\u597D\u997F\u2026\u2026*\u809A\u5B50\u5495\u5495\u53EB*$h",
    "Indoor_Day_3": "\u751F\u6D3B\u5728\u519C\u573A\u6700\u68D2\u7684\u4E8B\u60C5\u4E4B\u4E00\u5C31\u662F\u65E9\u4E0A\u5728\u9E1F\u513F\u7684\u6B4C\u58F0\u4E2D\u9192\u6765\u3002",
    "Indoor_Day_4": "\u4F60\u662F\u600E\u4E48\u5728\u5E72\u4E86\u90A3\u4E48\u591A\u519C\u6D3B\u7684\u60C5\u51B5\u4E0B\u8FD8\u8BA9\u624B\u4FDD\u6301\u67D4\u8F6F\u7684\uFF1F",
    "Indoor_Night_0": "\u4ECA\u665A\u4F60\u770B\u5230\u6708\u5149\u4E86\u5417\uFF1F\u5728\u5730\u5E73\u7EBF\u4E0A\u6708\u4EAE\u770B\u8D77\u6765\u5F88\u58EE\u89C2\u3002",
    "Indoor_Night_1": "\u6211\u4E4B\u524D\u770B\u5230\u8FC7\u6D41\u661F\u3002\u6211\u559C\u6B22\u5047\u88C5\u662F\u739B\u4E3D\u5C14\u8FBE\u8FC7\u6765\u5DE1\u89C6\u6211\u4EEC\u3002$h",
    "Indoor_Night_2": "\u6211\u51B3\u5B9A\u4E0D\u4E86\u662F\u60F3\u5403\u5DE7\u514B\u529B\u86CB\u7CD5\u8FD8\u662F\u719F\u8349\u8393\u3002\u6216\u8005\u90FD\u60F3\u2026\u2026\uFF1F#$e#\u8BF4\u5B9E\u8BDD\u2026\u2026\u6211\u662F\u6B63\u5728\u957F\u80D6\u5417\uFF1F$s",
    "Indoor_Night_3": "\u4F60\u4ECA\u5929\u5E72\u5F97\u4E0D\u9519\uFF01\u665A\u4E0A\u7684\u5269\u4F59\u65F6\u95F4\u4F60\u5E94\u8BE5\u653E\u677E\u4E00\u4E0B\u3002",
    "Indoor_Night_4": "\u6211\u771F\u7684\u5F00\u59CB\u7231\u4E0A\u8FD9\u8001\u623F\u5B50\u4E86\u3002\u665A\u4E0A\u5F88\u60EC\u610F\u3002#$e#\u5988\u5988\u628A\u8FD9\u91CC\u6539\u8FDB\u5F97\u5F88\u68D2\u3002$h",
    "Neutral_0": "\u6211\u5E0C\u671B\u5373\u4F7F\u6211\u957F\u80D6\u4E86\u4F60\u8FD8\u662F\u4F1A\u559C\u6B22\u6211\u3002",
    "Neutral_8": "\u6211\u4ECA\u5929\u6CA1\u6709\u7075\u611F\u2026\u2026$s",
    "OneKid_0": "\u4F60\u4ECA\u5929\u6709\u82B1\u65F6\u95F4\u966A%kid1\u73A9\u800D\u5417\uFF1F\u5B69\u5B50\u4EEC\u9700\u8981\u6E38\u620F\u65F6\u95F4\u624D\u80FD\u5145\u5206\u53D1\u6325\u6F5C\u529B\u3002",
    "OneKid_1": "\u4F60\u89C9\u5F97\u2026\u2026%kid1\u5C06\u6765\u4F1A\u4E0D\u4F1A\u6210\u4E3A\u4E00\u540D\u519C\u592B\u5462\uFF1F\u6216\u8005\u4E00\u540D\u5DE5\u7A0B\u5E08\uFF1F",
    "OneKid_3": "\u6211\u5BF9\u6211\u4EEC\u7684\u5B69\u5B50\u5BC4\u4E88\u539A\u671B\u3002\u6211\u4E00\u76F4\u5728\u770B\u5173\u4E8E\u629A\u517B\u5C0F\u5B69\u6700\u4F73\u65B9\u6CD5\u7684\u79D1\u5B66\u8D44\u6599\u3002",
    "Outdoor_0": "\u554A\u2026\u2026\u519C\u573A\u5F88\u597D\u95FB\uFF0C\u8BA9\u6211\u60F3\u8D77\u6211\u7238\u5988\u623F\u5B50\u65C1\u8FB9\u7684\u5C71\u8109\u3002",
    "Outdoor_1": "\u53EA\u8981\u7A0D\u7A0D\u89C4\u5212\u4E00\u4E0B\uFF0C\u6211\u4EEC\u5C31\u53EF\u4EE5\u8BA9\u5927\u90E8\u5206\u519C\u6D3B\u513F\u81EA\u52A8\u8FDB\u884C\uFF0C\u6211\u4EEC\u653E\u677E\u5C31\u884C\u4E86\uFF01",
    "Outdoor_2": "\u4ECA\u665A\u4F1A\u662F\u6674\u7A7A\u2026\u2026\u6211\u5728\u60F3\u662F\u5426\u53EF\u4EE5\u770B\u89C1%noun\u661F\u5EA7\u5417\uFF1F",
    "Outdoor_3": "\u522B\u62C5\u5FC3\uFF0C\u5982\u679C\u4F60\u628A\u6CE5\u5DF4\u5E26\u8FDB\u623F\u5B50\u6211\u662F\u4E0D\u4F1A\u4ECB\u610F\u7684\u3002\u5076\u5C14\u5F04\u810F\u4E00\u4E0B\u4E5F\u5F88\u6709\u8DA3\u3002",
    "Outdoor_4": "\u6211\u4ECE\u6765\u6CA1\u610F\u8BC6\u5230\u7BA1\u7406\u4E00\u4E2A\u519C\u573A\u9700\u8981\u591A\u5C11\u7CBE\u529B\u548C\u89C4\u5212\uFF01\u7B80\u76F4\u5C31\u50CF\u662F\u5B9E\u9A8C\u5BA4\u7684\u5DE5\u4F5C\u3002",
    "Rainy_Day_0": "\u6211\u5F88\u597D\u5947\u6F58\u59AE\u600E\u4E48\u6837\u4E86\uFF1F\u4E5F\u8BB8\u7B49\u4E0B\u6211\u4F1A\u6253\u7ED9\u5979\u3002",
    "Rainy_Day_1": "\u6211\u53EA\u662F\u5728\u5E7B\u60F3\u2026\u2026\u4F60\u89C9\u5F97\u739B\u4E3D\u5C14\u8FBE\u8FD8\u597D\u5417\uFF1F\u6211\u5E0C\u671B\u5979\u80FD\u627E\u5230\u5979\u771F\u6B63\u5C5E\u4E8E\u7684\u5730\u65B9\u2026\u2026",
    "Rainy_Day_2": "\u563F\uFF01\u6211\u6628\u5929\u6709\u70B9\u5931\u7720\uFF0C\u6240\u4EE5\u6211\u5728\u6211\u7684\u5DE5\u4F5C\u95F4\u6363\u9F13\u4E86\u4E00\u4F1A\u513F\u3002\u770B\uFF0C\u8FD9\u662F\u6211\u4E3A\u4F60\u51C6\u5907\u7684\u3002[688 369 338 325 287]#$e#\u6211\u5E0C\u671B\u4F60\u80FD\u7528\u5F97\u4E0A\u3002",
    "Rainy_Day_3": "\u6211\u552F\u4E00\u4E0D\u559C\u6B22\u96E8\u5929\u7684\u4E00\u70B9\u662F\u6211\u770B\u4E0D\u5230\u661F\u661F\uFF01",
    "Rainy_Day_4": "\u6211\u662F\u542C\u5230\u5C4B\u9876\u5728\u6F0F\u6C34\u5417\uFF1F\u6211\u8981\u68C0\u67E5\u4E00\u4E0B\u3002\u6211\u4ECE\u770B\u6211\u5988\u5988\u5E72\u6D3B\u5B66\u4E86\u4E00\u70B9\u6728\u5320\u6D3B\u513F\u3002",
    "Rainy_Night_0": "\u522B\u8BA9\u5DE5\u5177\u6DCB\u5728\u96E8\u91CC\uFF01\u8981\u662F\u5B83\u4EEC\u751F\u9508\u5C31\u4E0D\u597D\u529E\u4E86\u3002",
    "Rainy_Night_1": "\u55E8\uFF0C@\u3002\u8FD9\u4E48\u6F6E\u6E7F\u2026\u2026\u4F60\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F#$e#\u8FD9\u5929\u6C14\u8BA9\u6211\u60F3\u5230\u4E00\u4E9B\u5173\u4E8E\u5C0F\u73A9\u610F\u513F\u7684\u70B9\u5B50\u2026\u2026\u5982\u679C\u6211\u628A\u96E8\u6C34\u96C6\u4E2D\u8D77\u6765\uFF0C\u6216\u8BB8\u53EF\u4EE5\u63A8\u52A8\u4E00\u4E2A\u78E8\u574A\uFF1F",
    "Rainy_Night_2": "\u7238\u7238\u8FFD\u8E2A\u4E86\u8FC7\u53BB\u4E8C\u5341\u5E74\u7684\u5929\u6C14\u89C4\u5F8B\u3002#$e#\u73B0\u5728\u8BF4\u6709\u70B9\u592A\u65E9\u4E86\uFF0C\u4F46\u662F\u7ED3\u679C\u663E\u793A\u4E86\u4E00\u4E9B\u53CD\u5E38\u8D8B\u52BF\u3002",
    "Rainy_Night_3": "\u4ECA\u5929\u6211\u4EEC\u53EF\u4EE5\u5728\u5E8A\u4E0A\u5403\u610F\u5927\u5229\u9762\u6761\u5417\uFF1F",
    "Rainy_Night_4": "\u6211\u505A\u4E86\u4E00\u4E9B\u70B9\u5FC3\uFF01\u4F46\u662F\u5728\u4E0A\u5E8A\u524D\u8BB0\u5F97\u5237\u7259\u3002 [232 234 223 220]$h",
    "Rainy_Night_5": "\u4ECA\u5929\u6211\u8FC7\u5F97\u5E73\u6DE1\u65E0\u5E38\u2026\u2026\u56E0\u4E3A\u5929\u6C14\u539F\u56E0\u6211\u4E00\u76F4\u5F85\u5728\u5C4B\u5B50\u91CC\u3002#$e#\u4F46\u662F\u6211\u5F88\u653E\u677E\u3002\u9605\u8BFB\u6700\u65B0\u4E00\u671F\u7684\u201C\u6BCF\u5468\u56FE\u8868\u201D\u53C8\u8BA9\u6211\u5FC3\u60C5\u597D\u8D77\u6765\u4E86\u3002",
    "TwoKids_3": "\u6211\u81EA\u5DF1\u7684\u5DE5\u4F5C\u95F4\uFF0C\u4E24\u4E2A\u5F88\u68D2\u7684\u5B69\u5B50\u8FD8\u6709\u4E00\u65B9\u7F8E\u4E3D\u7684\u571F\u5730\u3002\u751F\u6D3B\u771F\u7F8E\u597D\u3002",
    "fall_1": "\u5728\u6BCF\u4E2A\u5B63\u8282\uFF0C\u591C\u7A7A\u4E2D\u90FD\u6709\u4E00\u7247\u65B0\u7684\u90E8\u5206\u53D8\u5F97\u6108\u53D1\u660E\u663E\u3002\u89C1\u8BC1\u8FD9\u4E00\u5E55\u4EE4\u4EBA\u9676\u9189\u3002",
    "fall_25": "\u51AC\u5929\u8FD1\u5728\u773C\u524D\u3002\u6211\u4EEC\u9700\u8981\u518D\u6B21\u68C0\u67E5\u4E00\u4E0B\u4F9B\u6696\u7CFB\u7EDF\uFF0C\u5173\u6389\u6C34\u9600\uFF0C\u67E5\u770B\u623F\u95F4\u6240\u6709\u7684\u4FDD\u6E29\u5C42\u3002#$e#\u4EB2\u7231\u7684\uFF0C\u522B\u62C5\u5FC3\u3002\u6211\u4F1A\u7167\u6599\u597D\u4E00\u5207\u7684\u3002",
    "fall_3": "\u79CB\u5929\u603B\u662F\u8BA9\u6211\u60F3\u8D77\u548C\u5988\u5988\u51FA\u53BB\u4F10\u6728\u7684\u65F6\u5019\u2026\u2026\u53EF\u80FD\u662F\u56E0\u4E3A\u65B0\u4F10\u6728\u6750\u548C\u6C41\u6DB2\u7684\u5473\u9053\u5427\u3002",
    "fall_Maru": "\u519C\u573A\u751F\u6D3B\u592A\u68D2\u5566\uFF0C\u4F46\u6211\u5F88\u9AD8\u5174\u6211\u8FD8\u5728\u8BCA\u6240\u5DE5\u4F5C\u2026\u2026\u533B\u7597\u670D\u52A1\u5BF9\u793E\u533A\u6765\u8BF4\u81F3\u5173\u91CD\u8981\u3002",
    "funLeave_Maru": "\u6211\u60F3\u6211\u4ECA\u5929\u4F1A\u53BB\u770B\u770B\u6211\u7684\u7236\u6BCD\u3002\u6211\u6709\u4E00\u6BB5\u65F6\u95F4\u6CA1\u89C1\u8FC7\u4ED6\u4EEC\u4E86\u3002",
    "funReturn_Maru": "\u5988\u5988\u548C\u7238\u7238\u90FD\u5F88\u597D\u3002\u4ED6\u4EEC\u7684\u65E5\u5E38\u751F\u6D3B\u8FD8\u662F\u90A3\u6837\uFF0C\u5373\u4F7F\u662F\u5728\u6211\u8D70\u4E4B\u540E\u3002\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F",
    "patio_Maru": "\u76EE\u524D\u6211\u8FD8\u4E0D\u80FD\u786E\u5B9A\u8FD9\u662F\u4EC0\u4E48\u2026\u2026\u4F46\u662F\u4E0D\u65F6\u8F6C\u4E00\u4E0B\u8FD9\u4E2A\u65E7\u6273\u624B\u8FD8\u86EE\u6709\u8DA3\u7684\u3002",
    "spouseRoom_Maru": "#$c .5#\u4ECA\u5929\u6211\u63D0\u65E9\u8D77\u6765\u770B\u4E86\u4F1A\u661F\u661F\u3002#$e#\u751C\u5FC3\uFF0C\u6211\u4ECA\u5929\u8981\u53BB\u505A\u6211\u7684\u9879\u76EE\uFF0C\u5E0C\u671B\u4F60\u4E0D\u4F1A\u4ECB\u610F\u3002",
    "spring_1": "\u6625\u5929\u770B\u5230\u4E07\u7269\u590D\u82CF\u7684\u611F\u89C9\u771F\u68D2\u3002",
    "spring_2": "\u90A3\u4E48\u4F60\u4ECA\u5929\u5B8C\u5584\u519C\u573A\u7684\u7B56\u7565\u662F\u4EC0\u4E48\uFF1F",
    "spring_22": "\u6211\u6709\u65F6\u60F3\u9080\u8BF7\u6211\u54E5\u54E5\u5171\u8FDB\u665A\u9910\uFF0C\u53EF\u662F\u4ED6\u4E0D\u613F\u51FA\u95E8\u3002",
    "spring_Maru": "\u65B0\u7684\u4E00\u5E74\u8015\u79CD\u5F00\u59CB\u4E86\uFF0C\u6211\u597D\u5174\u594B\u554A\uFF0C@\uFF01$h",
    "summer_2": "\u6211\u559C\u6B22\u628A\u590F\u5929\u770B\u5230\u7684\u4E0D\u540C\u6606\u866B\u5206\u7C7B\u3002",
    "summer_20": "\u4E0D\u77E5\u9053\u6211\u54E5\u54E5\u662F\u5426\u6709\u52C7\u6C14\u9080\u8BF7\u963F\u6BD4\u76D6\u5C14\u51FA\u53BB\uFF1F",
    "summer_Maru": "\u665A\u4E0A\u597D\u6696\u548C\uFF0C\u8FD9\u771F\u662F\u4E00\u5E74\u4E2D\u6700\u9002\u5408\u89C2\u661F\u7684\u65F6\u671F\uFF01\u8C01\u77E5\u9053\u8FD9\u91CC\u4F1A\u51FA\u73B0\u4EC0\u4E48\u5462\uFF1F",
    "winter_15": "\u8FD1\u6765\uFF0C\u51AC\u5929\u7B80\u76F4\u6E29\u548C\u5F97\u4EE4\u4EBA\u4E0D\u5B89\u3002",
    "winter_2": "\u90A3\u4E48\uFF0C\u8FD9\u4E2A\u51AC\u5929\u4F60\u6253\u7B97\u5982\u4F55\u7EF4\u6301\u6211\u4EEC\u7684\u6536\u76CA\u5462\uFF1F#$e#\u4F60\u53EF\u4EE5\u9493\u9C7C\u6216\u53BB\u91CE\u5916\u91C7\u96C6\u2026\u2026#$e#\u5982\u679C\u4F60\u6253\u7B97\u91C7\u77FF\uFF0C\u7B54\u5E94\u6211\u8981\u591A\u52A0\u5C0F\u5FC3\u3002",
    "winter_5": "\u6211\u5E0C\u671B\u6211\u7238\u7238\u6700\u8FD1\u8FC7\u5F97\u8FD8\u597D\u2026\u2026\u56E0\u4E3A\u51FA\u95E8\u7684\u673A\u4F1A\u5C11\uFF0C\u4ED6\u5728\u51AC\u5929\u7684\u65F6\u5019\u4F1A\u6291\u90C1\u3002",
    "winter_Maru": "\u6625\u5929\u6211\u5341\u5206\u671F\u5F85\u5927\u9EC4\u6D3E\u5462\u3002\u5662\u2026\u2026\u90A3\u6C14\u5473\uFF0C\u90A3\u5473\u9053\uFF01"
