    "AcceptBirthdayGift_Negative": "\u662F\u7ED9\u6211\u7684\u751F\u65E5\u793C\u7269\u5417\uFF1F\u8FD9\u4E2A\uFF0C\u5443\u2026\u2026\u5F88\u8010\u4EBA\u5BFB\u5473\uFF0C\u4E0D\u8FC7\u4F60\u80FD\u8BB0\u5F97\uFF0C\u6211\u8FD8\u662F\u5F88\u611F\u6FC0\u3002",
    "AcceptBirthdayGift_Positive": "\u4E00\u822C\u4E0D\u4F1A\u6709\u4EBA\u9001\u6211\u751F\u65E5\u793C\u7269\u3002@\uFF0C\u6211\u5F88\u611F\u52A8\uFF0C\u8C22\u8C22\u4F60\u3002",
    "AcceptGift_(O)SkillBook_3": "\u55EF\uFF0C\u5F88\u6709\u610F\u601D\u2026\u2026\u8FD9\u4E66\u5728\u661F\u9732\u8C37\u53EF\u4E0D\u5BB9\u6613\u5F04\u5230\u3002#$b#\u91CC\u9762\u597D\u50CF\u6709\u5F88\u591A\u5B9E\u7528\u7684\u5EFA\u8BAE\uFF0C\u8C22\u8C22\u4F60\uFF0C@\u3002",
    "AcceptGift_(O)StardropTea": "\u8FD9\u4E2A\u662F\u2026\u2026\u8981\u9001\u7ED9\u6211\u7684\uFF1F\u5B9E\u5728\u662F\u592A\u8D35\u91CD\u4E86\u2026\u2026\u8C22\u8C22\u4F60\u3002",
    "Fri": "\u8FD9\u5929\u6C14\u5BF9\u6211\u6765\u8BF4\u5012\u4E0D\u662F\u4EC0\u4E48\u5927\u95EE\u9898\u3002\u901A\u5E38\u6765\u8BF4\u6211\u4E00\u6574\u5E74\u90FD\u5728\u5E97\u9644\u8FD1\u8F6C\u60A0\u3002#$e#\u542C\u8D77\u6765\u6709\u70B9\u618B\u5C48\u5427\uFF1F",
    "Fri8": "\u6211\u5E94\u8BE5\u6512\u94B1\u4E70\u53F0\u7535\u8111\u2026\u2026#$e#\u5728\u201C\u4E92\u8054\u7F51\u201D\u4E0A\u8BF4\u4E0D\u5B9A\u80FD\u627E\u5230\u5973\u670B\u53CB\u2026\u2026$s#$e#\u4EC0\u4E48\uFF1F\u4F60\u522B\u770B\u4E0D\u8D77\u6211\uFF01\u53C8\u4E0D\u662F\u6240\u6709\u4EBA\u90FD\u957F\u5F97\u5E05\uFF0C\u6709\u9B45\u529B\uFF0C\u5584\u4E8E\u793E\u4EA4\uFF0C\u8FD8\u6709\u81EA\u5DF1\u7684\u519C\u573A\u7684\uFF01$u#$e#\u6211\u8FD9\u79CD\u4EBA\u5230\u5E95\u8981\u548B\u529E\u554A\uFF1F\u54CE\u54DF\u2026\u2026$s",
    "GreenRain": "\u8FD9\u79CD\u60C5\u51B5\u624D\u662F\u771F\u6B63\u8003\u9A8C\u4E00\u4E2A\u4EBA\u6709\u6CA1\u6709\u52C7\u6C14\u3002#$e#\u6211\u4F1A\u4FDD\u62A4\u827E\u2026\u2026\u90A3\u4EC0\u4E48\uFF0C\u6211\u4F1A\u4FDD\u62A4\u5927\u5BB6\u4E0D\u8981\u6DCB\u5230\u6709\u6BD2\u7684\u96E8\u6C34\uFF01",
    "GreenRainFinished": "\u96F7\u58F0\u5927\u96E8\u70B9\u5C0F\u554A\uFF0C\u6211\u8FD8\u4EE5\u4E3A\u603B\u7B97\u80FD\u5F53\u4E00\u56DE\u82F1\u96C4\u4E86\u3002\u5509\u2026\u2026\u7EE7\u7EED\u5E72\u6D3B\u5427\u3002",
    "GreenRain_2": "\u6709\u65F6\u5019\u6211\u771F\u5E0C\u671B\u6765\u4E00\u573A\u8D27\u771F\u4EF7\u5B9E\u7684\u5929\u707E\uFF0C\u800C\u4E0D\u662F\u8FD9\u4E2A\u7834\u7EFF\u96E8\u2014\u2014\u6211\u77E5\u9053\u8FD9\u60F3\u6CD5\u5F88\u7CDF\u7CD5\u3002#$b#\u5F97\u662F\u90A3\u79CD\uFF0C\u60CA\u5929\u52A8\u5730\u7EA7\u522B\u7684\u3002#$b#\u6211\u4E0D\u662F\u60F3\u8981\u6709\u4EBA\u53D7\u4F24\u2026\u2026#$b#\u6211\u53EA\u662F\u60F3\u8981\u6709\u6D3B\u7740\u7684\u611F\u89C9\u2026\u2026\u6709\u4EBA\u751F\u7684\u76EE\u6807\u2026\u2026",
    "Introduction": "\u5443\u2026\u2026\u55E8\u3002\u6211\u662F\u514B\u6797\u7279\u3002#$e#\u6211\u662F\u8FD9\u4E2A\u5C0F\u9547\u7684\u94C1\u5320\u3002\u8981\u662F\u60F3\u5347\u7EA7\u519C\u5177\u7684\u8BDD\uFF0C\u5C31\u6765\u627E\u6211\u5427\u3002",
    "Mon": "\u6CA1\u9519\u3002\u6211\u662F\u4E2A\u94C1\u5320\u3002#$e#\u6211\u7236\u4EB2\u4EE5\u524D\u4E5F\u662F\u4E00\u540D\u94C1\u5320\u3002#$e#\u6211\u7684\u7956\u7236\u4E5F\u662F\u4E00\u540D\u94C1\u5320\u3002$u#$q 9/9 Mon_old#\u4F60\u4E00\u5B9A\u731C\u4E0D\u5230\u6211\u7684\u66FE\u7956\u7236\u4EE5\u524D\u662F\u4E00\u540D\u2026\u2026#$r 9 30 Mon_9#\u94C1\u5320\u3002#$r 9 50 Mon_clown#\u4E00\u4E2A\u7CCA\u6D82\u7684\u5C0F\u4E11#$r 9 -50 Mon_rude#\u4E00\u4E2A\u5C16\u9178\u523B\u8584\u7684\u6DF7\u86CB\u3002",
    "Mon4": "\u771F\u7FA1\u6155\u4F60\u662F\u4E2A\u519C\u6C11\u554A\uFF0C@\u3002\u5728\u6237\u5916\u5DE5\u4F5C\u53EF\u6BD4\u6574\u5929\u5728\u70ED\u817E\u817E\u7684\u5927\u706B\u7089\u65C1\u8FB9\u597D\u591A\u4E86\u3002#$e#\u6211\u5F53\u8FD9\u4E2A\u94C1\u5320\u90FD\u662F\u56E0\u4E3A\u6211\u7238\u7238\u975E\u8981\u8BA9\u6211\u5F53\u554A\u3002",
    "Mon8": "\u6211\u4E0D\u5F97\u4E0D\u627F\u8BA4\uFF0C\u6709\u65F6\u5019\u6211\u8FD8\u633A\u5E86\u5E78\u6211\u7236\u4EB2\u5F53\u521D\u903C\u6211\u5F53\u94C1\u5320\uFF0C\u73B0\u5728\u6211\u81F3\u5C11\u6709\u4E00\u4EFD\u751F\u8BA1\u3002#$e#\u5047\u5982\u6211\u8FDE\u53EF\u4EE5\u5E72\u7684\u6D3B\u90FD\u6CA1\u6709\uFF0C\u6211\u5927\u6982\u53EA\u597D\u6574\u5929\u65E0\u6240\u4E8B\u4E8B\uFF0C\u4E0D\u505C\u5730\u611F\u5230\u540E\u6094\u3002$s",
    "Mon_9": "\u4F60\u600E\u4E48\u77E5\u9053\u7684\uFF1F$u",
    "Mon_clown": "\u54C8\u54C8\u54C8\u3002\u731C\u5F97\u597D\u3002$h",
    "Mon_old": "\u6CA1\u9519\u3002\u6211\u7684\u66FE\u7956\u7236\u4E5F\u662F\u540D\u94C1\u5320\u3002",
    "Mon_rude": "\u5594\u3002\u8FD9\u6837\u53EF\u5F88\u65E0\u793C\u54E6\u3002\u6211\u4E0D\u8FC7\u662F\u60F3\u5F00\u4E2A\u73A9\u7B11\u7F62\u4E86\uFF0C\u4F60\u5374\u628A\u8FD9\u4EF6\u4E8B\u641E\u4E25\u91CD\u4E86\u3002",
    "Resort": "\u5509\u2026\u2026\u5927\u5BB6\u90FD\u6765\u6C99\u6EE9\u4E0A\u4E86\uFF0C\u4F46\u6211\u8FD8\u662F\u611F\u89C9\u5F88\u5B64\u72EC\u2026\u2026$s",
    "Resort_Bar": "\u6211\u997F\u4E86\u2026\u2026$s",
    "Resort_Chair": "\u55F7\u2026\u2026\u6211\u611F\u89C9\u6211\u7684\u8EAB\u4F53\u90FD\u8981\u88AB\u70E4\u9165\u4E86\u3002$s",
    "Resort_Entering": "\u6211\u8981\u7A7F\u4E0A\u6211\u7684\u7279\u5236\u7EA2\u8272\u77ED\u88E4\uFF0C\u5E94\u8BE5\u975E\u5E38\u5438\u5F15\u773C\u7403\u3002",
    "Resort_Leaving": "\u55EF\uFF0C\u7ED3\u679C\u8DDF\u6211\u60F3\u7684\u4E0D\u592A\u4E00\u6837\u2026\u2026",
    "Resort_Shore": "\u54CE\u5440\u2026\u2026\u6211\u5FD8\u4E86\u526A\u811A\u8DBE\u7532\u4E86\u3002$s",
    "Resort_Shore_2": "\u6211\u4EE5\u4E3A\u8DDF\u7194\u7089\u6253\u4EA4\u9053\u4F1A\u8BA9\u6211\u9002\u5E94\u9AD8\u6E29\uFF0C\u4F46\u73B0\u5728\u6211\u8EAB\u4E0A\u5230\u5904\u90FD\u5728\u6D41\u6C57\u3002$s#$e#\u6211\u5E0C\u671B\u6CA1\u4EBA\u6CE8\u610F\u5230\u2026\u2026#$e#%\u514B\u6797\u7279\u7684\u8EAB\u4F53\u6B63\u5728\u95EA\u95EA\u53D1\u4EAE\u2026\u2026",
    "Sat": "\u6709\u65F6\u5019\u6211\u8FD8\u4F1A\u60F3\u60F3\u6211\u5728\u8FD9\u4E2A\u5C0F\u9547\u6700\u7EC8\u4F1A\u600E\u4E48\u6837\u3002$u",
    "Sat10": "\u4F60\u7684\u5DE5\u5177\u72B6\u6001\u600E\u4E48\u6837\uFF1F#$b#\u5982\u679C\u9700\u8981\u4FEE\u7406\u7684\u8BDD\uFF0C\u76F4\u63A5\u6765\u6211\u5E97\u91CC\uFF0C\u6211\u7ED9\u4F60\u7EC8\u8EAB\u4FDD\u4FEE\uFF01",
    "Sat6": "\u8BE5\u6B7B\uFF0C\u6211\u8FD9\u5C81\u6570\u5DF2\u7ECF\u6CA1\u6CD5\u518D\u505A\u4EC0\u4E48\u523A\u6FC0\u7684\u4E8B\u60C5\u4E86\u3002\u6211\u80FD\u505A\u7684\u53EA\u5269\u4E0B\u5728\u8FD9\u707C\u70ED\u7684\u94C1\u7089\u8FB9\u4E0A\u5927\u6C57\u6DCB\u6F13\u5730\u5E72\u94C1\u5320\u6D3B\u4E86\u3002",
    "Sun": "\u4F60\u6CA1\u6D3B\u5E72\u5417\uFF1F",
    "Sun4": "\u4F60\u7684\u90A3\u4E9B\u5DE5\u5177\u73B0\u5728\u7528\u5F97\u600E\u4E48\u6837\uFF1F",
    "Sun8": "\u6211\u5176\u5B9E\u5BF9\u81EA\u5DF1\u7684\u5DE5\u4F5C\u5F88\u81EA\u8C6A\uFF0C\u4E0D\u8FC7\u53EF\u80FD\u6CA1\u4EBA\u610F\u8BC6\u5230\uFF0C\u4E5F\u6CA1\u4EBA\u5728\u610F\u3002#$e#\u6211\u8DDF\u4F60\u8BF4\u2026\u2026\u6211\u5C0F\u65F6\u5019\u7684\u68A6\u60F3\u4E0D\u662F\u5F53\u94C1\u5320\uFF0C\u53EF\u662F\u73B0\u5728\u6211\u6210\u4E3A\u94C1\u5320\u4E86\uFF0C\u800C\u4E14\u6211\u60F3\u5F53\u6700\u597D\u7684\u94C1\u5320\u3002",
    "Thu": "\u6700\u8FD1\u751F\u610F\u5F88\u51B7\u6E05\u554A\u3002#$e#\u4F60\u8BE5\u5347\u7EA7\u4E0B\u4F60\u7684\u5DE5\u5177\u4E86\u3002\u8FD9\u6837\u6211\u4E5F\u80FD\u6323\u4E00\u7B14\u3002",
    "Thu8": "\u6211\u542C\u8BF4\u827E\u7C73\u4E3D\u6709\u4E00\u4E2A\u670B\u53CB\u4F4F\u5728\u6C99\u6F20\uFF0C\u4F60\u4E86\u89E3\u5979\u5417\uFF1F#$e#\u4E0D\u77E5\u9053\u5979\u662F\u4E0D\u662F\u5355\u8EAB\u5462\u2026\u2026$s",
    "Tue": "\u5982\u679C\u4F60\u60F3\u627E\u6211\u5347\u7EA7\u5DE5\u5177\u7684\u8BDD\uFF0C\u5C31\u5F97\u7ED9\u6211\u627E\u6765\u5408\u9002\u7684\u77FF\u77F3\u3002#$e#\u5F53\u7136\u4E86\uFF0C\u4E5F\u5F97\u4ED8\u6211\u4E9B\u94B1\u554A\u3002",
    "Wed": "\u563F\u3002\u8981\u70B9\u4EC0\u4E48\uFF1F",
    "Wed6": "\u554A\uFF0C\u4F60\u597D\uFF0C@\u3002\u771F\u62B1\u6B49\uFF0C\u6211\u8EAB\u4E0A\u6709\u70B9\u810F\u3002\u6211\u4E00\u6574\u4E2A\u65E9\u6668\u90FD\u5728\u8FD9\u4E2A\u706B\u7089\u8FB9\u4E0A\u5DE5\u4F5C\u3002$h#$e#\u8BDD\u8BF4\u56DE\u6765\uFF0C\u4F60\u6709\u4EC0\u4E48\u9700\u8981\u5462\uFF0C\u8FD8\u662F\u53EA\u662F\u6765\u770B\u770B\uFF1F",
    "cc_Minecart": "\u4E0D\u77E5\u600E\u7684\uFF0C\u65E7\u57CE\u7684\u77FF\u8F66\u7CFB\u7EDF\u53C8\u5F00\u59CB\u8FD0\u4F5C\u4E86\u3002\u5BF9\u4E8E\u5F80\u8FD4\u77FF\u5C71\u6765\u8BF4\uFF0C\u8FD9\u5341\u5206\u4FBF\u5229\u3002#$b#\u4F46\u662F\u4E0D\u662F\u5F88\u8212\u670D\u2026\u2026\u5982\u679C\u5B83\u53EF\u4EE5\u7A81\u7136\u542F\u7528\uFF0C\u5B83\u4E5F\u4F1A\u7A81\u7136\u5173\u95ED\u2026\u2026",
    "dating_Emily": "\u5443\u2026\u2026\u6211\u542C\u8BF4\u4F60\u8DDF\u827E\u7C73\u4E3D\u5728\u4E00\u8D77\u4E86\uFF0C\u606D\u559C\u4F60\u3002$s",
    "divorced_Emily": "\u6700\u8FD1\u6211\u83AB\u540D\u611F\u89C9\u81EA\u5DF1\u6709\u70B9\u5E0C\u671B\u3002",
    "eventSeen_101_memory_oneweek": "\u827E\u7C73\u4E3D\u6709\u63D0\u5230\u6211\u4EEC\u524D\u51E0\u5929\u7684\u7EA6\u4F1A\u5417\uFF1F#$b#\u7B49\u7B49\uFF0C\u8FD8\u662F\u522B\u8BF4\u4E86\u2026\u2026\u6211\u8FD8\u662F\u4E0D\u8981\u77E5\u9053\u4E86\uFF0C\u8FD9\u6837\u8FD8\u80FD\u633D\u56DE\u4E00\u70B9\u5C0A\u4E25\u3002$s",
    "event_advice1": "\u597D\u5427\u2026\u2026\u6211\u8BB0\u7740\u70B9\u3002",
    "event_advice2": "\u95EE\u9898\u5C31\u5728\u8FD9\u513F\u2026\u2026\u867D\u7136\u6211\u8868\u73B0\u5F97\u5F88\u81EA\u7136\u2026\u2026\u53EF\u6211\u4ECE\u6CA1\u4F53\u9A8C\u8FC7\u6210\u529F\u7684\u611F\u89C9\u554A\u3002$s",
    "married_Emily": "%\u514B\u6797\u7279\u773C\u775B\u5F80\u4E0B\u770B\uFF0C\u4E0D\u80AF\u8DDF\u4F60\u8BF4\u8BDD\u3002",
    "mineArea_121": "\u6709\u610F\u601D\uFF0C\u4F60\u7684\u9550\u5934\u4E0A\u6709\u94F1\u77FF\u77F3\u7684\u788E\u5C51\u2026\u2026\u4F60\u662F\u4E0D\u662F\u53BB\u4E86\u6C99\u6F20\u7684\u6D1E\u7A74\uFF1F#$e#\u6211\u4E00\u76F4\u60F3\u8981\u7528\u94F1\u6765\u7194\u70BC\uFF0C\u53EF\u60DC\u4E0D\u5BB9\u6613\u5F04\u5230\u3002",
    "mineArea_40": "\u554A\uFF0C\u770B\u4F60\u9550\u5934\u4E0A\u7684\u5212\u75D5\uFF0C\u60F3\u5FC5\u4F60\u5DF2\u7ECF\u5230\u8FC7\u77FF\u4E95\u6DF1\u5C42\u4E86\u3002#$e#\u5982\u679C\u77F3\u5934\u8D8A\u6765\u8D8A\u96BE\u6572\u788E\uFF0C\u5EFA\u8BAE\u4F60\u5347\u7EA7\u4E00\u4E0B\u9550\u5934\uFF0C\u6211\u53EF\u4EE5\u5E2E\u4F60\u3002",
    "reject_868": "\u5514\u2026\u2026\u90A3\u5757\u77F3\u5934\u5F88\u6709\u610F\u601D\uFF0C\u8DDF\u6211\u4EE5\u524D\u89C1\u5230\u8FC7\u7684\u5B8C\u5168\u4E0D\u4E00\u6837\u3002#$b#\u6211\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u5904\u7406\uFF0C\u6BD5\u7ADF\u6211\u505A\u7684\u662F\u5E73\u51E1\u751F\u610F\uFF0C\u4E0D\u61C2\u8FD9\u4E9B\u6709\u9B54\u6CD5\u7684\u2026\u2026"
  }
