    "Sat": "\u5982\u679C\u672C\u5730\u7684\u5782\u9493\u4E8B\u4E1A\u80FD\u591F\u66F4\u84EC\u52C3\u4E00\u4E9B\uFF0C\u4E5F\u8BB8\u6211\u4F1A\u8003\u8651\u5F15\u8FDB\u65B0\u8D27\u3002",
    "Sat8": "\u9C7C\u9493\u7684\u600E\u4E48\u6837\u554A\uFF1F#$e#\u6211\u4E00\u6709\u673A\u4F1A\u5C31\u53BB\u9493\u9C7C\uFF0C\u4F46\u8FD8\u6709\u4E2A\u5546\u5E97\u8981\u6253\u7406\uFF0C\u6240\u4EE5\u673A\u4F1A\u5E76\u4E0D\u591A\u554A\u3002",
    "Sun": "\u5982\u679C\u8D2D\u4E70\u9AD8\u7EA7\u9C7C\u7AFF\uFF0C\u4F60\u5C31\u53EF\u4EE5\u5728\u9C7C\u7EBF\u4E0A\u6302\u4E0A\u9C7C\u9975\u548C\u9493\u5177\u3002#$b#\u9C7C\u9975\u53EF\u4EE5\u8BA9\u9C7C\u513F\u66F4\u5FEB\u54AC\u94A9\u3002\u9493\u5177\u5219\u53EF\u4EE5\u8BA9\u6536\u7EBF\u8FC7\u7A0B\u66F4\u8F7B\u677E\u3002#$e#\u9493\u5177\u4E5F\u6709\u5F88\u591A\u79CD\uFF0C\u5404\u6709\u5404\u7684\u4F18\u70B9\u3002\u8FD9\u4E9B\u4E1C\u897F\u90FD\u6BD4\u8F83\u8106\u5F31\uFF0C\u6240\u4EE5\u5982\u679C\u4F7F\u7528\u4E86\u4E00\u9635\u540E\u9493\u5177\u574F\u6389\u4E86\uFF0C\u8BF7\u4E0D\u8981\u60CA\u8BB6\u3002",
    "Sun10": "\u54CE\u5440\u5440\uFF0C\u8FD9\u4E0D\u662F@\u8239\u957F\u561B\uFF01$h#$e#\u8981\u662F\u6211\u80FD\u627F\u53D7\u5F97\u8D77\uFF0C\u6211\u5C31\u7ED9\u4F60\u7684\u9C7C\u9975\u6253\u4E2A\u6298\u3002$s",
    "Thu": "*\u561F\u561F**\u56D4\u56D4*\u2026\u2026\u4EC0\u4E48\uFF1F\u6211\u5176\u5B9E\u633A\u60F3\u628A\u6211\u7684\u60F3\u6CD5\u8DDF\u4F60\u8BF4\u8BF4\uFF0C\u4F46\u90FD\u662F\u4E9B\u6E14\u592B\u7684\u79D8\u5BC6\u3002",
    "Thu2": "\u636E\u8BF4\u8FD9\u4E00\u7247\u6C34\u57DF\u6709\u5F88\u7A00\u6709\u7684\u9C7C\u51FA\u73B0\u5462\u2026\u2026\u4F46\u662F\u53EA\u6709\u7ECF\u9A8C\u5F88\u4E30\u5BCC\u7684\u9493\u8005\u624D\u6709\u53EF\u80FD\u6218\u80DC\u4ED6\u4EEC\u3002#$e#\u60F3\u8981\u8BA9\u7A00\u6709\u7684\u9C7C\u54AC\u94A9\uFF0C\u5F97\u8981\u7528\u6700\u597D\u7684\u9C7C\u9975\u624D\u884C\u3002",
    "Tue": "\u771F\u6B63\u7684\u9493\u8005\u5FC5\u987B\u61C2\u5F97\u5C0A\u91CD\u6C34\u2026\u2026\u8FD9\u4E00\u70B9\u53EF\u4E0D\u8981\u5FD8\u4E86\u3002",
    "Tue6": "\u6211\u8FD9\u4E2A\u8001\u5934\u5B50\u53EF\u662F\u4E2A\u8D44\u6DF1\u6E14\u592B\uFF0C\u77E5\u9053\u4E0D\u3002\u6211\u4ECE\u5C0F\u5C31\u5728\u5404\u4E2A\u5C9B\u5C7F\u4E4B\u95F4\u822A\u884C\uFF0C\u6E10\u6E10\u957F\u5927\u3002#$e#\u6E14\u592B\u7684\u751F\u6D3B\u5341\u5206\u8270\u96BE\uFF0C\u4F46\u5374\u6709\u7740\u795E\u5947\u7684\u9B45\u529B\u3002",
    "Wed": "\u6709\u4E9B\u9C7C\u4F1A\u968F\u7740\u5B63\u8282\u53D8\u5316\u51FA\u73B0\u6216\u6D88\u5931\uFF0C\u4E5F\u6709\u4E9B\u9C7C\u53EA\u4F1A\u5728\u4E0B\u96E8\u65F6\u6216\u8005\u591C\u95F4\u624D\u4F1A\u51FA\u73B0\u3002",
    "Wed6": "\u6211\u542C\u4F20\u95FB\u8BF4\u7011\u5E03\u4E4B\u95F4\u7684\u6C34\u5858\u91CC\u6709\u4E00\u79CD\u7279\u6B8A\u7684\u9C7C\u2026\u2026#$b#\u524D\u63D0\u662F\u4F60\u7528\u9C7C\u7AFF\u80FD\u591F\u5230\u90A3\u91CC\u2026\u2026",
    "accept_869": "\u554A\u2026\u2026\u6211\u4E00\u76F4\u90FD\u60F3\u6293\u4E00\u6761\u9CB6\u9C7C\uFF0C\u8FD9\u5C31\u662F\u6700\u5B8C\u7F8E\u7684\u9C7C\u9975\uFF01#$b#\u6765\u5427\uFF0C\u6211\u7528\u8FD9\u4E2A\u4E1C\u897F\u4E0E\u4F60\u4EA4\u6362\u3002\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u4EC0\u4E48\uFF0C\u4F46\u5B83\u662F\u5728\u4E0D\u4E45\u524D\u624D\u88AB\u51B2\u5230\u6D77\u6EE9\u4E0A\u7684\u3002#$b#\u6211\u6709\u79CD\u611F\u89C9\uFF0C\u4F60\u4F1A\u7528\u4E0A\u5B83\u7684\uFF0C\u5C0F\u4F19\u5B50\u3002^\u6211\u6709\u79CD\u611F\u89C9\uFF0C\u4F60\u4F1A\u7528\u4E0A\u5B83\u7684\uFF0C\u5C0F\u59D1\u5A18\u3002",
    "fishCaught_159": "\u54E6\uFF0C\u4F60\u7EC8\u4E8E\u5F81\u670D\u7EEF\u7EA2\u9C7C\u4E86\uFF01\u51E0\u5E74\u4E86\uFF0C\u90A3\u9C7C\u4E00\u76F4\u5728\u5632\u8BBD\u6211\uFF0C\u5C31\u5DEE\u54AC\u7A7F\u5730\u677F\u8FFD\u5230\u6211\u5BB6\u6765\u4E86\uFF01",
    "fishCaught_160": "\u54E6\uFF0C\u4F60\u9493\u5230\u9B9F\u9C47\u9C7C\u4E86\u554A\uFF1F\u90A3\u4E48\u9493\u7A00\u6709\u9C7C\u4F60\u7B97\u662F\u5165\u95E8\u4E86\u3002",
    "fishCaught_163": "\u8C22\u5929\u8C22\u5730\u2026\u2026\u4F60\u7ADF\u7136\u9493\u5230\u201C\u4F20\u5947\u4E4B\u9C7C\u201D\u4E86\uFF0C\u6211\u6CA1\u60F3\u5230\u80FD\u5728\u6709\u751F\u4E4B\u5E74\u770B\u5230\u2026\u2026$h#$b#\u55EF\uFF0C\u5C0F\u4F19\u5B50\uFF0C\u4F60\u6210\u529F\u4E86\u2026\u2026\u4F60\u662F\u661F\u9732\u8C37\u96BE\u5F97\u4E00\u89C1\u7684\u9493\u9C7C\u597D\u624B\u2026\u2026$h^\u55EF\uFF0C\u5C0F\u59D1\u5A18\uFF0C\u4F60\u6210\u529F\u4E86\u2026\u2026\u4F60\u662F\u661F\u9732\u8C37\u96BE\u5F97\u4E00\u89C1\u7684\u9493\u9C7C\u597D\u624B\u2026\u2026$h",
    "fishCaught_682": "\uFF08\u95FB\u4E86\u4E24\u4E0B\uFF09\u2026\u2026\u5C0F\u4F19\u5B50\uFF0C\u4F60\u662F\u4E0D\u662F\u5728\u4E0B\u6C34\u9053\u9493\u9C7C\u4E86\uFF1F^\uFF08\u95FB\u4E86\u4E24\u4E0B\uFF09\u2026\u2026\u5C0F\u59D1\u5A18\uFF0C\u4F60\u662F\u4E0D\u662F\u5728\u4E0B\u6C34\u9053\u9493\u9C7C\u4E86\uFF1F#$b#\u8FD9\u4E2A\u529E\u6CD5\u5012\u662F\u522B\u51FA\u5FC3\u88C1\u3002\u4F20\u8BF4\u4E2D\u8FD8\u6709\u4E00\u6761\u88AB\u6709\u6BD2\u6DE4\u6CE5\u641E\u53D8\u5F02\u7684\u5DE8\u5927\u9CA4\u9C7C\u2026\u2026",
    "fishCaught_775": "\u554A\uFF0C\u4F60\u7EC8\u4E8E\u902E\u5230\u51B0\u5DDD\u9C7C\u4E86\u2026\u2026\u8FD9\u53EF\u662F\u6211\u89C1\u8FC7\u7684\u6700\u6ED1\u5934\u7684\u9C7C\uFF01#$e#\u4F60\u8BD5\u4E86\u591A\u5C11\u6B21\uFF1F",
    "married": "\u54E6\uFF0C\u4F60\u8131\u5355\u4E86\u554A\uFF1F#$b#\u4E0D\u8FC7\u522B\u628A\u9493\u9C7C\u8352\u5E9F\u4E86\u2026\u2026",
    "summer_19": "\u660E\u5929\u5C31\u662F\u4E00\u5E74\u4E00\u5EA6\u7684\u9CDF\u9C7C\u5927\u8D5B\u2026\u2026\u597D\u54C7\uFF0C\u7231\u9493\u6DE1\u6C34\u9C7C\u7684\u4EBA\u8981\u5927\u663E\u8EAB\u624B\u561E\uFF01#$e#\u4E16\u754C\u5404\u5730\u7684\u9493\u9C7C\u9AD8\u624B\u90FD\u4F1A\u6765\u8FD9\u91CC\u9493\u8679\u9CDF\u9C7C\u2026\u2026#$e#\u5C0F\u4F19\u5B50\uFF0C\u5230\u65F6\u5019\u89C1\uFF01$h^\u5230\u65F6\u5019\u89C1\uFF01$h#$e#\u540E\u9762\u4E24\u5929\uFF0C\u6211\u53EA\u5F00\u4E00\u4E2A\u5C0F\u65F6\u7684\u5E97\uFF0C\u4ECE\u65E9\u4E0A 9 \u70B9\u5F00\u59CB\u3002\u5982\u679C\u4F60\u60F3\u8981\u4E70\u4E1C\u897F\u7684\u8BDD\uFF0C\u8981\u6293\u7D27\u65F6\u95F4\u3002",
    "summer_20": "\u4ECA\u5929\u6BD4\u8D5B\u5C31\u5F00\u59CB\u4E86\uFF01\u6211\u5DF2\u7ECF\u6574\u88C5\u5F85\u53D1\uFF0C\u8981\u53BB\u9493\u9CDF\u9C7C\u561E\u2026\u2026#$e#\u795D\u4F60\u597D\u8FD0\uFF01",
    "summer_21": "\u4F60\u6BD4\u8D5B\u7684\u60C5\u51B5\u600E\u4E48\u6837\uFF1F#$b#\u6211\u5DF2\u7ECF\u62FF\u5230\u4E0D\u5C11\u9EC4\u91D1\u6807\u7B7E\u4E86\u2026\u2026\u4F46\u662F\u8FD8\u8981\u7EE7\u7EED\uFF01",
    "winter_11": "\u660E\u5929\u5728\u6D77\u6EE9\u4E0A\u4F1A\u5F00\u59CB\u4E00\u4E2A\u5C0F\u6D3B\u52A8\u2026\u2026\u53EB\u505A\u201C\u9C7F\u9C7C\u8282\u201D\u3002#$e#\u55D0\u2026\u2026\u662F\u633A\u96BE\u9493\u7684\uFF0C\u90A3\u7FA4\u9C7F\u9C7C\uFF0C\u4E0D\u8FC7\u4F60\u73B0\u5728\u80AF\u5B9A\u5DF2\u7ECF\u8F7B\u8F66\u719F\u8DEF\u4E86\u3002",
    "winter_12": "\u7EE7\u7EED\u52A0\u628A\u52B2\uFF01\u6C34\u91CC\u8FD8\u6709\u597D\u591A\u9C7F\u9C7C\u561E\u2026\u2026",
    "winter_13": "\u8FD9\u4E48\u591A\u9493\u9C7C\u597D\u624B\u56E0\u4E3A\u559C\u6B22\u9493\u9C7C\u805A\u96C6\u5728\u8FD9\u91CC\uFF0C\u6211\u771F\u662F\u7279\u522B\u8212\u5FC3\u2026\u2026$h"
