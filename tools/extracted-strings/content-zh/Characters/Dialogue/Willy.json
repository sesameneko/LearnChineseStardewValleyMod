    "Mon": "\u4F60\u597D\u554A\uFF0C\u5B69\u5B50\u3002^\u4F60\u597D\u554A\uFF0C\u5C0F\u59D1\u5A18\u3002#$b#\u4ECA\u5929\u5929\u6C14\u5F88\u9002\u5408\u9493\u9C7C\u561B\uFF0C\u662F\u4E0D\u662F\uFF1F",
    "Mon4": "\u4F60\u5728\u672C\u5730\u6C34\u57DF\u6709\u4EC0\u4E48\u6536\u83B7\u5417\uFF1F\u770B\u4F60\u7684\u6837\u5B50\uFF0C\u5982\u679C\u52E4\u52A0\u953B\u70BC\u4E00\u5B9A\u4F1A\u6210\u4E3A\u51FA\u8272\u7684\u9493\u624B\u54E6\u3002",
