    "AcceptBirthdayGift_Negative": "\u554A\uFF01\u6211\u5728\u4E66\u4E0A\u770B\u5230\u8FC7\u8FD9\u4E2A\u4F20\u7EDF\u2026\u2026\u8FD9\u4E2A\u662F\u201C\u751F\u65E5\u793C\u7269\u201D\u5427\uFF1F#$b#\u6240\u4EE5\u9001\u522B\u4EBA\u5783\u573E\u4E5F\u662F\u4E00\u4E2A\u4F20\u7EDF\uFF1F",
    "AcceptBirthdayGift_Positive": "\u554A\uFF01\u6211\u5728\u4E66\u4E0A\u770B\u5230\u8FC7\u8FD9\u4E2A\u4F20\u7EDF\u2026\u2026\u8FD9\u4E2A\u662F\u201C\u751F\u65E5\u793C\u7269\u201D\u5427\uFF1F\u5514\uFF0C\u5F88\u6709\u610F\u601D\u2026\u2026",
    "AcceptGift_(O)StardropTea": "\uFF08\u95FB\u4E86\u4E00\u4E0B\uFF09\u2026\u2026\u8FD9\u662F\u725B\u5976\u5417\uFF1F\uFF08\u559D\u4E86\u4E00\u53E3\uFF09\u2026\u2026\u5514\u2026\u2026\u633A\u597D\u559D\u3002",
    "AcceptGift_Neutral_milk_item": "\u554A\uFF0C\u662F\u201C\u725B\u5976\u201D\u2026\u2026\uFF08\u54E7\u6E9C\uFF09\u2026\u2026\u771F\u6709\u8DA3\u3002\u6211\u53C8\u5FD8\u4E86\u2026\u2026\u8FD9\u4E2A\u996E\u6599\u662F\u4ECE\u54EA\u91CC\u6765\u7684\uFF1F#$b#\u2026\u2026\uFF01\uFF01\uFF01\uFF08\u7A00\u91CC\u54D7\u5566\uFF09",
    "Fri": "\u4F60\u4EE5\u524D\u6CA1\u89C1\u8FC7\u77EE\u5B50\u5417\uFF1F",
    "Fri_2": "\u4EBA\u4EEC\u90FD\u5BF9\u672A\u77E5\u7684\u4E8B\u7269\u611F\u5230\u6050\u60E7\u2026\u2026\u90A3\u5C31\u662F\u4E3A\u4EC0\u4E48\u6211\u8981\u628A\u5E97\u85CF\u5728\u8FD9\u91CC\u3002#$e#\u4F60\u7684\u5F00\u91C7\u6280\u5DE7\u5DF2\u7ECF\u8BC1\u660E\u4F60\u503C\u5F97\u6211\u7684\u4FE1\u4EFB\u4E86\u3002",
    "GreenRain": "\u6211\u4E0D\u592A\u80FD\u5206\u8FA8\u51FA\u7EFF\u8272\u3002#$b#\u53EF\u80FD\u662F\u56E0\u4E3A\u5728\u5730\u4E0B\u5F85\u4E45\u4E86\u3002",
    "Introduction": "\u563F\uFF0C\u4F60\u8EAB\u4E3A\u4E00\u4E2A\u4EBA\u7C7B\uFF0C\u8FD8\u771F\u662F\u64C5\u957F\u91C7\u77FF\u554A\u3002",
    "Mon": "\u8FD9\u4E9B\u4E1C\u897F\u90FD\u662F\u5730\u4E0A\u6361\u7684\u3002\u5C31\u662F\u665A\u4E0A\u4ECE\u4F60\u4EEC\u90A3\u91CC\u62FF\u6765\u7684\u3002#$e#\u55EF\uFF1F\u4F60\u8BF4\u7684\u0022\u79C1\u4EBA\u8D22\u4EA7\u0022\u662F\u4EC0\u4E48\uFF1F",
    "Sat": "\u77FF\u4E95\u91CC\u5F88\u5371\u9669\u554A\u3002\u4E0D\u5982\u5728\u6211\u7684\u5E97\u91CC\u4E70\u70B9\u4E1C\u897F\u786E\u4FDD\u5B89\u5168\u5427\uFF1F",
    "Sat_8": "\u77FF\u4E95\u53EF\u662F\u4E2A\u5371\u9669\u7684\u5730\u65B9\u3002\u5C0F\u5FC3\u554A\uFF0C\u670B\u53CB\u3002",
    "Sun": "\u6709\u673A\u4F1A\u4F60\u5F97\u544A\u8BC9\u6211\u8FD9\u4E2A\u88AB\u4F60\u79F0\u4E3A\u201C\u725B\u5976\u201D\u7684\u996E\u6599\u7684\u4E00\u5207\u554A\u3002",
    "Thu": "\u4F60\u4E0D\u4F1A\u662F\u6697\u5F71\u4EBA\u6D3E\u6765\u7684\u95F4\u8C0D\u5427\uFF1F#$e#\u6211\u53EF\u76EF\u7740\u4F60\u5462\u3002",
    "Thu_4": "\u5728\u5730\u4E0B\u611F\u89C9\u6700\u8212\u670D\u4E86\u3002#$e#\u8D8A\u6DF1\u8D8A\u597D\u554A\u3002",
    "Tue": "\u554A\u2026\u2026\u716E\u5C71\u6D1E\u841D\u535C\u3001\u70E4\u5C71\u6D1E\u841D\u535C\u3001\u5C71\u6D1E\u841D\u535C\u6C64\u8FD8\u6709\u7117\u5C71\u6D1E\u841D\u535C\u3002#$e#\u2026\u2026\u8FD8\u6709\u8BA9\u591C\u665A\u53D8\u5F97\u751C\u871C\u7684\u5C71\u6D1E\u841D\u535C\u5E03\u4E01\u86CB\u7CD5#$e#\u4EC0\u4E48\uFF1F",
    "Wed": "\u563F\uFF0C\u8981\u4E70\u70B9\u4EC0\u4E48\u5417\uFF1F",
    "Wed_6": "\u5F88\u4E45\u4EE5\u524D\uFF0C\u4EBA\u4EEC\u5C31\u77E5\u9053\u4E86\u5148\u8FDB\u6280\u672F\u7684\u79D8\u5BC6\u3002\u8003\u53E4\u5B66\u4E0A\u7684\u8BC1\u636E\u53EF\u4EE5\u8BC1\u660E\u8FD9\u4E00\u70B9\u3002#$e#\u53EF\u662F\u6211\u641E\u4E0D\u61C2\u8FD9\u4E9B\u77E5\u8BC6\u4EBA\u4EEC\u90FD\u662F\u4ECE\u4F55\u5904\u5F97\u6765\u7684\uFF1F\u53C8\u4EA7\u751F\u4E86\u4EC0\u4E48\u6210\u679C\uFF1F\u6211\u89C9\u5F97\u6709\u4E9B\u95EE\u9898\u53EF\u80FD\u6C38\u8FDC\u6CA1\u6709\u7B54\u6848\u2026\u2026",
    "firstVisit_Caldera": "\u4F60\u627E\u5230\u4F20\u8BF4\u4E2D\u7684\u77EE\u4EBA\u953B\u9020\u53F0\u4E86\uFF1F\u592A\u725B\u4E86\u2026\u2026\u6211\u81EA\u5DF1\u90FD\u6CA1\u89C1\u8FC7\u3002#$e#\u90A3\u4E2A\u673A\u5668\u592A\u53E4\u8001\u4E86\uFF0C\u6211\u4EEC\u65CF\u5DF2\u7ECF\u6CA1\u6709\u4EBA\u80FD\u7406\u89E3\u5B83\u7684\u539F\u7406\u4E86\uFF0C\u4E0D\u8FC7\u80FD\u786E\u5B9A\u662F\u77EE\u4EBA\u7684\u6280\u672F\u3002",
    "firstVisit_IslandNorth": "\u5982\u679C\u4F60\u8FDB\u5165\u59DC\u5C9B\u4E0A\u7684\u706B\u5C71\uFF0C\u53EF\u80FD\u4F1A\u9047\u5230\u6211\u4EEC\u65CF\u7684\u4EBA\uFF0C\u4E0D\u7528\u60CA\u614C\uFF01\u6211\u4EEC\u5BF9\u4EBA\u7C7B\u5F88\u53CB\u597D\u3002",
    "fishCaught_158": "\u54E6\uFF1F\u4F60\u9493\u5230\u4E86\u77F3\u5934\u9C7C\u4E86\uFF1F\u6211\u5F88\u719F\u6089\u7684\uFF0C\u6211\u4EEC\u6709\u65F6\u5019\u4F1A\u628A\u5B83\u4EEC\u5F53\u5BA0\u7269\u517B\u3002",
    "fishCaught_161": "\u54E6\uFF1F\u4F60\u9493\u5230\u51B0\u67F1\u9C7C\u4E86\uFF1F\u8FD9\u79CD\u5C0F\u9C7C\u751F\u6D3B\u5728\u4E25\u5BD2\u7684\u73AF\u5883\uFF0C\u4F46\u5F88\u6709\u6D3B\u529B\u3002\u6211\u4EEC\u65CF\u662F\u4E0D\u4F1A\u53BB\u90A3\u79CD\u5730\u65B9\u7684\u2026\u2026\u592A\u51B7\u4E86\uFF01",
    "fishCaught_162": "\u54E6\uFF1F\u4F60\u9493\u5230\u5CA9\u6D46\u9CD7\u9C7C\u4E86\uFF1F\u5F88\u597D\u554A\uFF01\u6211\u4EEC\u65CF\u4E5F\u6709\u9493\u5CA9\u6D46\u9CD7\u9C7C\u7684\u4F20\u7EDF\uFF0C\u8FD9\u79CD\u9C7C\u5F88\u597D\u5403\uFF01",
    "mineArea_121": "\u6211\u8DDF\u4F60\u8BF4\uFF0C\u4F60\u4F5C\u4E3A\u4E00\u4E2A\u4EBA\u7C7B\uFF0C\u91C7\u77FF\u6280\u672F\u5DF2\u7ECF\u5F88\u5F3A\u4E86\u3002"
