    "pamHouseUpgradeAnonymous": "\u7F57\u5BBE\u751A\u81F3\u4E0D\u4F1A\u544A\u8BC9*\u6211*\u8C01\u4E3A\u6F58\u59C6\u4E70\u4E86\u65B0\u623F\u5B50\uFF01#$e#\u867D\u7136\u6211\u5047\u88C5\u5728\u751F\u5979\u7684\u6C14\uFF0C\u4F46\u5077\u5077\u5730\u8BF4\uFF0C\u6211\u5F88\u9AD8\u5174\u5979\u8BF4\u5230\u505A\u5230\u2026\u2026$h",
