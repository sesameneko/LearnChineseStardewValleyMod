    "Tue": "\u661F\u9732\u8C37\u8FD9\u91CC\u6709\u7740\u975E\u5E38\u6D3B\u8DC3\u800C\u591A\u6837\u7684\u751F\u6001\u7CFB\u7EDF\u3002\u6B63\u56E0\u4E3A\u5982\u6B64\uFF0C\u6211\u624D\u8FEB\u4E0D\u53CA\u5F85\u5730\u642C\u5230\u8FD9\u91CC\u3002",
