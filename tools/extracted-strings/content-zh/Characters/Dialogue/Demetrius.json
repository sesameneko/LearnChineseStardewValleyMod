    "eventSeen_65_memory_oneweek": "$y \u0027\u6D1E\u7A74\u7684\u7814\u7A76\u6709\u6CA1\u6709\u8FDB\u5C55\uFF1F\u4EA7\u751F\u6709\u7528\u7684\u4E1C\u897F\u4E86\u5417\uFF1F_\u6709_\u54E6\uFF01\u8BF4\u660E\u90A3\u91CC\u7684\u6761\u4EF6\u6BD4\u6211\u63A8\u6D4B\u7684\u8FD8\u8981\u5408\u9002\u2026\u2026\u5514\u2026\u2026_\u6CA1\u6709_\u90A3\u4F60\u7ECF\u5E38\u53BB\u68C0\u67E5\u4E00\u4E0B\u5427\uFF0C\u6700\u7EC8\u80AF\u5B9A\u4F1A\u4EA7\u51FA\u4E00\u4E9B\u4E1C\u897F\u7684\u3002\u0027",
    "eventSeen_65_memory_twoweeks": "\u522B\u5FD8\u4E86\u53BB\u770B\u519C\u573A\u6D1E\u7A74\uFF01\u80AF\u5B9A\u5DF2\u7ECF\u51FA\u73B0\u6709\u7528\u7684\u4E1C\u897F\u4E86\u3002",
    "fall_Fri": "\u739B\u9C81\u771F\u662F\u82B1\u4E86\u5F88\u591A\u65F6\u95F4\u5728\u5979\u7684\u90A3\u4E9B\u5C0F\u73A9\u610F\u4E0A\u9762\u3002#$e#\u770B\u5230\u5979\u8FD9\u4E48\u6295\u5165\u6211\u5F88\u9AD8\u5174\u3002",
