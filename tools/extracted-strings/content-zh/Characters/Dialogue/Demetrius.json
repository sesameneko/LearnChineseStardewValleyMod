    "reject_869": "\u8FD9\u662F\u4E2A\u5F88\u597D\u7684\u6807\u672C\uFF0C\u4E0D\u8FC7\u53EA\u662F\u5E38\u89C1\u7684\u54C1\u79CD\u3002\u4F60\u53EF\u4EE5\u7559\u7740\u3002",
    "summer_Fri": "$p 40#\u6211\u542C\u8BF4\u739B\u9C81\u8BA9\u4F60\u7528\u4E86\u540E\u9762\u90A3\u4E2A\u671B\u8FDC\u955C\u3002|\u5982\u679C\u4F60\u548C\u739B\u9C81\u6210\u4E3A\u670B\u53CB\u7684\u8BDD\uFF0C\u6211\u76F8\u4FE1\u5979\u4E00\u5B9A\u4F1A\u6559\u4F60\u600E\u4E48\u7528\u540E\u9762\u90A3\u4E2A\u671B\u8FDC\u955C\u7684\u3002#$e#\u5F88\u523A\u6FC0\u554A\uFF0C\u662F\u4E0D\u662F\uFF1F",
