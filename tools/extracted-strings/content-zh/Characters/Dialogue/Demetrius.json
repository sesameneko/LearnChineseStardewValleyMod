    "Sat": "\u5514\u2026\u2026\u5982\u679C\u6839\u9645\u5316\u5408\u7269\u7684\u78B3-13 \u6C34\u5E73\u8DB3\u591F\u7684\u8BDD\u2026\u2026$u#$b#\u5662\uFF01\u62B1\u6B49\u3002\u6211\u5728\u60F3\u6570\u636E\u7684\u4E8B\uFF0C\u6CA1\u6CE8\u610F\u5230\u4F60\u3002#$e#\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F",
    "Sun": "\u65F6\u4E0D\u65F6\u6B47\u4E00\u6B47\u662F\u6709\u597D\u5904\u7684\u3002#$e#\u867D\u7136\u6211\u731C\u4F4F\u5728\u519C\u573A\u5E94\u8BE5\u6CA1\u4EC0\u4E48\u4F11\u606F\u7684\u65F6\u95F4\u5427\u3002#$e#\u5BF9\u4E86\uFF0C\u81F3\u5C11\u5728\u51AC\u5929\u7684\u65F6\u5019\u4F60\u4E0D\u7528\u64CD\u5FC3\u90A3\u4E9B\u4F5C\u7269\u554A\u3002",
