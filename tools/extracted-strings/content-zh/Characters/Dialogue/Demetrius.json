    "summer_Tue": "\u4E00\u5B9A\u8981\u6BCF\u5929\u7ED9\u690D\u7269\u6D47\u6C34\u3002#$e#\u4E0D\u8FC7\u5462\uFF0C\u8981\u662F\u4F60\u7528\u7684\u662F\u4FDD\u6C34\u80A5\u6599\u7684\u8BDD\u5C31\u4E0D\u7528\u592A\u9891\u7E41\u5730\u6D47\u6C34\u4E86\u3002#$e#\u5F88\u65B9\u4FBF\u5427\uFF1F",
