    "winter_Mon8": "\u4F60\u56DE\u5FC6\u5F80\u4E8B\u7684\u65F6\u5019\u4F1A\u4E0D\u4F1A\u611F\u5230\u6094\u6068\u3001\u7F9E\u6127\uFF1F#$e#\u4E5F\u8BB8\u8FD9\u5C31\u662F\u6210\u957F\u7684\u4E00\u90E8\u5206\u3002",
    "winter_Sat": "\u9752\u86D9\u4EEC\u51AC\u5929\u53EF\u5C31\u4E0D\u723D\u4E86\u3002#$e#\u771F\u662F\u53EF\u601C\u7684\u5C0F\u5BB6\u4F19\u3002$s||\u9752\u86D9\u51AC\u5929\u4F1A\u5E72\u4EC0\u4E48\uFF1F\u96BE\u9053\u5C31\u662F\u51BB\u8D77\u6765\uFF0C\u7136\u540E\u6625\u5929\u518D\u89E3\u51BB\uFF1F",
    "winter_Sat6": "\u6211\u5F88\u559C\u6B22\u51AC\u5929\uFF0C\u53EF\u6BCF\u6B21\u60F3\u5230\u5916\u9762\u53D7\u51BB\u7684\u52A8\u7269\u4EEC\u5FC3\u60C5\u5C31\u4E0D\u5927\u597D\u3002#$e#\u4E0D\u8FC7\u5B83\u4EEC\u5E94\u8BE5\u4E5F\u5DF2\u7ECF\u4E60\u60EF\u4E86\u5427\u2026\u2026\u5C31\u50CF\u6211\u4E00\u6837\u3002",
    "winter_Sun": "\u6211\u5806\u4E86\u4E2A\u602A\u7269\u96EA\u4EBA\uFF0C\u5FB7\u7C73\u7279\u91CC\u5384\u65AF\u903C\u7740\u6211\u62C6\u6389\u4E86\u3002#$e#\u4ED6\u8FD9\u662F\u6709\u4EC0\u4E48\u6BDB\u75C5\u554A\uFF1F$u",
    "winter_Sun6": "\u6211\u5806\u4E86\u4E2A\u602A\u7269\u96EA\u4EBA\uFF0C\u5FB7\u7C73\u7279\u91CC\u5384\u65AF\u903C\u7740\u6211\u62C6\u6389\u4E86\u2026\u2026\u800C\u739B\u9C81\u90A3\u4E2A\u53EF\u7231\u7684\u5C0F\u96EA\u4EBA\u4ED6\u5C31\u4E0D\u7BA1\uFF01$a#$e#\u771F\u662F\u60F3\u4E0D\u901A\u3002",
    "winter_Thu": "\u4E0D\u77E5\u4ECA\u665A\u5403\u4EC0\u4E48\u5462\u2026\u2026*\u561F\u56D4*$s",
    "winter_Thu6": "\u6211\u5E94\u8BE5\u5B66\u5B66\u505A\u996D\u3002\u4E00\u5B9A\u80FD\u6D3E\u4E0A\u5927\u7528\u573A\u3002",
    "winter_Tue": "\u55EF\u2026\u2026\u6211\u8FD8\u771F\u60F3\u4E0D\u51FA\u4EC0\u4E48\u53EF\u8BF4\u7684\u3002\u6211\u8DDF\u4F60\u8FD8\u4E0D\u5927\u719F\u3002",
    "winter_Tue10": "\u4F60\u662F\u6765\u770B\u6211\u7684\u5417\uFF1F$l#$e#\u2026\u2026$h",
    "winter_Tue4": "\u563F\u2026\u2026#$b#\u6709\u65F6\u5019\u5F88\u96BE\u60F3\u5230\u65B0\u7684\u804A\u5929\u8BDD\u9898\u3002\u5C31\u7B97\u662F\u719F\u4EBA\u4E5F\u4E00\u6837\u3002#$e#\u2026\u2026\u62B1\u6B49\u3002",
    "winter_Tue6": "\u6211\u5988\u628A\u6211\u7684\u6F2B\u753B\u6536\u85CF\u6254\u6389\u7684\u65F6\u5019\uFF0C\u6211\u5DEE\u4E00\u70B9\u5C31\u5BF9\u5979\u5927\u543C\u8D77\u6765\u2026\u2026\u4F46\u4E0D\u77E5\u600E\u4E48\u5C31\u6CA1\u558A\u51FA\u6765\u3002#$e#\u55EF\u2026\u2026\u679C\u7136\u5E74\u9F84\u5E26\u6765\u667A\u6167\u554A\u3002",
    "winter_Wed": "%\u585E\u5DF4\u65AF\u8482\u5B89\u597D\u50CF\u9677\u5165\u4E86\u6C89\u601D\u2026\u2026",
    "winter_Wed4": "\u5582\uFF0C\u8981\u662F\u6211\u788D\u4E8B\u4E86\u4F60\u53EF\u5F97\u544A\u8BC9\u6211\u554A\u3002#$e#\u4F60\u8981\u662F\u4E0D\u5FD9\u7684\u8BDD\u6211\u5012\u53EF\u4EE5\u966A\u966A\u4F60\u3002$h"
  }
}