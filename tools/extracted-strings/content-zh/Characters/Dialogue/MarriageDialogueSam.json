  "entries": {
    "Good_1": "\u4F60\u4F1A\u56DE\u60F3\u8D77\u6211\u4EEC\u6E9C\u8FDB\u6211\u623F\u95F4\u7684\u90A3\u665A\u5417\uFF1F\u6211\u5E38\u5E38\u60F3\u8D77\u2026\u2026$l",
    "Good_2": "\u4F60\u77E5\u9053\u5417\uFF0C\u4ECE\u4E00\u5F00\u59CB\u6211\u5C31\u611F\u89C9\u6211\u4EEC\u4F1A\u5728\u4E00\u8D77\u3002\u6211\u4EEC\u4E4B\u95F4\u6709\u4E00\u79CD\u7279\u522B\u7684\u60C5\u612B\u3002$l",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5E05\u5446\u4E86\uFF01\u4F60\u6362\u4E86\u53D1\u578B\u5417\uFF1F$l^\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u7F8E\u6781\u4E86\u3002\u4F60\u6362\u4E86\u53D1\u578B\u5417\uFF1F$l",
    "Good_4": "\u5B9D\u8D1D\uFF0C\u6211\u521A\u8981\u4E3A\u4F60\u5199\u4E00\u9996\u7528\u5409\u4ED6\u5F39\u594F\u7684\u6B4C\u3002\u4F46\u662F\u4F60\u5728\u8FD9\u91CC\uFF0C\u6211\u611F\u89C9\u5F88\u653E\u677E\u3002#$e#\u6211\u4E00\u822C\u5B64\u72EC\u7684\u65F6\u5019\u624D\u60F3\u5F39\u5409\u4ED6\u3002",
    "Good_5": "\u5B9D\u8D1D\uFF0C\u8DDF\u6211\u8BF4\u8BF4\u8BDD\u3002\u6211\u5F88\u60F3\u542C\u4F60\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\u3002",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6211\u77E5\u9053\u4F60\u6709\u65F6\u5019\u4F1A\u53BB\u5C71\u6D1E\u2026\u2026\u4F60\u53EF\u80FD\u4F1A\u5728\u90A3\u91CC\u88AB\u751F\u541E\u6D3B\u5265\uFF01",
    "Indoor_Day_0": "\u547C\u2026\u2026\u6211\u4ECE\u524D\u7684\u751F\u6D3B\u4E2D\u6709\u4E00\u4EF6\u4E8B\u6211\u4E1D\u6BEB\u4E0D\u6000\u5FF5\u2026\u2026\u90A3\u5C31\u662F\u5728 Joja \u8D85\u5E02\u7684\u5DE5\u4F5C\u3002",
    "Indoor_Day_1": "\u751F\u6D3B\u53D8\u5316\u65E0\u5E38\u3002\u597D\u597D\u4EAB\u53D7\u5427\u3002[211]$h#$e#\u4EC0\u4E48\uFF1F\u6211\u4ECE\u6CA1\u5B66\u8FC7\u70F9\u996A\u2026\u2026\u4E00\u76F4\u90FD\u662F\u5988\u5988\u5728\u505A\u996D\u3002",
    "Indoor_Day_2": "\u563F\u3002\u6211\u77E5\u9053\u6211\u73A9\u7B11\u5F00\u8FC7\u5206\u4E86\uFF0C\u4F46\u662F\u6211\u60F3\u8BA9\u4F60\u77E5\u9053\u6211\u5F88\u8BA4\u771F\u7684\u5728\u7231\u4F60\u2026\u2026$l",
    "Indoor_Day_3": "\u4F60\u4ECA\u5929\u6709\u4EC0\u4E48\u6253\u7B97\uFF1F#$e#\u54E6\uFF0C\u6211\u6CA1\u6709\u2026\u2026\u6211\u901A\u5E38\u5728\u5F00\u59CB\u524D\u51E0\u5206\u949F\u624D\u51B3\u5B9A\u505A\u4EC0\u4E48\u2026\u2026",
    "Indoor_Day_4": "\u5443\u2026\u2026\u4E5F\u8BB8\u672A\u6765\u67D0\u5929\u6211\u4F1A\u5728\u519C\u573A\u5E2E\u5FD9\u3002\u6211\u4ECA\u5929\u611F\u89C9\u5F88\u61D2\u554A\u3002$s#$e#\u4F60\u4E0D\u4F1A\u751F\u6C14\u5427\uFF1F",
    "Indoor_Night_0": "\u563F\uFF0C\u4F60\u770B\u8D77\u6765\u5F88\u7D2F\u3002\u8BA9\u6211\u4ECA\u665A\u5E2E\u4F60\u653E\u677E\u597D\u5417\uFF1F\u4E5F\u8BB8\u7B49\u4E0B\u6211\u4F1A\u7ED9\u4F60\u6309\u4E2A\u6469\u3002",
    "Indoor_Night_1": "\u6211\u7684\u4E00\u5929\uFF1F\u5662\u2026\u2026\u6211\u5DEE\u70B9\u5FD8\u4E86\u3002\u6211\u8FD8\u771F\u6CA1\u6709\u505A\u4EC0\u4E48\u503C\u5F97\u4E00\u63D0\u7684\u4E8B\u60C5\u3002\u53EA\u662F\u8F7B\u677E\u5730\u5EA6\u8FC7\u4E86\u4E00\u5929\u3002",
    "Indoor_Night_2": "\u563F\uFF0C\u62B1\u6B49\u6211\u6CA1\u6709\u94FA\u5E8A\u3002\u4F60\u77E5\u9053\u6211\u5F88\u908B\u9062\u2026\u2026\u6240\u4EE5\u4F60\u624D\u559C\u6B22\u6211\uFF0C\u5BF9\u5427\uFF1F$h",
    "Indoor_Night_3": "\u6211\u53EA\u60F3\u5FF5\u4F4F\u5728\u5BB6\u91CC\u65F6\u5988\u5988\u505A\u7684\u7802\u9505\u9C7C\u3002",
    "Indoor_Night_4": "\u51C6\u5907\u4E0A\u5E8A\u4E86\u5417\uFF1F\u6211\u5076\u5C14\u94FA\u4E86\u4E00\u6B21\u5E8A\u2026\u2026",
    "OneKid_0": "\u6211\u4F1A\u7ED9%kid1\u6362\u5C3F\u5E03\u2026\u2026\u522B\u62C5\u5FC3\u3002\u4F60\u8981\u5FD9\u7684\u4E8B\u60C5\u5DF2\u7ECF\u591F\u591A\u4E86\u3002",
    "OneKid_1": "\u8FD9\u5F88\u5947\u602A\uFF0C\u4F46\u6211\u771F\u4EAB\u53D7\u4F5C\u4E3A\u4E00\u540D\u7236\u4EB2\uFF01$h",
    "OneKid_3": "\u6211\u60F3\u6211\u4EEC\u5E94\u8BE5\u518D\u751F\u4E00\u4E2A\u3002\u4E3A\u4EC0\u4E48\u4E0D\u5462\uFF1F",
    "Outdoor_0": "\u4E5F\u8BB8\u6211\u5E94\u8BE5\u4E3A\u6211\u7684\u6ED1\u677F\u88C5\u51E0\u4E2A\u8D8A\u91CE\u8F6E\u5B50\u3002\u5728\u8FD9\u91CC\u5E02\u957F\u5218\u6613\u65AF\u7BA1\u4E0D\u5230\u6211\u3002$h",
    "Outdoor_1": "\u6211\u4E00\u76F4\u76EF\u7740\u5E7F\u9614\u7684\u84DD\u5929\u2026\u2026\u4F60\u6C38\u8FDC\u4E0D\u4F1A\u77E5\u9053 UFO \u4F1A\u4EC0\u4E48\u65F6\u5019\u7ECF\u8FC7\u3002",
    "Outdoor_2": "\u55E8\uFF0C@\uFF01\u8981\u662F\u6211\u591A\u61C2\u4E9B\u8015\u79CD\u7684\u77E5\u8BC6\uFF0C\u6211\u4E00\u5B9A\u4F1A\u591A\u5E2E\u5E2E\u4F60\u7684\u3002\u5BF9\u4E0D\u8D77\uFF01#$e#\u6211\u4F1A\u52AA\u529B\u9F13\u52B1\u4F60\u7684\u3002$h",
    "Outdoor_3": "\u7A7A\u6C14\u4E2D\u7684\u6C14\u606F\u8BA9\u6211\u611F\u89C9\u5F88\u4E50\u89C2\u2026\u2026\u4E5F\u8BB8\u662F\u683C\u65AF\u70E4\u7089\u91CC\u62AB\u8428\u98D8\u51FA\u6765\u7684\u9999\u6C14\u3002",
    "Outdoor_4": "\u54C7\u54E6\u2026\u2026\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5F88\u68D2\uFF0C\u6CE5\u571F\u53C8\u589E\u52A0\u4E86\u989D\u5916\u7684\u9B45\u529B\u3002$l",
    "Rainy_Day_0": "\u4ECA\u5929\u53EF\u80FD\u9002\u5408\u4F11\u606F\u4E00\u4E0B\uFF0C\u5F39\u4E00\u5F39\u5409\u4ED6\u2026\u2026#$e#\u563F\uFF0C\u5982\u679C\u4F60\u60F3\u7684\u8BDD\u4E5F\u53EF\u4EE5\u653E\u677E\u4E00\u4E0B\u3002",
    "Rainy_Day_1": "\u4F60\u89C9\u5F97\u585E\u5DF4\u65AF\u8482\u5B89\u548C\u963F\u6BD4\u76D6\u5C14\u4F1A\u5728\u4E00\u8D77\u5417\uFF1F#$e#\u54C8\u54C8\u2026\u2026\u6211\u73B0\u5728\u7ED3\u5A5A\u4E86\uFF0C\u6240\u4EE5\u6211\u4E5F\u60F3\u8BA9\u5176\u4ED6\u4EBA\u6B65\u5165\u5A5A\u59FB\u3002",
    "Rainy_Day_2": "\u563F\uFF0C\u6211\u5728\u62BD\u5C49\u91CC\u9762\u627E\u5230\u4E86\u8FD9\u4E2A\u3002[90 88 86 535]#$e#\u6211\u60F3\u4F60\u4E5F\u8BB8\u7528\u5F97\u4E0A\u5B83\u3002",
    "Rainy_Day_3": "\u5662\uFF0C\u9634\u5929\u771F\u662F\u8BA9\u4EBA\u65E0\u7CBE\u6253\u91C7\u2026\u2026$7",
    "Rainy_Day_4": "\u4F60\u7761\u5F97\u600E\u4E48\u6837\uFF1F\u96E8\u58F0\u8BA9\u6211\u7761\u5F97\u5F88\u6C89\u3002",
    "Rainy_Night_0": "\u563F\uFF0C\u4F60\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u6211\u4ECA\u5929\u5927\u90E8\u5206\u65F6\u95F4\u90FD\u8EBA\u5728\u5C4B\u91CC\u770B\u6F2B\u753B\u2026\u2026\u771F\u723D\u3002$h",
    "Rainy_Night_1": "\u5BF9\u6211\u6765\u8BF4\u4ECA\u5929\u771F\u662F\u4F4E\u8C03\u7684\u4E00\u5929\u2026\u2026\u53EF\u4E50\u3001\u51B7\u62AB\u8428\u3001\u5373\u5174\u5F39\u51E0\u5C0F\u65F6\u7684\u5409\u4ED6\u3002\u6211\u611F\u89C9\u5F88\u653E\u677E\u3002",
    "Rainy_Night_2": "\u65E9\u524D\uFF0C\u6211\u5728\u542C\u6211\u4EEC\u4E4B\u524D\u90A3\u573A\u8868\u6F14\u7684\u73B0\u573A\u5F55\u97F3\u3002\u8FD8\u8BB0\u5F97\u90A3\u573A\u8868\u6F14\u5417\uFF1F\u5929\u554A\uFF0C\u771F\u662F\u70C2\u900F\u4E86\u3002#$b#\u56E0\u4E3A\u6709\u4F60\u5728\u6240\u4EE5\u6211\u6709\u70B9\u513F\u7D27\u5F20\uFF0C\u6211\u4E0D\u60F3\u641E\u7838\uFF0C\u8BA9\u4F60\u89C9\u5F97\u6211\u662F\u4E2A\u5931\u8D25\u8005\uFF01$10",
    "Rainy_Night_3": "\u6211\u5E0C\u671B\u6587\u68EE\u7279\u4E0D\u4F1A\u56E0\u4E3A\u6211\u4E0D\u5728\u4E86\u800C\u611F\u5230\u592A\u5B64\u72EC\u2026\u2026\u6211\u89C9\u5F97\u6211\u8981\u5BF9\u4ED6\u8D1F\u8D23\u3002$s#$e#\u4F46\u662F\uFF0C\u751F\u6D3B\u53D8\u5316\u65E0\u5E38\u2026\u2026\u5BF9\u5427\uFF1F\u5B69\u5B50\u4EEC\u6700\u7EC8\u8981\u5B66\u5230\u8FD9\u4E00\u70B9\u2026\u2026\u4E0D\u7136\u6210\u4EBA\u7684\u4E16\u754C\u4F1A\u51FB\u57AE\u4ED6\u4EEC\u7684\u3002$7",
    "Rainy_Night_4": "\u563F\uFF0C\u6211\u5728\u70E4\u7BB1\u91CC\u70E4\u4E86\u51E0\u7247\u51B7\u62AB\u8428\u3002\u8FD9\u662F\u4F60\u7684\u4EFD\u3002 [206]$h",
    "TwoKids_0": "\u6211\u9192\u5F97\u5F88\u65E9\uFF0C\u5582\u4E86\u5B69\u5B50\u5E76\u6362\u4E86\u5C3F\u5E03\uFF01\u6211\u4EEC\u90FD\u51C6\u5907\u597D\u4E86\u3002\u4F60\u53EA\u8981\u597D\u597D\u8D5A\u94B1\u5C31\u884C\u4E86\u3002$h#$e#\u6211\u5F00\u73A9\u7B11\u7684\u2026\u2026\u6211\u4E0D\u662F\u4E3A\u4E86\u94B1\u624D\u548C\u4F60\u7ED3\u5A5A\u3002",
    "TwoKids_1": "\u6709\u4E86%kid2\u540E\uFF0C\u6211\u4EEC\u8981\u8BB0\u5F97\u591A\u5173\u6CE8\u4E9B%kid1\u3002\u6211\u4E0D\u60F3\u8BA9\u4ED6\u4EEC\u5AC9\u5992\u5BF9\u65B9\u3002",
    "TwoKids_2": "\u770B\u5230\u5B69\u5B50\u4EEC\u73A9\u5728\u4E00\u8D77\u5F88\u6709\u8DA3\u3002\u6211\u60F3\u4ED6\u4EEC\u4F1A\u5F88\u4EB2\u5BC6\u2026\u2026",
    "TwoKids_3": "\u6211\u4ECE\u6CA1\u60F3\u8FC7\u6211\u4F1A\u6210\u4E3A\u4E00\u4E2A\u5C45\u5BB6\u7537\u4EBA\uFF0C\u4F46\u662F\u6211\u5BF9\u6211\u4EEC\u5728\u8FD9\u91CC\u6784\u7B51\u7684\u4E00\u5207\u90FD\u5F88\u6EE1\u610F\u3002\u751F\u6D3B\u5F88\u7F8E\u597D\u3002$h",
    "fall_1": "\u5C31\u50CF\u4E00\u591C\u4E4B\u95F4\u6574\u4E2A\u661F\u9732\u8C37\u90FD\u53D8\u4E86\u2026\u2026\u6211\u731C\u79CB\u5929\u6765\u4E86\u3002",
    "fall_15": "\u563F\uFF0C\u660E\u5929\u5C31\u662F\u96C6\u5E02\u4E86\u3002\u6211\u5F97\u628A\u751F\u758F\u7684\u5F39\u5F13\u6280\u5DE7\u7EC3\u56DE\u6765\u2026\u2026",
    "fall_26": "\u6211\u60F3\u77E5\u9053\u4ECA\u5E74\u5988\u5988\u662F\u5426\u4F1A\u8BA9\u6587\u68EE\u7279\u53BB\u9B3C\u5C4B\u3002\u53EF\u80FD\u4E0D\u4F1A\u2026\u2026$h#$e#\u53EF\u601C\u7684\u5B69\u5B50\u3002\u4ED6\u603B\u6709\u4E00\u5929\u8981\u957F\u5927\u7684\u2026\u2026",
    "funLeave_Sam": "\u4ECA\u5929\u6211\u8981\u56DE\u5BB6\u770B\u770B\uFF0C\u597D\u5417\uFF1F\u665A\u4E0A\u6211\u4F1A\u56DE\u6765\u3002",
    "funReturn_Sam": "\u56DE\u5BB6\u63A2\u671B\u662F\u4EF6\u597D\u4E8B\uFF0C\u4F46\u4E0D\u77E5\u600E\u7684\u6211\u4F1A\u89C9\u5F97\u6709\u70B9\u538B\u6291\u3002\u5C31\u50CF\u2026\u2026\u6211\u4EEC\u7684\u751F\u6D3B\u5B8C\u5168\u5206\u5F00\uFF0C\u4E00\u5207\u90FD\u6BD4\u4EE5\u524D\u66F4\u52A0\u62D8\u8C28\u3002$7",
    "patio_Sam": "*\u5509*\u2026\u2026\u6211\u6C38\u8FDC\u4E0D\u4F1A\u7528\u8FD9\u4E00\u62DB\u2026\u2026$s",
    "spring_1": "\u5443\u2026\u2026\u6625\u5929\u2026\u2026\u6211\u7684\u9F3B\u5B50\u2026\u2026\u8FC7\u654F\u3002$s",
    "spring_12": "\u4F60\u5BF9\u660E\u5929\u7684\u8282\u65E5\u611F\u5230\u5174\u594B\u5417\uFF1F\u80FD\u518D\u89C1\u5230\u585E\u5DF4\u65AF\u8482\u5B89\u592A\u68D2\u5566\u3002",
    "spring_23": "\u5662\u2026\u2026\u660E\u5929\u662F\u82B1\u821E\u8282\uFF0C\u4E0D\u662F\u5417\uFF1F\u6211\u4EE5\u4E3A\u6211\u4EEC\u7ED3\u5A5A\u4E86\u5C31\u80FD\u6446\u8131\u5B83\u4E86\u3002#$e#\u7B97\u4E86\u3002\u6211\u89C9\u5F97\u5B83\u6709\u4E00\u79CD\u5947\u602A\u7684\u4E50\u8DA3\u3002",
    "summer_1": "\u590F\u5929\u82B1\u7C89\u6BD4\u8F83\u5C11\uFF0C\u6240\u4EE5\u6211\u7684\u9F3B\u5B50\u5F88\u8212\u670D\u3002$h",
    "summer_10": "\u4F60\u60F3\u597D\u5728\u5BB4\u4F1A\u7684\u6C64\u91CC\u9762\u653E\u4EC0\u4E48\u4E86\u5417\uFF1F#$e#\u653E\u70B9\u513F\u6076\u5FC3\u7684\u4E1C\u897F\u5E94\u8BE5\u5F88\u6709\u8DA3\u3002\u4F60\u77E5\u9053\u7684\uFF0C\u8DDF\u5DDE\u957F\u5F00\u4E2A\u73A9\u7B11\uFF01$h#$e#\u62B1\u6B49\u2026\u2026",
    "summer_27": "\u590F\u5929\u5F88\u68D2\uFF0C\u4F46\u662F\u73B0\u5728\u6211\u51C6\u5907\u597D\u8FCE\u63A5\u79CB\u5929\u4E86\u3002#$e#\u660E\u665A\u6211\u4EEC\u8981\u53BB\u770B\u6C34\u6BCD\u5417\uFF1F\u90A3\u5F88\u6709\u8DA3\u3002",
    "winter_1": "\u51B7\u7A7A\u6C14\u8BA9\u6211\u7684\u53D1\u80F6\u51DD\u56FA\u4E86\u3002\u611F\u89C9\u4E0D\u662F\u5F88\u8212\u670D\u3002$s",
    "winter_28": "\u6211\u4EEC\u5EA6\u8FC7\u4E86\u7F8E\u597D\u7684\u4E00\u5E74\uFF0C@\u2026\u2026\u4E00\u5E74\u8FC7\u5B8C\u4E86\u8FD8\u771F\u662F\u6709\u70B9\u4F24\u611F\u3002#$e#\u6211\u4EEC\u8981\u8BA9\u660E\u5E74\u66F4\u597D\uFF01$h",
    "winter_7": "\u660E\u5929\u6211\u4EEC\u8981\u987A\u4FBF\u8DEF\u8FC7\u51B0\u96EA\u8282\u5417\uFF1F\u518D\u6B21\u89C1\u5230\u5927\u5BB6\u53EF\u80FD\u5F88\u6709\u8DA3\u2026\u2026"
  }
