    "GreenRain": "\u5509\uFF0C\u987E\u5BA2\u90FD\u4E0D\u6765\u4E86\uFF01\u8FD9\u201C\u7EFF\u201D\u96E8\u8981\u662F\u518D\u4E0B\u4E0B\u53BB\uFF0C\u6211\u8FD9\u5E97\u91CC\u5C31\u5168\u662F\u201C\u8D64\u201D\u5B57\u4E86\uFF01$s",
