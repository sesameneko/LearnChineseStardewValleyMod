    "AcceptGift_(O)StardropTea": "\u6211\u6EF4\u4E2A\u4E56\u4E56\u2026\u2026\u6211\u6CA1\u60F3\u5230\u4F1A\u6536\u5230\u8FD9\u6837\u7684\u793C\u7269\u3002\u5B69\u5B50\uFF0C\u6211\u5F88\u9AD8\u5174\uFF01",
    "Fri": "\u6BCF\u5929\u90FD\u662F\u8FD9\u4E48\u7684\u5355\u8C03\uFF0C\u7B80\u76F4\u65E0\u804A\u900F\u9876\u2026\u2026$s#$b#\u5982\u679C\u51FA\u751F\u5728\u6709\u94B1\u4EBA\u5BB6\u5C31\u597D\u4E86\u2026\u2026$s",
    "Fri2": "\u5176\u5B9E\uFF0C\u6211\u4E00\u76F4\u5728\u60F3\u2026\u2026\u8981\u662F\u81EA\u5DF1\u6709\u4E2A\u4EC0\u4E48\u7231\u597D\u5C31\u597D\u4E86\u3002\u8FD9\u6837\u4E5F\u5C31\u4E0D\u4F1A\u6BCF\u5929\u665A\u4E0A\u90FD\u53BB\u9152\u5427\u9B3C\u6DF7\u3002#$e#\u4F60\u6709\u6CA1\u6709\u4EC0\u4E48\u597D\u4E3B\u610F\uFF1F#$e#\u2026\u2026\u5514\uFF0C\u8981\u4E48\u6211\u81EA\u5DF1\u548C\u81EA\u5DF1\u4E0B\u4E94\u5B50\u68CB\u600E\u4E48\u6837\uFF1F",
    "GreenRain": "\u8FD9\u662F\u4E0A\u5E1D\u7684\u4FE1\u53F7\u2026\u2026\u6211\u4EEC\u8981\u5B8C\u86CB\u4E86\u2026\u2026%noturn$s",
    "GreenRainFinished": "\u54CE\uFF0C\u5927\u6982\u672B\u65E5\u8FD8\u6CA1\u5230\u5427\uFF0C\u5B69\u5B50\u2026\u2026#$e#\u5509\uFF0C\u7EE7\u7EED\u671D\u4E5D\u665A\u4E94\u5427\u2026\u2026",
    "GreenRain_2": "\u6211\u89C9\u5F97\u8FD9\u573A\u96E8\u662F\u5728\u5BA3\u793A\u529B\u91CF\u2026\u2026\u662F\u4E00\u79CD\u544A\u8BEB\u3002#$b#\u81F3\u4E8E\u662F\u6765\u81EA\u5927\u81EA\u7136\u8FD8\u662F\u6765\u81EA\u7531\u5DF4\uFF0C\u8FD9\u5C31\u968F\u4FBF\u4F60\u600E\u4E48\u60F3\u4E86\u2026\u2026\u53CD\u6B63\u6211\u89C9\u5F97\u662F\u8FD9\u6837\u3002#$e#\u8BF4\u767D\u4E86\u5C31\u662F\u54B1\u4EEC\u4E0D\u80FD\u592A\u72C2\u5984\uFF0C\u4E0D\u7136\u4E0B\u7684\u53EF\u80FD\u4E0D\u662F\u7EFF\u96E8\u800C\u662F\u8840\u96E8\u4E86\u2026\u2026\u61C2\u6211\u610F\u601D\u4E0D\uFF1F",
    "Introduction": "\u4F60\u597D\uFF0C\u5B69\u5B50\u3002\u6211\u53EB\u6F58\u59C6\u3002#$e#\u53EA\u8981\u4F60\u6001\u5EA6\u4E0D\u6076\u52A3\uFF0C\u6211\u4EEC\u4E00\u5B9A\u4F1A\u6210\u4E3A\u670B\u53CB\u7684\u3002",
    "Mon": "#$1 PamDrank#\u5662\u2026\u2026\u6211\u7684\u5934\u2026\u2026$k#$e#\u5982\u679C\u6709\u94B1\u7684\u8BDD\uFF0C\u8C01\u4E0D\u60F3\u5403\u5F97\u5065\u5EB7\u70B9\u554A\u3002#$e#\u5582\uFF0C\u4F60\u90A3\u519C\u573A\u4E0A\u4E00\u5B9A\u79CD\u4E86\u4E0D\u5C11\u597D\u5403\u7684\uFF0C\u5BF9\u5427\uFF1F",
    "MovieInvitation": "\u8DDF\u8001\u6F58\u59C6\u7684\u7EA6\u4F1A\u4E4B\u591C\u5417\uFF1F\u54C8\uFF01$h^\u8DDF\u8001\u6F58\u59C6\u7684\u95FA\u871C\u4E4B\u591C\u5417\uFF1F\u54C8\uFF01$h#$b#\u5F53\u7136\u597D\u554A\uFF0C\u5B69\u5B50\u2026\u2026\u6211\u4EEC\u5230\u65F6\u5019\u89C1\u3002",
    "Resort": "\u554A\u2026\u2026\u5728\u8DEF\u4E0A\uFF0C\u5A01\u5229\u7ED9\u6BCF\u4E2A\u4EBA\u5206\u4E86\u4E00\u5757\u9C7C\u5E72\uFF0C\u975E\u5E38\u7F8E\u5473\uFF01",
    "Resort_Bar": "\u5B69\u5B50\uFF0C\u60C5\u51B5\u7279\u6B8A\u2026\u2026\u6211\u8981\u70B9\u4E00\u676F\u7279\u522B\u7684\u3002\u8981\u70C8\u4E00\u70B9\u7684\uFF01$h",
    "Resort_Chair": "\u771F\u662F\u8212\u670D\u554A\uFF01\u6211\u60F3\u628A\u978B\u5B50\u4E5F\u8131\u6389\uFF01$h#$e#\u5B69\u5B50\uFF0C\u6700\u597D\u522B\u51D1\u8FD1\u4E86\u770B\u6211\u7684\u811A\u3002",
    "Resort_Shore": "\u770B\u6765\u5468\u56F4\u6709\u4E0D\u5C11\u7F55\u89C1\u7684\u9C7C\uFF0C\u4E0B\u6B21\u6211\u5FC5\u987B\u5F97\u628A\u9C7C\u7AFF\u5E26\u4E0A\uFF01",
    "Saloon": "\u6211\u8FD9\u628A\u8001\u9AA8\u5934\uFF0C\u5C31\u9760\u559D\u70B9\u5C0F\u9152\u624D\u80FD\u6696\u548C\u8FC7\u6765\u2026\u2026$h",
    "Saloon6": "\u4F60\u597D\uFF0C\u5B69\u5B50\u3002\u5982\u679C\u6211\u6709\u94B1\u7684\u8BDD\uFF0C\u4E00\u5B9A\u8BF7\u4F60\u559D\u4E00\u676F\uFF01",
    "Saloon_Entry": "\u554A\u2026\u2026\u7EC8\u4E8E\u80FD\u6B47\u4F1A\u4E86\u3002/\u5F97\u8D76\u7D27\u559D\u4E00\u676F\u3002/\u683C\u65AF\uFF01\u5C31\u6765\u6211\u5E73\u5E38\u90A3\u676F\u3002/\u5582\uFF01\u6211\u56DE\u6765\u4E86\uFF01/\u554A\u554A\uFF0C\u8FD8\u771F\u662F\u5589\u5499\u5192\u70DF\u4E86\uFF01/\u7B80\u76F4\u8981\u6E34\u6B7B\u4E86\uFF01",
    "Saloon_Fri": "\u683C\u65AF\uFF01\u6700\u70C8\u7684\u9152\u518D\u7ED9\u6211\u6765\u4E00\u676F\uFF01",
    "Saloon_Sat": "%\u6F58\u59C6\u6CA1\u6709\u4EFB\u4F55\u53CD\u5E94\u3002",
    "Saloon_Sun": "%\u6F58\u59C6\u4F3C\u4E4E\u7761\u8FC7\u53BB\u4E86\u3002\u8FD8\u662F\u4E0D\u8981\u6253\u6270\u5979\u5427\u3002",
    "Saloon_Thu": "*\u5927\u53E3\u559D\u9152*\u2026\u2026\u4E00\u4E0B\u5348\u5C31\u76FC\u7740\u80FD\u6765\u8FD9\u91CC\u559D\u4E00\u53E3\u4E86\u3002\u5475\u5475\u3002",
    "Saloon_Tue": "\u5582\uFF0C\u683C\u65AF\uFF01\u518D\u6765\u4E00\u676F\uFF01*\u6253\u55DD*$h",
    "Saloon_Wed": "*\u5509* \u2026\u2026\u5582\uFF0C\u5C0F\u5B50\uFF0C\u4F60\u8FD9\u6837\u7684\u5E74\u8F7B\u4EBA\u4E0D\u8BE5\u5728\u8FD9\u91CC\u901B\u6E38\u3002",
    "Sat": "\u8FDB\u6765\u4E4B\u524D\uFF0C\u4F60\u6700\u597D\u5728\u95E8\u53E3\u628A\u978B\u4E0A\u7684\u6CE5\u90FD\u64E6\u5E72\u51C0\u3002$u#$e#\u64E6\u5730\u677F\u5B9E\u5728\u662F\u592A\u9EBB\u70E6\u4E86\u3002\u4F60\u4E5F\u5E94\u8BE5\u4F53\u8C05\u4E00\u4E0B\u3002",
    "Sat4": "\u5982\u679C\u6BCF\u5929\u665A\u4E0A\u6709\u4E9B\u5C0F\u5996\u7CBE\u51FA\u6765\u66FF\u6211\u6253\u626B\u623F\u95F4\u5C31\u597D\u4E86\u3002\u54C8\u54C8\u54C8\u3002$h#$e#\u8FD8\u771F\u60F3\u5403\u4E9B\u9632\u98CE\u8349\u5462\u3002#$e#\u5982\u679C\u6211\u7684\u817F\u6CA1\u4E8B\u7684\u8BDD\uFF0C\u5076\u5C14\u4E5F\u60F3\u53BB\u5C71\u91CC\u770B\u770B\u5462\u3002",
    "Sun": "\u4F60\u548C\u683C\u65AF\u662F\u670B\u53CB\u5417\uFF1F\u4ED6\u8FD9\u4EBA\u633A\u4E0D\u9519\u7684\u3002#$e#\u6211\u751F\u65E5\u7684\u65F6\u5019\uFF0C\u4ED6\u8FD8\u7ED9\u6211\u514D\u8D39\u5564\u9152\u6765\u7740\u3002",
    "Thu": "#$1 PamDrunk#\u5509\u5509\u2026\u2026\u6628\u665A\u7A0D\u5FAE\u559D\u591A\u4E86\u4E9B\uFF0C\u73B0\u5728\u4E0D\u8212\u670D\u2026\u2026\u5FEB\u8D70\u5F00\u3002$k#$e#\u867D\u7136\u6211\u8FD9\u623F\u5B50\u4E0D\u600E\u4E48\u6837\uFF0C\u4F46\u81F3\u5C11\u5C31\u5728\u6CB3\u8FB9\u3002#$e#\u563F\u3002\u6F58\u59AE\u53EF\u662F\u6211\u7684\u5B9D\u8D1D\u5973\u513F\uFF0C\u4F60\u522B\u6B3A\u8D1F\u5979\uFF0C\u77E5\u9053\u4E86\u5417\uFF1F",
    "Thu4": "\u6F58\u59AE\u8BF4\u6211\u5728\u9152\u5427\u5F85\u7684\u65F6\u95F4\u592A\u4E45\u4E86\u2026\u2026$s",
    "Thu4_inlaw_Penny": "\u4E00\u4E2A\u4EBA\u5728\u62D6\u8F66\u91CC\u9762\u7B80\u76F4\u5B64\u72EC\u5F97\u53EF\u6015\u2026\u2026",
    "Trailer_Entry": "\u6F58\u59AE\uFF01\u505A\u5B8C\u996D\u4E86\u5417\uFF1F/\u6F58\u59AE\uFF01\u5BB6\u52A1\u5E72\u4E86\u5417\uFF1F/\u6F58\u59AE\uFF01\u4F60\u5728\u5BB6\u5417\uFF1F/\u5582\uFF01\u6211\u56DE\u6765\u4E86\uFF01",
    "Tue": "\u5582\uFF01\u4F60\u53EF\u4E0D\u8981\u8D81\u6211\u4E0D\u5728\u5077\u5077\u6E9C\u8FDB\u6211\u7684\u623F\u8F66\uFF01\u61C2\u4E86\u5417\uFF1F$u#$e#\u4E0D\u597D\u610F\u601D\uFF0C\u53EA\u662F\u4E0D\u592A\u4FE1\u5F97\u8FC7\u964C\u751F\u4EBA\u800C\u5DF2\u3002",
    "Tue2": "\u6211\u4ECA\u5929\u65E9\u4E0A\u672C\u6765\u662F\u5728\u8BFB\u62A5\u7EB8\u7684\uFF0C\u7ED3\u679C\u641E\u5F97\u5F88\u90C1\u95F7\u3002\u8FD9\u4E16\u754C\u7B80\u76F4\u662F\u70C2\u900F\u4E86\u3002#$e#\u4F60\u4E5F\u5F97\u5F53\u5FC3\u554A\uFF0C\u4E0D\u7136\u65E9\u665A\u4F1A\u641E\u5F97\u5934\u7834\u8840\u6D41\u2026\u2026#$b#\u6211\u8001\u7238\u4EE5\u524D\u4E00\u76F4\u5BF9\u6211\u8FD9\u4E48\u8BF4\u3002\u5475\u5475\u3002$h",
    "Wed": "$d bus#\u8FD9\u5DF4\u58EB\u91CD\u65B0\u5F00\u59CB\u8FD0\u884C\uFF0C\u6211\u771F\u662F\u518D\u9AD8\u5174\u4E0D\u8FC7\u4E86\uFF01\u611F\u89C9\u6574\u4E2A\u4EBA\u53C8\u6D3B\u4E86\u8FC7\u6765\u3002|\u6700\u8FD1\u6211\u8FC7\u5F97\u4E0D\u592A\u597D\u3002\u524D\u51E0\u5929\u88AB\u516C\u53F8\u7ED9\u8F9E\u4E86\uFF0C\u4E22\u4E86\u5DF4\u58EB\u53F8\u673A\u7684\u5DE5\u4F5C\u3002\u5982\u679C\u80FD\u91CD\u65B0\u5F53\u56DE\u5DF4\u58EB\u53F8\u673A\uFF0C\u5C31\u80FD\u8F7D\u4F60\u53BB\u5361\u5229\u79D1\u6C99\u6F20\u4E86\u3002",
    "cc_Bus": "\u563F\uFF0C\u4F60\u542C\u8BF4\u8FC7\u90A3\u8F86\u8001\u5DF4\u58EB\u5417\uFF1F#$b#\u542C\u8BF4\u8FC7\u2026\u2026\u6211\u53C8\u5750\u4E0A\u9A7E\u9A76\u5EA7\u4E86\uFF0C\u5B69\u5B50\u2026\u2026\u563F\u563F\u3002\u611F\u89C9\u4E0D\u9519\u3002$h",
    "divorced_Penny": "\u6F58\u59AE\u54ED\u7740\u56DE\u5BB6\u4E86\u2026\u2026\u4F60\u5BF9\u5979\u505A\u4E86\u4EC0\u4E48\uFF1F$3",
    "event_credit1": "\u5582\uFF0C\u8BF4\u8BDD\u65F6\u6CE8\u610F\u70B9\uFF01\u4E0D\u7528\u4F60\u6765\u544A\u8BC9\u6211\u8BE5\u5E72\u4EC0\u4E48\u4E0D\u8BE5\u5E72\u4EC0\u4E48\uFF01$u",
    "event_credit2": "\u2026\u2026\u4E0D\u662F\u5417\uFF1F\u90A3\u592A\u7CDF\u7CD5\u4E86\uFF01$s#$b#\u2026\u2026\u5443$s",
    "fall_Fri": "\u6BCF\u5929\u90FD\u662F\u4E00\u6210\u4E0D\u53D8\u2026\u2026$s#$e#\u4F60\u6709\u6CA1\u6709\u8FD9\u4E48\u89C9\u5F97\u5462\uFF0C\u519C\u592B\uFF1F",
    "fall_Sat": "\u4F60\u80FD\u4E0D\u80FD\u5E2E\u5E2E\u5FD9\uFF0C\u6253\u626B\u4E00\u4E0B\u6211\u5BB6\uFF1F#$e#\u8BF4\u7B11\u5462\u3002$h",
    "fall_Sun": "\u4F60\u6CA1\u6D3B\u5E72\u5417\uFF1F#$e#\u6709\u5DE5\u4F5C\u5C31\u77E5\u8DB3\u5427\uFF0C\u81F3\u5C11\u4E0D\u7528\u6BCF\u5929\u5728\u9547\u4E0A\u6E38\u8361\u3002",
    "fall_Sun4": "\u771F\u60F3\u5FF5\u4EE5\u524D\u5F53\u5361\u8F66\u53F8\u673A\u7684\u65F6\u5019\u3002\u4EE5\u524D\u6211\u5F00\u7740\u5927\u5361\u5230\u5904\u8DD1\uFF0C\u80FD\u89C1\u5230\u5404\u79CD\u5404\u6837\u7684\u4EBA\uFF0C\u8FD8\u80FD\u5929\u5929\u542C\u5E7F\u64AD\u3002#$e#\u4EBA\u751F\u771F\u662F\u8BF4\u53D8\u5C31\u53D8\u5462\u3002",
    "fall_Thu": "\u6211\u9664\u4E86\u6F58\u59AE\u4E00\u65E0\u6240\u6709\u3002\u4F60\u53EF\u8981\u597D\u597D\u5F85\u5979\u3002",
    "fall_Tue": "\u5982\u679C\u548C\u4F60\u66F4\u719F\u7684\u8BDD\uFF0C\u53EF\u80FD\u4F1A\u66F4\u8C08\u7684\u5F00\u5427\u3002",
    "fall_Tue4": "\u522B\u770B\u6211\u73B0\u5728\u8FD9\u6837\uFF0C\u5F88\u4E45\u4EE5\u524D\u6211\u4E5F\u50CF\u4F60\u8FD9\u4E48\u5E74\u8F7B\u5462\u3002#$e#\u4EBA\u8001\u4E86\uFF0C\u611F\u89C9\u65F6\u95F4\u4E5F\u8FC7\u5F97\u98DE\u5FEB\u3002$s",
    "fall_Wed": "*\u5509*\u2026\u2026\u770B\u6765\u4ECA\u5929\u7684\u665A\u9910\u53C8\u8981\u5403\u901F\u51BB\u98DF\u54C1\u4E86\u3002$s",
    "married_Alex": "\u6240\u4EE5\u4F60\u771F\u7684\u8DDF\u83AB\u5C14\u7EB3\u5BB6\u7684\u5C0F\u4F19\u5B50\u7ED3\u5A5A\u4E86\uFF1F#$b#\u90A3\u6761\u81ED\u70D8\u70D8\u7684\u8001\u72D7\u4F60\u4E5F\u5E26\u8FC7\u53BB\u5417\uFF1F",
    "married_Penny": "\u6211\u5F88\u60F3\u5FF5\u6211\u7684\u5973\u513F\u2026\u2026$s#$b#\u4F60\u5BF9\u6211\u5BB6\u6F58\u59AE\u8981\u597D\u597D\u7684\uFF0C\u542C\u5230\u6CA1\u6709\uFF1F$u",
    "pamHouseUpgrade": "\u4E0D\u6562\u76F8\u4FE1\uFF0C\u4F60\u7ED9\u6211\u4E70\u4E86\u623F\u5B50\uFF01\u6709\u4EC0\u4E48\u9677\u4E95\u5417\uFF1F#$e#\u5BF9\u4E0D\u8D77\uFF0C\u6211\u8FD8\u4E0D\u4E60\u60EF\u4EBA\u4EEC\u5BF9\u6211\u8FD9\u4E48\u597D\u2026\u2026$s",
    "pamHouseUpgradeAnonymous": "\u6211\u4E0D\u6562\u76F8\u4FE1\u6709\u4EBA\u7ED9\u6211\u4E70\u4E86\u623F\u5B50\uFF01\u6211\u60F3\u77E5\u9053\u8FD9\u662F\u4E0D\u662F\u67D0\u79CD\u9A97\u5C40\uFF1F#$e#\u5BF9\u4E0D\u8D77\uFF0C\u6211\u8FD8\u4E0D\u4E60\u60EF\u4EBA\u4EEC\u5BF9\u6211\u8FD9\u4E48\u597D\u2026\u2026$s",
    "pamHouseUpgrade_memory_oneweek": "\u6211\u5F88\u559C\u6B22\u65B0\u623F\u5B50\uFF0C\u5B69\u5B50\uFF0C\u771F\u5FC3\u8C22\u8C22\u4F60\u554A\uFF01$h",
    "reject_867": "\u54C7\u54E6\uFF0C\u770B\u770B\u8FD9\u4E2A\u2026\u2026\u50CF\u662F\u6765\u81EA\u672A\u6765\u7684\u4E1C\u897F\u3002#$b#\u54C8\u54C8\uFF0C\u62B1\u6B49\u4E86\u5B69\u5B50\u2026\u2026\u6211\u7528\u4E0D\u6765\u8FD9\u4E2A\u3002\u8FD9\u4E0A\u9762\u7684\u6309\u94AE\u751A\u81F3\u6BD4\u6211\u7684\u8111\u7EC6\u80DE\u8FD8\u591A\uFF01$h",
    "structureBuilt_Fish Pond": "\u542C\u8BF4\u4F60\u5EFA\u4E86\u4E00\u4E2A\u9C7C\u5858\u2026\u2026\u56AF\uFF0C\u6211\u53EF\u662F\u5728\u9C7C\u5858\u65C1\u8FB9\u957F\u5927\u7684\u3002#$b#\u51E0\u4E4E\u4EC0\u4E48\u9C7C\u90FD\u53EF\u4EE5\u517B\u5728\u91CC\u9762\u2026\u2026\u4F46\u662F\u6709\u4E9B\u7A00\u6709\u7684\u9C7C\u6311\u5254\u5F97\u5F88\uFF01",
    "summer_Fri": "\u2026\u2026\u662F\u5417\uFF1F#$e#\u4F60\u8FD9\u5C0F\u4F19\u5B50\u5E74\u8F7B\u82F1\u4FCA\uFF0C\u5E72\u561B\u8981\u6765\u548C\u6211\u8FD9\u8001\u5973\u4EBA\u642D\u8BAA\uFF1F^\u4F60\u8FD9\u4E48\u5E74\u8F7B\u8C8C\u7F8E\uFF0C\u4E3A\u4EC0\u4E48\u8981\u6765\u7279\u610F\u548C\u6211\u8BF4\u8BDD\uFF1F",
    "summer_Sat": "\u6709\u4EBA\u5728\u5230\u5904\u62B1\u6028\u6211\u7684\u9662\u5B50\u592A\u4E71\u3002\u662F\u4F60\u5417\uFF1F$u#$e#\u55EF\u2026\u2026",
    "summer_Sat2": "\u522B\u6015\u9644\u8FD1\u90A3\u6761\u72D7\u3002#$b#\u867D\u7136\u770B\u8D77\u6765\u53EF\u80FD\u6709\u70B9\u51F6\uFF0C\u4E0D\u8FC7\u90A3\u72D7\u662F\u4E0D\u4F1A\u51B2\u8FC7\u6765\u54AC\u4F60\u7684\u3002#$b#\u4F60\u60F3\u77E5\u9053\u90A3\u72D7\u53EB\u4EC0\u4E48\uFF1F\u5C31\u53EB\u8FBE\u65AF\u8FEA\u554A\u3002",
    "summer_Thu": "\u4F60\u597D\u554A\uFF0C\u519C\u592B\u3002#$e#\u6211\u4E0D\u592A\u4E60\u60EF\u548C\u964C\u751F\u4EBA\u8BB2\u8BDD\u3002",
    "summer_Thu4": "\u6211\u603B\u662F\u4E0D\u77E5\u4E0D\u89C9\u5F97\u5C31\u8DD1\u5230\u9152\u5427\u5750\u5750\u3002#$e#\u5927\u6982\u662F\u79BB\u6211\u5BB6\u592A\u8FD1\u4E86\u5427\u3002\u8FD9\u751F\u6D3B\u65B9\u5F0F\u592A\u4E0D\u5065\u5EB7\u3002",
    "summer_Tue": "\u4F60\u597D\u554A\uFF0C\u964C\u751F\u4EBA\u3002",
    "summer_Tue2": "\u54E6\uFF0C\u8FD9\u4F4D\u662F@\u5148\u751F\u3002^\u54E6\uFF0C\u8FD9\u4F4D\u662F@\u5C0F\u59D0\u3002#$e#\u9700\u8981\u6211\u5E2E\u4F60\u505A\u4E9B\u4EC0\u4E48\u5417\uFF1F",
    "summer_Tue6": "\u6211\u4EE5\u524D\u4E5F\u50CF\u4F60\u4E00\u6837\uFF0C\u6709\u68A6\u60F3\u4E5F\u6709\u5E0C\u671B\u2026\u2026\u73B0\u5728\u8FD8\u4E0D\u662F\u843D\u5F97\u8FD9\u4E2A\u4E0B\u573A\u3002$s#$e#\u751F\u6D3B\u603B\u662F\u4E0D\u5C3D\u4EBA\u610F\u3002#$e#\u4E0D\u8FC7\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5728\u8FD9\u91CC\u81EA\u6028\u81EA\u827E\u4E5F\u4E0D\u662F\u529E\u6CD5\u3002",
    "summer_Wed": "\u5F53\u5730\u62E5\u6709\u4E00\u5EA7\u519C\u573A\u5BF9\u5C0F\u9547\u6765\u8BF4\u53EF\u662F\u4EF6\u597D\u4E8B\u3002",
    "summer_Wed4": "\u5982\u679C\u4F60\u7684\u519C\u573A\u666F\u6C14\u7684\u8BDD\uFF0C\u6216\u8BB8\u5F53\u5730\u7684\u7ECF\u6D4E\u4E5F\u4F1A\u597D\u8F6C\u3002#$e#\u7136\u540E\u5927\u5BB6\u5C31\u90FD\u6709\u5DE5\u4F5C\u4E86\uFF0C\u7136\u540E\u5C31\u7686\u5927\u6B22\u559C\u4E86\u4E0D\u662F\u5417\uFF1F",
    "winter_Fri": "\u6F58\u59AE\u8FD8\u771F\u662F\u559C\u6B22\u65E7\u4E66\u3002\u6211\u5C0F\u65F6\u5019\u8111\u5B50\u53EF\u6CA1\u5979\u90A3\u4E48\u806A\u660E\u3002#$e#\u6211\u5F88\u6B23\u6170\u3002",
    "winter_Mon": "\u4F60\u7684\u519C\u573A\u6709\u6CA1\u6709\u91CE\u732A\uFF1F",
    "winter_Sat": "\u6CB3\u5C31\u5728\u773C\u524D\uFF0C\u6211\u662F\u4E0D\u662F\u8BE5\u5B66\u5B66\u9493\u9C7C\u2026\u2026",
    "winter_Sun": "\u554A\u554A\u2026\u2026\u6211\u7684\u524D\u9662\u8FD8\u771F\u4E71\u3002$s",
    "winter_Thu": "\u4ECA\u5929\u8FD8\u771F\u662F\u51B7\u3002\u6216\u8BB8\u53BB\u9152\u5427\u4E00\u8D9F\uFF0C\u559D\u51E0\u676F\u5C31\u6696\u548C\u4E86\u3002\u5475\u5475\u3002#$e#\u4E0D\u5982\u4F60\u665A\u4E0A\u4E5F\u6765\u9152\u5427\u5750\u5750\uFF0C\u548C\u6211\u4E00\u8D77\u559D\u4E24\u676F\uFF1F",
    "winter_Tue": "\u4F60\u627E\u6211\u662F\u60F3\u8981\u70B9\u4EC0\u4E48\u5417\uFF1F\u8FD8\u662F\u53BB\u522B\u5904\u5427\u3002",
    "winter_Tue4": "\u6211\u5C31\u662F\u60F3\u8BA9\u6F58\u59AE\u4EE5\u540E\u6709\u597D\u65E5\u5B50\u8FC7\u3002\u7B49\u4F60\u6709\u4E86\u81EA\u5DF1\u7684\u5B69\u5B50\uFF0C\u5C31\u660E\u767D\u6211\u7684\u5FC3\u60C5\u4E86\u3002#$e#\u2026\u2026\u51AC\u5929\u8FD8\u771F\u662F\u5E72\u71E5\u3002\u611F\u89C9\u76AE\u80A4\u90FD\u76B1\u6210\u4E86\u7F8A\u76AE\u7EB8\u3002",
    "winter_Tue4_inlaw_Penny": "\u5582\u3002\u4F60\u5728\u519C\u573A\u91CC\u4E00\u5B9A\u8981\u597D\u597D\u5BF9\u5F85\u6F58\u59AE\u3002\u6211\u5C31\u53EA\u5269\u5979\u4E00\u4E2A\u4EBA\u4E86\uFF01",
    "winter_Wed": "\u5582\uFF0C\u5B69\u5B50\uFF01\u4F60\u8FD9\u662F\u8981\u53BB\u5E72\u4EC0\u4E48\uFF1F#$e#\u6211\u53EA\u662F\u548C\u5E73\u5E38\u4E00\u6837\uFF0C\u6D88\u78E8\u65F6\u95F4\u800C\u5DF2\u3002",
    "wonIceFishing": "\u597D\u5427\u2026\u2026\u5B69\u5B50\uFF0C\u9493\u9C7C\u6BD4\u8D5B\u4F60\u786E\u5B9E\u5802\u5802\u6B63\u6B63\u8D62\u4E86\u6211\u3002#$e#\u5514\u2026\u2026\u6211\u53EF\u80FD\u4E0D\u5E94\u8BE5\u7528\u5564\u9152\u9762\u7CCA\u70B8\u8611\u83C7\u5F53\u9C7C\u9975\u2026\u2026$u"
  }
