    "AcceptGift_(O)Book_Bombs": "\u54CE\uFF0C\u6211\u770B\u4E0D\u61C2\u77EE\u4EBA\u8BED\uFF0C\u4E0D\u8FC7\u62FF\u6765\u6536\u85CF\u4E5F\u633A\u6709\u610F\u601D\uFF0C\u8C22\u8C22\u4F60\u3002",
    "AcceptGift_(O)StardropTea": "\u8FD9\u662F\u9001\u6211\u7684\u5417\uFF1F\u5443\uFF0C\u6709\u70B9\u610F\u5916\u2026\u2026\u4E0D\u8FC7\u7ED9\u6211\u5427\uFF0C\u8C22\u8C22\u4F60\uFF01",
    "Fri": "\u4ECA\u5929\u771F\u662F\u4E2A\u9493\u9C7C\u7684\u597D\u65E5\u5B50\uFF0C\u4E0D\u662F\u5417\uFF1F",
    "Fri4": "\u6211\u5F97\u5B66\u5B66\u9493\u9C7C\u4E86\uFF0C\u8FD9\u6837\u80FD\u6709\u4E8B\u53EF\u505A\uFF0C\u4E0D\u81F3\u4E8E\u95F2\u7740\u3002",
    "GreenRain_2": "\u54CE\u5440\u2026\u2026\u4E0B\u8FD9\u573A\u96E8\u662F\u4E00\u4EF6\u597D\u4E8B\uFF0C\u80FD\u63D0\u9192\u6211\u4EEC\u5C71\u5916\u6709\u5C71\uFF0C\u5929\u5916\u6709\u5929\u3002#$e#@\u554A\uFF0C\u8FD9\u53CD\u800C\u80FD\u8BA9\u4EBA\u653E\u5FC3\u4E0B\u6765\u3002",
    "Mon": "\u4F60\u597D\u554A\u3002#$e#\u6211\u79BB\u5F00\u597D\u4E45\u4E86\u554A\u2026\u2026\u89C9\u5F97\u81EA\u5DF1\u5C31\u662F\u4E2A\u5F02\u4E61\u5BA2\u3002",
    "Mon4": "\u6211\u4E0D\u77E5\u9053\u6211\u8FD8\u80FD\u4E0D\u80FD\u9002\u5E94\u5BB6\u91CC\u7684\u751F\u6D3B\u3002#$e#\u9547\u5B50\u91CC\u7684\u5E73\u9759\u7965\u548C\u50CF\u662F\u4E00\u79CD\u63A9\u9970\u3002\u53EF\u80FD\u53EA\u6709\u6211\u89C9\u5F97\u8FD9\u6837\u5427\u3002",
    "MovieInvitation": "\u55EF\u2026\u2026\u597D\u7684\u3002\u8C22\u8C22\u3002\u6211\u4EEC\u5230\u65F6\u5019\u89C1\u3002$h",
    "Resort": "\u8FD9\u6BB5\u822A\u7A0B\u633A\u6709\u8DA3\u7684\uFF0C\u5728\u5BFC\u822A\u7684\u65F6\u5019\uFF0C\u6211\u6240\u63A5\u53D7\u7684\u822A\u6D77\u8BAD\u7EC3\u5C45\u7136\u6D3E\u4E0A\u4E86\u4E00\u70B9\u7528\u573A\u3002$h",
    "Resort_Bar": "\u6765\u70B9\u6C34\u5C31\u597D\u3002",
    "Resort_Chair": "\u8FD9\u4E2A\u5730\u65B9\u975E\u5E38\u9002\u5408\u5BB6\u5EAD\u6210\u5458\u52A0\u6DF1\u611F\u60C5\u3002\u6211\u771F\u7684\u5F88\u9AD8\u5174\u4F60\u628A\u8FD9\u91CC\u4FEE\u597D\u4E86\u3002",
    "Resort_Entering": "\u55E8\uFF0C@\u3002\u89C1\u5230\u4F60\u771F\u597D\u3002",
    "Resort_Leaving": "\u662F\u65F6\u5019\u56DE\u5BB6\u4E86\u3002",
    "Resort_Shore": "\u7AD9\u5728\u8FD9\u7247\u6C99\u6EE9\u4E0A\u2026\u2026\u6211\u611F\u53D7\u5230\u96BE\u5F97\u7684\u5E73\u9759\u3002$h#$e#\u8FD9\u7247\u6D77\u76F8\u5F53\u7279\u522B\u3002",
    "Sat": "\u4E54\u8FEA\u8DDF\u6211\u8BF4\u4F60\u5DF2\u7ECF\u5B8C\u5168\u878D\u5165\u5230\u8FD9\u4E2A\u96C6\u4F53\u5F53\u4E2D\u4E86\u3002\u6211\u5F88\u9AD8\u5174\u3002",
    "Sat8": "\u6211\u6709\u5931\u7720\u7684\u6BDB\u75C5\uFF0C\u6240\u4EE5\u5982\u679C\u6211\u770B\u8D77\u6765\u5F88\u75B2\u60EB\u7684\u8BDD\uFF0C\u8BF7\u4F60\u4E0D\u8981\u4ECB\u610F\u3002#$e#\u6211\u77E5\u9053\u4F60\u53EF\u4EE5\u7406\u89E3\u7684\u3002",
    "Sun": "\u867D\u7136\u6211\u56DE\u6765\u4E86\uFF0C\u4F46\u662F\u6211\u5374\u4E0D\u77E5\u9053\u81EA\u5DF1\u8BE5\u505A\u4E9B\u4EC0\u4E48\u3002#$e#\u6211\u5DF2\u7ECF\u4E60\u60EF\u4E86\u66F4\u6709\u7EC4\u7EC7\uFF0C\u6709\u7EAA\u5F8B\u7684\u751F\u6D3B\u4E86\u3002",
    "Sun4": "\u4F60\u6709\u4E00\u5957\u56FA\u5B9A\u7684\u52B3\u4F5C\u6D41\u7A0B\u662F\u5427\uFF1F\u90A3\u633A\u597D\u7684\u3002#$e#\u592A\u81EA\u7531\u4E86\u53CD\u800C\u4F1A\u5F88\u538B\u6291\uFF0C\u6BCF\u5929\u6309\u90E8\u5C31\u73ED\u662F\u6709\u597D\u5904\u7684\u3002",
    "Thu": "\u4F60\u4EEC\u662F\u6211\u513F\u5B50\u7684\u670B\u53CB\u5417\uFF1F#$e#\u4F60\u4EEC\u5927\u6982\u6BD4\u6211\u8FD8\u4E86\u89E3\u4ED6\u2026\u2026$s",
    "Thu6": "#$1 Kent1#\u6211 4 \u70B9\u949F\u5C31\u8D77\u6765\u4E86\u2026\u2026\u6709\u65F6\u5019\u6211\u4F1A\u6000\u7591\u81EA\u5DF1\u80FD\u4E0D\u80FD\u56DE\u5230\u6B63\u5E38\u7684\u751F\u6D3B\u4F5C\u606F\u4E0A\u6765\u3002$k#$e#\u5728\u6211\u79BB\u5F00\u4E4B\u540E\uFF0C\u5C71\u59C6\u771F\u7684\u957F\u5927\u4E86\u3002\u4ED6\u73B0\u5728\u662F\u4E2A\u771F\u6B63\u7684\u7537\u4EBA\u4E86\u3002#$e#\u6211\u771F\u5E0C\u671B\u80FD\u4E00\u76F4\u966A\u7740\u4ED6\u3002$s",
    "Thu_inlaw_Sam": "\u563F\uFF0C@\u3002\u7ED3\u5A5A\u4E86\u5F00\u5FC3\u5417\uFF1F",
    "Tue": "\u6211\u79BB\u5F00\u4E86\u4E4B\u540E\uFF0C\u8FD9\u91CC\u597D\u50CF\u4E5F\u6CA1\u4EC0\u4E48\u53D8\u5316\u3002#$e#\u597D\u5427\uFF0C\u53EA\u4E0D\u8FC7\u591A\u4E86\u4E2A\u4F60\u3002",
    "Tue2": "\u6211\u79BB\u5F00\u4E86\u4E4B\u540E\uFF0C\u8FD9\u91CC\u597D\u50CF\u4E5F\u6CA1\u4EC0\u4E48\u53D8\u5316\u3002#$e#\u53EA\u4E0D\u8FC7\u9547\u5B50\u91CC\u591A\u4E86\u4E00\u4E2A\u65B0\u7684\u519C\u592B\u5566\u3002$h",
    "Tue6": "\u6211\u89C9\u5F97\u6211\u9002\u5E94\u5F97\u633A\u597D\u7684\uFF0C\u6709\u670B\u53CB\u5728\u9547\u4E0A\u6211\u5F88\u5F00\u5FC3\u3002$h",
    "Wed": "\u4F60\u5DF2\u7ECF\u5728\u8FD9\u513F\u5446\u4E86\u4E00\u6BB5\u65F6\u95F4\u4E86\uFF0C\u4E0D\u662F\u5417\uFF1F\u4F60\u7684\u519C\u573A\u73B0\u5728\u4E00\u5B9A\u662F\u84B8\u84B8\u65E5\u4E0A\u3002",
    "Wed10": "\u751F\u547D\u672C\u8EAB\u5C31\u662F\u7279\u522B\u7684\u793C\u7269\uFF0C\u5B83\u8BF4\u6765\u5C31\u6765\uFF0C\u8BF4\u8D70\u5C31\u8D70\u2026\u2026\u6C38\u8FDC\u4E0D\u8981\u5FD8\u8BB0\u8FD9\u4E00\u70B9\u3002",
    "Wed6": "\u2026\u2026\u6211\u5728\u6218\u4E89\u4E2D\u5931\u53BB\u4E86\u597D\u591A\u670B\u53CB\u3002$s#$e#\u6700\u53EF\u60B2\u7684\u662F\u6211\u5C45\u7136\u8FDE\u4ED6\u4EEC\u7684\u9762\u5B54\u90FD\u60F3\u4E0D\u8D77\u6765\u4E86\u3002#$e#\u2026\u2026",
    "accept_864": "\u2026\u2026\uFF01$4#$b#\u2026\u2026\u4F60\u662F\u5728\u54EA\u627E\u5230\u8FD9\u4E2A\u7684\uFF1F$4#$b#\u2026\u2026$5#$b#\u2026\u2026\u8FD9\u4E2A\u4EBA\u2026\u2026\u6211\u4EEC\u66FE\u5728\u6218\u4E89\u4E2D\u5E76\u80A9\u4F5C\u6218\uFF0C@\u3002\u5BF9\u6211\u6765\u8BF4\uFF0C\u4ED6\u5C31\u50CF\u662F\u5144\u5F1F\u4E00\u6837\u3002#$b#\u53EF\u662F\u2026\u2026\u53EA\u6709\u6211\u6D3B\u7740\u56DE\u6765\u4E86\u3002$5#$b#\u5C3D\u7BA1\u5982\u6B64\uFF0C\u4ED6\u4ECE\u672A\u4E27\u5931\u8FC7\u52C7\u6C14\uFF0C\u5373\u4FBF\u9762\u4E34\u6B7B\u4EA1\u4E5F\u662F\u5982\u6B64\u3002\u4ED6\u662F\u771F\u6B63\u7684\u82F1\u96C4\u2026\u2026\u6211\u6C38\u8FDC\u4E0D\u4F1A\u5FD8\u8BB0\u4ED6\u3002#$b#\u8C22\u8C22\u4F60\u628A\u8FD9\u4E2A\u5E26\u7ED9\u6211\u2026\u2026\u8FD9\u5BF9\u6211\u6765\u8BF4\u5F88\u91CD\u8981\u3002#$b#\u6765\uFF0C\u62FF\u7740\u8FD9\u4E2A\u3002\u8FD9\u4E1C\u897F\u653E\u5728\u6211\u5BB6\u6A71\u67DC\u6DF1\u5904\u5DF2\u7ECF\u5F88\u591A\u5E74\u4E86\uFF0C\u6211\u4EEC\u4ECE\u6765\u6CA1\u7528\u8FC7\u3002",
    "eventSeen_100_memory_oneday": "\u90A3\u5929\u7684\u4E8B\u60C5\u975E\u5E38\u62B1\u6B49\u3002#$e#\u6211\u4E0D\u60F3\u88AB\u7279\u6B8A\u5BF9\u5F85\uFF0C\u6211\u53EA\u662F\u60F3\u5F53\u4E00\u4E2A\u666E\u901A\u4EBA\uFF0C\u8DDF\u5927\u5BB6\u4E00\u6837\u3002",
    "event_popcorn1": "\u522B\u518D\u8BF4\u4E86\uFF01\u4E0D\u8981\u8BA9\u6211\u4EEC\u592B\u59BB\u4FE9\u53D1\u751F\u77DB\u76FE\u4E86\u3002$u",
    "event_popcorn2": "\u2026\u2026$s#$b#\u4F60\u8BF4\u7684\u5B8C\u5168\u6B63\u786E\uFF0C@\u3002$s",
    "event_popcorn3": "\u522B\u5728\u6211\u9762\u524D\u6492\u8C0E\uFF01\u6211\u6700\u8BA8\u538C\u7684\u5C31\u662F\u6492\u8C0E\uFF01$u",
    "married_Sam": "\u80FD\u770B\u5230\u513F\u5B50\u6210\u957F\u4E3A\u4E00\u4E2A\u7537\u4EBA\uFF0C\u4F5C\u4E3A\u7236\u4EB2\u6211\u5F88\u81EA\u8C6A\u3002\u5E0C\u671B\u4F60\u4EEC\u4EE5\u540E\u80FD\u8D8A\u8FC7\u8D8A\u597D\u3002$h",
    "reject_865": "\u55EF\u2026\u2026\u5C01\u5F97\u5F88\u7D27\uFF0C\u8FD9\u6837\u4E00\u6765\u5473\u9053\u5E94\u8BE5\u8FD8\u662F\u5F88\u8DB3\u7684\u3002"
  }
