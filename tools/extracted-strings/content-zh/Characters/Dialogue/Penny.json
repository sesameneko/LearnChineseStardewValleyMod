    "AcceptBirthdayGift_Loved": "\u554A\uFF01\u8FD9\u662F\u7ED9\u6211\u7684\u5417\uFF1F\u7B97\u662F\u2026\u2026\u751F\u65E5\u793C\u7269\uFF1F$3#$b#\uFF08\u5438\u9F3B\u5B50\uFF09\u2026\u2026\u62B1\u6B49\u3002$s#$b#\u6211\u5C31\u662F\u6709\u70B9\u2026\u2026\u6CA1\u4E60\u60EF\u522B\u4EBA\u5BF9\u6211\u8FD9\u4E48\u597D\u3002#$b#\u2026\u2026\u5443\uFF0C\u6211\u8D85\u559C\u6B22\u8FD9\u4E2A\uFF0C\u771F\u7684\u3002\u975E\u5E38\u611F\u8C22\u4F60\u3002",
    "AcceptBirthdayGift_Negative": "\u7ED9\u6211\u7684\u751F\u65E5\u793C\u7269\u5417\uFF1F\u4F60\u5BF9\u6211\u771F\u597D\uFF01\u6211\u62C6\u5F00\u770B\u770B\u2026\u2026$h#$b#\u2026\u2026\u600E\u4E48\u56DE\u4E8B\uFF1F\uFF01$12#$b#\u2026\u2026\u5509\uFF0C\u597D\u5427\u3002\u539F\u6765\u662F\u4E2A\u523B\u8584\u7684\u73A9\u7B11\u3002$s#$b#\u6211\u771F\u50BB\uFF0C\u6211\u65E9\u8BE5\u660E\u767D\u7684\u2026\u2026$s",
    "AcceptBirthdayGift_Positive": "\u7ED9\u6211\u7684\u751F\u65E5\u793C\u7269\u5417\uFF1F\u4F60\u5BF9\u6211\u771F\u597D\uFF01\u6211\u5F88\u559C\u6B22\u3002$h",
    "AcceptGift_(O)StardropTea": "\u55EF\u2026\u2026\u597D\u9999\u554A\uFF0C\u6211\u5F88\u559C\u6B22\u3002",
    "AcceptGift_Positive_ancient_item": "\u54C7\u2026\u2026\u8FD9\u662F\u4E2A\u53E4\u8463\u5427\uFF0C\u6211\u5F97\u62FF\u53BB\u7ED9\u5188\u745F\u770B\u770B\u3002\u8C22\u8C22\u4F60\uFF01$h",
    "AcceptGift_Positive_book_item": "\u8C22\u8C22\u4F60\uFF01\u6211\u73B0\u5728\u8BFB\u7684\u4E66\u9A6C\u4E0A\u5C31\u770B\u5B8C\u4E86\uFF0C\u63A5\u4E0B\u6765\u6211\u5C31\u770B\u8FD9\u672C\uFF01$h",
    "FlowerDance_Accept": "\u6B38\u2026\u2026\u8DDF\u6211\u5417\uFF1F\u5F53\u7136\u53EF\u4EE5\u554A\uFF01$h#$b#\u2026\u2026\u90A3\u4E2A\uFF0C\u4F60\u80FD\u4E0D\u80FD\u5E26\u7740\u6211\u4E00\u70B9\uFF1F\u6211\u6709\u70B9\u7D27\u5F20\u2026\u2026$12",
    "FlowerDance_Accept_Spouse": "\u6211\u63A5\u53D7\uFF01$h#$b#*\u4F4E\u58F0\u8BF4*\u4F60\u8FD9\u4E8B\u60C5\u529E\u7684\u5F88\u6B63\u89C4\uFF0C\u8C22\u8C22\u4E86\uFF0C\u4EB2\u7231\u7684\u3002",
    "FlowerDance_Decline": "\u5662\u2026\u2026\u4E0D\u7528\u4E86\uFF0C\u8C22\u8C22\u3002$s",
    "Fri": "\u5982\u679C\u5728\u571F\u5730\u4E0A\u6F5C\u5FC3\u6316\u6398\uFF0C\u662F\u4F1A\u627E\u51FA\u6709\u610F\u601D\u7684\u4E1C\u897F\u7684\u3002#$e#\u6709\u4E00\u6B21\u6211\u627E\u5230\u4E00\u5757\u65E7\u74F7\u5668\u7684\u788E\u7247\u3002\u62FF\u53BB\u7ED9\u5188\u745F\u4E00\u770B\uFF0C\u4ED6\u7ADF\u7136\u8BF4\u90A3\u4E1C\u897F\u6709\u4E00\u5343\u5E74\u4EE5\u4E0A\u7684\u5386\u53F2\u5462\u3002",
    "Fri4": "\u6BCF\u5929\u90FD\u8981\u5237\u7897\u626B\u9664\u3002\u5443\u2026\u2026\u5982\u679C\u5988\u5988\u6BCF\u665A\u4E0D\u559D\u9152\uFF0C\u65E9\u65E9\u5C31\u56DE\u6765\u6309\u65F6\u7761\u89C9\uFF0C\u6216\u8BB8\u4E5F\u80FD\u5E2E\u6211\u505A\u70B9\u5BB6\u52A1\u5462\u3002$s",
    "Fri8": "\u6211\u4E0D\u8BE5\u6574\u5929\u56E0\u4E3A\u505A\u5BB6\u52A1\u800C\u53D1\u7262\u9A9A\u2026\u2026\u4E16\u754C\u4E0A\u8FD8\u6709\u4EBA\u5728\u6C34\u6DF1\u706B\u70ED\u4E4B\u4E2D\uFF0C\u6211\u5374\u5728\u8FD9\u62B1\u6028\u6D17\u7897\u7684\u4E8B\u60C5\u2026\u2026$s",
    "GreenRain": "\u4F60\u6CA1\u4E8B\u5427\uFF1F\u6211\u4EEC\u90FD\u641E\u4E0D\u6E05\u695A\u53D1\u751F\u4EC0\u4E48\u4E86\u2026\u2026$3",
    "GreenRain_2": "\u8FD9\u79CD\u5947\u602A\u7684\u5929\u6C14\u53EF\u4EE5\u8BA9\u5B69\u5B50\u4EEC\u5BF9\u5927\u81EA\u7136\u4EA7\u751F\u5174\u8DA3\uFF01$h",
    "Introduction": "\u54E6\u2026\u2026\u4F60\u597D\uFF01\u6211\u662F\u6F58\u59AE\u2026\u2026",
    "Mon": "\u4F60\u597D\u2026\u2026#$e#\u600E\u4E48\uFF0C\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F",
    "Mon4": "*\u5509*\u2026\u2026\u6211\u5988\u6BCF\u5929\u665A\u4E0A\u90FD\u53BB\u9152\u5427\u559D\u9152\uFF0C\u6015\u662F\u4E0A\u763E\u4E86\u3002$s#$q 7/8 Mon_old#\u4F46\u679C\u7136\u8FD8\u662F\u4E0D\u8981\u603B\u60F3\u7740\u6D88\u6781\u7684\u4E00\u9762\u5427\uFF1F#$r 7 50 Mon_7#\u6CA1\u9519\u3002\u8FD8\u662F\u4FDD\u6301\u4E50\u89C2\u6BD4\u8F83\u597D\u54E6\uFF01#$r 8 10 Mon_8#\u8FD8\u662F\u73B0\u5B9E\u4E00\u70B9\u6BD4\u8F83\u597D\u5427\u3002",
    "Mon8": "\u6211\u5176\u5B9E\u5F88\u60F3\u642C\u51FA\u53BB\u4F4F\u3002\u6BCF\u665A\u62C5\u5FC3\u5988\u5988\u4F1A\u4E0D\u4F1A\u559D\u591A\uFF0C\u771F\u7684\u5F88\u7D2F\u3002#$e#\u6211\u4E5F\u60F3\u4E00\u76F4\u966A\u7740\u5979\uFF0C\u8BA9\u5979\u9AD8\u5174\uFF0C\u4F46\u4E0D\u80FD\u603B\u8FD9\u6837\u4E0B\u53BB\u554A\u2026\u2026\u4F60\u660E\u767D\u7684\u5427\uFF1F$s",
    "Mon_7": "\u6211\u4E5F\u662F\u8FD9\u4E48\u60F3\u7684\u3002\u53EA\u8981\u96C6\u4E2D\u7CBE\u529B\u8BA9\u672A\u6765\u53D8\u5F97\u66F4\u597D\u5C31\u662F\u3002",
    "Mon_8": "\u6216\u8BB8\u4F60\u8BF4\u5F97\u5BF9\u3002\u8FD8\u662F\u63A5\u53D7\u73B0\u5B9E\u6BD4\u8F83\u597D\u3002$u",
    "Mon_old": "#$p 7#\u4E0D\u8FC7\u5982\u679C\u6211\u7EE7\u7EED\u52AA\u529B\uFF0C\u5E94\u8BE5\u662F\u80FD\u529D\u5979\u56DE\u5934\u7684\u5427\u3002|\u7684\u786E\u5982\u6B64\u3002\u8FD9\u4E8B\u6211\u4E5F\u6CA1\u4EC0\u4E48\u529E\u6CD5\u5462\u3002",
    "Resort": "\u8FD9\u91CC\u7684\u6C99\u5B50\u771F\u662F\u67D4\u8F6F\u53C8\u7EC6\u817B\u3002\u811A\u8DBE\u4E0A\u7684\u89E6\u611F\u771F\u597D\uFF01$h",
    "Resort_Entering": "\u8FD9\u5EA7\u5C9B\u771F\u662F\u592A\u6F02\u4EAE\u4E86\uFF01",
    "Resort_Leaving": "\u6211\u73A9\u5F97\u5F88\u5F00\u5FC3\u3002$h",
    "Resort_Shore": "\u5F53\u4F17\u7A7F\u7740\u6CF3\u8863\u611F\u89C9\u6709\u70B9\u4E0D\u597D\u610F\u601D\u3002$s#$b#\u6211\u5E0C\u671B\u6CA1\u4EBA\u5728\u770B\u2026\u2026$s",
    "Resort_Shore_2": "\u8FD9\u91CC\u7684\u6C34\u770B\u8D77\u6765\u6709\u70B9\u4E0D\u4E00\u6837\u2026\u2026#$e#\u6211\u5F88\u96BE\u76F8\u4FE1\uFF0C\u8FD9\u91CC\u548C\u6211\u6CE8\u89C6\u4E86\u4E00\u8F88\u5B50\u7684\u6D77\u6C34\u7ADF\u7136\u5C5E\u4E8E\u540C\u4E00\u7247\u5927\u6D0B\u3002",
    "Resort_Towel": "\u98CE\u603B\u662F\u628A\u6211\u7684\u4E66\u9875\u5439\u4E71\uFF0C\u5439\u5728\u76AE\u80A4\u4E0A\u7684\u611F\u89C9\u771F\u8212\u670D\u3002$h",
    "Resort_Towel_2": "\u6211\u5728\u8BFB\u4E00\u672C\u4E66\uFF0C\u8BB2\u7684\u662F\u4E00\u540D\u6C34\u624B\u6D41\u843D\u5230\u8352\u5C9B\u4E0A\u7684\u6545\u4E8B\u3002#$b#\u6211\u5728\u60F3\u5982\u679C\u6211\u5904\u5728\u90A3\u6837\u7684\u60C5\u51B5\u4E0B\uFF0C\u4F1A\u600E\u4E48\u505A\u5462\uFF1F",
    "Resort_Towel_2_Married": "\u4EB2\u7231\u7684\uFF0C\u4F60\u53EF\u4EE5\u7A0D\u5FAE\u5F80\u5DE6\u8FB9\u7AD9\u4E00\u70B9\u5417\uFF1F#$b#\u8C22\u8C22\uFF0C\u5728\u9633\u5149\u4E0B\u4E0D\u592A\u5BB9\u6613\u9605\u8BFB\uFF01$h",
    "Sat": "\u9547\u5B50\u5F88\u5C0F\uFF0C\u6240\u6709\u4EBA\u81EA\u7136\u90FD\u5341\u5206\u719F\u7EDC\u3002#$e#\u4E0D\u77E5\u57CE\u5E02\u91CC\u53C8\u662F\u4EC0\u4E48\u6837\u7684\u5462\uFF1F",
    "Sat2": "$d Joja#Joja \u8D85\u5E02\u5F00\u4E86\u4E4B\u540E\uFF0C\u9547\u4E0A\u7684\u4E8B\u60C5\u90FD\u4E0D\u4E00\u6837\u4E86\u3002\u76AE\u57C3\u5C14\u7684\u5546\u5E97\u73B0\u5728\u5F88\u4E0D\u666F\u6C14\u3002\u4E0D\u8FC7\u5988\u5988\u7279\u522B\u559C\u6B22 Joja\u3002\u6BD4\u8D77\u76AE\u57C3\u5C14\u5546\u5E97\uFF0C\u5728\u90A3\u91CC\u53EF\u4EE5\u4E70\u5230\u5F88\u591A\u5F88\u4FBF\u5B9C\u7684\u4E1C\u897F\u3002|\u81EA\u4ECE Joja \u505C\u4E1A\u4E4B\u540E\uFF0C\u5988\u5988\u5C31\u4E00\u76F4\u5728\u62B1\u6028\u3002\u4E0D\u8FC7\u6211\u89C9\u5F97\u8FD9\u6837\u5BF9\u5979\u4E5F\u597D\u3002\u6216\u8BB8\u5979\u73B0\u5728\u4E0D\u4F1A\u5929\u5929\u559D Joja \u53EF\u4E50\u4E86\u3002",
    "Sun": "\u4F60\u597D\u3002\u5514\u5514\u2026\u2026$u#$b#\u4ECA\u5929\u7684\u5929\u6C14\u8FD8\u771F\u662F\u7279\u522B\u5462\uFF0C\u4E0D\u89C9\u5F97\u5417\uFF1F#$e#\u62B1\u6B49\u2026\u2026$u",
    "Sun4": "\u867D\u7136\u6211\u4E00\u76F4\u90FD\u6709\u6CE8\u610F\uFF0C\u60F3\u4FDD\u6301\u623F\u95F4\u6E05\u6D01\uFF0C\u4F46\u5374\u603B\u662F\u4E71\u7CDF\u7CDF\u7684\u3002$s#$e#\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u5DE5\u4F5C\u8FD8\u8981\u505A\u5BB6\u52A1\u771F\u7684\u5F88\u7D2F\u3002$u",
    "Thu": "\u8FD9\u4E48\u5C0F\u7684\u9547\u4E0A\u8FD8\u5EFA\u4E86\u56FE\u4E66\u9986\uFF0C\u6211\u4EEC\u771F\u662F\u5341\u5206\u5E78\u8FD0\u3002#$e#\u5F53\u4F60\u6C89\u6D78\u5728\u4E66\u4E2D\u7684\u4E16\u754C\u65F6\uFF0C\u5F88\u5BB9\u6613\u5C31\u5FD8\u8BB0\u4E86\u73B0\u5B9E\u7684\u5E73\u51E1\u4E0E\u55A7\u56A3\u3002$u#$e#\u2026\u2026\u6216\u8BB8\u8FD9\u5C31\u662F\u6211\u559C\u7231\u8BFB\u4E66\u7684\u7406\u7531\u5427\u3002$s#$e#\u2026\u2026\u62B1\u6B49\u3002\u662F\u4E0D\u662F\u6709\u70B9\u5570\u55E6\u4E86\u5462\u3002",
    "Thu6": "\u5982\u679C\u80FD\u5F00\u4E2A\u5C0F\u82B1\u56ED\u5C31\u597D\u4E86\uFF0C\u4E0D\u8FC7\u6211\u4EEC\u7684\u524D\u9662\u5B9E\u5728\u662F\u592A\u810F\u4E86\u3002$u#$e#\u6216\u8BB8\u6709\u4E00\u5929\uFF0C\u6211\u4E5F\u80FD\u4F4F\u5728\u6709\u82B1\u56ED\u7684\u5730\u65B9\u3002#$e#\u4E5F\u8BB8\u6211\u4F1A\u4F4F\u5728\u519C\u573A\u5462\uFF01* \u54AF\u54AF\u7B11 *$h",
    "Tue": "\u4ECA\u5929\u6211\u8BE5\u53BB\u8F85\u5BFC\u6587\u68EE\u7279\u548C\u8D3E\u65AF\u4E86\u2026\u2026\u4ED6\u4EEC\u4E24\u4E2A\u867D\u7136\u6DD8\u6C14\uFF0C\u4F46\u80FD\u6559\u4E66\u80B2\u4EBA\u8BA9\u6211\u611F\u5230\u5F88\u5F00\u5FC3\u3002",
    "Tue10": "\u5443\uFF0C@\uFF1F\u5982\u679C\u8981\u517B\u5C0F\u5B69\u7684\u8BDD\uFF0C\u519C\u573A\u662F\u4E2A\u4E0D\u9519\u7684\u5730\u65B9\uFF0C\u4F60\u89C9\u5F97\u5462\uFF1F$l#$e#\u6211\u4E5F\u53EA\u662F\u968F\u4FBF\u60F3\u60F3\u5566\u3002$l",
    "Tue4": "$d bus#\u4E0D\u8FC7\u5982\u679C\u5988\u5988\u80FD\u91CD\u65B0\u5F53\u56DE\u5DF4\u58EB\u53F8\u673A\u7684\u8BDD\uFF0C\u6211\u4EEC\u5C31\u80FD\u5B58\u66F4\u591A\u7684\u94B1\u4E86\u3002\u55EF\uFF0C\u672A\u6765\u4E5F\u7A0D\u5FAE\u5149\u660E\u4E86\u4E00\u4E9B\u5462\u3002|\u6211\u5F53\u5BB6\u6559\u7684\u94B1\u672C\u6765\u662F\u60F3\u5B58\u8D77\u6765\u7684\uFF0C\u53EF\u5988\u5988\u6CA1\u6709\u5DE5\u4F5C\uFF0C\u5F88\u96BE\u5B58\u94B1\u3002$s",
    "Wed": "\u867D\u7136\u9547\u91CC\u6CA1\u6709\u5B66\u6821\uFF0C\u4F46\u6211\u4E00\u76F4\u90FD\u5728\u52AA\u529B\uFF0C\u60F3\u8981\u597D\u597D\u6559\u5BFC\u6587\u68EE\u7279\u4E0E\u8D3E\u65AF\u3002#$e#\u6BCF\u4E2A\u5B69\u5B50\u90FD\u5E94\u8BE5\u6709\u6210\u529F\u7684\u673A\u4F1A\u624D\u5BF9\u3002#$e#\u8D3E\u65AF\u7684\u6570\u5B66\u548C\u9605\u8BFB\u7406\u89E3\u90FD\u5F88\u4E0D\u9519\u3002\u6587\u68EE\u7279\u4ED6\u2026\u2026\u5514\uFF0C\u4ED6\u7684\u60F3\u8C61\u529B\u5F88\u4E30\u5BCC\u54E6\uFF01",
    "Wed2": "\u5BF9\u4E86\uFF01\u6211\u89C9\u5F97\u5E94\u8BE5\u5E26\u5B69\u5B50\u53BB\u91CE\u5916\u90CA\u6E38\u3002\u5E72\u8106\u53BB\u68EE\u6797\u597D\u4E86\u3002#$e#\u6700\u597D\u518D\u8BF7\u4E00\u4E2A\u7279\u9080\u8BB2\u5E08\u2026\u2026\u627E\u4E00\u4E2A\u719F\u6089\u81EA\u7136\u7684\u4EBA\u5982\u4F55\uFF1F#$e#\u62B1\u6B49\uFF0C\u6211\u53EA\u662F\u5728\u81EA\u8A00\u81EA\u8BED\u800C\u5DF2\u3002",
    "Wed4": "\u6211\u8FD9\u4E00\u8F88\u5B50\u90FD\u662F\u5728\u9E48\u9E55\u9547\u5EA6\u8FC7\u7684\u3002\u60F3\u60F3\u4E5F\u771F\u662F\u6709\u4E9B\u96BE\u4EE5\u7F6E\u4FE1\u3002#$e#\u8FD9\u4E16\u4E0A\u6709\u8BB8\u591A\u4E8B\u60C5\uFF0C\u6211\u6015\u662F\u90FD\u89C1\u4E0D\u5230\u4E86\u3002",
