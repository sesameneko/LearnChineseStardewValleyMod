    "Bad_7": "\u6211\u66FE\u7ECF\u5BF9\u4F60\u6765\u8BF4\u5F88\u7279\u522B\u2026\u2026\u4F46\u73B0\u5728\uFF0C\u53EA\u6709\u505A\u987F\u70ED\u817E\u817E\u7684\u665A\u9910\u624D\u80FD\u8BA9\u4F60\u5BB9\u5FCD\u6211\u3002$s",
    "Bad_8": "\u6700\u8FD1\u4F60\u5BF9\u6211\u597D\u51B7\u6DE1\u2026\u2026\u4F60\u5230\u5E95\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\u4F60\u7B80\u76F4\u50CF\u4E2A\u6CE5\u6CBC\u7CBE\u7075\u2026\u2026$s",
    "Bad_9": "\u4E0D\u77E5\u9053\u6211\u662F\u4E0D\u662F\u9009\u9519\u4E86\u2026\u2026\u5728\u6211\u4EEC\u76F8\u9047\u4E4B\u524D\u6211\u548C\u585E\u5DF4\u65AF\u8482\u5B89\u5C31\u662F\u597D\u670B\u53CB\u3002\u4E5F\u8BB8\u4ED6\u624D\u662F\u90A3\u4E2A\u552F\u4E00\u2026\u2026$s",
    "Good_1": "\u4F60\u542C\u5230\u90A3\u58F0\u97F3\u4E86\u5417\uFF1F\u6709\u65F6\u5019\u6211\u89C9\u5F97\u8FD9\u680B\u623F\u5B50\u95F9\u9B3C\u3002$u",
    "Good_2": "\u7EF4\u5C14\u7EF4\u514B\u5360\u661F\u9884\u8A00\u8BF4\u6211\u4ECA\u5929\u4F1A\u53D1\u751F\u5927\u597D\u4E8B\u3002\u6211\u611F\u89C9\u5145\u6EE1\u4E86\u5E72\u52B2\uFF01",
    "Good_3": "\u6211\u751A\u81F3\u4E0D\u8BB0\u5F97\u4E0A\u6B21\u67D3\u53D1\u662F\u4EC0\u4E48\u65F6\u5019\u4E86\u2026\u2026\u6211\u53D1\u8A93\uFF0C\u6211\u5934\u53D1\u7EDD\u5BF9\u6CA1\u6709\u892A\u8272\u2026\u2026",
    "Good_4": "\u5E78\u597D\u6211\u5728\u642C\u8FDB\u6765\u4E4B\u524D\u5C31\u6709\u4E00\u53CC\u7ED3\u5B9E\u7684\u9774\u5B50\u3002\u5F88\u96BE\u60F3\u8C61\u7A7F\u7740\u8FD0\u52A8\u978B\u8E2E\u7740\u811A\u4ECE\u6CE5\u4E2D\u8D70\u8FC7\u3002$h",
    "Good_5": "\u6211\u53EA\u662F\u5728\u6B23\u8D4F\u4F60\u9001\u6211\u7684\u7F8E\u4EBA\u9C7C\u540A\u5760\u2026\u2026\u6211\u4F1A\u4E00\u76F4\u6234\u7740\u5B83\uFF0C\u76F4\u5230\u751F\u547D\u7684\u5C3D\u5934\u3002$l",
    "Good_6": "\u563F\u3002\u6211\u77E5\u9053\u4F60\u5F88\u806A\u660E\uFF0C\u4F46\u6709\u65F6\u5019\u6211\u8FD8\u662F\u4F1A\u62C5\u5FC3\u4F60\u3002\u8FD9\u4E16\u754C\u4E0A\u5230\u5904\u90FD\u662F\u602A\u7269\u3002$6#$e#\u7B54\u5E94\u6211\u4F60\u4F1A\u5C0F\u5FC3\u3002\u6211\u4E0D\u60F3\u5931\u53BB\u4F60\u3002",
    "Good_7": "@\uFF1F\u6211\u53EA\u662F\u60F3\u8BF4\uFF0C\u6211\u8981\u611F\u8C22\u4F60\u4E3A\u6211\u4EEC\u505A\u51FA\u7684\u4E00\u5207\u52AA\u529B\u3002\u6211\u771F\u4E3A\u4F60\u611F\u5230\u9A84\u50B2\u3002$l",
    "Indoor_Day_0": "\u5728\u4F60\u642C\u8FDB\u6765\u4E4B\u524D\u6211\u5C31\u4E00\u76F4\u5F88\u559C\u6B22\u8FD9\u4E2A\u5730\u65B9\u3002\u73B0\u5728\u6211\u968F\u65F6\u90FD\u80FD\u63A2\u7D22\u519C\u573A\u4E86\uFF01$h",
    "Indoor_Day_1": "\u563F\uFF0C@\u3002\u53BB\u91CE\u5916\u5417\uFF1F\u6211\u6709\u4E1C\u897F\u8981\u7ED9\u4F60\u2026\u2026[286 287 205 732]#$e#\u5728\u4F60\u5904\u5883\u8270\u96BE\u7684\u65F6\u5019\u53EF\u4EE5\u7528\u5F97\u4E0A\u3002\u8FD9\u5E94\u8BE5\u80FD\u786E\u4FDD\u4F60\u7684\u5B89\u5168\u3002",
    "Indoor_Day_2": "\u53BB\u77FF\u573A\u5417\uFF1F\u563F\u2026\u2026\u5982\u679C\u4F60\u627E\u5230\u4EC0\u4E48\u597D\u5403\u7684\u4E1C\u897F\uFF0C\u8BB0\u5F97\u7ED9\u6211\u5E26\u4E00\u4EFD\uFF01$h",
    "Indoor_Day_3": "\u563F\uFF01\u6211\u53EA\u662F\u5728\u60F3\u6211\u4ECA\u5929\u5E94\u8BE5\u5E72\u561B\u3002\u6211\u8FD8\u4E0D\u4E60\u60EF\u8FD9\u4E48\u81EA\u7531\uFF01",
    "Indoor_Day_4": "\u6211\u5076\u5C14\u91CD\u65B0\u88C5\u4FEE\u4E00\u4E0B\u4F60\u662F\u4E0D\u4F1A\u4ECB\u610F\u7684\uFF0C\u5BF9\u5427\uFF1F\u6709\u7247\u80FD\u81EA\u5DF1\u88C5\u4FEE\u7684\u5730\u65B9\u4ECD\u8BA9\u6211\u611F\u5230\u5174\u594B\u3002",
    "Indoor_Day_Abigail": "\u6211\u4EEC\u7684\u519C\u573A\u603B\u662F\u6709\u65B0\u9C9C\u4E8B\u53D1\u751F\u2026\u2026\u6211\u7231\u8FD9\u6837\u7684\u751F\u6D3B\u3002",
    "Indoor_Night_0": "\u4ECA\u5929\u6211\u8FC7\u5F97\u5F88\u6109\u5FEB\u3002\u5982\u679C\u4F60\u7559\u5FC3\u89C2\u5BDF\u7684\u8BDD\uFF0C\u5C31\u4F1A\u53D1\u73B0\u8FD9\u91CC\u603B\u5728\u53D1\u751F\u4E9B\u6709\u8DA3\u7684\u4E8B\u513F\u3002",
    "Indoor_Night_1": "\u563F\uFF01\u8BF4\u8BF4\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\u554A\u3002\u53D1\u751F\u4EC0\u4E48\u4EE4\u4EBA\u5174\u594B\u7684\u4E8B\u4E86\u5417\uFF1F$h",
    "Indoor_Night_2": "\u6211\u66FE\u7ECF\u662F\u4E2A\u591C\u732B\u5B50\uFF0C\u4F46\u662F\u6211\u6B63\u5F00\u59CB\u4EAB\u53D7\u519C\u573A\u751F\u6D3B\u7684\u8282\u594F\u3002\u611F\u89C9\u5F88\u81EA\u7136\u3002",
    "Indoor_Night_3": "*\u54C8\u6B20*\u2026\u2026\u6211\u9A6C\u4E0A\u5C31\u51C6\u5907\u597D\u6536\u5DE5\u7761\u89C9\u4E86\u3002$h",
    "Indoor_Night_4": "\u8FD9\u91CC\u665A\u4E0A\u7684\u58F0\u97F3\u6709\u70B9\u5927\u3002\u6211\u4F1A\u4E00\u76F4\u5F88\u4EAB\u53D7\u5B83\u7684\u3002",
    "Indoor_Night_Abigail": "\u51C6\u5907\u8FC7\u4E00\u4F1A\u513F\u5C31\u7761\u5417\uFF1F\u6211\u53BB\u628A\u7535\u70ED\u6BEF\u6253\u5F00\u2026\u2026$l",
    "Neutral_0": "\u7B49\u5230\u6211\u767D\u53D1\u82CD\u82CD\uFF0C\u6211\u5E0C\u671B\u4F60\u8FD8\u4F1A\u559C\u6B22\u6211\u3002\u603B\u4F1A\u6709\u8FD9\u4E00\u5929\u7684\uFF01",
    "Neutral_1": "\u4F60\u89C9\u5F97\u7237\u7237\u4F1A\u4E3A\u6211\u4EEC\u611F\u5230\u9A84\u50B2\u5417\uFF1F",
    "Neutral_6": "\u4E0D\u77E5\u9053\u8001\u5E97\u600E\u4E48\u6837\u4E86\uFF1F\u6211\u5E94\u8BE5\u5C3D\u65E9\u518D\u53BB\u63A2\u671B\u4E00\u4E0B\u7236\u6BCD\u3002",
    "Neutral_7": "\u5982\u679C\u4F60\u53BB\u4E86\u7075\u754C\uFF0C\u6211\u4F1A\u5728\u7237\u7237\u65C1\u8FB9\u4E3A\u4F60\u8BBE\u4E00\u4E2A\u5C0F\u795E\u9F9B\u3002",
    "Neutral_8": "\u4E0D\u7BA1\u6211\u4EEC\u600E\u4E48\u6253\u626B\uFF0C\u623F\u5B50\u8FD8\u662F\u4F1A\u53D8\u810F\u3002#$e#\u4E5F\u8BB8\u662F\u519C\u573A\u672C\u6765\u5C31\u633A\u810F\u7684\u5427\u3002",
    "Neutral_9": "\u4E0D\u77E5\u9053\u6211\u4EEC\u4F1A\u4E0D\u4F1A\u8FD9\u8F88\u5B50\u4E00\u76F4\u4F4F\u5728\u8FD9\u91CC\uFF1F\u6211\u53EF\u80FD\u4F1A\u89C9\u5F97\u65E0\u804A\u3002",
    "OneKid_3": "\u6211\u771F\u4E0D\u6562\u76F8\u4FE1\u6211\u662F\u4E00\u4F4D\u201C\u5988\u5988\u201D\u4E86\u2026\u2026\u751F\u6D3B\u771F\u5947\u5999\u3002$h",
    "Outdoor_0": "\u4ECA\u5929\u8C37\u91CC\u5439\u8FC7\u5FAE\u98CE\uFF0C\u629A\u52A8\u5C71\u91CC\u7684\u7A7A\u6C14\u3002\u95FB\u8D77\u6765\u50CF\u6E05\u65B0\u7684\u677E\u6811\u548C\u6D0B\u82CF\u8349\u3002",
    "Outdoor_1": "\u55EF\u2026\u2026\u6211\u60F3\u6211\u4EEC\u5DF2\u7ECF\u6709\u5F88\u5927\u7684\u7A7A\u95F4\u6765\u653E\u517B\u53F2\u83B1\u59C6\u4E86\uFF01",
    "Outdoor_2": "\u4FDD\u6301\u4F60\u7237\u7237\u795E\u9F9B\u5E72\u51C0\u6574\u6D01\u3002\u6211\u80FD\u611F\u89C9\u5230\uFF0C\u5B83\u6709\u4E9B\u7279\u6B8A\u4E4B\u5904\u3002",
    "Outdoor_3": "\u6211\u4EEC\u62E5\u6709\u4E00\u4E2A\u5C71\u6D1E\uFF0C\u8FD9\u592A\u9177\u4E86\uFF01\u7B80\u76F4\u8BA9\u6211\u68A6\u60F3\u6210\u771F\u4E86\u3002$h",
    "Outdoor_4": "\u6211\u603B\u662F\u5FD8\u8BB0\u5728\u53E3\u888B\u91CC\u9762\u653E\u4E00\u4E9B\u96F6\u98DF\u3002*\u809A\u5B50\u5495\u5495\u53EB*$h",
    "Outdoor_Abigail": "\u6211\u5C31\u5728\u8FD9\u901B\u901B\uFF0C\u53EF\u4EE5\u5417\uFF1F#$e#\u8FD9\u513F\u6709\u8BB8\u591A\u6709\u8DA3\u7684\u866B\u5B50\u548C\u5C0F\u4E1C\u897F\u3002*\u8F7B\u7B11*$h",
    "Rainy_Day_0": "\u8FD9\u591C\u8272\u2026\u2026\u8FD9\u96E8\u2026\u2026\u8BA9\u6211\u5F88\u5174\u594B\u3002$l",
    "Rainy_Day_1": "\u563F\uFF0C\u8FD8\u8BB0\u5F97\u6211\u4EEC\u4E4B\u524D\u5728\u6E56\u8FB9\u5BF9\u5531\u5417\uFF1F\u8FD9\u5929\u6C14\u8BA9\u6211\u60F3\u8D77\u4E86\u90A3\u5929\u3002#$e#\u4F60\u7528\u90A3\u8FF7\u4F60\u7AD6\u7434\u60CA\u8273\u5230\u6211\u4E86\u2026\u2026\u5B8C\u5168\u51FA\u4E4E\u6211\u7684\u610F\u6599\u3002\u6211\u731C\u8FD9\u5C31\u662F\u6211\u8FD9\u4E48\u559C\u6B22\u4F60\u7684\u539F\u56E0\u3002$l",
    "Rainy_Day_2": "\u563F\uFF01\u6211\u4ECA\u5929\u65E9\u8D77\u5E76\u81EA\u5DF1\u53BB\u63A2\u9669\u4E86\u3002\u6211\u53D1\u73B0\u4E86\u8FD9\u4E2A\uFF0C\u8FD9\u8BA9\u6211\u60F3\u5230\u4E86\u4F60\u3002[768 767 769 66 82]#$e#\u4F60\u89C9\u5F97\u81EA\u5DF1\u80FD\u627E\u5230\u6BD4\u8FD9\u66F4\u597D\u7684\u5417\uFF1F\u6211\u53EF\u4E0D\u6562\u80AF\u5B9A\uFF01$h",
    "Rainy_Day_3": "\u4ECA\u5929\u53EF\u80FD\u5F88\u9002\u5408\u53BB\u5C71\u6D1E\uFF0C\u5BF9\u5427\uFF1F\u4E0D\u8FC7\u8981\u5C0F\u5FC3\u554A\u3002#$e#\u5982\u679C\u4F60\u8981\u53BB\u7684\u8BDD\uFF0C\u8BB0\u5F97\u5E26\u4E0A\u51E0\u74F6\u751F\u547D\u836F\u6C34\u3002",
    "Rainy_Day_4": "\u6216\u8BB8\u4ECA\u5929\u6211\u4F1A\u73A9\u201C\u8349\u539F\u4E4B\u738B\u7684\u5192\u9669\u4E4B\u65C5\u201D\u2026\u2026\u6211\u53D1\u8A93\u603B\u6709\u4E00\u5929\u6211\u80FD\u81EA\u5DF1\u901A\u5173\u3002$h",
    "Rainy_Day_Abigail": "\u90CA\u5916\u7684\u666F\u8272\u5728\u8FD9\u79CD\u5929\u6C14\u4E0B\u5E94\u8BE5\u4F1A\u66F4\u6709\u8DA3\uFF0C\u4F60\u4E0D\u89C9\u5F97\u5417\uFF1F",
    "Rainy_Night_0": "\u6211\u53EA\u662F\u5728\u770B\u88AB\u96E8\u6DCB\u6E7F\u7684\u6728\u5934\u2026\u2026\u6211\u53D1\u8A93\u6211\u770B\u5230\u4EC0\u4E48\u9ED1\u6F06\u6F06\u7684\u4E1C\u897F\u5728\u6811\u5468\u56F4\u79FB\u52A8\u3002$6",
    "Rainy_Night_1": "\u4ECA\u665A\u5F88\u9002\u5408\u770B\u9B3C\u9B42\u2026\u2026",
    "Rainy_Night_2": "\u4F60\u80FD\u611F\u53D7\u5230\u5417\uFF1F\u96E8\u7684\u5B81\u9759\u2026\u2026",
    "Rainy_Night_3": "\u5728\u8FD9\u6837\u7684\u591C\u665A\u91CC\uFF0C\u6211\u559C\u6B22\u628A\u706F\u8C03\u6697\uFF0C\u9759\u9759\u8046\u542C\u2026\u2026$8",
    "Rainy_Night_4": "\u6211\u665A\u9910\u60F3\u505A\u6C64\u3002\u5E0C\u671B\u4E0D\u8981\u592A\u96BE\u559D\u2026\u2026[199 218 219 727 730]$h",
    "Rainy_Night_5": "\u563F\uFF01\u4F60\u770B\u8D77\u6765\u5E72\u6D3B\u513F\u5F88\u5356\u529B\u554A\u3002\u6211\u80FD\u5E2E\u4F60\u653E\u677E\u5417\uFF1F^\u4F60\u5E72\u6D3B\u513F\u4E00\u76F4\u5F88\u5356\u529B\u5417\uFF1F\u4F60\u7CBE\u75B2\u529B\u5C3D\u7684\u6837\u5B50\u771F\u53EF\u7231\u3002$h",
    "Rainy_Night_Abigail": "\u542C\u7740\u96E8\u58F0\u5F88\u5FEB\u5C31\u80FD\u5165\u7761\u4E86\u3002",
    "TwoKids_0": "\u6211\u5DF2\u7ECF\u7ED9%kid1\u548C%kid2\u5582\u8FC7\u5DE7\u514B\u529B\u9EA6\u7247\u4E86\u3002\u4ED6\u4EEC\u5728\u5C16\u53EB\uFF01",
    "TwoKids_2": "\u6211\u68A6\u5230%kid2\u5C06\u6210\u4E3A\u4E00\u540D\u8457\u540D\u7684\u602A\u7269\u730E\u4EBA\u3002\u6211\u5DF2\u7ECF\u5728\u8003\u8651\u505A\u4E00\u5957\u5C0F\u88C5\u5907\u4E86\u3002",
    "TwoKids_3": "\u4E00\u95F4\u9177\u9177\u7684\u8001\u623F\u5B50\uFF0C\u51E0\u4E2A\u5B69\u5B50\uFF0C\u8FD8\u6709\u7F8E\u597D\u7684\u519C\u573A\u3002\u4ECE\u6CA1\u6599\u5230\u6211\u4F1A\u8FC7\u4E0A\u4ECA\u5929\u8FD9\u6837\u7684\u751F\u6D3B\u2026\u2026\u4E0D\u8FC7\u5462\uFF01\u6211\u4EEC\u7684\u751F\u6D3B\u624D\u521A\u521A\u5F00\u59CB\u3002$h",
    "fall_1": "\u8FD9\u9999\u5473\u5F88\u660E\u663E\u2026\u2026\u8611\u83C7\u3001\u8150\u70C2\u7684\u6811\u53F6\u3001\u5357\u74DC\u3002\u79CB\u5929\u5230\u4E86\u3002\u5F88\u7F8E\u597D\u4E0D\u662F\u5417\uFF1F",
    "fall_2": "\u8FD9\u4E2A\u5B63\u8282\u6211\u4EEC\u53EF\u4EE5\u79CD\u5DE8\u578B\u5357\u74DC\u5417\uFF1F\u4EB2\u7231\u7684\uFF1F$h",
    "fall_20": "\u4EB2\u7231\u7684\u2026\u2026\u4F60\u5BF9\u6211\u6765\u8BF4\u6BD4\u6EE1\u7BB1\u7684\u6C34\u6676\u66F4\u73CD\u8D35\u3002#$e#\u90A3\uFF0C\u4E00\u7BB1\u7D2B\u6C34\u6676\u5462\uFF1F\u55EF\u2026\u2026\u8FD9\u4E2A\u6211\u5F97\u60F3\u60F3\u3002$h",
    "fall_6": "\u554A\u2026\u2026\u79CB\u5929\u554A\u3002\u8FD9\u53EF\u80FD\u662F\u4E00\u5E74\u91CC\u9762\u6211\u6700\u559C\u6B22\u7684\u65F6\u5149\u3002\u79CB\u5929\u7684\u989C\u8272\u771F\u7684\u5F88\u914D\u6211\u7684\u5934\u53D1\uFF0C\u4F60\u89C9\u5F97\u5462\uFF1F",
    "fall_Abigail": "\u6211\u662F\u5728\u4F60\u8EAB\u4E0A\u95FB\u5230\u5357\u74DC\u7684\u5473\u9053\u4E86\u5417\uFF1F\u53EF\u80FD\u6211\u662F\u5728\u505A\u68A6\u5427\u2026\u2026$h",
    "funLeave_Abigail": "\u544A\u8BC9\u4F60\u4E00\u58F0\uFF0C\u6211\u4ECA\u5929\u8981\u53BB\u5C0F\u9547\u3002\u6211\u5F97\u53BB\u6D3B\u52A8\u4E00\u4E0B\u7B4B\u9AA8\u3002",
    "funReturn_Abigail": "\u563F\uFF01\u4F60\u8FC7\u5F97\u597D\u5417\uFF1F\u6211\u8FC7\u5F97\u633A\u597D\u3002\u6563\u6563\u6B65\u8BA9\u4EBA\u7CBE\u795E\u6E05\u723D\u3002$h",
    "patio_Abigail": "%\u963F\u6BD4\u76D6\u5C14\u6B63\u6C89\u9189\u5728\u5979\u7684\u97F3\u4E50\u91CC\u3002",
    "spouseRoom_Abigail": "#$c .5#\u6211\u63D0\u524D\u8D77\u5E8A\u7ED9\u5C0F\u5927\u536B\u5582\u4E86\u5403\u7684\u3002\u4ECA\u65E9\u4ED6\u5F88\u6709\u6D3B\u529B\u3002#$e#\u6211\u5E0C\u671B\u4F60\u4E0D\u4F1A\u4ECB\u610F\u8C5A\u9F20\u7684\u5473\u9053\u3002",
    "spring_1": "\u8BDD\u8BF4\uFF0C\u4F60\u5BF9\u65B0\u7684\u4E00\u5E74\u6709\u4EC0\u4E48\u5927\u8BA1\u5212\u5417\uFF1F",
    "spring_12": "\u563F\uFF0C\u660E\u5929\u5C31\u662F\u590D\u6D3B\u8282\u4E86\u3002\u62B1\u6B49\uFF0C\u4F46\u6211\u4E0D\u4F1A\u56E0\u4E3A\u6211\u4EEC\u7ED3\u5A5A\u4E86\u800C\u624B\u4E0B\u7559\u60C5\u7684\uFF01$h#$e#\u6211\u8981\u6210\u4E3A\u5F69\u86CB\u5927\u5BFB\u5B9D\u7684\u8D62\u5BB6\u3002\u4F60\u5C3D\u7BA1\u8BD5\u7740\u6253\u8D25\u6211\u5427\u3002",
    "spring_2": "\u65B0\u5E74\u4F60\u6709\u4EC0\u4E48\u76EE\u6807\u5417\uFF1F\u6211\u6B63\u52AA\u529B\u5728\u534A\u5E74\u5185\u51CF\u8F7B\u4E00\u4E9B\u4F53\u91CD\u3002$h",
    "spring_Abigail": "\u867D\u7136\u6211\u4E5F\u559C\u6B22\u51B7\u70B9\u7684\u5B63\u8282\uFF0C\u4F46\u6700\u7EC8\u6211\u8FD8\u662F\u5F88\u559C\u6B22\u770B\u5230\u6625\u5929\u7684\u6765\u4E34\u3002",
    "summer_1": "\u6211\u5F88\u5BB9\u6613\u6652\u4F24\uFF0C\u6240\u4EE5\u5728\u6BCF\u5E74\u8FD9\u4E2A\u65F6\u5019\u6211\u90FD\u9700\u8981\u6CE8\u610F\u3002#$e#\u5E0C\u671B\u4F60\u559C\u6B22\u6211\u53D8\u767D\u7684\u6837\u5B50\u3002$h",
    "summer_15": "\u590F\u5929\u5230\u4E86\u2026\u2026\u4F30\u8BA1\u8981\u6EE1\u623F\u5B50\u82CD\u8747\u4E86\u3002#$e#\u522B\u62C5\u5FC3\uFF0C\u6211\u4F1A\u5904\u7406\u5B83\u4EEC\u7684\u3002\u8FD9\u5F88\u597D\u73A9\uFF01$h",
    "summer_4": "\u5343\u4E07\u522B\u4E2D\u6691\u554A\uFF0C\u4EB2\u7231\u7684\u3002#$e#\u8981\u591A\u559D\u6C34\uFF0C\u522B\u7D2F\u7740\u81EA\u5DF1\u3002",
    "summer_8": "\u6211\u5BF9\u8FD9\u5473\u9053\u611F\u5230\u62B1\u6B49\u2026\u2026\u4ECA\u665A\u70ED\u5F97\u6211\u5168\u8EAB\u5192\u6C57\u3002",
    "summer_Abigail": "\u54CE\u54DF\u2026\u2026\u6211\u771F\u60F3\u5403\u5DE7\u514B\u529B\u86CB\u7CD5\u3002",
    "winter_15": "\u51AC\u5929\u53BB\u8C37\u91CC\u63A2\u9669\u5F88\u6709\u8DA3\uFF01\u5728\u4E00\u5C42\u5927\u96EA\u7684\u63A9\u76D6\u4E0B\uFF0C\u4E00\u5207\u90FD\u5927\u4E0D\u76F8\u540C\u3002\u5E76\u4E14\u5F88\u5B89\u9759\u2026\u2026",
    "winter_3": "\u5B9E\u9645\u4E0A\u6211\u559C\u6B22\u51B7\u5929\u3002\u7ED9\u4E86\u6211\u4E00\u4E2A\u5B89\u9038\u7684\u7406\u7531\uFF01$h",
    "winter_Abigail": "\u8FD8\u8BB0\u5F97\u5F88\u4E45\u4EE5\u524D\u6211\u4EEC\u4E00\u8D77\u5728\u6211\u5C4B\u91CC\u73A9\u201C\u8349\u539F\u4E4B\u738B\u201D\u7684\u6E38\u620F\u5417\uFF1F\u90A3\u65F6\u771F\u662F\u5F00\u5FC3\u3002$h"
  }
}