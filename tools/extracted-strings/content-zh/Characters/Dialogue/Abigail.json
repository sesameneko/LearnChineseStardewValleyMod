    "AcceptGift_(O)279": "\u54C7\u2026\u2026@\uFF01\u4F60\u786E\u5B9A\u8981\u7ED9\u6211\u5417\uFF1F\u8FD9\u4E2A\u592A\u7A00\u6709\u4E86\uFF01#$b#\u6211\u627F\u8BA4\uFF0C\u6211\u5DF2\u7ECF\u5F00\u59CB\u998B\u4E86\u2026\u2026$h",
    "AcceptGift_(O)66": "$c 0.5#\u54C7\u2026\u2026\u6211\u6700\u559C\u6B22\u8FD9\u4E2A\u989C\u8272\u4E86\uFF01@\uFF0C\u8C22\u8C22\u4F60\uFF01$h#\u8C22\u8C22\u4F60\uFF01\u8FD9\u662F\u6211\u6700\u559C\u6B22\u7684\u77F3\u5934\uFF0C\u975E\u5E38\u597D\u770B\u3002",
    "AcceptGift_(O)Book_Void": "\u54C7\uFF0C\u8FD9\u672C\u4E66\u770B\u7740\u597D\u5413\u4EBA\u2026\u2026\u6211\u5F88\u559C\u6B22\uFF01#$b#\uFF08\u7FFB\u3001\u7FFB\u3001\u7FFB\uFF09\u2026\u2026\u54C7\u2026\u2026\u5168\u662F\u602A\u7269\u2026\u2026$h#$b#\u8FDB\u6D1E\u7A74\u63A2\u9669\u4E4B\u524D\u6211\u5F97\u597D\u597D\u7814\u7A76\u4E00\u4E0B\u2026\u2026\u8C22\u8C22\u4F60\uFF01",
