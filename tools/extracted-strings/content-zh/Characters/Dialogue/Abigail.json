    "Event_VideoGame_Yes": "\u975E\u5E38\u597D\uFF01\u6211\u6562\u8BF4\u4F60\u4E0D\u8D39\u5439\u7070\u4E4B\u529B\u5C31\u80FD\u95EF\u8FC7\u8FD9\u4E00\u5173\u3002$h",
    "FlowerDance_Accept": "\u6B38\uFF0C\u597D\u554A\u3002\u6211\u4EEC\u4E00\u8D77\u8DF3\u5427\uFF0C\u8FD9\u6837\u53EF\u4EE5\u4E00\u8D77\u5C34\u5C2C\u3002$h",
    "FlowerDance_Accept_Spouse": "\u4F46\u2026\u2026\u4F46\u662F\u2026\u2026\u6211\u7406\u60F3\u7684\u821E\u4F34\u662F\u2026\u2026$s#$b#\u5F00\u4E2A\u73A9\u7B11\u800C\u5DF2\uFF01\u6211\u7684\u821E\u4F34\u5F53\u7136\u662F\u4F60\u554A\uFF0C\u6211\u7231\u4F60\u3002$h",
    "FlowerDance_Decline": "\u771F\u662F\u53D7\u5BA0\u82E5\u60CA\u5462\u2026\u2026\u4F46\u6211\u8FD8\u662F\u5F97\u8BF4\u4E0D\u884C\u3002\u5BF9\u4E0D\u8D77\u4E86\u3002",
    "Fri": "\u54C7\u54E6\uFF0C\u6211\u624D\u60F3\u8D77\u6765\u4ECA\u5929\u662F\u5468\u4E94\u3002$u#$e#\u6709\u65F6\u5019\u6211\u771F\u662F\u8FC7\u7684\u7A00\u91CC\u7CCA\u6D82\u7684\u3002",
    "Fri2": "\u4ECA\u5929\u665A\u4E0A\u6211\u4EEC\u90FD\u8981\u53BB\u9152\u5427\u73A9\u3002\u8FD9\u5927\u6982\u7B97\u662F\u5468\u4E94\u7684\u4F20\u7EDF\u5427\u3002",
    "Fri6": "\u4ECA\u5929\u5C0F\u9E1F\u4EEC\u53EB\u5F97\u597D\u6B22\u554A\u3002\u5B83\u4EEC\u90A3\u4E48\u5355\u7EAF\uFF0C\u6839\u672C\u5C31\u4E0D\u62C5\u5FC3\u672A\u6765\u3002#$e#\u50CF\u5B83\u4EEC\u90A3\u6837\u4E5F\u633A\u597D\u7684\uFF0C\u5BF9\u4E0D\u5BF9\uFF1F",
    "GreenRain": "\u6211\u60F3\u53BB\u63A2\u9669\uFF0C\u4F46\u662F\u6211\u77E5\u9053\u6211\u5988\u6709\u70B9\u62C5\u5FC3\u3002\u6211\u4E0D\u60F3\u589E\u52A0\u5979\u7684\u8D1F\u62C5\u3002",
    "GreenRainFinished": "\u8F6C\u773C\u95F4\uFF0C\u4E00\u5207\u90FD\u6062\u590D\u6210\u5F80\u5E38\u4E00\u6837\uFF0C\u7B80\u76F4\u8DDF\u53D8\u9B54\u672F\u4E00\u6837\uFF01$h",
    "GreenRain_2": "\u4F60\u770B\u5230\u9547\u4E0A\u90A3\u4E9B\u79BB\u8C31\u7684\u6811\u4E86\u5417\uFF1F\u53D8\u5316\u771F\u7684\u597D\u5927\u2026\u2026\u6211\u611F\u89C9\u8FDB\u5165\u4E86\u7AE5\u8BDD\u4E16\u754C\u3002",
    "Introduction": "\u554A\uFF0C\u5BF9\u4E86\u2026\u2026\u6211\u542C\u8BF4\u6709\u4EBA\u642C\u5230\u90A3\u5EA7\u65E7\u519C\u573A\u3002#$e#\u8BF4\u6765\u8FD8\u633A\u9057\u61BE\u7684\u5462\uFF0C\u6211\u4E00\u76F4\u90FD\u5F88\u559C\u6B22\u4E00\u4E2A\u4EBA\u5728\u90A3\u7247\u6742\u8349\u4E1B\u751F\u7684\u519C\u7530\u91CC\u63A2\u9669\u3002$9",
    "Mon": "\u54E6\uFF0C\u563F\u3002\u4F60\u662F\u5728\u4F11\u606F\u5417\uFF1F",
    "Mon2": "\u554A\uFF0C\u55E8\uFF01#$e#\u4F60\u53BB\u8FC7\u5893\u56ED\u6CA1\uFF1F\u90A3\u91CC\u53EF\u662F\u4E2A\u72EC\u5904\u7684\u597D\u5730\u65B9\u5462\u3002",
    "Mon8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u6211\u8FD8\u8BB0\u5F97\u4E00\u5F00\u59CB\u4F60\u642C\u6765\u9547\u4E0A\u7684\u65F6\u5019\uFF0C\u6211\u60F3\u5230\u90A3\u7247\u6811\u6797\u8981\u53D8\u6210\u519C\u7530\u5C31\u6709\u70B9\u96BE\u8FC7\uFF0C\u4E0D\u8FC7\u73B0\u5728\u6211\u89C9\u5F97\u4F60\u642C\u6765\u8FD9\u91CC\u771F\u597D\uFF01$h|\u2026\u2026\u54CE\uFF0C@\uFF01$h#$e#\u8981\u73A9\u4E00\u4F1A\u513F\u5417\uFF1F\u6765\uFF01\u6211\u6765\u770B\u770B\u4F60\u7684\u624B\u76F8\uFF0C\u563B\u563B\u3002$h",
    "Resort": "\u5509\u2026\u2026\u5A01\u5229\u8BF4\u6211\u4EEC\u5FC5\u987B\u5F85\u5728\u6D77\u6EE9\u4E0A\u2026\u2026$s#$b#\u6211\u90FD\u628A\u6211\u7684\u5251\u548C\u5176\u4ED6\u4E1C\u897F\u5E26\u6765\u4E86\u2026\u2026$s",
    "Resort_Bar": "\u683C\u65AF\u7ED9\u6211\u505A\u4E86\u4E00\u676F\u6DF1\u7D2B\u8272\u7684\u63D0\u795E\u996E\u6599\uFF0C\u8DDF\u6211\u7684\u5934\u53D1\u989C\u8272\u4E00\u6837\uFF0C\u5473\u9053\u597D\u6781\u4E86\uFF01$h",
    "Resort_Entering": "\u6211\u5E0C\u671B\u6709\u7F8E\u4EBA\u9C7C\u80FD\u5149\u4E34\u6D77\u6EE9\uFF01",
    "Resort_Leaving": "\u6211\u5F97\u95EE\u95EE\u5A01\u5229\u6211\u4EEC\u80FD\u4E0D\u80FD\u8D70\u4E00\u6761\u98CE\u666F\u4F18\u7F8E\u7684\u8DEF\u7EBF\u56DE\u53BB\u3002",
    "Resort_Leaving_2": "\u4E5F\u8BB8\u6211\u4EEC\u56DE\u53BB\u7684\u8DEF\u4E0A\u4F1A\u770B\u5230\u6D77\u602A\u3002",
    "Resort_Shore": "\u6D77\u6EE9\u8FD8\u4E0D\u9519\uFF0C\u4F46\u5F88\u5FEB\u5C31\u73A9\u817B\u4E86\u3002\u6211\u66F4\u60F3\u53BB\u770B\u770B\u90A3\u7247\u9ED1\u6697\u7684\u4E1B\u6797\uFF0C\u8FD8\u6709\u706B\u5C71\uFF01",
    "Resort_Shore_2": "\u5514\uFF0C\u4F60\u89C9\u5F97\u6211\u80FD\u5077\u5077\u628A\u6211\u7684\u8C5A\u9F20\u5E26\u5230\u5C9B\u4E0A\u6765\u5417\uFF1F#$e#\u554A\u4E0D\u884C\uFF0C\u5927\u536B\u5E94\u8BE5\u4E0D\u592A\u4F1A\u6E38\u6CF3\u3002$h",
    "Resort_Umbrella": "\u6211\u7684\u76AE\u80A4\u5F88\u5BB9\u6613\u6652\u4F24\uFF0C\u6240\u4EE5\u6211\u5F97\u5728\u4F1E\u4E0B\u5F85\u4E00\u4F1A\u513F\u3002#$e#\u6211\u559C\u6B22\u9634\u51C9\u5904\uFF0C\u88AB\u5927\u592A\u9633\u6652\u7740\u4F1A\u8BA9\u6211\u5934\u660F\u8111\u6DA8\u3002",
    "Resort_Umbrella_2": "\u563F\uFF0C@\uFF0C\u60F3\u4E0D\u60F3\u548C\u6211\u4E00\u8D77\u505A\u4E2A\u6C99\u5821\uFF1F#$e#\u8981\u662F\u5EFA\u4E2A\u6C99\u5821\u5730\u7262\u5C31\u66F4\u9177\u4E86\uFF01$h",
    "Resort_Umbrella_3": "\u563F\uFF0C@\uFF0C\u4F60\u89C9\u5F97\u4F60\u80FD\u505A\u4E2A\u6728\u7B4F\u51FA\u6765\u5417\uFF1F#$e#\u6211\u5728\u6765\u7684\u8DEF\u4E0A\u770B\u5230\u4E86\u51E0\u4E2A\u5F88\u9177\u7684\u5C9B\u5C7F\uFF0C\u6211\u60F3\u53BB\u770B\u770B\u3002",
