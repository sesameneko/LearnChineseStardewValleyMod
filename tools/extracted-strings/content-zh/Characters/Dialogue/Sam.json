    "10": "\u4F60\u770B\u4E86\u6628\u665A\u7684\u6BD4\u8D5B\u5417\uFF1F#$b#\u7B49\u7B49\uFF0C\u4F60\u6709\u7535\u89C6\u673A\u5417\u2026\u2026\uFF1F",
    "14": "\u5443\uFF0C\u6211\u521A\u624D\u8E29\u5230\u4E00\u5768\u4E0D\u77E5\u4EC0\u4E48\u4E1C\u897F\u2026\u2026\u8FD9\u53CC\u978B\u53EF\u662F\u6211\u521A\u4E70\u7684\u554A\u3002$s",
    "AcceptBirthdayGift_Negative": "\u54E6\u54E6\u54E6\u54E6\uFF01\u4F60\u8FD8\u8BB0\u2014\u2014$h#$b#\u2026\u2026\uFF08\u95FB\u4E86\u4E24\u4E0B\uFF09\u2026\u2026\u8FD9\u662F\u4EC0\u4E48\u602A\u5473\u2026\u2026\uFF1F$8#$b#\u2026\u2026\u554A\u3002$5",
    "AcceptBirthdayGift_Positive": "\u54E6\u54E6\u54E6\u54E6\uFF01\u4F60\u8FD8\u8BB0\u5F97\u554A\uFF01\u8FD9\u5C31\u5BF9\u4E86\u561B\uFF01$h",
    "AcceptGift_(O)206": "\u554A\u54C8\u2026\u2026\u8BE5\u5403\u62AB\u8428\u4E86\uFF01$h",
    "AcceptGift_(O)StardropTea": "\u54C7\u2026\u2026\u7B49\u7B49\u2026\u2026\u8FD9\u662F\u7ED9\u6211\u7684\uFF1F\u592A\u60CA\u559C\u4E86\uFF01\u8C22\u8C22\u4F60\uFF01",
    "Event_band1": "\u563F\uFF0C\u4F60\u77E5\u9053\u5417\uFF1F\u8FD9\u6070\u6070\u662F\u6211\u89C9\u5F97\u4E50\u961F\u8BE5\u8D70\u7684\u98CE\u683C\u3002",
    "Event_band2": "\u563F\uFF0C\u4F60\u77E5\u9053\u5417\uFF1F\u8FD9\u6070\u6070\u662F\u6211\u89C9\u5F97\u4E50\u961F\u8BE5\u8D70\u7684\u98CE\u683C\u3002",
    "Event_band3": "\u563F\uFF0C\u4F60\u77E5\u9053\u5417\uFF1F\u8FD9\u6070\u6070\u662F\u6211\u89C9\u5F97\u4E50\u961F\u8BE5\u8D70\u7684\u98CE\u683C\u3002",
    "Event_band4": "\u563F\uFF0C\u4F60\u77E5\u9053\u5417\uFF1F\u8FD9\u6070\u6070\u662F\u6211\u89C9\u5F97\u4E50\u961F\u8BE5\u8D70\u7684\u98CE\u683C\u3002",
    "FlowerDance_Accept": "\u554A\u2026\u2026\u8DDF\u6211\u5417\uFF1F\u563F\u563F\u2026\u2026\u597D\u554A\u3002\u611F\u89C9\u4F1A\u5F88\u6709\u8DA3\uFF01$10",
    "FlowerDance_Accept_Spouse": "\u54E6\uFF0C\u6211\u53C8\u5F97\u7A7F\u4E0A\u90A3\u4EF6\u50BB\u4E4E\u4E4E\u7684\u897F\u88C5\u5417\uFF1F\u6211\u60F3\u65E2\u7136\u6211\u4EEC\u5DF2\u7ECF\u7ED3\u5A5A\u4E86\u2026\u2026\u5514\uFF0C\u90A3\u597D\u5427\u3002$s",
    "FlowerDance_Decline": "\u55EF\u2026\u2026\u6211\u4E0D\u77E5\u9053\u3002\u4E0D\u5982\u660E\u5E74\u5427\u3002$s",
    "Fri": "\u6211\u6709\u544A\u8BC9\u8FC7\u4F60\u6211\u4EEC\u4E00\u5BB6\u4EBA\u66FE\u7ECF\u662F\u4F4F\u5728\u57CE\u91CC\u7684\u5417\uFF1F#$e#\u90A3\u91CC\u6709\u8DA3\u591A\u4E86\uFF0C\u4F46\u662F\u5374\u5F88\u5435\u5F88\u5FD9\u788C\u2026\u2026\u5F88\u96BE\u8BF4\u54EA\u79CD\u751F\u6D3B\u6BD4\u8F83\u597D\u3002",
    "Fri10": "\u4EBA\u8D8A\u8001\u554A\uFF0C\u5C31\u8D8A\u7559\u604B\u8FD9\u5C71\u8C37\u3002#$b#\u4E5F\u8BB8\u6211\u662F\u56E0\u4E3A\u67D0\u79CD\u539F\u56E0\u2026\u2026\u800C\u6709\u8FD9\u6837\u7684\u60F3\u6CD5\u5427\u3002$10#$e#\u8BDD\u8BF4\uFF0C\u4F60\u4ECA\u5929\u5DE5\u4F5C\u987A\u5229\u5417\uFF1F$h",
    "Fri4": "\u7236\u4EB2\u66FE\u5728\u57CE\u91CC\u5F53\u8FC7\u6E05\u9053\u592B\u3002#$e#\u4F60\u65E0\u6CD5\u60F3\u8C61\u4ED6\u5728\u522B\u4EBA\u7684\u5783\u573E\u4E2D\u53D1\u73B0\u8FC7\u4EC0\u4E48\u4E1C\u897F\u3002",
    "GreenRain": "\u54CE\u5440\uFF01\u4E0B\u9178\u96E8\u4E86\u5417\uFF1F\u4F1A\u4E0D\u4F1A\u628A\u5C4B\u9876\u8150\u8680\u7A7F\u4E86\uFF0C\u7136\u540E\u6D3B\u6D3B\u70E7\u6B7B\u6211\u4EEC\uFF1F$8#$b#\u6211\u5F97\u4FDD\u62A4\u597D\u6211\u5F1F\u5F1F\uFF01$7",
    "GreenRainFinished": "\u597D\u50CF\u5168\u90FD\u5B8C\u597D\u65E0\u635F\u2026\u2026\u8FD9\u573A\u96E8\u597D\u5947\u602A\u3002\u4F60\u6CA1\u4E8B\u5427\uFF1F",
    "GreenRain_2": "\u4F60\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u8FD9\u573A\u96E8\u633A\u6696\u548C\u7684\uFF0C\u4F3C\u4E4E\u6709\u79CD\u751F\u673A\u2026\u2026",
    "Introduction": "\u563F\uFF0C\u6211\u53EB\u5C71\u59C6\u3002\u5F88\u9AD8\u5174\u8BA4\u8BC6\u4F60\u3002$h",
    "Mon": "\u563F\uFF0C\u519C\u592B\u3002",
    "Mon2": "\u563F\uFF0C\u4F60\u600E\u4E48\u6837\u4E86\uFF1F#$e#\u6628\u665A\u6211\u8FDE\u7EED\u7EC3\u4E60\u4E86 4 \u4E2A\u5C0F\u65F6\u7684\u5409\u4ED6\uFF0C\u624B\u6307\u90FD\u75DB\u6B7B\u4E86\u3002$s#$e#\u518D\u89C1\uFF0C\u6211\u8FD8\u6709\u4E8B\u8981\u5FD9\u2026\u2026",
    "Mon8": "\u544A\u8BC9\u4F60\u4E00\u4E2A\u79D8\u5BC6\u2026\u2026\u6211\u7684\u540D\u5B57\u201C\u5C71\u59C6\u201D\u5176\u5B9E\u662F\u201C\u5C71\u59C6\u68EE\u201D\u7684\u7F29\u5199\u3002$10#$e#\u5F88\u591A\u4EBA\u90FD\u4E0D\u77E5\u9053\uFF0C\u4F60\u4E5F\u522B\u544A\u8BC9\u522B\u4EBA\u3002",
    "Resort": "\u5C9B\u5C7F\u7684\u6DF1\u5904\u80AF\u5B9A\u8FD8\u6709\u4E9B\u6709\u8DA3\u7684\u4E1C\u897F\u3002#$e#\u4F46\u662F\uFF0C\u5A01\u5229\u8BA9\u6211\u4EEC\u5FC5\u987B\u5F85\u5728\u8FD9\u91CC\u2026\u2026\u5927\u6982\u662F\u51FA\u4E8E\u5B89\u5168\u8D23\u4EFB\u7684\u8003\u8651\u5427\u3002$s",
    "Resort_Bar": "\u6211\u6765\u559D\u4E00\u676F\u63D0\u63D0\u795E\uFF0C\u7B49\u4F1A\u5C31\u56DE\u6D77\u6EE9\u3002",
    "Resort_Entering": "\u54C7\uFF0C\u771F\u662F\u4E2A\u597D\u5730\u65B9\uFF01",
    "Resort_Leaving": "\u6652\u4E86\u8FD9\u4E48\u591A\u592A\u9633\uFF0C\u6211\u611F\u89C9\u633A\u4E0D\u9519\u7684\u3002$h",
    "Resort_Shore": "\u8FD9\u6D77\u6D6A\u597D\u5927\u2026\u2026\u4F60\u731C\u600E\u4E48\u7740\uFF1F\u6211\u8981\u6512\u94B1\u4E70\u4E2A\u51B2\u6D6A\u677F\u4E86\u3002",
    "Resort_Towel": "%\u5C71\u59C6\u7528\u5409\u4ED6\u5F39\u594F\u7740\u7235\u58EB\u4E50\u3002",
    "Resort_Towel_2": "\u6211\u662F\u4E0D\u662F\u8BE5\u5B66\u4E00\u4E0B\u5C24\u514B\u91CC\u91CC\u2026\u2026#$e#\u963F\u6BD4\u5728\u6253\u5EB7\u8304\u9F13\uFF0C\u585E\u5DF4\u65AF\u8482\u5B89\u5728\u6253\u94A2\u9F13\u2026\u2026\u201C\u5929\u5802\u7684\u9E48\u9E55\u201D\u2026\u2026$s#$e#\u600E\u4E48\u4E86\uFF0C\u4F60\u770B\u4E0A\u53BB\u5FE7\u5FC3\u5FE1\u5FE1\u7684\u3002$h",
    "Sat": "\u55EF\u3002\u6211\u624D\u60F3\u8D77\u6211\u597D\u50CF\u9700\u8981\u505A\u67D0\u4EF6\u4E8B\u2026\u2026\u4F46\u53C8\u4E0D\u8BB0\u5F97\u662F\u4EC0\u4E48\u4E8B\u4E86\u3002#$e#\u5509\uFF0C\u6211\u603B\u662F\u90A3\u4E48\u5584\u5FD8\u3002",
    "Sat4": "\u5662\uFF01\u6211\u521A\u60F3\u8D77\u6211\u5F97\u6253\u7535\u8BDD\u7ED9\u6211\u7684\u7956\u6BCD\u3002\u6211\u5148\u628A\u8FD9\u6761\u6A61\u80F6\u5708\u7ED1\u5728\u624B\u8155\u4E0A\u63D0\u9192\u81EA\u5DF1\u3002#$e#\u6211\u5FC5\u987B\u5E38\u5E38\u7ED9\u81EA\u5DF1\u505A\u5C0F\u63D0\u793A\uFF0C\u5426\u5219\u5C31\u4F1A\u5FD8\u8BB0\u5F97\u4E00\u5E72\u4E8C\u51C0\u3002$h",
    "Sun": "\u54E6\uFF0C\u771F\u662F\u98CE\u548C\u65E5\u4E3D\u7684\u4E00\u5929\u2026\u2026\u4E0D\u662F\u5417\uFF1F",
    "Sun8": "\u6709\u65F6\u5019\u6211\u4E0D\u7981\u5728\u60F3\uFF0C\u6BCD\u4EB2\u8FD9\u8F88\u5B50\u771F\u7684\u5E78\u798F\u5417\u2026\u2026$s#$e#\u6211\u66FE\u7ECF\u95EE\u8FC7\u5979\u4E00\u6B21\uFF0C\u611F\u89C9\u5979\u5728\u9690\u7792\u7740\u4E00\u4E9B\u5185\u5FC3\u7684\u75DB\u82E6\u3002",
    "Thu": "\u6BCF\u5E74\u8FD9\u4E2A\u65F6\u5019\uFF0C\u4E91\u5F69\u90FD\u4F1A\u5F88\u597D\u770B\uFF0C\u4E0D\u662F\u5417\uFF1F#$e#\u5C31\u50CF\u9999\u8349\u5473\u96EA\u7CD5\u6F02\u6D6E\u5728\u84DD\u8393\u9171\u4E0A\u2026\u2026\u6216\u8BB8\u53EA\u662F\u6211\u997F\u4E86\u3002",
    "Thu2": "\u6211\u7236\u4EB2\u662F\u4F4D\u58EB\u5175\uFF0C\u6B63\u5728\u62B5\u6297\u6208\u7279\u6D1B\u56FD\u3002\u6240\u4EE5\u4ED6\u4EBA\u4E0D\u5728\u8FD9\u91CC\u2026\u2026#$e#\u603B\u6709\u4E00\u5929\u4ED6\u4F1A\u56DE\u6765\u7684\u3002#$e#\u2026\u2026\u6211\u542C\u8BF4\u8FC7\u6208\u7279\u6D1B\u56FD\u7684\u5F88\u591A\u53EF\u6015\u4F20\u8A00\u2026\u2026$s",
    "Thu2_2": "\u6211\u7236\u4EB2\u56DE\u6765\u4E86\u3002\u4F60\u89C1\u5230\u4ED6\u4E86\u5417\uFF1F#$b#\u5F88\u9AD8\u5174\u4ED6\u5E73\u5B89\u5F52\u6765\u3002",
    "Thu6_1": "\u6211\u89C9\u5F97\u6211\u7236\u4EB2\u5927\u6982\u4F1A\u5728\u4E00\u5E74\u5185\u56DE\u6765\u3002#$e#\u5982\u679C\u4F60\u90A3\u65F6\u8FD8\u4F4F\u5728\u8FD9\u91CC\u7684\u8BDD\uFF0C\u4F60\u5C31\u80FD\u89C1\u5230\u4ED6\u4E86\u3002#$e#\u4F60\u4E0B\u4E86\u90A3\u4E48\u591A\u529F\u592B\u5728\u4F60\u7684\u519C\u573A\u4E0A\uFF0C\u5E94\u8BE5\u4E0D\u4F1A\u629B\u5F03\u5B83\u7684\u5427\uFF01",
    "Thu6_2": "\u2026\u2026\u6211\u5BF9\u6211\u7236\u4EB2\u7684\u5F52\u6765\u6709\u70B9\u5FD0\u5FD1\u4E0D\u5B89\u3002\u611F\u89C9\u4ED6\u53D8\u5F97\u5F88\u5947\u602A\u3002$s#$b#\u4E0D\u8FC7\u6211\u4E5F 3 \u5E74\u6CA1\u89C1\u4ED6\u4E86\u2026\u2026\u4E5F\u8BB8\u662F\u751F\u758F\u4E86\u5427\u3002",
    "Thu_2": "\u6211\u7236\u4EB2\u56DE\u6765\u4E86\u3002\u4F60\u89C1\u5230\u4ED6\u4E86\u5417\uFF1F#$b#\u5F88\u9AD8\u5174\u4ED6\u5E73\u5B89\u5F52\u6765\u3002",
    "Thu_3": "*\u5509*\u2026\u2026\u6211\u8FD8\u5728\u8FD9\u91CC\u505A\u4EC0\u4E48\uFF1F",
    "Tue": "\u554A\uFF0C\u4F60\u597D\uFF01\u5F88\u9AD8\u5174\u518D\u6B21\u89C1\u9762\u3002#$e#\u4E0D\u8981\u90A3\u4E48\u7D27\u5F20\u561B\uFF01",
    "Tue4": "\u55E8\uFF0C@\u3002\u4F60\u60F3\u51FA\u53BB\u8D70\u8D70\u5417\uFF1F#$e#\u7761\u61D2\u89C9\u662F\u5F88\u723D\uFF0C\u4F46\u6709\u65F6\u5019\u6211\u771F\u4E0D\u60F3\u7761\u2026\u2026\u56E0\u4E3A\u592A\u6D6A\u8D39\u65F6\u95F4\u4E86\u3002",
    "Wed": "\u6211\u6B63\u5728\u4E3A\u6211\u7684\u4E50\u961F\u521B\u4F5C\u65B0\u66F2\uFF0C\u4F46\u662F\u6211\u5B8C\u5168\u6CA1\u6709\u7075\u611F\u2026\u2026#$q 19/20 Wed_old#\u563F\u2026\u2026\u4F60\u89C9\u5F97\u6211\u7684\u65B0\u6B4C\u8BE5\u662F\u4EC0\u4E48\u4E3B\u9898\u7684\uFF1F#$r 20 30 Wed_20#\u8015\u79CD\u3001\u6316\u77FF\u548C\u780D\u67F4\u3002#$r 8820 30 Wed_20#\u6D77\u4E2D\u4E4B\u57CE\u3002#$r 8821 30 Wed_20#\u706B\u8F66\u3002#$r 19 -50 Wed_19#\u968F\u4FBF\u5427\u3002\u53CD\u6B63\u90FD\u662F\u96BE\u542C\u6B7B\u7684\u3002",
    "Wed10": "\u563F\u5144\u5F1F\u3002\u4F60\u4ECA\u5929\u597D\u50CF\u671D\u6C14\u52C3\u52C3\u7684\u6837\u5B50\uFF01^@\u3002\u5443\u2026\u2026\u6211\u53EA\u662F\u60F3\u8BF4\u2026\u2026\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5F88\u597D\u770B\u3002$10",
    "Wed6": "\u6211\u8DDF\u585E\u5DF4\u65AF\u8482\u5B89\u8BA4\u8BC6\u5F88\u4E45\u4E86\u3002\u4ED6\u662F\u4E2A\u633A\u6709\u8DA3\u7684\u5BB6\u4F19\u3002#$e#\u9664\u4E86\u4F60\u4EEC\u4FE9\u4EBA\uFF0C\u6211\u5728\u8FD9\u91CC\u90FD\u6CA1\u6709\u5176\u4ED6\u7684\u670B\u53CB\u4E86\u3002",
    "Wed_19": "\u6211\u8BF4\u5144\u5F1F\u2026\u2026\u4F60\u6709\u75C5\u554A\uFF1F\u7B97\u4E86\u5F53\u6211\u6CA1\u95EE\u3002$a",
    "Wed_20": "\u662F\u5417\uFF1F\u4F60\u8FD9\u4E2A\u4E3B\u610F\u5F88\u4E0D\u9519\u54E6\u3002\u8C22\u8C22\uFF01$h",
    "Wed_old": "$p 19#\u4F46\u6211\u5DF2\u7ECF\u77E5\u9053\u4F60\u7684\u60F3\u6CD5\u4E86\u3002$a|\u8C22\u8C22\u4F60\u7684\u5E2E\u5FD9\uFF0C\u6211\u5DF2\u7ECF\u60F3\u5230\u6B4C\u8BCD\u4E86\uFF01$h",
    "breakUp": "\u7B49\u7B49\u2026\u2026\u4EC0\u4E48\uFF1F$8#$b#\u6211\u8FD8\u4EE5\u4E3A\u6211\u4EEC\u76F8\u5904\u5F97\u4E0D\u9519\u2026\u2026\u53EF\u80FD\u662F\u6211\u5B8C\u5168\u641E\u9519\u4E86\u5427\u2026\u2026\u90A3\u2026\u2026\u884C\u5427\u3002$9#$b#\u55EF\uFF0C\u597D\u7684\u2026\u2026\u6211\u4EEC\u8FD8\u80FD\u5F53\u670B\u53CB\u3002$9",
    "dating_Sam": "\u5514\u2026\u2026\u73B0\u5728\u53EF\u4EE5\u4EB2\u4E00\u4E0B\u4E86\u5417\uFF1F$l",
