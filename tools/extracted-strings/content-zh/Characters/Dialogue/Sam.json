    "summer_Wed2": "\u6628\u665A\u6211\u770B\u89C1\u5929\u82B1\u677F\u4E0A\u6709\u53EA\u8718\u86DB\u3002\u5B83\u4EEC\u662F\u559C\u70ED\u7684\u751F\u7269\u3002#$e#\u5E0C\u671B\u5B83\u6CA1\u6709\u8D81\u6211\u7761\u7740\u65F6\u722C\u8FDB\u6211\u7684\u5634\u5DF4\u3002$s",
    "winter_24": "\u51AC\u65E5\u661F\u76DB\u5BB4\u7684\u521D\u8877\u662F\u63D0\u9192\u5927\u5BB6\u8981\u5BF9\u4E16\u95F4\u4E07\u7269\u62B1\u6709\u611F\u6069\u4E4B\u5FC3\u3002#$b#\u6211\uFF1F\u6211\u53EA\u5BF9\u7F8E\u98DF\u6709\u5174\u8DA3\u3002\u5475\u5475\u3002$h",
    "winter_7": "\u6709\u4E00\u6B21\u5728\u51B0\u8282\u65F6\uFF0C\u683C\u65AF\u6389\u8FDB\u4E86\u6CB3\u91CC\u3002\u6211\u4EEC\u5728\u9152\u5427\u5F04\u4E86\u4E00\u4E2A\u5DE8\u5927\u7684\u7BDD\u706B\u624D\u70D8\u5E72\u4E86\u4ED6\u3002#$e#\u5F53\u65F6\u5927\u5BB6\u90FD\u5F88\u62C5\u5FC3\u518D\u4E5F\u5C1D\u4E0D\u5230\u4ED6\u7684\u7F8E\u5473\u610F\u5927\u5229\u9762\u4E86\u3002",
    "winter_Fri": "\u51AC\u5929\u6700\u7CDF\u7CD5\u7684\u4E8B\u60C5\u83AB\u8FC7\u4E8E\u53CC\u811A\u5728\u96EA\u4E2D\u6E7F\u900F\u3002\u4F60\u5F88\u5E78\u8FD0\u7A7F\u7740\u4E00\u53CC\u539A\u539A\u7684\u9774\u5B50\u3002",
    "winter_Mon": "\u4F60\u597D\u2026\u2026\u5F88\u51B7\uFF0C\u4E0D\u662F\u5417\uFF1F",
    "winter_Mon2": "\u51AC\u5929\u65F6\u5927\u5BB6\u90FD\u5F85\u5728\u5C4B\u91CC\uFF0C\u6240\u4EE5\u6211\u53EF\u4EE5\u5F88\u5927\u58F0\u5730\u5F39\u5409\u4ED6\u3002$h",
    "winter_Sat4": "\u6211\u521A\u60F3\u8D77\u9700\u8981\u4E3A\u5409\u4ED6\u66F4\u6362\u5409\u4ED6\u5F26\u3002#$b#\u597D\uFF0C\u6211\u5F97\u5728\u6211\u7684\u624B\u8155\u4E0A\u8BB0\u4E0B\u4ECA\u665A\u8981\u505A\u7684\u4E8B\u3002#$e#\u6211\u5FC5\u987B\u5E38\u5E38\u7ED9\u81EA\u5DF1\u505A\u5C0F\u63D0\u793A\uFF0C\u5426\u5219\u5C31\u4F1A\u5FD8\u8BB0\u5F97\u4E00\u5E72\u4E8C\u51C0\u3002$h",
    "winter_Sun": "\u5C3D\u91CF\u522B\u628A\u5BB6\u91CC\u5F04\u4E71\uFF0C\u5426\u5219\u6BCD\u4EB2\u5C31\u8981\u53D1\u706B\u4E86\u3002",
    "winter_Sun8": "\u8981\u662F\u80FD\u53BB\u73A9\u96EA\u64AC\u5C31\u597D\u4E86\uFF0C\u4F60\u8BF4\u5462\uFF1F#$e#\u4E0D\u8FC7\u9644\u8FD1\u6CA1\u6709\u9002\u5408\u7684\u5C71\u4E18\u3002$s#$e#\u800C\u4E14\u6211\u4E5F\u6CA1\u6709\u96EA\u64AC\u3002#$e#\u8BDD\u8BF4\uFF0C\u4F60\u6700\u8FD1\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F",
    "winter_Thu": "\u6211\u7236\u4EB2\u662F\u519B\u4EBA\uFF0C\u5728\u8DDF\u6208\u7279\u6D1B\u6253\u4ED7\u3002\u6240\u4EE5\u4ED6\u4EBA\u4E0D\u5728\u8FD9\u91CC\u3002#$e#\u4E0D\u8FC7\u4ED6\u5F88\u5FEB\u4F1A\u56DE\u6765\u3002",
    "winter_Thu6": "\u7236\u4EB2\u56DE\u6765\u4E00\u9635\u5B50\u4E86\u3002\u6211\u7EC8\u4E8E\u5F00\u59CB\u4E60\u60EF\u4E86\u4E0B\u6765\u3002",
    "winter_Thu6_1": "\u6211\u7236\u4EB2\u5E94\u8BE5\u4F1A\u5728\u4E0B\u4E2A\u6625\u5929\u56DE\u6765\u3002#$e#\u5DF2\u7ECF 3 \u5E74\u6CA1\u89C1\u5230\u4ED6\u4E86\u3002\u89C1\u9762\u65F6\u4F1A\u5F88\u5947\u602A\u5427\u3002",
    "winter_Thu_2": "\u51AC\u5929\u8981\u8BF4\u6709\u54EA\u4E00\u70B9\u597D\u2026\u2026\u83AB\u8FC7\u4E8E\u5168\u90E8\u868A\u5B50\u90FD\u6D88\u5931\u4E86\u3002",
    "winter_Tue": "\u554A\uFF0C\u4F60\u597D\uFF01\u5F88\u9AD8\u5174\u518D\u6B21\u89C1\u9762\u3002#$e#\u4E0D\u8981\u90A3\u4E48\u7D27\u5F20\u561B\uFF01",
    "winter_Tue4": "\u55E8\uFF0C@\u3002\u4F60\u60F3\u51FA\u53BB\u8D70\u8D70\u5417\uFF1F#$e#\u4E0D\u8FC7\uFF0C\u6BCF\u5E74\u8FD9\u4E2A\u65F6\u5019\u90FD\u6700\u9002\u5408\u8865\u89C9\u4E86\u3002$h",
    "winter_Wed": "$d Joja#\u6211\u5F88\u8BA8\u538C\u5728 Joja \u8D85\u5E02\u5DE5\u4F5C\uFF0C\u4F46\u4E0D\u5F97\u4E0D\u4E3A\u4E94\u6597\u7C73\u6298\u8170\u554A\u3002|\u6211\u5F88\u9AD8\u5174\u5728\u535A\u7269\u9986\u5DE5\u4F5C\u3002\u81F3\u5C11\u6BD4\u6C89\u95F7\u7684 Joja \u8D85\u5E02\u6709\u8DA3\u591A\u4E86\u3002"
  }
}