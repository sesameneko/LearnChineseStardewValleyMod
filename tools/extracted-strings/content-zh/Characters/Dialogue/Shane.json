    "breakUp": "\uFF08\u54BD\u53E3\u6C34\uFF09\u54E6\u2026\u2026\u55EF\uFF0C\u597D\u5427\u2026\u2026\u6211\u65E9\u8BE5\u77E5\u9053\u4F1A\u53D8\u6210\u8FD9\u6837\u7684\u3002$s#$b#\u6211\u2026\u2026\u5443\u2026\u2026\u90A3\u5C31\u9910\u5427\u89C1\u3002",
