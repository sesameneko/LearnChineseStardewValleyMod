    "AcceptGift_(O)StardropTea": "\u5514\u2026\u2026\uFF08\u559D\u4E86\u4E00\u53E3\uFF09\u2026\u2026\u554A\u2026\u2026\u8FD9\u662F\u6211\u5988\u5988\u505A\u7684\u91D1\u67AA\u9C7C\u7802\u9505\u7684\u5473\u9053\uFF01\u597D\u559D\uFF01",
    "Fri": "\u6240\u4EE5\u4F60\u662F\u4F4D\u519C\u6C11\uFF0C\u662F\u5427\uFF1F\u81F3\u5C11\u662F\u4E2A\u672C\u5206\u7684\u5DE5\u4F5C\u3002",
    "Fri10": "\u6211\u4EE5\u524D\u662F\u4E2A\u813E\u6C14\u66B4\u8E81\u7684\u8001\u5934\u5B50\u3002\u4F46\u662F\u73B0\u5728\u6211\u7684\u813E\u6C14\u53D8\u5F97\u5F88\u597D\u4E86\u3002\u5475\u5475\uFF01$h#$e#\u4FDD\u91CD\u5427\uFF0C\u5C0F\u5B50\u3002^\u4FDD\u91CD\u5427\uFF0C\u4EB2\u7231\u7684\u3002",
    "Fri4": "\u6211\u7684\u7237\u7237\u4E5F\u662F\u519C\u592B\u3002\u8FD9\u662F\u4E2A\u4EE4\u4EBA\u5C0A\u656C\u7684\u804C\u4E1A\u3002#$e#\u5982\u679C\u6211\u5E74\u8F7B\u4E00\u70B9\u6211\u5C31\u53BB\u4F60\u7684\u519C\u573A\u6307\u70B9\u4F60\u51E0\u62DB\u4E86\u3002",
    "Fri8": "\u6211\u4E00\u76F4\u5728\u60F3\u2026\u2026\u662F\u4E0D\u662F\u6211\u6709\u70B9\u592A\u7231\u53D1\u7262\u9A9A\u4E86\u3002$s#$e#\u6211\u4EE5\u4E3A\u6CA1\u4EBA\u4F1A\u5728\u4E4E\u6211\u4EEC\u8FD9\u4E9B\u8001\u5BB6\u4F19\u3002",
    "GreenRain": "\u4EB2\u7231\u7684\uFF0C\u6CA1\u4E8B\u7684\uFF0C\u6CA1\u4E8B\u7684\u2026\u2026\u522B\u64CD\u5FC3\u4E86\u3002%noturn#$b#\u5373\u4F7F\u6709\u6BD2\uFF0C\u6211\u5F53\u521D\u5728\u7164\u77FF\u91CC\u5F85\u4E00\u5206\u949F\uFF0C\u5438\u5230\u7684\u6BD2\u6C14\u90FD\u6BD4\u8FD9\u591A\u2026\u2026\u6211\u4E0D\u8FD8\u662F\u6D3B\u5F97\u597D\u597D\u7684\uFF01",
    "GreenRain_2": "\u8FD9\u573A\u96E8\u4E0B\u5B8C\u5C31\u8981\u9664\u8349\uFF0C\u5E74\u8F7B\u4EBA\u6709\u5F97\u597D\u5FD9\u4E86\u2026\u2026\u563F\u563F\u2026\u2026$h",
    "Introduction": "\u54FC\u2026\u2026\u8981\u8DDF\u8FD9\u4E9B\u65B0\u9762\u5B54\u6253\u4EA4\u9053\u8FD8\u771F\u662F\u4E0D\u723D\u554A\u3002#$b#\u5BF9\u4E86\uFF0C\u6211\u53EB\u4E54\u6CBB\u3002\u8D76\u7D27\u7ED9\u6211\u6D88\u5931\u2026\u2026\u54FC\u3002",
    "Mon": "\u6211\u4E0D\u662F\u5F88\u7231\u8BF4\u8BDD\u3002\u5C24\u5176\u4E0D\u559C\u6B22\u8DDF\u964C\u751F\u4EBA\u8BF4\u8BDD\u3002\u8BF7\u522B\u4ECB\u610F\u3002",
    "Mon6": "\u6211\u5F88\u60CA\u8BB6\u4F60\u613F\u610F\u548C\u50CF\u6211\u4E00\u6837\u7684\u8001\u524D\u8F88\u505A\u670B\u53CB\u3002",
    "MovieInvitation": "\u4F60\u60F3\u8DDF\u6211\u8FD9\u6837\u7684\u8001\u5934\u53BB\u770B\u7535\u5F71\uFF1F\u2026\u2026\u5514\u2026\u2026\u597D\u5427\u3002\u6211\u4EEC\u5230\u65F6\u5019\u89C1\u3002",
    "Sat": "\u5BF9\u6211\u6765\u8BF4\u5468\u672B\u548C\u5E73\u65F6\u4E5F\u6CA1\u4EC0\u4E48\u4E0D\u540C\u3002#$e#\u4F60\u9000\u4F11\u4E86\u7684\u8BDD\u4E5F\u4F1A\u4E00\u6837\u3002",
    "Sun": "\u4F60\u4E0D\u51B7\u5417\uFF1F\u4ED6\u4EEC\u4E0D\u518D\u50CF\u4EE5\u524D\u90A3\u6837\u7EC7\u6BDB\u8863\u4E86\u3002#$e#*\u5509*\u2026\u2026",
    "Thu": "\u6211\u73B0\u5728\u6CA1\u7A7A\u804A\u5929\uFF0C\u5C0F\u4F19\u5B50\u3002^\u6211\u73B0\u5728\u6CA1\u7A7A\u804A\u5929\uFF0C\u5C0F\u59D0\u3002#$e#\u6211\u6700\u559C\u6B22\u7684\u8282\u76EE\u6B63\u6F14\u7740\u5462\u3002",
    "Thu10": "\u5230\u4E86\u6211\u8FD9\u4E2A\u5E74\u7EAA\u5C31\u5F88\u96BE\u518D\u9002\u5E94\u65B0\u9C9C\u4E8B\u7269\u4E86\u3002#$e#\u6709\u4E00\u5929\u4F60\u4F1A\u61C2\u7684\u3002#$e#\u8D81\u7740\u5E74\u8F7B\u597D\u597D\u4EAB\u53D7\u5427\u3002",
    "Thu6": "\u4F60\u597D\uFF0C@\u3002\u60F3\u4E00\u8D77\u770B\u7535\u89C6\u5417\uFF1F",
    "Tue": "\u55EF\u2026\u2026\u8C8C\u4F3C\u53C8\u662F\u9634\u6C89\u7684\u4E00\u5929\u3002$s",
    "Tue10": "\u5BF9\u4E8E\u6211\u7684\u817F\uFF0C\u6211\u4E0D\u8BE5\u592A\u60B2\u89C2\u7684\u3002#$e#\u6211\u8BE5\u5E86\u5E78\u6211\u8FD8\u6D3B\u7740\u3002$h",
    "Wed": "\u4E9A\u5386\u514B\u65AF\u662F\u6211\u7684\u5B59\u5B50\u3002\u6211\u8DDF\u4F60\u8BF4\u8FC7\u5417\uFF1F#$e#\u54C8\uFF1F\u6CA1\u5173\u7CFB\u968F\u610F\u8BF4\u3002",
    "Wed10": "@\uFF01\u522B\u770B\u7535\u89C6\u4E86\u6211\u4EEC\u6765\u804A\u5929\u5427\u3002$h#$e#\u73B0\u5728\u7684\u5E74\u8F7B\u4EBA\u90FD\u5728\u73A9\u5565\uFF1F",
    "Wed10_inlaw_Alex": "\u6211\u627F\u8BA4\uFF0C\u6211\u89C9\u5F97\u2026\u2026\u4E24\u4E2A\u7537\u4EBA\u5728\u4E00\u8D77\u592A\u5947\u602A\u4E86\u3002\u4F46\u662F\u6211\u77E5\u9053\u4F60\u662F\u4E2A\u5F88\u68D2\u7684\u5E74\u8F7B\u4EBA\uFF0C\u800C\u4E14\u6211\u77E5\u9053\u4F60\u4EEC\u4FE9\u76F8\u7231\u4E86\u2026\u2026\u6211\u5DF2\u7ECF\u6539\u53D8\u6211\u7684\u60F3\u6CD5\u4E86\u3002^\u73B0\u5728\u4F60\u662F\u6211\u4EEC\u5BB6\u91CC\u7684\u4E00\u5206\u5B50\u4E86\u2026\u2026\u6211\u7B80\u76F4\u592A\u9A84\u50B2\u4E86\u3002",
    "Wed8": "\u6211\u591A\u5E0C\u671B\u6211\u7684\u817F\u597D\u8D77\u6765\uFF0C\u8FD9\u6837\u5C31\u53EF\u4EE5\u548C\u4E9A\u5386\u514B\u65AF\u6349\u8FF7\u85CF\u4E86\u3002$s#$e#\u4F46\u90A3\u5DF2\u7ECF\u662F\u4E0D\u53EF\u80FD\u7684\u4E86\u3002$s",
    "Wed_inlaw_Alex": "\u4E24\u4E2A\u7537\u4EBA\u600E\u4E48\u53EF\u4EE5\u7ED3\u5A5A\u5462\uFF1F\u592A\u4E0D\u6B63\u5E38\u4E86\u2026\u2026\u54FC\u3002\u53EF\u80FD\u662F\u6211\u201C\u8DDF\u4E0D\u4E0A\u65F6\u4EE3\u201D\u4E86\u2026\u2026^\u73B0\u5728\u4F60\u662F\u6211\u4EEC\u5BB6\u91CC\u7684\u4E00\u5206\u5B50\u4E86\u3002\u6211\u5F88\u9AD8\u5174\u6211\u7684\u5B59\u5B50\u5A36\u5230\u4E86\u8FD9\u4E48\u597D\u7684\u59BB\u5B50\u3002",
    "WinterStar_GiveGift_After": "\u4F60\u4E0D\u559C\u6B22\u662F\u5427\uFF1F\u5475\uFF01\u73B0\u5728\u7684\u5E74\u8F7B\u4EBA\u2026\u2026\u4EC0\u4E48\u90FD\u4E0D\u61C2\u5F97\u73CD\u60DC\u3002\u6211\u53C8\u4E0D\u662F\u4EC0\u4E48\u6709\u94B1\u4EBA\uFF0C\u4E70\u8FD9\u4E2A\u53EF\u8D35\u4E86\uFF01",
    "accept_867": "\u8FD9\u662F\u4EC0\u4E48\uFF1F#$b#\u5514\u2026\u2026\u6240\u4EE5\u4F60\u662F\u5148\u6309\u4E86\u8FD9\u4E2A\u6309\u952E\uFF1F\u8FD9\u4E2A\u6309\u952E\u662F\u7528\u6765\u505A\u4EC0\u4E48\u7684\uFF1F\u55EF\u2026\u2026\uFF08\u5495\u54DD\uFF09#$b#\u54C8\u54C8\uFF01\u55EF\uFF0C\u770B\u770B\u8FD9\u4E2A\uFF01\u662F\u65B0\u7684\u9891\u9053\uFF01$h#$b#\u7ED9\uFF0C\u62FF\u7740\u8FD9\u4E2A\u3002\u8FD9\u662F\u6211\u5F53\u5E74\u6316\u77FF\u7684\u65F6\u5019\u53D1\u73B0\u7684\u4E00\u5757\u77F3\u5934\u3002\u56DB\u5341\u5E74\u6765\uFF0C\u5B83\u4E00\u76F4\u51B0\u51C9\u51B0\u51C9\u7684\uFF0C\u8FD8\u53D1\u7740\u84DD\u5149\uFF0C\u5F88\u6709\u610F\u601D\u3002\u8DDF\u9B54\u6CD5\u4E00\u6837\uFF01",
    "divorced_once": "\u54FC\u2026\u2026\u9047\u5230\u56F0\u96BE\u5C31\u9000\u7F29\u4E86\u662F\u5427\uFF1F#$e#\u8FD9\u5E74\u5934\uFF0C\u7ED3\u5A5A\u5C31\u8DDF\u770B\u7535\u89C6\u4E00\u6837\u2026\u2026\u8981\u662F\u538C\u5026\u4E86\uFF0C\u6362\u4E2A\u9891\u9053\u5C31\u5B8C\u4E8B\u4E86\uFF01\u6211\u5E74\u8F7B\u7684\u65F6\u5019\u554A\u2026\u2026\uFF08\u53D1\u7262\u9A9A\uFF09",
    "eventSeen_18_memory_oneweek": "\u4F60\u770B\u6211\u53EF\u80FD\u8DDF\u4E0D\u4E0A\u65F6\u4EE3\uFF0C\u4F46\u4F60\u8981\u662F\u5230\u6211\u8FD9\u4E2A\u5E74\u7EAA\uFF0C\u5C31\u80FD\u5BF9\u4EBA\u751F\u770B\u5F97\u900F\u5F7B\u4E86\u3002\u8FD9\u5C31\u53EB\u201C\u667A\u6167\u201D\u3002#$b#\u5E74\u8F7B\u4EBA\u6839\u672C\u770B\u4E0D\u6E05\u5927\u5C40\u3002\u4ED6\u4EEC\u54EA\u6765\u8FD9\u4E2A\u6C34\u5E73\uFF1F",
    "eventSeen_502969_memory_oneweek": "\u4E0A\u5468\u4E4B\u540E\u90A3\u4E2A\u6D63\u718A\u5C31\u518D\u4E5F\u6CA1\u6765\u4E86\uFF01\u4E0D\u77E5\u9053\u4F60\u5E72\u4E86\u4EC0\u4E48\u3002",
    "joja_Begin": "\u90A3\u4E48\u2026\u2026\u8001\u793E\u533A\u4E2D\u5FC3\u6CA1\u4E86\uFF0C\u662F\u5427\uFF1F\u4E0D\u7BA1\u5C0F\u9547\u7684\u4EF7\u503C\u89C2\u6709\u4F55\u53D8\u5316\uFF1F\u65F6\u4EE3\u8FD9\u4E48\u53D8\uFF0C\u90FD\u662F\u4E00\u79CD\u803B\u8FB1\u2026\u2026",
    "married_Alex": "\u2026\u2026\u54FC\u3002^\u6211\u5165\u571F\u4E4B\u524D\u8BA9\u6211\u5F53\u4E2A\u66FE\u7237\u7237\uFF0C\u4F60\u770B\u884C\u4E0D\u884C\uFF1F",
    "pamHouseUpgrade": "\u8C22\u8C22\u4F60\u6362\u6389\u90A3\u8F86\u7834\u70C2\u4E0D\u582A\u7684\u65E7\u62D6\u8F66\u2026\u2026\u65B0\u623F\u5B50\u66F4\u597D\u770B\u4E86\u3002#$e#\u4F60\u77E5\u9053\u5417\uFF0C\u6211\u6562\u786E\u4FE1\uFF0C\u8FD9\u4E5F\u4F1A\u589E\u52A0\u6211\u4EEC\u623F\u4EA7\u7684\u4EF7\u503C\uFF01",
    "pamHouseUpgradeAnonymous": "\u54CE\u54DF\u2026\u2026\u90A3\u4E2A\u65B0\u623F\u5B50\u6709\u70B9\u906E\u6321\u6211\u7684\u6CB3\u666F\u2026\u2026\u4F46\u5B83\u80AF\u5B9A\u6BD4\u6F58\u59C6\u539F\u6765\u4F4F\u7684\u90A3\u4E2A\u8001\u9521\u7F50\u597D\u770B\u3002",
    "winter_1": "\u5662\u2026\u2026\u592A\u51B7\u4E86\u3002#$e#\u5E74\u8F7B\u4EBA\u5C31\u662F\u6297\u51BB\u554A\u3002"
  }
