  "entries": {
    "Good_1": "\u751F\u6D3B\u5728\u4E00\u8D77\u539F\u6765\u5982\u6B64\u6709\u8DA3\uFF01\u6211\u4E00\u76F4\u4EE5\u4E3A\u6211\u4F1A\u5355\u8EAB\u4E00\u8F88\u5B50\u3002",
    "Good_2": "\u6211\u4EEC\u8D70\u5230\u4E00\u8D77\u662F\u547D\u4E2D\u6CE8\u5B9A\u2026\u2026\u6211\u771F\u5FC3\u76F8\u4FE1\u8FD9\u4E00\u70B9\uFF01",
    "Good_3": "\u8C22\u8C22\u4F60\u5E26\u6211\u5230\u4F60\u7684\u5BB6\u3002\u6211\u559C\u6B22\u8FD9\u4E2A\u65B0\u7684\u751F\u6D3B\u3002$4",
    "Good_4": "\u6211\u4EEC\u7684\u632F\u52A8\u80FD\u91CF\u6781\u4E3A\u534F\u8C03\u3002\u4F60\u80FD\u611F\u89C9\u5230\u5417\uFF1F",
    "Good_5": "\u6211\u5341\u5206\u6B23\u8D4F\u6211\u7684\u5A5A\u793C\u62A4\u8EAB\u7B26\u2026\u2026\u8FD9\u5916\u5F62\u771F\u6F02\u4EAE\uFF01\u6211\u80FD\u611F\u89C9\u5230\u4ECE\u5B83\u8EAB\u4E0A\u6563\u53D1\u51FA\u6765\u7684\u7EAF\u84DD\u80FD\u91CF\u3002$l",
    "Good_6": "\u6628\u665A\u6211\u53C8\u505A\u4E86\u4E00\u4E2A\u5173\u4E8E\u6211\u4EEC\u68A6\u3002\u6211\u4EEC\u722C\u5230\u4E86\u4E00\u68F5\u6C34\u6676\u6811\u9876\u4E0A\uFF0C\u770B\u7740\u8302\u76DB\u7684\u548C\u7F8E\u4E3D\u7684\u8349\u5730\u3002\u6211\u4E00\u76F4\u5728\u505A\u8FD9\u4E2A\u68A6\u3002#$e#\u6211\u4E0D\u77E5\u9053\u8FD9\u610F\u5473\u7740\u4EC0\u4E48\uFF0C\u4F46\u6211\u89C9\u5F97\u8FD9\u662F\u4E00\u4E2A\u597D\u5146\u5934\u3002",
    "Indoor_Day_0": "\u5728%farm\u519C\u573A\u7684\u53C8\u4E00\u4E2A\u7F8E\u597D\u7684\u4E00\u5929\u2026\u2026\u6211\u76F8\u4FE1\u4ECA\u5929\u4F1A\u6709\u597D\u4E8B\u53D1\u751F\uFF01$h",
    "Indoor_Day_1": "\u6765\uFF0C\u62FF\u7740\u3002\u8FD9\u662F\u7ED9\u4F60\u7684\u3002[428 440 444 338 207 395 749]",
    "Indoor_Day_2": "\u563F\uFF0C\u67D0\u4EBA\u4E00\u5B9A\u7761\u5F97\u5F88\u597D\u2026\u2026\u4ECA\u5929\u65E9\u4E0A\u4F60\u770B\u4E0A\u53BB\u5F88\u6E05\u65B0\u4EAE\u4E3D\u3002$h",
    "Indoor_Day_3": "\u6211\u7684\u661F\u5EA7\u8FD0\u52BF\u4ECA\u5929\u4E0D\u662F\u592A\u597D\u2026\u2026\u4F46\u662F\u4ECD\u5C06\u5C3D\u91CF\u52AA\u529B\u3002\u8BA9\u6211\u4EEC\u5F00\u59CB\u5DE5\u4F5C\u5427\uFF01",
    "Indoor_Day_4": "\u554A\u2026\u2026*\u55DD*\u2026\u2026\u6211\u65E9\u9910\u5403\u4E86\u592A\u591A\u7684\u9EB8\u76AE\u677E\u997C\u3002$s",
    "Indoor_Night_0": "\u4F60\u7684\u886C\u886B\u4E0A\u662F\u4E0D\u662F\u53C8\u7834\u4E86\u4E2A\u6D1E\uFF1F\u4E0D\u7528\u62C5\u5FC3\uFF0C\u6211\u53EF\u4EE5\u7ED9\u4F60\u7F1D\u4E0A\u3002",
    "Indoor_Night_1": "\u6B22\u8FCE\u56DE\u5BB6\uFF0C@\u3002\u5E0C\u671B\u4F60\u4ECA\u5929\u8FC7\u5F97\u5F88\u6109\u5FEB\u3002",
    "Indoor_Night_2": "\u5DF2\u7ECF\u5230\u7761\u89C9\u65F6\u95F4\u4E86\uFF1F\u54CE\u5440\uFF0C\u53C8\u4E00\u5929\u4ECE\u6211\u8EAB\u8FB9\u98D8\u8D70\u4E86\u3002$u",
    "Indoor_Night_3": "\u554A\uFF0C\u90A3\u4E2A\u9999\u5473\uFF01\u53EA\u6709\u4F60\u4F1A\u6563\u53D1\u51FA\u8FD9\u79CD\u9999\u5473\u3002$h#$e#\u771F\u597D\u95FB\u3002",
    "Indoor_Night_4": "\u6211\u6253\u626B\u4E86\u6574\u4E2A\u5C4B\u5B50\uFF0C\u64E6\u6D17\u4E86\u7A97\u6237\uFF0C\u5E76\u6E05\u7406\u4E86\u51B0\u7BB1\u3002\u771F\u662F\u975E\u5E38\u5145\u5B9E\u7684\u4E00\u5929\uFF01",
    "Neutral_0": "\u5F53\u6211\u8001\u4E86\uFF0C\u5934\u53D1\u53D8\u767D\u3001\u53D8\u786C\u7684\u65F6\u5019\uFF0C\u6211\u5E0C\u671B\u4F60\u4F1A\u4F9D\u7136\u559C\u6B22\u6211\u3002",
    "Neutral_8": "\u6211\u4ECA\u5929\u6CA1\u6709\u7075\u611F\u2026\u2026$s",
    "OneKid_0": "\u6211\u5E0C\u671B\u6211\u4EEC\u7684\u5B69\u5B50%kid1\u80FD\u62E5\u6709\u5584\u826F\u548C\u4F53\u8D34\u7684\u54C1\u8D28\u3002\u8FD9\u6BD4\u5728\u5B66\u6821\u5F97\u9AD8\u5206\u91CD\u8981\u591A\u4E86\u3002",
    "OneKid_1": "\u4E00\u4E2A\u5B69\u5B50\u591F\u5417\uFF0C\u6216\u8005\u6211\u4EEC\u518D\u751F\u4E00\u4E2A\uFF1F#$e#\u6211\u60F3\u6211\u4EEC\u8FD8\u662F\u770B\u547D\u8FD0\u7684\u5B89\u6392\u5427\u3002",
    "OneKid_3": "\u6211\u70B9\u71C3\u4E86\u4E00\u53EA\u6D45\u7EFF\u8272\u7684\u8721\u70DB\uFF0C\u5E76\u5728%kid1\u5934\u4E0A\u6296\u4E86\u6296\u4E00\u675F\u5AE9\u8584\u8377\u679D\u3002\u8FD9\u6837\u5E94\u8BE5\u80FD\u9A71\u8D70\u4EFB\u4F55\u5371\u9669\u7684\u5E7D\u7075\u3002",
    "Outdoor_0": "\u6211\u559C\u6B22\u65E9\u8D77\u3002\u7A7A\u6C14\u6BD4\u8F83\u6E05\u65B0\uFF0C\u81EA\u7136\u754C\u4E2D\u7684\u751F\u547D\u4E5F\u66F4\u6709\u6D3B\u529B\u3002",
    "Outdoor_1": "\u4ECA\u5929\u7684\u65E5\u7A0B\u662F\u4EC0\u4E48\uFF0C\u4EB2\u7231\u7684\uFF1F",
    "Outdoor_2": "\u54E6\u54E6\uFF01\u54E6\uFF01\u6211\u53C8\u770B\u5230\u4E00\u53EA\u4E86\uFF01$h#$e#\u6211\u6B63\u5728\u6570\u677E\u9F20\u3002",
    "Outdoor_3": "\u6652\u4E00\u6652\u592A\u9633\u5BF9\u4F60\u662F\u6709\u597D\u5904\u7684\u3002\u4E0D\u8981\u611F\u5230\u4E0D\u723D\uFF0C\u597D\u5417\uFF1F",
    "Outdoor_4": "\u65E9\u4E0A\u597D\uFF01\u6211\u8FD8\u5728\u60F3\u4F60\u4EC0\u4E48\u65F6\u5019\u624D\u4F1A\u8D77\u5E8A\u5462\uFF01$h#$e#\u6CA1\u5173\u7CFB\uFF0C@\u2026\u2026\u4F60\u5E94\u8BE5\u597D\u597D\u7761\u4E0A\u4E00\u665A\u3002",
    "Rainy_Day_0": "\u6211\u60F3\u77E5\u9053\u4E0B\u96E8\u65F6\u98DE\u866B\u90FD\u5230\u54EA\u91CC\u53BB\u4E86\uFF1F\u96E8\u6C34\u96BE\u9053\u4E0D\u4F1A\u6253\u5728\u5B83\u4EEC\u8EAB\u4E0A\u5417\uFF1F",
    "Rainy_Day_1": "\u50CF\u8FD9\u6837\u7684\u4E00\u5929\u662F\u6765\u81EA\u5927\u81EA\u7136\u7684\u795D\u798F\u3002",
    "Rainy_Day_2": "\u65E9\u4E0A\u597D\u2026\u2026\u8FD9\u662F\u6211\u4E3A\u4F60\u51C6\u5907\u7684\u793C\u7269\u3002\u4E0D\u8981\u62C5\u5FC3\uFF0C\u6211\u5DF2\u7ECF\u7528\u718F\u9999\u718F\u8FC7\u4E86\u3002[428 440 444 338 207]",
    "Rainy_Day_3": "\u6211\u672C\u6765\u6253\u7B97\u653E\u98DE\u8FD9\u53EA\u9E66\u9E49\uFF0C\u4F46\u662F\u5B83\u7684\u7FC5\u8180\u603B\u662F\u65E0\u6CD5\u75CA\u6108\u3002\u4E0D\u8FC7\u5B83\u770B\u8D77\u6765\u5F88\u6EE1\u8DB3\u3002\u6211\u7ECF\u5E38\u7167\u987E\u5B83\u3002#$e#\u5B83\u5BF9\u6211\u8BF4\u5728\u8FD9\u91CC\u5F88\u5FEB\u4E50\u3002",
    "Rainy_Day_4": "\u6211\u4ECE\u6765\u6CA1\u6709\u544A\u8BC9\u8FC7\u4F60\u2026\u2026\u4F46\u662F\u5F53\u4F60\u7B2C\u4E00\u6B21\u6765\u5230\u8FD9\u91CC\u65F6\uFF0C\u6211\u505A\u4E86\u4E00\u4E2A\u8DDF\u4F60\u6709\u5173\u7684\u68A6\u3002\u6211\u5C31\u77E5\u9053\u6211\u4EEC\u7684\u4EBA\u751F\u9053\u8DEF\u4F1A\u4EA4\u7EC7\u5728\u4E00\u8D77\u3002$4",
    "Rainy_Night_0": "\u6BCF\u4E00\u4E2A\u65F6\u523B\u90FD\u6709\u4E00\u79CD\u72EC\u7279\u800C\u73CD\u8D35\u7684\u7F8E\u4E3D\u2026\u2026\u4F60\u6CE8\u610F\u5230\u4E86\u5417\uFF1F\u6709\u65F6\u5B83\u5F88\u5BB9\u6613\u88AB\u5FFD\u7565\u3002",
    "Rainy_Night_1": "\u6211\u80FD\u542C\u5230\u690D\u7269\u5F7C\u6B64\u7684\u4EA4\u8C08\u2026\u2026\u4ECA\u5929\u4E0B\u96E8\u8FC7\u540E\u4ED6\u4EEC\u5F88\u5F00\u5FC3\uFF01",
    "Rainy_Night_2": "\u4F60\u4ECA\u5929\u600E\u4E48\u6837\uFF1F\u4F60\u770B\u8D77\u6765\u6709\u70B9\u513F\u95F7\u95F7\u4E0D\u4E50\u3002@",
    "Rainy_Night_3": "\u6211\u7684\u4E00\u5929\u975E\u5E38\u5E73\u9759\u3002\u4F60\u7684\u5462\uFF1F",
    "Rainy_Night_4": "\u6765\u4E00\u4E9B\u751C\u70B9\u5417\uFF1F\u8FD9\u662F\u6211\u7528\u7279\u6B8A\u539F\u6599\u505A\u7684\uFF0C\u4E0D\u542B\u9EB8\u8D28\uFF0C\u53EA\u7528\u4ED9\u4EBA\u638C\u7CD6\u6D46\u6765\u589E\u52A0\u751C\u5473\u3002[232 234 223 220]$h",
    "Rainy_Night_5": "\u96E8\u58F0\u4F1A\u4E0D\u4F1A\u8BA9\u4F60\u542C\u5230\u5165\u8FF7\uFF1F",
    "TwoKids_1": "\u4E00\u4E2A\u5927\u623F\u5B50\uFF0C\u4E24\u4E2A\u5B69\u5B50\u548C\u4E00\u53EA\u9E66\u9E49\u2026\u2026\u6211\u5FD9\u5F97\u4E0D\u53EF\u5F00\u4EA4\uFF01",
    "TwoKids_2": "\u55EF\uFF0C%kid2\u7684\u5934\u53D1\u786E\u5B9E\u50CF\u4F60\u2026\u2026$u",
    "TwoKids_3": "\u5662\uFF0C\u6211\u5DF2\u7ECF\u7ED9\u5B69\u5B50\u5582\u8FC7\u7F8A\u5976\u548C\u6709\u673A\u85DC\u9EA6\u6CE1\u8299\u4E86\u3002\u4F60\u4E13\u5FC3\u7167\u987E\u519C\u573A\u5C31\u597D\uFF01",
    "fall_1": "\u4ECA\u5E74\u5DF2\u7ECF\u8FC7\u53BB\u4E00\u534A\u4E86\u3002\u771F\u662F\u96BE\u4EE5\u7F6E\u4FE1\uFF01",
    "fall_25": "\u6211\u4EEC\u7684\u8EAB\u4F53\u81EA\u7136\u5730\u4E0E\u5B63\u8282\u4FDD\u6301\u4E00\u81F4\u3002\u79CB\u5929\u7684\u5149\u7EBF\u548C\u8272\u5F69\u8FEB\u4F7F\u6211\u4EEC\u4E3A\u8352\u51C9\u7684\u51AC\u5B63\u505A\u51C6\u5907\u3002#$e#\u5BF9\u4E8E\u6211\u4EEC\u8FDC\u53E4\u7684\u7956\u5148\u6765\u8BF4\uFF0C\u8FD9\u79CD\u611F\u89C9\u4E00\u76F4\u4F34\u968F\u7740\u4ED6\u4EEC\u5E76\u4E14\u81F3\u5173\u91CD\u8981\u3002\u5BF9\u4E8E\u6211\u4EEC\u6765\u8BF4\uFF0C\u5B83\u4EC5\u4EC5\u662F\u900F\u8FC7\u55A7\u56A3\u7684\u73B0\u4EE3\u751F\u6D3B\u8F7B\u8F7B\u4E00\u77A5\u800C\u5DF2\u3002",
    "fall_Emily": "\u4ECA\u5929\u65E9\u4E0A\u6211\u559D\u4E86\u8425\u517B\u5976\u6614\uFF0C\u611F\u89C9\u8D85\u8D85\u8D85\u2014\u2014\u8D85\u68D2\u7684\uFF01$h",
    "funLeave_Emily": "\u4ECA\u5929\u6211\u6253\u7B97\u53BB\u9547\u4E0A\u901B\u901B\uFF0C\u7136\u540E\u53BB\u9152\u5427\u5E2E\u5FD9\u3002\u795D\u4F60\u6709\u7F8E\u597D\u7684\u4E00\u5929\u3002",
    "funReturn_Emily": "\u6211\u4ECA\u5929\u8FC7\u5F97\u5F88\u597D\u2026\u2026\u5076\u5C14\u51FA\u53BB\u8D70\u8D70\u4E5F\u633A\u597D\u7684\u3002",
    "patio_Emily": "\u8FD9\u662F\u6211\u6E05\u6668\u51A5\u60F3\u65F6\u6700\u559C\u6B22\u6765\u7684\u5730\u65B9\u3002#$e#\u6211\u60F3\u8C61\u8FD9\u5EA7\u6C34\u6676\u82B1\u56ED\u4E2D\u7684\u80FD\u91CF\u6D41\u7ECF\u6211\u7684\u8EAB\u4F53\u3002",
    "spouseRoom_Emily": "\u6211\u4ECA\u5929\u5C06\u82B1\u4E00\u4E9B\u65F6\u95F4\u966A\u4F34\u9E66\u9E49\u3002\u5B83\u6C38\u8FDC\u4E5F\u4E0D\u4F1A\u98DE\u4E86\uFF0C\u771F\u4EE4\u6211\u4F24\u5FC3\u3002$u",
    "spring_1": "\u65B0\u5E74\u5FEB\u4E50\uFF0C\u5B9D\u8D1D\u3002\u8BA9\u6211\u4EEC\u628A\u8FD9\u4E00\u5E74\u8FC7\u5F97\u7279\u522B\u4E00\u70B9\u3002$4",
    "spring_2": "\u6211\u7684\u690D\u7269\u670B\u53CB\u4EEC\u90FD\u91CD\u65B0\u7115\u53D1\u51FA\u4E86\u751F\u673A\u3002\u6211\u611F\u5230\u5F88\u6EE1\u8DB3\u3002",
    "spring_22": "\u55EF\u2026\u2026\u6211\u60F3\u53EF\u4EE5\u7528\u65B0\u6458\u7684\u852C\u83DC\u505A\u4E00\u4E2A\u6C99\u62C9\uFF0C\u4F5C\u4E3A\u665A\u9910\uFF0C\u600E\u4E48\u6837\uFF1F",
    "spring_Emily": "\u65B0\u7684\u4E00\u5E74\u8015\u79CD\u5F00\u59CB\u4E86\uFF0C\u6211\u597D\u5174\u594B\u554A\uFF0C@\uFF01$h",
    "summer_2": "\u5728\u8FD9\u7F8E\u597D\u7684\u4E00\u5929\uFF0C\u613F\u7531\u5DF4\u4FDD\u4F51\u4F60\u3002$7",
    "summer_20": "\u6211\u4EEC\u4F53\u5185\u7684\u80FD\u91CF\u5C31\u50CF\u5B63\u8282\u4E00\u6837\u5728\u6CE2\u52A8\u3002\u4E86\u89E3\u4F60\u81EA\u5DF1\u72EC\u6709\u7684\u8282\u594F\u662F\u901A\u5F80\u5185\u5728\u548C\u8C10\u7684\u7B2C\u4E00\u6B65\u3002",
    "summer_Emily": "\u54BB\uFF01\u5F88\u70ED\uFF0C\u4F46\u611F\u89C9\u5F88\u597D\uFF0C\u4E0D\u662F\u5417\uFF1F#$e#\u4E5F\u8BB8\u4ECA\u5929\u6211\u4EEC\u4F1A\u770B\u5230\u4E00\u4E9B\u91CE\u751F\u9E66\u9E49\u3002",
    "winter_15": "\u5728\u8FD9\u6837\u7684\u65E5\u5B50\u91CC\uFF0C\u6211\u6E34\u671B\u5F97\u5230\u8089\u6842\u3001\u8089\u8C46\u853B\u3001\u4E01\u9999\u3001\u5C0F\u8C46\u853B\u3002",
    "winter_2": "\u6211\u4E0D\u7981\u60F3\u5230\u90A3\u4E9B\u6B63\u5728\u5916\u9762\u51BB\u5F97\u745F\u745F\u53D1\u6296\u7684\u53EF\u601C\u7684\u677E\u9F20\u4EEC\u3002$s",
    "winter_5": "*\u5509*\u2026\u2026\u4E3A\u4EC0\u4E48\u4E16\u754C\u4E0A\u6709\u6218\u4E89\u548C\u4EC7\u6068\u5462\uFF1F$s",
    "winter_Emily": "\u54CE\u5466\uFF0C\u6211\u7684\u5934\u53D1\u53C8\u51DD\u56FA\u4E86\u3002$s"
  }
}