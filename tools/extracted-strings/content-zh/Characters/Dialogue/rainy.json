  "entries": {
    "Abigail": "\u96E8\u5929\u7684\u661F\u9732\u8C37\u522B\u6709\u4E00\u756A\u6ECB\u5473\u2026\u2026\u4F60\u8BF4\u5462\uFF1F",
    "Alex": "\u5514\u3002\u8FD9\u79CD\u5929\u6C14\u4E0D\u9002\u5408\u8FD0\u52A8\u3002$s#$e#\u554A\uFF0C\u4E0D\u8FC7\u5728\u5BA4\u5185\u8FD8\u662F\u53EF\u4EE5\u7EC3\u4E60\u4E3E\u91CD\u7684\u3002$h",
    "Caroline": "\u6211\u7684\u82B1\u56ED\u4ECA\u5929\u4F1A\u5F88\u9AD8\u5174\u3002$h#$e#\u2026\u2026\u800C\u4E14\u6211\u4EEC\u8FD9\u4E2A\u6708\u7684\u6C34\u8D39\u4E5F\u4F1A\u964D\u4F4E\u3002",
    "Clint": "\u4ECA\u5929\u662F\u63A2\u7D22\u77FF\u573A\u7684\u597D\u65E5\u5B50\u2026\u2026\u8FD0\u6C14\u597D\u7684\u8BDD\u8BF4\u4E0D\u5B9A\u80FD\u591F\u627E\u5230\u7A00\u6709\u77FF\u77F3\u3002",
    "Demetrius": "\u4F60\u597D\u3002\u60F3\u8981\u6696\u548C\u7684\u8BDD\u5C31\u8FDB\u6765\u5427\u3002",
    "Dwarf": "\u96E8\u2026\u2026\u5BF9\u6211\u4EEC\u6765\u8BF4\u5C31\u50CF\u795E\u8BDD\u6545\u4E8B\u4E00\u6837\u3002\u6211\u4EEC\u77EE\u4EBA\u4E00\u65CF\u6709\u7684\u4EBA\u4E00\u8F88\u5B50\u90FD\u6CA1\u89C1\u8FC7\u4E0B\u96E8\u3002",
    "Elliott": "\u4E0B\u96E8\u7684\u65F6\u5019\u8EBA\u5728\u5E8A\u4E0A\uFF0C\u9690\u7EA6\u80FD\u542C\u5230\u8FDC\u5904\u4F20\u6765\u96FE\u89D2\u58F0\u3002#$b#\u4F46\u662F\u671B\u51FA\u7A97\u5916\u53EA\u80FD\u770B\u89C1\u7070\u8499\u8499\u4E00\u7247\u3002",
    "Emily": "\u5361\u5229\u79D1\u6C99\u6F20\u4ECE\u4E0D\u4E0B\u96E8\u2026\u2026\u6211\u670B\u53CB\u6851\u8FEA\u5C31\u4F4F\u5728\u90A3\u91CC\u3002#$e#\u771F\u5E0C\u671B\u4ECA\u5929\u80FD\u53BB\u62DC\u8BBF\u5979\u3002$s",
    "Evelyn": "\u6211\u4E00\u9192\u6765\u5C31\u542C\u5230\u54EA\u91CC\u4F20\u6765\u6EF4\u6C34\u58F0\u2026\u2026\u5E94\u8BE5\u662F\u5929\u82B1\u677F\u6F0F\u6C34\u4E86\u3002$s#$e#\u4EE5\u524D\u90FD\u662F\u4E54\u6CBB\u8D1F\u8D23\u722C\u4E0A\u53BB\u4FEE\u597D\u7684\u2026\u2026*\u5509*$s",
    "George": "\u5929\u6C14\u4E5F\u592A\u51B7\u4E86\u5427\uFF1F\u65E5\u5B50\u771F\u96BE\u71AC\u554A\u3002",
    "Gus": "\u8FD9\u79CD\u5929\u6C14\u6700\u9002\u5408\u4EAB\u53D7\u4E00\u676F\u5E72\u6DA9\u7684\u7EA2\u9152\u4E86\uFF0C\u5BF9\u5427\uFF1F#$e#\u6211\u7231\u6B7B\u6211\u7684\u5DE5\u4F5C\u4E86\u3002\u54C8\u54C8\u54C8\u3002",
    "Haley": "\u6211\u82B1\u4E86\u4E00\u6574\u4E2A\u65E9\u4E0A\u5F04\u8FD9\u53D1\u578B\u2026\u2026\u4F46\u662F\u4E00\u573A\u5927\u96E8\u5C31\u7ED9\u6211\u6BC1\u4E86\u3002$s#$e#*\u5509* \u2026\u2026\u751F\u6D3B\u6709\u65F6\u786E\u5B9E\u4E0D\u5BB9\u6613\u554A\u3002",
    "Harvey": "\u55E8\uFF0C@\uFF01\u989D\u2026\u2026\u6700\u8FD1\u5728\u56FE\u4E66\u9986\u6709\u53D1\u73B0\u4EC0\u4E48\u597D\u4E66\u5417\uFF1F#$e#\u5475\u5475\u3002\u90A3\u4E2A\uFF0C\u5443\u2026\u2026\u4E0B\u6B21\u518D\u804A\uFF1F",
    "Jodi": "\u4F60\u8FDB\u6765\u524D\u64E6\u5E72\u51C0\u4E86\u9774\u5B50\u5417\uFF1F\u62B1\u6B49\u2026\u2026\u6211\u521A\u521A\u624D\u628A\u5730\u677F\u64E6\u5E72\u51C0\u3002#$e#\u4E0D\u8FC7\u8FD9\u91CC\u6C38\u8FDC\u6B22\u8FCE\u4F60\uFF01\u5475\u5475\u3002$h",
    "Krobus": "\u554A\uFF0C\u4ECA\u5929\u4E0B\u6C34\u9053\u6C34\u91CF\u5F88\u5927\u3002\u8FD9\u91CC\u4F1A\u53D8\u5F97\u5341\u5206\u6F6E\u6E7F\u2026\u2026\u5C31\u50CF\u6211\u559C\u6B22\u7684\u90A3\u6837\u3002",
    "Leah": "\u4E5F\u8BB8\u6211\u4ECA\u5929\u8BE5\u716E\u70B9\u65B0\u9C9C\u523A\u6FC0\u7684\u83DC\u80B4\u3002\u8FA3\u83DC\u597D\u50CF\u633A\u4E0D\u9519\u3002",
    "Leo": "\u4E0B\u96E8\u65F6\u5C71\u8C37\u91CC\u5F88\u5E73\u9759\u2026\u2026#$e#\u5BF9\u6211\u6765\u8BF4\u2026\u2026\u5927\u81EA\u7136\u5C31\u50CF\u662F\u4E00\u4E2A\u719F\u4EBA\uFF0C\u6709\u7740\u4E0D\u540C\u7684\u60C5\u7EEA\u3002",
    "Lewis": "\u4F60\u597D\u554A\uFF0C@\u3002\u4ECA\u5929\u53EF\u4EE5\u5077\u4E2A\u95F2\u5427\uFF1F#$e#\u5E0C\u671B\u6CB3\u6C34\u4E0D\u4F1A\u6CDB\u6EE5\u5427\u2026\u2026$s",
    "Linus": "\u6696\u6696\u7684\u96E8\u5F88\u9002\u5408\u5F53\u4F5C\u6C90\u6D74\u3002$h",
    "Marnie": "\u55E8\uFF0C@\u3002\u4F60\u90FD\u6210\u843D\u6C64\u9E21\u4E86\u2026\u2026\u53EF\u601C\u7684\u5B69\u5B50\uFF01$h",
    "Maru": "\u4E0B\u96E8\u7684\u65F6\u5019\u6211\u5C31\u6709\u501F\u53E3\u4E13\u5FC3\u505A\u6211\u7684\u5C0F\u73A9\u610F\u513F\u3002$h#$e#\u4E0D\u8FC7\u8FD9\u5BF9\u4F60\u6765\u8BF4\u5E94\u8BE5\u5F88\u65E0\u8DA3\u3002",
    "Pam": "\u5B69\u5B50\uFF0C\u4F60\u597D\u554A\u3002\u6CA1\u88AB\u6DCB\u6E7F\u5427\uFF1F",
    "Penny": "\u96E8\u6EF4\u6253\u5728\u6211\u4EEC\u623F\u8F66\u7684\u91D1\u5C5E\u8F66\u9876\u4E0A\u7684\u58F0\u97F3\u975E\u5E38\u54CD\u3002#$e#\u2026\u2026\u4E0D\u8FC7\u633A\u597D\u542C\u3002$h",
    "Pierre": "\u8FD9\u79CD\u5929\u6C14\u4E0B\u5F88\u591A\u4EBA\u90FD\u5F85\u5728\u5BB6\u91CC\u2026\u2026\u751F\u610F\u4E0D\u597D\u505A\u554A\u3002$s",
    "Robin": "\u5927\u96E8\u963B\u6B62\u4E0D\u4E86\u6211\u5B8C\u6210\u5DE5\u4F5C\uFF01$h#$e#\u867D\u8BF4\u6F6E\u6E7F\u7684\u6728\u6750\u5F88\u96BE\u5904\u7406\u3002$s",
    "Sam": "\u5927\u96E8\u63A9\u76D6\u4E86\u58F0\u97F3\uFF0C\u73B0\u5728\u6211\u5F39\u5409\u4ED6\u518D\u5927\u58F0\u90FD\u4E0D\u4F1A\u88AB\u5988\u5988\u9A82\u4E86\u3002\u5475\u5475\u3002$h",
    "Sandy": "\u542C\u8BF4\u5BB6\u4E61\u5728\u4E0B\u96E8\u3002\u4F60\u662F\u4E3A\u907F\u96E8\u624D\u8DD1\u6765\u8FD9\u91CC\u7684\u5417\uFF1F$h#$e#\u8BDD\u8BF4\u6211\u6709\u70B9\u6000\u5FF5\u96E8\u666F\u4E86\u2026\u2026$s",
    "Sebastian": "\u8FD0\u6C14\u597D\u7684\u8BDD\uFF0C\u8FD9\u79CD\u5929\u6C14\u53EF\u80FD\u4F1A\u770B\u89C1\u9752\u86D9\u3002",
    "Shane": "\u55EF\u2026\u2026\u8FD9\u5929\u6C14\u8BA9\u6211\u89C9\u5F97\u5F88\u5E72\u6E34\u3002 $s",
    "Wizard": "\u66B4\u96E8\u5929\u662F\u6211\u8DDF\u67D0\u4E9B\u5143\u7D20\u6C9F\u901A\u7684\u552F\u4E00\u673A\u4F1A\u3002#$e#\u4F60\u4E0D\u4F1A\u660E\u767D\u7684\u3002"
  }
