  "entries": {
    "AcceptGift_(O)18": "\u54C7\uFF01\u770B\u5230\u9EC4\u6C34\u4ED9\u5C31\u8BA9\u6211\u60F3\u5230\u4E86\u661F\u9732\u8C37\u7684\u6625\u5929\uFF01$h",
    "AcceptGift_(O)402": "\uFF08\u95FB\u4E86\u4E00\u4E0B\uFF09\u2026\u2026\u55EF\u2026\u2026\u9999\u8C4C\u8C46\u7684\u5473\u9053\u6700\u597D\u95FB\u4E86\u3002",
    "AcceptGift_(O)418": "\u554A\u2026\u2026\u661F\u9732\u8C37\u5373\u4F7F\u5728\u51AC\u5929\u4E5F\u80FD\u79CD\u51FA\u7F8E\u4E3D\u7684\u82B1\u6735\u3002",
    "AcceptGift_(O)StardropTea": "\u54C7\uFF0C\u8FD9\u4E2A\u592A\u5C11\u89C1\u4E86\u2026\u2026\u4F60\u5C45\u7136\u8981\u9001\u7ED9\u6211\u5417\uFF1F\u4EB2\u7231\u7684\uFF0C\u592A\u611F\u8C22\u4E86\uFF01",
    "Fri": "\u5728\u8FD9\u91CC\u8015\u79CD\u4E0D\u4F1A\u6709\u597D\u7ED3\u679C\uFF0C\u751C\u5FC3\u3002#$e#\u9664\u975E\u4F60\u662F\u60F3\u79CD\u4ED9\u4EBA\u638C\u3002$h",
    "Fri4": "\u6211\u5176\u5B9E\u4E0D\u53EB\u6851\u8FEA\u3002\u90FD\u662F\u4E3A\u4E86\u751F\u610F\u624D\u8FD9\u4E48\u53EB\u7684\u3002#$e#\u4E0D\u8FC7\u73B0\u5728\u5927\u5BB6\u90FD\u53EB\u6211\u6851\u8FEA\uFF0C\u6211\u4E5F\u4E60\u60EF\u4E86\u3002",
    "GreenRain": "\u542C\u8BF4\u661F\u9732\u8C37\u51FA\u73B0\u4E86\u7F55\u89C1\u7684\u5929\u6C14\u3002#$e#\u5047\u5982\u8FD9\u91CC\u4E5F\u80FD\u4E0B\u96E8\u5C31\u597D\u4E86\u2026\u2026$s",
    "Mon": "\u54C8\u55BD\uFF0C\u751C\u5FC3\uFF01#$b#\u5F88\u9AD8\u5174\u5DF4\u58EB\u6062\u590D\u670D\u52A1\u3002\u6211\u90FD\u5F00\u59CB\u611F\u89C9\u5230\u5B64\u72EC\u4E86\u3002#$e#\u2026\u2026\u6211\u5DEE\u70B9\u90FD\u8981\u5173\u95E8\u5927\u5409\u4E86\u3002$s#$e#\u4F46\u73B0\u5728\u6709\u4F60\u6765\u4E70\u79CD\u5B50\u4E86\u2026\u2026\u5BF9\u5427\uFF0C\u751C\u5FC3\uFF1F$h",
    "Sat": "\u55E8\uFF01\u6B22\u8FCE\u6765\u5230\u6851\u8FEA\u7684\u7EFF\u6D32\uFF0C\u5361\u5229\u79D1\u6C99\u6F20\u7684\u7B2C\u4E00\u65C5\u6E38\u80DC\u5730\uFF01#$e#*\u4F4E\u58F0\u8BF4*\u6211\u542C\u8D77\u6765\u591F\u4E13\u4E1A\u5417\uFF1F$h#$e#\u8BF7\u6D4F\u89C8\u6211\u4EEC\u7684\u56DB\u5B63\u79CD\u5B50\u7CBE\u54C1\u3002#$e#\u4F60\u770B\u8D77\u6765\u5F88\u53E3\u6E34\u3002\u6765\uFF0C\u5C1D\u5C1D\u8FD9\u676F\u51B0\u51BB\u9C9C\u5976\u3002[184]#$e#\u597D\u559D\u5427\uFF1F$h",
    "Sun": "\u8FD9\u91CC\u56DB\u5B63\u5982\u590F\uFF0C\u54EA\u6015\u662F\u51AC\u5929\u90FD\u4E00\u6837\u3002#$e#\u5176\u5B9E\u662F\u6709\u70B9\u70ED\u5F97\u8FC7\u5206\u2026\u2026\u6211\u7684\u76AE\u80A4\u5F88\u5BB9\u6613\u5C31\u88AB\u6652\u4F24\u3002$s",
    "Sun8": "\u55E8\uFF0C\u751C\u5FC3\u3002\u6CA1\u9519\uFF0C\u5C31\u662F\u6211\uFF0C\u72EC\u81EA\u4E00\u4EBA\u5728\u8FD9\u5BB6\u8001\u5E97\u91CC\u3002\u55EF\u2026\u2026#$e#\u9664\u4E86\u540E\u9762\u90A3\u4F4D\u5947\u602A\u7684\u5BB6\u4F19\u3002\u4F46\u662F\u4ED6\u4ECE\u6765\u6CA1\u6709\u51FA\u8FC7\u6765\uFF0C\u6240\u4EE5\u6211\u90FD\u7ECF\u5E38\u5FD8\u4E86\u4ED6\u3002",
    "Thu": "\u623F\u95F4\u540E\u9762\u7684\u90A3\u4E2A\u53EF\u7591\u7684\u5BB6\u4F19\uFF1F\u6211\u4E0D\u60F3\u591A\u7BA1\u95F2\u4E8B\u3002#$e#\u8BDD\u8BF4\u2026\u2026\u5C71\u8C37\u91CC\u7684\u6C14\u5019\u600E\u4E48\u6837\uFF1F",
    "Thu2": "\u623F\u95F4\u540E\u9762\u7684\u90A3\u4E2A\u53EF\u7591\u7684\u5BB6\u4F19\uFF1F\u6211\u4E0D\u60F3\u591A\u7BA1\u95F2\u4E8B\u3002#$e#\u8BDD\u8BF4\u2026\u2026\u5C71\u8C37\u91CC\u7684\u6C14\u5019\u600E\u4E48\u6837\uFF1F",
    "Thu4": "\u563F\u2026\u2026\u6211\u89C9\u5F97\u4F60\u662F\u4FE1\u5F97\u8FC7\u7684\u4EBA\u3002\u4F60\u80FD\u591F\u4FDD\u5B88\u79D8\u5BC6\u7684\uFF0C\u5BF9\u5427\uFF1F#$b#*\u4F4E\u58F0\u8BF4*\u540E\u9762\u7684\u90A3\u4E2A\u554A\u2026\u2026\u662F\u67D0\u95F4\u79C1\u4EBA\u4F1A\u6240\u3002\u6211\u4ECE\u6CA1\u8FDB\u8FC7\u53BB\uFF0C\u4F46\u662F\u4ED6\u4EEC\u6BCF\u4E2A\u6708\u7ED9\u6211\u5F88\u4E30\u539A\u7684\u79DF\u91D1\uFF0C\u6240\u4EE5\u6211\u4E0D\u4F1A\u53BB\u591A\u7BA1\u95F2\u4E8B\u3002#$e#\u554A\uFF01\u661F\u9732\u8C37\u7684\u5929\u6C14\u600E\u4E48\u6837\u4E86\uFF1F",
    "Tue": "\u4F60\u53EF\u4EE5\u5728\u5916\u9762\u627E\u5230\u6930\u5B50\u548C\u4ED9\u4EBA\u638C\u679C\u5B9E\u3002\u60F3\u8981\u591A\u5C11\u968F\u4FBF\u62FF\u3002#$e#\u90FD\u662F\u975E\u5E38\u7F8E\u5473\u7684\u3002\u563B\u563B\uFF01~$h",
    "Tue10": "\u55E8\uFF01~\u5F85\u4E45\u4E00\u70B9\u554A\u3002#$e#\u8FD9\u4E2A\u7A7A\u8C03\u611F\u89C9\u5F88\u4E0D\u9519\u5427\uFF1F",
    "Wed": "\u554A\u4F60\u597D\uFF01\u5982\u679C\u4F60\u5728\u9547\u4E0A\u9047\u89C1\u6211\u7684\u670B\u53CB\u827E\u7C73\u4E3D\uFF0C\u8BB0\u5F97\u5E2E\u6211\u6253\u4E2A\u62DB\u547C\uFF1F#$e#\u8C22\u8C22\uFF01$h",
    "Wed10": "\u563F\uFF0C\u662F@\uFF01\u5F88\u9AD8\u5174\u89C1\u5230\u4F60\uFF0C\u5B69\u5B50\u3002\u6211\u521A\u5728\u60F3\u4F60\u4F1A\u4E0D\u4F1A\u4E0D\u56DE\u6765\u4E86\uFF01#$e#\u8981\u4E0D\u662F\u8981\u7ECF\u8425\u8FD9\u5BB6\u5E97\uFF0C\u6211\u5C31\u4F1A\u8DDF\u4F60\u4E00\u5757\u56DE\u5C71\u8C37\u4E00\u4E24\u5929\u4E86\u2026\u2026\u5230\u65E7\u519C\u573A\u91CC\uFF0C\u5C31\u4F60\u6211\u4E24\u4EBA\u3002$s#$e#\u4F60\u5F97\u591A\u6765\u770B\u6211\u554A\uFF0C\u5426\u5219\u6211\u5C31\u4F1A\u5F88\u4F24\u5FC3\u3002$h",
    "Wed8": "\u50CF\u4F60\u8FD9\u6837\u7ECF\u5E38\u8DD1\u6765\u6C99\u6F20\u4E0D\u662F\u82B1\u8D39\u5F88\u5927\u5417\uFF1F#$e#\u4F60\u4E00\u5B9A\u662F\u5F88\u559C\u6B22\u6765\u89C1\u6211\uFF0C\u5BF9\u5427\uFF1F\u55EF\u2026\u2026 $h||\u5509\u2026\u2026\u6211\u5F88\u6000\u5FF5\u661F\u9732\u8C37\u7684\u6F02\u4EAE\u82B1\u6735\u2026\u2026$s",
    "accept_866": "\u661F\u9732\u8C37\u73AB\u7470\uFF1F\u771F\u662F\u592A\u6F02\u4EAE\u4E86\uFF01\u8C22\u8C22\u4F60\uFF01$h#$b#\u6211\u8981\u662F\u6000\u5FF5\u661F\u9732\u8C37\u5C31\u95FB\u4E00\u95FB\u8FD9\u6735\u73AB\u7470\u3002\u563F\u563F\u3002$h#$b#\u6765\uFF0C\u62FF\u7740\u8FD9\u4E2A\u3002\u5B83\u5DF2\u7ECF\u5728\u67B6\u5B50\u4E0A\u5F85\u4E86\u5341\u5E74\uFF0C\u6839\u672C\u6CA1\u6709\u4EBA\u4E70\u5B83\u3002\u4F60\u62FF\u8D70\u5427\uFF01",
    "married_Emily": "\u4F60\u4EEC\u7684\u5A5A\u793C\u600E\u4E48\u6837\uFF1F\u827E\u7C73\u4E3D\u4E4B\u524D\u8DD1\u8FC7\u6765\u8DDF\u6211\u8BF4\u4E86\u4F60\u4EEC\u7684\u4E8B\u60C5\u3002#$b#\u4E4B\u540E\u4E00\u5B9A\u8981\u53BB\u519C\u573A\u4E0A\u770B\u770B\u4F60\u4EEC\u4FE9\uFF01"
  }
}