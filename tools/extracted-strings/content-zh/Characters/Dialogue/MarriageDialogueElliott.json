  "entries": {
    "Good_0": "@\u2026\u2026\u6211\u5BF9\u4F60\u7684\u4E00\u5207\u52AA\u529B\u611F\u5230\u9A84\u50B2\u3002\u6709\u4F60\u6211\u771F\u5E78\u8FD0\u3002$l",
    "Good_1": "\u6211\u4E3A\u4F60\u5199\u4E86\u4E00\u672C\u79D8\u5BC6\u7684\u8BD7\u96C6\uFF0C\u6765\u8868\u8FBE\u6211\u5BF9\u4F60\u7684\u7231\u610F\u3002$l",
    "Good_2": "\u6211\u6765\u5230\u661F\u9732\u8C37\u672C\u662F\u4E3A\u4E86\u5BFB\u627E\u80FD\u53D1\u6325\u6211\u7279\u957F\u7684\u8C61\u7259\u5854\u3002\u4F46\u6211\u5374\u627E\u5230\u4E86\u5B64\u72EC\u4E4B\u7262\u3002\u662F\u4F60\u4ECE\u4E2D\u62EF\u6551\u4E86\u6211\u3002$l",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5E05\u5446\u4E86\uFF01\u4F60\u522E\u80E1\u5B50\u4E86\u5417\uFF1F\u4F60\u7684\u4E0B\u5DF4\u8F6E\u5ED3\u582A\u79F0\u5B8C\u7F8E\u3002$l^\u4ECA\u5929\u4F60\u6563\u53D1\u7684\u5973\u6027\u9B45\u529B\u7B80\u76F4\u8BA9\u4EBA\u65E0\u6CD5\u62B5\u6297\u3002\u6211\u65E0\u6CD5\u5C06\u89C6\u7EBF\u4ECE\u4F60\u8EAB\u4E0A\u79FB\u5F00\u3002$l",
    "Good_4": "\u4F60\u4E0D\u5728\u7684\u65F6\u5019\u6211\u767E\u722A\u6320\u5FC3\u3002\u4F46\u662F\u5F53\u6211\u542C\u5230\u68EE\u6797\u91CC\u6CE5\u9774\u7684\u58F0\u97F3\uFF0C\u6211\u7684\u5FC3\u53C8\u6B7B\u7070\u590D\u71C3\u4E86\u3002",
    "Good_5": "\u6211\u6B63\u5728\u884C\u7985\u3002\u8FD9\u5BF9\u6FC0\u53D1\u521B\u9020\u529B\u6709\u5E2E\u52A9\u3002",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6709\u65F6\u5019\u771F\u662F\u62C5\u5FC3\u4F60\u554A\uFF01\u4E16\u754C\u4E0A\u4F1A\u6709\u5360\u4F60\u4FBF\u5B9C\u7684\u4EBA\u3002",
    "Indoor_Day_0": "\u65E2\u7136\u6211\u4EEC\u5728\u4E00\u8D77\u4E86\uFF0C\u6211\u4F1A\u66F4\u52A0\u7167\u987E\u597D\u81EA\u5DF1\u7684\u3002\u5BF9\u6211\u6765\u8BF4\u5355\u8EAB\u751F\u6D3B\u4E0D\u662F\u5F88\u5065\u5EB7\u3002",
    "Indoor_Day_1": "\u65E9\u4E0A\u597D\u554A\uFF0C@\uFF01\u6211\u6CE1\u4E86\u4E00\u58F6\u5496\u5561\u3002[395]#$e#\u6211\u53D1\u73B0\u6BCF\u5929\u65E9\u4E0A\u6211\u90FD\u8D2A\u5FF5\u8FD9\u5F3A\u70C8\u7684\u5473\u9053\u3002",
    "Indoor_Day_2": "\u5982\u679C\u4F60\u5728\u623F\u5B50\u91CC\u53D1\u73B0\u8718\u86DB\uFF0C\u4E0D\u8981\u78BE\u788E\u5B83\uFF01\u544A\u8BC9\u6211\u4E00\u58F0\uFF0C\u6211\u4F1A\u628A\u8FD9\u53EF\u601C\u7684\u4E1C\u897F\u4E22\u5230\u5916\u9762\u53BB\u3002",
    "Indoor_Day_3": "\u6211\u6709\u79CD\u9884\u611F\u2026\u2026\u4ECA\u5929\u5C06\u4F1A\u662F\u7F8E\u5999\u7684\u4E00\u5929\uFF01$h#$e#\u6211\u9F3B\u5B50\u611F\u53D7\u5230\u4E86\u8FD9\u7279\u522B\u7684\u6C14\u606F\u2026\u2026",
    "Indoor_Day_4": "\u6211\u53C8\u505A\u4E86\u5669\u68A6\uFF0C\u68A6\u5230\u4F60\u7ED9\u6211\u5243\u4E86\u5E73\u5934\u2026\u2026\u4F60\u4E0D\u4F1A\u518D\u7ED9\u6211\u5243\u4E86\uFF0C\u5BF9\u5427\uFF1F$s#$e#\u6211\u76F8\u4FE1\u4F60\u3002",
    "Indoor_Night_0": "\u4ECE\u6700\u95EA\u4EAE\u7684\u51AC\u65E5\u4E4B\u661F\u5230\u94F1\u77FF\u7684\u5FAE\u5149\uFF0C\u90FD\u4E0D\u6BD4\u4E0D\u4E0A\u6211\u7684\u597D\u4EBA\u513F\u3002$l^\u4ECE\u6700\u95EA\u4EAE\u7684\u51AC\u65E5\u4E4B\u661F\u5230\u94F1\u77FF\u7684\u5FAE\u5149\uFF0C\u90FD\u4E0D\u6BD4\u4E0D\u4E0A\u4F60\u8FF7\u4EBA\u7684\u7F8E\u3002$l",
    "Indoor_Night_1": "\u567C\u556A\u7684\u706B\u7130\u7ED9\u5C4B\u5B50\u589E\u6DFB\u4E86\u5F88\u68D2\u7684\u6C14\u6C1B\u2026\u2026\u6BCF\u5757\u6728\u5934\u71C3\u70E7\u7684\u65B9\u5F0F\u90FD\u5F88\u72EC\u7279\u3002",
    "Indoor_Night_2": "\u6211\u5728\u6D77\u8FB9\u7684\u8001\u623F\u5B50\u91CC\u6CA1\u4EC0\u4E48\u6210\u529F\u7684\u79CD\u690D\u7ECF\u9A8C\u3002\u5E0C\u671B\u6211\u80FD\u8DDF\u7740\u4F60\u5B66\u4F1A\u4E00\u4E9B\u6280\u5DE7\u3002#$e#\u5728\u8FD9\u65B9\u9762\uFF0C\u4F60\u662F\u5927\u5E08\uFF0C\u800C\u6211\u662F\u8C26\u5351\u7684\u5B66\u5F92\u3002",
    "Indoor_Night_3": "\u5F53\u6211\u6CE8\u89C6\u4F60\u7F8E\u5999\u7684\u8138\u5E9E\uFF0C\u91D1\u8272\u7684\u5149\u51C0\u5316\u4E86\u6211\u90A3\u9897\u88AB\u6050\u6016\u7684\u9ED1\u591C\u6495\u88C2\u7684\u5FC3\u3002#$e#\u53EA\u6709\u8BD7\u624D\u80FD\u63CF\u8FF0\u6211\u5BF9\u4F60\u7684\u611F\u89C9\u3002$l",
    "Indoor_Night_4": "\u543E\u7231\u2026\u2026\u6211\u4E0D\u4F1A\u62FF100\u5757\u94F1\u952D\u6362\u53D6\u4F60\u3002#$e#\u4E5F\u4E0D\u4F1A\u662F1000\u5757\u2026\u2026#$e#\u751A\u81F310000\u5757\u4E5F\u4E0D\u884C$7#$e#\u2026\u2026$7#$e#100000\u5757\u4E5F\u4E0D\u884C\uFF01$a#$e#\u2026\u2026$s#$e#\u90A3\u2026\u2026\u4E00\u767E\u4E07\u5757\u7EAF\u94F1\u2026\u2026\uFF1F\u522B\u8BA9\u6211\u8FD9\u4E48\u505A\u2026\u2026$8",
    "OneKid_0": "\u4F60\u4ECA\u5929\u6709\u82B1\u4E00\u70B9\u513F\u65F6\u95F4\u7167\u987E\u5C0F%kid1\u73A9\u800D\u5417\uFF1F\u53EF\u80FD\u751F\u4E24\u4E2A\u5B69\u5B50\u4F1A\u8BA9\u6211\u4EEC\u66F4\u8F7B\u677E\u4E9B\u3002",
    "OneKid_1": "\u5C0F%kid1\u5C06\u5728\u8FD9\u91CC\u5EA6\u8FC7\u5FEB\u4E50\u7684\u7AE5\u5E74\u3002\u6709\u597D\u591A\u53EF\u4EE5\u63A2\u7D22\u7684\u5730\u65B9\u3002",
    "OneKid_3": "\u7167\u987E\u5B69\u5B50\u4E0D\u662F\u6211\u7684\u5F3A\u9879\u2026\u2026\u4F46\u6211\u4F1A\u5C3D\u6211\u6700\u5927\u7684\u52AA\u529B\u505A\u4E2A\u597D\u7238\u7238\u3002",
    "Outdoor_0": "\u6211\u6700\u5927\u7684\u68A6\u60F3\u5B9E\u73B0\u4E86\u2026\u2026\u770B\u770B\u8FD9\u4EE4\u4EBA\u53F9\u4E3A\u89C2\u6B62\u7684\u666F\u8272\uFF01",
    "Outdoor_1": "\u80A5\u6C83\u7684\u571F\u5730\u5728\u6211\u811A\u4E0B\uFF0C\u65B0\u9C9C\u7684\u7A7A\u6C14\u5145\u5165\u6211\u7684\u80BA\u91CC\uFF0C\u6E29\u6696\u7684\u592A\u9633\u8BA9\u6211\u6D51\u8EAB\u8212\u5766\u2026\u2026\u751F\u6D3B\u4E00\u5207\u987A\u5229\u3002",
    "Outdoor_2": "\u6211\u53EF\u80FD\u4F1A\u5F85\u5728\u8FD9\u91CC\uFF0C\u5199\u4E00\u4E9B\u8BD7\u3002\u6211\u611F\u89C9\u7075\u611F\u7A81\u7136\u6D8C\u6765\u3002\u4F60\u7EE7\u7EED\uFF0C\u770B\u597D\u751F\u610F\u3002",
    "Outdoor_3": "\u5982\u679C\u6211\u5B8C\u5168\u5F85\u7740\u4E0D\u52A8\uFF0C\u53EF\u80FD\u4F1A\u6709\u7F8E\u4E3D\u7684\u8774\u8776\u5F85\u5728\u6211\u7684\u9F3B\u5B50\u4E0A\u4E0D\u52A8\u3002",
    "Outdoor_4": "\u6211\u559D\u592A\u591A\u5496\u5561\u4E86\u2026\u2026\u6211\u5634\u5DF4\u5E72\u5F97\u50CF\u5361\u5229\u79D1\u6C99\u6F20\u4E00\u6837\u3002$s#$e#\u5662\u2026\u2026\u62B1\u6B49\u6211\u7684\u5634\u91CC\u90FD\u662F\u5496\u5561\u5473\u3002$7",
    "Rainy_Day_0": "\u6211\u4ECA\u5929\u611F\u89C9\u6709\u7075\u611F\u2026\u2026\u6211\u60F3\u6211\u4F1A\u5199\u70B9\u4E1C\u897F\u3002",
    "Rainy_Day_1": "\u96E8\u58F0\u4EE5\u4E00\u79CD\u5FAE\u5999\u7684\u65B9\u5F0F\u8BA9\u6211\u60F3\u8D77\u6211\u5728\u6D77\u8FB9\u7684\u5C0F\u5C4B\u3002#$e#\u519C\u573A\u5F88\u68D2\uFF0C\u4F46\u662F\u6211\u8FD8\u662F\u60F3\u5FF5\u5927\u6D77\u7684\u58F0\u97F3\u3002",
    "Rainy_Day_2": "\u6211\u8D77\u7684\u5F88\u65E9\uFF0C\u6CE1\u4E86\u4E9B\u5496\u5561\u3002[395]#$e#\u6211\u53D1\u73B0\u559D\u4E00\u676F\u8FD9\u79CD\u7CBE\u81F4\u7684\u996E\u6599\u80FD\u8BA9\u65E9\u6668\u8FC7\u5F97\u66F4\u52A0\u60EC\u610F\uFF01",
    "Rainy_Day_3": "\u4EB2\u7231\u7684\uFF0C\u6211\u4ECA\u5929\u8FD8\u662F\u4F1A\u5F85\u5728\u5C4B\u91CC\u3002\u8FD9\u96E8\u8BA9\u6211\u53D1\u4E1D\u67D4\u8F6F\u3002",
    "Rainy_Day_4": "\u6211\u5199\u4F5C\u7684\u7075\u611F\u5C31\u50CF\u5929\u6C14\u4E00\u6837\u2026\u2026\u6765\u6765\u53BB\u53BB\uFF0C\u65E0\u5F71\u65E0\u8E2A\u3002\u4ECA\u5929\u6211\u5B8C\u5168\u6CA1\u6709\u7075\u611F\u3002$s#$e#\u4E5F\u8BB8\u6211\u4F1A\u8BFB\u4E00\u672C\u540D\u8457\uFF0C\u597D\u6FC0\u53D1\u4E00\u4E9B\u7075\u611F\u3002",
    "Rainy_Night_0": "\u665A\u4E0A\u597D\u3002\u4ECA\u5929\u7684\u6536\u83B7\u5982\u4F55\uFF0C@\uFF1F^\u665A\u4E0A\u597D\u3002\u4EB2\u7231\u7684\uFF0C\u4ECA\u5929\u7684\u6536\u83B7\u5982\u4F55\uFF1F",
    "Rainy_Night_1": "\u4F60\u8EAB\u5B50\u51B7\u51B0\u51B0\u7684\uFF01\u8BA9\u6211\u5E2E\u4F60\u6696\u548C\u8D77\u6765\u5427\u3002$l",
    "Rainy_Night_2": "\u6211\u5F88\u64C5\u957F\u5199\u4F5C\uFF0C\u4F46\u6211\u8FD8\u662F\u65E0\u6CD5\u5F62\u5BB9\u4F60\u7684\u9B45\u529B\u3002$l^\u6211\u5F88\u64C5\u957F\u5199\u4F5C\uFF0C\u4F46\u6211\u8FD8\u662F\u65E0\u6CD5\u5F62\u5BB9\u4F60\u7684\u7F8E\u3002$l",
    "Rainy_Night_3": "\u6211\u4ECA\u5929\u505A\u4E86\u4EC0\u4E48\uFF1F\u6211\u8981\u8BF4\u2026\u2026\u8981\u82B1\u5F88\u591A\u7CBE\u529B\u624D\u80FD\u7EF4\u6301\u5F3A\u5065\u7684\u4F53\u9B44\u3002",
    "Rainy_Night_4": "\u6211\u4E00\u4E0B\u5348\u90FD\u5728\u5E7B\u60F3\u5927\u6D77\u3002\u6240\u4EE5\u6211\u51B3\u5B9A\u716E\u4E00\u4E9B\u6D77\u9C9C\u3002 [198 202 727 728]$h",
    "TwoKids_0": "\u6211\u5DF2\u7ECF\u7ED9%kid1\u548C%kid2\u5582\u8FC7\u996D\u4E86\u3002\u5C0F\u4E1C\u897F\u4EEC\u5403\u4E86\u5F88\u591A\uFF01",
    "TwoKids_1": "\u6211\u4E4B\u524D\u5E26\u8FC7%kid1\uFF0C\u6211\u53D1\u8A93\u6211\u542C\u5230\u4E86\u201C\u7238\u2026\u2026\u7238\u201D\u7684\u58F0\u97F3\u3002$h",
    "TwoKids_2": "\u6211\u8981\u5C3D\u5FEB\u6559%kid1\u770B\u4E66\uFF01\u8FD9\u662F\u5C0F\u5B69\u4E86\u89E3\u8FD9\u4E2A\u4E16\u754C\u7684\u597D\u65B9\u6CD5\u3002",
    "TwoKids_3": "\u6211\u4EEC\u505A\u5F97\u5F88\u597D\uFF0C@\u3002\u519C\u573A\u7ECF\u8425\u5F97\u5341\u5206\u987A\u5229\uFF0C\u800C\u6211\u4EEC\u5065\u5EB7\u7684\u5B69\u5B50\u4E5F\u5E26\u6765\u4E86\u5DE8\u5927\u7684\u559C\u60A6\u3002\u6211\u597D\u5F00\u5FC3\u554A\u3002",
    "fall_1": "\u79CB\u5929\u7684\u5149\u8F89\u2026\u2026\u4E94\u5B98\u7684\u76DB\u5BB4\u2026\u2026\u4ECE\u53E4\u81F3\u4ECA\u6FC0\u53D1\u4E86\u65E0\u6570\u4F1F\u5927\u8BD7\u4EBA\u7684\u521B\u4F5C\u7075\u611F\u3002",
    "fall_15": "\u660E\u5929\u6211\u4F1A\u653E\u4E0B\u6211\u7684\u9A84\u50B2\uFF0C\u6C89\u6D78\u5728\u677E\u8F6F\u591A\u6C41\u7684\u70E4\u4E09\u660E\u6CBB\u4E2D\u3002",
    "fall_26": "\u5982\u679C\u6211\u5728\u4E07\u7075\u8282\u4E0A\u72C2\u996E\u4E24\u52A0\u4ED1\u5357\u74DC\u5564\u9152\u4F60\u8FD8\u4F1A\u7231\u6211\u5417\uFF1F\u6709\u65F6\u5019\u7537\u4EBA\u4F1A\u6709\u7B80\u5355\u7C97\u66B4\u7684\u6B32\u671B\u2026\u2026",
    "funLeave_Elliott": "\u6211\u60F3\u6211\u4ECA\u5929\u4F1A\u53BB\u6D77\u8FB9\u3002\u6211\u603B\u662F\u5F88\u9AD8\u5174\u518D\u6B21\u770B\u5230\u5927\u6D77\u3002",
    "funReturn_Elliott": "\u6211\u4ECA\u5929\u4E00\u4E2A\u4EBA\u5728\u6D77\u8FB9\u8FC7\u5F97\u5F88\u6109\u5FEB\u3002\u6211\u770B\u6F6E\u8D77\u6F6E\u843D\uFF0C\u5C31\u50CF\u8FC7\u53BB\u4E00\u6837\u3002",
    "patio_Elliott": "\u554A\uFF0C\u591A\u4E48\u7F8E\u597D\u7684\u9002\u5408\u8BFB\u4E66\u7684\u4E00\u5929\u2026\u2026\u4EB2\u7231\u7684\uFF0C\u4F60\u4E0D\u89C9\u5F97\u5417\uFF1F",
    "spring_1": "\u6211\u65B0\u5E74\u7684\u51B3\u5FC3\u662F\u5199\u4F5C\u3001\u5199\u4F5C\u3001\u518D\u5199\u4F5C\uFF01\u6211\u4E0D\u80FD\u505C\u6B62\u63D0\u5347\u6211\u7684\u5199\u4F5C\u6280\u5DE7\u3002",
    "spring_12": "\u8FD9\u5F88\u5947\u602A\uFF0C\u4F46\u662F\u6211\u6625\u5929\u7ECF\u5E38\u6E34\u671B\u5403\u77F3\u69B4\u3002",
    "spring_23": "\u4EB2\u7231\u7684\uFF0C\u6211\u671F\u5F85\u660E\u5929\u548C\u4F60\u5171\u821E\u3002",
    "summer_1": "\u5F53\u9633\u5149\u666E\u7167\uFF0C\u8774\u8776\u5728\u5145\u6EE1\u6D46\u679C\u9999\u5473\u7684\u5FAE\u98CE\u4E2D\u98DE\u821E\u65F6\uFF0C\u60F3\u60C5\u7EEA\u4F4E\u843D\u4E5F\u96BE\u3002$h",
    "summer_10": "\u4ECA\u5929\u6211\u672C\u6765\u6253\u7B97\u53BB\u6211\u7684\u5C4B\u5B50\u518D\u62FF\u4E00\u74F6\u58A8\u6C34\u7684\uFF0C\u4F46\u662F\u540E\u6765\u6211\u60F3\u5230\u660E\u5929\u5C31\u662F\u590F\u5A01\u5937\u5BB4\u4F1A\u3002\u4E8E\u662F\u6211\u51B3\u5B9A\u5230\u65F6\u5019\u987A\u8DEF\u53BB\u3002",
    "summer_27": "\u6240\u6709\u7F8E\u597D\u7684\u4E8B\u60C5\u90FD\u4F1A\u843D\u5E55\uFF0C\u5305\u62EC\u590F\u5929\u5E78\u798F\u7684\u65E5\u5B50\u3002\u5E78\u798F\u7684\u79D8\u8BC0\u662F\u63A5\u53D7\u6539\u53D8\uFF0C\u4E0D\u53BB\u8BC4\u5224\u3002",
    "winter_1": "\u51AC\u5929\u662F\u770B\u4E66\u548C\u5F39\u94A2\u7434\u7684\u597D\u65F6\u5019\u3002\u8BB0\u5F97\u5076\u5C14\u505C\u4E0B\u6765\u4EAB\u53D7\u5B89\u9759\u7684\u65F6\u5149\u3002",
    "winter_28": "\u4EB2\u7231\u7684\uFF0C\u9664\u5915\u5FEB\u4E50\u3002\u8BF7\u6536\u4E0B\u8FD9\u4EFD\u5E86\u795D\u793C\u7269\u3002[348]",
    "winter_7": "\u6211\u6709\u70B9\u751F\u758F\u4E86\uFF0C\u4F46\u662F\u6211\u8BA1\u5212\u53C2\u52A0\u660E\u5929\u7684\u9493\u9C7C\u5927\u8D5B\uFF01\u4EB2\u7231\u7684\uFF0C\u4F60\u6709\u4E2A\u5F3A\u529B\u7684\u5BF9\u624B\u4E86\u3002"
  }
}