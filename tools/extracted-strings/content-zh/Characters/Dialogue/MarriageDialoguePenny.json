  "entries": {
    "Good_0": "@\u2026\u2026\u6211\u8FD8\u662F\u4E0D\u6562\u76F8\u4FE1\u6211\u4EEC\u7ED3\u5A5A\u4E86\u2026\u2026$l",
    "Good_1": "\u6211\u4E00\u76F4\u90FD\u68A6\u60F3\u548C\u4F60\u7ED3\u5A5A\u3002$l",
    "Good_2": "\u81EA\u4ECE\u4F60\u642C\u5230\u8FD9\u91CC\uFF0C\u6211\u5C31\u77E5\u9053\u4F60\u662F\u6211\u7684\u547D\u4E2D\u6CE8\u5B9A\u2026\u2026$l",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5E05\u5446\u4E86\uFF01\u4F60\u522E\u80E1\u5B50\u4E86\u5417\uFF1F$l^\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u7F8E\u6781\u4E86\u3002\u4F60\u6362\u4E86\u53D1\u578B\u5417\uFF1F$l",
    "Good_4": "\u8FD9\u5730\u65B9\u771F\u7684\u5F00\u59CB\u6709\u5BB6\u7684\u611F\u89C9\u4E86\u3002$l",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6709\u65F6\u5019\u6211\u62C5\u5FC3\u4F60\u6CA1\u6709\u5403\u8DB3\u591F\u7684\u5065\u5EB7\u98DF\u7269\u3002",
    "Indoor_Day_0": "\u8FD9\u91CC\u771F\u5B81\u9759\u3002\u6211\u8FC7\u53BB\u7ECF\u5E38\u505A\u6700\u6050\u6016\u7684\u5669\u68A6\uFF0C\u4F46\u662F\u73B0\u5728\u6211\u7761\u5F97\u5F88\u9999\u3002",
    "Indoor_Day_1": "\u65E9\u4E0A\u597D\u554A\uFF0C@\uFF01\u6211\u7ED9\u4F60\u505A\u4E86\u70ED\u817E\u817E\u7684\u65E9\u9910\uFF01[195 210 211]#$e#\u4F60\u586B\u6EE1\u809A\u5B50\u518D\u79BB\u5F00\u5BF9\u6211\u6765\u8BF4\u5F88\u91CD\u8981\u3002$h",
    "Indoor_Day_2": "\u55EF\uFF0C\u6211\u60F3\u6211\u4ECA\u5929\u4F1A\u770B\u4E66\u3002\u4E0A\u6B21\u5728\u56FE\u4E66\u9986\u7684\u65F6\u5019\uFF0C\u6211\u5B66\u5230\u4E86\u4E00\u4E9B\u65B0\u4E1C\u897F\u3002#$e#\u5188\u745F\u8BA9\u6211\u4EE3\u4ED6\u5411\u4F60\u95EE\u597D\u3002",
    "Indoor_Day_3": "\u6211\u559C\u6B22\u542C\u4F60\u8BB2\u627E\u5230\u7684\u90A3\u4E9B\u53E4\u7269\u3002\u8003\u53E4\u8BA9\u4EBA\u7740\u8FF7\uFF01#$e#\u60F3\u60F3\u770B\u2026\u2026 10000 \u5E74\u524D\u8FD9\u4E2A\u5730\u65B9\u53EF\u80FD\u5C31\u6709\u519C\u592B\u4E86\u3002",
    "Indoor_Day_4": "\u6211\u4EEC\u7B2C\u4E00\u6B21\u89C1\u9762\u7684\u65F6\u5019\u6211\u5F88\u5BB3\u7F9E\u5417\uFF1F\u73B0\u5728\u60F3\u60F3\u6211\u4EEC\u5DF2\u7ECF\u8D70\u8FC7\u6F2B\u6F2B\u957F\u8DEF\u8FD8\u771F\u6709\u8DA3\u3002$h",
    "Indoor_Night_0": "\u751C\u5FC3\uFF0C\u665A\u4E0A\u597D\u3002\u4F60\u505A\u5B8C\u4ECA\u5929\u60F3\u8981\u505A\u7684\u4E8B\u4E86\u5417\uFF1F#$e#\u5982\u679C\u6CA1\u6709\uFF0C\u4E5F\u6CA1\u5173\u7CFB\u3002\u6211\u4EEC\u6709\u7684\u662F\u65F6\u95F4\uFF01",
    "Indoor_Night_1": "\u55EF\u2026\u2026\u660E\u5929\u662F\u7A7F\u77ED\u88D9\u8FD8\u662F\u88E4\u5B50\uFF1F\u5662\uFF0C\u6211\u9A97\u8C01\u5462\u2026\u2026\u6211\u4E00\u76F4\u90FD\u662F\u7A7F\u77ED\u88D9\u3002",
    "Indoor_Night_2": "\u6211\u4EEC\u5728\u8FD9\u91CC\u8FC7\u5F97\u5F88\u597D\u3002\u6211\u4EEC\u5E94\u8BE5\u4E00\u76F4\u52AA\u529B\u5E76\u8BB0\u4F4F\u90A3\u4E9B\u6CA1\u6211\u4EEC\u5E78\u8FD0\u7684\u4EBA\u3002#$e#\u6211\u53EA\u662F\u5F88\u611F\u6FC0\u6211\u4EEC\u6240\u62E5\u6709\u7684\u4E1C\u897F\u3002",
    "Indoor_Night_3": "\u56E0\u4E3A\u6211\u79BB\u5F00\u4E86\u5979\u8EAB\u8FB9\uFF0C\u5988\u5988\u73B0\u5728\u53EF\u80FD\u5F88\u5B64\u72EC\u3002\u6211\u53EA\u662F\u5E0C\u671B\u5979\u4E0D\u8981\u592A\u9891\u7E41\u7684\u53BB\u9152\u5427\u6765\u6253\u53D1\u5BC2\u5BDE\u3002#$e#\u4F60\u4E0D\u7528\u611F\u5230\u96BE\u8FC7\uFF01\u5988\u5988\u5FC5\u987B\u89E3\u51B3\u5979\u81EA\u5DF1\u7684\u95EE\u9898\u3002 ",
    "Indoor_Night_4": "\u51C6\u5907\u597D\u94BB\u8FDB\u88AB\u7A9D\u4E86\u5417\uFF1F\u6211\u628A\u5E8A\u548C\u5176\u4ED6\u7684\u90FD\u51C6\u5907\u597D\u4E86\u2026\u2026$11",
    "OneKid_0": "\u4F60\u4ECA\u5929\u6709\u82B1\u4E00\u70B9\u513F\u65F6\u95F4\u548C\u5C0F%kid1\u73A9\u800D\u5417\uFF1F\u4E5F\u8BB8\u518D\u751F\u4E00\u4E2A\u5C0F\u5B69\u4F1A\u66F4\u597D\u4E9B\u3002",
    "OneKid_1": "\u5C0F%kid1\u5C06\u5728\u8FD9\u91CC\u5EA6\u8FC7\u5FEB\u4E50\u7684\u7AE5\u5E74\u3002",
    "OneKid_3": "\u81EA\u4ECE\u6211\u4EEC\u6709\u4E86\u5B69\u5B50\u540E\uFF0C\u6211\u611F\u89C9\u81EA\u5DF1\u8001\u4E86\u5F88\u591A\u3002\u4E5F\u8BB8\u53EA\u662F\u56E0\u4E3A\u6211\u627F\u62C5\u4E86\u65B0\u7684\u8D23\u4EFB\u3002#$e#\u8FD9\u611F\u89C9\u8FD8\u4E0D\u9519\uFF01\u6211\u65E9\u5C31\u671F\u5F85\u7740\u517B\u80B2\u5B69\u5B50\u4E86\u3002$11",
    "Outdoor_0": "\u6211\u4EE5\u524D\u53EA\u662F\u68A6\u60F3\u80FD\u4F4F\u5728\u8FD9\u6837\u7F8E\u4E3D\u7684\u5730\u65B9\uFF0C\u73B0\u5728\u7F8E\u68A6\u6210\u771F\u4E86\u3002#$e#\u6211\u66FE\u7ECF\u5728\u5BB6\u7684\u65F6\u5019\u8FC7\u5F97\u5F88\u60B2\u60E8\u3002$s",
    "Outdoor_1": "\u8FD9\u96BE\u9053\u4E0D\u662F\u629A\u80B2\u5B69\u5B50\u7684\u5B8C\u7F8E\u5730\u65B9\u5417\u3002#$e#\u80FD\u5728\u519C\u573A\u957F\u5927\u6211\u7B80\u76F4\u518D\u5F00\u5FC3\u4E0D\u8FC7\u4E86\u3002",
    "Outdoor_2": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u8981\u662F\u6211\u591A\u61C2\u4E9B\u8015\u79CD\u7684\u77E5\u8BC6\uFF0C\u6211\u4E00\u5B9A\u4F1A\u591A\u5E2E\u5E2E\u4F60\u7684\u3002\u5BF9\u4E0D\u8D77\uFF01#$e#\u6211\u4F1A\u4E00\u76F4\u60F3\u7740\u4F60\u7684\u3002$h",
    "Outdoor_3": "\u6211\u770B\u5230\u6B63\u897F\u65B9\u6709\u4E00\u53EA\u71D5\u5B50\u5728\u98DE\u3002\u5728\u661F\u9732\u8C37\uFF0C\u8FD9\u662F\u5F88\u597D\u7684\u9884\u5146\u3002$h",
    "Outdoor_4": "\u554A\u2026\u2026\u5728\u5916\u9762\u611F\u89C9\u53EF\u771F\u4E0D\u9519\uFF01\u6211\u53EF\u4EE5\u5728\u8FD9\u513F\u5F85\u4E00\u6574\u5929\uFF0C\u89C2\u5BDF\u6BCF\u79CD\u5C0F\u4E8B\u7269\u3002",
    "Rainy_Day_0": "\u96E8\u5929\u6211\u603B\u662F\u60F3\u7740\u8089\u6842\u548C\u997C\u5E72\u3002",
    "Rainy_Day_1": "\u4E0D\u77E5\u9053\u739B\u9C81\u548C\u54C8\u7EF4\u533B\u751F\u4F1A\u4E0D\u4F1A\u5728\u4E00\u8D77\uFF1F\u6211\u786E\u5B9A\u54C8\u7EF4\u559C\u6B22\u5979\u2026\u2026#$e#\u4F46\u662F\u6211\u89C9\u5F97\u739B\u9C81\u53EF\u5B9A\u4F1A\u5148\u8E0F\u51FA\u7B2C\u4E00\u6B65\u3002$h",
    "Rainy_Day_2": "\u55E8\uFF0C\u751C\u5FC3\uFF01\u4ECA\u5929\u65E9\u4E0A\u6211\u51FA\u53BB\u4E70\u4E1C\u897F\u4E86\uFF0C\u5E76\u4E3A\u4F60\u5E26\u4E86\u8FD9\u4E2A\u3002[186 180 770 535]#$e#\u6211\u89C9\u5F97\u4F60\u4E00\u5B9A\u7528\u5F97\u4E0A\u8FD9\u4E2A\u3002$11",
    "Rainy_Day_3": "\u55EF\u2026\u2026\u4E5F\u8BB8\u6211\u5E94\u8BE5\u8BD5\u9A8C\u4E00\u4E0B\u65B0\u914D\u65B9\u3002\u751C\u5FC3\uFF0C\u4F60\u559C\u6B22\u6211\u4E0A\u6B21\u7684\u90A3\u4E2A\u914D\u65B9\uFF0C\u5BF9\u5427\uFF1F#$e#\u53EB\u4EC0\u4E48\u6765\u7740\u2026\u2026\u201C\u7EA2\u8FA3\u6912@\u201D\uFF1F",
    "Rainy_Day_4": "\u5728\u8FD9\u6837\u7684\u65E5\u5B50\u91CC\uFF0C\u6211\u559C\u6B22\u7A9D\u8D77\u6765\u8BFB\u4E00\u672C\u597D\u4E66\u3002",
    "Rainy_Night_0": "\u4EB2\u7231\u7684\uFF0C\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u6211\u4E00\u4E0B\u5348\u5728\u8BFB\u4E00\u672C\u5C0F\u8BF4\u3002",
    "Rainy_Night_1": "\u6211\u60F3\u6211\u5988\u73B0\u5728\u80AF\u5B9A\u5728\u9152\u5427\u2026\u2026\u4F46\u662F\u6211\u5BF9\u8FD9\u4EF6\u4E8B\u611F\u89C9\u6CA1\u90A3\u4E48\u7CDF\u7CD5\u4E86\u3002\u6211\u65E0\u80FD\u65E0\u529B\u4E86\u3002",
    "Rainy_Night_2": "\u6211\u53EA\u662F\u5728\u60F3\u6211\u4EEC\u5728\u516C\u5171\u6D74\u5BA4\u76F8\u9047\u7684\u90A3\u4E00\u665A\u3002$l#$e#\u6211\u6C38\u8FDC\u4E0D\u4F1A\u5FD8\u8BB0\u90A3\u4E00\u665A\u2026\u2026$l",
    "Rainy_Night_3": "\u6211\u4F4F\u5728\u90A3\u4E2A\u8001\u62D6\u8F66\u91CC\u7684\u65F6\u5019\uFF0C\u96E8\u58F0\u66FE\u56F0\u6270\u6211\u3002\u4F46\u5728\u8FD9\u91CC\u96E8\u58F0\u5374\u8BA9\u4EBA\u6170\u85C9\u3002",
    "Rainy_Night_4": "\u6211\u505A\u4E86\u7F8E\u7F8E\u7684\u665A\u9910\u3002\u5E0C\u671B\u4F60\u559C\u6B22\u3002 [212 214 225 209 200]$h",
    "TwoKids_0": "\u6211\u5DF2\u7ECF\u7ED9%kid1\u548C%kid2\u5582\u8FC7\u996D\u4E86\u3002\u4ED6\u4EEC\u771F\u662F\u997F\u4E86\uFF01",
    "TwoKids_1": "\u6709\u4E86%kid2\u540E\uFF0C\u6211\u4EEC\u8981\u8BB0\u5F97\u591A\u5173\u6CE8\u4E9B%kid1\u3002\u6211\u4E0D\u60F3\u8BA9\u4ED6\u4EEC\u5AC9\u5992\u5BF9\u65B9\u3002",
    "TwoKids_2": "\u6211\u68A6\u5230%kid2\u957F\u4E86\u7FC5\u8180\uFF0C\u98DE\u5411\u591C\u7A7A\u3002\u8FD9\u610F\u5473\u7740\u4EC0\u4E48\uFF1F",
    "TwoKids_3": "\u4E00\u680B\u6F02\u4EAE\u7684\u623F\u5B50\uFF0C\u4E24\u4E2A\u53EF\u7231\u7684\u5B69\u5B50\u8FD8\u6709\u4E00\u65B9\u7F8E\u4E3D\u7684\u571F\u5730\u3002\u6211\u4EEC\u771F\u5E78\u8FD0\u3002",
    "fall_1": "\u79CB\u5929\u2026\u2026\u8BA9\u6211\u60F3\u5230\u5F69\u8272\u7684\u7EB8\u548C\u80F6\u6C34\u3002\u53EF\u80FD\u662F\u6211\u548C\u5B69\u5B50\u4EEC\u4E00\u8D77\u592A\u4E45\u4E86\u3002$h",
    "fall_2": "\u4F60\u4ECA\u5E74\u4F1A\u79CD\u5DE8\u578B\u5357\u74DC\u5417\uFF1F$11",
    "fall_5": "\u79CB\u5929\u7684\u5473\u9053\u8BA9\u6211\u60F3\u8D77\u4E66\u7684\u5473\u9053\u2026\u2026\u5F88\u5947\u602A\uFF0C\u4E0D\u662F\u5417\uFF1F",
    "funLeave_Penny": "\u6211\u4ECA\u5929\u8981\u53BB\u9547\u5B50\u91CC\u653E\u677E\u4E00\u4E0B\u3002\u6211\u4E00\u4F1A\u513F\u5C31\u56DE\u6765\uFF01",
    "funReturn_Penny": "\u6211\u73A9\u5F97\u5F88\u6109\u5FEB\u2026\u2026\u4E0E\u5927\u5BB6\u4FDD\u6301\u8054\u7CFB\u611F\u89C9\u5F88\u597D\u3002\u8BF4\u8BF4\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\u554A\u3002",
    "patio_Penny": "\u8FD9\u6BD4\u6211\u5728\u9547\u91CC\u7684\u8001\u5730\u65B9\u66F4\u5E73\u9759\u3002\u6211\u5728\u8FD9\u91CC\u5F88\u9AD8\u5174\u3002",
    "spring_1": "\u671F\u671B\u4ECA\u5E74\u5929\u6C14\u6696\u548C\u3002\u6211\u4EEC\u8981\u5728\u4ECA\u5E74\u4E30\u6536\u3002",
    "spring_15": "\u554A\uFF0C\u201C\u6625\u5B63\u5927\u626B\u9664\u201D\u2026\u2026\u5176\u5B9E\u6211\u5F88\u4EAB\u53D7\u8FD9\u4E2A\u3002",
    "spring_8": "\u6625\u5929\u5927\u6982\u662F\u6211\u6700\u559C\u6B22\u7684\u5B63\u8282\u3002\u7A7A\u6C14\u91CC\u9762\u6EE1\u662F\u751F\u6C14\uFF0C\u8BA9\u6211\u5145\u6EE1\u4E86\u5E0C\u671B\u3002",
    "summer_1": "\u590F\u5929\u771F\u70ED\uFF0C\u4F46\u662F\u8FD9\u6E7F\u5EA6\u8BA9\u76AE\u80A4\u5F88\u8212\u670D\u3002",
    "summer_16": "*\u547C*\u2026\u2026\u6211\u9700\u8981\u5403\u66F4\u591A\u751C\u74DC\u6D88\u6691\uFF01",
    "summer_2": "\u590F\u5929\uFF0C\u8682\u8681\u4F1A\u53D8\u5F97\u6D3B\u8DC3\u8D77\u6765\u3002\u6211\u53EF\u4EE5\u770B\u5B83\u4EEC\u597D\u51E0\u4E2A\u5C0F\u65F6\u2026\u2026\u4ECE\u5B83\u4EEC\u7684\u5916\u89C2\u6765\u770B\uFF0C\u8682\u8681\u4E00\u5B9A\u6709\u590D\u6742\u7684\u6587\u5316\u3002",
    "winter_1": "\u51AC\u5929\u662F\u653E\u677E\u7684\u597D\u65F6\u5019\u3002\u5728\u6F2B\u957F\u7684\u4E00\u5E74\u540E\u503C\u5F97\u597D\u597D\u653E\u677E\u4E00\u4E0B\uFF01",
    "winter_3": "\u8FD9\u4E2A\u51AC\u5929\u6211\u4EEC\u8981\u600E\u4E48\u7EF4\u6301\u751F\u8BA1\uFF1F\u5662\uFF0C\u4F60\u4E0D\u5FC5\u544A\u8BC9\u6211\u2026\u2026\u6211\u76F8\u4FE1\u4F60\u4F1A\u505A\u51FA\u6B63\u786E\u7684\u51B3\u5B9A\u3002",
    "winter_6": "\u98D8\u843D\u7684\u96EA\u8BA9\u6211\u60F3\u8D77\u6211\u5976\u5976\uFF0C\u5750\u5728\u706B\u65C1\u7684\u6447\u6905\u4E0A\u3002\u6211\u5370\u8C61\u6700\u6DF1\u7684\u662F\u5979\u7684\u5F71\u5B50\u5728\u6A59\u8272\u7684\u6728\u5934\u4E0A\u5FFD\u9690\u5FFD\u73B0\u3002\u90A3\u662F\u5F88\u4E45\u4EE5\u524D\u7684\u4E8B\u4E86\u3002"
  }
}