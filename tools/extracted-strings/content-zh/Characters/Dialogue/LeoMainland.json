  "entries": {
    "18": "\u6211\u521A\u6765\u7684\u65F6\u5019\uFF0C\u83B1\u7EB3\u65AF\u7ED9\u6211\u505A\u4E86\u4E00\u5957\u53F6\u5B50\u8863\u670D\uFF0C\u5C31\u548C\u4ED6\u7684\u8863\u670D\u4E00\u6837\u2026\u2026#$b#\u4F46\u6211\u7A7F\u7740\u770B\u4E0A\u53BB\u5F88\u6ED1\u7A3D\u2026\u2026\u50CF\u4E00\u53EA\u6BDB\u8338\u8338\u7684\u8292\u679C\uFF01$h#$e#\u6211\u60F3\uFF0C\u6211\u8FD8\u662F\u7EE7\u7EED\u7528\u7FBD\u6BDB\u5C31\u597D\u3002",
    "4": "\u6211\u770B\u5230\u4E00\u4E2A\u5927\u8292\u679C\u98D8\u5728\u7A7A\u4E2D\u3002\u83B1\u7EB3\u65AF\u544A\u8BC9\u6211\u8BF4\uFF0C\u90A3\u662F\u4E2A\u70ED\u6C14\u7403\uFF01$u#$b#\u6211\u8FD8\u4EE5\u4E3A\u53EA\u6709\u9E1F\u513F\u80FD\u98DE\u5462\u2026\u2026",
    "AcceptGift_(O)StardropTea": "\u54C7\uFF0C\u662F\u91D1\u8272\u6838\u6843\u7684\u5473\u9053\uFF01\u771F\u597D\u559D\uFF01",
    "Fri": "\u83B1\u7EB3\u65AF\u4E00\u76F4\u5728\u6559\u6211\u5C71\u8C37\u91CC\u91CE\u751F\u98DF\u7269\u7684\u5404\u79CD\u77E5\u8BC6\u3002\u91CE\u5916\u771F\u662F\u6709\u4E0D\u5C11\u597D\u4E1C\u897F\uFF01$h#$e#\u4E0D\u8FC7\u2026\u2026\u6211\u786E\u5B9E\u6709\u70B9\u6000\u5FF5\u6BCF\u5929\u5403\u91D1\u8272\u6838\u6843\u5F53\u65E9\u9910\u7684\u65E5\u5B50\u2026\u2026$s",
    "Fri8": "\u83B1\u7EB3\u65AF\u53D4\u53D4\u8BF4\u6211\u5E94\u8BE5\u628A\u9C7C\u5148\u201C\u70F9\u996A\u201D\u4E86\u518D\u5403\u2026\u2026$s#$b#\u8FD9\u592A\u96BE\u9002\u5E94\u4E86\u2026\u2026\u5E72\u5DF4\u5DF4\u7684\u2026\u2026$s",
    "GreenRain": "\u6211\u5F88\u559C\u6B22\u8FD9\u4E2A\u5929\u6C14\u2026\u2026\u5F88\u6F6E\u6E7F\uFF0C\u4EFF\u4F5B\u56DE\u5230\u4E86\u6211\u5BB6\u4E61\u7684\u68EE\u6797\u3002",
    "LeoDeparture": "\u6211\u9700\u8981\u627E\u5230\u80FD\u591F\u5C45\u4F4F\u7684\u5730\u65B9\u2026\u2026$s#$b#\u4F46\u6211\u6709\u4E2A\u8BA1\u5212\u2026\u2026\u6211\u6253\u7B97\u4F9D\u9760\u6211\u7684\u670B\u53CB\u4EEC\u3002",
    "Mon": "\u4F60\u597D\uFF0C@\u3002\u80FD\u518D\u5728\u5C9B\u4E0A\u89C1\u5230\u4F60\uFF0C\u5C31\u8DDF\u4ECE\u524D\u4E00\u6837\uFF0C\u771F\u662F\u592A\u597D\u4E86\u3002\u6211\u5F88\u5F00\u5FC3\uFF01#$e#\u55EF\uFF0C\u5F53\u521D\u4F60\u7B2C\u4E00\u6B21\u6765\u7684\u65F6\u5019\uFF0C\u6211\u88AB\u5413\u5230\u4E86\u2026\u2026\u5F53\u65F6\u6211\u5C31\u611F\u89C9\u6211\u7684\u751F\u6D3B\u4F1A\u53D1\u751F\u53D8\u5316\u3002$u",
    "Sat": "\u4E5F\u8BB8\u6709\u4E00\u5929\uFF0C\u6211\u4F1A\u53BB\u53C2\u89C2\u4E00\u4E0B\u7956\u7956\u57CE\u2026\u2026$u#$b#\u4F46\u73B0\u5728\u6211\u5B8C\u5168\u6CA1\u6709\u51C6\u5907\u597D\u3002\u5BF9\u6211\u6765\u8BF4\uFF0C\u8FD9\u91CC\u5DF2\u7ECF\u591F\u964C\u751F\u7684\u4E86\uFF0C\u4E0D\u8FC7\u76EE\u524D\u6211\u5F85\u5728\u8FD9\u91CC\u611F\u89C9\u5F88\u81EA\u5728\uFF01$h",
    "Sat10": "@\uFF1F\u5443\u2026\u2026\u6211\u6709\u70B9\u4E0D\u597D\u610F\u601D\u95EE\u2026\u2026$u#$b#\u4F60\u89C9\u5F97\u2026\u2026\u8D3E\u65AF\u4F1A\u8DDF\u6211\u8FD9\u6837\u7684\u4EBA\u505A\u670B\u53CB\u5417\uFF1F$u#$b#\u6211\u662F\u4E0D\u662F\u592A\u53E4\u602A\u4E86\uFF1F$s#$e#\u54C8\u54C8\u54C8\u2026\u2026\u8C01\u5728\u4E4E\u5462\u3002\u603B\u6709\u4E00\u5929\u6211\u4F1A\u5F04\u660E\u767D\u7684\u3002$h",
    "Sun": "\u4E5F\u8BB8\u6211\u4F1A\u628A\u661F\u9732\u8C37\u5F53\u4F5C\u6211\u7684\u65B0\u5BB6\u2026\u2026\u4F46\u662F\uFF0C\u8FD9\u5EA7\u5C9B\u4E5F\u59CB\u7EC8\u4F1A\u662F\u6211\u7684\u5BB6\u3002#$e#\u80FD\u591F\u56DE\u6765\u770B\u770B\uFF0C\u771F\u662F\u4E0D\u9519\u3002",
    "Sun10": "\u9E66\u9E49\u4EEC\u60F3\u8BA9\u6211\u611F\u8C22\u4F60\u7ED9\u5B83\u4EEC\u627E\u5230\u90A3\u4E48\u591A\u91D1\u8272\u6838\u6843\u3002\u5B83\u4EEC\u89C9\u5F97\u5F88\u597D\u5403\u3002$h",
    "Thu": "\u4F60\u6709\u6CA1\u6709\u6CE8\u610F\u8FC7\uFF0C\u751F\u6D3B\u5728\u8FD9\u91CC\u7684\u5404\u79CD\u6709\u8DA3\u9E1F\u513F\uFF1F#$e#\u5982\u679C\u4F60\u542C\u5F97\u8DB3\u591F\u4ED4\u7EC6\uFF0C\u5B83\u4EEC\u4E5F\u8BB8\u4F1A\u544A\u8BC9\u4F60\u4E00\u4E9B\u4E1C\u897F\u3002",
    "Thu10": "\u6700\u521D\uFF0C\u6211\u611F\u89C9\u81EA\u5DF1\u5728\u8FD9\u91CC\u662F\u4E2A\u5916\u6765\u8005\u3002\u4F46\u6211\u5DF2\u7ECF\u4EA4\u5230\u4E86\u8BB8\u591A\u670B\u53CB\uFF01$h#$b#\u7EC8\u4E8E\uFF0C\u6211\u611F\u89C9\u81EA\u5DF1\u6709\u4E86\u5F52\u5C5E\u2026\u2026",
    "Thu8": "\u6700\u521D\u611F\u89C9\u5F88\u7CDF\u2026\u2026\u8981\u79BB\u5F00\u5C9B\u5C7F\uFF0C\u7136\u540E\u8E0F\u4E0A\u4E00\u7247\u964C\u751F\u7684\u571F\u5730\u3002$s#$e#\u4F46\uFF0C\u8FC7\u4E86\u4E00\u6BB5\u65F6\u95F4\u540E\uFF0C\u6211\u5C31\u9002\u5E94\u4E86\u3002#$b#\u6211\u771F\u662F\u4E2A\u9002\u5E94\u6027\u6781\u5F3A\u7684\u4EBA\uFF01$h",
    "Tue": "\u6F58\u59AE\u5C0F\u59D0\u6B63\u5728\u5C3D\u529B\u8BA9\u6211\u52A0\u5FEB\u5B66\u4E60\u7684\u901F\u5EA6\u3002\u5979\u771F\u662F\u4E2A\u597D\u4EBA\u2026\u2026#$e#\u2026\u2026\u5E78\u8FD0\u7684\u662F\uFF0C\u6211\u56DE\u60F3\u8D77\u4E86\u4E00\u4E9B\u4E8B\u60C5\uFF0C\u6765\u81EA\u6211\u8FC7\u53BB\u7684\u8FC7\u53BB\u2026\u2026\u5728\u6211\u6D41\u843D\u5230\u5C9B\u4E0A\u4E4B\u524D\u2026\u2026\u6240\u4EE5\uFF0C\u5B66\u4E60\u4E5F\u6CA1\u6709\u60F3\u8C61\u4E2D\u7684\u90A3\u4E48\u96BE\u3002#$e#\u6F58\u59AE\u5C0F\u59D0\u8BF4\uFF0C\u5979\u5F88\u60CA\u8BB6\u6211\u77E5\u9053\u90A3\u4E48\u591A\u7684\u4E1C\u897F\uFF01",
    "Tue10": "\u5728\u4E00\u5F00\u59CB\u7684\u65F6\u5019\uFF0C\u6211\u786E\u5B9A\u8D3E\u65AF\u548C\u6587\u68EE\u7279\u89C9\u5F97\u6211\u5F88\u5947\u602A\u3002\u6211\u4E0D\u5C0F\u5FC3\u5728\u5B66\u4E60\u7684\u684C\u5B50\u65C1\u9E1F\u53EB\u4E86\u51E0\u6B21\u2026\u2026\u5F88\u5C34\u5C2C\u3002$s#$e#\u5927\u5BB6\u90FD\u89C9\u5F97\u6211\u6765\u4E86\u4E4B\u540E\u9547\u4E0A\u7684\u53D8\u5316\u5F88\u5927\u3002\u4F46\u6211\u4EEC\u73B0\u5728\u662F\u597D\u670B\u53CB\u4E86\uFF01$h",
    "Wed": "\u83B1\u7EB3\u65AF\u548C\u6F58\u59AE\u5C0F\u59D0\u4F1A\u8BA9\u6211\u5B66\u5230\u6240\u6709\u9700\u8981\u5B66\u4E60\u7684\u4E1C\u897F\uFF01$h#$e#\u5218\u6613\u65AF\u9547\u957F\u8BF4\uFF0C\u6211\u5C31\u5FEB\u8981\u6210\u4E3A\u201C\u5168\u65B9\u4F4D\u53D1\u5C55\u7684\u9547\u6C11\u201D\u4E86\u2026\u2026\u867D\u7136\u6211\u4E0D\u61C2\u662F\u4EC0\u4E48\u610F\u601D\u3002",
    "winter_Fri": "\u83B1\u7EB3\u65AF\u6559\u6211\u5236\u4F5C\u4E86\u4E00\u79CD\u7279\u6B8A\u7684\u8FA3\u5473\u6885\u5B50\u6E0D\u9C7C\u2026\u2026#$b#\u4ED6\u8BF4\uFF0C\u53EA\u8981\u6211\u591A\u5403\u70B9\u8FD9\u79CD\u9C7C\uFF0C\u4ECA\u5E74\u51AC\u5929\u6211\u5C31\u4E0D\u6101\u4FDD\u6696\u4E86\uFF01$h",
    "winter_Thu": "\u5C71\u8C37\u91CC\u7684\u9E1F\u513F\u5E76\u4E0D\u592A\u6015\u51B7\u3002#$e#\u6211\u6709\u4E00\u70B9\u70B9\u5AC9\u5992\u5B83\u4EEC\u6696\u548C\u7684\u8863\u88F3\u2026\u2026$s"
  }
}