    "winter_Mon10": "\u5C0F\u5FC3\u522B\u8BA9\u51B0\u67F1\u7838\u5230\u8111\u888B\uFF01\u6211\u53EF\u4E0D\u60F3\u8BA9\u6211\u6700\u597D\u7684\u670B\u53CB\u53D7\u4F24\uFF01",
    "winter_Sat": "\u4F60\u4F1A\u505A\u201C\u8C46\u7C7B\u706B\u9505\u201D\u5417\uFF1F#$e#\u6211\u5F88\u559C\u6B22\u90A3\u9053\u83DC\u3002$h%revealtaste:Emily:207#$e#\u4E0D\u8FC7\u5728\u51AC\u5929\u60F3\u8981\u83B7\u5F97\u65B0\u9C9C\u7684\u98DF\u6750\u5F88\u96BE\u554A\uFF0C\u662F\u4E0D\u662F\uFF1F",
    "winter_Sun": "\u55E8\uFF01#$e#\u2026\u2026\u6709\u4E8B\u5417\uFF1F",
    "winter_Sun6": "\u6211\u548C\u6211\u7684\u59B9\u59B9\u6709\u65F6\u4F1A\u6253\u67B6\u3002\u4E0D\u8FC7\u5979\u8981\u662F\u771F\u79BB\u5F00\u4E86\uFF0C\u6211\u4F1A\u975E\u5E38\u60F3\u5979\u7684\u3002#$e#\u6211\u89C9\u5F97\u5979\u6709\u4E00\u5929\u4F1A\u6210\u4E3A\u4E00\u540D\u5584\u826F\u7684\u5973\u6027\u2026\u2026\u522B\u8BA9\u5979\u77E5\u9053\u662F\u6211\u8BF4\u7684\u54E6\u3002$h#$e#\u6240\u4EE5\u8BF4\uFF0C\u4F60\u60F3\u804A\u4E9B\u4EC0\u4E48\u5417\uFF1F",
    "winter_Sun6_inlaw_Haley": "\u4EE3\u6211\u5411\u6211\u59B9\u59B9\u95EE\u597D\uFF01\u8FD8\u6709\uFF0C\u63D0\u9192\u5979\u660E\u5929\u6765\u770B\u6211\u3002",
    "winter_Thu": "\u8FD9\u4E9B\u53EF\u601C\u7684\u9C7C\u4E00\u5B9A\u611F\u89C9\u5F88\u51B7\u5427\u3002$s#$e#\u4E0D\u77E5\u9053\u9C7C\u4F1A\u4E0D\u4F1A\u51AC\u7720\u554A\uFF1F\u4E5F\u8BB8\u6211\u53EF\u4EE5\u53BB\u95EE\u95EE\u5FB7\u7C73\u7279\u91CC\u5384\u65AF\u3002",
    "winter_Tue": "\u54E6\uFF0C\u4F60\u597D\u554A\uFF0C@\uFF01$h#$e#\u4F60\u73B0\u5728\u662F\u4E0D\u662F\u5F88\u64C5\u957F\u79CD\u5730\u4E86\uFF1F",
    "winter_Tue2": "\u6211\u6562\u6253\u8D4C\uFF0C\u4F60\u73B0\u5728\u4E00\u5B9A\u5DF2\u7ECF\u6210\u4E3A\u4E86\u4E00\u4E2A\u4F18\u79C0\u7684\u519C\u573A\u4E3B\uFF01",
    "winter_Tue4": "\u6211\u611F\u89C9\u6211\u7684\u5934\u53D1\u51BB\u5F97\u786C\u90A6\u90A6\u7684\u2026\u2026\uFF01$s",
    "winter_Wed": "\u6D77\u8389\u548C\u6211\u751F\u6765\u5C31\u6CA1\u6709\u4F4F\u5927\u623F\u5B50\u7684\u547D\u3002\u6253\u626B\u5927\u623F\u5B50\u771F\u662F\u592A\u96BE\u4E86\u3002#$e#\u554A\uFF0C\u6211\u4E0D\u8BE5\u8FD9\u4E48\u62B1\u6028\u3002#$e#\u4F60\u7684\u519C\u820D\u770B\u8D77\u6765\u771F\u662F\u6E29\u99A8\u53C8\u8212\u9002\u554A\u3002$h"
  }
