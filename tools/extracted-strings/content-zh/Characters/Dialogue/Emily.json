    "AcceptBirthdayGift_Negative": "\u554A\uFF0C\u4F60\u8FD8\u8BB0\u5F97\u6211\u7684\u751F\u65E5\uFF01@\uFF0C\u8C22\u8C22\u4F60\uFF01\u4F60\u2014\u2014$h#$b#\u2026\u2026\uFF08\u95FB\u4E86\u4E24\u4E0B\uFF09\u2026\u2026\u4EC0\u4E48\u5473\u9053\uFF1F$s#$b#\u2026\u2026\u8FD9\u662F\u4EC0\u4E48\u4E1C\u897F\u2026\u2026\uFF1F$s",
    "AcceptBirthdayGift_Positive": "\u554A\uFF0C\u4F60\u8FD8\u8BB0\u5F97\u6211\u7684\u751F\u65E5\uFF01@\uFF0C\u8C22\u8C22\u4F60\uFF01\u4F60\u6709\u5FC3\u4E86\u3002$h",
    "AcceptGift_(O)60": "$c 0.5#\u554A\uFF01\u2026\u2026\u563F\u563F\u2026\u2026\u6211\u77E5\u9053\u4F60\u4ECA\u5929\u4E3A\u4EC0\u4E48\u9001\u6211\u8FD9\u5757\u5B9D\u77F3\u4E86\uFF0C\u771F\u6709\u610F\u601D\u2026\u2026#\u54C7\uFF0C\u597D\u6F02\u4EAE\uFF01\u8FD9\u4E2A\u989C\u8272\u8BA9\u6211\u60F3\u5230\u4E86\u68EE\u6797\u4E2D\u7684\u7075\u529B\u2026\u2026\u4F60\u80FD\u611F\u53D7\u5230\u91CC\u9762\u8574\u85CF\u7740\u6811\u6728\u7684\u529B\u91CF\u5417\uFF1F",
    "AcceptGift_(O)62": "$c 0.5#\u597D\u5149\u6ED1\u554A\uFF01\u62FF\u7740\u7684\u65F6\u5019\u2026\u2026\u6211\u80FD\u611F\u53D7\u5230\u6765\u81EA\u5927\u6D77\u91CC\u7F8E\u4EBA\u9C7C\u7684\u529B\u91CF\u3002\u8C22\u8C22\u4F60\uFF01#\u8C22\u8C22\u4F60\uFF01\u6211\u8981\u653E\u5728\u6795\u5934\u4E0B\u9762\uFF0C\u665A\u4E0A\u8BF4\u4E0D\u5B9A\u80FD\u68A6\u5230\u5927\u6D77\u5462\u3002",
    "AcceptGift_(O)64": "$c 0.5#\u54C7\uFF0C\u8FD9\u4E2A\u989C\u8272\uFF01\u8DDF\u6211\u7684\u8863\u670D\u5F88\u642D\u3002$h#\u54CE\uFF0C\u8FD9\u53EF\u592A\u597D\u4E86\u2026\u2026\u6700\u8FD1\u6211\u6709\u70B9\u6020\u60F0\uFF0C\u6709\u4E86\u7EA2\u5B9D\u77F3\u80AF\u5B9A\u80FD\u632F\u594B\u8D77\u6765\uFF01",
    "AcceptGift_(O)66": "$c 0.5#\u54C7\uFF0C@\uFF0C\u8FD9\u4E2A\u597D\u6F02\u4EAE\uFF01\u4F46\u613F\u4F60\u627E\u5B83\u7684\u65F6\u5019\u6CA1\u6709\u5192\u7740\u592A\u5927\u7684\u5371\u9669\u3002$h#\u54CE\uFF0C\u8FD9\u662F\u7D2B\u6C34\u6676\u5427\uFF01\u5E0C\u671B\u6211\u53BB\u9152\u5427\u5DE5\u4F5C\u5230\u6DF1\u591C\u7684\u65F6\u5019\uFF0C\u5B83\u80FD\u4FDD\u62A4\u6211\u3002",
    "AcceptGift_(O)68": "$c 0.5#\u54C7\u2026\u2026\u8C22\u8C22\u4F60\uFF01\u8FD9\u4E2A\u989C\u8272\u5F88\u7B26\u5408\u6211\u4ECA\u5929\u7684\u5FC3\u60C5\u3002$h#\u8FD9\u5757\u5B9D\u77F3\u6563\u53D1\u7740\u6E29\u6696\u8212\u7F13\u7684\u80FD\u91CF\uFF0C\u53EF\u4EE5\u8BA9\u4EBA\u91CD\u65B0\u96C6\u4E2D\u601D\u7EEA\u2026\u2026\u4ECA\u5929\u80FD\u6536\u5230\u8FD9\u4E2A\u771F\u662F\u592A\u5408\u9002\u4E86\uFF0C\u8C22\u8C22\u4F60\uFF01",
    "AcceptGift_(O)70": "$c 0.5#\u6211\u6628\u665A\u68A6\u89C1\u4F60\u4F1A\u9001\u6211\u4E00\u5757\u7FE1\u7FE0\uFF0C\u771F\u6709\u610F\u601D\uFF01$h#\u54CE\uFF0C\u8FD9\u662F\u7FE1\u7FE0\u5427\uFF01\u636E\u8BF4\u7FE1\u7FE0\u80FD\u62DB\u8D22\u2026\u2026\u8C01\u4F1A\u8DDF\u94B1\u8FC7\u4E0D\u53BB\u5462\uFF1F$h",
    "AcceptGift_(O)StardropTea": "\u54C7\uFF0C\u8C22\u8C22\u4F60\uFF01\u6211\u542C\u8BF4\u5982\u679C\u4F60\u7761\u524D\u559D\u8FD9\u4E2A\uFF0C\u665A\u4E0A\u505A\u68A6\u4F1A\u611F\u89C9\u8EAB\u4E34\u5176\u5883\u3002",
    "AcceptGift_(TR)ParrotEgg": "\u554A\uFF0C\u5E78\u597D\u8FD8\u6709\u70B9\u6E29\u5EA6\u2026\u2026\u53EF\u601C\u7684\u5C0F\u5BB6\u4F19\uFF0C\u5B83\u7684\u5988\u5988\u600E\u4E48\u4E86\uFF1F\uFF08\u67D4\u58F0\u8BF4\uFF09\u2026\u2026\u522B\u62C5\u5FC3\uFF0C\u5988\u5988\u5728\u8FD9\u91CC\u2026\u2026\u592A\u53EF\u601C\u4E86\u3002$s#$b#@\uFF0C\u4F60\u9001\u6211\u8FD9\u4E2A\u6211\u5F88\u5F00\u5FC3\uFF0C\u6211\u4F1A\u597D\u597D\u7167\u987E\u5B83\u7684\u3002",
    "FlowerDance_Accept": "\u597D\u554A\uFF0C\u6211\u53EF\u4EE5\u8DDF\u4F60\u8DF3\u821E\uFF01$h#$e#\u6211\u6709\u70B9\u5174\u594B\u2026\u2026\u611F\u89C9\u4F1A\u5F88\u5F00\u5FC3\uFF01",
    "FlowerDance_Accept_Spouse": "\u5F53\u7136\u597D\u5440\uFF0C\u751C\u5FC3\u3002\u6211\u671F\u5F85\u8FD9\u4E00\u523B\u5F88\u4E45\u4E86\uFF01$h",
    "FlowerDance_Decline": "\u5F88\u62B1\u6B49\u2026\u2026\u6211\u5DF2\u7ECF\u7B54\u5E94\u4E0E\u522B\u4EBA\u5171\u821E\u4E86\u3002$u",
    "Fri": "\u6625\u5929\u554A\uFF0C\u7F24\u7EB7\u7684\u5B63\u8282\u3002\u4E2A\u4EBA\u6765\u8BB2\u6211\u5F88\u559C\u6B22\u5B9D\u77F3\u8272\u8C03\u7684\u3002#$b#\u54E6\uFF0C\u62B1\u6B49\uFF01\u6211\u662F\u4E0D\u662F\u53C8\u5F00\u59CB\u5600\u5495\u5173\u4E8E\u6D41\u884C\u7684\u4E1C\u897F\u4E86\uFF1F",
    "GreenRain": "\u8FD9\u80CC\u540E\u80AF\u5B9A\u6709\u4EC0\u4E48\u6DF1\u610F\u2026\u2026\u5927\u81EA\u7136\u5728\u5411\u6211\u4EEC\u4F20\u9012\u4FE1\u53F7\u3002$3#$e#\u5177\u4F53\u662F\u4EC0\u4E48\u5462\uFF1F\u6211\u5206\u8FA8\u4E0D\u51FA\u6765\u2026\u2026\u5B9E\u5728\u592A\u96BE\u61C2\u4E86\u3002\u4E0D\u8FC7\uFF0C\u6211\u611F\u53D7\u5230\u4E00\u4E2A\u5F3A\u5927\u7684\u5B58\u5728\u2026\u2026$3",
    "GreenRain_2": "\u4F60\u611F\u53D7\u5230\u4E86\u5417\uFF1F\u68EE\u6797\u5728\u6B4C\u5531\uFF01\u5927\u6811\u5728\u6B22\u5FEB\u5730\u8DF3\u821E\uFF01",
    "Introduction": "\u54E6\u54E6\uFF01\u2026\u2026\u4ECE\u4F60\u7684\u8868\u60C5\u6211\u770B\u5F97\u51FA\u6765\uFF0C\u4F60\u5DF2\u7ECF\u5F00\u59CB\u559C\u6B22\u4E0A\u9E48\u9E55\u9547\u8FD9\u91CC\u4E86\u3002#$b#\u4F60\u8981\u662F\u60F3\u8FC7\u4E9B\u591C\u751F\u6D3B\u7684\u8BDD\uFF0C\u5C31\u53BB\u9152\u5427\u3002\u6211\u5728\u90A3\u91CC\u5DE5\u4F5C\u54E6\uFF01",
    "Mon": "\u6211\u548C\u6D77\u8389\u662F\u59D0\u59B9\uFF0C\u8FD9\u4E8B\u6211\u8DDF\u4F60\u8BF4\u8FC7\u5417\uFF1F\u662F\u4E0D\u662F\u5F88\u5947\u602A\uFF1F",
    "Mon2": "\u6211\u6709\u4E00\u4E2A\u4E0D\u4E3A\u4EBA\u77E5\u7684\u7231\u597D\uFF0C\u4F46\u6211\u4E0D\u4F1A\u8BF4\u3002#$e#\u4E5F\u8BB8\u6709\u4E00\u5929\u6211\u4F1A\u544A\u8BC9\u4F60\u3002$h",
    "Mon4": "\u8FD9\u4E2A\u4E16\u754C\u5145\u65A5\u7740\u5E7D\u7075\u4E0E\u9B54\u6CD5\u2026\u2026\u6709\u4E9B\u4EBA\u4E0D\u76F8\u4FE1\u6211\uFF0C\u4F46\u6211\u77E5\u9053\u8FD9\u662F\u771F\u7684\u3002#$e#\u6211\u4ECE\u4F60\u773C\u775B\u91CC\u53EF\u4EE5\u770B\u51FA\u6765\u2026\u2026\u4F60\u76F8\u4FE1\u5F02\u4E16\u754C\u7684\u5B58\u5728\uFF0C\u5C31\u50CF\u6211\u4E00\u6837\u3002",
    "Mon6": "\u6211\u5E0C\u671B\u6D77\u8389\u53EF\u4EE5\u627E\u4EFD\u5DE5\u4F5C\uFF0C\u6216\u8005\u81F3\u5C11\u53EF\u4EE5\u505A\u505A\u996D\uFF0C\u6253\u626B\u6253\u626B\u623F\u95F4\u3002$s#$e#\u6211\u89C9\u5F97\u5979\u60F3\u5AC1\u7ED9\u6709\u94B1\u4EBA\u3002$u",
    "Mon6_inlaw_Haley": "\u4E0D\u5F97\u4E0D\u8BF4\uFF0C\u81EA\u4ECE\u6D77\u8389\u8D70\u540E\uFF0C\u6211\u7684\u751F\u6D3B\u66F4\u4E95\u4E95\u6709\u6761\u4E86\u3002",
    "Mon8": "\u8FD9\u4E2A\u5C0F\u9547\u6709\u4E9B\u4EBA\u867D\u7136\u5F88\u5584\u826F\uFF0C\u4F46\u8FD8\u662F\u627E\u4E0D\u5230\u5C5E\u4E8E\u81EA\u5DF1\u7684\u5E78\u798F\u3002\u8FD9\u8BA9\u6211\u4F24\u5FC3\u3002$u#$e#\u7531\u4E8E\u6211\u5728\u9152\u5427\u5DE5\u4F5C\uFF0C\u6240\u4EE5\u4E5F\u80FD\u542C\u5230\u5404\u79CD\u9178\u751C\u82E6\u8FA3\uFF0C\u4EBA\u95F4\u51B7\u6696\u3002$u",
    "Resort": "\u5982\u679C\u4F60\u5411\u592A\u9633\u655E\u5F00\u5FC3\u6249\uFF0C\u5C31\u80FD\u5728\u4F53\u5185\u611F\u53D7\u5230\u7231\u7684\u80FD\u91CF\u3002$h",
    "Resort_Bar": "\u80FD\u5728\u9152\u5427\u5F53\u4E00\u6B21\u987E\u5BA2\u771F\u662F\u5947\u5999\uFF01$h",
    "Resort_Chair": "@\uFF0C\u4F60\u73A9\u5F97\u5F00\u5FC3\u5417\uFF1F\u7D2F\u4E86\u7684\u8BDD\uFF0C\u8BB0\u5F97\u4F11\u606F\u4E00\u4E0B\uFF01",
    "Resort_Dance": "%\u827E\u7C73\u4E3D\u6C89\u9189\u5728\u97F3\u4E50\u91CC\u3002",
    "Resort_Entering": "\u554A\uFF0C\u8FD9\u4E2A\u5730\u65B9\u771F\u4E0D\u9519\uFF01\u597D\u591A\u9E66\u9E49\uFF01",
    "Resort_Leaving": "\u554A\u2026\u2026\u547C\u5438\u597D\u8212\u7545\u3002",
    "Resort_Shore": "\u4F60\u80FD\u611F\u89C9\u5230\u5417\uFF1F\u6D77\u6D0B\u6709\u7740\u6DF1\u539A\u7684\u6CBB\u6108\u80FD\u91CF\u3002",
    "Sat": "\u6211\u559C\u6B22\u81EA\u5DF1\u505A\u8863\u670D\uFF0C\u53EF\u662F\u8981\u5F04\u5230\u5E03\u6599\u4E0D\u662F\u5F88\u5BB9\u6613\u3002#$e#\u8981\u8D70\u597D\u8FDC\u624D\u80FD\u8D70\u5230\u57CE\u5E02\u554A\u3002",
    "Sat6": "@\uFF0C\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\u5E03\u6599\u7684\u6750\u8D28\uFF1F\u6BCF\u79CD\u6750\u8D28\u90FD\u6709\u4E0D\u540C\u7684\u4E2A\u6027\u2026\u2026\u6478\u6478\u6211\u7684\u88D9\u5B50\u2026\u2026\u611F\u89C9\u5230\u4E86\u5417\uFF1F",
    "Sun": "\u55E8\uFF0C@\uFF01#$e#\u4F60\u517B\u6CA1\u517B\u7EF5\u7F8A\u554A\uFF1F\u5B83\u4EEC\u7684\u6BDB\u53EF\u4EE5\u7EC7\u6210\u975E\u5E38\u6F02\u4EAE\u7684\u5E03\u6599\uFF01#$e#\u4E0D\u8FC7\uFF0C\u4F60\u9700\u8981\u4E00\u53F0\u7EC7\u5E03\u673A\u3002\u5982\u679C\u4F60\u77E5\u9053\u600E\u4E48\u505A\u7684\u8BDD\u53EF\u4EE5\u81EA\u5DF1\u505A\u4E00\u4E2A\u3002",
    "Sun4": "\u7236\u6BCD\u628A\u623F\u5B50\u4EA4\u7ED9\u6211\u4EEC\u7167\u770B\u3002\u4ED6\u4EEC\u5728\u8FC7\u53BB\u4E24\u5E74\u91CC\u90FD\u5728\u73AF\u6E38\u4E16\u754C\u3002#$e#\u6211\u4EEC\u4E0D\u77E5\u9053\u4ED6\u4EEC\u4EC0\u4E48\u65F6\u5019\u4F1A\u56DE\u6765\u3002#$e#\u4E0D\u8FC7\u6211\u5F88\u559C\u6B22\u5728\u8FD9\u91CC\u751F\u6D3B\u3002\u8FD9\u91CC\u5F88\u6F02\u4EAE\uFF0C\u5C0F\u9547\u4E5F\u5F88\u68D2\u3002",
    "Thu": "\u6211\u5E0C\u671B\u4F60\u53EF\u4EE5\u7528\u53EF\u6301\u7EED\u5730\u7684\u65B9\u6CD5\u6765\u8015\u4F5C\u3002\u661F\u9732\u8C37\u7684\u751F\u6001\u7CFB\u7EDF\u53EF\u662F\u5F88\u8106\u5F31\u7684\uFF01#$e#\u4F60\u95EE\u6211\u600E\u4E48\u77E5\u9053\u7684\uFF1F\u6211\u7684\u76F4\u89C9\u53EF\u662F\u5F88\u5F3A\u7684\uFF01",
    "Thu4": "\u6709\u65F6\u5019\uFF0C\u82B1\u513F\u4F1A\u8DDF\u6211\u8BF4\u8BDD\u2026\u2026\u6BCF\u4E00\u6735\u90FD\u5728\u8BC9\u8BF4\u7740\u4E0D\u540C\u7684\u6545\u4E8B\uFF01",
    "Tue": "\u6211\u5728\u683C\u65AF\u9152\u5427\u517C\u804C\u3002\u8D5A\u7684\u94B1\u80FD\u89E3\u51B3\u597D\u5927\u95EE\u9898\u5462\u3002",
    "Tue4": "\u6211\u5728\u683C\u65AF\u9152\u5427\u5DE5\u4F5C\u53EA\u662F\u4E3A\u4E86\u7EF4\u751F\u2026\u2026\u53EF\u662F\u6211\u771F\u6B63\u7684\u68A6\u60F3\u662F\u5F53\u88C1\u7F1D\u3002$u#$e#\u4F60\u770B\uFF0C\u8FD9\u4E9B\u8863\u670D\u90FD\u662F\u6211\u4EB2\u624B\u7F1D\u7684\u54E6\u3002",
    "Tue6": "\u5662\uFF0C\u55E8\u2026\u2026\u5F88\u9AD8\u5174\u4F60\u6765\u770B\u6211\u3002$h",
    "Tue8": "@\u2026\u2026\u6211\u8BA4\u4E3A\u6211\u4EEC\u7684\u672A\u6765\u90FD\u5F88\u5149\u660E\u3002",
    "Wed": "\u6211\u542C\u8BF4\u8FC7\u4E00\u4E9B\u5173\u4E8E\u7A00\u4E16\u9B54\u6212\u7684\u4F20\u8A00\u3002\u636E\u8BF4\u8FD9\u4E9B\u6212\u6307\u7531\u5931\u843D\u7684\u6587\u660E\u6240\u6253\u9020\u3002\u6211\u4E5F\u4E0D\u77E5\u9053\u662F\u4E0D\u662F\u771F\u7684\u3002",
