  "entries": {
    "AcceptGift_(O)StardropTea": "\u554A\uFF0C\u8FD9\u662F\u4EC0\u4E48\u597D\u4E1C\u897F\uFF1F\u597D\u50CF\u662F\u4E00\u79CD\u7F55\u89C1\u7684\u5F3A\u529B\u836F\u6C34\u3002\u5F88\u597D\uFF0C\u6211\u7684\u8BD5\u5242\u7BB1\u91CC\u53C8\u65B0\u6DFB\u4E00\u4E2A\u5B9D\u8D1D\u3002",
    "Fri": "\u6211\u89C9\u5F97\u9547\u4E0A\u7684\u4EBA\u90FD\u6015\u6211\u3002#$e#\u867D\u7136\u5F88\u4E0D\u5E78\uFF0C\u4E0D\u8FC7\u4EBA\u7C7B\u60E7\u6015\u672A\u77E5\u4E5F\u662F\u6B63\u5E38\u7684\u5427\u3002",
    "Fri6": "\u6211\u5F88\u4E45\u4EE5\u524D\u7ED3\u8FC7\u5A5A\u3002\u540E\u6765\u6211\u4EEC\u5206\u5F00\u4E86\uFF0C\u5979\u5C31\u5728\u57CE\u9547\u5468\u56F4\u56DB\u5904\u4E71\u98DE\uFF0C\u5BF9\u6240\u89C1\u4E4B\u7269\u4E0B\u8BC5\u5492\u3002#$e#\u7528\u8FD9\u65B9\u6CD5\u6765\u53D1\u6CC4\u81EA\u5DF1\u7684\u6124\u6012\uFF0C\u771F\u662F\u5B69\u5B50\u6C14\u3002",
    "GreenRain": "\u4ECA\u5929\u53CD\u5E38\u7684\u96E8\u6C34\u53EF\u80FD\u4F1A\u4EE4\u4EBA\u6050\u614C\uFF0C\u4E0D\u8FC7\u5176\u5B9E\u6CA1\u4EC0\u4E48\u597D\u6015\u7684\u3002#$e#\u5F88\u591A\u751F\u7269\u53CD\u800C\u9AD8\u5174\u8FD8\u6765\u4E0D\u53CA\u5462\u3002",
    "GreenRain_2": "\u81EA\u7136\u7684\u529B\u91CF\u6781\u4E3A\u5F3A\u5927\uFF0C\u4E0D\u5BB9\u5C0F\u89D1\u3002#$e#\u4E0D\u597D\u610F\u601D\uFF0C\u6709\u4E9B\u7279\u6B8A\u7684\u4E8B\u60C5\u6211\u5F97\u5728\u4ECA\u5929\u5904\u7406\u6389\u3002",
    "Introduction": "\u554A\uFF0C\u6CA1\u9519\u3002\u6211\u5F88\u4E45\u524D\u5C31\u9884\u89C1\u5230\u4F60\u7684\u5230\u6765\u4E86\uFF0C\u5E74\u8F7B\u7684@\u3002#$e#\u4E0D\u8FC7\uFF0C\u4F60\u7684\u547D\u8FD0\u6700\u7EC8\u8FD8\u662F\u638C\u63E1\u5728\u4F60\u81EA\u5DF1\u624B\u4E2D\u3002",
    "Mon": "\u5173\u4E8E\u4F60\u7684\u672A\u6765\uFF0C\u6211\u770B\u5230\u4E86\u5F88\u591A\u4E8B\u554A\uFF0C\u5E74\u8F7B\u7684@\u3002#$e#\u5982\u679C\u6211\u544A\u8BC9\u4E86\u4F60\uFF0C\u53EF\u80FD\u4F1A\u4EA7\u751F\u5F88\u4E25\u91CD\u7684\u62A5\u5E94\u554A\u3002",
    "Mon4": "\u5728\u8FDC\u79BB\u4EBA\u7C7B\u6587\u660E\u7684\u5730\u65B9\uFF0C\u5927\u81EA\u7136\u624D\u4F1A\u5C55\u73B0\u5176\u5965\u79D8\u3002",
    "Mon8": "\u4E16\u754C\u4E0A\u8FD8\u6709\u4E9B\u5730\u65B9\u5C1A\u672A\u53D7\u5230\u73B0\u4EE3\u601D\u7EF4\u7684\u684E\u688F\uFF0C\u9B54\u6CD5\u5728\u90A3\u91CC\u6B23\u6B23\u5411\u8363\u2026\u2026",
    "MovieInvitation": "\u5514\u2026\u2026\u6211\u60F3\u6211\u5E94\u8BE5\u80FD\u4E0E\u4F60\u4F5C\u4F34\u2026\u2026\u884C\u3002\u7B49\u4F60\u5230\u4E86\uFF0C\u6211\u4FBF\u4F1A\u73B0\u8EAB\u3002\u518D\u4F1A\u3002",
    "Sat": "\u5C0F\u5FC3\u554A\uFF0C\u4F60\u73B0\u5728\u7AD9\u7684\u5730\u65B9\u62E5\u6709\u6D53\u539A\u7684\u9B54\u529B\u3002#$e#\u6211\u628A\u6211\u7684\u5C4B\u5B50\u5EFA\u5728\u8FD9\u91CC\u53EF\u662F\u6709\u539F\u56E0\u7684\u3002",
    "Sat2": "\u4F60\u548C\u68EE\u6797\u91CC\u7684\u7CBE\u7075\u53D6\u5F97\u4EC0\u4E48\u8FDB\u5C55\u4E86\u5417\uFF1F",
    "Sat6": "\u867D\u7136\u79D1\u5B66\u5B9E\u8DF5\u53EF\u4EE5\u7CBE\u786E\u523B\u753B\u4E16\u754C\u4E0A\u7684\u7269\u8D28\uFF0C\u4F46\u662F\u5B83\u6C38\u8FDC\u65E0\u6CD5\u89E3\u91CA\u6700\u6DF1\u5C42\u7684\u5965\u79D8\u2026\u2026",
    "Sun": "\u6709\u65F6\u6211\u4F1A\u5077\u5077\u89C2\u5BDF\u6751\u6C11\u4EEC\u3002#$e#\u6211\u60F3\u627E\u4E00\u4E2A\u4EBA\u6765\u5F53\u6211\u7684\u5B66\u5F92\u3002\u7EC8\u6709\u4E00\u5929\u6211\u4F1A\u79BB\u5F00\u8FD9\u5177\u8EAF\u58F3\uFF0C\u4F46\u6211\u5BF9\u4E8E\u5965\u672F\u7684\u7814\u7A76\u4E00\u5B9A\u8981\u4F20\u627F\u4E0B\u53BB\u3002",
    "Thu": "\u6211\u4EEC\u5468\u906D\u6709\u65E0\u6570\u795E\u79D8\u7684\u5B58\u5728\u3002\u60F3\u8981\u53D1\u73B0\u5B83\u4EEC\u5C31\u5FC5\u987B\u8981\u6709\u8DB3\u591F\u7684\u8010\u5FC3\u2026\u2026",
    "Thu10": "\u4E0D\u8981\u544A\u8BC9\u522B\u4EBA\u2026\u2026\u4F46\u6211\u53D1\u73B0\uFF0C\u672C\u5730\u5C45\u6C11\u4E2D\u4F3C\u4E4E\u6709\u4E2A\u4EBA\u662F\u6211\u7684\u5973\u513F\u2026\u2026#$e#\u4E5F\u8BB8\u662F\u6211\u641E\u9519\u4E86\u2026\u2026\u867D\u8BF4\u8FD9\u4E0D\u5BFB\u5E38\uFF0C\u5374\u4E5F\u4E0D\u662F\u5168\u65E0\u53EF\u80FD\u3002",
    "Tue": "\u5982\u679C\u6CA1\u6709\u91CD\u8981\u7684\u4E8B\uFF0C\u8BF7\u4E0D\u8981\u6253\u6405\u6211\u3002\u6211\u8FD8\u6709\u597D\u591A\u6D3B\u8981\u5E72\u5462\u3002",
    "Tue10": "\u5047\u5982\u73B0\u5B9E\u662F\u7531\u610F\u8BC6\u4EA7\u751F\u7684\uFF0C\u90A3\u4E48\u4E00\u4E2A\u4EBA\u82E5\u662F\u638C\u63E1\u4E86\u7CBE\u795E\u7684\u529B\u91CF\uFF0C\u5C31\u53EF\u4EE5\u652F\u914D\u73B0\u5B9E\u2026\u2026",
    "Tue4": "\u6211\u5BF9\u4F60\u7684\u4FE1\u4EFB\u8DB3\u591F\u6211\u653E\u4F60\u8FDB\u5730\u4E0B\u5BA4\u4E86\u3002\u4E0D\u8FC7\u4F60\u5728\u4E0B\u9762\u53EF\u4E0D\u8981\u4E71\u52A8\u4E1C\u897F\u3002",
    "Tue8": "@\uFF0C\u4F60\u597D\u3002\u6211\u76F8\u4FE1\u4F60\u8FD8\u6CA1\u6709\u6D89\u8DB3\u9ED1\u9B54\u6CD5\u5427\uFF1F",
    "Wed": "\u8981\u7814\u7A76\u8BB8\u591A\u5E74\u624D\u80FD\u7406\u89E3\u5143\u7D20\u7684\u8BED\u8A00\u3002#$e#\u8981\u60F3\u7528\u4ED6\u4EEC\u7684\u8BED\u8A00\u8BB2\u8BDD\u5219\u9700\u8981\u8BA4\u771F\u7814\u7A76\u4E00\u8F88\u5B50\u624D\u884C\u3002#$e#\u90A3\u4E48\uFF0C\u62B1\u6B49\uFF0C\u6211\u8981\u5F00\u5DE5\u4E86\u2026\u2026",
    "accept_868": "\u554A\u2026\u2026\u662F\u6781\u5BD2\u788E\u7247\u3002#$b#\u786E\u5B9E\uFF0C\u8FD9\u662F\u6700\u4E3A\u5F3A\u5927\u7684\u4E00\u79CD\u7269\u8D28\uFF0C\u542B\u6709\u5F3A\u529B\u7684\u51B0\u5143\u7D20\u3002#$b#\u5982\u679C\u4F60\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\u6211\u5C31\u6536\u4E0B\u4E86\u3002#$b#\u2026\u2026#$b#\u2026\u2026\u5443\u2026\u2026\u4F60\u8FD8\u6CA1\u8D70\u554A\u3002\u54E6\u3002\u4F60\u662F\u60F3\u8981\u70B9\u4EC0\u4E48\u5417\uFF1F#$b#\u2026\u2026\u7ED9\u4F60\u8FD9\u4E2A\u3002",
    "married": "\u5514\u2026\u2026\u7ED3\u5A5A\uFF1F\u6211\u7948\u7977\u4F60\u8FD0\u6C14\u4F1A\u6BD4\u6211\u5F53\u521D\u597D\u5427\u2026\u2026",
    "roommates_Krobus": "\u548C\u79D1\u7F57\u5E03\u65AF\u8FD9\u7C7B\u751F\u7269\u4E00\u8D77\u751F\u6D3B\u662F\u4E00\u79CD\u8003\u9A8C\uFF0C\u4E0D\u8FC7\u80AF\u5B9A\u5BF9\u53CC\u65B9\u90FD\u5F88\u6709\u4EF7\u503C\u3002#$e#\u8FD9\u79CD\u4E0D\u5BFB\u5E38\u7684\u53CB\u8C0A\u6700\u7EC8\u7ED3\u679C\u4F1A\u5982\u4F55\uFF0C\u6211\u627F\u8BA4\u6211\u5F88\u611F\u5174\u8DA3\u3002"
  }
}