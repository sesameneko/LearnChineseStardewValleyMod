    "AcceptGift_(O)928": "\u563B\u563B\u2026\u2026\u591A\u9001\u6211\u70B9\u8FD9\u4E2A\uFF0C\u6211\u4E09\u5341\u5C81\u5C31\u80FD\u9000\u4F11\u4E86\uFF01$h",
