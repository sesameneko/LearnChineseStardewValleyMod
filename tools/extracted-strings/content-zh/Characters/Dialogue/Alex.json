    "summer_Tue": "\u8981\u662F\u6211\u7684\u53D1\u578B\u4E0D\u53D7\u5973\u5B69\u5B50\u6B22\u8FCE\uFF0C\u6211\u80AF\u5B9A\u4F1A\u9A6C\u4E0A\u628A\u5B83\u5243\u6389\u3002#$e#*\u5509* \u2026\u2026\u751F\u6D3B\u8270\u8F9B\u554A\u3002",
    "summer_Wed": "\u563F\uFF0C\u519C\u5BB6\u5C0F\u4F19\u513F\uFF0C\u6211\u6709\u4E2A\u95EE\u9898\u60F3\u95EE\u4F60\u3002^\u563F\uFF0C\u519C\u5BB6\u5973\u5B69\u513F\uFF0C\u6211\u6709\u4E2A\u95EE\u9898\u60F3\u95EE\u4F60\u3002#$b#$q 52/53 summer_Wed_01_old#\u4F60\u89C9\u5F97\u6211\u80FD\u6210\u4E3A\u804C\u4E1A\u9009\u624B\u5417\uFF1F#$r 52 30 summer_Wed_01_01#\u4F60\u4E00\u5B9A\u4F1A\u6210\u4E3A\u8FD0\u52A8\u573A\u4E0A\u7684\u4F20\u5947#$r 52 0 summer_Wed_01_02#\u53EF\u80FD\u5427\uFF0C\u4F60\u6BD5\u7ADF\u7EC3\u4E60\u4E86\u90A3\u4E48\u4E45#$r 53 -50 summer_Wed_01_03#\u522B\u505A\u68A6\u4E86\uFF0C\u4F60\u8FD8\u662F\u8001\u8001\u5B9E\u5B9E\u53BB\u505A\u63A8\u9500\u5458\u5427",
    "summer_Wed8": "\u6211\u5176\u5B9E\u4E0D\u4ECB\u610F\u5F53\u519C\u6C11\u2026\u2026\u4ECE\u67D0\u79CD\u610F\u4E49\u4E0A\u6765\u8BF4\uFF0C\u8FD9\u548C\u5F53\u8FD0\u52A8\u5458\u662F\u4E00\u56DE\u4E8B\u3002#$e#\u6211\u559C\u6B22\u5728\u6237\u5916\u7528\u81EA\u5DF1\u7684\u53CC\u624B\u505A\u4E9B\u4E8B\u60C5\u3002",
    "summer_Wed_01_01": "\u563F\uFF0C\u6211\u5C31\u662F\u8FD9\u4E2A\u610F\u601D\uFF01$h#$e#\u4F60\u6BD4\u6211\u60F3\u8C61\u7684\u8FD8\u8981\u9177\u3002",
    "summer_Wed_01_02": "\u5BF9\uFF0C\u6211\u8FD9\u4E48\u68D2\uFF0C\u6839\u672C\u4E0D\u9700\u8981\u7EC3\u4E60\u90A3\u4E48\u4E45\u3002$u",
    "summer_Wed_01_03": "\u4F60\u6709\u6BDB\u75C5\u5427\u3002\u4F60\u5C31\u662F\u770B\u6211\u6BD4\u4F60\u6709\u5929\u8D4B\uFF0C\u6BD4\u4F60\u53D7\u6B22\u8FCE\uFF0C\u6240\u4EE5\u773C\u7EA2\u4E86\u3002$a^\u600E\u4E48\u53EF\u80FD\u3002\u4F60\u5C31\u662F\u770B\u6211\u6BD4\u4F60\u53D7\u6B22\u8FCE\u5F97\u591A\uFF0C\u6240\u4EE5\u5AC9\u5992\u4E86\uFF0C\u4F60\u4E2A\u795E\u7ECF\u75C5\u3002$a#$e#\u79BB\u6211\u8FDC\u70B9\u513F\u3002$a",
    "summer_Wed_01_old": "$p 52#\u563F\uFF0C\u7B49\u6211\u6210\u4E86\u804C\u4E1A\u9009\u624B\uFF0C\u4F60\u5C31\u53EF\u4EE5\u8DDF\u4EBA\u8BF4\uFF0C\u4F60\u662F\u6211\u7684\u7B2C\u4E00\u4F4D\u201C\u7C89\u4E1D\u201D\u3002\u662F\u4E0D\u662F\u633A\u9177\u554A\uFF1F|\u563F\uFF0C\u6211\u5DF2\u7ECF\u5728\u52A0\u500D\u7EC3\u4E60\u4E86\uFF0C\u6240\u4EE5\u6211\u4E00\u5B9A\u4F1A\u8FDB\u5165\u804C\u4E1A\u961F\uFF0C\u7136\u540E\u8BC1\u660E\u4F60\u9519\u4E86\u3002\u4F60\u5C31\u7B49\u7740\u77A7\u5427\u3002$a",
    "winter_1": "\u51AC\u5929\u592A\u65E0\u804A\u4E86\u3002\u7ECF\u5E38\u4E0B\u96EA\uFF0C\u627E\u4E0D\u5230\u6709\u8DA3\u7684\u4E8B\u60C5\u3002#$e#\u6211\u731C\u6709\u4EBA\u559C\u6B22\u51AC\u5929\u3002",
    "winter_Fri": "\u4F60\u5C45\u7136\u5192\u7740\u98CE\u96EA\u4E13\u7A0B\u6765\u770B\u6211\uFF1F#$e#\u55EF\uFF0C\u633A\u5408\u60C5\u5408\u7406\u7684\u3002",
    "winter_Fri4": "\u4F60\u5C45\u7136\u5192\u7740\u98CE\u96EA\u4E13\u7A0B\u6765\u770B\u6211\uFF1F#$e#\u4F60\u8FD9\u4EBA\u5B9E\u5728\u662F\u592A\u597D\u4E86\u3002$h",
    "winter_Mon": "\u4F60\u559C\u6B22\u4E0B\u96EA\u5417\uFF1F\u6211\u2026\u2026\u6211\u4E00\u5FC3\u53EA\u671F\u76FC\u7740\u6625\u5929\u3002",
    "winter_Sat": "\u9547\u5B50\u91CC\u4F4F\u4E86\u4E00\u4E9B\u602A\u4EBA\u3002#$e#\u2026\u2026\u5C31\u50CF\u585E\u5DF4\u65AF\u8482\u5B89\u3002\u4E3A\u4EC0\u4E48\u4ED6\u603B\u662F\u7A7F\u9ED1\u8272\u7684\u8863\u670D\uFF1F#$e#\u771F\u662F\u641E\u4E0D\u61C2\u3002",
    "winter_Sat6": "\u6709\u4E9B\u4E0E\u6211\u4EEC\u622A\u7136\u4E0D\u540C\u7684\u4EBA\u5B58\u5728\uFF0C\u8FD9\u4E0D\u633A\u597D\u73A9\u513F\u7684\u5417\uFF1F#$b#\u6211\u641E\u4E0D\u61C2\u4ED6\u4EEC\u4E3A\u4EC0\u4E48\u4F1A\u90A3\u6837\uFF0C\u4F46\u6211\u5E76\u4E0D\u4ECB\u610F\u3002",
    "winter_Sun": "\u563F\uFF0C\u683C\u7403\u6BD4\u8D5B\u5C31\u5728\u4ECA\u5929\uFF01#$e#\u8FD9\u53EF\u80FD\u662F\u4E00\u5468\u91CC\u9762\u6211\u6700\u559C\u6B22\u7684\u4E00\u5929\u3002",
    "winter_Thu": "\u7B49\u6211\u6210\u4E3A\u804C\u4E1A\u9009\u624B\uFF0C\u6323\u4E86\u94B1\uFF0C\u5C31\u8981\u5728\u70ED\u5E26\u4E70\u4E2A\u5EA6\u5047\u522B\u5885\u3002#$e#\u7136\u540E\u5C31\u4E0D\u7528\u518D\u8FC7\u8FD9\u79CD\u65E0\u804A\u7684\u51AC\u5929\u4E86\u3002",
    "winter_Thu10": "\u8981\u662F\u6211\u80FD\u6323\u5230\u5927\u94B1\uFF0C\u4E00\u5B9A\u4F1A\u8BA9\u6211\u7684\u4EB2\u670B\u597D\u53CB\u8FC7\u4E0A\u597D\u65E5\u5B50\u3002#$e#\u4E5F\u5305\u62EC\u4F60\u5728\u5185\u3002$h",
    "winter_Thu6": "\u771F\u5E0C\u671B\u6211\u80FD\u63A7\u5236\u5929\u6C14\u3002",
    "winter_Tue": "\u563F\uFF0C\u4F60\u80FD\u4E0D\u80FD\u4EE3\u6211\u53BB\u8DDF\u6D77\u8389\u95EE\u4E2A\u597D\uFF1F",
    "winter_Tue4": "\u563F\uFF0C@\u3002\u4F60\u80FD\u5E2E\u6211\u4E2A\u5FD9\u5417\uFF1F$l#$b#\u8981\u662F\u4F60\u89C1\u5230\u4E86\u6D77\u8389\uFF0C\u544A\u8BC9\u5979\u6211\u6B63\u5FD9\u7740\u5462\u3002$l#$e#\u8C22\u8C22\u4F60\u3002",
    "winter_Tue4_inlaw_Haley": "\u6211\u627F\u8BA4\u2026\u2026\u4F60\u548C\u6D77\u8389\u7ED3\u5A5A\u7684\u65F6\u5019\u6211\u6709\u70B9\u513F\u5AC9\u5992\u3002\u4F46\u662F\uFF0C\u54CE\u2026\u2026\u8FD9\u4E5F\u662F\u4E00\u4E2A\u6211\u91CD\u65B0\u4E86\u89E3\u81EA\u5DF1\u7684\u673A\u4F1A\u3002$9",
    "winter_Tue_inlaw_Haley": "\u54E6\uFF0C\u563F\u3002\u5A5A\u540E\u751F\u6D3B\u600E\u4E48\u6837\uFF1F$9",
    "winter_Wed": "\u51AC\u5929\uFF0C\u4EBA\u4EEC\u90FD\u4F1A\u5F85\u5728\u5BB6\u91CC\uFF0C\u505A\u4E9B\u65E0\u804A\u7684\u7410\u4E8B\u3002$s#$e#\u6216\u8BB8\u770B\u770B\u4E66\u5C31\u4E0D\u4F1A\u90A3\u4E48\u65E0\u804A\u2026\u2026\u624D\u602A\u3002",
    "winter_Wed8": "\u4F60\u77E5\u9053\u5417\uFF1F\u6211\u8981\u5F00\u59CB\u8BFB\u4E66\u4E86\uFF01"
  }
