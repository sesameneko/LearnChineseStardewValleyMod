    "AcceptGift_Positive_category_egg": "$c 0.8#\u54E6\uFF01\u8C22\u8C22\u4F60\uFF0C\u86CB\u767D\u8D28\u53EF\u662F\u589E\u808C\u5229\u5668\u3002#\uFF08\u6572\u5F00\uFF09\uFF08\u5438\u6E9C\uFF09\u2026\u2026\u55EF\uFF0C\u8FD9\u624D\u591F\u610F\u601D\u561B\u3002",
    "Event_beach1": "\u90A3\u662F\u5F53\u7136\u7684\u4E86\u3002\u4E0D\u7136\u6211\u4F1A\u4EE5\u4E3A\u4F60\u75AF\u4E86\u3002\u8981\u4E0D\u7136\u5C31\u662F\u50BB\u4E86\u3002",
    "Event_beach2": "\u771F\u7684\uFF1F\u4F60\u8FD8\u771F\u662F\u4E2A\u5947\u602A\u7684\u5BB6\u4F19\u554A\u3002$a#$b#\u62B1\u6B49\u3002",
