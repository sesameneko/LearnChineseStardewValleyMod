    "FlowerDance_Accept": "\u4F60\u600E\u4E48\u5148\u8BF4\u4E86\uFF01\u6211\u521A\u60F3\u95EE\u4F60\u2026\u2026$h#$e#\u54B1\u4EEC\u5230\u65F6\u5019\u89C1\u3002",
    "FlowerDance_Accept_Spouse": "\u597D\u5427\uFF0C\u8FD9\u5E94\u8BE5\u4F1A\u5F88\u6709\u8DA3\u2026\u2026\u5E0C\u671B\u4ECA\u5E74\u6211\u80FD\u8BB0\u4F4F\u821E\u6B65\uFF01\u6709\u597D\u957F\u65F6\u95F4\u6CA1\u8DF3\u821E\u4E86\u2026\u2026$h",
    "FlowerDance_Decline": "\u7B97\u4E86\u2026\u2026\u6211\u53BB\u627E\u522B\u4EBA\u95EE\u95EE\u3002\u795D\u4F60\u597D\u8FD0\u3002",
    "Fri": "\u563F\uFF0C\u600E\u4E48\u5566\uFF0C\u519C\u5BB6\u5C0F\u4F19\u513F\uFF1F^\u563F\uFF0C\u539F\u6765\u662F\u519C\u5BB6\u59D1\u5A18\u554A\u3002\u4F60\u7A7F\u4E86\u65B0\u88E4\u5B50\u5417\uFF1F\u8FD9\u5C31\u5BF9\u4E86\u3002#$e#\u54E6\uFF0C\u5DEE\u70B9\u5FD8\u4E86\u3002\u4ECA\u5929\u662F\u6211\u505A\u4FEF\u5367\u6491\u7684\u65E5\u5B50\uFF01#$e#\u6BCF\u6B21\u6211\u505A\u4FEF\u5367\u6491\uFF0C\u90FD\u4F1A\u8BD5\u7740\u6BD4\u4E0A\u6B21\u591A\u505A\u51E0\u4E2A\u3002\u8FD9\u79CD\u953B\u70BC\u65B9\u6CD5\u633A\u68D2\u7684\u5427\uFF1F",
    "Fri4": "\u563F\uFF0C@\u3002\u5F88\u9AD8\u5174\u4F60\u80FD\u6765\u3002#$e#\u6211\u6562\u5149\u660E\u6B63\u5927\u5730\u8BF4\u6211\u7231\u6211\u5976\u5976\uFF01#$e#\u81F3\u4E8E\u6211\u7237\u7237\u561B\u2026\u2026#$e#\u8BF4\u7B11\u5462\u3002$h",
    "Fri8": "\u55E8\uFF0C@\u3002\u4F60\u4ECA\u5929\u633A\u6709\u8FD0\u52A8\u6C14\u606F\u7684\u561B\u3002$h^\u563F\uFF0C@\u3002\u4F60\u6362\u4E86\u53D1\u578B\u5417\uFF1F\u6211\u611F\u89C9\u773C\u524D\u4E00\u4EAE\u5462\u3002$h",
    "GreenRain": "\u5916\u9762\u548B\u4E86\uFF1F\u8981\u505A\u4EC0\u4E48\u5417\uFF1F#$e#\u6211\u5C31\u8DDF\u5916\u516C\u5916\u5A46\u5F85\u5728\u8FD9\u91CC\u2026\u2026$s",
    "GreenRain_2": "\u6211\u65E9\u4E0A\u60F3\u53BB\u6668\u8DD1\uFF0C\u53EF\u662F\u690D\u7269\u957F\u75AF\u4E86\uFF01\u6240\u4EE5\u5C31\u6CA1\u8DD1\u591A\u8FDC\u2026\u2026",
    "Introduction": "\u54E6\uFF0C\u563F\u3002\u4F60\u5C31\u662F\u90A3\u4E2A\u65B0\u6765\u7684\u5427\uFF1F\u4E0D\u9519\u4E0D\u9519\u3002^\u563F\uFF0C\u4F60\u5C31\u662F\u65B0\u6765\u7684\u90A3\u4E2A\u59D1\u5A18\uFF0C\u662F\u4E0D\u662F\uFF1F\u6211\u4EEC\u4E00\u5B9A\u4F1A\u76F8\u5904\u5F97\u5F88\u6109\u5FEB\u7684\u3002\u6211\u662F\u4E9A\u529B\u514B\u65AF\u3002#$e#\u56DE\u89C1\u3002",
    "Mon": "\u4F60\u77E5\u9053\u5417\uFF1F\u6211\u4E0A\u9AD8\u4E2D\u7684\u65F6\u5019\u53EF\u662F\u5168\u660E\u661F\u56DB\u5206\u536B\u54E6\u3002\u771F\u7684\u3002$u#$e#\u770B\u5230\u6211\u5939\u514B\u4E0A\u8FD9\u9897\u5C0F\u661F\u661F\u4E86\u5417\uFF1F\u8FD9\u5C31\u662F\u8BC1\u660E\u3002",
    "Mon8": "\u6211\u66FE\u7ECF\u60F3\u8981\u8FFD\u9010\u540D\u5229\uFF0C\u4F46\u6700\u8FD1\uFF0C\u6211\u7684\u60F3\u6CD5\u53D1\u751F\u4E86\u6539\u53D8\u3002\u5230\u4E86\u6700\u540E\uFF0C\u771F\u6B63\u80FD\u8BA9\u4EBA\u6EE1\u8DB3\u7684\u5176\u5B9E\u5C31\u662F\u4E00\u4E9B\u5FAE\u4E0D\u8DB3\u9053\u7684\u5C0F\u4E8B\uFF0C\u4F60\u8BF4\u662F\u4E0D\u662F\uFF1F#$e#\u6211\u4ECD\u7136\u60F3\u5F53\u804C\u4E1A\u9009\u624B\uFF0C\u4F46\u90A3\u5DF2\u7ECF\u4E0D\u662F\u8FD9\u4E2A\u4E16\u754C\u4E0A\u6700\u91CD\u8981\u7684\u4E8B\u60C5\u4E86\u3002",
    "Resort": "\u554A\u2026\u2026\u6211\u4F1A\u4E60\u60EF\u5C9B\u5C7F\u4E0A\u7684\u751F\u6D3B\u7684\uFF01",
    "Resort_Bar": "\u6211\u70B9\u4E86\u4E00\u4EFD\u9999\u8549\u5976\u6614\u52A0\u4E24\u52FA\u86CB\u767D\u7C89\u3002",
    "Resort_Chair": "\u4F60\u7A7F\u90A3\u5957\u8863\u670D\u4E0D\u70ED\u5417\uFF1F\u522B\u5427\u5144\u5F1F\u2026\u2026\u8FD9\u53EF\u662F\u5728\u6D77\u6EE9\u4E0A\uFF01^\u4F60\u7A7F\u90A3\u5957\u8863\u670D\u4E0D\u70ED\u5417\uFF1F\u4F60\u5F97\u611F\u53D7\u4E0B\u6D77\u98CE\u5439\u62C2\u7684\u611F\u89C9\uFF01",
    "Resort_Entering": "\u603B\u7B97\u5230\u4E86\uFF01",
    "Resort_Leaving": "\u554A\u2026\u2026\u5FEB\u4E50\u7684\u65F6\u5149\u603B\u662F\u8FD9\u4E48\u77ED\u6682\u3002$s",
    "Resort_Shore": "\u4E0D\u77E5\u9053\u4E00\u4E2A\u6765\u56DE\u6211\u80FD\u6E38\u591A\u8FDC\uFF1F#$e#\u6211\u731C\u600E\u4E48\u7740\u4E5F\u5F97\u6709\u4E2A\u4E00\u82F1\u91CC\u3002#$b#\u2026\u2026\u522B\u62C5\u5FC3\uFF0C\u6211\u4E0D\u4F1A\u771F\u53BB\u8BD5\u7684\u3002$h",
    "Resort_Towel": "\u73B0\u5728\u5C9B\u5C7F\u5F00\u653E\u4E86\uFF0C\u53EF\u5C31\u6CA1\u6709\u501F\u53E3\u7EE7\u7EED\u5B85\u5728\u5BB6\u91CC\u4E86\uFF01",
    "Resort_Towel_2": "\u54CE\u5440\uFF0C\u603B\u7B97\u8BA9\u8FD9\u4E9B\u8179\u808C\u51FA\u6765\u89C1\u89C1\u592A\u9633\u4E86\u3002#$e#\u56DE\u5BB6\u540E\u4E00\u76F4\u628A\u5B83\u4EEC\u85CF\u8D77\u6765\u6709\u70B9\u53EF\u60DC\u3002",
    "Resort_Towel_3": "\u7B49\u6211\u6210\u4E3A\u804C\u4E1A\u9009\u624B\uFF0C\u6211\u8981\u53BB\u4E16\u754C\u5404\u5730\u7684\u5C9B\u5C7F\u4E0A\u5EA6\u5047\u3002#$e#\u4E0D\u8FC7\u76EE\u524D\u5C31\u5728\u8FD9\u4E2A\u5730\u65B9\u8FC7\u8FC7\u763E\u5427\uFF01$h",
    "Resort_Wander": "\u597D\u5427\uFF0C\u65E9\u77E5\u9053\u5E94\u8BE5\u5E26\u4E2A\u98DE\u76D8\u6765\u7684\u2026\u2026$h",
    "Resort_Wander_2": "\u6709\u4EBA\u6765\u6392\u7403\u6BD4\u8D5B\u5417\uFF1F#$e#\u522B\u62C5\u5FC3\uFF0C\u6211\u4F1A\u653E\u6C34\u7684\uFF01$h",
    "Sat": "\u6211\u7684\u80F3\u818A\u597D\u9178\u554A\uFF0C\u4F46\u5BF9\u6211\u8FD9\u6837\u7684\u4EBA\u6765\u8BF4\uFF0C\u8FD9\u6B63\u662F\u53D6\u5F97\u8FDB\u6B65\u7684\u6807\u5FD7\u3002#$e#\u6211\u6628\u5929\u80AF\u5B9A\u505A\u4E86\u4E00\u5343\u4E2A\u4FEF\u5367\u6491\u3002",
    "Sat10": "\u6211\u6700\u8FD1\u5F88\u96BE\u96C6\u4E2D\u6CE8\u610F\u529B\u3002$l",
    "Sun": "\u563F\u3002#$e#\u600E\u4E48\uFF0C\u6709\u8BDD\u8981\u548C\u6211\u8BF4\u5417\uFF1F\u6211\u8FD9\u4F1A\u513F\u6B63\u5FD9\u7740\u5462\u3002",
    "Sun2": "\u563F\uFF0C@\u3002#$e#\u5BF9\uFF0C\u6211\u8BB0\u5F97\u4F60\u7684\u540D\u5B57\u3002",
    "Sun4": "\u563F\uFF0C@\u3002#$e#\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F",
    "Thu": "\u5929\u6C14\u70ED\u8D77\u6765\u4E86\u2026\u2026\u6211\u611F\u89C9\u6709\u4E9B\u5598\u4E0D\u8FC7\u6C14\u3002",
    "Tue": "\u6D77\u6EE9\u662F\u4E2A\u503C\u5F97\u4E00\u73A9\u7684\u597D\u5730\u65B9\uFF0C\u5728\u90A3\u91CC\u8FD8\u80FD\u505A\u4E2A\u65E5\u5149\u6D74\u3002#$e#\u4F60\u5F97\u65F6\u5E38\u6652\u6652\u592A\u9633\uFF0C\u8981\u4E0D\u7136\u80A4\u8272\u5C31\u4F1A\u53D8\u5F97\u82CD\u767D\u3002#$e#*\u5509* \u2026\u2026\u771F\u5E0C\u671B\u9547\u4E0A\u80FD\u591A\u4E9B\u5973\u5B69\u5B50\uFF0C\u4F60\u660E\u767D\u6211\u7684\u610F\u601D\u5427\uFF1F$s^\u563F\uFF0C\u6709\u7A7A\u8DDF\u6211\u53BB\u6D77\u6EE9\u73A9\u73A9\u554A\uFF1F\u4F60\u6709\u6BD4\u57FA\u5C3C\u6CF3\u8863\u5417\uFF1F",
    "Tue6": "\u548C\u670B\u53CB\u4EEC\u5728\u6D77\u6EE9\u4E0A\u5EA6\u8FC7\u6109\u5FEB\u7684\u4E00\u5929\uFF0C\u6CA1\u6709\u80FD\u6BD4\u8FD9\u7F8E\u7684\u4E8B\u60C5\u4E86\u2026\u2026\u6211\u8BF4\u7684\u6CA1\u9519\u5427\uFF1F",
