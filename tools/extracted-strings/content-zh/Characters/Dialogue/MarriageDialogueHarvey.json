  "entries": {
    "Good_0": "@\u2026\u2026\u6211\u8FD8\u662F\u4E0D\u6562\u76F8\u4FE1\u6211\u4EEC\u7ED3\u5A5A\u4E86\u2026\u2026$l",
    "Good_1": "\u4F60\u628A\u6211\u4ECE\u5B64\u72EC\u7684\u751F\u6D3B\u4E2D\u62EF\u6551\u51FA\u6765\uFF0C\u586B\u8865\u4E86\u6211\u5FC3\u91CC\u7684\u7A7A\u7F3A\u3002\u8C22\u8C22\u4F60\u3002$l",
    "Good_2": "\u81EA\u4ECE\u4F60\u642C\u5230\u8FD9\u91CC\uFF0C\u6211\u5C31\u77E5\u9053\u4F60\u662F\u6211\u7684\u547D\u4E2D\u6CE8\u5B9A\u2026\u2026$l",
    "Good_3": "\u54C7\u54E6\uFF0C\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5E05\u5446\u4E86\uFF01\u4F60\u522E\u80E1\u5B50\u4E86\u5417\uFF1F$l^\u54C7\u54E6\u2026\u2026\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u7F8E\u6781\u4E86\u3002$l",
    "Good_6": "\u51FA\u53BB\u8981\u5C0F\u5FC3\u554A\uFF01\u6211\u505A\u4E86\u5669\u68A6\uFF0C\u68A6\u5230\u4F60\u67D4\u5F31\u7684\u8EAB\u4F53\u88AB\u63A8\u8FDB\u6025\u8BCA\u5BA4\u3002$7",
    "Indoor_Day_0": "\u6211\u60F3\u6211\u4EEC\u90FD\u5728\u52AA\u529B\u8FBE\u5230\u751F\u6D3B\u7684\u67D0\u79CD\u5E73\u8861\u3002\u4E00\u79CD\u590D\u6742\u7684\u5E73\u8861\u3002#$e#\u5BF9\u6211\u6765\u8BF4\uFF0C\u642C\u5230\u8FD9\u91CC\u6B63\u9002\u5408\u6211\u627E\u5230\u90A3\u79CD\u5E73\u8861\u3002$l",
    "Indoor_Day_1": "\u65E9\u4E0A\u597D\u554A\uFF0C@\uFF01\u6211\u7ED9\u4F60\u505A\u4E86\u8425\u517B\u65E9\u9910\uFF01[201]#$e#\u9E21\u86CB\u662F\u5F88\u597D\u7684\u86CB\u767D\u8D28\u6765\u6E90\uFF0C\u90FD\u5403\u6389\u5427\u3002",
    "Indoor_Day_2": "\u4ECA\u5929\u6211\u8981\u7814\u7A76\u533B\u5B66\u6587\u732E\u3002\u5BF9\u6211\u6765\u8BF4\u8DDF\u4E0A\u6700\u65B0\u8D8B\u52BF\u5F88\u91CD\u8981\uFF0C\u8FD9\u6837\u6211\u624D\u80FD\u4E3A\u6211\u7684\u60A3\u8005\u63D0\u4F9B\u6700\u597D\u7684\u62A4\u7406\uFF01",
    "Indoor_Day_3": "\u4ECA\u5929\u6211\u8981\u542C\u7235\u58EB\u4E50\uFF0C\u5E76\u5B8C\u6210\u6211\u7684\u533B\u7597\u62A5\u544A\u3002\u4F60\u6709\u4EC0\u4E48\u8BA1\u5212\uFF1F",
    "Indoor_Day_4": "\u6211\u4EEC\u7B2C\u4E00\u6B21\u89C1\u9762\u7684\u65F6\u5019\u6211\u6709\u70B9\u6015\u4F60\u3002\u73B0\u5728\u60F3\u60F3\u6211\u4EEC\u5C45\u7136\u8D70\u5230\u4E86\u4ECA\u5929\uFF0C\u8FD8\u771F\u6709\u8DA3\u3002$h",
    "Indoor_Night_0": "\u4EB2\u7231\u7684\uFF0C\u4F60\u770B\u8D77\u6765\u7CBE\u75B2\u529B\u5C3D\u3002\u8BA9\u6211\u4ECA\u665A\u7ED9\u4F60\u6309\u6469\u5427\u3002\u6211\u4FDD\u8BC1\u8FD9\u4F1A\u51CF\u8F7B\u4F60\u808C\u8089\u7EC4\u7EC7\u7684\u708E\u75C7\uFF01$l",
    "Indoor_Night_1": "\u6211\u4ECA\u5929\u5F88\u653E\u677E\u2026\u2026\u770B\u4E86\u4F1A\u513F\u4E66\u3001\u542C\u4E86\u4F1A\u513F\u6536\u97F3\u673A\uFF0C\u5E76\u73A9\u4E86\u4F1A\u513F\u98DE\u673A\u6A21\u578B\u3002#$e#\u4E0D\u65F6\u4F11\u606F\u653E\u677E\u4E00\u4E0B\u5F88\u91CD\u8981\u2026\u2026\u538B\u529B\u6709\u5BB3\u5065\u5EB7\u3002",
    "Indoor_Night_2": "\u665A\u4E0A\u597D\u2026\u2026\u4F60\u5B8C\u6210\u4E86\u4ECA\u5929\u8981\u505A\u7684\u4E8B\u60C5\u4E86\u5417\uFF1F#$e#\u4E0D\u8981\u62C5\u5FC3\u6211\u3002\u6211\u5F88\u72EC\u7ACB\u3002\u5982\u679C\u4F60\u6709\u66F4\u591A\u4E8B\u60C5\u8981\u505A\uFF0C\u90A3\u5C31\u8BF7\u4FBF\u5427\u3002",
    "Indoor_Night_3": "\u5F53\u533B\u751F\u5F88\u6709\u538B\u529B\uFF0C\u6240\u4EE5\u4F4F\u5728\u50CF%farm\u519C\u573A\u4E00\u6837\u653E\u677E\u7684\u5730\u65B9\u771F\u662F\u592A\u68D2\u4E86\u3002",
    "Indoor_Night_4": "\u5662\uFF01\u6211\u53EA\u662F\u5728\u601D\u8003\u7740\u5FAA\u73AF\u7CFB\u7EDF\uFF0C\u800C\u5FD8\u4E86\u6211\u8981\u53BB\u505A\u4EC0\u4E48\u3002\u8FD9\u662F\u533B\u751F\u5178\u578B\u7684\u95EE\u9898\u3002",
    "OneKid_0": "\u4F60\u548C%kid1\u662F\u6211\u751F\u547D\u4E2D\u6700\u91CD\u8981\u7684\u90E8\u5206\u3002",
    "OneKid_1": "\u5C0F%kid1\u5C06\u5728\u8FD9\u91CC\u5EA6\u8FC7\u5FEB\u4E50\u7684\u7AE5\u5E74\u3002\u6211\u4EEC\u6709\u8FD9\u4E2A\u673A\u4F1A\u771F\u5E78\u8FD0\u3002",
    "OneKid_3": "\u6211\u771F\u559C\u6B22\u5F53\u7236\u4EB2\u7684\u611F\u89C9\uFF01$h",
    "Outdoor_0": "\u8FD9\u662F\u4E2A\u5F88\u5B89\u5168\u7684\u5730\u70B9\u3002\u4F60\u7EE7\u7EED\u53BB\u5FD9\u5427\uFF0C\u4E0D\u8981\u62C5\u5FC3\u6211\u3002",
    "Outdoor_1": "\u4ECE\u79D1\u5B66\u4E0A\u6765\u8BB2\uFF0C\u6211\u60F3\u5728\u8FD9\u91CC\u629A\u517B\u5B69\u5B50\u5341\u5206\u7406\u60F3\u3002\u4F60\u8BA4\u4E3A\u5982\u4F55\uFF1F",
    "Outdoor_2": "\u6211\u53EF\u80FD\u4E0D\u662F\u6700\u4EE4\u4EBA\u6FC0\u52A8\u7684\u4EBA\uFF0C\u4F46\u662F\u6211\u4F59\u751F\u90FD\u4F1A\u5BF9\u4F60\u5FE0\u8BDA\u3002$l",
    "Outdoor_3": "@\u2026\u2026\u4F60\u2026\u2026\u4F60\u5BF9\u6211\u6765\u8BF4\u5C31\u662F\u6574\u4E2A\u4E16\u754C\u3002$l",
    "Outdoor_4": "\u4F5C\u4E3A\u4E00\u540D\u79D1\u5B66\u5BB6\uFF0C\u6211\u5BF9\u6606\u866B\u548C\u690D\u7269\u5FAE\u5999\u7684\u76F8\u4E92\u4F5C\u7528\u5F88\u7740\u8FF7\u3002",
    "Rainy_Day_0": "\u96E8\u5929\u4F1A\u5F15\u8D77\u6D41\u611F\u662F\u4E2A\u8C2C\u8BBA\u3002\u4F46\u662F\uFF0C\u6CE8\u610F\u4E0D\u8981\u5728\u6CE5\u91CC\u6ED1\u5012\u4E86\uFF01#$e#\u6211\u5E38\u5E38\u5F88\u62C5\u5FC3\u4F60\u3002",
    "Rainy_Day_1": "\u6211\u4E00\u4E2A\u4EBA\u4F4F\u5728\u8BCA\u6240\u4E0A\u9762\u7B80\u76F4\u5B64\u72EC\u5F97\u65E0\u4EE5\u590D\u52A0\u2026\u2026\u73B0\u5728\u6211\u5F00\u5FC3\u591A\u4E86\u3002$h",
    "Rainy_Day_2": "\u6211\u9192\u5F97\u5F88\u65E9\uFF0C\u4F46\u662F\u6211\u4E0D\u4F1A\u5435\u9192\u4F60\u7684\u3002\u4F60\u770B\u8D77\u6765\u5F88\u5E73\u9759\u3002",
    "Rainy_Day_3": "\u6211\u4E0D\u4ECB\u610F\u4E0B\u96E8\u3002\u5F53\u7136\uFF0C\u6211\u770B\u4E0D\u5230\u98DE\u673A\u7ECF\u8FC7\uFF0C\u4F46\u6211\u8FD8\u662F\u80FD\u542C\u5230\u6536\u97F3\u673A\u7684\u5431\u5431\u58F0\u3002#$e#\u5B83\u8BA9\u6240\u6709\u4E8B\u7269\u90FD\u66F4\u52A0\u795E\u79D8\u4E86\u3002",
    "Rainy_Day_4": "\u6211\u79EF\u4E86\u4E00\u5806\u7684\u5BB6\u52A1\uFF0C\u4ECA\u5929\u60F3\u5168\u90E8\u5F04\u5B8C\u3002\u6211\u6709\u597D\u591A\u4E8B\u60C5\u8981\u5FD9\u5462\uFF01",
    "Rainy_Night_0": "\u4EB2\u7231\u7684\uFF0C\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u6211\u4ECA\u5929\u672C\u6253\u7B97\u6D17\u76D8\u5B50\u7684\uFF0C\u4F46\u7ED3\u679C\u6C89\u8FF7\u4E8E\u9605\u8BFB\u6700\u65B0\u4E00\u671F\u201C\u819D\u76D6\u624B\u672F\u7231\u597D\u8005\u201D\u4E86\u3002",
    "Rainy_Night_1": "\u5982\u679C\u4F60\u4EAB\u53D7\u751F\u6D3B\uFF0C\u53C8\u600E\u4E48\u4F1A\u4ECB\u610F\u751F\u6D3B\u7684\u91CD\u590D\u7410\u788E\uFF1F\u6211\u662F\u8FD9\u4E48\u8BF4\u7684\u3002",
    "Rainy_Night_2": "\u4F60\u770B\u8D77\u6765\u6253\u6E7F\u4E86\u4E00\u70B9\u5440\uFF1F\u4E3A\u4F55\u4E0D\u5728\u706B\u8FB9\u70E4\u6696\u548C\u4E00\u70B9\uFF1F^\u4EB2\u7231\u7684\uFF0C\u4F60\u770B\u8D77\u6765\u6253\u6E7F\u4E86\u4E00\u70B9\uFF1F\u4E3A\u4F55\u4E0D\u5728\u706B\u8FB9\u70E4\u6696\u548C\u4E00\u70B9\uFF1F",
    "Rainy_Night_3": "\u96E8\u58F0\u8BA9\u6211\u4EEC\u7684\u6CE8\u610F\u529B\u96C6\u4E2D\u5728\u4E00\u4E9B\u4E8B\u4E0A\uFF0C\u6240\u4EE5\u4E0D\u4F1A\u56E0\u4E3A\u80E1\u601D\u4E71\u60F3\u5206\u6563\u6CE8\u610F\u529B\u3002#$e#\u8FD9\u662F\u6211\u8BA4\u4E3A\u4E3A\u4EC0\u4E48\u96E8\u5929\u8BA9\u4EBA\u5BBD\u6170\u7684\u7406\u7531\u2026\u2026",
    "Rainy_Night_4": "\u6211\u505A\u4E86\u4E00\u987F\u7F8E\u7F8E\u7684\u5065\u5EB7\u665A\u9910\u3002\u90FD\u662F\u8C37\u91CC\u65B0\u9C9C\u3001\u6709\u76CA\u5065\u5EB7\u7684\u98DF\u6750\uFF01[212 214 225 209 200]$h#$e#\u4EB2\u7231\u7684\uFF0C\u597D\u5403\u4E5F\u4E0D\u8981\u8D2A\u591A\u54E6\u3002",
    "TwoKids_0": "\u6211\u5DF2\u7ECF\u7ED9%kid1\u548C%kid2\u5582\u8FC7\u65E9\u9910\u4E86\u3002\u6211\u8BD5\u7740\u6559\u4ED6\u4EEC\u4EAB\u7528\u5065\u5EB7\u7684\u98DF\u7269\uFF01",
    "TwoKids_1": "\u6211\u8BA4\u4E3A\u5E94\u8BE5\u5141\u8BB8\u5B69\u5B50\u968F\u610F\u63A2\u7D22\u4E0E\u73A9\u800D\u3002\u6BD5\u7ADF\u4F60\u53EA\u6709\u4E00\u4E2A\u7AE5\u5E74\u3002",
    "TwoKids_2": "\u6216\u8BB8%kid2\u957F\u5927\u4EE5\u540E\u53EF\u80FD\u4F1A\u6210\u4E3A\u4E00\u540D\u98DE\u884C\u5458\uFF0C\u50CF\u6211\u6C38\u8FDC\u4E0D\u80FD\u4F01\u53CA\u7684\u90A3\u6837\uFF1F",
    "TwoKids_3": "\u73B0\u5728\u6211\u6DF1\u7231\u7740\u4F60\u548C\u5B69\u5B50\u4EEC\uFF0C\u5E76\u4E14\u6211\u5F88\u5E78\u798F\u3002\u6211\u4E00\u76F4\u68A6\u60F3\u7740\u6709\u4E2A\u7F8E\u6EE1\u7684\u5BB6\u5EAD\u3002$l#$e#\u6211\u5BB3\u6015\u4E00\u76F4\u5355\u8EAB\u2026\u2026\u6211\u597D\u7231\u4F60\u3002$l",
    "fall_1": "\u4EB2\u7231\u7684\uFF0C\u4ECA\u5E74\u79CB\u5929\u591A\u79CD\u51E0\u79CD\u4F5C\u7269\u3002#$e#\u6216\u8005\u53EA\u79CD\u8513\u8D8A\u8393\u2026\u2026\u8FD9\u53D6\u51B3\u4E8E\u4F60\u3002\u6211\u61C2\u4EC0\u4E48\u5462\uFF1F",
    "fall_15": "\u660E\u5929\u662F\u96C6\u5E02\u3002\u98DF\u7269\u4E30\u5BCC\u800C\u4E14\u5F88\u54B8\uFF0C\u4F46\u6211\u5076\u5C14\u4E5F\u53EF\u4EE5\u5962\u4F88\u4E00\u4E0B\u3002$h",
    "fall_26": "\u6211\u627F\u8BA4\uFF0C\u4E07\u7075\u8282\u603B\u662F\u8BA9\u6211\u80A0\u75DB\u2026\u2026\u4F46\u662F\u6211\u4F1A\u5C3D\u91CF\u52C7\u6562\u7684\u3002",
    "funLeave_Harvey": "\u6211\u60F3\u4ECA\u5929\u7A0D\u7A0D\u6563\u4E00\u4E0B\u6B65\u3002\u6211\u9700\u8981\u653E\u677E\u4E00\u4E0B\u3002",
    "funReturn_Harvey": "\u6211\u4ECA\u5929\u5F88\u6109\u5FEB\u3002\u4E0D\u65F6\u72EC\u5904\u4E00\u4E0B\u8BA9\u4EBA\u795E\u6E05\u6C14\u723D\u3002\u4F60\u4ECA\u5929\u8FC7\u5F97\u597D\u5417\uFF0C\u4EB2\u7231\u7684\uFF1F",
    "patio_Harvey": "\u4F60\u8981\u77E5\u9053\uFF0C\u5F53\u6211\u5728\u8FD9\u91CC\u9605\u8BFB\u7684\u65F6\u5019\uFF0C\u8FD9\u672C\u300A\u808C\u8171\u52A8\u529B\u5B66\u300B\u6742\u5FD7\u5B9E\u9645\u4E0A\u8FD8\u662F\u53EF\u4EE5\u770B\u5F97\u4E0B\u53BB\u7684\u3002",
    "spring_1": "\u770B\u5230\u4E07\u7269\u590D\u82CF\u771F\u662F\u597D\u554A\uFF01\u5355\u8C03\u7684\u51AC\u5929\u8FC7\u540E\u690D\u7269\u90FD\u7115\u7136\u4E00\u65B0\u4E86\u3002",
    "spring_12": "\u5662\uFF0C\u660E\u5929\u6709\u4E2A\u8282\u5E86\uFF0C\u5BF9\u5427\uFF1F\u4EBA\u7FA4\u3001\u6D3B\u52A8\u2026\u2026*\u541E\u53E3\u6C34* \u2026\u2026$s",
    "spring_23": "\u4F60\u2026\u2026\u4F60\u660E\u5929\u4F1A\u548C\u6211\u8DF3\u821E\u5417\uFF1F$7#$e#\u8FD9\u603B\u662F\u6709\u70B9\u5C34\u5C2C\u3002$7",
    "summer_1": "\u5343\u4E07\u522B\u6652\u4F24\u4E86\uFF0C\u4EB2\u7231\u7684\uFF01\u90A3\u5BF9\u4F60\u7684\u76AE\u80A4\u6765\u8BF4\u5F88\u5371\u9669\u3002$8#$e#\u4F5C\u4E3A\u4F60\u7684\u4E08\u592B\u548C\u533B\u751F\uFF0C\u4F60\u7684\u5065\u5EB7\u548C\u5B89\u5168\u662F\u6211\u7B2C\u4E00\u4F18\u5148\u8003\u8651\u7684\u4E8B\u60C5\uFF01",
    "summer_10": "\u4F60\u60F3\u597D\u5728\u5BB4\u4F1A\u7684\u6C64\u91CC\u9762\u653E\u4EC0\u4E48\u4E86\u5417\uFF1F#$e#\u6211\u4F1A\u653E\u4E00\u79CD\u9AD8\u4EF7\u503C\u3001\u9AD8\u8D28\u91CF\u7684\u4E1C\u897F\u3002\u6211\u4EEC\u90FD\u60F3\u7ED9\u5DDE\u957F\u7559\u4E0B\u6DF1\u523B\u5370\u8C61\uFF01",
    "summer_27": "\u968F\u7740\u590F\u5929\u5373\u5C06\u7ED3\u675F\uFF0C\u51B7\u5929\u5373\u5C06\u5F00\u59CB\uFF0C\u6211\u7684\u5DE5\u4F5C\u91CF\u4E5F\u5F00\u59CB\u589E\u52A0\u3002\u5982\u679C\u6211\u6709\u70B9\u513F\u90C1\u90C1\u5BE1\u6B22\uFF0C\u90A3\u6211\u63D0\u524D\u8BF4\u58F0\u62B1\u6B49\u2026\u2026",
    "winter_1": "\u51AC\u5929\u7684\u65F6\u5019\u7A7A\u6C14\u5F88\u5E72\u71E5\u3002\u6240\u4EE5\u6211\u76AE\u80A4\u4F1A\u53D1\u7EA2\u3002#$e#\u522B\u62C5\u5FC3\uFF0C\u6BCF\u5929\u665A\u4E0A\u6211\u4F1A\u5728\u4F60\u7684\u80CC\u4E0A\u64E6\u4E00\u4E9B\u677E\u9732\u6CB9\u3002$l",
    "winter_28": "\u55EF\uFF0C\u4ECA\u5E74\u771F\u662F\u7F8E\u5999\u7684\u4E00\u5E74\u3002\u6211\u5B8C\u5168\u76F8\u4FE1\u660E\u5E74\u4F1A\u66F4\u597D\uFF01$h",
    "winter_7": "\u660E\u5929\u6211\u4EEC\u8981\u987A\u4FBF\u8DEF\u8FC7\u51B0\u96EA\u8282\u5417\uFF1F\u6211\u5F88\u559C\u6B22\u5706\u9876\u5EFA\u7B51\u2026\u2026"
  }
