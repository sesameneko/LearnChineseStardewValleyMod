  "entries": {
    "Bad_5": "\u62DC\u6258\uFF0C\u6211\u53EA\u60F3\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u5446\u7740\u3002\u4F60\u4E3A\u4EC0\u4E48\u4E0D\u53BB\u5916\u9762\u505A\u4F60\u81EA\u5DF1\u7684\u4E8B\u60C5\uFF1F",
    "Bad_6": "\u60A8\u60F3\u600E\u6837\uFF1F\u4F60\u600E\u4E48\u8DDF\u6211\u7EE7\u7236\u4E00\u4E2A\u8C03\u8C03\u3002\u5FEB\u8D70\u5F00\u3002$a",
    "Bad_7": "\u8FD9\u5730\u65B9\u611F\u89C9\u50CF\u5893\u5730\u3002$s",
    "Bad_8": "\u6211\u53C8\u5F00\u59CB\u5438\u70DF\u4E86\u2026\u2026\u6700\u8FD1\u6211\u538B\u529B\u91CD\u91CD\u3002$s",
    "Good_0": "\u563F\u3002\u770B\u7740\u6211\u3002\u522B\u5FD8\u4E86\u6211\u7231\u7740\u4F60\u2026\u2026\u4F60\u662F\u6211\u7684\u4E00\u5207\u3002$l#$b#\u73B0\u5728\u53BB\u4E3A\u6211\u4EEC\u6323\u4E9B\u94B1\u5427\u3002$h",
    "Good_1": "\u563F\u2026\u2026\u8FC7\u6765\uFF01\u4F60\u4ECA\u5929\u770B\u8D77\u6765\u5F88\u68D2\u3002$l",
    "Good_2": "\u4F60\u4E00\u76F4\u770B\u8D77\u6765\u5F88\u68D2\uFF0C\u5373\u4F7F\u5728\u9662\u5B50\u91CC\u5F04\u5F97\u6EE1\u8EAB\u90FD\u662F\u6CE5\u4E4B\u540E\u3002$l",
    "Good_3": "\u6211\u4E0D\u7ECF\u5E38\u8868\u8FBE\uFF0C\u4F46\u662F\u80FD\u6210\u4E3A\u4F60\u7684\u4E08\u592B\u6211\u5F88\u5E78\u798F\u3002\u5A36\u4F60\u662F\u6211\u505A\u8FC7\u7684\u6700\u597D\u7684\u51B3\u5B9A\u3002$l",
    "Good_4": "\u4F60\u4E0D\u7528\u62C5\u5FC3\u6211\u3002\u5F88\u591A\u65F6\u5019\u6211\u559C\u6B22\u4E00\u4E2A\u4EBA\u3002",
    "Good_5": "\u6709\u65F6\u5019\u6211\u5F88\u751F\u6C14\u2026\u2026\u4F46\u662F\u770B\u5230\u4F60\u4E4B\u540E\u6211\u5C31\u4F1A\u5F00\u59CB\u51B7\u9759\u4E0B\u6765\u3002$7#$e#\u4E5F\u8BB8\u968F\u7740\u5E74\u9F84\u589E\u957F\uFF0C\u6211\u4F1A\u653E\u677E\u5FC3\u6001\u3002",
    "Good_6": "\u6211\u77E5\u9053\u4F60\u5F88\u575A\u5F3A\uFF0C\u4F46\u6709\u65F6\u5019\u6211\u8FD8\u662F\u4F1A\u62C5\u5FC3\u4F60\u3002\u53BB\u72E9\u730E\u602A\u7269\u7684\u65F6\u5019\u4E00\u5B9A\u8981\u8BB0\u5F97\u5E26\u4E0A\u751F\u547D\u836F\u6C34\u548C\u8010\u7528\u7684\u9774\u5B50\uFF0C\u597D\u5417\uFF1F",
    "Good_8": "\u6211\u4ECA\u5929\u6CA1\u4EC0\u4E48\u5DE5\u4F5C\u7684\u5FC3\u60C5\u3002\u4E5F\u8BB8\u6211\u5E94\u8BE5\u770B\u7535\u89C6\u3002",
    "Good_9": "\u6211\u771F\u7684\u4E0D\u9700\u8981\u670B\u53CB\u3002\u4F60\u662F\u6211\u751F\u547D\u4E2D\u552F\u4E00\u9700\u8981\u7684\u4EBA\u3002\u662F\u4E0D\u662F\u5F88\u5947\u602A\uFF1F#$e#\u6211\u731C\u6211\u8DDF\u5927\u90E8\u5206\u4EBA\u4E0D\u4E00\u6837\u3002",
    "Indoor_Day_0": "\u968F\u7740\u5E74\u7EAA\u8D8A\u6765\u8D8A\u5927\uFF0C\u6211\u5C31\u8D8A\u4E0D\u7559\u604B\u57CE\u5E02\u4E86\u3002\u57CE\u5E02\u66FE\u7ECF\u6709\u67D0\u79CD\u795E\u79D8\u7684\u9B45\u529B\u3002\u4F46\u4E8B\u5B9E\u8BC1\u660E\u90A3\u53EA\u662F\u4E00\u79CD\u6D6A\u6F2B\u7684\u5E7B\u60F3\u3002#$e#\u57CE\u5E02\u592A\u7E41\u5FD9\uFF0C\u5230\u5904\u90FD\u662F\u4EBA\u2026\u2026\u6211\u4E0D\u5C5E\u4E8E\u90A3\u91CC\u3002\u6211\u662F\u4E2A\u559C\u6B22\u5B64\u72EC\u7684\u4EBA\u3002",
    "Indoor_Day_1": "\u563F\u2026\u2026\u60F3\u6765\u70B9\u5496\u5561\u5417\uFF1F[395]$7#$e#\u6211\u60F3\u8981\u70B9\u2026\u2026\u4E4B\u524D\u4ECE\u5669\u68A6\u4E2D\u9192\u6765\uFF0C\u6211\u73B0\u5728\u518D\u4E5F\u7761\u4E0D\u7740\u4E86\u3002",
    "Indoor_Day_2": "\u6628\u665A\u6211\u5931\u7720\u4E86\uFF0C\u6240\u4EE5\u6211\u665A\u4E0A\u51FA\u53BB\u9A91\u6469\u6258\u8F66\u4E86\u3002#$e#\u6211\u8981\u4FDD\u6301\u72EC\u7ACB\uFF0C\u5373\u4F7F\u6211\u4EEC\u7ED3\u5A5A\u4E86\u3002\u6211\u5C31\u662F\u8FD9\u6837\u3002\u4F46\u6211\u4ECD\u7136\u7231\u4F60\u3002$7",
    "Indoor_Day_3": "\u563F\u3002\u4F60\u6628\u665A\u7761\u5F97\u600E\u6837\uFF1F\u6211\u542C\u5230\u4F60\u8BF4\u68A6\u8BDD\u4E86\u3002#$e#\u4F60\u4F3C\u4E4E\u88AB\u5413\u5230\u4E86\uFF0C\u4F46\u662F\u6211\u5FC5\u987B\u627F\u8BA4\u2026\u2026\u90A3\u5F88\u53EF\u7231\u3002$l",
    "Indoor_Day_4": "\u548C\u4F60\u4F4F\u5728\u8FD9\u91CC\u8BA9\u6211\u5B66\u4F1A\u4E86\u8D70\u51FA\u81EA\u5DF1\u7684\u5821\u5792\u3002\u6211\u89C9\u5F97\u8FD9\u6837\u5BF9\u6211\u5F88\u597D\u3002$7",
    "Indoor_Night_0": "\u563F\u3002\u4ECA\u5929\u6211\u5728\u623F\u5B50\u5468\u56F4\u95F2\u901B\u4E86\u4E00\u4E0B\u3002\u6CA1\u4EC0\u4E48\u6709\u610F\u601D\u7684\u2026\u2026#$e#\u2026\u2026#$e#\u4ECE\u6211\u4EEC\u7684\u623F\u5B50\u770B\u8FC7\u53BB\uFF0C\u98CE\u666F\u592A\u7F8E\u4E86\u3002\u5728\u524D\u5ECA\u53EF\u4EE5\u770B\u5230\u9E48\u9E55\u9547\u7684\u65E5\u843D\u3002",
    "Indoor_Night_1": "\u4E5F\u8BB8\u6211\u559D\u592A\u591A\u5496\u5561\u4E86\u2026\u2026\u6211\u5E76\u6CA1\u611F\u5230\u5F88\u7D2F\u3002#$e#\u6211\u8FD8\u5728\u8BD5\u7740\u9002\u5E94\u519C\u573A\u7684\u751F\u6D3B\u65B9\u5F0F\u3002\u6211\u8FC7\u53BB\u5076\u5C14\u71AC\u591C\u5230\u51CC\u6668 5 \u70B9\uFF0C\u7136\u540E\u7761\u5230\u4E0B\u5348 2 \u70B9\u624D\u8D77\u6765\u3002$h",
    "Indoor_Night_2": "\u62E5\u6709\u6211\u4EEC\u81EA\u5DF1\u7684\u5C0F\u7A9D\u611F\u89C9\u771F\u597D\u3002\u6211\u60F3\u505A\u4EC0\u4E48\u5C31\u505A\u4EC0\u4E48\uFF0C\u4E0D\u4F1A\u4E00\u76F4\u53D7\u4EBA\u5520\u53E8\u3002#$e#\u6211\u8D70\u4E86\u739B\u9C81\u80AF\u5B9A\u5F88\u9AD8\u5174\u3002",
    "Indoor_Night_3": "\u4E4B\u524D\u6211\u5728\u7A97\u6237\u5916\u9762\u770B\u5230\u4E86\u4E00\u53EA\u8759\u8760\u3002\u5B83\u4EEC\u5F88\u96BE\u770B\u5230\uFF0C\u4F46\u662F\u5982\u679C\u4F60\u96C6\u4E2D\u6CE8\u610F\u529B\uFF0C\u53EF\u4EE5\u7ECF\u5E38\u770B\u5230\u5B83\u4EEC\u4E00\u63A0\u800C\u8FC7\u3002\u5B83\u4EEC\u5C31\u5728\u90A3\u91CC\u3002",
    "Indoor_Night_4": "\u5728\u5BB6\u91CC\u6211\u7ECF\u5E38\u611F\u89C9\u88AB\u5FFD\u7565\u2026\u2026\u4F46\u662F\u6211\u611F\u89C9\u81EA\u5DF1\u662F\u771F\u6B63\u5C5E\u4E8E\u8FD9\u91CC\u3002\u8C22\u8C22\u4F60\u8BA9\u6211\u89C9\u5F97\u5BBE\u81F3\u5982\u5F52\uFF0C@\u3002$l",
    "Neutral_0": "\u6211\u6563\u6B65\u7684\u65F6\u5019\u5C3D\u53EF\u80FD\u907F\u5F00\u6BCF\u4E00\u4E2A\u4EBA\u3002\u6211\u4E0D\u559C\u6B22\u88AB\u8FEB\u8DDF\u522B\u4EBA\u5BD2\u6684\u3002",
    "Neutral_2": "\u7B49\u6211\u4EEC\u4ECA\u665A\u8EBA\u5728\u5E8A\u4E0A\u7684\u65F6\u5019\u518D\u7ED9\u6211\u8BB2\u8BB2\u4F60\u7684\u4E00\u5929\u5427\uFF1F\u6211\u73B0\u5728\u6709\u70B9\u5FD9\u2026\u2026",
    "Neutral_3": "\u4F60\u4ECA\u5929\u4F1A\u53BB\u9547\u5B50\u91CC\u5417\uFF1F\u4E3A\u4EC0\u4E48\uFF0C\u4F60\u6709\u4EC0\u4E48\u4E8B\uFF1F",
    "Neutral_4": "\u6211\u5411\u6211\u4ECA\u5929\u53EF\u4EE5\u6D17\u8863\u670D\u2026\u2026\u4F60\u53EF\u80FD\u624B\u4E0A\u5168\u662F\u7BA1\u7406\u519C\u573A\u7684\u4E8B\u3002",
    "Neutral_5": "\u5BB6\u91CC\u662F\u4E0D\u662F\u6709\u4E9B\u62EE\u636E\uFF1F\u6211\u4E0D\u60F3\u5356\u6389\u6211\u7684\u7B14\u8BB0\u672C\u7535\u8111\u2026\u2026",
    "Neutral_6": "\u5982\u679C\u4F60\u8981\u53BB\u9547\u5B50\u89C1\u4F60\u7684\u670B\u53CB\uFF0C\u90A3\u5C31\u53BB\u5427\u3002\u4E0D\u7BA1\u600E\u6837\uFF0C\u6211\u559C\u6B22\u4E00\u4E2A\u4EBA\u3002",
    "Neutral_8": "\u6253\u626B\u623F\u5B50\u6CA1\u4EC0\u4E48\u610F\u601D\uFF0C\u4F46\u662F\u5F53\u6211\u8FB9\u542C\u97F3\u4E50\u8FB9\u6253\u626B\u65F6\uFF0C\u5C31\u4F1A\u8FC7\u5F97\u5F88\u5FEB\u3002",
    "OneKid_0": "\u6211\u8FD8\u5728\u52AA\u529B\u9002\u5E94\u5F53\u4E00\u540D\u7236\u4EB2\u3002\u522B\u62C5\u5FC3\uFF0C\u6211\u4F1A\u597D\u597D\u7167\u987E%kid1\u7684\uFF01\u53EA\u662F\u2026\u2026\u6211\u8FD8\u4E0D\u592A\u4E60\u60EF\u3002",
    "OneKid_1": "\u4E5F\u8BB8\u7B49%kid1\u518D\u957F\u5927\u70B9\u513F\uFF0C\u6211\u4F1A\u7ED9\u6469\u6258\u88C5\u4E00\u4E2A\u8FB9\u8F66\uFF0C\u7136\u540E\u6211\u4EEC\u5C31\u53EF\u4EE5\u4E00\u8D77\u53BB\u515C\u98CE\u4E86\u3002$h",
    "OneKid_3": "\u4F60\u95FB\u5230%kid1\u8EAB\u4E0A\u7684\u5473\u9053\u4E86\u5417\uFF1F\u4E5F\u8BB8\u8BE5\u6D17\u6FA1\u4E86\u2026\u2026",
    "Outdoor_0": "\u6211\u4ECA\u5929\u60F3\u505A\u70B9\u4EC0\u4E48\u2026\u2026\u4F46\u662F\u6211\u4E0D\u786E\u5B9A\u3002\u4F60\u6709\u6CA1\u6709\u8FD9\u4E48\u89C9\u5F97\u8FC7\u5462\uFF0C@\uFF1F",
    "Outdoor_1": "\u55EF\u2026\u2026\u4E3A\u4E86\u5065\u5EB7\uFF0C\u6709\u65F6\u5019\u6211\u5F3A\u8FEB\u81EA\u5DF1\u5F85\u5728\u5916\u9762\u3002#$e#\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u4EC0\u4E48\u611F\u89C9\uFF0C\u4F46\u662F\u6211\u559C\u6B22\u5F85\u5728\u5BA4\u5185\u3002\u4E5F\u8BB8\u6211\u592A\u4E60\u60EF\u6211\u660F\u6697\u7684\u5730\u4E0B\u5BA4\u4E86\u3002",
    "Outdoor_2": "\u6211\u4F1A\u4ECE\u8FD9\u91CC\u770B\u7740\u4F60\u3002$h#$e#\u6211\u559C\u6B22\u770B\u7740\u4F60\u3002",
    "Outdoor_3": "\u6211\u4E0D\u60F3\u56E0\u4E3A\u7ED3\u5A5A\u800C\u53D8\u5F97\u67D4\u5F31\u3002\u4E5F\u8BB8\u6211\u8BE5\u5F00\u59CB\u591A\u5403\u70B9\u7EA2\u8FA3\u6912\uFF0C\u5E76\u953B\u70BC\u8EAB\u4F53\uFF1F#$e#\u53EA\u662F\u60F3\u60F3\u800C\u5DF2\u2026\u2026$h",
    "Outdoor_4": "\u6211\u4EEC\u5E94\u8BE5\u591A\u517B\u70B9\u53F2\u83B1\u59C6\u2026\u2026\u5927\u91CF\u517B\u6B96\u5229\u6DA6\u76F8\u5F53\u53EF\u89C2\u3002\u5B83\u4EEC\u5F88\u597D\u517B\u3002#$e#\u5E76\u4E14\uFF0C\u4E0D\u540C\u989C\u8272\u7684\u53F2\u83B1\u59C6\u53EF\u4EE5\u4EA7\u51FA\u4E0D\u540C\u7684\u7269\u54C1\u3002\u6211\u4E0D\u77E5\u9053\uFF0C\u6211\u89C9\u5F97\u90A3\u662F\u4E00\u79CD\u6709\u8DA3\u7684\u7231\u597D\u3002",
    "Rainy_Day_0": "\u7EC8\u4E8E\u2026\u2026\u4E0B\u5927\u96E8\u4E86\u3002\u6211\u5F88\u5BB9\u6613\u5BF9\u6674\u5929\u611F\u5230\u538C\u70E6\u3002",
    "Rainy_Day_1": "\u563F\u3002\u6211\u53EA\u662F\u5728\u60F3\u6211\u5728\u5730\u4E0B\u5BA4\u7684\u65E7\u623F\u95F4\u3002\u6211\u5728\u90A3\u91CC\u611F\u89C9\u5F88\u8212\u670D\uFF0C\u4F46\u662F\u8FD9\u91CC\u66F4\u6709\u8DA3\u4E9B\u3002\u800C\u4E14\u6211\u4E0D\u559C\u6B22\u90A3\u5473\u9053\u2026\u2026#$e#\u4F4F\u5728\u6211\u5988\u623F\u5B50\u91CC\u8FD9\u4E48\u4E45\u6211\u89C9\u5F97\u6709\u70B9\u513F\u5C34\u5C2C\u3002",
    "Rainy_Day_2": "\u563F\u3002\u6628\u665A\u6211\u7761\u4E0D\u7740\uFF0C\u6240\u4EE5\u6211\u53BB\u5C71\u6D1E\u8D70\u4E86\u8D70\u3002\u6211\u627E\u5230\u4E86\u8FD9\u4E2A\uFF0C\u60F3\u8981\u5417\uFF1F[575 769 767 84 66 78]#$e#\u6211\u53EA\u662F\u5076\u5C14\u4F1A\u5931\u7720\uFF0C\u8FD9\u4E0E\u4F60\u65E0\u5173\u3002\u6211\u7231\u4F60\u3002$7",
    "Rainy_Day_3": "\u4ECA\u5929\u4F3C\u4E4E\u5F88\u9002\u5408\u8EBA\u7740\uFF0C\u6216\u8BB8\u770B\u4E66\u6216\u8005\u505A\u70B9\u522B\u7684\u2026\u2026\u4F60\u89C9\u5F97\u5462\uFF1F",
    "Rainy_Day_4": "\u563F\uFF0C\u53C8\u662F\u96E8\u5929\u2026\u2026\u592A\u597D\u4E86\u3002#$e#\u4F60\u770B\u8D77\u6765\u5F88\u51B7\u2026\u2026\u6765\uFF0C\u9760\u8FD1\u70B9\u513F\u3002$l",
    "Rainy_Night_0": "\u65E2\u7136\u6211\u4EEC\u7ED3\u5A5A\u4E86\uFF0C\u73B0\u5728\u6211\u5728\u5C3D\u6700\u5927\u52AA\u529B\u6212\u70DF\u2026\u2026\u6211\u4E0D\u60F3\u6BD4\u4F60\u5148\u53BB\u4E16\u3002\u8FD9\u662F\u4E2A\u574F\u4E60\u60EF\u3002#$e#\u6211\u60F3\u548C\u4F60\u5171\u521B\u672A\u6765\u3002$l",
    "Rainy_Night_1": "\u6211\u4ECA\u5929\u7528\u7B14\u8BB0\u672C\u7535\u8111\u5B8C\u6210\u4E86\u4E9B\u5DE5\u4F5C\u3002\u5B9E\u9645\u4E0A\u6211\u60F3\u51FA\u4E86\u4E00\u4E9B\u6211\u60F3\u505A\u7684\u6E38\u620F\u7684\u70B9\u5B50\u3002#$e#\u9760\u7740\u4F60\u7684\u519C\u573A\u6536\u5165\uFF0C\u6211\u53EF\u4EE5\u5B9E\u73B0\u81EA\u5DF1\u7684\u4EBA\u751F\u7406\u60F3\u3002\u592A\u68D2\u5566\u3002\u8C22\u8C22\u3002$h",
    "Rainy_Night_2": "\u62B1\u6B49\uFF0C\u6211\u6CA1\u505A\u665A\u996D\u3002\u6211\u4EEC\u53EF\u4EE5\u5403\u70B9\u51B0\u7BB1\u91CC\u7684\u51B7\u62AB\u8428\u6216\u8005\u522B\u7684\u3002#$e#\u6211\u4E0D\u77E5\u9053\uFF0C\u6211\u5728\u60F3\u522B\u7684\u3002\u6211\u7ECF\u5E38\u4F1A\u5FD8\u8BB0\u505A\u5BB6\u52A1\u2026\u2026",
    "Rainy_Night_3": "\u4ECA\u5929\u8FC7\u5F97\u600E\u4E48\u6837\uFF1F\u4F60\u6709\u6CA1\u6709\u6740\u6B7B\u4EC0\u4E48\u602A\u7269\uFF1F$h#$e#\u4E0D\u65F6\u53D1\u6CC4\u4E00\u4E0B\u7684\u611F\u89C9\u4E5F\u5F88\u597D\uFF0C\u4E0D\u662F\u5417\uFF1F",
    "Rainy_Night_4": "\u6216\u8BB8\u4ECA\u665A\u4F1A\u6709\u4E00\u4F4D\u5973\u5DEB\u524D\u6765\u62DC\u8BBF\uFF1F\u54C8\u2026\u2026\u5982\u679C\u751F\u6D3B\u6709\u90A3\u4E48\u6709\u8DA3\u5C31\u597D\u4E86\u2026\u2026",
    "TwoKids_0": "\u522B\u62C5\u5FC3\uFF0C\u6211\u5DF2\u7ECF\u5582\u8FC7\u5B69\u5B50\u4E86\u2026\u2026%kid2\u53C8\u628A\u5DE7\u514B\u529B\u725B\u5976\u6D12\u5230\u6211\u886C\u886B\u4E0A\u4E86\u3002",
    "TwoKids_1": "\u6211\u5E0C\u671B%kid1\u548C%kid2\u80FD\u76F8\u5904\u5730\u5F88\u597D\u3002\u6211\u548C\u739B\u9C81\u603B\u662F\u50CF\u5B69\u5B50\u4E00\u6837\u6253\u67B6\u3002#$e#\u73B0\u5728\u56DE\u60F3\u8D77\u6765\uFF0C\u5927\u90E8\u5206\u65F6\u5019\u90FD\u662F\u6211\u7684\u9519\u2026\u2026",
    "TwoKids_2": "\u6211\u4E00\u76F4\u68A6\u5230%kid2\u7A7F\u7740\u6697\u5F71\u8428\u6EE1\u7684\u8863\u670D\uFF0C\u5750\u5728\u53D1\u5149\u7684\u5357\u74DC\u4E0A\u3002\u5F88\u5947\u602A\uFF0C\u5BF9\u5427\uFF1F",
    "TwoKids_3": "\u6211\u4EEC\u8D70\u8FC7\u4E86\u6F2B\u957F\u7684\u8DEF\uFF0C@\u3002\u770B\u770B\u6211\u4EEC\u7684\u5BB6\u5EAD\u3002\u8BF4\u5B9E\u8BDD\uFF0C\u6211\u4ECE\u672A\u6599\u5230\u6211\u4F1A\u6709\u4ECA\u5929\u8FD9\u6837\u7684\u5904\u5883\u3002#$e#\u65E2\u6765\u4E4B\uFF0C\u5219\u5B89\u4E4B\u2026\u2026$l",
    "fall_1": "\u5C31\u50CF\u4E00\u591C\u4E4B\u95F4\u6574\u4E2A\u661F\u9732\u8C37\u90FD\u53D8\u4E86\u2026\u2026\u6211\u731C\u79CB\u5929\u6765\u4E86\u3002",
    "fall_15": "\u661F\u9732\u8C37\u96C6\u5E02\u5BF9\u6211\u6765\u8BF4\u6709\u70B9\u513F\u6324\u2026\u2026\u4F46\u6211\u53EA\u662F\u548C\u5C71\u59C6\u95F2\u901B\u3002\u8DDF\u4ED6\u4EA4\u6D41\u4E00\u756A\u5E94\u8BE5\u633A\u4E0D\u9519\u3002#$e#\u4F46\u4F60\u4E5F\u5E94\u8BE5\u73A9\u4E00\u73A9\u644A\u4F4D\u6E38\u620F\uFF01\u4E0D\u8981\u62C5\u5FC3\u6211\u3002$7",
    "fall_26": "\u660E\u5929\u7684\u4E07\u7075\u8282\u771F\u8BA9\u6211\u611F\u5230\u5174\u594B\u3002\u4E0D\u77E5\u9053\u4F1A\u770B\u5230\u4EC0\u4E48\u6050\u6016\u7684\u4E1C\u897F\u3002$h",
    "funLeave_Sebastian": "\u6211\u4ECA\u5929\u8981\u6563\u4E00\u4E0B\u6B65\u3002\u6211\u9700\u8981\u4E00\u70B9\u5C5E\u4E8E\u81EA\u5DF1\u7684\u65F6\u95F4\u3002\u665A\u4E0A\u89C1\u3002",
    "funReturn_Sebastian": "\u6211\u8FC7\u5F97\u5F88\u597D\uFF0C\u6CA1\u4EC0\u4E48\u597D\u8DDF\u4F60\u8BF4\u7684\u3002\u4E3A\u4F55\u4E0D\u8DDF\u6211\u8BF4\u8BF4\u4F60\u4ECA\u5929\u8FC7\u5F97\u5982\u4F55\uFF1F",
    "patio_Sebastian": "\u6709\u4E8B\u5417\uFF1F\u6211\u5C31\u5728\u8FD9\u6446\u5F04\u4E00\u4F1A\u6211\u7684\u6469\u6258\u8F66\u3002",
    "spring_1": "\u5662\u2026\u2026\u6211\u7684\u5934\u3002\u65B0\u5E74\u5FEB\u4E50\u2026\u2026$h",
    "spring_12": "\u660E\u5929\u7684\u8282\u65E5\u6709\u6CA1\u6709\u8BA9\u4F60\u611F\u5230\u5174\u594B\uFF1F\u80FD\u518D\u89C1\u5230\u5C71\u59C6\u771F\u662F\u592A\u68D2\u5566\u3002",
    "spring_23": "\u5662\u2026\u2026\u660E\u5929\u662F\u82B1\u821E\u8282\uFF0C\u4E0D\u662F\u5417\uFF1F\u6211\u4EEC\u5FC5\u987B\u5F97\u53BB\u5417\uFF1F#$e#\u6211\u8BA8\u538C\u7A7F\u7740\u53EF\u7B11\u53C8\u7D27\u7EF7\u7684\u8FDE\u8EAB\u8863\u3002\u4E3A\u4EC0\u4E48\u5218\u6613\u65AF\u8BA9\u6211\u4EEC\u8FD9\u6837\u505A\uFF1F$s",
    "summer_1": "\u590F\u5929\u6765\u4E86\u2026\u2026\u5982\u679C\u6211\u60F3\u8BA9\u76AE\u80A4\u4E00\u76F4\u8FD9\u4E48\u767D\uFF0C\u5C31\u8981\u6D82\u5F88\u539A\u7684\u9632\u6652\u971C\u2026\u2026",
    "summer_10": "\u4F60\u60F3\u597D\u5728\u5BB4\u4F1A\u7684\u6C64\u91CC\u9762\u653E\u4EC0\u4E48\u4E86\u5417\uFF1F#$e#\u6211\u4E0D\u77E5\u9053\u653E\u4EC0\u4E48\u597D\u2026\u2026\u4F60\u624D\u662F\u53A8\u5E08\uFF01$7",
    "summer_27": "\u5929\u6C14\u5F00\u59CB\u8F6C\u51C9\u4E86\u3002\u8FD9\u611F\u89C9\u68D2\u6781\u4E86\u3002#$e#\u660E\u665A\u6211\u4EEC\u8981\u4E0D\u8981\u53BB\u53C2\u52A0\u8282\u65E5\uFF1F\u5B9E\u9645\u4E0A\u6211\u5F88\u559C\u6B22\u8FD9\u4E2A\u4F20\u7EDF\u3002$7",
    "winter_1": "\u4ECA\u5E74\u51AC\u5929\u4F60\u6709\u4EC0\u4E48\u8BA1\u5212\uFF1F\u6211\u77E5\u9053\u4F60\u5728\u51AC\u5929\u8FC7\u5F97\u6BD4\u8F83\u8F7B\u677E\u3002",
    "winter_28": "\u4ECA\u5E74\u8FC7\u5F97\u771F\u68D2\uFF0C@\u3002\u6211\u4EEC\u5E94\u8BE5\u7A0D\u7A0D\u5E86\u795D\u4E00\u4E0B\u3002[346]$h#$e#\u6211\u76F8\u4FE1\u660E\u5E74\u4F1A\u66F4\u597D\u3002$7",
    "winter_7": "\u4F60\u8981\u53C2\u52A0\u4ECA\u5E74\u7684\u9493\u9C7C\u5927\u8D5B\u5417\uFF1F"
  }
}