    "winter_Mon8": "\u661F\u9732\u8C37\u8981\u662F\u80FD\u6696\u548C\u4E00\u4E9B\u5C31\u597D\u4E86\u3002#$e#\u6211\u53EF\u4EE5\u642C\u5230\u522B\u7684\u5730\u65B9\uFF0C\u4F46\u662F\u2026\u2026",
    "winter_Sat": "\u51AC\u5929\u7684\u552F\u4E00\u597D\u5904\u5C31\u662F\u6211\u53EF\u4EE5\u591A\u7761\u4E00\u4F1A\u3002#$e#\u6211\u6BCF\u5929\u665A\u4E0A\u8981\u7761 10 \u5C0F\u65F6\u3002",
    "winter_Sat8": "\u51AC\u5929\u4F60\u5C31\u4E0D\u7528\u592A\u64CD\u52B3\u4E86\uFF0C\u771F\u662F\u633A\u597D\u5462\u3002#$e#\u80FD\u4F11\u606F\u4E00\u4E0B\u5F88\u4E0D\u9519\u5427\uFF1F",
    "winter_Sun": "\u4F60\u80FD\u5E2E\u6211\u53BB\u8DDF\u4E9A\u5386\u514B\u65AF\u6253\u4E2A\u62DB\u547C\u5417\uFF1F#$e#\u8C22\u8C22\u4F60\u3002",
    "winter_Sun10": "@\uFF0C\u4F60\u4ECA\u5929\u7CBE\u795E\u4E0D\u9519\u554A\uFF0C\u6211\u559C\u6B22\u3002^@\uFF0C\u4F60\u4ECA\u5929\u5F88\u6F02\u4EAE\u561B\u3002#$e#\u2026\u2026$h",
    "winter_Sun6": "\u55EF\uFF0C\u4F60\u8981\u662F\u89C1\u5230\u4E9A\u5386\u514B\u65AF\uFF0C\u9EBB\u70E6\u8DDF\u4ED6\u8BF4\u58F0\u6211\u4ECA\u5929\u5F88\u5FD9\uFF0C\u597D\u5417\uFF1F#$e#\u8C22\u8C22\u4F60\u3002",
    "winter_Thu": "\u6211\u8981\u5F00\u59CB\u5199\u4E00\u4EFD\u660E\u5E74\u6625\u5929\u6211\u9700\u8981\u7684\u8863\u670D\u6E05\u5355\u3002",
    "winter_Thu6": "\u4E5F\u8BB8\u4ECA\u5E74\u6625\u5929\u6211\u8981\u6350\u51FA\u4E00\u4E9B\u88D9\u5B50\u3002#$e#\u6211\u4F30\u6478\u6211\u73B0\u5728\u5F97\u6709 1000 \u591A\u6761\u88D9\u5B50\u4E86\u3002$h#$e#\u2026\u2026\u4EC0\u4E48\uFF1F",
    "winter_Tue": "\u55E8\u3002\u6709\u4EC0\u4E48\u9700\u8981\u7684\u5417\uFF1F#$e#\u2026\u2026",
    "winter_Tue2": "\u4F60\u53EB@\uFF0C\u5BF9\u5427\uFF1F#$e#\u6211\u603B\u8BB0\u4E0D\u4F4F\u3002",
    "winter_Tue4": "\u55E8\uFF0C@\u3002#$e#\u519C\u573A\u4E0A\u6709\u4EC0\u4E48\u597D\u73A9\u7684\u4E8B\u5417\uFF1F",
    "winter_Wed": "\u771F\u5E0C\u671B\u6709\u4EBA\u80FD\u7ED9\u6211\u5E26\u676F\u8584\u8377\u5473\u7684\u5496\u5561\u3002$s#$e#\u4E0D\u7528\u9EBB\u70E6\u4E86\uFF0C\u6211\u77E5\u9053\u4F60\u505A\u4E0D\u51FA\u6765\u3002",
    "winter_Wed6": "\u6211\u597D\u50CF\u5F00\u59CB\u660E\u767D\u4E86\uFF0C\u8863\u670D\u5E76\u4E0D\u662F\u6700\u91CD\u8981\u7684\u3002\u4F60\u8BF4\u662F\u5427\uFF1F#$e#\u4E0D\u8FC7\u6211\u8FD8\u662F\u5F88\u559C\u6B22\u8863\u670D\u3002\u7A0D\u5FAE\u6253\u626E\u4E00\u4E0B\u81EA\u5DF1\u6709\u4EC0\u4E48\u4E0D\u597D\u5462\uFF1F"
  }
}