    "Event_room3": "\u54C8\uFF1F\u673A\u5668\u4EBA\u662F\u4EC0\u4E48\uFF1F",
    "FlowerDance_Accept": "\u554A\u2026\u2026\u4F60\u662F\u60F3\u9080\u8BF7\u672C\u5C0F\u59D0\u8DF3\u821E\u5417\uFF1F$13^\u554A\uFF1F\u597D\u5440\uFF01\u6211\u53EF\u4EE5\u8DDF\u4F60\u8DF3\u821E\uFF01#$b#\u563B\u563B\u2026\u2026\u5F53\u7136\u53EF\u4EE5\uFF0C\u6211\u5F88\u4E50\u610F\u505A\u4F60\u7684\u821E\u4F34\u3002$h^\u6211\u4EEC\u73A9\u4E2A\u75DB\u5FEB\u5427\uFF01$h#$e#\u5514\u2026\u2026\u4F60\u633A\u81EA\u4FE1\u7684\uFF0C\u6211\u5F88\u6B23\u8D4F\u3002\u5176\u4ED6\u7537\u751F\u592A\u5BB3\u7F9E\u4E86\uFF0C\u90FD\u4E0D\u6562\u9080\u8BF7\u6211\u3002^\u4F60\u4ECA\u5929\u771F\u7684\u597D\u6F02\u4EAE\uFF01$h",
    "FlowerDance_Accept_Spouse": "*\u5509*\u2026\u2026\u6211\u662F\u82B1\u5973\u738B\u7684\u65F6\u4EE3\u5DF2\u7ECF\u7ED3\u675F\u4E86\u2026\u2026\u6240\u4EE5\u5BF9\u6211\u6765\u8BF4\u8FD9\u662F\u4E00\u6B21\u82E6\u4E50\u53C2\u534A\u7684\u821E\u8E48\u3002$s#$b#\u4F46\u662F\uFF0C\u662F\u7684\u2026\u2026",
    "FlowerDance_Decline": "\u989D\u2026\u2026\u4E0D\u3002",
    "Fri": "%\u6D77\u8389\u6CA1\u6709\u7406\u4F60\u3002",
    "Fri10": "@\uFF0C\u6211\u4EEC\u6709\u7A7A\u53BB\u91CE\u8425\u5427\uFF1F#$e#\u6211\u53BB\u8FC7\u7684\u6700\u602A\u5F02\u7684\u5730\u65B9\u5C31\u662F\u7956\u7956\u57CE\u4E86\u3002",
    "Fri2": "\u4F60\u6210\u5929\u5728\u519C\u573A\u5FD9\u6D3B\u6765\u5FD9\u6D3B\u53BB\uFF0C\u5C31\u4E0D\u89C9\u5F97\u65E0\u804A\u5417\uFF1F#$e#\u6D51\u8EAB\u5F04\u5F97\u810F\u516E\u516E\u7684\uFF0C\u6211\u53EF\u5FCD\u4E0D\u4E86\u3002#$e#\u4F60\u7684\u76AE\u80A4\u4E00\u5B9A\u5DF2\u7ECF\u6652\u6210\u5C0F\u9EA6\u8272\u4E86\u5427\uFF1F",
    "Fri6": "\u6211\u5F97\u627E\u627E\u9664\u4E86\u8D2D\u7269\u4E4B\u5916\u7684\u7231\u597D\u4E86\u3002#$e#\u6211\u5F97\u5F00\u9614\u4E0B\u773C\u754C\u3002#$e#\u4E5F\u8BB8\u6211\u8BE5\u5B66\u5B66\u8FF7\u4F60\u7AD6\u7434\uFF1F",
    "GreenRain": "\u6211\u597D\u50CF\u8FD8\u6CA1\u6765\u8FC7\u8FD9\u91CC\uFF0C\u8FD8\u633A\u8212\u670D\u7684\uFF01$h#$e#\u554A\uFF0C\u6211\u4E0D\u662F\u5F88\u62C5\u5FC3\u8FD9\u573A\u96E8\uFF0C\u80AF\u5B9A\u4F1A\u505C\u7684\u3002",
    "GreenRain_2": "\u5047\u5982\u4E0B\u7C89\u8272\u7684\u96E8\u518D\u53EB\u9192\u6211\u5427\u2026\u2026\u80FD\u4E0B\u7C89\u8272\u7684\u86CB\u7CD5\u96E8\u90A3\u5C31\u66F4\u597D\u4E86\uFF01",
    "Introduction": "\u5662\u2026\u2026\u4F60\u5C31\u662F\u90A3\u4E2A\u65B0\u6765\u7684\u519C\u592B\u5427\uFF1F^\u5662\u2026\u2026\u4F60\u5C31\u662F\u90A3\u4E2A\u65B0\u6765\u7684\u519C\u573A\u59D1\u5A18\u5427\uFF1F#$e#\u54C8\uFF1F\u5662\u2026\u2026\u6211\u662F\u6D77\u8389\u3002#$e#\u55EF\u2026\u2026\u8981\u4E0D\u662F\u4F60\u90A3\u8EAB\u8863\u670D\uFF0C\u4F60\u5E94\u8BE5\u8FD8\u633A\u53EF\u7231\u7684\u5427\u3002^\u55EF\u2026\u2026\u8981\u4E0D\u662F\u4F60\u90A3\u8EAB\u8863\u670D\uFF0C\u4F60\u5E94\u8BE5\u8FD8\u633A\u6F02\u4EAE\u7684\u5427\u3002\u2026\u2026\u5443\uFF0C\u522B\u4ECB\u610F\u3002$h",
    "Mon": "\u5C0F\u9547\u592A\u5C0F\u4E86\u3002\u6CA1\u610F\u601D\u3002$u#$e#\u6211\u5F97\u5F00\u8F66\u53BB\uFF0C\u5927\u6982\uFF0C20 \u82F1\u91CC\u53BB\u4E70\u5F97\u4F53\u7684\u670D\u88C5\u3002$s#$e#\u8FD9\u5C31\u662F\u4E3A\u4EC0\u4E48\u6211\u4E00\u822C\u7F51\u8D2D\u3002#$e#\u4EC0\u4E48\uFF1F",
    "Mon6": "\u6211\u4EE5\u524D\u8001\u662F\u62B1\u6028\u8FD9\u4E2A\u9547\u592A\u5C0F\u4E86\uFF0C\u4F46\u662F\u6211\u8D8A\u6765\u8D8A\u559C\u6B22\u5B83\u4E86\u3002#$e#\u5047\u5982\u592A\u5927\u7684\u8BDD\uFF0C\u5C31\u4E0D\u4F1A\u6709\u5F52\u5C5E\u611F\u4E86\u3002",
    "Resort": "\u771F\u662F\u5B8C\u7F8E\u7684\u6D77\u6EE9\u3002\u8981\u662F\u53EF\u4EE5\u7684\u8BDD\uFF0C\u6211\u613F\u610F\u6C38\u8FDC\u5F85\u5728\u8FD9\u91CC\uFF01",
    "Resort_Bar": "\u683C\u65AF\u4E3A\u6211\u7279\u5236\u4E86\u4E00\u6B3E\u53EF\u7231\u7684\u679C\u996E\uFF01$h",
