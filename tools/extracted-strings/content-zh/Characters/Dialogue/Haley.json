    "Resort_Entering": "\u6211\u6765\u7684\u65F6\u5019\u770B\u89C1\u6D77\u8C5A\u4E86\uFF01",
    "Resort_Leaving": "\u6652\u7740\u592A\u9633\u83AB\u540D\u5730\u8BA9\u6211\u89C9\u5F97\u5F88\u8212\u670D\u3002",
    "Resort_Shore": "\u6D3B\u4E45\u4E86\u603B\u662F\u80FD\u89C1\u5230\u5404\u79CD\u5947\u7279\u7684\u5730\u65B9\u2026\u2026\u8C01\u77E5\u9053\u5728\u6B64\u4E4B\u5916\u7684\u5730\u65B9\u53C8\u662F\u4EC0\u4E48\u6837\u5462\uFF1F",
    "Resort_Shore_2": "\u54C7\u54E6\uFF0C\u770B\u770B\u5730\u5E73\u7EBF\u4E0A\u7684\u9633\u5149\u591A\u4E48\u8000\u773C\uFF01$h#$b#\u8FD9\u91CC\u7684\u65E5\u843D\u80AF\u5B9A\u53EF\u4EE5\u62CD\u51FA\u60CA\u8273\u7684\u7167\u7247\u3002#$e#\u4E0B\u6B21\u6765\u5F97\u8BB0\u5F97\u5E26\u4E0A\u76F8\u673A\u3002",
    "Resort_Towel": "\u8981\u6652\u6210\u5B8C\u7F8E\u7684\u68D5\u8910\u8272\u76AE\u80A4\u662F\u4E00\u95E8\u827A\u672F\u6D3B\u2026\u2026#$e#\u6709\u70B9\u50CF\u70E4\u68C9\u82B1\u7CD6\u2026\u2026\u4F60\u65CB\u8F6C\u8EAB\u4F53\u7684\u8282\u594F\u5F97\u521A\u521A\u597D\u3002$h",
    "Resort_Towel_2": "\u8EBA\u5728\u70ED\u5E26\u6D77\u6EE9\u4E0A\u2026\u2026#$b#\u5509\u2026\u2026\u6211\u60F3\u6211\u7EC8\u4E8E\u5728\u5B87\u5B99\u4E2D\u627E\u5230\u4E86\u81EA\u5DF1\u7684\u4F4D\u7F6E\u3002#$e#\u4F46\u6211\u89C9\u5F97\u661F\u9732\u8C37\u4E5F\u662F\u4E2A\u4E0D\u9519\u7684\u5730\u65B9\uFF01$h",
    "Resort_Towel_3": "\u8FD9\u4EF6\u6CF3\u8863\u662F\u827E\u7C73\u4E3D\u7684\u670B\u53CB\u4ECE\u7956\u7956\u57CE\u5BC4\u7ED9\u6211\u7684\u3002#$e#\u5927\u57CE\u5E02\u7684\u65F6\u5C1A\u5C42\u6B21\u5C31\u662F\u4E0D\u4E00\u6837\uFF0C\u662F\u4E0D\u662F\uFF1F$h",
    "Sat": "\u6211\u597D\u60F3\u53BB\u4E70\u4E70\u4E70\u554A\uFF01\u554A\uFF01\u771F\u5E0C\u671B\u80FD\u6709\u4E2A\u5927\u578B\u5546\u573A\u3002",
    "Sat8": "#$1 haleySeagull#\u6628\u5929\u6211\u53D1\u73B0\u4E00\u53EA\u7FC5\u8180\u88AB\u7F51\u7F20\u4F4F\u7684\u6D77\u9E25\u3002\u5F53\u7136\uFF0C\u6211\u628A\u5B83\u7ED9\u653E\u4E86\u3002\u5B83\u770B\u8D77\u6765\u597D\u65E0\u52A9\uFF0C\u53EF\u601C\u7684\u5C0F\u4E1C\u897F\u3002$k$s#$e#\u6216\u8BB8\u6211\u5E94\u8BE5\u591A\u953B\u70BC\u953B\u70BC\u4E86\u2026\u2026\u6C38\u8446\u9752\u6625\u4EC0\u4E48\u7684\u6BD5\u7ADF\u90FD\u662F\u5F02\u60F3\u5929\u5F00\u554A\u3002",
    "Sun": "\u6211\u59D0\u59D0\u597D\u5947\u602A\u3002\u6709\u65F6\u5019\u6211\u90FD\u6000\u7591\u6211\u4EEC\u662F\u5426\u6709\u8840\u7F18\u5173\u7CFB\u3002$u",
    "Sun6": "\u6211\u60F3\u6350\u4E00\u4E9B\u8863\u7269\u2026\u2026\u6211\u7684\u978B\u5B50\u4F30\u8BA1\u5F97\u6709\u4E00\u767E\u6765\u53CC\u4E86\u3002",
    "Thu": "#$1 HaleyClothes#\u6211\u51B3\u5B9A\u4E86\uFF0C\u4ECA\u5929\u6211\u628A\u6211\u7684\u8863\u670D\u6574\u7406\u6574\u7406\u3002\u6211\u8981\u628A\u53BB\u5E74\u7684\u6B3E\u5F0F\u90FD\u6254\u4E86\u7ED9\u65B0\u6B3E\u817E\u51FA\u7A7A\u95F4\uFF01#$e#*\u5509*\u6211\u597D\u60F3\u53BB\u5403\u5C0F\u86CB\u7CD5\u554A\u3002#$e#\u4F60\u6709\u4EC0\u4E48\u9700\u8981\u7684\u4E48\uFF1F",
    "Thu6": "\u6211\u6628\u665A\u505A\u4E86\u665A\u9910\u3002\u611F\u89C9\u8FD8\u4E0D\u9519\uFF01#$e#\u4F46\u662F\u6211\u628A\u53A8\u623F\u641E\u5F97\u4E00\u56E2\u7CDF\u2026\u2026",
    "Tue": "\u4E0D\u9519\u7684\u978B\u5B50\u3002^\u4E0D\u9519\u7684\u6837\u5F0F\u3002#$b#\u662F\u7528\u5851\u6599\u505A\u7684\u5417\uFF1F^\u54E6\u7B49\u7B49\u2026\u2026\u4F60\u7A7F\u4E86\uFF1F#$e#\u6211\u597D\u65E0\u804A\u3002",
    "Tue2": "\u4ECA\u65E9\u6D77\u6EE9\u4F1A\u6709\u7F8E\u4E3D\u7684\u8D1D\u58F3\u88AB\u51B2\u4E0A\u6765\u5417\uFF1F#$e#\u867D\u7136\u73B0\u5728\u4E0D\u662F\u4E00\u5E74\u4E2D\u6361\u8D1D\u58F3\u7684\u6700\u597D\u65F6\u8282\u3002",
