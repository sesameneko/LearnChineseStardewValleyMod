    "eventSeen_94": "\u4E0A\u6B21\u4F60\u5E26\u6765\u7684\u90A3\u6761\u9C7C\uFF0C\u771F\u7684\u5F88\u611F\u8C22\uFF01\u90A3\u662F\u6211\u4EEC\u6700\u8FD1\u5C1D\u5230\u7684\u6700\u7F8E\u5473\u7684\u9C7C\u4E86\u3002",
    "fall_Mon6": "\u6211\u5E94\u8BE5\u591A\u73CD\u60DC\u798F\u6C14\u7684\uFF0C\u6BD5\u7ADF\u6211\u4EEC\u5DF2\u7ECF\u8FC7\u5F97\u5F88\u597D\u4E86\uFF0C\u6709\u4E9B\u4EBA\u8FD8\u662F\u7F3A\u8863\u5C11\u98DF\u3002$s",
