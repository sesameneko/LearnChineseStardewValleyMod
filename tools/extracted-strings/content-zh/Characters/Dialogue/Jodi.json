    "2_1": "\u6211\u4E08\u592B\u80AF\u7279\u662F\u4F4D\u58EB\u5175\uFF0C\u5728\u6D77\u5916\u670D\u5F79\u3002\u56E0\u6B64\u4ED6\u73B0\u5728\u4E0D\u5728\u3002#$b#\u4ED6\u670D\u5F79\u5B8C\u4E86\u540E\u4E00\u5B9A\u4F1A\u5B89\u5168\u5F52\u6765\u7684\uFF01\uFF01\uFF01#$e#\u9700\u8981\u4EC0\u4E48\u5417\uFF1F",
    "AcceptGift_(O)StardropTea": "\u554A\u2026\u2026\u4F60\u786E\u5B9A\u8981\u9001\u8FD9\u4E48\u73CD\u8D35\u7684\u4E1C\u897F\u5417\uFF1F\u597D\u5427\uFF0C\u8C22\u8C22\u4F60\uFF01",
    "Fri": "$d Joja#Joja \u8D85\u5E02\u7684\u98DF\u7269\u867D\u8BF4\u53EF\u80FD\u4E0D\u662F\u7279\u522B\u5065\u5EB7\uFF0C\u4F46\u662F\u90A3\u4E48\u4F4E\u7684\u4EF7\u683C\u771F\u662F\u8BA9\u4EBA\u53D1\u75AF|\u76AE\u57C3\u5C14\u5546\u5E97\u7684\u98DF\u7269\u6BD4 Joja \u8D85\u5E02\u7684\u66F4\u65B0\u9C9C\u4E5F\u66F4\u5065\u5EB7\u3002\u4F46\u6211\u786E\u5B9E\u6000\u5FF5 Joja \u8D85\u5E02\u7684\u4EF7\u683C\u3002",
    "GreenRain": "\u4F60\u6CA1\u4E8B\u5417\uFF1F\u6211\u4EEC\u4EE5\u524D\u4ECE\u6765\u6CA1\u89C1\u8FC7\u8FD9\u79CD\u60C5\u51B5\u2026\u2026$s#$e#\u8981\u662F\u6211\u8001\u516C\u5728\u5C31\u597D\u4E86\uFF0C\u4ED6\u80AF\u5B9A\u77E5\u9053\u8BE5\u600E\u4E48\u529E\u3002$s",
    "GreenRain_2": "\u6587\u68EE\u7279\u4E00\u5927\u65E9\u5C31\u8DD1\u5230\u96E8\u91CC\u73A9\u53BB\u4E86\uFF0C\u4F46\u613F\u4ED6\u4EEC\u8BF4\u8FD9\u573A\u96E8\u5B8C\u5168\u65E0\u5BB3\u662F\u771F\u7684\uFF01",
    "Introduction": "\u5662\uFF01\u4F60\u548C\u6211\u60F3\u8C61\u4E2D\u7684\u6709\u70B9\u4E0D\u4E00\u6837\u5462\u2026\u2026\u4F46\u662F\u6CA1\u5173\u7CFB\uFF01\u6211\u662F\u4E54\u8FEA\u3002#$e#\u8FD9\u662F\u4E2A\u5B81\u9759\u7684\u5C0F\u9547\uFF0C\u6240\u4EE5\u80FD\u6709\u4EBA\u642C\u8FDB\u6765\u771F\u7684\u8BA9\u4EBA\u9AD8\u5174\u5462\uFF01\u6709\u4E2A\u519C\u573A\u4E3B\u786E\u5B9E\u53EF\u4EE5\u6539\u53D8\u5F88\u591A\u4E8B\u3002",
    "Mon": "\u7EF4\u6301\u4E00\u4E2A\u5BB6\u5EAD\u662F\u5F88\u4E0D\u5BB9\u6613\u7684\u4E8B\u2026\u2026\u4F46\u662F\u603B\u5F97\u6709\u4EBA\u505A\u5427\u3002#$e#\u600E\u4E48\u4E86\uFF1F",
    "Mon2": "$d kent#\u6628\u5929\u6211\u53BB\u4E86\u7531\u5DF4\u796D\u575B\u611F\u8C22\u6211\u4E08\u592B\u80FD\u5E73\u5B89\u5F52\u6765\u3002|\u6628\u5929\u6211\u53BB\u4E86\u7531\u5DF4\u796D\u575B\u7948\u6C42\u6211\u4E08\u592B\u80FD\u5E73\u5B89\u5F52\u6765\u3002#$e#\u6211\u4E5F\u60F3\u4FDD\u6301\u4E50\u89C2\uFF0C\u4F46\u662F\u6709\u65F6\u611F\u89C9\u592A\u96BE\u4E86\u3002$s",
    "Mon6": "\u6709\u4E2A\u5BB6\u786E\u5B9E\u633A\u597D\u7684\u2026\u2026\u4F46\u662F\u5982\u679C\u6211\u8BF4\u6211\u4ECE\u4E0D\u6E34\u671B\u5E74\u8F7B\u65F6\u7684\u81EA\u7531\u80AF\u5B9A\u662F\u5728\u6492\u8C0E\u2026\u2026$s",
