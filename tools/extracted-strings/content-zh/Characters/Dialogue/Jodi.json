    "pamHouseUpgradeAnonymous": "\u4F60\u770B\u5230\u6F58\u59C6\u7684\u65B0\u623F\u5B50\u4E86\u5417\uFF1F\u597D\u5BB6\u4F19\u2026\u2026\u8981\u662F\u6211\u4E5F\u6709\u8FD9\u4E48\u591A\u94B1\u5C31\u597D\u4E86\u2026\u2026\u597D\u6B79\u80FD\u628A\u53A8\u623F\u91CD\u65B0\u88C5\u4FEE\u4E00\u4E0B\u2026\u2026$s",
    "reject_864": "\u8FD9\u662F\u4EC0\u4E48\uFF1F\u770B\u8D77\u6765\u50CF\u662F\u80AF\u7279\u7684\u4E00\u4F4D\u6218\u53CB\u3002\u4E5F\u8BB8\u4F60\u5E94\u8BE5\u628A\u8FD9\u4E2A\u62FF\u53BB\u7ED9\u4ED6\u770B\u770B\uFF1F",
