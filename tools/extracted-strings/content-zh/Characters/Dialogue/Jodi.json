    "Resort_Bar": "\u683C\u65AF\u5728\uFF0C\u6211\u4EEC\u5C31\u5F88\u5F00\u5FC3\u3002",
    "Resort_Entering": "\u591A\u4E48\u4EAB\u53D7\u554A\uFF01",
    "Resort_Leaving": "\u6211\u4ECA\u665A\u5927\u6982\u4F1A\u505A\u6D77\u9C9C\u3002$h",
    "Sat": "\u55E8\u3002#$e#\u9700\u8981\u4EC0\u4E48\u5417\uFF1F",
    "Sat4": "\u4F60\u80FD\u52A8\u624B\u53BB\u7FFB\u65B0\u90A3\u5EA7\u7834\u65E7\u7684\u519C\u573A\u771F\u662F\u592A\u597D\u4E86\u3002#$e#\u7B49\u4F60\u5F04\u5F97\u5DEE\u4E0D\u591A\u4E86\uFF0C\u6211\u4EEC\u5927\u5BB6\u4E5F\u90FD\u80FD\u8DDF\u7740\u53D7\u76CA\u5462\uFF01$h#$e#\u5F53\u7136\uFF0C\u4E5F\u53EF\u662F\u4E2A\u5927\u5DE5\u7A0B\u3002#$e#\u518D\u89C1\u3002",
    "Sun": "#$c .5#\u4ECA\u5929\u4E0D\u505A\u5BB6\u52A1\u6D3B\u4E86\uFF0C\u6211\u8981\u4F11\u606F\u4E00\u4E0B\u3002$h#$e#\u6211\u4ECA\u5929\u4F11\u606F\u3002$h#$e#\u6211\u518D\u4E0D\u51FA\u53BB\u5F85\u4F1A\u6211\u5C31\u8981\u75AF\u4E86\uFF01#$e#\u518D\u8BF4\uFF0C\u6211\u4E5F\u4E0D\u60F3\u9AA8\u5934\u751F\u9508\u3002",
    "Sun8": "\u6211\u68A6\u5230\u6211\u5F7B\u5E95\u81EA\u7531\u4E86\uFF0C\u9664\u4E86\u81EA\u5DF1\u4EE5\u5916\uFF0C\u5BF9\u4EFB\u4F55\u4EBA\u90FD\u6CA1\u6709\u4E49\u52A1\u2026\u2026#$b#\u2026\u2026\u2026\u2026\u7136\u540E\u6211\u68A6\u9192\u4E86\u5E76\u610F\u8BC6\u5230\u6211\u773C\u524D\u6709\u4E00\u5806\u5BB6\u52A1\u6D3B\u513F\u2026\u2026$s#$e#\u4F46\u6211\u4E0D\u540E\u6094\u6709\u4E00\u4E2A\u5BB6\u5EAD\uFF0C@\u2026\u2026\u5C71\u59C6\u548C\u6587\u68EE\u5BF9\u6211\u6765\u8BF4\u610F\u5473\u7740\u4E00\u5207\uFF01",
    "Thu": "\u4F60\u662F\u4F4D\u519C\u592B\uFF0C\u662F\u5427\uFF1F\u6709\u610F\u601D\u3002#$e#\u6211\u7B2C\u4E00\u6B21\u8BA4\u8BC6\u519C\u592B\u3002#$e#\u4E5F\u8BB8\u4EE5\u540E\u4F60\u53EF\u4EE5\u6559\u6211\u600E\u4E48\u79CD\u83DC\u3002$h",
    "Thu6": "\u65F6\u95F4\u90FD\u53BB\u54EA\u4E86\uFF1F*\u5509*#$e#\u6211\u8FD8\u8BB0\u5F97\u5C71\u59C6\u5C0F\u65F6\u5019\u7A7F\u5C3F\u5E03\u7684\u6837\u5B50\u5462\u3002\u4ED6\u90A3\u65F6\u591A\u53EF\u7231\u3002$s#$e#\u4F60\u53EF\u522B\u544A\u8BC9\u4ED6\u6211\u8BF4\u8FC7\u8FD9\u8BDD\u3002$h#$e#\u4F60\u4E00\u5B9A\u5F88\u7231\u8DDF\u6211\u804A\u5929\u5427\uFF1F",
