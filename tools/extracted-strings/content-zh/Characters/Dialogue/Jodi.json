    "summer_Tue": "\u4F60\u597D\u3002#$e#\u4F60\u9700\u8981\u4EC0\u4E48\uFF1F\u6211\u6709\u70B9\u5FD9\u3002",
    "summer_Tue_inlaw_Sam": "\u6211\u7684\u5C0F\u8428\u7C73\u5728\u65E7\u519C\u573A\u91CC\u5E72\u5F97\u600E\u4E48\u6837\uFF1F$h",
    "winter_Fri": "\u611F\u89C9\u5076\u5C14\u4F11\u4F11\u5047\u4E5F\u4F1A\u633A\u4E0D\u9519\u7684\u2026\u2026$s",
    "winter_Mon": "\u6211\u5C0F\u65F6\u5019\u5F88\u559C\u6B22\u73A9\u96EA\u3002\u5F53\u5988\u5988\u6700\u5927\u7684\u597D\u5904\u4E4B\u4E00\u5C31\u662F\u6211\u80FD\u591F\u91CD\u6E29\u513F\u65F6\u7684\u56DE\u5FC6\u3002$h",
    "winter_Sun": "\u5982\u679C\u6211\u6709\u94B1\u4E86\uFF0C\u6211\u8981\u505A\u7684\u7B2C\u4E00\u4EF6\u4E8B\u5C31\u662F\u96C7\u4E00\u540D\u5973\u4EC6\u548C\u4E00\u540D\u53A8\u5E08\u3002#$e#\u6211\u7684\u5929\u554A\uFF0C\u60F3\u60F3\u5C31\u5F88\u7F8E\uFF01$h",
    "winter_Thu": "\u5C71\u59C6\u7684\u97F3\u4E50\u592A\u5435\u4E86\u3002\u6211\u5E0C\u671B\u4E0D\u4F1A\u6253\u6270\u5230\u90BB\u5C45\u4EEC\u3002",
    "winter_Thu8": "\u56E0\u4E3A\u80AF\u7279\u662F\u519B\u4EBA\uFF0C\u4EE5\u53CA\u5176\u4ED6\u79CD\u79CD\u539F\u56E0\uFF0C\u6211\u4EEC\u6709\u70B9\u50CF\u662F\u95EA\u5A5A\u2026\u2026\u6211\u51E0\u4E4E\u6CA1\u6709\u611F\u53D7\u8FC7\u9752\u6625\u548C\u81EA\u7531\uFF0C\u73B0\u5728\u5DF2\u7ECF\u56DE\u4E0D\u53BB\u4E86\u3002$s#$e#\u6211\u4E0D\u6562\u76F8\u4FE1\u5BF9\u4F60\u8BF4\u4E86\u8FD9\u4E9B\u3002$4",
    "winter_Thu_inlaw_Sam": "\u5C71\u59C6\u600E\u4E48\u6837\uFF1F\u6211\u5FC5\u987B\u627F\u8BA4\uFF0C\u81EA\u4ECE\u4ED6\u642C\u51FA\u53BB\u540E\u5F88\u5C11\u9700\u8981\u505A\u996D\u548C\u6253\u626B\u4E86\u2026\u2026",
    "winter_Tue": "\u55E8\u3002\u4EBA\u4EEC\u603B\u662F\u95EE\u4F60\u519C\u573A\u7684\u4E8B\u60C5\uFF0C\u4F60\u4F1A\u4E0D\u4F1A\u89C9\u5F97\u70E6\uFF1F#$e#\u8981\u662F\u6211\u7684\u8BDD\u6211\u80AF\u5B9A\u4F1A\u3002",
    "winter_Tue6": "*\u5509* \u2026\u2026\u6709\u65F6\u5019\u6211\u4F1A\u68A6\u5230\u81EA\u5DF1\u5B64\u8EAB\u4E00\u4EBA\u2026\u2026\u6CA1\u6709\u4E00\u4E2A\u9700\u8981\u7167\u987E\u7684\u5BB6\u3002\u8FD9\u542C\u8D77\u6765\u5F88\u6050\u6016\u5417\uFF1F$s#$e#\u4E0D\u8981\u544A\u8BC9\u4EFB\u4F55\u4EBA\u54E6\u3002$4",
    "winter_Wed2": "\u6211\u662F\u600E\u4E48\u627E\u4E50\u5B50\u7684\uFF1F\u55EF\u2026\u2026\u8FD9\u662F\u4E2A\u597D\u95EE\u9898\u3002#$e#\u6211\u559C\u6B22\u7761\u89C9\u3002$s",
    "winter_Wed4_2": "\u80AF\u7279\u5DF2\u7ECF\u5728\u5BB6\u5446\u4E86\u4E00\u6BB5\u65F6\u95F4\u4E86\uFF0C\u4F46\u4ED6\u8FD8\u662F\u4E00\u526F\u5FC3\u795E\u4E0D\u5B81\u7684\u6837\u5B50\u3002$s"
  }
