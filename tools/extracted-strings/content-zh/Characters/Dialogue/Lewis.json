    "Fri": "\u6211\u5E0C\u671B%farm\u519C\u573A\u4E0A\u4E00\u5207\u90FD\u597D\u3002\u6211\u4E0D\u60F3\u770B\u5230\u5B83\u5E72\u900F\u4E86\u7684\u6837\u5B50\u3002",
    "GreenRain": "\u6211\u521A\u521A\u6253\u7535\u8BDD\u8DDF\u5DDE\u957F\u786E\u8BA4\u4E86\u2026\u2026\u636E\u8BF4\u8FD9\u573A\u96E8\u662F\u5B8C\u5168\u65E0\u5BB3\u7684\uFF0C\u53EA\u662F\u5927\u81EA\u7136\u7684\u4E00\u79CD\u5947\u5F02\u73B0\u8C61\u3002#$b#\u4E0D\u8FC7\u9547\u4E0A\u8FD8\u662F\u6709\u5C45\u6C11\u611F\u5230\u6050\u614C\uFF0C\u8FD9\u5C31\u4E0D\u592A\u597D\u4E86\u2026\u2026",
    "GreenRainFinished": "\u54CE\uFF0C\u4E5F\u7B97\u662F\u8BA9\u6211\u4EEC\u7684\u5C0F\u9547\u8E81\u52A8\u4E86\u4E00\u756A\uFF01\u5E78\u597D\u5927\u5BB6\u90FD\u6CA1\u4E8B\u3002$h#$e#\u5047\u5982\u518D\u53D1\u751F\u4E00\u6B21\u7684\u8BDD\uFF0C\u5927\u5BB6\u5E94\u8BE5\u4F1A\u4ECE\u5BB9\u4E0D\u5C11\u2014\u2014\u8FD9\u53C8\u4E0D\u662F\u4E16\u754C\u672B\u65E5\uFF01",
    "GreenRain_2": "\u6211\u4F30\u8BA1\u8FD9\u79CD\u5947\u602A\u7684\u96E8\u6BCF\u5E74\u90FD\u4F1A\u4E0B\u4E86\u3002\u5927\u5BB6\u610F\u8BC6\u5230\u8FD9\u53EA\u662F\u5927\u81EA\u7136\u7684\u73B0\u8C61\u4E4B\u540E\u5E94\u8BE5\u4E5F\u9547\u5B9A\u4E86\u5F88\u591A\u3002",
    "Introduction": "\u4F60\u5728\u90A3\u4E2A\u7834\u5C4B\u91CC\u8FC7\u7684\u7B2C\u4E00\u665A\u600E\u4E48\u6837\uFF1F#$e#\u4F60\u7237\u7237\u4EE5\u524D\u603B\u662F\u62B1\u6028\u90A3\u5F20\u6643\u6643\u60A0\u60A0\u7684\u65E7\u5E8A\u3002\u4F46\u6211\u89C9\u5F97\uFF0C\u4ED6\u5FC3\u91CC\u5176\u5B9E\u662F\u7231\u7740\u90A3\u95F4\u623F\u5B50\u7684\u3002",
    "Mon": "\u73B0\u5728\u53EF\u662F\u505A\u56ED\u827A\u7684\u597D\u65F6\u8282\u554A\uFF0C\u751A\u81F3\u5BF9\u6211\u4EEC\u8FD9\u4E9B\u4E0D\u662F\u519C\u592B\u7684\u4EBA\u6765\u8BF4\u4E5F\u4E00\u6837\u3002#$e#\u661F\u9732\u8C37\u56E0\u4E3A\u51FA\u4EA7\u6700\u7F8E\u7684\u6625\u5B63\u82B1\u5349\u800C\u51FA\u540D\uFF01$h",
    "Resort": "@\uFF0C\u4F60\u592A\u4E86\u4E0D\u8D77\u4E86\u3002\u4F60\u771F\u7684\u628A\u8FD9\u4E2A\u5730\u65B9\u7ED9\u4FEE\u597D\u4E86\uFF01$h",
    "Resort_Bar": "\u563F\u563F\u2026\u2026\u683C\u65AF\u771F\u662F\u5F97\u5FC3\u5E94\u624B\u554A\u3002",
    "Resort_Chair": "\u563F\u563F\u2026\u2026\u770B\u770B\u8FD9\u5730\u65B9\uFF01\u6211\u4E0D\u77E5\u9053\u4F60\u662F\u600E\u4E48\u505A\u5230\u7684\uFF0C\u6574\u4E2A\u9547\u5B50\u7ADF\u7136\u90FD\u5728\u8BA8\u8BBA\u8FD9\u4E2A\u5C0F\u5C0F\u7684\u5EA6\u5047\u533A\u4E86\u3002$h",
    "Resort_Leaving": "\u5927\u5BB6\u5FEB\u4E0A\u8239\uFF01\u6211\u4EEC\u8981\u56DE\u661F\u9732\u8C37\u4E86\uFF01",
    "Resort_Shore": "\u8FD9\u79CD\u5EA6\u5047\u7684\u673A\u4F1A\u80FD\u591F\u5F88\u6709\u6548\u5730\u5E26\u52A8\u5F53\u5730\u7ECF\u6D4E\uFF01#$e#\u6211\u6700\u597D\u8FD8\u662F\u4E0D\u8981\u5728\u592A\u9633\u91CC\u5F85\u592A\u4E45\uFF0C\u4E0D\u7136\u6211\u7684\u80E1\u5B50\u5C31\u4F1A\u5E72\u6389\u3002",
    "Saloon": "\u665A\u4E0A\u597D\uFF01\u771F\u9AD8\u5174\u770B\u5230\u4F60\u5728\u548C\u9547\u5B50\u91CC\u7684\u4EBA\u804A\u5929\u3002#$b#\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u5C31\u6765\u8FD9\u91CC\u5750\u5750\uFF0C\u542C\u542C\u65B0\u95FB\u4E5F\u633A\u597D\u7684\u3002$h",
    "Saloon4": "\u665A\u4E0A\u597D\uFF0C@\uFF01\u771F\u9AD8\u5174\u770B\u5230\u4F60\u5728\u8FD9\u91CC\u4F11\u606F\u3002\u5076\u5C14\u4F11\u606F\u4F11\u606F\u5BF9\u4F60\u6709\u597D\u5904\u7684\u3002$h#$b#\u4F60\u7684\u7956\u7236\u603B\u662F\u592A\u52AA\u529B\u5DE5\u4F5C\u4E86\u2026\u2026\u6211\u4ECA\u665A\u8981\u591A\u559D\u4E00\u676F\u5564\u9152\uFF0C\u5411\u4ED6\u81F4\u656C\u3002",
    "Saloon_Entry": "\u55E8\uFF0C\u683C\u65AF\uFF01",
    "Sat": "\u5468\u672B\u7684\u65F6\u5019\u5927\u5BB6\u770B\u8D77\u6765\u90FD\u6BD4\u8F83\u5F00\u5FC3\uFF0C\u4F60\u4E0D\u8FD9\u4E48\u89C9\u5F97\u5417\uFF1F#$e#\u7136\u800C\uFF0C\u6211 7 \u5929\u90FD\u5728\u4E0A\u73ED\u3002",
    "Sun": "\u6211\u5728\u9E48\u9E55\u9547\u5F53\u4E86 20 \u591A\u5E74\u7684\u9547\u957F\uFF01#$e#\u9009\u4E3E\u7684\u65F6\u5019\uFF0C\u6CA1\u4E00\u4E2A\u4EBA\u6295\u6211\u7684\u53CD\u5BF9\u7968\u3002\u6211\u89C9\u5F97\u90A3\u610F\u5473\u7740\u6211\u7684\u5DE5\u4F5C\u505A\u5F97\u5F88\u597D\u3002#$e#\u6211\u559C\u6B22\u5F53\u9547\u957F\u3002",
    "Thu": "\u9152\u5427\u665A\u4E0A\u7684\u65F6\u5019\u4F1A\u633A\u70ED\u95F9\u7684\u3002\u6709\u65F6\u5019\u6211\u4EEC\u751A\u81F3\u4F1A\u5F80\u81EA\u52A8\u70B9\u5531\u673A\u91CC\u653E\u4E00\u679A\u786C\u5E01*\u7A83\u7B11*$h#$e#\u4E0D\u7BA1\u600E\u4E48\u6837\uFF0C\u6211\u6BCF\u5468\u90FD\u4F1A\u53BB\u4E00\u6B21\uFF0C\u53BB\u542C\u542C\u522B\u4EBA\u95F2\u804A\u3002",
    "Town_57_40": "#$c .3#\u4F60\u8FD9\u4E48\u65E9\u5C31\u6765\u9547\u5B50\u91CC\u4E86\uFF0C\u55EF\uFF1F\u519C\u6D3B\u5DF2\u7ECF\u505A\u5B8C\u4E86\u5417\uFF1F#$e#\u65E9\u554A\uFF01\u6211\u8FD8\u662F\u5728\u50CF\u5F80\u5E38\u4E00\u6837\u68C0\u67E5\u82B1\u56ED\u800C\u5DF2\u3002$h#$c .5#\u55EF\u2026\u2026\u8FD9\u4E9B\u662F\u869C\u866B\u5417\uFF1F$s#$e#\u55EF\u2026\u2026\u4F46\u613F\u53EF\u522B\u662F\u86A7\u58F3\u866B\u554A\u2026\u2026$s",
    "Tue": "\u628A\u4F60\u60F3\u8981\u5356\u6389\u7684\u4E1C\u897F\u90FD\u653E\u5230\u4F60\u623F\u5B50\u65C1\u8FB9\u7684\u5305\u88C5\u7BB1\u91CC\u3002#$e#\u6211\u4F1A\u53BB\u770B\u770B\u4F60\u5F80\u91CC\u9762\u653E\u4E86\u4EC0\u4E48\u7684\u3002",
    "Tue2": "\u6BCF\u4E2A\u5B63\u8282\u4F0A\u59CB\uFF0C\u4F60\u90FD\u5F97\u5148\u9664\u6389\u4E0A\u4E2A\u5B63\u8282\u7684\u6B7B\u6389\u7684\u4F5C\u7269\u3002\u7528\u9570\u5200\u662F\u6700\u65B9\u4FBF\u7684\u3002",
    "Wed": "\u54FC\u2026\u2026\u6536\u7A0E\u2026\u2026*\u561F\u56D4*\u2026\u2026\u6625\u5B63\u8282\u65E5\u5F00\u9500\u2026\u2026*\u561F\u56D4*\u2026\u2026$u#$e#\u600E\u4E48\u4E86\uFF1F",
    "cc_Begin": "*\u55C5*\u2026\u2026*\u55C5*\u2026\u2026\u554A\uFF0C\u6211\u611F\u89C9\u4F60\u5DF2\u5728\u65E7\u793E\u533A\u4E2D\u5FC3\u5446\u4E86\u4E00\u6BB5\u65F6\u95F4\u3002\u771F\u662F\u592A\u597D\u4E86\uFF0C\u6709\u4EBA\u5728\u7167\u6599\u90A3\u4E2A\u5730\u65B9\u3002",
