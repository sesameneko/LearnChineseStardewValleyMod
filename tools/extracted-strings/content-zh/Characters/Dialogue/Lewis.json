    "AcceptBirthdayGift_Negative": "\u56AF\uFF0C\u4F60\u8FD8\u8BB0\u5F97\u6211\u8FD9\u4E2A\u8001\u9547\u957F\u7684\u751F\u65E5\u554A\u2026\u2026\u8FD9\u662F\u4EC0\u4E48\u4E1C\u897F\uFF1F$h#$b#\u5443\u2026\u2026\u8FD9\u4E2A\u561B\uFF0C\u5FC3\u610F\u5230\u4E86\u5C31\u884C\u4E86\u3002",
    "AcceptBirthdayGift_Positive": "\u56AF\uFF0C\u4F60\u8FD8\u8BB0\u5F97\u6211\u8FD9\u4E2A\u8001\u9547\u957F\u7684\u751F\u65E5\u554A\u3002\u4F60\u6709\u5FC3\u4E86\uFF0C\u8FD9\u4E2A\u793C\u7269\u6211\u5F88\u559C\u6B22\uFF01$h",
