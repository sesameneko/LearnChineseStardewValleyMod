    "Tue": "\u6211\u5BF9\u9633\u5149\u8FC7\u654F\uFF0C\u767D\u5929\u4E0D\u6562\u51FA\u95E8\u3002#$b#\u8FD9\u91CC\u7684\u6761\u4EF6\u6700\u7406\u60F3\u4E86\u3002#$e#\u60F3\u4E0D\u60F3\u4E70\u70B9\u4EC0\u4E48\uFF1F",
    "Wed": "\u6211\u5728\u8FD9\u91CC\u641C\u5BFB\u503C\u94B1\u7684\u4E1C\u897F\uFF0C\u7136\u540E\u628A\u5B83\u4EEC\u5356\u6389\u3002\u60F3\u4E0D\u60F3\u4E70\u70B9\u4EC0\u4E48\uFF1F",
    "Wed6": "\u5982\u679C\u4F60\u628A\u8033\u6735\u51D1\u5230\u6B63\u786E\u7684\u7BA1\u5B50\u4E0A\uFF0C\u5C31\u53EF\u4EE5\u4ECE\u8FD9\u91CC\u5230\u4EFB\u4F55\u623F\u5B50\u7684\u58F0\u97F3\u4E86\u3002#$b#\u4E0D\u8FC7\u6211\u4E0D\u4F1A\u5077\u542C\u7684\uFF01$3",
