    "4_*": "\u2026\u2026\u4F60\u6709\u6CA1\u6709\u5728\u77FF\u4E95\u91CC\u9762\u9047\u5230\u5176\u4ED6\u50CF\u6211\u8FD9\u6837\u7684\u5BB6\u4F19\uFF1F\u5982\u679C\u4ED6\u4EEC\u4E0D\u592A\u53CB\u597D\uFF0C\u6211\u5411\u4F60\u9053\u6B49\u3002\u6211\u4EEC\u5DF2\u7ECF\u5B66\u4F1A\u754F\u60E7\u4EBA\u7C7B\u4E86\u2026\u2026\u6BD5\u7ADF\u2026\u2026\u6709\u592A\u591A\u4E0D\u6109\u5FEB\u7684\u906D\u9047\u3002#$e#\u4F60\u2026\u2026\u6CA1\u6709\u6740\u8FC7\u6211\u7684\u670B\u53CB\u5427\uFF1F",
    "8_*": "\u6211\u4EEC\u548C\u77EE\u4EBA\u4E4B\u95F4\u7684\u5343\u5E74\u6218\u4E89\u6700\u8FD1\u7EC8\u4E8E\u7ED3\u675F\u4E86\u3002\u4E0D\u8FC7\u5F7C\u6B64\u4E4B\u95F4\u4F9D\u7136\u4E92\u76F8\u618E\u6068\u3002",
    "AcceptBirthdayGift_Negative": "\u554A\u2026\u2026\u4F60\u4EEC\u8BF4\u7684\u201C\u751F\u65E5\u793C\u7269\u201D\u5C31\u662F\u8FD9\u79CD\u4E1C\u897F\u5417\uFF1F\u6211\u4E0D\u662F\u5F88\u61C2\u4EBA\u7C7B\u2026\u2026$s",
    "AcceptBirthdayGift_Positive": "\u54C7\uFF0C\u8FD9\u662F\u6211\u5B75\u5316\u65E5\u7684\u7EAA\u5FF5\u793C\u7269\u5417\uFF01\u8C22\u8C22\u4F60\uFF01$h",
    "AcceptGift_(O)308": "\u597D\u9999\u554A\uFF01\u8FD9\u6837\u5427\uFF0C\u4E00\u534A\u6211\u7528\u6765\u5403\uFF0C\u53E6\u4E00\u534A\u6211\u7528\u6765\u6D82\u4FDD\u6E7F\u2026\u2026$h",
    "AcceptGift_(O)879": "\u8FD9\u74F6\u597D\u95FB\u7684\u9999\u6C34\u662F\u8981\u9001\u7ED9\u6211\u5417\uFF1F\u54CE\u5440\uFF0C@\u2026\u2026\u6211\u90FD\u8138\u7EA2\u4E86\uFF0C\u4E0D\u8FC7\u4F60\u53EF\u80FD\u770B\u4E0D\u51FA\u6765\u2026\u2026$4",
    "AcceptGift_(O)Book_Void": "\u54CE\uFF0C\u5FEB\u770B\uFF01\u6211\u670B\u53CB\u5728\u8FD9\u91CC\u90FD\u6709\uFF01$h#$b#\u7B49\u7B49\uFF0C\u8FD9\u662F\u6211\u5417\u2026\u2026\uFF1F$7",
    "AcceptGift_(O)StardropTea": "\u8FD9\u662F\u661F\u4E4B\u679C\u8336\u5417\uFF1F\u8C22\u8C22\u4F60\uFF01\u53EA\u8981\u6EF4\u4E0A\u4E00\u6EF4\uFF0C\u6211\u7684\u5C4B\u5B50\u5C31\u80FD\u9999\u4E0A\u4E00\u6574\u5929\u3002",
    "Fri": "\u2026\u2026",
    "GreenRain": "\u4ECA\u5929\u6C34\u7684\u6D41\u901F\u7279\u522B\u5FEB\u2026\u2026\u5730\u4E0A\u53D1\u751F\u4EC0\u4E48\u4E86\uFF1F",
    "Mon": "\u8BF7\u4F60\u4E0D\u8981\u5403\u60CA\u3002\u6211\u548C\u522B\u4EBA\u4E0D\u5927\u4E00\u6837\u3002#$e#\u6211\u82B1\u4E86\u5F88\u591A\u65F6\u95F4\u89C2\u5BDF\u7814\u7A76\u4EBA\u7C7B\u3002\u6211\u77E5\u9053\u4F60\u60F3\u8981\u4E70\u4E1C\u897F\u3002\u60F3\u8981\u770B\u770B\u6211\u90FD\u6709\u4E9B\u4EC0\u4E48\u5417\uFF1F",
    "Mon2": "\u4F60\u53C8\u6765\u4E86\uFF1F\u8FD9\u786E\u5B9E\u5F88\u7B26\u5408\u6211\u7684\u4EBA\u7C7B\u884C\u4E3A\u5B66\u7406\u8BBA\u3002",
    "Mon6": "\u5728\u6211\u4EEC\u7684\u8BED\u8A00\u91CC\uFF0C\u201C\u79D1\u7F57\u5E03\u65AF\u201D\u610F\u601D\u5C31\u662F\u201C\u8FC7\u6865\u4EBA\u201D\u3002",
    "Sat": "\u661F\u671F\u4E94\u7684\u65F6\u5019\u6211\u4F1A\u4FDD\u6301\u5B89\u9759\uFF0C\u4EE5\u8868\u793A\u5BF9\u7531\u5DF4\u8654\u8BDA\u3002",
    "Sat4": "\u6211\u5F88\u60F3\u53BB\u5916\u9762\u7684\u4E16\u754C\u770B\u770B\uFF0C\u4F46\u5BF9\u6211\u4E0D\u662F\u5F88\u5B89\u5168\u3002$s",
    "Sat8": "\u6211\u6C38\u8FDC\u4E0D\u4F1A\u660E\u767D\u4F5C\u4E3A\u4EBA\u7C7B\u662F\u4EC0\u4E48\u611F\u53D7\u2026\u2026\u4E0D\u8FC7\u8DDF\u4F60\u804A\u5929\u4E4B\u540E\uFF0C\u6211\u591A\u5C11\u7406\u89E3\u4E86\u4E00\u70B9\u3002",
    "SpouseStardrop": "\u6211\u60F3\u9001\u4F60\u8FD9\u4E2A\uFF0C\u4F5C\u4E3A\u4F60\u5141\u8BB8\u6211\u548C\u4F60\u4E00\u8D77\u4F4F\u7684\u8C22\u793C\u3002$h",
    "Sun": "\u62B1\u6B49\u2026\u2026\u6211\u8FD8\u662F\u6709\u70B9\u4E0D\u5927\u4E60\u60EF\u8DDF\u4EBA\u7C7B\u76F8\u5904\u3002\u4F46\u662F\u6211\u7684\u5546\u5E97\u4F9D\u7136\u4F1A\u5BF9\u4F60\u5F00\u653E\u3002",
