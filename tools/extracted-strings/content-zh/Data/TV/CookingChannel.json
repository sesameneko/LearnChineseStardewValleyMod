    "16": "Cranberry Candy/\u8513\u8D8A\u8393\u7CD6\u679C\uFF01\u8FD9\u662F\u4E00\u6B3E\u4F60\u8FC7\u65B0\u5E74\u65F6\u9700\u8981\u7684\u7EDD\u5999\u7CD6\u679C\u3002\u8513\u8D8A\u8393\u672C\u8EAB\u5C31\u5E26\u6709\u82E6\u5473\uFF0C\u4F46\u662F\uFF0C\u628A\u5B83\u4EEC\u6D78\u5230\u5927\u91CF\u7684\u7CD6\u6C34\u4E2D\u4E4B\u540E\uFF0C\u5C1D\u8D77\u6765\u7B80\u76F4\u5C31\u50CF\u662F\u5929\u4F7F\u7684\u773C\u6CEA\u3002\u73B0\u5728\uFF0C\u770B\u6211\u600E\u4E48\u6765\u505A\u2026\u2026",
    "17": "Pizza/\u62AB\u8428\uFF01\u62AB\u8428\u662F\u6C38\u6052\u7684\u70F9\u996A\u7ECF\u5178\uFF0C\u8FD9\u4E5F\u662F\u6709\u5176\u539F\u56E0\u7684\u3002\u91D1\u9EC4\u8272\u7684\u7CBE\u7F8E\u997C\u80DA\u5DF2\u7ECF\u51FA\u7089\u4E86\uFF0C\u5148\u6D47\u4E00\u5C42\u849C\u9999\u6D53\u90C1\u7684\u756A\u8304\u9171\uFF0C\u7136\u540E\uFF0C\u518D\u6D47\u4E0A\u4E00\u5C42\u8BA9\u4EBA\u53E3\u6C34\u76F4\u6D41\u7684\u5976\u916A\u3002\u8FD9\u624D\u521A\u521A\u5F00\u59CB\uFF01\u8BA9\u6211\u4EEC\u5728\u4E0A\u9762\u6492\u4E9B\u65B0\u9C9C\u80E1\u6912\u548C\u756A\u8304\u3002\u6211\u7684\u5929\uFF01",
    "18": "Hashbrowns/\u85AF\u997C\uFF01\u8FD9\u9053\u83DC\u770B\u4F3C\u7B80\u5355\uFF0C\u4E0D\u8FC7\uFF0C\u771F\u7684\u662F\u975E\u5E38\u7F8E\u5473\uFF01\u5148\u5C06\u571F\u8C46\u5207\u6210\u4E1D\uFF0C\u7136\u540E\u6492\u4E0A\u9002\u91CF\u7684\u76D0\uFF0C\u518D\u7528\u4F60\u6700\u559C\u6B22\u7684\u70ED\u6CB9\u5C06\u571F\u8C46\u4E1D\u70B8\u597D\u3002\u611F\u89C9\u5F88\u7B80\u5355\uFF0C\u662F\u5427\uFF1F\u597D\u5427\uFF0C\u6211\u53EF\u4EE5\u7ED9\u4F60\u4EEC\u4E00\u4E9B\u5EFA\u8BAE\uFF0C\u8BA9\u4F60\u4EEC\u505A\u8D77\u6765\u66F4\u52A0\u7B80\u5355\u2026\u2026",
    "19": "Complete Breakfast/\u5B8C\u7F8E\u65E9\u9910\uFF01\u4E0A\u5468\uFF0C\u6211\u4EEC\u6559\u4E86\u4F60\u4EEC\u5982\u4F55\u5236\u4F5C\u571F\u8C46\u714E\u997C\u3002\u8FD9\u5468\uFF0C\u6211\u8981\u6559\u4F60\u4EEC\u5982\u4F55\u5C06\u571F\u8C46\u714E\u997C\u548C\u5176\u5B83\u98DF\u6750\u7ED3\u5408\uFF0C\u505A\u51FA\u4E00\u987F\u4E30\u76DB\u7684\u7231\u5FC3\u65E9\u9910\u3002\u8FD9\u4E2A\u8089\u771F\u7684\u80FD\u586B\u9971\u4F60\u7684\u809A\u5B50\uFF0C\u5E76\u4E14\u7ED9\u4F60\u5145\u8DB3\u7684\u80FD\u91CF\uFF0C\u8BA9\u4F60\u4E00\u6574\u5929\u5DE5\u4F5C\u90FD\u6709\u52B2\u3002",
    "2": "Coleslaw/\u5377\u5FC3\u83DC\u6C99\u62C9\uFF01\u60F3\u5403\u4E0A\u4E00\u5927\u76D8\u6E05\u6DE1\u800C\u67D4\u8F6F\u7684\u5377\u5FC3\u83DC\uFF1F\u4E0D\u5149\u662F\u4F60\u6709\u8FD9\u6837\u7684\u60F3\u6CD5\u3002\u5176\u5B9E\u5377\u5FC3\u83DC\u6C99\u62C9\u53EF\u4EE5\u505A\u5F97\u66F4\u52A0\u7F8E\u5473\u3002\u505A\u8FD9\u9053\u83DC\uFF0C\u4E00\u5B9A\u8981\u9009\u53D6\u591A\u6C41\u3001\u65B0\u9C9C\u7684\u5377\u5FC3\u83DC\u3002\u6492\u4E0A\u4E00\u70B9\u918B\u548C\u6C99\u62C9\u9171\u5C31\u53EF\u4EE5\u4E86\u3002\u554A\uFF0C\u975E\u5E38\u8106\u723D\u3002",
    "20": "Lucky Lunch/\u5E78\u8FD0\u5348\u9910\uFF01\u5728\u53E4\u8001\u7684\u4F20\u8BF4\u4E2D\uFF0C\u8FD9\u662F\u4E00\u987F\u8FDE\u5E78\u8FD0\u548C\u8D22\u5BCC\u4E4B\u795E\u90FD\u65E0\u6CD5\u963B\u6321\u7684\u5348\u9910\u3002\u4F60\u5403\u5B8C\u4E4B\u540E\uFF0C\u5C31\u4F1A\u5C06\u5E78\u8FD0\u4E4B\u6C14\u5F15\u5165\u4F60\u7684\u809A\u5185\uFF0C\u8FD9\u80A1\u5E78\u8FD0\u4E4B\u6C14\u4F1A\u7ED9\u4F60\u5E26\u6765\u597D\u8FD0\u76F4\u5230\u5348\u9910\u5168\u90E8\u88AB\u6D88\u5316\u3002\u542C\u8D77\u6765\u602A\u602A\u7684\uFF0C\u662F\u5427\uFF1F\u6211\u4E0D\u80FD\u8BF4\u6211\u4E00\u5B9A\u76F8\u4FE1\uFF0C\u4F46\u662F\uFF0C\u4E0D\u7BA1\u5982\u4F55\uFF0C\u8FD9\u5348\u9910\u786E\u5B9E\u662F\u7F8E\u5473\u554A\uFF01",
