    "23": "Pink Cake/\u6709\u4E00\u4F4D\u6765\u81EA\u9E48\u9E55\u9547\u7684\u89C2\u4F17\u6700\u8FD1\u5199\u4E86\u4E00\u5C01\u4FE1\u7ED9\u6211\u2026\u2026\u6211\u4EEC\u6765\u770B\u770B\u2026\u2026\u5979\u7684\u540D\u5B57\u662F\u6D77\u8389\u3002\u5979\u5199\u9053\uFF1A\u201C\u4E0A\u6B21\u6211\u5728\u7956\u7956\u5E02\u7684\u65F6\u5019\uFF0C\u5403\u5230\u4E86\u4F60\u505A\u7684\u7C89\u8272\u86CB\u7CD5\uFF0C\u6211\u9A6C\u4E0A\u5C31\u7231\u4E0A\u5B83\u4E86\u3002\u4F60\u80FD\u5728\u4E0B\u671F\u8282\u76EE\u4E2D\u5206\u4EAB\u4E00\u4E0B\u7C89\u8272\u86CB\u7CD5\u7684\u914D\u65B9\u5417\uFF1F\u201D\u3002\u597D\u5427\uFF0C\u4E3A\u4EC0\u4E48\u4E0D\u5462\uFF1F\u8FD9\u662F\u4E00\u6B3E\u975E\u5E38\u68D2\u7684\u86CB\u7CD5\u3002\u5E76\u4E14\uFF0C\u4F60\u6C38\u8FDC\u4E0D\u4F1A\u731C\u5230\u5176\u79D8\u65B9\u662F\u2026\u2026\u751C\u74DC\uFF01",
    "24": "Roasted Hazelnuts/\u70E4\u699B\u5B50\uFF01\u6211\u7684\u623F\u5B50\u540E\u9762\u6709\u4E00\u9897\u53E4\u8001\u800C\u6F02\u4EAE\u7684\u699B\u5B50\u6811\uFF0C\u6BCF\u5E74\uFF0C\u6211\u90FD\u4F1A\u9080\u8BF7\u5168\u5BB6\u4EBA\u8FC7\u6765\u4E3E\u884C\u4E00\u6B21\u679C\u4EC1\u70E7\u70E4\u5BB4\u4F1A\uFF01\u4E00\u65E6\u6211\u4EEC\u5F00\u59CB\u70E7\u70E4\uFF0C\u5468\u56F4\u7684\u90BB\u5C45\u5C31\u4F1A\u95FB\u9999\u800C\u6765\u3002\u70E4\u699B\u5B50\u7684\u6D53\u9999\u771F\u7684\u662F\u4E0D\u53EF\u963B\u6321\u554A\u3002\u597D\u4E86\uFF0C\u6765\u770B\u770B\u6211\u7684\u5BB6\u65CF\u79D8\u65B9\u2026\u2026",
    "25": "Fruit Salad/\u6C34\u679C\u6C99\u62C9\uFF01\u8FD9\u662F\u4E00\u9053\u5065\u5EB7\u3001\u7F8E\u5473\u7684\u83DC\u80B4\uFF0C\u53EF\u4EE5\u8BA9\u4F60\u6BCF\u5929\u90FD\u8FC7\u5F97\u8212\u7545\u3002\u6700\u91CD\u8981\u7684\u5C31\u662F\u8981\u9009\u53D6\u6210\u719F\u7684\u6C34\u679C\u3002\u53EF\u522B\u7ED9\u6211\u63D0\u90A3\u4E9B\u8D85\u5E02\u91CC\u5356\u7684\u9694\u591C\u6C34\u679C\u2026\u2026\u6211\u6240\u8BF4\u7684\u662F\u65B0\u9C9C\u6458\u53D6\u7684\u591A\u6C41\u3001\u7F8E\u5473\u6C34\u679C\u3002\u597D\u5427\uFF0C\u73B0\u5728\u4ED4\u7EC6\u770B\u597D\u4E86\u2026\u2026",
    "26": "Blackberry Cobbler/\u9ED1\u8393\u8106\u76AE\u997C\uFF01\u8FD9\u9053\u83DC\u603B\u4F1A\u8BA9\u6211\u60F3\u8D77\u661F\u9732\u8C37\u3002\u79CB\u5B63\u7684\u90A3\u51E0\u5929\uFF0C\u661F\u9732\u8C37\u5230\u5904\u90FD\u662F\u6211\u4EBA\u751F\u4E2D\u5403\u8FC7\u6700\u7F8E\u5473\u7684\u9ED1\u8393\u3002\u5982\u679C\u4F60\u5BB6\u91CC\u6709\u4E00\u4E9B\u8FD9\u6837\u7684\u9ED1\u8393\uFF0C\u6211\u6781\u529B\u5EFA\u8BAE\u4F60\u5C06\u5B83\u4EEC\u505A\u6210\u8FD9\u7B80\u5355\u9ED1\u8393\u8106\u76AE\u997C\u3002",
    "27": "Crab Cakes/\u87F9\u9EC4\u7CD5\uFF01\u87F9\u8089\u672C\u8EAB\u5C31\u6BD4\u8F83\u7EC6\u817B\uFF0C\u4F46\u662F\uFF0C\u5C06\u5B83\u4E0E\u9762\u5305\u5C51\u3001\u9E21\u86CB\u6405\u62CC\u6DF7\u5408\u4E4B\u540E\uFF0C\u5C31\u53D8\u5F97\u975E\u5E38\u5165\u5473\u4E86\u3002\u8FD9\u5C31\u662F\u6211\u559C\u6B22\u5403\u87F9\u9EC4\u7CD5\u7684\u539F\u56E0\u3002\u4E0D\u8FC7\uFF0C\u5728\u4F60\u6572\u788E\u87F9\u58F3\u4E4B\u524D\uFF0C\u5148\u770B\u4E00\u4E0B\u6211\u8FD9\u4E2A\u975E\u5E38\u5173\u952E\u7684\u8C03\u5473\u6599\u2026\u2026",
    "28": "Fiddlehead Risotto/\u610F\u5F0F\u8568\u83DC\u7096\u996D\uFF01\u8568\u83DC\u770B\u4E0A\u53BB\u5F88\u6F02\u4EAE\uFF0C\u4F46\u662F\uFF0C\u76F4\u63A5\u5403\u7684\u8BDD\uFF0C\u4F1A\u611F\u89C9\u975E\u5E38\u4E4F\u5473\u3002\u6240\u4EE5\uFF0C\u4F60\u5F97\u591A\u6CE8\u610F\u81EA\u5DF1\u52A0\u5165\u7684\u9999\u6599\u3002\u5B9E\u8BDD\u8BF4\uFF0C\u610F\u5F0F\u8568\u83DC\u7096\u996D\u8981\u505A\u597D\uFF0C\u8FD8\u662F\u975E\u5E38\u96BE\u7684\u3002\u4E0D\u8FC7\uFF0C\u5728\u6211\u7684\u5E2E\u52A9\u4E0B\uFF0C\u4F60\u4E00\u5B9A\u4F1A\u6210\u529F\u505A\u51FA\u4E00\u9053\u7F8E\u5473\u7684\u610F\u5F0F\u8568\u83DC\u7096\u996D\u3002",
    "29": "Poppyseed Muffin/\u865E\u7F8E\u4EBA\u7C7D\u677E\u7CD5\uFF01\u865E\u7F8E\u4EBA\u4F1A\u5F00\u51FA\u975E\u5E38\u8FF7\u4EBA\u7684\u82B1\u6735\u2026\u2026\u4F46\u662F\uFF0C\u4E3A\u4EC0\u4E48\u4E0D\u628A\u865E\u7F8E\u4EBA\u548C\u8FD9\u53EF\u53E3\u7684\u677E\u997C\u5145\u5206\u878D\u5408\u5230\u4E00\u8D77\u5462\uFF1F\u6211\u5BF9\u865E\u7F8E\u4EBA\u7C7D\u60C5\u6709\u72EC\u949F\u3002\u8FD9\u865E\u7F8E\u4EBA\u7C7D\u770B\u8D77\u6765\u6CA1\u4EC0\u4E48\u7279\u522B\u7684\uFF0C\u4F46\u662F\uFF0C\u5B83\u4EEC\u4F1A\u8BA9\u9762\u5305\u751C\u70B9\u66F4\u5177\u9999\u5473\u548C\u8D28\u611F\u3002\u5E76\u4E14\uFF0C\u5B83\u4EEC\u8FD8\u5F88\u5065\u5EB7\uFF01",
    "3": "Radish Salad/\u841D\u535C\u6C99\u62C9\uFF01\u6CA1\u6709\u4EC0\u4E48\u83DC\u80FD\u591F\u6BD4\u5F97\u4E0A\u4E00\u76D8\u65B0\u9C9C\u7684\u80E1\u6912\u841D\u535C\u3002\u8FD9\u8BA9\u6211\u60F3\u8D77\u6765\u665A\u6625\u7684\u65F6\u5019\u2026\u2026\u6211\u7684\u6BCD\u4EB2\u4F1A\u5C06\u65B0\u9C9C\u7684\u841D\u535C\u5207\u6210\u7247\uFF0C\u7136\u540E\u6492\u4E0A\u4E00\u70B9\u76D0\u548C\u80E1\u6912\u7C89\uFF0C\u548C\u5168\u9EA6\u9762\u5305\u4E00\u8D77\u5403\u3002\u554A\uFF0C\u8FD9\u4E9B\u90FD\u662F\u5F80\u4E8B\u2026\u2026\u6211\u597D\u50CF\u6709\u70B9\u8DD1\u9898\u4E86\uFF0C\u4ED4\u7EC6\u770B\u597D\u2026\u2026",
    "30": "Lobster Bisque/\u9F99\u867E\u6D53\u6C64\uFF01\u4F60\u53EF\u4EE5\u4EB2\u81EA\u5C06\u8FD9\u9053\u83DC\u732E\u7ED9\u5DDE\u957F\u3002\u8FD9\u9F99\u867E\u6D53\u6C64\u6D53\u90C1\u3001\u5976\u9999\u3001\u7F8E\u5473\uFF0C\u5E76\u4E14\u4F1A\u8BA9\u4F60\u611F\u53D7\u5230\u6D77\u6D0B\u7684\u5473\u9053\u3002\u8981\u627E\u5230\u4E00\u4E9B\u65B0\u9C9C\u7684\u9F99\u867E\u662F\u6700\u96BE\u7684\uFF0C\u4E0D\u8FC7\uFF0C\u6211\u76F8\u4FE1\u4F60\u53EF\u4EE5\u505A\u5230\u7684\u3002\u597D\u5427\uFF0C\u5982\u679C\u4F60\u89C9\u5F97\u81EA\u5DF1\u591F\u7075\u5DE7\uFF0C\u90A3\u5C31\u4EB2\u81EA\u7528\u87F9\u7B3C\u6293\u4E00\u53EA\uFF01",
    "31": "Bruschetta/\u610F\u5F0F\u70E4\u9762\u5305\uFF01\u8FD9\u662F\u4E00\u9053\u7B80\u5355\u4F46\u975E\u5E38\u7F8E\u5473\u7684\u5F00\u80C3\u83DC\uFF0C\u5B83\u771F\u7684\u80FD\u7A81\u663E\u51FA\u539F\u6750\u6599\u7684\u8D28\u611F\u3002\u4F60\u9700\u8981\u51C6\u5907\u7684\u662F\u9762\u5305\u3001\u897F\u7EA2\u67FF\u4EE5\u53CA\u6CB9\u3002\u9996\u5148\uFF0C\u5C06\u9762\u5305\u70E4\u597D\u3002\u5C06\u897F\u7EA2\u67FF\u5207\u788E\uFF0C\u5E76\u6492\u5230\u70E4\u597D\u7684\u9762\u5305\u4E0A\u3002\u7136\u540E\uFF0C\u6DCB\u4E0A\u4E00\u70B9\u6CB9\uFF0C\u5C31\u53EF\u4EE5\u4E0A\u684C\u4E86\u3002\u6211\u6CA1\u9A97\u4F60\u5427\uFF0C\u505A\u8D77\u6765\u786E\u5B9E\u7B80\u5355\uFF01",
    "32": "Shrimp Cocktail/\u9C9C\u867E\u9E21\u5C3E\u9152\uFF01\u8FD9\u662F\u53E6\u4E00\u9053\u4F1A\u8BA9\u4F60\u548C\u4F60\u7684\u5BA2\u4EBA\u975E\u5E38\u559C\u6B22\u7684\u5F00\u80C3\u83DC\u3002\u6211\u5236\u4F5C\u7684\u9E21\u5C3E\u9152\u6C41\u6781\u5176\u9C9C\u7F8E\uFF0C\u6211\u76F8\u4FE1\u4F60\u4E00\u5B9A\u4F1A\u7231\u4E0A\u5B83\u7684\u3002\u597D\u4E86\uFF0C\u7B2C\u4E00\u6B65\u662F\u2026\u2026",
    "4": "Omelet/\u714E\u86CB\u5377\uFF01\u8FD9\u662F\u4E00\u9053\u5F88\u7B80\u5355\u7684\u83DC\uFF0C\u4F46\u662F\uFF0C\u4E00\u4E0D\u5C0F\u5FC3\u5C31\u4F1A\u505A\u574F\u3002\u4E00\u4E2A\u5B8C\u7F8E\u7684\u714E\u86CB\u5377\u7B80\u76F4\u5C31\u662F\u4E00\u4EF6\u827A\u672F\u54C1\u3002\u8FD9\u662F\u4E00\u4E2A\u7EAF\u91D1\u8272\u3001\u95EA\u95EA\u53D1\u5149\u7684\u5929\u4F7F\u4E4B\u86CB\uFF0C\u63A5\u4E0B\u6765\uFF0C\u6211\u8981\u5411\u4F60\u4EEC\u5C55\u793A\u4E00\u4E0B\u6211\u7684\u7EDD\u6280\u2026\u2026",
    "5": "Baked Fish/\u70E4\u9C7C\uFF01\u6BCF\u5F53\u6211\u5728\u5BB6\u505A\u8FD9\u9053\u83DC\u7684\u65F6\u5019\uFF0C\u6211\u90A3\u4E24\u53EA\u732B\u5C31\u4F1A\u6293\u72C2\u3002\u6211\u9700\u8981\u5B89\u6392\u4E00\u4F4D\u5E2E\u53A8\u6765\u770B\u7740\u5B83\u4EEC\uFF0C\u9632\u6B62\u5B83\u4EEC\u8DF3\u4E0A\u6765\u62A2\u9C7C\u5403\u3002\u4E00\u5B9A\u8981\u9009\u53D6\u65B0\u9C9C\u7684\u9C7C\uFF0C\u6700\u597D\u662F\u4F60\u4EB2\u624B\u9493\u7684\u3002\u597D\u4E86\uFF0C\u73B0\u5728\u6211\u8981\u628A\u9C7C\u653E\u5230\u94FA\u597D\u7684\u7EFF\u8272\u852C\u83DC\u4E0A\u2026\u2026",
    "6": "Pancakes/\u8584\u714E\u997C\uFF01\u6709\u7684\u65F6\u5019\uFF0C\u6211\u4F1A\u88AB\u7CBE\u81F4\u3001\u590D\u6742\u7684\u83DC\u80B4\u5438\u5F15\u2026\u2026\u4E0D\u8FC7\uFF0C\u4E00\u5757\u7B80\u5355\u7684\u8584\u714E\u997C\u4E5F\u53EF\u4EE5\u629A\u6170\u6211\u7684\u5FC3\u7075\u3002\u5EFA\u8BAE\u5728\u8FD9\u4E00\u5C42\u5C42\u70ED\u714E\u997C\u4E0A\u6D82\u4E0A\u9EC4\u6CB9\u548C\u67AB\u7CD6\u6D46\u3002",
    "7": "Maki Roll/\u751F\u9C7C\u7247\u5BFF\u53F8\uFF01\u67D4\u8F6F\u7684\u7C73\u996D\u5C06\u9C7C\u7684\u9C9C\u5473\u5305\u88F9\u5176\u4E2D\u3002\u559C\u6B22\u53E3\u5473\u91CD\u70B9\u7684\uFF0C\u4E5F\u53EF\u4EE5\u6765\u4E00\u70B9\u82A5\u672B\u3002\u8BF4\u7740\u8BF4\u7740\uFF0C\u6211\u5C31\u5F00\u59CB\u6D41\u53E3\u6C34\u4E86\u3002\u54E6\uFF0C\u6211\u592A\u559C\u6B22\u5BFF\u53F8\u4E86\u2026\u2026",
    "8": "Bread/\u9762\u5305\uFF01\u5236\u4F5C\u9762\u5305\u53EF\u4EE5\u8BF4\u662F\u4E00\u4EF6\u975E\u5E38\u590D\u6742\u7684\u4E8B\u60C5\uFF0C\u4F46\u662F\uFF0C\u6211\u53EF\u4EE5\u8BA9\u5B83\u53D8\u5F97\u5F88\u7B80\u5355\u3002\u6700\u91CD\u8981\u7684\u6750\u6599\u5F53\u7136\u5C31\u662F\u9762\u7C89\u4E86\u3002\u4E0D\u8FC7\uFF0C\u5728\u548C\u9762\u4E4B\u524D\uFF0C\u6211\u4EEC\u5F97\u8BA9\u9192\u4E00\u4E0B\u9175\u6BCD\u3002\u5B83\u4EEC\u559C\u6B22\u6E29\u6C34\u3002\u6211\u559C\u6B22\u4F7F\u7528\u666E\u901A\u7684\u7CD6\uFF0C\u4E0D\u8FC7\u7528\u8702\u871C\u6216\u8005\u67AB\u7CD6\u6D46\u4E5F\u662F\u53EF\u4EE5\u7684\uFF01",
    "9": "Tortilla/\u58A8\u897F\u54E5\u8584\u997C\uFF01\u770B\u8FD9\u4E2A\u8282\u76EE\u7684\u65F6\u5019\uFF0C\u6709\u591A\u5C11\u4EBA\u8FD8\u5728\u54AC\u7740\u7528\u5FAE\u6CE2\u7089\u70E4\u51FA\u6765\u7684\u50BB\u74DC\u5F0F\u7389\u7C73\u714E\u997C\u5462\uFF1F\u4E22\u4EBA\u554A\u3002\u90A3\u6837\u5403\u8584\u997C\u8FD8\u4E0D\u5982\u76F4\u63A5\u628A\u7389\u7C73\u7C92\u88F9\u5230\u7834\u65E7\u7684\u62B9\u5E03\u91CC\u3002\u73B0\u5728\uFF0C\u90FD\u7ED9\u6211\u542C\u597D\u4E86\u3002\u5982\u679C\u4F60\u5C1D\u4E86\u6211\u624B\u5DE5\u5236\u4F5C\u7684\u65B0\u9C9C\u7389\u7C73\u714E\u997C\uFF0C\u4F60\u5C31\u518D\u4E5F\u4E0D\u4F1A\u50CF\u4EE5\u524D\u4E00\u6837\u2026\u2026"
