    "NaturalWonders_Scene2": "\u30D5\u30A7\u30FC\u30F3\u8AF8\u5CF6\u3001\u5357\u6D77\u5CB8\u304B\u308980\u30DE\u30A4\u30EB\u306E\u6240\u306B\u3042\u308B\u30C8\u30ED\u30D4\u30AB\u30EB\u30D1\u30E9\u30C0\u30A4\u30B9\u3067\u3059\u3002\u5CF6\u306F\u3001\u4ED8\u8FD1\u306E\u706B\u5C71\u6D3B\u52D5\u3067\u5F62\u6210\u3055\u308C\u3001\u6D3B\u52D5\u306F\u4ECA\u3067\u3082\u7D9A\u3044\u3066\u3044\u307E\u3059\u2026",
    "NaturalWonders_Scene3": "\u5357\u306E\u6E56\u306E\u6696\u304B\u3044\u6C17\u5019\u306E\u5F71\u97FF\u3067\u3001\u9AD8\u6C34\u6E96\u306E\u751F\u7269\u5B66\u7684\u591A\u69D8\u6027\u304C\u5B9F\u73FE\u3055\u308C\u3066\u3044\u307E\u3059\u2026\u8981\u3059\u308B\u306B\u3001\u5CF6\u306B\u306F\u751F\u547D\u304C\u6CA2\u5C71\u3044\u308B\u306E\u3067\u3059\uFF01",
    "NaturalWonders_Scene4": "\u3067\u306F\u3001\u9A12\u304C\u3057\u3044\u5317\u306E\u30BA\u30BA\u30B7\u30C6\u30A3\u306B\u79FB\u52D5\u3057\u307E\u3057\u3087\u3046\u3002\u30B3\u30F3\u30AF\u30EA\u30FC\u30C8\u3068\u92FC\u9244\u306E\u30B8\u30E3\u30F3\u30B0\u30EB\u3001\u305D\u3057\u3066\u4EBA\u5DE5\u7684\u306A\u660E\u304B\u308A\u3067\u30B7\u30C6\u30A3\u306F\u5F62\u6210\u3055\u308C\u3066\u3044\u307E\u3059\u3002",
    "NaturalWonders_Scene5": "\u30B3\u30F3\u30C7\u30A3\u30B7\u30E7\u30F3\u306F\u53B3\u3057\u3044\u3067\u3059\u304C\u3001\u8C4A\u304B\u306A\u751F\u6D3B\u9001\u308B\u8005\u3082\u3044\u307E\u3059\u2026",
    "NaturalWonders_Scene6": "\u897F\u306E\u5F7C\u65B9\u306E\u30B8\u30A7\u30E0\u6D77\u3067\u306F\u3001\u30D7\u30EC\u30FC\u30EA\u30FC\u30A2\u30A4\u30E9\u30F3\u30C9\u304C\u305D\u306E\u4E2D\u306B\u30DD\u30C4\u30F3\u3068\u6D6E\u304B\u3093\u3067\u3044\u307E\u3059\u3002\u540D\u524D\u3068\u306F\u88CF\u8179\u306B\u3001\u3053\u306E\u571F\u5730\u306B\u306F\u69D8\u3005\u306A\u751F\u7269\u7FA4\u7CFB\u304C\u5B58\u5728\u3057\u307E\u3059\u3002",
    "NaturalWonders_Scene7": "\u305D\u3057\u3066\u3001\u5CF6\u306F\u30A2\u30E9\u30A4\u30B0\u30DE\u304C\u6CA2\u5C71\u3044\u308B\u3053\u3068\u3067\u6709\u540D\u3067\u3059\uFF01",
    "NaturalWonders_Scene8": "\u3067\u306F\u3001\u6700\u5F8C\u306B\u30E1\u30A4\u30F3\u30E9\u30F3\u30C9\u306B\u79FB\u308A\u307E\u3057\u3087\u3046\u3002\u3053\u306E\u5927\u9678\u3067\u6700\u3082\u5FEB\u9069\u306A\u5834\u6240\u2026Stardew Valley\u3067\u3059\u3002",
    "NaturalWonders_Scene9": "\u6E29\u6696\u306A\u6C17\u5019\u306E\u8C37\u306F\u3001\u68EE\u6797\u306B\u751F\u606F\u3059\u308B\u751F\u7269\u3084\u866B\u306B\u3068\u3063\u3066\u5B8C\u74A7\u306A\u4F4F\u51E6\u3067\u3059\u3002\u306A\u3093\u3068\u7F8E\u3057\u3044\u306E\u3067\u3057\u3087\u3046\uFF01",
    "NaturalWonders_Title": "\u5929\u4E0B\u306E\u5947\u89B3\uFF1A\u30B9\u30EA\u30EA\u30F3\u30B0\u306A\u4E16\u754C\u3092\u63A2\u691C",
    "Wumbus_Description": "\u4ED6\u306E\u60D1\u661F\u304B\u3089\u3084\u3063\u3066\u304D\u305F\u307D\u3063\u3061\u3083\u308A\u7537\u306E\u751F\u304D\u69D8\u3092\u63CF\u3044\u305F\u3001\u304A\u304B\u3057\u306ASF\u30B3\u30E1\u30C7\u30A3\u30FC\u3002",
    "Wumbus_Scene1": "\u300C\u30A6\u30F3\u30D0\u30B9\u300D",
    "Wumbus_Scene2": "\u30A6\u30F3\u30D0\u30B9\u306F\u3001\u3044\u3064\u3082\u6C17\u697D\u306B\u30B9\u30C8\u30EC\u30C3\u30C1\u3057\u3066\u3001\u65E5\u5411\u307C\u3063\u3053\u3092\u697D\u3057\u3093\u3067\u3044\u307E\u3059\u3002",
    "Wumbus_Scene3": "\u305D\u306E\u508D\u3089\u3067\u3001\u5F7C\u306E\u5FE0\u5B9F\u306A\u3057\u3082\u3079\u3001\u30D5\u30FC\u30C9\u30DC\u30C3\u30C8\u304C\u713C\u304D\u30B0\u30EB\u30C6\u30F3\u30D1\u30C3\u30AF\u306E\u30EC\u30C3\u30C9\u30BD\u30FC\u30B9\u304C\u3051\u3092\u8ABF\u7406\u3057\u3066\u3044\u307E\u3059\u3002",
    "Wumbus_Scene4": "\u30A6\u30F3\u30D0\u30B9\u306F\u3001\u7525\u306E\u30ED\u30C3\u30BB\u30EB\u306F\u661F\u30B7\u30B9\u30C6\u30E0\u306E\u6587\u5316\u3084\u6D3B\u52D5\u306B\u8208\u5473\u304C\u3042\u308B\u306E\u3067\u3059\u304C\u3001\u3042\u307E\u308A\u9762\u767D\u304F\u306A\u3044\u3088\u3046\u3067\u3059\u3002",
    "Wumbus_Scene5": "\u300C\u30D7\u30B7\u30E3\u30FC\uFF01\u300D",
    "Wumbus_Scene6": "\u3053\u306E\u6620\u753B\u306F\u3001\u30A6\u30F3\u30D0\u30B9\u306E\u5947\u5999\u3067\u793E\u4F1A\u3084\u6280\u8853\u304C\u6975\u7AEF\u306B\u300E\u9032\u5316\u300F\u3057\u305F\u4E16\u754C\u3067\u306E\u304A\u304B\u3057\u306A\u751F\u6D3B\u3092\u63CF\u5199\u3057\u3066\u3044\u307E\u3059\u3002",
    "Wumbus_Scene7": "\u69D8\u3005\u306A\u30B7\u30FC\u30F3\u3067\u3001\u30E2\u30C0\u30F3\u306A\u30E9\u30A4\u30D5\u30B9\u30BF\u30A4\u30EB\u306E\u4E0D\u6761\u7406\u306B\u5BFE\u3059\u308B\u30AE\u30E3\u30B0\u304C\u76DB\u308A\u8FBC\u307E\u308C\u3066\u3044\u307E\u3059\u3002",
    "Wumbus_Scene8": "\u5A2F\u697D\u3001\u30A8\u30F3\u30BF\u30FC\u30C6\u30A4\u30E1\u30F3\u30C8\u306E\u9078\u629E\u306F\u7121\u9650\u306B\u3042\u308B\u306B\u3082\u95A2\u308F\u3089\u305A\u3001\u30A6\u30F3\u30D0\u30B9\u306F\u53CB\u9054\u3068\u4E00\u7DD2\u306B\u30D4\u30B6(\u30B0\u30EB\u30C6\u30F3100%)\u3092\u98DF\u3079\u305F\u308A\u3057\u307E\u3059\u3002",
    "Wumbus_Title": "\u30A6\u30F3\u30D0\u30B9",
    "ZuzuCityExpress_Description": "\u5927\u4EBA\u6C17\u306E\u30AF\u30E9\u30B7\u30C3\u30AF\u6620\u753B\u3001\u73FE\u4EE3\u306E\u30B7\u30A2\u30BF\u30FC\u3067\u5927\u5207\u306B\u5FA9\u5143\u3055\u308C\u307E\u3057\u305F\u3002",
    "ZuzuCityExpress_Scene1": "\u300C\u30BA\u30BA\u30B7\u30C6\u30A3\u30FB\u30A8\u30AF\u30B9\u30D7\u30EC\u30B9\u300D",
    "ZuzuCityExpress_Scene2": "\u30BA\u30BA\u30B7\u30C6\u30A3\u30FB\u30A8\u30AF\u30B9\u30D7\u30EC\u30B9\u304C\u6C37\u306E\u5730\u65B9\u304B\u3089\u5357\u306B\u6700\u5F8C\u306E\u65C5\u3078\u3068\u51FA\u307E\u3059\u30023\u65E5\u9593\u306E\u65C5\uFF01",
    "ZuzuCityExpress_Scene3": "\u82E5\u3044\u5973\u6027\u304C\u7269\u601D\u308F\u3057\u3052\u306B\u7A93\u306E\u5916\u3092\u773A\u3081\u3066\u3044\u307E\u3059\u3002",
    "ZuzuCityExpress_Scene6": "\u6620\u753B\u306F\u3001\u6C38\u9060\u306E\u30C6\u30FC\u30DE\u3068\u3044\u3048\u308B\u2026\u300C\u7406\u7531\u3068\u611F\u60C5\u306E\u845B\u85E4\u300D\u3092\u63CF\u5199\u3057\u3066\u3044\u307E\u3059\u3002",
    "ZuzuCityExpress_Scene7": "\u679C\u305F\u3057\u3066\u5F7C\u5973\u306F\u3001\u7406\u6027\u3068\u6E07\u671B\u3001\u3069\u3061\u3089\u3092\u9078\u3076\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F",
    "ZuzuCityExpress_Scene8": "\u305D\u306E\u7B54\u3048\u3092\u77E5\u308B\u3053\u3068\u306A\u304F\u3001\u6620\u753B\u306F\u7D42\u308F\u3063\u3066\u3057\u307E\u3044\u307E\u3059\u2026",
    "ZuzuCityExpress_Title": "\u30BA\u30BA\u30B7\u30C6\u30A3\u30FB\u30A8\u30AF\u30B9\u30D7\u30EC\u30B9"
  }
