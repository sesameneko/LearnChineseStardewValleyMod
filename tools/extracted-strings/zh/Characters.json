    "Phone_Ring_Lewis": "@\uFF0C\u4F60\u597D\u3002#$b#\u6211\u53EA\u662F\u60F3\u8DDF\u4F60\u901A\u4E2A\u7535\u8BDD\uFF0C\u4E5F\u770B\u770B%farm\u519C\u573A\u7ECF\u8425\u5F97\u600E\u4E48\u6837\u3002#$b#$y \u0027\u4E00\u5207\u90FD\u597D\u5417\uFF1F_\u5F88\u4E0D\u9519\uFF01\u6211\u5728\u8FD9\u91CC\u5F88\u81EA\u5728\uFF01_\u90A3\u6211\u5C31\u653E\u5FC3\u4E86\u3002*\u4F60\u5728\u6211\u4EEC\u7684\u793E\u533A\u91CC\u771F\u7684\u5F88\u91CD\u8981\uFF0C\u6211\u76F8\u4FE1\u5927\u5BB6\u90FD\u8FD9\u4E48\u89C9\u5F97\u3002*\u4F60\u7684\u7956\u7236\u4E00\u5B9A\u4F1A\u5BF9\u4F60\u7684\u6210\u5C31\u611F\u5230\u81EA\u8C6A\u3002*\u55EF\uFF0C\u6211\u5C31\u4E0D\u803D\u8BEF\u4F60\u7684\u6D3B\u4E86\u3002\u518D\u89C1\uFF01_\u633A\u597D\u7684\uFF01\u519C\u4F5C\u7269\u957F\u52BF\u5F88\u597D\u3002_\u90A3\u6211\u5C31\u653E\u5FC3\u4E86\uFF01*\u4F60\u7684\u519C\u573A\u786E\u5B9E\u4FC3\u8FDB\u4E86\u6211\u4EEC\u8FD9\u91CC\u7684\u7ECF\u6D4E\u53D1\u5C55\uFF0C\u5BF9\u5927\u5BB6\u90FD\u6709\u597D\u5904\u3002\u6211\u4EEC\u90FD\u5F88\u611F\u8C22\u4F60\u7684\u8F9B\u52E4\u5DE5\u4F5C\uFF01*\u6211\u89C9\u5F97\u4F60\u7684\u7956\u7236\u5E94\u8BE5\u4F1A\u5BF9\u4F60\u6240\u53D6\u5F97\u7684\u6210\u5C31\u611F\u5230\u81EA\u8C6A\u3002*\u55EF\uFF0C\u6211\u5C31\u4E0D\u803D\u8BEF\u4F60\u7684\u6D3B\u4E86\u3002\u518D\u89C1\uFF01_\u4E0D\u7B97\u5F88\u597D\u2026\u2026_\u554A\u2026\u2026\u90A3\u633A\u7CDF\u7CD5\u7684\uFF0C\u4E0D\u8FC7\u6CA1\u5173\u7CFB\u3002$s*\u5443\u2026\u2026\u7EE7\u7EED\u52AA\u529B\uFF0C\u6211\u76F8\u4FE1\u4F1A\u597D\u8D77\u6765\u7684\u2026\u2026*\u55EF\uFF0C\u6211\u5C31\u4E0D\u803D\u8BEF\u4F60\u7684\u6D3B\u4E86\u2026\u2026\u5982\u4F55\uFF1F\u4E4B\u540E\u518D\u804A\u5427\u3002\u518D\u89C1\u3002$s_\u6211\u77E5\u9053\u4F60\u7684\u79D8\u5BC6\uFF0C\u5218\u6613\u65AF\u3002_\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u7535\u8BDD\u662F\u4E0D\u662F\u574F\u4E86\uFF0C\u6211\u4EC0\u4E48\u4E5F\u6CA1\u542C\u89C1\u2026\u2026\u7B97\u4E86\uFF0C\u90A3\u6211\u5C31\u6302\u6389\u5427\u3002\u518D\u89C1\u3002$3\u0027",
    "Phone_Ring_Pierre": "@\uFF0C\u4F60\u597D\u3002\u662F\u6211\uFF0C\u76AE\u57C3\u5C14\u3002#$b#\u4F60\u6700\u8FD1\u600E\u4E48\u6837\uFF1F\u8FC7\u5F97\u4E0D\u9519\uFF1F\u90A3\u5C31\u597D\u3002#$b#\u55EF\uFF0C\u6211\u53EA\u662F\u60F3\u611F\u8C22\u4F60\u8FD9\u4E48\u7167\u987E\u6211\u7684\u751F\u610F\u3002\u800C\u4E14\u6211\u60F3\u63D0\u9192\u4F60\u4E00\u4E0B\uFF0C\u76AE\u57C3\u5C14\u6742\u8D27\u5E97\u91CC\u90FD\u662F\u6700~\u597D\u7684\u79CD\u5B50\u548C\u519C\u4EA7\u54C1\u3002#$b#\u5E0C\u671B\u4F60\u80FD\u5FEB\u5FEB\u6765\u5149\u987E\u6211\u7684\u5546\u5E97\u3002\u62DC\u62DC\uFF01\uFF08\u556A\u55D2\uFF09 ",
