    "WitchHut.4": "\u4F60\u62D4\u53BB\u74F6\u585E\u6247\u4E86\u4E0B\u91CC\u9762\u7684\u5473\u9053\u5230\u9F3B\u5B50\u91CC\u3002\u90A3\u6C14\u5473\u786E\u662F\u51FA\u5947\u7684\u597D\u95FB\uFF0C\u50CF\u662F\u674F\u548C\u9999\u8F9B\u6599\u7684\u5473\u9053\u3002",
    "WitchHut.5": "\u8BC5\u5492\u8FD9\u4E61\u6751\uFF01\u2026\u2026\u4E00\u672C\u519C\u6751\u5DEB\u5A46\u7684\u9B54\u6CD5\u4E66",
    "WitchHut.6": "\u4F60\u8BD5\u7740\u907F\u514D\u773C\u795E\u4EA4\u6D41\u2026\u2026"
  }
}