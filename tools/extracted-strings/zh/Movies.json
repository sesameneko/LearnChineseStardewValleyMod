    "BraveLittleSapling_Description": "\u4E00\u90E8\u5BB6\u5EAD\u52A8\u753B\u559C\u5267\uFF0C\u8BB2\u8FF0\u4E86\u4E00\u9897\u5C0F\u6811\u82D7\u7ECF\u5386\u4E86\u4E00\u756A\u795E\u5947\u7684\u5192\u9669\u540E\u6210\u957F\u4E3A\u4E00\u68F5\u6811\u7684\u6545\u4E8B\uFF01",
    "BraveLittleSapling_Scene1": "\u52C7\u6562\u7684\u5C0F\u6811\u82D7",
    "BraveLittleSapling_Scene2": "\u52C7\u6562\u7684\u5C0F\u6811\u82D7\u6B63\u79BB\u5F00\u4ED6\u7684\u5BB6\u3002\u4ED6\u72B9\u8C6B\u4E86\u4E00\u4F1A\u513F\uFF0C\u8F6C\u8FC7\u8EAB\u53BB\uFF0C\u77E5\u9053\u81EA\u5DF1\u4F1A\u79BB\u5F00\u5F88\u957F\u4E00\u6BB5\u65F6\u95F4\u2026\u2026",
    "BraveLittleSapling_Scene3": "\u6811\u6797\u91CC\u7684\u5176\u4ED6\u5C0F\u6811\u805A\u96C6\u5728\u57CE\u9547\u7684\u8FB9\u7F18\uFF0C\u6FC0\u52A8\u5730\u6325\u52A8\u7740\u5B83\u4EEC\u7684\u6811\u679D\uFF0C\u4E0E\u5176\u544A\u522B\u2026\u2026\uFF01",
    "BraveLittleSapling_Scene4": "\u54E6\u4E0D\uFF01\u7A81\u5982\u5176\u6765\u5F00\u59CB\u4E0B\u96E8\u4E86\u2026\u2026\uFF01\u4E4C\u4E91\u5BC6\u5E03\u5934\u9876\uFF0C\u5C0F\u6811\u82D7\u5F00\u59CB\u52A0\u901F\u51B2\u523A\u2026\u2026",
    "BraveLittleSapling_Scene5": "\u6050\u60E7\u4ECE\u5FC3\u4E2D\u6D6E\u73B0\uFF0C\u4FE1\u5FF5\u88AB\u65E0\u6B62\u5C3D\u7684\u5927\u96E8\u51B2\u5237\u6B86\u5C3D\uFF0C\u52C7\u6562\u7684\u5C0F\u6811\u82D7\u5F00\u59CB\u5931\u53BB\u5E0C\u671B\u2026\u2026",
    "BraveLittleSapling_Scene6": "\u2026\u2026\u4F46\u8FD9\u662F\u4EC0\u4E48\u2026\u2026\uFF1F\u5C0F\u6811\u611F\u5230\u5934\u9876\u6709\u523A\u75DB\u611F\u2026\u2026",
    "BraveLittleSapling_Scene7": "\u4E5F\u8BB8\u4E00\u573A\u843D\u96E8\u5C31\u662F\u8FC8\u5411\u53C2\u5929\u5927\u6811\u7684\u7B2C\u4E00\u6B65\uFF01",
    "BraveLittleSapling_Scene8": "\u518D\u89C1\u4E86\uFF0C\u5C0F\u5BB6\u4F19\uFF01",
    "BraveLittleSapling_Title": "\u52C7\u6562\u7684\u5C0F\u6811\u82D7",
    "ItHowlsInTheRain_Description": "\u4E00\u7FA4\u5E74\u8F7B\u4EBA\u5F00\u59CB\u5BFB\u627E\u4E00\u4E2A\u795E\u79D8\u58F0\u97F3\u7684\u6765\u6E90\u3002\uFF08\u672A\u6210\u5E74\u4EBA\u8BF7\u5BB6\u957F\u966A\u540C\u89C2\u770B\uFF09",
    "ItHowlsInTheRain_Scene1": "\u5B83\u5728\u96E8\u4E2D\u568E\u53EB",
    "ItHowlsInTheRain_Scene10": "\u5B83\u8FD8\u5728\u90A3\u91CC\u2026\u2026",
    "ItHowlsInTheRain_Scene2": "\u201C\u4EE5\u4E0B\u955C\u5934\u662F\u4ECE\u683C\u5170\u666E\u7ACB\u987F\u4EE5\u5357 30 \u82F1\u91CC\u5904\u7684\u5E9F\u5F03\u6444\u50CF\u673A\u4E2D\u62A2\u6551\u51FA\u6765\u7684\u3002\u201D",
    "ItHowlsInTheRain_Scene3": "\u201C\u4F60\u542C\u5230\u4E86\u5417\uFF1F\u6211\u60F3\u5B83\u662F\u4ECE\u90A3\u4E9B\u6811\u6797\u91CC\u4F20\u6765\u7684\u2026\u2026\u6211\u4EEC\u8D70\u2026\u2026\u201D",
    "ItHowlsInTheRain_Scene4": "\uFF08\u6C89\u91CD\u7684\u5598\u606F\uFF09\u201C\u2026\u2026\u770B\uFF01\u201D",
    "ItHowlsInTheRain_Scene5": "\uFF08\u6444\u50CF\u673A\u6447\u6643\u7740\u5411\u524D\u8FDB\u5165\u68EE\u6797\uFF09",
    "ItHowlsInTheRain_Scene6": "\u201C\u54E6\uFF0C\u539F\u6765\u53EA\u662F\u4F60\uFF0C\u52A0\u91CC\u2026\u2026(\u5598)(\u5598)\u2026\u2026\u522B\u6293\u7740\u6211\u7684\u80F3\u818A\uFF01\u201D",
    "ItHowlsInTheRain_Scene6_2": "\u554A\uFF01",
    "ItHowlsInTheRain_Scene7": "\u201C\u770B\uFF01\u5B83\u5728\u704C\u6728\u4E1B\u4E2D\u2026\u2026\u201D",
    "ItHowlsInTheRain_Scene8": "\u54CE\u5440\uFF01",
    "ItHowlsInTheRain_Scene8_2": "\u54E6\u2026\u2026",
    "ItHowlsInTheRain_Scene9": "\uFF08\u80FD\u542C\u5230\u4F4E\u6C89\u7684\u53EB\u58F0\u548C\u5947\u602A\u7684\u811A\u6B65\u58F0\uFF09",
    "ItHowlsInTheRain_Title": "\u5B83\u5728\u96E8\u4E2D\u568E\u53EB",
    "JourneyOfThePrairieKing_Description": "\u5927\u53D7\u559C\u7231\u7684\u7535\u5B50\u6E38\u620F\u6765\u5230\u94F6\u5C4F\u4E4B\u4E0A\uFF01",
    "JourneyOfThePrairieKing_Scene1": "\u300A\u8349\u539F\u4E4B\u738B\u4E4B\u65C5\uFF1A\u5927\u7535\u5F71\u300B",
    "JourneyOfThePrairieKing_Scene10": "\u5217\u8F66\u83B7\u6551\u4E86\u3002",
    "JourneyOfThePrairieKing_Scene11": "\u8C22\u5E55\u3002",
    "JourneyOfThePrairieKing_Scene2": "\u53C8\u662F\u5728\u5C18\u571F\u98DE\u626C\u7684\u53E4\u9053\u4E0A\uFF0C\u6211\u4EEC\u770B\u5230\u8349\u539F\u4E4B\u738B\u6B63\u770B\u5B88\u7740\u4E00\u5217\u6EE1\u8F7D\u73CD\u8D35\u5B9D\u85CF\u7684\u8D27\u8F66\u3002",
    "JourneyOfThePrairieKing_Scene3": "\u4F46\u662F\uFF0C\u6211\u4EEC\u7684\u4E3B\u4EBA\u516C\u4E0D\u77E5\u9053\uFF0C\u90AA\u6076\u7684\u6B79\u5F92\u6B63\u5728\u9644\u8FD1\u7684\u60AC\u5D16\u4E0A\u864E\u89C6\u7708\u7708\u2026\u2026",
    "JourneyOfThePrairieKing_Scene4": "\u201C\u7EC8\u4E8E\u80FD\u591F\u628A\u90A3\u4E2A\u81EA\u4EE5\u4E3A\u662F\u7684\u6CBB\u5B89\u5B98\u9664\u6389\u5E76\u4E14\u628A\u5B9D\u7269\u5077\u8D70\u4E86\u2026\u2026\u90A3\u662F\u6211\u7684\u56CA\u4E2D\u4E4B\u7269\uFF01\u201D",
    "JourneyOfThePrairieKing_Scene5": "\u201C\u5929\u54EA\uFF01\u770B\u8D77\u6765\u8FD9\u5C71\u5D29\u662F\u76F4\u51B2\u7740\u5217\u8F66\u53BB\u7684\u3002\u201D",
    "JourneyOfThePrairieKing_Scene6": "\u8349\u539F\u4E4B\u738B\u542C\u5230\u8FDC\u5904\u4F20\u6765\u4E00\u9635\u5FAE\u5F31\u7684\u9686\u9686\u58F0\u2026\u2026\u770B\uFF01",
    "JourneyOfThePrairieKing_Scene7": "\u601D\u7EEA\u5982\u7535\uFF0C\u4ED6\u5F00\u4E86\u4E00\u67AA\u3002",
    "JourneyOfThePrairieKing_Scene8": "\u4F46\u53D1\u751F\u4E86\u4EC0\u4E48\uFF1F\u6C34\u82B1\u56DB\u5904\u98DE\u6E85\uFF01",
    "JourneyOfThePrairieKing_Scene9": "\u4ED6\u53C8\u5F00\u4E86\u4E00\u67AA\uFF01\u539A\u539A\u7684\u6CE5\u571F\u963B\u6B62\u4E86\u5C71\u5D29\u3002",
    "JourneyOfThePrairieKing_Title": "\u8349\u539F\u4E4B\u738B\u4E4B\u65C5\uFF1A\u5927\u7535\u5F71",
    "MiracleAtColdstarRanch_Description": "\u5C3D\u7BA1\u56F0\u96BE\u91CD\u91CD\uFF0C\u4E00\u4E2A\u5BB6\u5EAD\u8FD8\u662F\u4FDD\u6301\u7740\u51AC\u661F\u7CBE\u795E\u7684\u5EF6\u7EED\u2026\u2026",
    "MiracleAtColdstarRanch_Scene1": "\u300A\u51B7\u661F\u7267\u573A\u7684\u5947\u8FF9\u300B",
    "MiracleAtColdstarRanch_Scene11": "\u5F53\u665A\uFF0C\u4E0D\u5BFB\u5E38\u7684\u73B0\u8C61\u53D1\u751F\u4E86\u2026\u2026",
    "MiracleAtColdstarRanch_Scene12": "\u7B2C\u4E8C\u5929\uFF0C\u51B7\u661F\u5988\u5988\u60CA\u8BB6\u5730\u53D1\u73B0\u6811\u4E0A\u96F6\u661F\u70B9\u7F00\u7740\u5B87\u5B99\u679C\u5B9E\u3002",
    "MiracleAtColdstarRanch_Scene12_2": "\u201C\u6211\u4EEC\u76F8\u4FE1\u7740\u51AC\u65E5\u661F\uFF0C\u6B63\u662F\u56E0\u6B64\u6211\u4EEC\u5F97\u4EE5\u88AB\u94ED\u8BB0\uFF01\u201D",
    "MiracleAtColdstarRanch_Scene13": "\u4ED6\u4EEC\u4E00\u8D77\u5206\u4EAB\u4E86\u661F\u4E4B\u679C\u5B9E\u3002\u5C3D\u7BA1\u5B83\u5F88\u5C0F\uFF0C\u4F46\u5374\u662F\u4ED6\u4EEC\u5403\u8FC7\u7684\u6700\u7F8E\u5473\u3001\u6700\u6EE1\u8DB3\u7684\u98DF\u7269\u3002",
    "MiracleAtColdstarRanch_Scene14": "\u4E00\u5BB6\u4EBA\u83B7\u6551\u4E86\uFF0C\u5E0C\u671B\u7684\u7CBE\u7075\u4E5F\u6D3B\u8E66\u4E71\u8DF3\u7740\u3002\u51AC\u661F\u7684\u8BFA\u8A00\u518D\u4E00\u6B21\u88AB\u5FE0\u5B9E\u5730\u9075\u5B88\u2026\u2026",
    "MiracleAtColdstarRanch_Scene2": "\u8FD9\u662F\u51AC\u661F\u65E5\u7684\u524D\u591C\uFF0C\u5DF2\u7ECF\u8FDE\u7EED\u4E09\u5468\u4E0B\u96EA\u4E0D\u505C\u4E86\u3002",
    "MiracleAtColdstarRanch_Scene3": "\u51B7\u661F\u5BB6\u65CF\u9677\u5165\u56F0\u5883\u2026\u2026\u53BB\u4E0D\u4E86\u57CE\u91CC\u3002\u5E78\u8FD0\u7684\u662F\uFF0C\u5976\u725B\u6709\u8DB3\u591F\u7684\u5E72\u8349\u53EF\u4EE5\u8FC7\u6D3B\u3002",
    "MiracleAtColdstarRanch_Scene5": "\u2026\u2026\u4F46\u662F\u8FD9\u5BB6\u4EBA\u5DF2\u7ECF\u6CA1\u6709\u98DF\u7269\u50A8\u5907\u4E86\u3002",
    "MiracleAtColdstarRanch_Scene7": "\u5C3D\u7BA1\u5982\u6B64\uFF0C\u51B7\u661F\u7238\u7238\u8FD8\u662F\u52C7\u6562\u5730\u5192\u7740\u9669\u6076\u7684\u6761\u4EF6\u780D\u4E0B\u4E86\u51AC\u661F\u6811\u2026\u2026",
    "MiracleAtColdstarRanch_Scene9": "\u5C3D\u7BA1\u4ED6\u4EEC\u5F88\u997F\uFF0C\u5BB6\u91CC\u8FD8\u662F\u5C06\u8FD9\u68F5\u6811\u88C5\u9970\u8D77\u6765\uFF0C\u8BA9\u51AC\u661F\u7684\u8BFA\u8A00\u6C38\u5B58\u3002",
    "MiracleAtColdstarRanch_Title": "\u51B7\u661F\u7267\u573A\u7684\u5947\u8FF9",
    "Mysterium_Description": "\u76F4\u9762\u5348\u591C\u9762\u7EB1\u7684\u80CC\u540E\u6240\u9690\u85CF\u7684\u2026\u2026\u53EA\u6709\u7ECF\u5386\u8FC7\u624D\u4F1A\u76F8\u4FE1\uFF01",
    "Mysterium_Scene1": "\u300A\u795E\u79D8\u4E8B\u8FF9\u300B",
    "Mysterium_Scene10": "\u201C\u4F60\u4E00\u5B9A\u8981\u544A\u8BC9\u4F60\u7684\u670B\u53CB\u53BB\u770B\u4ECA\u665A\u7684\u300A\u795E\u79D8\u4E8B\u8FF9\u300B\u2026\u2026\u201D",
    "Mysterium_Scene11": "\u201C\u2026\u2026\u5426\u5219\u6211\u4F1A\u5728\u4F60\u6C89\u7761\u4E4B\u65F6\u62DC\u8BBF\uFF01\u201D",
    "Mysterium_Scene2": "\u9ED1\u6697\u4E2D\u82E5\u9690\u82E5\u73B0\u7684\u8F6E\u5ED3\u2026\u2026",
    "Mysterium_Scene5": "\u8352\u51C9\u3001\u672A\u77E5\u7684\u865A\u7A7A\u4E2D\u2026\u2026\u6709\u96BE\u4EE5\u8A00\u8BF4\u7684\u6050\u6016\u5728\u7B49\u5F85\u3002",
    "Mysterium_Scene8": "\u5404\u79CD\u652F\u79BB\u7834\u788E\u7684\uFF0C\u8D85\u8131\u4E16\u4FD7\u60F3\u8C61\u7684\u573A\u666F\u4E0A\u6F14\u2026\u2026",
    "Mysterium_Title": "\u795E\u79D8\u4E8B\u8FF9",
    "NaturalWonders_Description": "\u53C2\u89C2\u82AC\u5409\u5C14\u5171\u548C\u56FD\u7684\u571F\u5730\u2026\u2026\u4ECE\u82AC\u7FA4\u5C9B\u5230\u7956\u7956\u57CE\uFF0C\u8FD9\u4E2A\u4E16\u754C\u5145\u6EE1\u4E86\u751F\u673A\uFF01",
    "NaturalWonders_Scene1": "\u300A\u81EA\u7136\u5947\u89C2\uFF1A\u63A2\u7D22\u6211\u4EEC\u8FD9\u5145\u6EE1\u6D3B\u529B\u7684\u4E16\u754C\u300B",
    "NaturalWonders_Scene2": "\u82AC\u7FA4\u5C9B\u662F\u5357\u90E8\u6D77\u5CB8 80 \u82F1\u91CC\u5916\u7684\u70ED\u5E26\u5929\u5802\u3002\u8FD9\u4E9B\u5C9B\u5C7F\u662F\u7531\u4E8E\u8BE5\u5730\u533A\u7684\u706B\u5C71\u6D3B\u52A8\u800C\u5F62\u6210\u7684\uFF0C\u800C\u4E14\u8FD8\u5728\u4E0D\u65AD\u589E\u957F\u2026\u2026",
    "NaturalWonders_Scene3": "\u5357\u5927\u6D0B\u6E29\u6696\u7684\u6C14\u5019\u4F7F\u5F97\u751F\u7269\u591A\u6837\u6027\u6781\u4E3A\u4E30\u5BCC\u2026\u2026\u7B80\u800C\u8A00\u4E4B\uFF0C\u8FD9\u4E2A\u5C9B\u4E0A\u5145\u6EE1\u4E86\u751F\u547D\uFF01",
    "NaturalWonders_Scene4": "\u73B0\u5728\u6211\u4EEC\u5F80\u5317\u8D70\uFF0C\u6765\u5230\u7E41\u534E\u7684\u7956\u7956\u57CE\u3002\u5B83\u662F\u4E00\u4E2A\u7531\u6DF7\u51DD\u571F\u548C\u94A2\u94C1\u7EC4\u6210\u7684\u4E16\u754C\uFF0C\u6709\u57CE\u5E02\u7684\u5149\u8292\u7167\u4EAE\u3002",
    "NaturalWonders_Scene5": "\u8FD9\u91CC\u7684\u81EA\u7136\u73AF\u5883\u53EF\u80FD\u5F88\u6076\u52A3\uFF0C\u4F46\u6211\u4EEC\u4ECD\u7136\u53D1\u73B0\u4E86\u5927\u91CF\u7684\u81EA\u7136\u751F\u547D\u2026\u2026",
    "NaturalWonders_Scene6": "\u5728\u9065\u8FDC\u7684\u897F\u90E8\uFF0C\u5E7F\u9614\u7684\u5B9D\u77F3\u6D77\u4E0A\uFF0C\u8349\u539F\u5C9B\u5B64\u7ACB\u5176\u4E2D\u3002\u4ECE\u5B83\u7684\u540D\u5B57\u53EF\u4EE5\u770B\u51FA\uFF0C\u8FD9\u7247\u571F\u5730\u662F\u5404\u79CD\u5404\u6837\u7684\u81EA\u7136\u751F\u7269\u7FA4\u843D\u7684\u5BB6\u56ED\u3002",
    "NaturalWonders_Scene7": "\u8FD9\u4E2A\u5C9B\u4EE5\u5176\u6D63\u718A\u6570\u91CF\u4F17\u591A\u800C\u95FB\u540D\uFF01",
    "NaturalWonders_Scene8": "\u6700\u540E\uFF0C\u6211\u4EEC\u56DE\u5230\u5927\u9646\uFF0C\u53C2\u89C2\u5927\u9646\u4E0A\u6700\u5B9C\u4EBA\u7684\u5730\u533A\u4E4B\u4E00\u2026\u2026\u661F\u9732\u8C37\u3002",
    "NaturalWonders_Scene9": "\u5C71\u8C37\u7684\u6E29\u5E26\u6C14\u5019\u662F\u5404\u79CD\u68EE\u6797\u751F\u7269\u548C\u6606\u866B\u7684\u5B8C\u7F8E\u5BB6\u56ED\u3002\u591A\u7F8E\u7684\u5730\u65B9\u554A\uFF01",
    "NaturalWonders_Title": "\u81EA\u7136\u5947\u89C2\uFF1A\u63A2\u7D22\u6211\u4EEC\u8FD9\u5145\u6EE1\u6D3B\u529B\u7684\u4E16\u754C",
    "Wumbus_Description": "\u4E00\u90E8\u8352\u8BDE\u7684\u79D1\u5E7B\u559C\u5267\uFF0C\u4EE5\u53E6\u4E00\u4E2A\u661F\u7403\u4E0A\u67D0\u4E2A\u7B28\u86CB\u7684\u751F\u6D3B\u548C\u65F6\u4EE3\u4E3A\u4E2D\u5FC3\u5C55\u5F00\u3002",
    "Wumbus_Scene1": "\u300A\u6E29\u5E03\u65AF\u300B",
    "Wumbus_Scene2": "\u6E29\u5E03\u65AF\uFF0C\u603B\u662F\u65E0\u5FE7\u65E0\u8651\uFF0C\u8EAB\u5FC3\u653E\u677E\uFF0C\u4EAB\u53D7\u6765\u81EA\u4ED6\u661F\u7403\u7684\u6052\u661F\u5E26\u6765\u7684\u6E29\u6696\u3002",
    "Wumbus_Scene3": "\u4ED6\u5FE0\u5B9E\u7684\u4EC6\u4EBA\uFF0C\u98DF\u54C1\u673A\u5668\u4EBA\uFF0C\u5411\u4ED6\u63D0\u4F9B\u6E90\u6E90\u4E0D\u65AD\u7684\u6CB9\u70B8\u9762\u997C\u548C\u201C\u7EA2\u9171\u201D\u3002",
    "Wumbus_Scene4": "\u6E29\u5E03\u65AF\u8BD5\u56FE\u8BA9\u4ED6\u7684\u4F84\u5B50\u7F57\u585E\u5C14\u5BF9\u661F\u4F53\u7CFB\u7EDF\u7684\u6587\u5316\u548C\u4E8B\u52A1\u611F\u5174\u8DA3\uFF0C\u4F46\u7F57\u585E\u5C14\u5BF9\u6B64\u5174\u8DA3\u5E73\u5E73\u3002",
    "Wumbus_Scene5": "\u201C\u5550\uFF01\u201D",
    "Wumbus_Scene6": "\u8FD9\u90E8\u7535\u5F71\u63CF\u8FF0\u7684\u662F\u6E29\u5E03\u65AF\u751F\u6D3B\u7684\u5947\u602A\u4E16\u754C\u91CC\u7684\u4E00\u4E2A\u5E7D\u9ED8\u7684\u751F\u6D3B\u7247\u6BB5\uFF0C\u8FD9\u4E2A\u4E16\u754C\u7684\u6280\u672F\u5DF2\u7ECF\u53D1\u5C55\u5230\u4E86\u4E00\u4E2A\u6781\u9AD8\u7684\u6C34\u5E73\u3002",
    "Wumbus_Scene7": "\u8BB8\u591A\u573A\u666F\u8BD5\u56FE\u5728\u73B0\u4EE3\u751F\u6D3B\u65B9\u5F0F\u7684\u8352\u8C2C\u4E2D\u627E\u5230\u5E7D\u9ED8\u3002",
    "Wumbus_Scene8": "\u4F46\u662F\uFF0C\u5C3D\u7BA1\u62E5\u6709\u8FD1\u4E4E\u65E0\u9650\u7684\u5A31\u4E50\u65B9\u5F0F\uFF0C\u6E29\u5E03\u65AF\u548C\u4ED6\u7684\u670B\u53CB\u4EEC\u4ECD\u7136\u559C\u6B22\u805A\u5728\u4E00\u8D77\uFF0C\u4EAB\u7528\u4E00\u987F\u7F8E\u5473\u7684\u6BD4\u8428\u3002\uFF08100% \u7531\u8C37\u86CB\u767D\u6750\u6599\u5236\u6210\u3002\uFF09",
    "Wumbus_Title": "\u6E29\u5E03\u65AF",
    "ZuzuCityExpress_Description": "\u4E00\u90E8\u5907\u53D7\u559C\u7231\u7684\u7ECF\u5178\u7535\u5F71\uFF0C\u7ECF\u8FC7\u7CBE\u5FC3\u91CD\u7F6E\uFF0C\u9002\u5408\u73B0\u4EE3\u5F71\u9662\u3002",
    "ZuzuCityExpress_Scene1": "\u300A\u7956\u7956\u57CE\u7279\u5FEB\u5217\u8F66\u300B",
    "ZuzuCityExpress_Scene2": "\u7956\u7956\u57CE\u7279\u5FEB\u5217\u8F66\u4ECE\u51B0\u51B7\u7684\u6D77\u5CB8\u5411\u5357\u90E8\u5C55\u5F00\u4E86\u6700\u540E\u4E00\u8D9F\u65C5\u7A0B\u2026\u2026\u8FD9\u662F\u4E00\u8D9F\u4E3A\u671F\u4E09\u5929\u7684\u65C5\u7A0B\uFF01",
    "ZuzuCityExpress_Scene3": "\u4E00\u4F4D\u5E74\u8F7B\u7684\u5973\u58EB\u82E5\u6709\u6240\u601D\u5730\u51DD\u89C6\u7740\u7A97\u5916\u3002",
    "ZuzuCityExpress_Scene6": "\u8FD9\u90E8\u7535\u5F71\u63A2\u7D22\u4E86\u4E00\u4E2A\u6C38\u6052\u7684\u4E3B\u9898\u2026\u2026\u7406\u6027\u4E0E\u60C5\u611F\u7684\u51B2\u7A81\u3002",
    "ZuzuCityExpress_Scene7": "\u5979\u4F1A\u8FFD\u968F\u81EA\u8EAB\u7406\u6027\u601D\u7EF4\u7684\u65B9\u5411\uFF0C\u8FD8\u662F\u5979\u5185\u5FC3\u7684\u6E34\u671B\uFF1F",
    "ZuzuCityExpress_Scene8": "\u5728\u6211\u4EEC\u627E\u5230\u7B54\u6848\u4E4B\u524D\uFF0C\u7535\u5F71\u5C31\u7ED3\u675F\u4E86\u2026\u2026",
    "ZuzuCityExpress_Title": "\u7956\u7956\u57CE\u7279\u5FEB\u5217\u8F66"
  }
}