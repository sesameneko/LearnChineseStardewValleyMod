  "wasCompressed": true,
  "entries": {
    "derby_contestent0": "\u9493\u9C7C\u4EBA\uFF1A\u6211\u4ECE\u683C\u5170\u666E\u987F\u5927\u8001\u8FDC\u8D76\u8FC7\u6765\u5C31\u662F\u4E3A\u4E86\u53C2\u52A0\u8FD9\u4E2A\u6BD4\u8D5B\u3002||\u9493\u9C7C\u4EBA\uFF1A\u6211\u53EF\u4E0D\u4F1A\u7A7A\u624B\u800C\u5F52\uFF0C\u80AF\u5B9A\u8981\u9493\u6EE1\u4E00\u80CC\u5305\u7684\u9CDF\u9C7C\uFF01",
    "derby_contestent1": "\u6C34\u624B\uFF1A\u6211\u597D\u50CF\u7A7F\u5F97\u592A\u6B63\u5F0F\u4E86\u3002",
    "derby_contestent2": "\u6C34\u624B\uFF1A\u5475\u5475\u2026\u2026\u5C45\u7136\u6709\u4EBA\u8DDF\u6211\u7A7F\u4E00\u6837\u7684\u8863\u670D\u3002\u5C34\u5C2C\u6B7B\u4E86\uFF01",
    "derby_contestent3": "\u9493\u9C7C\u4EBA\uFF1A\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u60F3\u5B89\u9759\u5730\u9493\u9C7C\u3002||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u4F60\u5C31\u6CA1\u70B9\u773C\u529B\u89C1\u5417\uFF1F||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026||\u9493\u9C7C\u4EBA\uFF1A\u770B\u6765\u6211\u4E0D\u5F97\u4E0D\u52A8\u624B\u4E86\u3002||\u9493\u9C7C\u4EBA\uFF1A\u2026\u2026",
    "derby_contestent4": "\u9493\u9C7C\u59D0\u59B9\uFF1A\u6211\u4EEC\u662F\u8457\u540D\u7684\u9493\u9C7C\u59D0\u59B9\uFF01||\u9493\u9C7C\u59D0\u59B9\uFF1A\u5FD7\u5728\u5FC5\u5F97\uFF0C\u820D\u6211\u5176\u8C01\uFF01\u8036\uFF01\u8036\uFF01\u8036\uFF01",
    "derby_contestent5": "\u9493\u5BA2\uFF1A\u4F60\u600E\u4E48\u6837\uFF1F\u6211\u6CA1\u5582\u5230\u9C7C\uFF0C\u5149\u987E\u7740\u5582\u868A\u5B50\u4E86\u2026\u2026",
    "derby_contestent6": "\u9CDF\u9C7C\u4FA0\uFF1A\u6211\u8001\u5BB6\u90A3\u8FB9\u90FD\u558A\u6211\u201C\u9CDF\u9C7C\u4FA0\u201D\u3002||\u9CDF\u9C7C\u4FA0\uFF1A\u6CA1\u9519\uFF0C\u8FD9\u4E94\u5E74\u6211\u4E00\u76F4\u5728\u5B66\u4E60\u9CDF\u9C7C\u7684\u601D\u7EF4\u65B9\u5F0F\u3002\u5176\u5B9E\u5F88\u7B80\u5355\uFF1A\u5403\u4E86\u7761\uFF0C\u7761\u4E86\u5403\uFF0C\u5403\u9971\u4E86\u518D\u4EA7\u4E2A\u5375\u3002||\u9CDF\u9C7C\u4FA0\uFF1A\u78B0\u5DE7\u6211\u4E5F\u5F88\u559C\u6B22\u5403\uFF0C\u5C31\u662F\u4E0D\u592A\u4F1A\u4EA7\u5375\u3002",
    "derby_contestent7": "\u9493\u9C7C\u4EBA\uFF1A\u4F60\u60F3\u907F\u5F00\u4EBA\u7FA4\u662F\u5427\uFF1F\u6211\u4E5F\u662F\u3002",
    "derby_contestent8": "\u9493\u9C7C\u9AD8\u624B\uFF1A\u867D\u7136\u8FD9\u4E2A\u4E0D\u662F\u6DD8\u6C70\u8D5B\uFF0C\u4F46\u662F\u2026\u2026\u5982\u679C\u6211\u62FF\u5230\u7684\u6807\u7B7E\u6700\u591A\uFF0C\u80AF\u5B9A\u8981\u5230\u5904\u70AB\u8000\u4E00\u756A\uFF01||\u9493\u9C7C\u9AD8\u624B\uFF1A\u51AC\u5929\u7684\u9C7F\u9C7C\u8282\u6211\u4E5F\u4F1A\u6765\u7684\u2026\u2026\u90A3\u624D\u662F\u771F\u6B63\u7684\u6311\u6218\uFF01||\u9493\u9C7C\u9AD8\u624B\uFF1A\u9493\u9CDF\u9C7C\u7684\u79D8\u8BC0\u5728\u4E8E\uFF0C\u4F60\u7684\u9C7C\u9975\u8981\u770B\u8D77\u6765\u975E\u5E38\u597D\u5403\uFF0C\u8BA9\u9C7C\u5FCD\u4E0D\u4F4F\u54AC\u4E00\u53E3\u2026\u2026",
    "derby_contestent9": "\u9493\u9C7C\u4EBA\uFF1A\u54CE\uFF0C\u8FD9\u624D\u662F\u4EBA\u751F\u561B\u3002\u9493\u4E0A\u4E00\u6574\u5929\u9CDF\u9C7C\uFF0C\u8FD9\u65E5\u5B50\u522B\u63D0\u6709\u591A\u5B81\u9759\u4E86\u3002",
    "winter_derby_contestent0": "\u9493\u9C7C\u4EBA\uFF1A\u9C7F\u9C7C\u901A\u5E38\u53EA\u5728\u665A\u4E0A\u51FA\u73B0\uFF0C\u4E0D\u8FC7\u4ED6\u4EEC\u5728\u6C34\u91CC\u6254\u4E86\u7279\u6B8A\u7684\u9C7C\u9975\uFF0C\u6240\u4EE5\u5B83\u4EEC\u4E00\u6574\u5929\u90FD\u5728\u6D3B\u52A8\u3002",
    "winter_derby_contestent1": "\u6C34\u624B\uFF1A\u5927\u51B7\u5929\u6211\u611F\u89C9\u81EA\u5DF1\u5F88\u575A\u97E7\uFF0C\u50CF\u662F\u4E00\u5757\u8089\u5E72\u3002||\u6C34\u624B\uFF1A\u5929\u6C14\u592A\u70ED\u7684\u8BDD\uFF0C\u6211\u5C31\u4F1A\u611F\u89C9\u50CF\u4E2A\u5E03\u4E01\u3002",
    "winter_derby_contestent10": "\u9493\u9C7C\u4EBA\uFF1A\u6211\u624B\u6307\u90FD\u51BB\u50F5\u4E86\uFF0C\u5F97\u5148\u559D\u4E00\u676F\u82F9\u679C\u6C41\u70ED\u70ED\u8EAB\u5B50\u3002\u795D\u4F60\u597D\u8FD0\u554A\uFF01",
    "winter_derby_contestent11": "\u9C7F\u9C7C\u53A8\u5E08\uFF1A\u554A\uFF0C\u4E0D\u7528\u7BA1\u6211\u2026\u2026\u6211\u5C31\u662F\u6765\u6279\u53D1\u9C7F\u9C7C\u7684\uFF01||\u9C7F\u9C7C\u53A8\u5E08\uFF1A\u54CE\uFF0C\u4F60\u8FD8\u6123\u7740\u505A\u4EC0\u4E48\uFF1F\u4F60\u4E0D\u53BB\u9493\uFF0C\u9C7F\u9C7C\u53EF\u4E0D\u4F1A\u81EA\u5DF1\u4E0A\u6765\uFF01",
    "winter_derby_contestent2": "\u6C34\u624B\uFF1A\u5C0F\u9C7F\u9C7C\u4E56\u4E56\uFF0C\u5FEB\u70B9\u8FC7\u6765\u2026\u2026",
    "winter_derby_contestent3": "\u9493\u9C7C\u4EBA\uFF1A\u4F60\u662F\u672C\u5730\u4EBA\u5427\uFF1F\u6211\u5C31\u6293\u4E00\u4E9B\u8FD9\u91CC\u7684\u597D\u9C7F\u9C7C\uFF0C\u5E0C\u671B\u4F60\u4EEC\u4E0D\u8981\u4ECB\u610F\u2026\u2026",
    "winter_derby_contestent4": "\u9493\u9C7C\u59D0\u59B9\uFF1A\u6211\u4EEC\u662F\u8457\u540D\u7684\u9493\u9C7C\u59D0\u59B9\u3002||\u9493\u9C7C\u59D0\u59B9\uFF1A\u9C7F\u9C7C\u9C7F\u9C7C\uFF0C\u7EDD\u4E0D\u72B9\u8C6B\uFF01\u8036\uFF01\u8036\uFF01\u8036\uFF01",
    "winter_derby_contestent5": "\u5782\u9493\u8005\uFF1A\u5636\u2026\u2026\u597D\u51B7\u554A\uFF01\u6216\u8BB8\u6211\u5C31\u4E0D\u9002\u5408\u5728\u51AC\u5929\u6D77\u9493\u3002||\u5782\u9493\u8005\uFF1A\u8981\u662F\u6709\u4E00\u4E2A\u9CA4\u9C7C\u8282\u5C31\u597D\u4E86\u2026\u2026",
    "winter_derby_contestent6": "\u9CDF\u9C7C\u4FA0\uFF1A\u5509\uFF0C\u9C7F\u9C7C\u8DDF\u9CDF\u9C7C\u6709\u70B9\u4E0D\u4E00\u6837\uFF0C\u4F46\u6211\u8FD8\u662F\u53EF\u4EE5\u9493\u5230\u7684\u3002||\u9CDF\u9C7C\u4FA0\uFF1A\u5982\u679C\u4F60\u60F3\u83B7\u5F97\u5956\u54C1\u5C31\u8D76\u7D27\u53BB\u9493\u9C7C\u5427\uFF01",
    "winter_derby_contestent7": "\u9493\u9C7C\u4EBA\uFF1A\u51FA\u53D1\u7684\u65F6\u5019\u6211\u8001\u5A46\u7ED9\u6211\u5E26\u4E86\u70ED\u5496\u5561\uFF0C\u8FD8\u662F\u7528\u4FDD\u6E29\u74F6\u88C5\u7684\uFF0C\u591A\u8D34\u5FC3\uFF01",
    "winter_derby_contestent8": "\u9493\u9C7C\u9AD8\u624B\uFF1A\u5618\u2026\u2026\u6211\u4E0D\u60F3\u5413\u5230\u9C7F\u9C7C\u3002||\u9493\u9C7C\u9AD8\u624B\uFF1A\u6211\u5F85\u5728\u8FD9\u91CC\u5C31\u662F\u4E3A\u4E86\u907F\u5F00\u4EBA\u7FA4\uFF0C\u9C7F\u9C7C\u633A\u6015\u4EBA\u7684\u3002||\u9493\u9C7C\u9AD8\u624B\uFF1A\u4F60\u60F3\u5728\u8FD9\u9493\u9C7C\u7684\u8BDD\u4E5F\u884C\uFF0C\u5C31\u662F\u522B\u5435\u95F9\u3002",
    "winter_derby_contestent9": "\u9493\u9C7C\u4EBA\uFF1A\u6211\u4E0D\u5728\u610F\u6BD4\u8D5B\u80FD\u4E0D\u80FD\u83B7\u80DC\uFF0C\u6211\u5C31\u662F\u60F3\u611F\u53D7\u4E00\u4E0B\u6C1B\u56F4\u3002||\u9493\u9C7C\u4EBA\uFF1A\u590F\u5929\u7684\u5929\u6C14\u56FA\u7136\u597D\uFF0C\u4F46\u662F\u51DB\u51BD\u7684\u51AC\u5929\u4E5F\u4E0D\u9519\u3002\u6CA1\u6709\u53CD\u5DEE\uFF0C\u4EBA\u751F\u4F1A\u53D8\u6210\u4EC0\u4E48\u6837\uFF1F"
  }
